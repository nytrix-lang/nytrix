;; ny-make:unicode:data:end
fn _idx(list<int> starts, int cp) int {
   mut lo = 0
   mut hi = starts.len
   while lo < hi {
      def mid = (lo + hi) >> 1
      if starts[mid] <= cp { lo = mid + 1 } else { hi = mid }
   }
   lo - 1
}

fn _range(list<int> starts, list<int> vals, int cp, int dflt) int {
   def i = _idx(starts, cp)
   if i < 0 { return dflt }
   vals[i]
}

fn _in_pairs(list<int> pairs, int cp) bool {
   mut lo = 0
   mut hi = pairs.len >> 1
   while lo < hi {
      def mid = (lo + hi) >> 1
      if pairs[mid * 2] <= cp { lo = mid + 1 } else { hi = mid }
   }
   if lo == 0 { return false }
   def i = (lo - 1) * 2
   cp <= pairs[i + 1]
}

fn _seq_idx(list<int> starts, int cp) int {
   def i = _idx(starts, cp)
   if i < 0 || starts[i] != cp { return -1 }
   i
}

fn u_gc(int cp) int {
   if cp >= 0 && cp < 128 { return _ascii_gc[cp] }
   _range(_gc_starts, _gc_vals, cp, 0)
}

fn u_prop(int cp) int {
   if cp >= 0 && cp < 128 { return _ascii_prop[cp] }
   _range(_prop_starts, _prop_vals, cp, 0)
}

fn u_ccc(int cp) int { _range(_ccc_starts, _ccc_vals, cp, 0) }

fn u_script(int cp) int { _range(_script_starts, _script_vals, cp, 0) }

fn u_script_name(int id) str {
   if id < 0 || id >= _script_names.len { return "Unknown" }
   _script_names[id]
}

fn u_grapheme(int cp) int { _range(_gb_starts, _gb_vals, cp, 0) }

fn u_word(int cp) int { _range(_wb_starts, _wb_vals, cp, 0) }

fn u_sentence(int cp) int { _range(_sb_starts, _sb_vals, cp, 0) }

fn u_id_type(int cp) int { _range(_id_type_starts, _id_type_vals, cp, 0) }

fn u_id_allowed(int cp) bool { _in_pairs(_id_allowed, cp) }

fn _map_at(list<int> starts, list<int> vals, int cp) int {
   def i = _seq_idx(starts, cp)
   if i < 0 { return cp }
   vals[i]
}

fn u_upper(int cp) int {
   if cp >= 0 && cp < 128 { return _ascii_up[cp] }
   _map_at(_up_map_starts, _up_map_vals, cp)
}

fn u_lower(int cp) int {
   if cp >= 0 && cp < 128 { return _ascii_lo[cp] }
   _map_at(_lo_map_starts, _lo_map_vals, cp)
}

fn u_title(int cp) int {
   if cp >= 0 && cp < 128 { return _ascii_ti[cp] }
   _map_at(_ti_map_starts, _ti_map_vals, cp)
}

fn u_fold(int cp) int { _map_at(_fold_map_starts, _fold_map_vals, cp) }

fn u_case_len(int cp, int kind) int {
   mut i = 0
   if kind == 0 { i = _seq_idx(_up_starts, cp) }
   elif kind == 1 { i = _seq_idx(_lo_starts, cp) }
   elif kind == 2 { i = _seq_idx(_ti_starts, cp) }
   else { i = _seq_idx(_fold_starts, cp) }
   if i < 0 { return 0 }
   if kind == 0 { return _up_lens[i] }
   if kind == 1 { return _lo_lens[i] }
   if kind == 2 { return _ti_lens[i] }
   _fold_lens[i]
}

fn u_case_at(int cp, int kind, int pos) int {
   mut i = 0
   if kind == 0 { i = _seq_idx(_up_starts, cp) }
   elif kind == 1 { i = _seq_idx(_lo_starts, cp) }
   elif kind == 2 { i = _seq_idx(_ti_starts, cp) }
   else { i = _seq_idx(_fold_starts, cp) }
   if i < 0 { return -1 }
   if kind == 0 { return _up_pool[_up_offs[i] + pos] }
   if kind == 1 { return _lo_pool[_lo_offs[i] + pos] }
   if kind == 2 { return _ti_pool[_ti_offs[i] + pos] }
   _fold_pool[_fold_offs[i] + pos]
}

fn u_decomp_kind(int cp) int {
   def i = _seq_idx(_decomp_starts, cp)
   if i < 0 { return 0 }
   _decomp_flags[i]
}

fn u_decomp_len(int cp) int {
   def i = _seq_idx(_decomp_starts, cp)
   if i < 0 { return 0 }
   _decomp_lens[i]
}

fn u_decomp_at(int cp, int pos) int {
   def i = _seq_idx(_decomp_starts, cp)
   if i < 0 { return -1 }
   _decomp_pool[_decomp_offs[i] + pos]
}

fn u_compose_pair(int a, int b) int {
   def i = _seq_idx(_comp_bases, a)
   if i < 0 { return 0 }
   mut k = _comp_offs[i]
   def end = i + 1 < _comp_offs.len ? _comp_offs[i + 1] : _comp_combs.len
   while k < end {
      if _comp_combs[k] - b == 0 { return _comp_vals[k] }
      k += 1
   }
   0
}

fn u_conf_len(int cp) int {
   def i = _seq_idx(_conf_starts, cp)
   if i < 0 { return 0 }
   _conf_lens[i]
}

fn u_conf_at(int cp, int pos) int {
   def i = _seq_idx(_conf_starts, cp)
   if i < 0 { return -1 }
   _conf_pool[_conf_offs[i] + pos]
}

;; Keywords: unicode utf8 codepoint category script identifier property
;; Unicode 18.0 fundamentals. Property queries are allocation-free; text
;; iteration uses the byte decoder already owned by core.str.
def str UNICODE_VERSION = "18.0.0"

fn utf8_valid(str s) bool { strmod.utf8_valid(s) }

fn utf8_len(str s) int { strmod.utf8_len(s) }

fn from_codepoint(int cp) str { strmod.chr(cp) }

fn codepoint_at(str s, int idx=0) int { strmod.ord_at(s, idx) }

fn code_points(str s) list<int> {
   "Returns Unicode scalar values; malformed bytes become U+FFFD."
   mut out = []
   mut i = 0
   def n = s.len
   while i < n {
      def w = strmod._utf8_seq_len(s, i, n)
      if w < 1 {
         out = out.append(0xFFFD)
         i += 1
      } else {
         out = out.append(strmod._utf8_decode_at(s, i, w))
         i += w
      }
   }
   out
}

fn chars(str s) list<str> {
   "Returns one string per code point; malformed bytes become U+FFFD strings."
   mut out = []
   mut i = 0
   def n = s.len
   while i < n {
      def w = strmod._utf8_seq_len(s, i, n)
      if w < 1 {
         out = out.append("\xef\xbf\xbd")
         i += 1
      } else {
         out = out.append(strmod._substr(s, i, i + w))
         i += w
      }
   }
   out
}

fn byte_offset(str s, int cp_index) int {
   "Returns the byte offset of a code-point index, clamped to the string end."
   if cp_index <= 0 { return 0 }
   mut i = 0
   mut pos = 0
   def n = s.len
   while i < n && pos < cp_index {
      def w = strmod._utf8_seq_len(s, i, n)
      if w < 1 { i += 1 } else { i += w }
      pos += 1
   }
   i
}

fn category(int cp) str {
   case u_gc(cp) {
      1 -> "Lu"
      2 -> "Ll"
      3 -> "Lt"
      4 -> "Lm"
      5 -> "Lo"
      6 -> "Mn"
      7 -> "Mc"
      8 -> "Me"
      9 -> "Nd"
      10 -> "Nl"
      11 -> "No"
      12 -> "Pc"
      13 -> "Pd"
      14 -> "Ps"
      15 -> "Pe"
      16 -> "Pi"
      17 -> "Pf"
      18 -> "Po"
      19 -> "Sm"
      20 -> "Sc"
      21 -> "Sk"
      22 -> "So"
      23 -> "Zs"
      24 -> "Zl"
      25 -> "Zp"
      26 -> "Cc"
      27 -> "Cf"
      28 -> "Cs"
      29 -> "Co"
      _ -> "Cn"
   }
}

fn script(int cp) str { u_script_name(u_script(cp)) }

fn combining_class(int cp) int { u_ccc(cp) }

fn is_alphabetic(int cp) bool { (u_prop(cp) & U_PROP_ALPHA) != 0 }

fn is_numeric(int cp) bool { (u_prop(cp) & U_PROP_NUMERIC) != 0 }

fn is_whitespace(int cp) bool { (u_prop(cp) & U_PROP_WHITESPACE) != 0 }

fn is_uppercase(int cp) bool { (u_prop(cp) & U_PROP_UPPERCASE) != 0 }

fn is_lowercase(int cp) bool { (u_prop(cp) & U_PROP_LOWERCASE) != 0 }

fn is_xid_start(int cp) bool { (u_prop(cp) & U_PROP_XID_START) != 0 }

fn is_xid_continue(int cp) bool { (u_prop(cp) & U_PROP_XID_CONTINUE) != 0 }

fn is_assigned(int cp) bool { (u_prop(cp) & U_PROP_ASSIGNED) != 0 }

fn is_default_ignorable(int cp) bool { (u_prop(cp) & U_PROP_DEFAULT_IGNORABLE) != 0 }

fn is_bidi_control(int cp) bool { (u_prop(cp) & U_PROP_BIDI_CONTROL) != 0 }

fn is_extended_pictographic(int cp) bool { (u_prop(cp) & U_PROP_EXTENDED_PICTOGRAPHIC) != 0 }

fn is_ascii(int cp) bool { cp >= 0 && cp < 128 }

fn is_control(int cp) bool { u_gc(cp) == 26 }

fn is_format(int cp) bool { u_gc(cp) == 27 }

fn is_letter(int cp) bool {
   def g = u_gc(cp)
   g >= 1 && g <= 5
}

fn is_mark(int cp) bool {
   def g = u_gc(cp)
   g >= 6 && g <= 8
}

fn is_number(int cp) bool {
   def g = u_gc(cp)
   g >= 9 && g <= 11
}

fn is_punctuation(int cp) bool {
   def g = u_gc(cp)
   g >= 12 && g <= 18
}

fn is_symbol(int cp) bool {
   def g = u_gc(cp)
   g >= 19 && g <= 22
}

fn is_separator(int cp) bool {
   def g = u_gc(cp)
   g >= 23 && g <= 25
}

fn is_cased(int cp) bool { (u_prop(cp) & U_PROP_CASED) != 0 }

fn is_case_ignorable(int cp) bool {
   (u_prop(cp) & U_PROP_CASE_IGNORABLE) != 0
}

;; Keywords: unicode case uppercase lowercase title folding
;; Full Unicode 18.0 casing, including one-to-many mappings and the
;; Final_Sigma/Turkic context rules.
def int CASE_UPPER = 0
def int CASE_LOWER = 1
def int CASE_TITLE = 2
def int CASE_FOLD = 3

fn _case_emit(ptr b, int cp) ptr {
   if cp < 0 || cp > 0x10FFFF { return b }
   if cp <= 0x7F { return strmod.builder_append_byte(b, cp) }
   if cp <= 0x7FF {
      b = strmod.builder_append_byte(b, 0xC0 | (cp >> 6))
      return strmod.builder_append_byte(b, 0x80 | (cp & 0x3F))
   }
   if cp <= 0xFFFF {
      b = strmod.builder_append_byte(b, 0xE0 | (cp >> 12))
      b = strmod.builder_append_byte(b, 0x80 | ((cp >> 6) & 0x3F))
      return strmod.builder_append_byte(b, 0x80 | (cp & 0x3F))
   }
   b = strmod.builder_append_byte(b, 0xF0 | (cp >> 18))
   b = strmod.builder_append_byte(b, 0x80 | ((cp >> 12) & 0x3F))
   b = strmod.builder_append_byte(b, 0x80 | ((cp >> 6) & 0x3F))
   strmod.builder_append_byte(b, 0x80 | (cp & 0x3F))
}

fn simple_upper(int cp) int { u_upper(cp) }

fn simple_lower(int cp) int { u_lower(cp) }

fn simple_title(int cp) int { u_title(cp) }

fn simple_fold(int cp) int { u_fold(cp) }

fn _simple(int cp, int kind) int {
   if kind == CASE_UPPER { return u_upper(cp) }
   if kind == CASE_LOWER { return u_lower(cp) }
   if kind == CASE_TITLE { return u_title(cp) }
   u_fold(cp)
}

fn _mapped(ptr b, int cp, int kind) ptr {
   def n = u_case_len(cp, kind)
   if n > 0 {
      mut i = 0
      while i < n {
         b = _case_emit(b, u_case_at(cp, kind, i))
         i += 1
      }
      return b
   }
   _case_emit(b, _simple(cp, kind))
}

fn _final_sigma(list<int> cps, int at) bool {
   mut before = false
   mut j = at - 1
   while j >= 0 {
      def cp = cps[j]
      if is_cased(cp) {
         before = true
         break
      }
      if !is_case_ignorable(cp) { break }
      j -= 1
   }
   if !before { return false }
   j = at + 1
   while j < cps.len {
      def cp = cps[j]
      if is_cased(cp) { return false }
      if !is_case_ignorable(cp) { return true }
      j += 1
   }
   true
}

fn _build_upper(list<int> cps, str locale) str {
   mut b = strmod.Builder(cps.len * 2 + 8)
   mut i = 0
   while i < cps.len {
      mut cp = cps[i]
      if locale == "tr" || locale == "az" {
         if cp == 0x69 { cp = 0x130 }
         elif cp == 0x131 { cp = 0x49 }
      }
      b = _mapped(b, cp, CASE_UPPER)
      i += 1
   }
   def out = strmod.builder_to_str(b)
   strmod.builder_free(b)
   out
}

fn _build_lower(list<int> cps, str locale) str {
   mut b = strmod.Builder(cps.len * 2 + 8)
   mut i = 0
   while i < cps.len {
      mut cp = cps[i]
      if locale == "tr" || locale == "az" {
         if cp == 0x49 { cp = 0x131 }
         elif cp == 0x130 { cp = 0x69 }
      } elif cp == 0x3A3 && _final_sigma(cps, i) {
         cp = 0x3C2
      }
      b = _mapped(b, cp, CASE_LOWER)
      i += 1
   }
   def out = strmod.builder_to_str(b)
   strmod.builder_free(b)
   out
}

fn _build_title(list<int> cps, str locale) str {
   mut b = strmod.Builder(cps.len * 2 + 8)
   mut first = true
   mut i = 0
   while i < cps.len {
      def cp = cps[i]
      if first && is_cased(cp) {
         b = _mapped(b, cp, CASE_TITLE)
         first = false
      } elif locale == "tr" || locale == "az" {
         if cp == 0x49 { b = _case_emit(b, 0x131) }
         elif cp == 0x130 { b = _case_emit(b, 0x69) }
         else { b = _mapped(b, cp, CASE_LOWER) }
      } else {
         b = _mapped(b, cp, CASE_LOWER)
      }
      i += 1
   }
   def out = strmod.builder_to_str(b)
   strmod.builder_free(b)
   out
}

fn _build_fold(list<int> cps, bool turkic) str {
   mut b = strmod.Builder(cps.len * 2 + 8)
   mut i = 0
   while i < cps.len {
      mut cp = cps[i]
      if turkic {
         if cp == 0x49 {
            b = _case_emit(b, 0x131)
            i += 1
            continue
         }
         if cp == 0x130 {
            b = _case_emit(b, 0x69)
            i += 1
            continue
         }
      }
      b = _mapped(b, cp, CASE_FOLD)
      i += 1
   }
   def out = strmod.builder_to_str(b)
   strmod.builder_free(b)
   out
}

fn to_upper(str s, str locale="") str {
   "Returns full Unicode uppercase. locale tr/az enables Turkic casing."
   _build_upper(code_points(s), locale)
}

fn to_lower(str s, str locale="") str {
   "Returns full Unicode lowercase. locale tr/az enables Turkic casing."
   _build_lower(code_points(s), locale)
}

fn to_title(str s, str locale="") str {
   "Returns title casing for the first cased scalar; remaining scalars are lower."
   _build_title(code_points(s), locale)
}

fn case_fold(str s, bool turkic=false) str {
   "Returns full Unicode case folding(optionally Turkic)."
   _build_fold(code_points(s), turkic)
}

;; Keywords: unicode normalize nfc nfd nfkc nfkd canonical compatibility
;; UAX #15 normalization. Hangul is algorithmic; decomposition, ordering, and
;; canonical composition use compact generated tables.
def int S_BASE = 0xAC00
def int L_BASE = 0x1100
def int V_BASE = 0x1161
def int T_BASE = 0x11A7
def int L_COUNT = 19
def int V_COUNT = 21
def int T_COUNT = 28
def int N_COUNT = 588
def int S_COUNT = 11172

fn _decompose_cp(int cp, bool compat, list<int> out) list<int> {
   def s = cp - S_BASE
   if s >= 0 && s < S_COUNT {
      def l = L_BASE + s / N_COUNT
      def v = V_BASE + (s % N_COUNT) / T_COUNT
      def t = T_BASE + s % T_COUNT
      out = out.append(l)
      out = out.append(v)
      if t != T_BASE { out = out.append(t) }
      return out
   }
   def kind = u_decomp_kind(cp)
   if kind == 1 || (compat && kind == 2) {
      def n = u_decomp_len(cp)
      mut i = 0
      while i < n {
         out = _decompose_cp(u_decomp_at(cp, i), compat, out)
         i += 1
      }
      return out
   }
   out.append(cp)
}

fn _decompose_all(list<int> cps, bool compat) list<int> {
   mut out = []
   mut i = 0
   while i < cps.len {
      out = _decompose_cp(cps[i], compat, out)
      i += 1
   }
   out
}

fn _canonical_order(list<int> cps) list<int> {
   mut out = []
   mut i = 0
   while i < cps.len {
      def cp = cps[i]
      def cc = u_ccc(cp)
      out = out.append(cp)
      if cc != 0 {
         mut j = out.len - 1
         while j > 0 {
            def prev = u_ccc(out[j - 1])
            if prev == 0 || prev <= cc { break }
            def tmp = out[j]
            out[j] = out[j - 1]
            out[j - 1] = tmp
            j -= 1
         }
      }
      i += 1
   }
   out
}

fn _hangul_compose(int a, int b) int {
   def li = a - L_BASE
   if li >= 0 && li < L_COUNT {
      def vi = b - V_BASE
      if vi >= 0 && vi < V_COUNT {
         return S_BASE + (li * V_COUNT + vi) * T_COUNT
      }
   }
   def si = a - S_BASE
   if si >= 0 && si < S_COUNT && si % T_COUNT == 0 {
      def ti = b - T_BASE
      if ti > 0 && ti < T_COUNT { return a + ti }
   }
   0
}

fn _compose_pair(int a, int b) int {
   def h = _hangul_compose(a, b)
   if h != 0 { return h }
   u_compose_pair(a, b)
}

fn _compose(list<int> cps) list<int> {
   mut out = []
   mut starter_idx = -1
   mut starter = 0
   mut last_cc = 0
   mut i = 0
   while i < cps.len {
      def cp = cps[i]
      def cc = u_ccc(cp)
      if starter_idx >= 0 && (last_cc < cc || last_cc == 0) {
         def comp = _compose_pair(starter, cp)
         if comp != 0 {
            out[starter_idx] = comp
            starter = comp
            i += 1
            continue
         }
      }
      if cc == 0 {
         starter_idx = out.len
         starter = cp
      }
      out = out.append(cp)
      last_cc = cc
      i += 1
   }
   out
}

fn _norm_emit(ptr b, int cp) ptr {
   if cp <= 0x7F { return strmod.builder_append_byte(b, cp) }
   if cp <= 0x7FF {
      b = strmod.builder_append_byte(b, 0xC0 | (cp >> 6))
      return strmod.builder_append_byte(b, 0x80 | (cp & 0x3F))
   }
   if cp <= 0xFFFF {
      b = strmod.builder_append_byte(b, 0xE0 | (cp >> 12))
      b = strmod.builder_append_byte(b, 0x80 | ((cp >> 6) & 0x3F))
      return strmod.builder_append_byte(b, 0x80 | (cp & 0x3F))
   }
   b = strmod.builder_append_byte(b, 0xF0 | (cp >> 18))
   b = strmod.builder_append_byte(b, 0x80 | ((cp >> 12) & 0x3F))
   b = strmod.builder_append_byte(b, 0x80 | ((cp >> 6) & 0x3F))
   strmod.builder_append_byte(b, 0x80 | (cp & 0x3F))
}

fn _to_string(list<int> cps) str {
   mut b = strmod.Builder(cps.len * 2 + 8)
   mut i = 0
   while i < cps.len {
      b = _norm_emit(b, cps[i])
      i += 1
   }
   def out = strmod.builder_to_str(b)
   strmod.builder_free(b)
   out
}

fn _run(str s, bool compat, bool compose) str {
   mut cps = _decompose_all(code_points(s), compat)
   cps = _canonical_order(cps)
   if compose { cps = _compose(cps) }
   _to_string(cps)
}

fn nfd(str s) str { _run(s, false, false) }

fn nfkd(str s) str { _run(s, true, false) }

fn nfc(str s) str { _run(s, false, true) }

fn nfkc(str s) str { _run(s, true, true) }

fn normalize(str s, str form="NFC") str {
   "Normalizes to NFC, NFD, NFKC, or NFKD(case-insensitive form name)."
   if form == "NFD" || form == "nfd" { return nfd(s) }
   if form == "NFKC" || form == "nfkc" { return nfkc(s) }
   if form == "NFKD" || form == "nfkd" { return nfkd(s) }
   if form == "NFC" || form == "nfc" { return nfc(s) }
   nfc(s)
}

fn is_normalized(str s, str form="NFC") bool {
   normalize(s, form) == s
}

;; Keywords: unicode segment grapheme word sentence uax29
;; UAX #29 boundaries over code-point offsets. Grapheme clusters implement the
;; complete GB3..GB999 rule set, including emoji ZWJ, regional indicators, and
;; Indic conjunct linker rules.
def int GB_OTHER = 0
def int GB_CR = 1
def int GB_LF = 2
def int GB_CONTROL = 3
def int GB_EXTEND = 4
def int GB_ZWJ = 5
def int GB_RI = 6
def int GB_PREPEND = 7
def int GB_SPACING = 8
def int GB_L = 9
def int GB_V = 10
def int GB_T = 11
def int GB_LV = 12
def int GB_LVT = 13

fn _gbp(int cp) int { u_grapheme(cp) }

fn _ep(int cp) bool { (u_prop(cp) & U_PROP_EXTENDED_PICTOGRAPHIC) != 0 }

fn _incb(int cp) int {
   def p = u_prop(cp)
   if (p & U_PROP_INCB_LINKER) != 0 { return 1 }
   if (p & U_PROP_INCB_CONSONANT) != 0 { return 2 }
   if (p & U_PROP_INCB_EXTEND) != 0 { return 3 }
   0
}

fn _gb_break(list<int> cps, int i) bool {
   if i <= 0 || i >= cps.len { return true }
   def a = cps[i - 1]
   def b = cps[i]
   def pa = _gbp(a)
   def pb = _gbp(b)
   if pa == GB_CR && pb == GB_LF { return false }
   if pa == GB_CONTROL || pa == GB_CR || pa == GB_LF { return true }
   if pb == GB_CONTROL || pb == GB_CR || pb == GB_LF { return true }
   if pa == GB_L && (pb == GB_L || pb == GB_V || pb == GB_LV || pb == GB_LVT) { return false }
   if (pa == GB_LV || pa == GB_V) && (pb == GB_V || pb == GB_T) { return false }
   if (pa == GB_LVT || pa == GB_T) && pb == GB_T { return false }
   if pb == GB_EXTEND || pb == GB_ZWJ { return false }
   if pb == GB_SPACING { return false }
   if pa == GB_PREPEND { return false }
   if pb == GB_EXTEND || pb == GB_ZWJ { return false }
   if _gb_incb_join(cps, i) { return false }
   if pb == GB_OTHER && _ep(b) && pa == GB_ZWJ {
      mut j = i - 2
      while j >= 0 && _gbp(cps[j]) == GB_EXTEND { j -= 1 }
      if j >= 0 && _ep(cps[j]) { return false }
   }
   if pa == GB_RI && pb == GB_RI {
      mut count = 0
      mut j = i - 1
      while j >= 0 && _gbp(cps[j]) == GB_RI {
         count += 1
         j -= 1
      }
      if (count & 1) == 1 { return false }
   }
   true
}

fn _gb_incb_join(list<int> cps, int i) bool {
   if _incb(cps[i]) != 2 { return false }
   mut j = i - 1
   mut linker = false
   while j >= 0 {
      def k = _incb(cps[j])
      if k == 1 { linker = true }
      elif k != 3 { break }
      j -= 1
   }
   linker && j >= 0 && _incb(cps[j]) == 2
}

fn grapheme_boundaries(str s) list<int> {
   "Returns code-point offsets at every grapheme-cluster boundary."
   def cps = code_points(s)
   mut out = [0]
   mut i = 1
   while i < cps.len {
      if _gb_break(cps, i) { out = out.append(i) }
      i += 1
   }
   if cps.len > 0 && out[out.len - 1] != cps.len { out = out.append(cps.len) }
   out
}

fn graphemes(str s) list<str> {
   def b = grapheme_boundaries(s)
   mut out = []
   mut i = 0
   while i + 1 < b.len {
      out = out.append(strmod._utf8_slice(s, b[i], b[i + 1]))
      i += 1
   }
   out
}

fn grapheme_len(str s) int {
   def b = grapheme_boundaries(s)
   if b.len == 0 { return 0 }
   b.len - 1
}

fn grapheme_count(str s) int { grapheme_len(s) }

fn grapheme_slice(str s, int start, int stop) str {
   def b = grapheme_boundaries(s)
   mut a = start
   mut z = stop
   if a < 0 { a = (b.len - 1) + a }
   if z < 0 { z = (b.len - 1) + z }
   if a < 0 { a = 0 }
   if z > b.len - 1 { z = b.len - 1 }
   if a >= z || b.len < 2 { return "" }
   strmod._utf8_slice(s, b[a], b[z])
}

def int WB_OTHER = 0
def int WB_CR = 1
def int WB_LF = 2
def int WB_NEWLINE = 3
def int WB_EXTEND = 4
def int WB_ZWJ = 5
def int WB_RI = 6
def int WB_FORMAT = 7
def int WB_KATAKANA = 8
def int WB_HEBREW = 9
def int WB_ALETTER = 10
def int WB_SINGLE = 11
def int WB_DOUBLE = 12
def int WB_MIDNUMLET = 13
def int WB_MIDLETTER = 14
def int WB_MIDNUM = 15
def int WB_NUMERIC = 16
def int WB_EXTENDNUMLET = 17
def int WB_WSEGSPACE = 18

fn _wbp(int cp) int { u_word(cp) }

fn _wb_skip(int p) bool { p == WB_EXTEND || p == WB_ZWJ || p == WB_FORMAT }

fn _wb_ah(int p) bool { p == WB_ALETTER || p == WB_HEBREW }

fn _wb_mid(int p) bool {
   p == WB_MIDLETTER || p == WB_MIDNUMLET || p == WB_SINGLE
}

fn _wb_midnum(int p) bool {
   p == WB_MIDNUM || p == WB_MIDNUMLET || p == WB_SINGLE
}

fn _wb_break(list<int> cps, int i) bool {
   if i <= 0 || i >= cps.len { return true }
   def a = cps[i - 1]
   def b = cps[i]
   def pa = _wbp(a)
   def pb = _wbp(b)
   if pa == WB_CR && pb == WB_LF { return false }
   if pa == WB_NEWLINE || pa == WB_CR || pa == WB_LF { return true }
   if pb == WB_NEWLINE || pb == WB_CR || pb == WB_LF { return true }
   if _wb_skip(pb) { return false }
   if pa == WB_ZWJ && _ep(b) { return false }
   mut j = i - 1
   while j >= 0 && _wb_skip(_wbp(cps[j])) { j -= 1 }
   if j < 0 { return true }
   def p = _wbp(cps[j])
   def pc = cps[j]
   mut k = i + 1
   while k < cps.len && _wb_skip(_wbp(cps[k])) { k += 1 }
   def n = k < cps.len ? _wbp(cps[k]) : WB_OTHER
   if _wb_ah(p) && _wb_ah(pb) { return false }
   if _wb_ah(p) && _wb_mid(pb) && _wb_ah(n) { return false }
   if p == WB_HEBREW && pb == WB_SINGLE { return false }
   if p == WB_HEBREW && pb == WB_DOUBLE && n == WB_HEBREW { return false }
   if p == WB_SINGLE && pb == WB_HEBREW {
      mut q = j - 1
      while q >= 0 && _wb_skip(_wbp(cps[q])) { q -= 1 }
      if q >= 0 && _wbp(cps[q]) == WB_HEBREW { return false }
   }
   if p == WB_DOUBLE && pb == WB_HEBREW {
      mut q = j - 1
      while q >= 0 && _wb_skip(_wbp(cps[q])) { q -= 1 }
      if q >= 0 && _wbp(cps[q]) == WB_HEBREW { return false }
   }
   if p == WB_NUMERIC && pb == WB_NUMERIC { return false }
   if _wb_ah(p) && pb == WB_NUMERIC { return false }
   if p == WB_NUMERIC && _wb_ah(pb) { return false }
   if p == WB_NUMERIC && _wb_midnum(pb) && n == WB_NUMERIC { return false }
   if _wb_midnum(p) && pb == WB_NUMERIC {
      mut q = j - 1
      while q >= 0 && _wb_skip(_wbp(cps[q])) { q -= 1 }
      if q >= 0 && _wbp(cps[q]) == WB_NUMERIC { return false }
   }
   if p == WB_KATAKANA && pb == WB_KATAKANA { return false }
   if (p == WB_ALETTER || p == WB_HEBREW || p == WB_NUMERIC ||
      p == WB_KATAKANA || p == WB_EXTENDNUMLET) && pb == WB_EXTENDNUMLET { return false }
   if p == WB_EXTENDNUMLET && (pb == WB_ALETTER || pb == WB_HEBREW ||
      pb == WB_NUMERIC || pb == WB_KATAKANA) { return false }
   if p == WB_RI && pb == WB_RI {
      mut count = 0
      mut q = j
      while q >= 0 && _wbp(cps[q]) == WB_RI {
         count += 1
         q -= 1
      }
      if (count & 1) == 1 { return false }
   }
   true
}

fn word_boundaries(str s) list<int> {
   def cps = code_points(s)
   mut out = [0]
   mut i = 1
   while i < cps.len {
      if _wb_break(cps, i) { out = out.append(i) }
      i += 1
   }
   if cps.len > 0 && out[out.len - 1] != cps.len { out = out.append(cps.len) }
   out
}

fn words(str s) list<str> {
   def b = word_boundaries(s)
   mut out = []
   mut i = 0
   while i + 1 < b.len {
      out = out.append(strmod._utf8_slice(s, b[i], b[i + 1]))
      i += 1
   }
   out
}

def int SB_OTHER = 0
def int SB_CR = 1
def int SB_LF = 2
def int SB_EXTEND = 3
def int SB_SEP = 4
def int SB_FORMAT = 5
def int SB_SP = 6
def int SB_LOWER = 7
def int SB_UPPER = 8
def int SB_OLETTER = 9
def int SB_NUMERIC = 10
def int SB_ATERM = 11
def int SB_SCONTINUE = 12
def int SB_STERM = 13
def int SB_CLOSE = 14

fn _sbp(int cp) int { u_sentence(cp) }

fn _sb_skip(int p) bool { p == SB_EXTEND || p == SB_FORMAT }

fn _sb_term(int p) bool { p == SB_ATERM || p == SB_STERM }

fn _sb_letter(int p) bool {
   p == SB_LOWER || p == SB_UPPER || p == SB_OLETTER
}

fn _sb_prev(list<int> cps, int at) int {
   mut q = at - 1
   while q >= 0 && _sb_skip(_sbp(cps[q])) { q -= 1 }
   q
}

fn _sb_term_before(list<int> cps, int at) int {
   "Returns the index of the terminal starting a Close* Sp* run, or -1."
   mut q = at
   while q >= 0 && _sbp(cps[q]) == SB_SP { q = _sb_prev(cps, q) }
   while q >= 0 && _sbp(cps[q]) == SB_CLOSE { q = _sb_prev(cps, q) }
   if q >= 0 && _sb_term(_sbp(cps[q])) { return q }
   -1
}

fn _sb_break(list<int> cps, int i) bool {
   if i <= 0 || i >= cps.len { return true }
   def a = cps[i - 1]
   def b = cps[i]
   def pa = _sbp(a)
   def pb = _sbp(b)
   if pa == SB_CR && pb == SB_LF { return false }
   if pa == SB_SEP || pa == SB_CR || pa == SB_LF { return true }
   if pb == SB_SEP || pb == SB_CR || pb == SB_LF { return true }
   if _sb_skip(pb) { return false }
   mut j = i - 1
   while j >= 0 && _sb_skip(_sbp(cps[j])) { j -= 1 }
   if j < 0 { return true }
   def p = _sbp(cps[j])
   if p == SB_ATERM && pb == SB_NUMERIC { return false }
   if p == SB_ATERM && pb == SB_UPPER {
      def q = _sb_prev(cps, j)
      if q >= 0 && ( _sbp(cps[q]) == SB_UPPER || _sbp(cps[q]) == SB_LOWER ) {
         return false
      }
   }
   def term = _sb_term_before(cps, j)
   if term < 0 { return false }
   if pb == SB_SCONTINUE || _sb_term(pb) { return false }
   if pb == SB_CLOSE || pb == SB_SP { return false }
   if _sbp(cps[term]) == SB_ATERM {
      mut k = i
      while k < cps.len {
         def q = _sbp(cps[k])
         if _sb_skip(q) {
            k += 1
            continue
         }
         if q == SB_LOWER { return false }
         if q == SB_OLETTER || q == SB_UPPER || q == SB_SEP || q == SB_CR || q == SB_LF || _sb_term(q) { break }
         k += 1
      }
   }
   true
}

fn sentence_boundaries(str s) list<int> {
   def cps = code_points(s)
   mut out = [0]
   mut i = 1
   while i < cps.len {
      if _sb_break(cps, i) { out = out.append(i) }
      i += 1
   }
   if cps.len > 0 && out[out.len - 1] != cps.len { out = out.append(cps.len) }
   out
}

fn sentences(str s) list<str> {
   def b = sentence_boundaries(s)
   mut out = []
   mut i = 0
   while i + 1 < b.len {
      out = out.append(strmod._utf8_slice(s, b[i], b[i + 1]))
      i += 1
   }
   out
}

;; Keywords: unicode security confusable skeleton mixed script identifier
;; UTS #39 identifier security. Expensive skeleton work is deliberately
;; separate from ordinary text and property operations.
fn _security_emit(ptr b, int cp) ptr {
   if cp <= 0x7F { return strmod.builder_append_byte(b, cp) }
   if cp <= 0x7FF {
      b = strmod.builder_append_byte(b, 0xC0 | (cp >> 6))
      return strmod.builder_append_byte(b, 0x80 | (cp & 0x3F))
   }
   if cp <= 0xFFFF {
      b = strmod.builder_append_byte(b, 0xE0 | (cp >> 12))
      b = strmod.builder_append_byte(b, 0x80 | ((cp >> 6) & 0x3F))
      return strmod.builder_append_byte(b, 0x80 | (cp & 0x3F))
   }
   b = strmod.builder_append_byte(b, 0xF0 | (cp >> 18))
   b = strmod.builder_append_byte(b, 0x80 | ((cp >> 12) & 0x3F))
   b = strmod.builder_append_byte(b, 0x80 | ((cp >> 6) & 0x3F))
   strmod.builder_append_byte(b, 0x80 | (cp & 0x3F))
}

fn _skeleton_pass(list<int> cps) str {
   mut b = strmod.Builder(cps.len * 2 + 8)
   mut i = 0
   while i < cps.len {
      def cp = cps[i]
      if !is_default_ignorable(cp) {
         def n = u_conf_len(cp)
         if n > 0 {
            mut k = 0
            while k < n {
               b = _security_emit(b, u_conf_at(cp, k))
               k += 1
            }
         } else {
            b = _security_emit(b, cp)
         }
      }
      i += 1
   }
   def out = strmod.builder_to_str(b)
   strmod.builder_free(b)
   out
}

fn skeleton(str s) str {
   "Returns the UTS #39 confusable skeleton(NFD, map, drop ignorables, NFD)."
   def first = _skeleton_pass(code_points(nfd(s)))
   nfd(first)
}

fn is_confusable(str a, str b) bool {
   "True when two strings share a confusable skeleton."
   skeleton(a) == skeleton(b)
}

fn has_suspicious_invisible(str s) bool {
   def cps = code_points(s)
   mut i = 0
   while i < cps.len {
      def cp = cps[i]
      if is_default_ignorable(cp) || is_bidi_control(cp) {
         return true
      }
      i += 1
   }
   false
}

fn has_bidi_control(str s) bool {
   def cps = code_points(s)
   mut i = 0
   while i < cps.len {
      if is_bidi_control(cps[i]) { return true }
      i += 1
   }
   false
}

fn is_mixed_script(str s) bool {
   def cps = code_points(s)
   mut seen = ""
   mut i = 0
   while i < cps.len {
      def name = script(cps[i])
      if name != "Common" && name != "Inherited" && name != "Unknown" {
         if seen == "" { seen = name }
         elif seen != name { return true }
      }
      i += 1
   }
   false
}

fn is_identifier_allowed(str s) bool {
   "Checks XID_Start/XID_Continue plus UTS #39 IdentifierStatus=Allowed."
   def cps = code_points(s)
   if cps.len == 0 { return false }
   mut i = 0
   while i < cps.len {
      def cp = cps[i]
      if i == 0 {
         if !is_xid_start(cp) { return false }
      } elif !is_xid_continue(cp) {
         return false
      }
      if !u_id_allowed(cp) { return false }
      i += 1
   }
   true
}

fn identifier_type(int cp) str {
   case u_id_type(cp) {
      1 -> "Not_XID"
      2 -> "Not_NFKC"
      3 -> "Exclusion"
      4 -> "Obsolete"
      5 -> "Technical"
      6 -> "Uncommon_Use"
      _ -> "Allowed"
   }
}
