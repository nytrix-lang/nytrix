CompileFlags:
  CompilationDatabase: ./build/release
  Add:
    - -std=c11
    - -Ibuild
    - -Isrc
    - -Isrc/base
    - -Isrc/code
    - -Isrc/code/lang
    - -Isrc/code/lang/c/parser
    - -Isrc/code/lang/ny/parser
    - -Isrc/code/lang/ny/semantics
    - -Isrc/cmd/ny/repl
    - -Isrc/code/backend/runtime
    - -Isrc/code/backend/core
    - -Isrc/code/backend/lower
    - -Isrc/code/backend/mach
    - -D_GNU_SOURCE

Diagnostics:
  Suppress:
    - unused-parameter
