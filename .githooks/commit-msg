#!/bin/sh
set -eu

message_file=${1:?commit message path is required}
subject=$(sed -n '/^[^#[:space:]]/ {p; q;}' "$message_file")

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

length=${#subject}
if [ "$length" -gt 72 ]; then
  printf '%s\n' "commit-msg: subject is ${length} characters; limit is 72." >&2
  exit 1
fi

case "$subject" in
  build\(*\):*|chore\(*\):*|ci\(*\):*|docs\(*\):*|feat\(*\):*|fix\(*\):*|\
  perf\(*\):*|refactor\(*\):*|style\(*\):*|test\(*\):*)
    ;;
  *)
    printf '%s\n' "commit-msg: use '<type>(scope): concise imperative summary'." >&2
    printf '%s\n' "Scope is required. Allowed types: build, chore, ci, docs, feat, fix, perf, refactor, style, test." >&2
    exit 1
    ;;
esac

case "$subject" in
  *.)
    printf '%s\n' "commit-msg: omit the trailing period from the subject." >&2
    exit 1
    ;;
esac
