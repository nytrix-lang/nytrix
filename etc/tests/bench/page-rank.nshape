shape page-rank {
  family "perf-real"
  generator "stress"
  features ["perf", "graph", "fp", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
use std.core.tbuf
;; Power-iteration PageRank on a star graph (all nodes -> node 0).
def N = 100
def ITERS = 50
def damping = 0.85
mut rank = f64buf_new(N)
mut newrank = f64buf_new(N)
mut i = 0
while i < N {
   f64buf_store(rank, i, 1.0 / float(N))
   i += 1
}
def t0 = ticks()
mut it = 0
while it < ITERS {
   mut j = 0
   while j < N {
      f64buf_store(newrank, j, (1.0 - damping) / float(N))
      j += 1
   }
   i = 0
   while i < N {
      def contrib = f64buf_load(rank, i) * damping
      f64buf_store(newrank, 0, f64buf_load(newrank, 0) + contrib)
      i += 1
   }
   def tmp = rank
   rank = newrank
   newrank = tmp
   it += 1
}
def t1 = ticks()
mut argmax = 0
mut best = f64buf_load(rank, 0)
i = 1
while i < N {
   def v = f64buf_load(rank, i)
   if v > best {
      best = v
      argmax = i
   }
   i += 1
}
print("checksum=", argmax)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    int N = 100, ITERS = 50;
    double damping = 0.85;
    double *rank = (double *)malloc((size_t)N * sizeof(double));
    double *newrank = (double *)malloc((size_t)N * sizeof(double));
    for (int i = 0; i < N; i++) { rank[i] = 1.0 / N; newrank[i] = 0.0; }
    int64_t start = now_ns();
    for (int it = 0; it < ITERS; it++) {
        for (int j = 0; j < N; j++) newrank[j] = (1.0 - damping) / N;
        for (int i = 0; i < N; i++) {
            double contrib = rank[i] * damping;
            newrank[0] += contrib;
        }
        double *tmp = rank; rank = newrank; newrank = tmp;
    }
    int64_t end = now_ns();
    int argmax = 0;
    double best = rank[0];
    for (int i = 1; i < N; i++)
        if (rank[i] > best) { best = rank[i]; argmax = i; }
    printf("checksum=%d\n", argmax);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
