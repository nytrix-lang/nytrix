shape heapsort {
  family "perf-real"
  generator "stress"
  features ["perf", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
;; Heapsort over an i64 array (classic comparison-sort benchmark).
fn sift_down(list a, int root, int count) int {
   mut p = root
   while true {
      def l = 2 * p + 1
      def r = 2 * p + 2
      mut m = p
      if l < count && a[l] > a[m] { m = l }
      if r < count && a[r] > a[m] { m = r }
      if m == p { break }
      def t = a[p]
      a[p] = a[m]
      a[m] = t
      p = m
   }
   0
}
def N = 50000
mut a = []
mut seed = 42
mut i = 0
while i < N {
   seed = (seed * 3877 + 29573) % 139968
   a = append(a, seed)
   i += 1
}
def t0 = ticks()
i = N / 2 - 1
while i >= 0 {
   sift_down(a, i, N)
   i -= 1
}
i = N - 1
while i > 0 {
   def t = a[0]
   a[0] = a[i]
   a[i] = t
   sift_down(a, 0, i)
   i -= 1
}
mut ck = 0
i = 0
while i < N {
   ck += a[i] * (i + 1)
   i += 1
}
def t1 = ticks()
print("checksum=", ck)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static void sift(int64_t *a, int root, int count) {
    int p = root;
    while (1) {
        int l = 2 * p + 1, r = 2 * p + 2, m = p;
        if (l < count && a[l] > a[m]) m = l;
        if (r < count && a[r] > a[m]) m = r;
        if (m == p) break;
        int64_t t = a[p]; a[p] = a[m]; a[m] = t;
        p = m;
    }
}

int main(void) {
    const int N = 50000;
    int64_t *a = malloc((size_t)N * sizeof(int64_t));
    int seed = 42;
    for (int i = 0; i < N; i++) {
        seed = (seed * 3877 + 29573) % 139968;
        a[i] = seed;
    }
    int64_t start = now_ns();
    for (int i = N / 2 - 1; i >= 0; i--) sift(a, i, N);
    for (int i = N - 1; i > 0; i--) {
        int64_t t = a[0]; a[0] = a[i]; a[i] = t;
        sift(a, 0, i);
    }
    int64_t ck = 0;
    for (int i = 0; i < N; i++) ck += a[i] * (int64_t)(i + 1);
    int64_t end = now_ns();
    free(a);
    printf("checksum=%lld\n", (long long)ck);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
