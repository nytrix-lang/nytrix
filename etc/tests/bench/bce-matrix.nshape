shape bce-matrix {
  family "perf-real"
  generator "stress"
  features ["perf", "bounds-check", "bce", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
;; 2D traversal with indexed access: tests bounds-check elimination.
def M = 100
mut a = []
mut i = 0
while i < M * M {
   a = append(a, i)
   i += 1
}
def t0 = ticks()
mut acc = 0
mut r = 0
while r < M {
   mut cc = 0
   while cc < M {
      acc += a[r * M + cc]
      cc += 1
   }
   r += 1
}
def t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    int M = 100;
    long *a = (long *)malloc((size_t)M * M * sizeof(long));
    for (int i = 0; i < M * M; i++) a[i] = i;
    int64_t start = now_ns();
    long acc = 0;
    for (int r = 0; r < M; r++)
        for (int c = 0; c < M; c++)
            acc += a[r * M + c];
    int64_t end = now_ns();
    printf("checksum=%ld\n", acc);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
