shape sieve-raw {
  family "perf-real"
  generator "stress"
  features ["perf", "raw-buffer", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
def N = 60000
fn sieve(int n) int {
 if n < 2 { return 0 }
 def size = (n >> 1) + 1
 def flags = malloc(size)
 mut i = 0
 while i < size {
  store8(flags, 1, i)
  i += 1
 }
 mut count = 1
 mut p = 3
 while p * p <= n {
  if load8(flags, p >> 1) {
   def sq = p * p
   mut mul = sq
   while mul <= n {
    store8(flags, 0, mul >> 1)
    mul += p * 2
   }
  }
  p += 2
 }
 i = 3
 while i <= n {
  if load8(flags, i >> 1) { count += 1 }
  i += 2
 }
 free(flags)
 count
}
def t0 = ticks()
def r = sieve(N)
def t1 = ticks()
print("checksum=", r)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
static int64_t now_ns(void) {
 struct timespec ts;
 clock_gettime(CLOCK_MONOTONIC, &ts);
 return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}
int main(void) {
 const int n = 60000;
 const int size = (n >> 1) + 1;
 unsigned char *flags = malloc((size_t)size);
 if (!flags) return 2;
 int64_t start = now_ns();
 memset(flags, 1, (size_t)size);
 int count = 1;
 for (int p = 3; p * p <= n; p += 2) {
  if (flags[p >> 1])
   for (int mul = p * p; mul <= n; mul += p * 2) flags[mul >> 1] = 0;
 }
 for (int i = 3; i <= n; i += 2) if (flags[i >> 1]) ++count;
 int64_t end = now_ns();
 free(flags);
 printf("checksum=%d\n", count);
 printf("elapsed_ns=%lld\n", (long long)(end - start));
 return 0;
}
C
}
