shape vector {
  family "perf-real"
  generator "stress"
  features ["perf", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
;; Vector Benchmark: element-wise multiply over Ny lists.
def n = 65536 * argc()
def rounds = 2
mut a = []
mut b = []
mut c = []
mut i = 0
while i < n {
   a = append(a, i + 1)
   b = append(b, i + 3)
   c = append(c, 0)
   i += 1
}
def t0 = ticks()
mut acc = 0
mut r = 0
while r < rounds {
   mut i2 = 0
   while i2 < n {
      c[i2] = a[i2] * b[i2]
      i2 += 1
   }
   acc += c[0] + c[n - 1]
   r += 1
}
def t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(int argc, char **argv) {
    (void)argv;
    const int n = 65536 * argc, rounds = 2;
    int64_t *a = (int64_t *)malloc((size_t)n * sizeof(int64_t));
    int64_t *b = (int64_t *)malloc((size_t)n * sizeof(int64_t));
    int64_t *c = (int64_t *)malloc((size_t)n * sizeof(int64_t));
    if (!a || !b || !c) return 2;
    for (int i = 0; i < n; i++) { a[i] = i + 1; b[i] = i + 3; }
    int64_t start = now_ns();
    int64_t acc = 0;
    for (int r = 0; r < rounds; r++) {
        for (int i = 0; i < n; i++) c[i] = a[i] * b[i];
        acc += c[0] + c[n - 1];
    }
    int64_t end = now_ns();
    free(a); free(b); free(c);
    printf("checksum=%lld\n", (long long)acc);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
