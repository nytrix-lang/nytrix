shape bench_matrix {
  family "perf-real"
  generator "stress"
  features ["perf", "matrix", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
def int n = 128
def row = malloc(n * 8)
def col = malloc(n * 8)
if row == 0 || col == 0 { panic("matrix buffer allocation failed") }
def int t0 = ticks()
mut int acc = 0
mut int i = 0
while i < n {
  mut int j = 0
  while j < n {
    store64_i(row, i * n + j, j * 8)
    store64_i(col, j * n + i, j * 8)
    j += 1
  }
  mut int k = 0
  mut int product = 0
  while k < n {
    product += load64_i(row, k * 8) * load64_i(col, k * 8)
    k += 1
  }
  acc += product
  i += 1
}
def int t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
free(row)
free(col)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int64_t dot(const int64_t *a, const int64_t *b, int n) {
  int64_t s = 0;
  for (int i = 0; i < n; i++)
    s += (int64_t)a[i] * b[i];
  return s;
}

int main(void) {
  const int n = 128;
  int64_t *row = (int64_t *)malloc(128 * sizeof(int64_t));
  int64_t *col = (int64_t *)malloc(128 * sizeof(int64_t));
  if (!row || !col) return 2;
  int64_t t0 = now_ns();
  int64_t acc = 0;
  for (int i = 0; i < n; i++) {
    for (int j = 0; j < n; j++) {
      row[j] = (int64_t)i * n + j;
      col[j] = (int64_t)j * n + i;
    }
    acc += dot(row, col, n);
  }
  int64_t t1 = now_ns();
  free(row);
  free(col);
  printf("checksum=%lld\n", (long long)acc);
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
