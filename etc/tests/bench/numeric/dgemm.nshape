shape dgemm {
  family "perf-real"
  generator "stress"
  features ["perf", "fp", "matmul", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core.os.time
use core.tbuf
;; Dense double matrix multiply (64x64): integer-valued inputs keep results exact.
def M = 64
def A = f64buf_new(M * M)
def B = f64buf_new(M * M)
def C = f64buf_new(M * M)
mut i = 0
while i < M * M {
   f64buf_store(A, i, float((i / M) + 1))
   f64buf_store(B, i, float((i % M) + 1))
   f64buf_store(C, i, 0.0)
   i += 1
}
def int t0 = ticks()
mut r = 0
while r < M {
   mut k = 0
   ;; Unroll four k rows while preserving each output's ascending-k sum order.
   ;; Keep the scalar tail so a future non-multiple M remains correct.
   while k < M - 3 {
      def a0 = f64buf_load(A, r * M + k)
      def a1 = f64buf_load(A, r * M + k + 1)
      def a2 = f64buf_load(A, r * M + k + 2)
      def a3 = f64buf_load(A, r * M + k + 3)
      mut cc = 0
      while cc < M {
         def cidx = r * M + cc
         def bidx = k * M + cc
         f64buf_store(C, cidx,
                      f64buf_load(C, cidx) + a0 * f64buf_load(B, bidx))
         f64buf_store(C, cidx,
                      f64buf_load(C, cidx) + a1 * f64buf_load(B, bidx + M))
         f64buf_store(C, cidx,
                      f64buf_load(C, cidx) + a2 * f64buf_load(B, bidx + 2 * M))
         f64buf_store(C, cidx,
                      f64buf_load(C, cidx) + a3 * f64buf_load(B, bidx + 3 * M))
         cc += 1
      }
      k += 4
   }
   while k < M {
      def a = f64buf_load(A, r * M + k)
      mut cc = 0
      while cc < M {
         def cidx = r * M + cc
         f64buf_store(C, cidx,
                      f64buf_load(C, cidx) + a * f64buf_load(B, k * M + cc))
         cc += 1
      }
      k += 1
   }
   r += 1
}
def int t1 = ticks()
;; Verify the entire result matrix exactly (values are exact integers).
mut conv = 1
mut r2 = 0
while r2 < M {
   mut c2 = 0
   while c2 < M {
      def val = f64buf_load(C, r2 * M + c2)
      if val != float(M * (r2 + 1) * (c2 + 1)) { conv = 0 }
      c2 += 1
   }
   r2 += 1
}
print("checksum=", conv)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    int M = 64;
    double *A = (double *)malloc((size_t)M * M * sizeof(double));
    double *B = (double *)malloc((size_t)M * M * sizeof(double));
    double *C = (double *)malloc((size_t)M * M * sizeof(double));
    for (int i = 0; i < M * M; i++) {
        A[i] = (double)((i / M) + 1);
        B[i] = (double)((i % M) + 1);
        C[i] = 0.0;
    }
    int64_t start = now_ns();
    for (int r = 0; r < M; r++) {
        int k = 0;
        for (; k < M - 3; k += 4) {
            double a0 = A[r * M + k];
            double a1 = A[r * M + k + 1];
            double a2 = A[r * M + k + 2];
            double a3 = A[r * M + k + 3];
            for (int c = 0; c < M; c++) {
                int cidx = r * M + c;
                int bidx = k * M + c;
                C[cidx] += a0 * B[bidx];
                C[cidx] += a1 * B[bidx + M];
                C[cidx] += a2 * B[bidx + 2 * M];
                C[cidx] += a3 * B[bidx + 3 * M];
            }
        }
        for (; k < M; k++) {
            double a = A[r * M + k];
            for (int c = 0; c < M; c++)
                C[r * M + c] += a * B[k * M + c];
        }
    }
    int64_t end = now_ns();
    int conv = 1;
    for (int r = 0; r < M; r++)
        for (int c = 0; c < M; c++)
            if (C[r * M + c] != (double)(M * (r + 1) * (c + 1))) conv = 0;
    printf("checksum=%d\n", conv);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
