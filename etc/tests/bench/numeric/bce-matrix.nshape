shape bce-matrix {
  family "perf-real"
  generator "stress"
  features ["perf", "bounds-check", "bce", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  flags_matrix "--native-only --native-backend=x86_64 --native-tier=opt -O3 --nyir-verify"
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time

;; Keep the buffer and its append loop in function-local storage so the
;; optimizer can prove its allocation lineage without assuming that a
;; module-global symbol cannot be changed through an unknown alias.
fn matrix_sum() int {
   ;; 2D traversal with indexed access: tests bounds-check elimination.
   def M = 100
   mut list<int> a = []
   mut int i = 0
   while i < M * M {
      a = append(a, i)
      i += 1
   }
   assert(a.len() >= M * M, "matrix fill must produce the indexed length")
   def int t0 = ticks()
   mut int acc = 0
   mut int r = 0
   while r < M {
      mut int cc = 0
      while cc < M {
         acc += a[r * M + cc]
         cc += 1
      }
      r += 1
   }
   def int t1 = ticks()
   print("checksum=", acc)
   print("bench_elapsed_ns=", t1 - t0)
   0
}
def _matrix_checksum = matrix_sum()
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    int M = 100;
    long *a = (long *)malloc((size_t)M * M * sizeof(long));
    for (int i = 0; i < M * M; i++) a[i] = i;
    int64_t start = now_ns();
    long acc = 0;
    for (int r = 0; r < M; r++)
        for (int c = 0; c < M; c++)
            acc += a[r * M + c];
    int64_t end = now_ns();
    printf("checksum=%ld\n", acc);
    if (end <= start) end = start + 1;
    printf("bench_elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
