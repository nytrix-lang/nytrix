shape pbkdf2 {
  family "perf-real"
  generator "stress"
  features ["perf", "crypto", "pbkdf2", "hmac", "bitwise", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  budget {
    max_native_c_ratio 25.0
  }
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
use core.math.simmd (sha256_blocks)
;; PBKDF2-HMAC-SHA256 (RFC 2898): password "password", salt "salt", 1000
;; iterations, 32-byte derived key. SHA-256 compression uses the portable
;; block API; HMAC caches the inner and outer pad-block states.

fn zeros(int n) ptr {
   return i64buf_new(n)
}

fn sha256_init(ptr state) {
   store32(state, 0x6a09e667, 0)
   store32(state, 0xbb67ae85, 4)
   store32(state, 0x3c6ef372, 8)
   store32(state, 0xa54ff53a, 12)
   store32(state, 0x510e527f, 16)
   store32(state, 0x9b05688c, 20)
   store32(state, 0x1f83d9ab, 24)
   store32(state, 0x5be0cd19, 28)
}

fn sha256_digest(ptr state, ptr out) {
   mut i = 0
   while i < 8 {
      def word = load32(state, i * 4)
      i64buf_store(out, i * 4, (word >> 24) & 0xFF)
      i64buf_store(out, i * 4 + 1, (word >> 16) & 0xFF)
      i64buf_store(out, i * 4 + 2, (word >> 8) & 0xFF)
      i64buf_store(out, i * 4 + 3, word & 0xFF)
      i += 1
   }
}

;; Generic SHA-256: hashes len bytes of msg, writes 32 digest bytes to out.
fn sha256(ptr msg, int len, ptr out, ptr buf, ptr state) {
   def padded = ((len + 8) / 64 + 1) * 64
   mut i = 0
   while i < padded {
      store8(buf, 0, i)
      i += 1
   }
   i = 0
   while i < len {
      store8(buf, i64buf_load(msg, i) & 0xFF, i)
      i += 1
   }
   store8(buf, 0x80, len)
   def bitlen = len * 8
   i = 0
   while i < 8 {
      store8(buf, (bitlen >> (8 * i)) & 0xFF, padded - 1 - i)
      i += 1
   }
   sha256_init(state)
   sha256_blocks(state, buf, padded / 64)
   sha256_digest(state, out)
}

;; HMAC-SHA256: writes 32 bytes to out.
fn hmac_sha256(ptr data, int dlen, ptr out, ptr inner, ptr ih, ptr outer,
               ptr sha_buf, ptr state, ptr inner_base, ptr outer_base) {
   if dlen > 55 {
      mut i = 0
      while i < dlen {
         i64buf_store(inner, 64 + i, i64buf_load(data, i) & 0xFF)
         i += 1
      }
      sha256(inner, 64 + dlen, ih, sha_buf, state)
      i = 0
      while i < 32 {
         i64buf_store(outer, 64 + i, i64buf_load(ih, i))
         i += 1
      }
      sha256(outer, 96, out, sha_buf, state)
      return
   }
   mut i = 0
   while i < 64 {
      store8(sha_buf, 0, i)
      i += 1
   }
   i = 0
   while i < dlen {
      store8(sha_buf, i64buf_load(data, i) & 0xFF, i)
      i += 1
   }
   store8(sha_buf, 0x80, dlen)
   def inner_bitlen = (64 + dlen) * 8
   i = 0
   while i < 8 {
      store8(sha_buf, (inner_bitlen >> (8 * i)) & 0xFF, 63 - i)
      i += 1
   }
   memcpy(state, inner_base, 32)
   sha256_blocks(state, sha_buf, 1)
   sha256_digest(state, ih)
   i = 0
   while i < 64 {
      store8(sha_buf, 0, i)
      i += 1
   }
   i = 0
   while i < 32 {
      store8(sha_buf, i64buf_load(ih, i), i)
      i += 1
   }
   store8(sha_buf, 0x80, 32)
   i = 0
   while i < 8 {
      store8(sha_buf, 768 >> (8 * i) & 0xFF, 63 - i)
      i += 1
   }
   memcpy(state, outer_base, 32)
   sha256_blocks(state, sha_buf, 1)
   sha256_digest(state, out)
}

;; PBKDF2-HMAC-SHA256 with 32-byte derived key.
fn pbkdf2(ptr pw, int pwlen, ptr salt, int saltlen, int iters, ptr out) {
   def s = zeros(saltlen + 4)
   mut data_capacity = saltlen + 4
   if data_capacity < 32 { data_capacity = 32 }
   mut sha_msg_capacity = pwlen
   if sha_msg_capacity < 64 + data_capacity {
      sha_msg_capacity = 64 + data_capacity
   }
   if sha_msg_capacity < 96 { sha_msg_capacity = 96 }
   def sha_buf = malloc(((sha_msg_capacity + 8) / 64 + 1) * 64)
   def state = malloc(32)
   def inner_base = malloc(32)
   def outer_base = malloc(32)
   def kp = zeros(64)
   def inner = zeros(64 + data_capacity)
   def ih = zeros(32)
   def outer = zeros(96)
   mut i = 0
   while i < 64 {
      i64buf_store(kp, i, 0)
      i += 1
   }
   mut keylen = pwlen
   if keylen > 64 {
      sha256(pw, keylen, kp, sha_buf, state)
      keylen = 32
   } else {
      i = 0
      while i < keylen {
         i64buf_store(kp, i, i64buf_load(pw, i) & 0xFF)
         i += 1
      }
   }
   i = 0
   while i < 64 {
      i64buf_store(inner, i, i64buf_load(kp, i) ^ 0x36)
      i64buf_store(outer, i, i64buf_load(kp, i) ^ 0x5c)
      i += 1
   }
   sha256_init(inner_base)
   i = 0
   while i < 64 {
      store8(sha_buf, i64buf_load(inner, i), i)
      i += 1
   }
   sha256_blocks(inner_base, sha_buf, 1)
   sha256_init(outer_base)
   i = 0
   while i < 64 {
      store8(sha_buf, i64buf_load(outer, i), i)
      i += 1
   }
   sha256_blocks(outer_base, sha_buf, 1)
   i = 0
   while i < saltlen {
      i64buf_store(s, i, i64buf_load(salt, i) & 0xFF)
      i += 1
   }
   i64buf_store(s, saltlen, 0)
   i64buf_store(s, saltlen + 1, 0)
   i64buf_store(s, saltlen + 2, 0)
   i64buf_store(s, saltlen + 3, 1)
   def u = zeros(32)
   hmac_sha256(s, saltlen + 4, u, inner, ih, outer,
               sha_buf, state, inner_base, outer_base)
   i = 0
   while i < 32 {
      i64buf_store(out, i, i64buf_load(u, i))
      i += 1
   }
   def prev = zeros(32)
   mut it = 1
   while it < iters {
      i = 0
      while i < 32 {
         i64buf_store(prev, i, i64buf_load(u, i))
         i += 1
      }
      hmac_sha256(prev, 32, u, inner, ih, outer,
                  sha_buf, state, inner_base, outer_base)
      i = 0
      while i < 32 {
         i64buf_store(out, i, i64buf_load(out, i) ^ i64buf_load(u, i))
         i += 1
      }
      it += 1
   }
   free(state)
   free(inner_base)
   free(outer_base)
   free(sha_buf)
}

def password = zeros(8)
i64buf_store(password, 0, 112)
i64buf_store(password, 1, 97)
i64buf_store(password, 2, 115)
i64buf_store(password, 3, 115)
i64buf_store(password, 4, 119)
i64buf_store(password, 5, 111)
i64buf_store(password, 6, 114)
i64buf_store(password, 7, 100)
def salt = zeros(4)
i64buf_store(salt, 0, 115)
i64buf_store(salt, 1, 97)
i64buf_store(salt, 2, 108)
i64buf_store(salt, 3, 116)
def int t0 = ticks()
def dk = zeros(32)
pbkdf2(password, 8, salt, 4, 1000, dk)
def int t1 = ticks()
mut ck = 0
mut i = 0
while i < 32 {
   ck += i64buf_load(dk, i)
   i += 1
}
print("checksum=", ck)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static uint32_t rotr(uint32_t x, uint32_t n) { return (x >> n) | (x << (32 - n)); }

static const uint32_t K[64] = {
    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
};

static void sha256(const uint8_t *data, size_t len, uint8_t out[32]) {
    size_t padded = ((len + 8) / 64 + 1) * 64;
    /* buf[256] is safe while padded <= 256, i.e. len <= 240. */
    uint8_t buf[256] = {0};
    memcpy(buf, data, len);
    buf[len] = 0x80;
    uint64_t bitlen = (uint64_t)len * 8;
    for (int i = 0; i < 8; i++) buf[padded - 1 - i] = (uint8_t)(bitlen >> (8 * i));
    uint32_t H[8] = {
        0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
        0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19
    };
    for (size_t off = 0; off < padded; off += 64) {
        uint32_t w[64];
        for (int i = 0; i < 16; i++)
            w[i] = ((uint32_t)buf[off + i*4] << 24) | ((uint32_t)buf[off + i*4+1] << 16) |
                   ((uint32_t)buf[off + i*4+2] << 8) | (uint32_t)buf[off + i*4+3];
        for (int i = 16; i < 64; i++) {
            uint32_t s0 = rotr(w[i-15],7) ^ rotr(w[i-15],18) ^ (w[i-15] >> 3);
            uint32_t s1 = rotr(w[i-2],17) ^ rotr(w[i-2],19) ^ (w[i-2] >> 10);
            w[i] = w[i-16] + s0 + w[i-7] + s1;
        }
        uint32_t a=H[0],b=H[1],c=H[2],d=H[3],e=H[4],f=H[5],g=H[6],h=H[7];
        for (int i = 0; i < 64; i++) {
            uint32_t S1 = rotr(e,6) ^ rotr(e,11) ^ rotr(e,25);
            uint32_t ch = (e & f) ^ ((~e) & g);
            uint32_t t1 = h + S1 + ch + K[i] + w[i];
            uint32_t S0 = rotr(a,2) ^ rotr(a,13) ^ rotr(a,22);
            uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
            uint32_t t2 = S0 + maj;
            h=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2;
        }
        H[0]+=a; H[1]+=b; H[2]+=c; H[3]+=d; H[4]+=e; H[5]+=f; H[6]+=g; H[7]+=h;
    }
    for (int i = 0; i < 8; i++) {
        out[i*4]   = (uint8_t)(H[i] >> 24);
        out[i*4+1] = (uint8_t)(H[i] >> 16);
        out[i*4+2] = (uint8_t)(H[i] >> 8);
        out[i*4+3] = (uint8_t)H[i];
    }
}

static void hmac_sha256(const uint8_t *key, size_t klen, const uint8_t *data,
                        size_t dlen, uint8_t out[32]) {
    uint8_t kp[64] = {0};
    if (klen > 64) {
        sha256(key, klen, kp);
        klen = 32;
    } else {
        memcpy(kp, key, klen);
    }
    uint8_t inner[192] = {0};
    for (int i = 0; i < 64; i++) inner[i] = kp[i] ^ 0x36;
    memcpy(inner + 64, data, dlen);
    uint8_t ih[32];
    sha256(inner, 64 + dlen, ih);
    uint8_t outer[128] = {0};
    for (int i = 0; i < 64; i++) outer[i] = kp[i] ^ 0x5c;
    memcpy(outer + 64, ih, 32);
    sha256(outer, 96, out);
}

static void pbkdf2(const uint8_t *pw, size_t pwlen, const uint8_t *salt,
                   size_t saltlen, int iters, uint8_t out[32]) {
    uint8_t s[36];
    memcpy(s, salt, saltlen);
    s[saltlen] = 0;
    s[saltlen+1] = 0;
    s[saltlen+2] = 0;
    s[saltlen+3] = 1;
    uint8_t u[32], prev[32];
    hmac_sha256(pw, pwlen, s, saltlen + 4, u);
    memcpy(out, u, 32);
    for (int it = 1; it < iters; it++) {
        memcpy(prev, u, 32);
        hmac_sha256(pw, pwlen, prev, 32, u);
        for (int i = 0; i < 32; i++) out[i] ^= u[i];
    }
}

int main(void) {
    const uint8_t pw[8] = {'p','a','s','s','w','o','r','d'};
    const uint8_t salt[4] = {'s','a','l','t'};
    int64_t t0 = now_ns();
    uint8_t dk[32];
    pbkdf2(pw, 8, salt, 4, 1000, dk);
    int64_t t1 = now_ns();
    int64_t ck = 0;
    for (int i = 0; i < 32; i++) ck += dk[i];
    printf("checksum=%lld\n", (long long)ck);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
