shape bench_dce {
  family "perf-real"
  generator "stress"
  features ["perf", "dce", "branch", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
ci windows-skip
  source ny generate awk <<'AWK'
BEGIN {
  print "use std.core"
  print "use std.os.time"
  print "def t0 = ticks()"
  print "mut x = 0"
  for (i = 0; i < 500; i++)
    print "if x == " i " { x = x + 1 } else { x = x + 2 }"
  print "def t1 = ticks()"
  print "print(\"checksum=\", x)"
  print "print(\"elapsed_ns=\", t1 - t0)"
}
AWK
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
  int64_t t0 = now_ns();
  int x = 0;
  for (int i = 0; i <= 499; i++) {
    if (x == i)
      x = x + 1;
    else
      x = x + 2;
  }
  int64_t t1 = now_ns();
  printf("checksum=%d\n", x);
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
