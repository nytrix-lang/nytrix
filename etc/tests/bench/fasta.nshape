shape fasta {
  family "perf-real"
  generator "stress"
  features ["perf", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
;; Fasta-style random sequence generation (LCG + weighted-lookup core).
def N = 250000
def tab = [65, 67, 71, 84]
mut seed = 42
mut sum = 0
mut i = 0
def t0 = ticks()
while i < N {
   seed = (seed * 3877 + 29573) % 139968
   sum += tab.get(seed % 4)
   i += 1
}
def t1 = ticks()
print("checksum=", sum * 1000000 + N)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int N = 250000;
    const int tab[4] = {65, 67, 71, 84};
    int seed = 42;
    int64_t sum = 0;
    int64_t start = now_ns();
    for (int i = 0; i < N; i++) {
        seed = (seed * 3877 + 29573) % 139968;
        sum += tab[seed % 4];
    }
    int64_t end = now_ns();
    printf("checksum=%lld\n", (long long)(sum * 1000000 + N));
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
