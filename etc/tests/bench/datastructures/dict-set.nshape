shape dict_integer_set_scaling {
  family "perf-real"
  generator "stress"
  features ["perf", "dict", "set", "integer-key", "scaling", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  budget {
    max_native_c_ratio 30.0
    max_native_llvm_ratio 1.5
  }
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
def int n = 500000
;; Use the native dictionary representation exercised by `{}` in application
;; code; the C reference below uses an open-addressed integer-key table.
mut dict d = {}
mut int i = 0
def int t0 = ticks()
while i < n {
  d[i] = i
  i += 1
}
def int t1 = ticks()
def int checksum = int(d.get(0, -1)) + int(d.get(n / 2, -1)) +
                   int(d.get(n - 1, -1))
print("checksum=", checksum)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

typedef struct { int key; int used; } Slot;

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static unsigned hash_int(unsigned x) {
  x ^= x >> 16;
  x *= 0x7feb352dU;
  x ^= x >> 15;
  x *= 0x846ca68bU;
  return x ^ (x >> 16);
}

int main(void) {
  const int n = 500000;
  size_t capacity = 8;
  Slot *tbl = calloc(capacity, sizeof(*tbl));
  if (!tbl) return 2;
  int64_t t0 = now_ns();
  for (int i = 0; i < n; ++i) {
    if (((size_t)i + 1) * 10 >= capacity * 7) {
      size_t next_capacity = capacity * 2;
      Slot *next = calloc(next_capacity, sizeof(*next));
      if (!next) { free(tbl); return 4; }
      for (size_t j = 0; j < capacity; ++j) {
        if (!tbl[j].used) continue;
        unsigned h = hash_int((unsigned)tbl[j].key) & (next_capacity - 1);
        while (next[h].used) h = (h + 1) & (next_capacity - 1);
        next[h] = tbl[j];
      }
      free(tbl);
      tbl = next;
      capacity = next_capacity;
    }
    unsigned h = hash_int((unsigned)i) & (capacity - 1);
    while (tbl[h].used) h = (h + 1) & (capacity - 1);
    tbl[h].used = 1;
    tbl[h].key = i;
  }
  int64_t t1 = now_ns();
  int checksum = 0;
  const int probes[] = {0, n / 2, n - 1};
  for (size_t i = 0; i < sizeof(probes) / sizeof(probes[0]); ++i) {
    unsigned h = hash_int((unsigned)probes[i]) & (capacity - 1);
    while (tbl[h].used && tbl[h].key != probes[i])
      h = (h + 1) & (capacity - 1);
    if (!tbl[h].used) { free(tbl); return 3; }
    checksum += tbl[h].key;
  }
  free(tbl);
  printf("checksum=%d\n", checksum);
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
