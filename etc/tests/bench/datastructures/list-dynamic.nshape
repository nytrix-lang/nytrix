shape dynamic_list_append_scaling {
  family "perf-real"
  generator "stress"
  features ["perf", "list", "append", "dynamic", "scaling", "checksum", "time"]
  template ny-test-case
  tier "critical"
  budget {
    max_native_c_ratio 2.5
    max_native_llvm_ratio 4.0
  }
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
def n = 1000000
mut xs = []
mut i = 0
def int t0 = ticks()
while i < n {
  xs = append(xs, i)
  i += 1
}
def int t1 = ticks()
def int checksum = xs[0] + xs[n / 2] + xs[n - 1]
print("checksum=", checksum)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
  const size_t n = 1000000;
  int64_t *xs = NULL;
  size_t len = 0, cap = 0;
  int64_t t0 = now_ns();
  for (size_t i = 0; i < n; ++i) {
    if (len == cap) {
      size_t next = cap ? cap * 2 : 8;
      int64_t *grown = realloc(xs, next * sizeof(*xs));
      if (!grown) { free(xs); return 2; }
      xs = grown;
      cap = next;
    }
    xs[len++] = (int64_t)i;
  }
  int64_t t1 = now_ns();
  int64_t checksum = xs[0] + xs[n / 2] + xs[n - 1];
  free(xs);
  printf("checksum=%lld\n", (long long)checksum);
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
  source py <<'PY'
import time

n = 1000000
xs = []
t0 = time.process_time_ns()
for i in range(n):
    xs.append(i)
t1 = time.process_time_ns()
print(f"checksum={xs[0] + xs[n // 2] + xs[-1]}")
print(f"elapsed_ns={t1 - t0}")
PY
}
