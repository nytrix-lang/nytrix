shape iter {
  family "perf-real"
  generator "stress"
  features ["perf", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Iterator-pipeline: map, reverse, chain over typed i64 buffers.
def n = 20000
def xs = i64buf_new(n)
def mapped = i64buf_new(n)
def reversed = i64buf_new(n)
def chained = i64buf_new(n * 2)
mut i = 0
while i < n {
   i64buf_store(xs, i, i)
   i += 1
}
def int start = ticks()
i = 0
while i < n {
   def v = i64buf_load(xs, i) + 1
   i64buf_store(mapped, i, v)
   i64buf_store(chained, i, v)
   i += 1
}
i = 0
while i < n {
   def v = i64buf_load(mapped, n - 1 - i)
   i64buf_store(reversed, i, v)
   i64buf_store(chained, n + i, v)
   i += 1
}
mut sum = 0
i = 0
while i < n * 2 {
   sum += i64buf_load(chained, i)
   i += 1
}
def int end = ticks()
print("checksum=", sum)
print("elapsed_ns=", end - start)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int n = 20000;
    int64_t *xs = calloc((size_t)n, sizeof(*xs));
    int64_t *mapped = calloc((size_t)n, sizeof(*mapped));
    int64_t *reversed = calloc((size_t)n, sizeof(*reversed));
    int64_t *chained = calloc((size_t)n * 2, sizeof(*chained));
    if (!xs || !mapped || !reversed || !chained) return 2;
    for (int i = 0; i < n; i++) xs[i] = i;
    int64_t start = now_ns();
    for (int i = 0; i < n; i++) {
        int64_t value = xs[i] + 1;
        mapped[i] = value;
        chained[i] = value;
    }
    for (int i = 0; i < n; i++) {
        int64_t value = mapped[n - 1 - i];
        reversed[i] = value;
        chained[n + i] = value;
    }
    int64_t sum = 0;
    for (int i = 0; i < n * 2; i++) sum += chained[i];
    int64_t end = now_ns();
    free(xs); free(mapped); free(reversed); free(chained);
    printf("checksum=%lld\n", (long long)sum);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
