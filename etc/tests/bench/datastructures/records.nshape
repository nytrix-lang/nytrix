shape mixed_record_stream {
  family "perf-real"
  generator "stress"
  features ["perf", "records", "tagged-union", "allocation", "working-set-scaling", "c-vs-ny", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time

fn record_case(int n) int {
   def ptr records = i64buf_new(n * 3)
   mut int i = 0
   while i < n {
      def int base = i * 3
      if i % 3 == 0 {
         i64buf_store(records, base, 1)
         i64buf_store(records, base + 1, i)
         i64buf_store(records, base + 2, i + 1)
      } else if i % 3 == 1 {
         i64buf_store(records, base, 2)
         i64buf_store(records, base + 1, i * 3)
         i64buf_store(records, base + 2, 0)
      } else {
         i64buf_store(records, base, 3)
         i64buf_store(records, base + 1, 0)
         i64buf_store(records, base + 2, 0)
      }
      i += 1
   }
   mut int checksum = 0
   i = 0
   while i < n {
      def int base = i * 3
      def int tag = i64buf_load(records, base)
      if tag == 1 {
         checksum += i64buf_load(records, base + 1) + 2 * i64buf_load(records, base + 2)
      } else if tag == 2 {
         checksum += i64buf_load(records, base + 1)
      } else {
         checksum += 7
      }
      i += 1
   }
   checksum
}

def int t0 = ticks()
def int checksum = record_case(32768) + record_case(262144) + record_case(2097152)
def int t1 = ticks()
print("checksum=", checksum)
assert(checksum == 4467846643701, "mixed record stream checksum")
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

typedef struct { uint8_t tag; int64_t a, b; } Event;

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int64_t record_case(int n) {
    Event *events = malloc((size_t)n * sizeof(*events));
    if (!events) return INT64_MIN;
    for (int i = 0; i < n; ++i) {
        if (i % 3 == 0) events[i] = (Event){1, i, i + 1};
        else if (i % 3 == 1) events[i] = (Event){2, (int64_t)i * 3, 0};
        else events[i] = (Event){3, 0, 0};
    }
    int64_t checksum = 0;
    for (int i = 0; i < n; ++i) {
        switch (events[i].tag) {
        case 1: checksum += events[i].a + 2 * events[i].b; break;
        case 2: checksum += events[i].a; break;
        default: checksum += 7; break;
        }
    }
    free(events);
    return checksum;
}

int main(void) {
    int64_t start = now_ns();
    int64_t checksum = record_case(32768) + record_case(262144) + record_case(2097152);
    int64_t end = now_ns();
    if (checksum != INT64_C(4467846643701)) return 3;
    printf("checksum=%lld\n", (long long)checksum);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
