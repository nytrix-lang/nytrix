shape sha256 {
  family "perf-real"
  generator "stress"
  features ["perf", "crypto", "bitwise", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
;; SHA-256 (FIPS 180-4) over 55-byte LCG messages.

def K = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
         0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
         0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
         0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
         0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
         0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
         0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
         0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

;; list of n zeros
fn zeros(int n) list {
   mut r = []
   mut i = 0
   while i < n {
      r = append(r, 0)
      i += 1
   }
   return r
}

fn rotr(int x, int n) int {
   return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF
}

fn be32(list buf, int off) int {
   return (((buf[off] & 0xFF) << 24) |
           ((buf[off + 1] & 0xFF) << 16) |
           ((buf[off + 2] & 0xFF) << 8) |
           (buf[off + 3] & 0xFF))
}

;; pad/w/hout are allocated once by the caller and reused.
fn sha256(list msg, list pad, list w, list hout) {
   mut i = 0
   while i < 55 {
      pad[i] = msg[i]
      i += 1
   }
   pad[55] = 0x80
   def bl = 55 * 8
   i = 56
   while i < 64 {
      pad[i] = (bl >> (8 * (63 - i))) & 0xFF
      i += 1
   }
   i = 0
   while i < 16 {
      w[i] = be32(pad, i * 4)
      i += 1
   }
   while i < 64 {
      def x15 = w[i - 15]
      def x2 = w[i - 2]
      def s0 = rotr(x15, 7) ^^ rotr(x15, 18) ^^ (x15 >> 3)
      def s1 = rotr(x2, 17) ^^ rotr(x2, 19) ^^ (x2 >> 10)
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & 0xFFFFFFFF
      i += 1
   }
   mut va = 0x6a09e667
   mut vb = 0xbb67ae85
   mut vc = 0x3c6ef372
   mut vd = 0xa54ff53a
   mut ve = 0x510e527f
   mut vf = 0x9b05688c
   mut vg = 0x1f83d9ab
   mut vh = 0x5be0cd19
   i = 0
   while i < 64 {
      def s1r = rotr(ve, 6) ^^ rotr(ve, 11) ^^ rotr(ve, 25)
      def chx = (ve & vf) ^^ ((~ve) & vg)
      def t1 = (vh + s1r + chx + K[i] + w[i]) & 0xFFFFFFFF
      def s0r = rotr(va, 2) ^^ rotr(va, 13) ^^ rotr(va, 22)
      def maj = (va & vb) ^^ (va & vc) ^^ (vb & vc)
      def t2 = (s0r + maj) & 0xFFFFFFFF
      vh = vg
      vg = vf
      vf = ve
      ve = (vd + t1) & 0xFFFFFFFF
      vd = vc
      vc = vb
      vb = va
      va = (t1 + t2) & 0xFFFFFFFF
      i += 1
   }
   hout[0] = (0x6a09e667 + va) & 0xFFFFFFFF
   hout[1] = (0xbb67ae85 + vb) & 0xFFFFFFFF
   hout[2] = (0x3c6ef372 + vc) & 0xFFFFFFFF
   hout[3] = (0xa54ff53a + vd) & 0xFFFFFFFF
   hout[4] = (0x510e527f + ve) & 0xFFFFFFFF
   hout[5] = (0x9b05688c + vf) & 0xFFFFFFFF
   hout[6] = (0x1f83d9ab + vg) & 0xFFFFFFFF
   hout[7] = (0x5be0cd19 + vh) & 0xFFFFFFFF
}

def M = 2000
def msg = zeros(55)
def pad = zeros(64)
def w = zeros(64)
def hout = zeros(8)
def t0 = ticks()
mut seed = 42
mut sum = 0
mut rep = 0
while rep < M {
   mut i = 0
   while i < 55 {
      seed = (seed * 3877 + 29573) % 139968
      msg[i] = seed % 256
      i += 1
   }
   sha256(msg, pad, w, hout)
   sum += (hout[0] >> 24) & 0xFF
   rep += 1
}
def t1 = ticks()
print("checksum=", sum)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static uint32_t rotr(uint32_t x, uint32_t n) { return (x >> n) | (x << (32 - n)); }

static void sha256(const unsigned char *msg, size_t len, uint32_t out[8]) {
    static const uint32_t K[64] = {
        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
    };
    uint32_t H[8] = {
        0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
        0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19
    };
    uint64_t bitlen = (uint64_t)len * 8;
    size_t padded = ((len + 8) / 64 + 1) * 64;
    unsigned char buf[256] = {0};
    memcpy(buf, msg, len);
    buf[len] = 0x80;
    for (int i = 0; i < 8; i++) buf[padded - 1 - i] = (unsigned char)(bitlen >> (8 * i));
    for (size_t off = 0; off < padded; off += 64) {
        uint32_t w[64];
        for (int i = 0; i < 16; i++)
            w[i] = ((uint32_t)buf[off + i*4] << 24) | ((uint32_t)buf[off + i*4 + 1] << 16) |
                   ((uint32_t)buf[off + i*4 + 2] << 8) | (uint32_t)buf[off + i*4 + 3];
        for (int i = 16; i < 64; i++) {
            uint32_t s0 = rotr(w[i-15],7) ^ rotr(w[i-15],18) ^ (w[i-15] >> 3);
            uint32_t s1 = rotr(w[i-2],17) ^ rotr(w[i-2],19) ^ (w[i-2] >> 10);
            w[i] = w[i-16] + s0 + w[i-7] + s1;
        }
        uint32_t a=H[0],b=H[1],c=H[2],d=H[3],e=H[4],f=H[5],g=H[6],h=H[7];
        for (int i = 0; i < 64; i++) {
            uint32_t S1 = rotr(e,6) ^ rotr(e,11) ^ rotr(e,25);
            uint32_t ch = (e & f) ^ ((~e) & g);
            uint32_t t1 = h + S1 + ch + K[i] + w[i];
            uint32_t S0 = rotr(a,2) ^ rotr(a,13) ^ rotr(a,22);
            uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
            uint32_t t2 = S0 + maj;
            h=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2;
        }
        H[0]+=a; H[1]+=b; H[2]+=c; H[3]+=d; H[4]+=e; H[5]+=f; H[6]+=g; H[7]+=h;
    }
    for (int i = 0; i < 8; i++) out[i] = H[i];
}

int main(void) {
    int M = 2000;
    uint32_t seed = 42;
    unsigned char msg[55];
    int64_t t0 = now_ns();
    uint32_t sum = 0;
    for (int rep = 0; rep < M; rep++) {
        for (int i = 0; i < 55; i++) {
            seed = (seed * 3877 + 29573) % 139968;
            msg[i] = (unsigned char)(seed % 256);
        }
        uint32_t d[8];
        sha256(msg, 55, d);
        sum += d[0] >> 24;
    }
    int64_t t1 = now_ns();
    printf("checksum=%u\n", sum);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
