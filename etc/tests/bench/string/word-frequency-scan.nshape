shape word_frequency_scan {
  family "perf-real"
  generator "stress"
  features ["perf", "string", "scan", "word-frequency", "c-vs-ny", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core.os.time

def int repetitions = 25000
def str vocabulary = "amber birch cobalt delta ember fern garnet hazel indigo "
def int t0 = ticks()
def str corpus = str.repeat(vocabulary, repetitions)
def int length = corpus.len
mut int i = 0
mut int amber = 0, birch = 0, cobalt = 0, delta = 0, ember = 0
mut int fern = 0, garnet = 0, hazel = 0, indigo = 0
while i < length {
   while i < length && load8(corpus, i) == 32 { i += 1 }
   if i < length {
      def int start = i
      while i < length && load8(corpus, i) != 32 { i += 1 }
      def int first = load8(corpus, start)
      ;; The generated vocabulary has a unique initial byte for each token.
      if first == 97 { amber += 1 }
      if first == 98 { birch += 1 }
      if first == 99 { cobalt += 1 }
      if first == 100 { delta += 1 }
      if first == 101 { ember += 1 }
      if first == 102 { fern += 1 }
      if first == 103 { garnet += 1 }
      if first == 104 { hazel += 1 }
      if first == 105 { indigo += 1 }
   }
}
def int checksum = amber + 2 * birch + 3 * cobalt + 4 * delta + 5 * ember +
   6 * fern + 7 * garnet + 8 * hazel + 9 * indigo
def int t1 = ticks()
assert(checksum == 1125000, "word-frequency scan checksum")
print("checksum=", checksum)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

enum { REPETITIONS = 25000 };
static const char vocabulary[] = "amber birch cobalt delta ember fern garnet hazel indigo ";

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    int64_t start_time = now_ns();
    size_t vocab_len = sizeof(vocabulary) - 1;
    size_t corpus_len = vocab_len * REPETITIONS;
    char *corpus = malloc(corpus_len + 1);
    if (!corpus) return 2;
    for (int run = 0; run < REPETITIONS; ++run)
        memcpy(corpus + (size_t)run * vocab_len, vocabulary, vocab_len);
    corpus[corpus_len] = '\0';

    int64_t counts[9] = {0};
    size_t i = 0;
    while (i < corpus_len) {
        while (i < corpus_len && corpus[i] == ' ') ++i;
        if (i == corpus_len) break;
        size_t token_start = i;
        while (i < corpus_len && corpus[i] != ' ') ++i;
        switch (corpus[token_start]) {
        case 'a': ++counts[0]; break;
        case 'b': ++counts[1]; break;
        case 'c': ++counts[2]; break;
        case 'd': ++counts[3]; break;
        case 'e': ++counts[4]; break;
        case 'f': ++counts[5]; break;
        case 'g': ++counts[6]; break;
        case 'h': ++counts[7]; break;
        case 'i': ++counts[8]; break;
        default: break;
        }
    }
    int64_t checksum = counts[0] + 2 * counts[1] + 3 * counts[2] +
        4 * counts[3] + 5 * counts[4] + 6 * counts[5] +
        7 * counts[6] + 8 * counts[7] + 9 * counts[8];
    int64_t end_time = now_ns();
    free(corpus);
    if (checksum != 1125000) return 3;
    printf("checksum=%lld\n", (long long)checksum);
    if (end_time <= start_time) end_time = start_time + 1;
    printf("elapsed_ns=%lld\n", (long long)(end_time - start_time));
    return 0;
}
C
}
