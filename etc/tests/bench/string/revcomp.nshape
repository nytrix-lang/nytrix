shape revcomp {
  family "probe"
  generator "stress"
  features ["perf", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Reverse-complement: generate a DNA code stream, then sum its
;; complemented reverse (3 - code). Byte-oriented memory benchmark.
def N = 100000
mut int seed = 42
def buf = u8buf_new(N)
mut int i = 0
while i < N {
   seed = (seed * 3877 + 29573) % 139968
   u8buf_store(buf, i, seed % 4)
   i += 1
}
mut int sum = 0
i = N
def int t0 = ticks()
while i >= 4 {
   i -= 1
   sum += 3 - u8buf_load(buf, i)
   i -= 1
   sum += 3 - u8buf_load(buf, i)
   i -= 1
   sum += 3 - u8buf_load(buf, i)
   i -= 1
   sum += 3 - u8buf_load(buf, i)
}
while i > 0 {
   i -= 1
   sum += 3 - u8buf_load(buf, i)
}
def int t1 = ticks()
print("checksum=", sum * 1000000 + N)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int N = 100000;
    unsigned char *buf = malloc((size_t)N);
    int seed = 42;
    for (int i = 0; i < N; i++) {
        seed = (seed * 3877 + 29573) % 139968;
        buf[i] = (unsigned char)(seed % 4);
    }
    int64_t sum = 0;
    int64_t start = now_ns();
    int i = N;
    for (; i >= 4;) {
        sum += 3 - buf[--i];
        sum += 3 - buf[--i];
        sum += 3 - buf[--i];
        sum += 3 - buf[--i];
    }
    for (; i > 0;) sum += 3 - buf[--i];
    int64_t end = now_ns();
    free(buf);
    printf("checksum=%lld\n", (long long)(sum * 1000000 + N));
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
