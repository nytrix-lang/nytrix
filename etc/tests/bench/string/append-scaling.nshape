shape string_append_scaling {
  family "perf-real"
  generator "stress"
  features ["perf", "string", "append", "scaling", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  tier "critical"
  budget {
    max_native_c_ratio 10.0
    max_native_llvm_ratio 1.5
  }
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
def x = "abc"
def int t0 = ticks()
mut s = ""
for i in 0..5000000 {
  s = s + x
}
def int t1 = ticks()
print("checksum=", s.len)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
  const size_t count = 5000001;
  const size_t chunk = 3;
  char *s = malloc(count * chunk + 1);
  if (!s) return 2;
  const char x[] = "abc";
  int64_t t0 = now_ns();
  for (size_t i = 0; i < count; ++i)
    memcpy(s + i * chunk, x, chunk);
  s[count * chunk] = '\0';
  int64_t t1 = now_ns();
  printf("checksum=%zu\n", strlen(s));
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  free(s);
  return 0;
}
C
}
