shape sor {
  family "perf-real"
  generator "stress"
  features ["perf", "fp", "sor", "grid", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
use std.core.tbuf
;; Successive Over-Relaxation / Jacobi diffusion on a 100x100 grid.
def N = 100
def ITERS = 200
mut grid = f64buf_new(N * N)
mut ngrid = f64buf_new(N * N)
mut i = 0
while i < N {
   f64buf_store(grid, i, 1.0)
   f64buf_store(grid, (N - 1) * N + i, 1.0)
   f64buf_store(grid, i * N, 1.0)
   f64buf_store(grid, i * N + N - 1, 1.0)
   i += 1
}
def t0 = ticks()
mut it = 0
while it < ITERS {
   mut r = 1
   while r < N - 1 {
      mut cc = 1
      while cc < N - 1 {
         def v = (f64buf_load(grid, (r - 1) * N + cc) + f64buf_load(grid, (r + 1) * N + cc)
                + f64buf_load(grid, r * N + cc - 1) + f64buf_load(grid, r * N + cc + 1)) / 4.0
         f64buf_store(ngrid, r * N + cc, v)
         cc += 1
      }
      r += 1
   }
   def tmp = grid
   grid = ngrid
   ngrid = tmp
   it += 1
}
def t1 = ticks()
def center = f64buf_load(grid, (N / 2) * N + N / 2)
mut conv = 0
if center > 0.1 { conv = 1 } else { conv = 0 }
print("checksum=", conv)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    int N = 100, ITERS = 200;
    double *grid = (double *)malloc((size_t)N * N * sizeof(double));
    double *ngrid = (double *)malloc((size_t)N * N * sizeof(double));
    for (int i = 0; i < N * N; i++) { grid[i] = 0.0; ngrid[i] = 0.0; }
    for (int i = 0; i < N; i++) {
        grid[i] = 1.0;
        grid[(N - 1) * N + i] = 1.0;
        grid[i * N] = 1.0;
        grid[i * N + N - 1] = 1.0;
    }
    int64_t start = now_ns();
    for (int it = 0; it < ITERS; it++) {
        for (int r = 1; r < N - 1; r++) {
            for (int c = 1; c < N - 1; c++) {
                double v = (grid[(r - 1) * N + c] + grid[(r + 1) * N + c]
                          + grid[r * N + c - 1] + grid[r * N + c + 1]) / 4.0;
                ngrid[r * N + c] = v;
            }
        }
        double *tmp = grid;
        grid = ngrid;
        ngrid = tmp;
    }
    int64_t end = now_ns();
    double center = grid[(N / 2) * N + N / 2];
    int conv = (center > 0.1) ? 1 : 0;
    printf("checksum=%d\n", conv);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
