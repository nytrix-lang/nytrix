shape bench_straight {
  family "perf-real"
  generator "stress"
  features ["perf", "straight-line", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
ci windows-skip
  source ny generate awk <<'AWK'
BEGIN {
  print "use std.core"
  print "use std.os.time"
  print "def t0 = ticks()"
  print "mut x = 0"
  for (i = 1; i <= 100; i++)
    print "x = x + " i
  print "def t1 = ticks()"
  print "print(\"checksum=\", x)"
  print "print(\"elapsed_ns=\", t1 - t0)"
}
AWK
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
  int64_t t0 = now_ns();
  int x = 0;
  for (int i = 1; i <= 100; i++)
    x += i;
  int64_t t1 = now_ns();
  printf("checksum=%d\n", x);
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
