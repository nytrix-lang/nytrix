shape qrsyndrome {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "gf256", "crypto", "c-vs-ny", "native", "checksum", "time"]
  meta "Reed-Solomon GF(256) syndrome evaluation, 512 blocks"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.os.time
;; Reed-Solomon syndrome evaluation over GF(256) with log/antilog tables, the
;; arithmetic core behind qrduino's QR encoder.
def gf = i64buf_new(512)
def lg = i64buf_new(256)
mut x = 1
mut i = 0
while i < 255 {
   i64buf_store(gf, i, x)
   i64buf_store(lg, x, i)
   x = x << 1
   if x >= 256 { x = x ^ 0x11D }
   i += 1
}
i = 255
while i < 510 {
   i64buf_store(gf, i, i64buf_load(gf, i - 255))
   i += 1
}
def DATA = 200
def data = i64buf_new(DATA)
i = 0
while i < DATA {
   i64buf_store(data, i, (i * 73 + 29) & 0xFF)
   i += 1
}
def int t0 = ticks()
mut acc = 0
mut blk = 0
while blk < 512 {
   def off = (blk * 13) % DATA
   mut j = 0
   while j < 16 {
      mut s = 0
      mut p = 0
      while p < DATA {
         def a = i64buf_load(data, (p + off) % DATA)
         if a != 0 {
            s = s ^ i64buf_load(gf, i64buf_load(lg, a) + (j * p) % 255)
         }
         p += 1
      }
      acc = (acc + s + j) % 1000000007
      j += 1
   }
   blk += 1
}
def int t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    int64_t gf[512], lg[256];
    for (int i = 0; i < 256; i++) lg[i] = 0;
    int64_t x = 1;
    for (int i = 0; i < 255; i++) {
        gf[i] = x;
        lg[x] = i;
        x <<= 1;
        if (x >= 256) x ^= 0x11D;
    }
    for (int i = 255; i < 510; i++) gf[i] = gf[i - 255];

    enum { DATA = 200 };
    int64_t data[DATA];
    for (int i = 0; i < DATA; i++) data[i] = (i * 73 + 29) & 0xFF;

    int64_t t0 = now_ns();
    int64_t acc = 0;
    for (int blk = 0; blk < 512; blk++) {
        int64_t off = (blk * 13) % DATA;
        for (int j = 0; j < 16; j++) {
            int64_t s = 0;
            for (int p = 0; p < DATA; p++) {
                int64_t a = data[(p + off) % DATA];
                if (a != 0)
                    s ^= gf[lg[a] + (j * p) % 255];
            }
            acc = (acc + s + j) % 1000000007LL;
        }
    }
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
