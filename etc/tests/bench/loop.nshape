shape bench_loop {
  family "perf-real"
  generator "stress"
  features ["perf", "loop", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
def n = 1000000 * argc()
mut acc = 0
mut i = 0
def t0 = ticks()
while i <= n {
  acc += i
  i += 1
}
def t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(int argc, char **argv) {
  (void)argv;
  int n = 1000000 * argc;
  int64_t t0 = now_ns();
  volatile int64_t acc = 0;
  for (int64_t i = 0; i <= n; i++)
    acc += i;
  int64_t t1 = now_ns();
  printf("checksum=%lld\n", (long long)acc);
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
