shape mcf {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "graph", "relaxation", "c-vs-ny", "native", "checksum", "time"]
  meta "single-depot network flow relaxation"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.os.time
;; Successive shortest-path relaxation over a fixed directed network.
def N = 64
def E = 192
def ptr eu = i64buf_new(E)
def ptr ev = i64buf_new(E)
def ptr ec = i64buf_new(E)
def ptr dist = i64buf_new(N)
mut e = 0
while e < E {
   i64buf_store(eu, e, e % N)
   i64buf_store(ev, e, (e * 7 + 3) % N)
   i64buf_store(ec, e, (e * 13 + 7) % 97 + 1)
   e += 1
}
mut acc = 0
mut iter = 0
def int t0 = ticks()
while iter < 512 {
   e = 0
   while e < E {
      i64buf_store(ec, e, (i64buf_load(ec, e) * 17 + 11) % 997 + 1)
      e += 1
   }
   mut v = 0
   while v < N {
      i64buf_store(dist, v, 1073741824)
      v += 1
   }
   i64buf_store(dist, 0, 0)
   mut pass = 0
   while pass < N - 1 {
      e = 0
      while e < E {
         def u = i64buf_load(eu, e)
         def w = i64buf_load(ev, e)
         def nd = i64buf_load(dist, u) + i64buf_load(ec, e)
         if nd < i64buf_load(dist, w) { i64buf_store(dist, w, nd) }
         e += 1
      }
      pass += 1
   }
   v = 0
   while v < N {
      acc = (acc + i64buf_load(dist, v)) % 1000000007
      v += 1
   }
   iter += 1
}
def int t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int N = 64, E = 192;
    int64_t *eu = calloc((size_t)E, sizeof(int64_t));
    int64_t *ev = calloc((size_t)E, sizeof(int64_t));
    int64_t *ec = calloc((size_t)E, sizeof(int64_t));
    int64_t *dist = calloc((size_t)N, sizeof(int64_t));
    for (int e = 0; e < E; e++) {
        eu[e] = e % N;
        ev[e] = (e * 7 + 3) % N;
        ec[e] = (e * 13 + 7) % 97 + 1;
    }
    int64_t acc = 0;
    int64_t t0 = now_ns();
    for (int iter = 0; iter < 512; iter++) {
        for (int e = 0; e < E; e++) ec[e] = (ec[e] * 17 + 11) % 997 + 1;
        for (int v = 0; v < N; v++) dist[v] = 1073741824;
        dist[0] = 0;
        for (int pass = 0; pass < N - 1; pass++) {
            for (int e = 0; e < E; e++) {
                int64_t nd = dist[eu[e]] + ec[e];
                if (nd < dist[ev[e]]) dist[ev[e]] = nd;
            }
        }
        for (int v = 0; v < N; v++) acc = (acc + dist[v]) % 1000000007;
    }
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
