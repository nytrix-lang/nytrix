shape sor {
  family "perf-real"
  generator "stress"
  features ["perf", "fp", "sor", "grid", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  flags_matrix "--native-only -O0; --native-only -O3; -O0; -O3"
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Successive Over-Relaxation / Jacobi diffusion on a 100x100 grid.
fn run_sor() int {
   def N = 100
   def ITERS = 200
   mut ptr grid = f64buf_new(N * N)
   mut ptr ngrid = f64buf_new(N * N)
   mut i = 0
   while i < N {
      f64buf_store(grid, i, 1.0)
      f64buf_store(grid, (N - 1) * N + i, 1.0)
      f64buf_store(grid, i * N, 1.0)
      f64buf_store(grid, i * N + N - 1, 1.0)
      i += 1
   }
   def int t0 = ticks()
   mut it = 0
   while it < ITERS {
      if it % 2 == 0 {
         mut int r = 1
         while r < N - 1 {
            def int r_prev = (r - 1) * N
            def int r_curr = r * N
            def int r_next = (r + 1) * N
            mut int cc = 1
            while cc < N - 1 {
               def f64 v = (f64buf_load(grid, r_prev + cc) + f64buf_load(grid, r_next + cc)
                          + f64buf_load(grid, r_curr + cc - 1) + f64buf_load(grid, r_curr + cc + 1)) * 0.25
               f64buf_store(ngrid, r_curr + cc, v)
               cc += 1
            }
            r += 1
         }
      } else {
         mut int r = 1
         while r < N - 1 {
            def int r_prev = (r - 1) * N
            def int r_curr = r * N
            def int r_next = (r + 1) * N
            mut int cc = 1
            while cc < N - 1 {
               def f64 v = (f64buf_load(ngrid, r_prev + cc) + f64buf_load(ngrid, r_next + cc)
                          + f64buf_load(ngrid, r_curr + cc - 1) + f64buf_load(ngrid, r_curr + cc + 1)) * 0.25
               f64buf_store(grid, r_curr + cc, v)
               cc += 1
            }
            r += 1
         }
      }
      it += 1
   }
   def int t1 = ticks()
   mut ptr result = grid
   if ITERS % 2 != 0 { result = ngrid }
   mut checksum = 0
   mut k = 0
   while k < N * N {
      checksum += int(f64buf_load(result, k) * 1000000.0)
      k += 1
   }
   if checksum != 1725461952 { return 1 }
   print("checksum=", checksum)
   print("elapsed_ns=", t1 - t0)
   0
}

run_sor()
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    int N = 100, ITERS = 200;
    double *grid = (double *)malloc((size_t)N * N * sizeof(double));
    double *ngrid = (double *)malloc((size_t)N * N * sizeof(double));
    for (int i = 0; i < N * N; i++) { grid[i] = 0.0; ngrid[i] = 0.0; }
    for (int i = 0; i < N; i++) {
        grid[i] = 1.0;
        grid[(N - 1) * N + i] = 1.0;
        grid[i * N] = 1.0;
        grid[i * N + N - 1] = 1.0;
    }
    int64_t start = now_ns();
    for (int it = 0; it < ITERS; it++) {
        double *src = grid, *dst = ngrid;
        if (it & 1) { src = ngrid; dst = grid; }
        for (int r = 1; r < N - 1; r++) {
            int r_prev = (r - 1) * N;
            int r_curr = r * N;
            int r_next = (r + 1) * N;
            for (int c = 1; c < N - 1; c++)
                dst[r_curr + c] = (src[r_prev + c] + src[r_next + c]
                                  + src[r_curr + c - 1] + src[r_curr + c + 1]) * 0.25;
        }
    }
    int64_t end = now_ns();
    int64_t checksum = 0;
    double *result = (ITERS & 1) ? ngrid : grid;
    for (int i = 0; i < N * N; i++)
        checksum += (int64_t)(result[i] * 1000000.0);
    if (checksum != 1725461952) return 1;
    printf("checksum=%lld\n", (long long)checksum);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
