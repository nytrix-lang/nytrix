shape ackermann {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "recursion", "c-vs-ny", "native", "checksum", "time"]
  meta "Ackermann recursion with a runtime input"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.prim (env)
use core.os.time (ticks)

fn ack(int m, int n) int {
  if m == 0 { return n + 1 }
  if n == 0 { return ack(m - 1, 1) }
  ack(m - 1, ack(m, n - 1))
}

;; Read the starting depth at runtime so both references execute recursion.
def int depth = str(env("NYTRIX_BENCH_ACK_DEPTH")) == "5" ? 5 : 4
mut sum = 0
mut i = 0
def int start = ticks()
while i < 1200 {
  sum = sum + ack(3, depth + ((sum >> 1) & 1))
  i = i + 1
}
def int elapsed = ticks() - start
print("checksum=", sum)
print("elapsed_ns=", elapsed)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int64_t ack(int64_t m, int64_t n) {
  if (m == 0) return n + 1;
  if (n == 0) return ack(m - 1, 1);
  return ack(m - 1, ack(m, n - 1));
}

int main(void) {
  const char *requested = getenv("NYTRIX_BENCH_ACK_DEPTH");
  int64_t depth = requested && strcmp(requested, "5") == 0 ? 5 : 4;
  int64_t sum = 0;
  int64_t start = now_ns();
  for (int64_t i = 0; i < 1200; ++i)
    sum += ack(3, depth + ((sum >> 1) & 1));
  int64_t elapsed = now_ns() - start;
  printf("checksum=%lld\n", (long long)sum);
  printf("elapsed_ns=%lld\n", (long long)elapsed);
  return 0;
}
C
}
