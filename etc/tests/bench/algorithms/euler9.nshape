shape euler9 {
  family "algorithm"
  generator "stress"
  features ["c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
;; inspired from QBE: minic/test/euler9.c.
use core
use core.os.time
@inline fn gcd(int a, int b) int {
   while b != 0 {
      def int r = a % b
      a = b
      b = r
   }
   a
}
def int t0 = ticks()
mut int result = 0
mut int m = 2
while 2 * m * (m + 1) <= 1000 {
   mut int n = 1
   while n < m {
      def int perimeter = 2 * m * (m + n)
      if ((m - n) & 1) != 0 && 1000 % perimeter == 0 && gcd(m, n) == 1 {
         def int k = 1000 / perimeter
         def int x = (m * m - n * n) * k
         def int y = (2 * m * n) * k
         def int z = (m * m + n * n) * k
         result = x * y * z
      }
      n += 1
   }
   m += 1
}
def int t1 = ticks()
print("checksum=", result)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int gcd(int a, int b) {
  while (b != 0) {
    int r = a % b;
    a = b;
    b = r;
  }
  return a;
}

int main(void) {
  int64_t start = now_ns();
  int result = 0;
  for (int m = 2; 2 * m * (m + 1) <= 1000; ++m) {
    for (int n = 1; n < m; ++n) {
      int perimeter = 2 * m * (m + n);
      if (((m - n) & 1) != 0 && 1000 % perimeter == 0 && gcd(m, n) == 1) {
        int k = 1000 / perimeter;
        int a = (m * m - n * n) * k;
        int b = 2 * m * n * k;
        int c = (m * m + n * n) * k;
        result = a * b * c;
      }
    }
  }
  int64_t end = now_ns();
  printf("checksum=%d\n", result);
  if (end <= start) end = start + 1;
  printf("elapsed_ns=%lld\n", (long long)(end - start));
}
C
}
