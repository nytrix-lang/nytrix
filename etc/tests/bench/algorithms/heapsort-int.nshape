shape heapsort-int {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "sort", "c-vs-ny", "native", "checksum", "time"]
  meta "Integer heapsort over 400000 deterministic values"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf

def n = 400000
def a = i64buf_new(n + 1)
mut seed = 42
mut i = 1
while i <= n {
  seed = (seed * 1103515245 + 12345) & 2147483647
  i64buf_store(a, i, seed % 1000000007)
  i = i + 1
}
mut l = n / 2 + 1
mut ir = n
mut rra = 0
mut done = 0
while done == 0 {
  if l > 1 {
    l = l - 1
    rra = i64buf_load(a, l)
  } else {
    rra = i64buf_load(a, ir)
    i64buf_store(a, ir, i64buf_load(a, 1))
    ir = ir - 1
    if ir == 1 {
      i64buf_store(a, 1, rra)
      done = 1
    }
  }
  if done == 0 {
    mut ii = l
    mut j = l * 2
    while j <= ir {
      if j < ir {
        if i64buf_load(a, j) < i64buf_load(a, j + 1) {
          j = j + 1
        }
      }
      if rra < i64buf_load(a, j) {
        i64buf_store(a, ii, i64buf_load(a, j))
        ii = j
        j = j * 2
      } else {
        j = ir + 1
      }
    }
    i64buf_store(a, ii, rra)
  }
}
mut checksum = i64buf_load(a, 1) + i64buf_load(a, n) + i64buf_load(a, n / 2)
i = 2
while i <= n {
  if i64buf_load(a, i - 1) > i64buf_load(a, i) {
    checksum = 0 - 1
  }
  i = i + 1
}
print("checksum=", checksum)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

int main(void) {
  int n = 400000;
  int64_t *a = (int64_t *)malloc((size_t)(n + 1) * sizeof(int64_t));
  int64_t seed = 42;
  for (int i = 1; i <= n; ++i) {
    seed = (seed * 1103515245 + 12345) & 2147483647;
    a[i] = seed % 1000000007;
  }
  int l = n / 2 + 1;
  int ir = n;
  int64_t rra = 0;
  int done = 0;
  while (!done) {
    if (l > 1) {
      --l;
      rra = a[l];
    } else {
      rra = a[ir];
      a[ir] = a[1];
      if (--ir == 1) { a[1] = rra; done = 1; }
    }
    if (!done) {
      int i = l;
      int j = l * 2;
      while (j <= ir) {
        if (j < ir && a[j] < a[j + 1]) ++j;
        if (rra < a[j]) { a[i] = a[j]; i = j; j *= 2; }
        else j = ir + 1;
      }
      a[i] = rra;
    }
  }
  int64_t checksum = a[1] + a[n] + a[n / 2];
  for (int i = 2; i <= n; ++i) if (a[i - 1] > a[i]) checksum = -1;
  printf("checksum=%lld\n", (long long)checksum);
  free(a);
  return 0;
}
C
}
