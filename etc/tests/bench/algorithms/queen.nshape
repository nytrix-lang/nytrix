shape queen {
  family "algorithm"
  generator "stress"
  features ["c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
;; inspired from QBE: minic/test/queen.c.
fn queens(int row, int cols, int diag_l, int diag_r) int {
   if row == 8 { return 1 }
   mut total = 0
   mut available = (~(cols | diag_l | diag_r)) & 255
   while available != 0 {
      def bit = available & -available
      available -= bit
      total += queens(row + 1, cols | bit, ((diag_l | bit) << 1) & 255,
                      (diag_r | bit) >> 1)
   }
   total
}
def result = queens(0, 0, 0, 0)
print("checksum=", result)
NY
  source c <<'C'
#include <stdio.h>

static int queens(int row, int cols, int diag_l, int diag_r) {
  if (row == 8) return 1;

  int total = 0;
  int available = (~(cols | diag_l | diag_r)) & 255;
  while (available != 0) {
    int bit = available & -available;
    available -= bit;
    total += queens(row + 1, cols | bit, ((diag_l | bit) << 1) & 255,
                    (diag_r | bit) >> 1);
  }
  return total;
}

int main(void) {
  int result = queens(0, 0, 0, 0);
  printf("checksum=%d\n", result);
}
C
}
