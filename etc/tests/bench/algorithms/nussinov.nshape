shape nussinov {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "dynamic-programming", "rna", "c-vs-ny", "native", "checksum", "time"]
  meta "Nussinov RNA secondary-structure DP over 256 bases"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Nussinov-style maximum base-pair folding. The pair predicate is synthetic so
;; the workload is deterministic and integer-only.
def N = 256
def dp = i64buf_new(N * N)
fn paired(int i, int j) bool { (i * 3 + j * 5) % 7 == 0 }
mut z = 0
while z < N * N {
   i64buf_store(dp, z, 0)
   z += 1
}
def int t0 = ticks()
mut len = 2
while len <= N {
   mut i = 0
   while i + len <= N {
      def j = i + len - 1
      mut best = i64buf_load(dp, (i + 1) * N + j)
      def v1 = i64buf_load(dp, i * N + j - 1)
      if v1 > best { best = v1 }
      if paired(i, j) {
         def v2 = i64buf_load(dp, (i + 1) * N + j - 1) + 1
         if v2 > best { best = v2 }
      }
      mut k = i + 1
      while k < j {
         if paired(i, k) {
            def v3 = i64buf_load(dp, (i + 1) * N + k - 1) + 1
                    + i64buf_load(dp, (k + 1) * N + j)
            if v3 > best { best = v3 }
         }
         k += 1
      }
      i64buf_store(dp, i * N + j, best)
      i += 1
   }
   len += 1
}
def int t1 = ticks()
print("checksum=", i64buf_load(dp, N - 1))
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int paired(int i, int j) { return (i * 3 + j * 5) % 7 == 0; }

int main(void) {
    const int N = 256;
    int64_t *dp = calloc((size_t)N * N, sizeof(int64_t));
    int64_t t0 = now_ns();
    for (int len = 2; len <= N; len++) {
        for (int i = 0; i + len <= N; i++) {
            int j = i + len - 1;
            int64_t best = dp[(i + 1) * N + j];
            int64_t v1 = dp[i * N + j - 1];
            if (v1 > best) best = v1;
            if (paired(i, j)) {
                int64_t v2 = dp[(i + 1) * N + j - 1] + 1;
                if (v2 > best) best = v2;
            }
            for (int k = i + 1; k < j; k++)
                if (paired(i, k)) {
                    int64_t v3 = dp[(i + 1) * N + k - 1] + 1 + dp[(k + 1) * N + j];
                    if (v3 > best) best = v3;
                }
            dp[i * N + j] = best;
        }
    }
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)dp[N - 1]);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    free(dp);
    return 0;
}
C
}
