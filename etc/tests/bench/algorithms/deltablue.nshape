shape deltablue {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "fixpoint", "c-vs-ny", "native", "checksum", "time"]
  meta "constraint propagation to a fixpoint"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.os.time
;; DeltaBlue-style constraint propagation: each round relaxes upper bounds
;; (val[b] <= val[a] + val[c]) and injects a small delta so work continues.
def NV = 96
def val = i64buf_new(NV)
mut i = 0
while i < NV {
   i64buf_store(val, i, 1000 + (i * 17) % 97)
   i += 1
}
def int t0 = ticks()
mut round = 0
while round < 60000 {
   mut j = 0
   while j < NV {
      def a = (j * 7 + 3) % NV
      def b = (j * 13 + 5) % NV
      def c = (j * 29 + 11) % NV
      def rhs = i64buf_load(val, a) + i64buf_load(val, c)
      if i64buf_load(val, b) > rhs { i64buf_store(val, b, rhs) }
      j += 1
   }
   mut k = 0
   while k < NV {
      if (round + k) % 11 == 0 { i64buf_store(val, k, i64buf_load(val, k) + 5) }
      k += 1
   }
   round += 1
}
def int t1 = ticks()
mut acc = 0
mut s = 0
while s < NV {
   acc = (acc + i64buf_load(val, s)) % 1000000007
   s += 1
}
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    enum { NV = 96 };
    int64_t *val = (int64_t *)calloc((size_t)NV, sizeof(int64_t));
    for (int i = 0; i < NV; i++)
        val[i] = 1000 + (i * 17) % 97;
    int64_t t0 = now_ns();
    for (int round = 0; round < 60000; round++) {
        for (int j = 0; j < NV; j++) {
            int a = (j * 7 + 3) % NV;
            int b = (j * 13 + 5) % NV;
            int c = (j * 29 + 11) % NV;
            int64_t rhs = val[a] + val[c];
            if (val[b] > rhs) val[b] = rhs;
        }
        for (int k = 0; k < NV; k++) {
            if ((round + k) % 11 == 0) val[k] += 5;
        }
    }
    int64_t t1 = now_ns();
    int64_t acc = 0;
    for (int s = 0; s < NV; s++)
        acc = (acc + val[s]) % 1000000007LL;
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    free(val);
    return 0;
}
C
}
