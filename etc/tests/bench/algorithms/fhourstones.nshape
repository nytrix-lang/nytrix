shape fhourstones {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "search", "alpha-beta", "c-vs-ny", "native", "checksum", "time"]
  meta "Alpha-beta search of a 7x6 Connect Four position"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Fixed-order alpha-beta over a 7x6 grid. Identical move order and evaluation
;; on both sides make the returned score and node count directly comparable.
def W = 7
def H = 6
def board = i64buf_new(W * H)
def meta = i64buf_new(1)
fn drop(ptr board, int col, int player) int {
   mut row = H - 1
   while row >= 0 {
      if i64buf_load(board, row * W + col) == 0 {
         i64buf_store(board, row * W + col, player)
         return row
      }
      row -= 1
   }
   -1
}
fn won(ptr board, int row, int col, int player) bool {
   mut d = 0
   while d < 4 {
      mut dr = 0
      mut dc = 0
      if d == 0 { dc = 1 }
      if d == 1 { dr = 1 }
      if d == 2 { dr = 1 }
      if d == 3 { dr = 1 }
      if d == 2 { dc = 1 }
      if d == 3 { dc = -1 }
      mut count = 1
      mut step = 1
      while step >= -1 {
         mut r = row + dr * step
         mut c = col + dc * step
         while r >= 0 && r < H && c >= 0 && c < W && i64buf_load(board, r * W + c) == player {
            count += 1
            r += dr
            c += dc
         }
         step -= 2
      }
      if count >= 4 { return true }
      d += 1
   }
   false
}
fn evaluate(ptr board, int player) int {
   mut score = 0
   mut r = 0
   while r < H {
      mut c = 0
      while c < W {
         def v = i64buf_load(board, r * W + c)
         if v == player {
            if c == 3 { score += 4 } else { score += 3 }
         } else if v != 0 {
            if c == 3 { score -= 4 } else { score -= 3 }
         }
         c += 1
      }
      r += 1
   }
   score
}
fn search(ptr board, ptr meta, int depth, int alpha, int beta, int player) int {
   i64buf_store(meta, 0, i64buf_load(meta, 0) + 1)
   mut best = -1000000
   mut played = 0
   mut col = 0
   while col < W {
      def row = drop(board, col, player)
      if row >= 0 {
         played += 1
         mut score = 0
         if won(board, row, col, player) {
            score = 10000 + depth
         } else if depth <= 1 {
            score = evaluate(board, player)
         } else {
            score = -search(board, meta, depth - 1, -beta, -alpha, 3 - player)
         }
         i64buf_store(board, row * W + col, 0)
         if score > best { best = score }
         if best > alpha { alpha = best }
         if alpha >= beta { break }
      }
      col += 1
   }
   if played == 0 { 0 } else { best }
}
;; Fixed opening so both sides search the same non-trivial position.
drop(board, 3, 1)
drop(board, 2, 2)
drop(board, 4, 1)
drop(board, 1, 2)
drop(board, 3, 1)
def int t0 = ticks()
def score = search(board, meta, 7, -1000000, 1000000, 2)
def int t1 = ticks()
print("checksum=", (score * 1000003 + i64buf_load(meta, 0)) % 1000000007)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

enum { W = 7, H = 6 };
static int64_t *board, *meta;

static int drop_piece(int col, int player) {
    for (int row = H - 1; row >= 0; row--)
        if (board[row * W + col] == 0) { board[row * W + col] = player; return row; }
    return -1;
}

static int won(int row, int col, int player) {
    static const int dr[4] = {0, 1, 1, 1};
    static const int dc[4] = {1, 0, 1, -1};
    for (int d = 0; d < 4; d++) {
        int count = 1;
        for (int step = 1; step >= -1; step -= 2) {
            int r = row + dr[d] * step, c = col + dc[d] * step;
            while (r >= 0 && r < H && c >= 0 && c < W && board[r * W + c] == player) {
                count++;
                r += dr[d];
                c += dc[d];
            }
        }
        if (count >= 4) return 1;
    }
    return 0;
}

static int evaluate(int player) {
    int score = 0;
    for (int r = 0; r < H; r++)
        for (int c = 0; c < W; c++) {
            int v = (int)board[r * W + c];
            if (v == player) score += 3 + (c == 3);
            else if (v != 0) score -= 3 + (c == 3);
        }
    return score;
}

static int search(int depth, int alpha, int beta, int player) {
    meta[0] += 1;
    int best = -1000000, played = 0;
    for (int col = 0; col < W; col++) {
        int row = drop_piece(col, player);
        if (row >= 0) {
            played++;
            int score;
            if (won(row, col, player)) score = 10000 + depth;
            else if (depth <= 1) score = evaluate(player);
            else score = -search(depth - 1, -beta, -alpha, 3 - player);
            board[row * W + col] = 0;
            if (score > best) best = score;
            if (best > alpha) alpha = best;
            if (alpha >= beta) break;
        }
    }
    return played == 0 ? 0 : best;
}

int main(void) {
    board = calloc(W * H, sizeof(int64_t));
    meta = calloc(1, sizeof(int64_t));
    drop_piece(3, 1);
    drop_piece(2, 2);
    drop_piece(4, 1);
    drop_piece(1, 2);
    drop_piece(3, 1);
    int64_t t0 = now_ns();
    int score = search(7, -1000000, 1000000, 2);
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)((score * 1000003LL + meta[0]) % 1000000007LL));
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    free(board); free(meta);
    return 0;
}
C
}
