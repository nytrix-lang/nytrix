shape sieve {
  family "perf-real"
  generator "stress"
  features ["perf", "raw-buffer", "c-vs-ny", "native", "checksum", "time"]
  meta "spec:types:array-vs-raw"
  template ny-test-case
  tier "critical"
  budget {
    max_native_c_ratio 10.0
    max_ny_compile_ms 3000
  }
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
def N = 6000000
fn sieve(int n) int {
 if n < 2 { return 0 }
 def size = (n >> 1) + 1
 def flags = malloc(size)
 memset(flags, 1, size)
 mut count = 1
 mut p = 3
 while p * p <= n {
  if load8(flags, p >> 1) {
   mut idx = (p * p) >> 1
   while idx < size {
    store8(flags, 0, idx)
    idx += p
   }
  }
  p += 2
 }
 ;; Flags contain only 0 or 1. Count eight odd candidates per unaligned
 ;; 64-bit load; multiplying by the repeated-byte constant places their sum
 ;; in the high byte. Keep the tail in bounds for arbitrary input sizes.
 mut i = 1
 while i + 8 <= size {
  count += (load64(flags, i) * 0x0101010101010101) >> 56
  i += 8
 }
 while i < size {
  if load8(flags, i) { count += 1 }
  i += 1
 }
 free(flags)
 count
}
def int t0 = ticks()
def r = sieve(N)
def int t1 = ticks()
print("checksum=", r)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int sieve(int n) {
    if (n < 2) return 0;
    int size = (n >> 1) + 1;
    unsigned char *flags = (unsigned char *)malloc((size_t)size);
    if (!flags) exit(2);
    memset(flags, 1, (size_t)size);
    int count = 1;
    for (int p = 3; p * p <= n; p += 2) {
        if (flags[p >> 1]) {
            for (int idx = (p * p) >> 1; idx < size; idx += p) flags[idx] = 0;
        }
    }
    for (int i = 3; i <= n; i += 2) if (flags[i >> 1]) count++;
    free(flags);
    return count;
}
int main(void) {
    int64_t start = now_ns();
    int r = sieve(6000000);
    int64_t end = now_ns();
    printf("checksum=%lld\n", (long long)r);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
  source py <<'PY'
import time

N = 6000000

def sieve(n):
    if n < 2:
        return 0
    flags = bytearray(b"\x01") * ((n >> 1) + 1)
    p = 3
    while p * p <= n:
        if flags[p >> 1]:
            mul = p * p
            while mul <= n:
                flags[mul >> 1] = 0
                mul += p * 2
        p += 2
    count = 1
    i = 3
    while i <= n:
        if flags[i >> 1]:
            count += 1
        i += 2
    return count

start = time.process_time_ns()
r = sieve(N)
end = time.process_time_ns()
print(f"checksum={r}")
print(f"elapsed_ns={max(1, end - start)}")
PY
}
