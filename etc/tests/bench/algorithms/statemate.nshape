shape statemate {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "branchy", "state-machine", "c-vs-ny", "native", "checksum", "time"]
  meta "car-window statechart dispatch over 200000 events"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
;; Branch-heavy statechart dispatch, the shape statemate stresses: six states,
;; four events, every transition an if-chain rather than a table lookup.
def NEV = 200000
mut state = 0
mut lcg = 12345
def int t0 = ticks()
mut acc = 0
mut step = 0
while step < NEV {
   lcg = (lcg * 1103515245 + 12345) & 0x7FFFFFFF
   def ev = (lcg >> 16) & 3
   if state == 0 {
      if ev == 0 { state = 1 } else { if ev == 1 { state = 2 } else { if ev == 2 { state = 3 } else { state = 5 } } }
   } else {
      if state == 1 {
         if ev == 0 { state = 1 } else { if ev == 1 { state = 2 } else { if ev == 2 { state = 0 } else { state = 5 } } }
      } else {
         if state == 2 {
            if ev == 0 { state = 1 } else { if ev == 1 { state = 2 } else { if ev == 2 { state = 0 } else { state = 5 } } }
         } else {
            if state == 3 {
               if ev == 0 { state = 3 } else { if ev == 1 { state = 4 } else { if ev == 2 { state = 0 } else { state = 5 } } }
            } else {
               if state == 4 {
                  if ev == 0 { state = 3 } else { if ev == 1 { state = 4 } else { if ev == 2 { state = 0 } else { state = 5 } } }
               } else {
                  if ev == 0 { state = 1 } else { if ev == 1 { state = 2 } else { if ev == 2 { state = 0 } else { state = 5 } } }
               }
            }
         }
      }
   }
   acc = (acc * 31 + state * 7 + ev) % 1000000007
   step += 1
}
def int t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int NEV = 200000;
    int64_t state = 0, lcg = 12345, acc = 0;
    int64_t t0 = now_ns();
    for (int step = 0; step < NEV; step++) {
        lcg = (lcg * 1103515245LL + 12345) & 0x7FFFFFFF;
        int64_t ev = (lcg >> 16) & 3;
        if (state == 0) {
            if (ev == 0) state = 1;
            else if (ev == 1) state = 2;
            else if (ev == 2) state = 3;
            else state = 5;
        } else if (state == 1) {
            if (ev == 0) state = 1;
            else if (ev == 1) state = 2;
            else if (ev == 2) state = 0;
            else state = 5;
        } else if (state == 2) {
            if (ev == 0) state = 1;
            else if (ev == 1) state = 2;
            else if (ev == 2) state = 0;
            else state = 5;
        } else if (state == 3) {
            if (ev == 0) state = 3;
            else if (ev == 1) state = 4;
            else if (ev == 2) state = 0;
            else state = 5;
        } else if (state == 4) {
            if (ev == 0) state = 3;
            else if (ev == 1) state = 4;
            else if (ev == 2) state = 0;
            else state = 5;
        } else {
            if (ev == 0) state = 1;
            else if (ev == 1) state = 2;
            else if (ev == 2) state = 0;
            else state = 5;
        }
        acc = (acc * 31 + state * 7 + ev) % 1000000007LL;
    }
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
