shape hash {
  family "perf-real"
  generator "stress"
  features ["perf", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
;; djb2-style 32-bit rolling hash over an LCG byte stream.
def N = 1000000
mut seed = 42
mut h = 5381
mut i = 0
def t0 = ticks()
while i < N {
   seed = (seed * 3877 + 29573) % 139968
   h = ((h * 33) + (seed % 256)) & 0xFFFFFFFF
   i += 1
}
def t1 = ticks()
print("checksum=", h)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int N = 1000000;
    int seed = 42;
    unsigned int h = 5381u;
    int64_t start = now_ns();
    for (int i = 0; i < N; i++) {
        seed = (seed * 3877 + 29573) % 139968;
        h = ((h * 33u) + (unsigned int)(seed % 256)) & 0xFFFFFFFFu;
    }
    int64_t end = now_ns();
    printf("checksum=%u\n", h);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
