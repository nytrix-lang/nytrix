shape iter {
  family "perf-real"
  generator "stress"
  features ["perf", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
;; Iterator-pipeline: map, reverse, chain over Ny lists.
def n = 20000
mut xs = []
mut i = 0
while i < n {
   xs = append(xs, i)
   i += 1
}
def start = ticks()
mut mapped = []
mut reversed = []
mut chained = []
i = 0
while i < n {
   mapped = append(mapped, xs[i] + 1)
   chained = append(chained, xs[i] + 1)
   i += 1
}
i = 0
while i < n {
   def v = mapped[n - 1 - i]
   reversed = append(reversed, v)
   chained = append(chained, v)
   i += 1
}
mut sum = 0
i = 0
while i < n * 2 {
   sum += chained[i]
   i += 1
}
def end = ticks()
print("checksum=", sum)
print("elapsed_ns=", end - start)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int n = 20000;
    int64_t *xs = malloc((size_t)n * sizeof(*xs));
    int64_t *mapped = malloc((size_t)n * sizeof(*mapped));
    int64_t *reversed = malloc((size_t)n * sizeof(*reversed));
    int64_t *chained = malloc((size_t)n * 2 * sizeof(*chained));
    if (!xs || !mapped || !reversed || !chained) return 2;
    for (int i = 0; i < n; i++) xs[i] = i;
    int64_t start = now_ns();
    for (int i = 0; i < n; i++) mapped[i] = xs[i] + 1;
    for (int i = 0; i < n; i++) reversed[i] = mapped[n - 1 - i];
    memcpy(chained, mapped, (size_t)n * sizeof(*chained));
    memcpy(chained + n, reversed, (size_t)n * sizeof(*chained));
    int64_t sum = 0;
    for (int i = 0; i < n * 2; i++) sum += chained[i];
    int64_t end = now_ns();
    free(xs); free(mapped); free(reversed); free(chained);
    printf("checksum=%lld\n", (long long)sum);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
