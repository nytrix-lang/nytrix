shape dgemm {
  family "perf-real"
  generator "stress"
  features ["perf", "fp", "matmul", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
use std.core.tbuf
;; Dense double matrix multiply (64x64): integer-valued inputs keep results exact.
def M = 64
def A = f64buf_new(M * M)
def B = f64buf_new(M * M)
def C = f64buf_new(M * M)
mut i = 0
while i < M * M {
   f64buf_store(A, i, float((i / M) + 1))
   f64buf_store(B, i, float((i % M) + 1))
   i += 1
}
def t0 = ticks()
mut r = 0
while r < M {
   mut cc = 0
   while cc < M {
      mut s = 0.0
      mut k = 0
      while k < M {
         s += f64buf_load(A, r * M + k) * f64buf_load(B, k * M + cc)
         k += 1
      }
      f64buf_store(C, r * M + cc, s)
      cc += 1
   }
   r += 1
}
def t1 = ticks()
;; Verify the entire result matrix exactly (values are exact integers).
mut conv = 1
mut r2 = 0
while r2 < M {
   mut c2 = 0
   while c2 < M {
      def val = f64buf_load(C, r2 * M + c2)
      if val != float(M * (r2 + 1) * (c2 + 1)) { conv = 0 }
      c2 += 1
   }
   r2 += 1
}
print("checksum=", conv)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    int M = 64;
    double *A = (double *)malloc((size_t)M * M * sizeof(double));
    double *B = (double *)malloc((size_t)M * M * sizeof(double));
    double *C = (double *)malloc((size_t)M * M * sizeof(double));
    for (int i = 0; i < M * M; i++) {
        A[i] = (double)((i / M) + 1);
        B[i] = (double)((i % M) + 1);
        C[i] = 0.0;
    }
    int64_t start = now_ns();
    for (int r = 0; r < M; r++)
        for (int c = 0; c < M; c++) {
            double s = 0.0;
            for (int k = 0; k < M; k++) s += A[r * M + k] * B[k * M + c];
            C[r * M + c] = s;
        }
    int64_t end = now_ns();
    int conv = 1;
    for (int r = 0; r < M; r++)
        for (int c = 0; c < M; c++)
            if (C[r * M + c] != (double)(M * (r + 1) * (c + 1))) conv = 0;
    printf("checksum=%d\n", conv);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
