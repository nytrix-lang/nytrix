shape list {
  family "perf-real"
  generator "stress"
  features ["perf", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
def n = 20000
;; List (Benchmark): fill and sum a Ny list.
def start = ticks()
mut lst = []
mut i = 0
while i < n {
   lst = append(lst, i)
   i += 1
}
mut sum = 0
i = 0
while i < n {
   sum = sum + lst[i]
   i += 1
}
def end = ticks()
def expected = (n - 1) * n / 2 ;; Sum of 0..n-1
if sum != expected { sum = -2 }
print("checksum=", sum)
print("elapsed_ns=", end - start)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int n = 20000;
    int64_t *lst = malloc((size_t)n * sizeof(*lst));
    if (!lst) return 2;
    int64_t start = now_ns();
    for (int i = 0; i < n; i++) lst[i] = i;
    int64_t sum = 0;
    for (int i = 0; i < n; i++) sum += lst[i];
    int64_t expected = (int64_t)(n - 1) * n / 2;
    int64_t end = now_ns();
    free(lst);
    if (sum != expected) return 3;
    printf("checksum=%lld\n", (long long)sum);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
