shape bench_float {
  family "perf-real"
  generator "stress"
  features ["perf", "float", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
def t0 = ticks()
mut x = 0.0
for i in 0..5000000 {
  x = x + 1.5
  x = x * 0.999
}
def t1 = ticks()
print("checksum=", x > 0.0)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
  int64_t t0 = now_ns();
  double x = 0.0;
  for (int i = 0; i < 5000000; i++) {
    x = x + 1.5;
    x = x * 0.999;
  }
  int64_t t1 = now_ns();
  printf("checksum=%s\n", x > 0.0 ? "true" : "false");
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
