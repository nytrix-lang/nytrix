shape binary-trees {
  family "perf-real"
  generator "stress"
  features ["perf", "gc", "recursion", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
;; Binary-trees: recursive full-tree node count with per-node allocation.
fn count(int depth) int {
   def n = [depth]
   if depth <= 0 { return 1 }
   1 + count(depth - 1) + count(depth - 1)
}
def t0 = ticks()
mut d = 4
mut acc = 0
while d <= 10 {
   acc += count(d)
   d += 1
}
def t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static long count(int depth) {
    long *n = (long *)malloc(16);
    n[0] = (long)depth;
    if (depth <= 0) return 1;
    return 1 + count(depth - 1) + count(depth - 1);
}

int main(void) {
    int64_t start = now_ns();
    long acc = 0;
    for (int d = 4; d <= 10; d++) acc += count(d);
    int64_t end = now_ns();
    printf("checksum=%ld\n", acc);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
