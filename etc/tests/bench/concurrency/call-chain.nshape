shape bench_call_chain {
  family "perf-real"
  generator "stress"
  features ["perf", "call", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  tier "critical"
  budget {
    max_native_c_ratio 30.0
    max_ny_compile_ms 3000
  }
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
fn add(int a, int b) int { a + b }
fn mul(int a, int b) int { a * b }
fn chain(int n) int {
  def a = add(n, 1)
  def b = mul(a, 2)
  def c = add(b, n)
  c
}
;; The seed is a fixed constant: deriving it from argc() made the checksum
;; sensitive to how many arguments each route's launcher passes (Ny native,
;; Ny LLVM, and the C host all count argv differently under the bench
;; harness, so identical computation disagreed by a few units).
def seed = 3
mut r = 0
mut i = 0
def int t0 = ticks()
while i < 500000 {
  r += chain((i + seed) % 501)
  i += 1
}
def int t1 = ticks()
print("checksum=", r)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int64_t chain(int64_t n) {
  int64_t a = n + 1;
  int64_t b = a * 2;
  return b + n;
}

int main(int argc, char **argv) {
  (void)argv;
  (void)argc;
  /* Match Ny's 64-bit integer operations; int32 let C vectorize a different
     arithmetic width and made the native/C ratio misleading. */
  int64_t seed = 3;
  int64_t t0 = now_ns();
  int64_t r = 0;
  for (int64_t i = 0; i < 500000; i++)
    r += chain((i + seed) % 501);
  int64_t t1 = now_ns();
  printf("checksum=%lld\n", (long long)r);
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
