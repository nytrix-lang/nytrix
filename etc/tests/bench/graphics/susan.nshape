shape susan {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "image", "stencil", "c-vs-ny", "native", "checksum", "time"]
  meta "SUSAN-style 3x3 smoothing and edge response over 256x256"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Two-pass 3x3 image filter: smooth, then mark pixels whose centre differs
;; from the local mean by more than a fixed threshold.
def N = 256
def img = i64buf_new(N * N)
def out = i64buf_new(N * N)
mut i = 0
while i < N * N {
   i64buf_store(img, i, (i * 17 + 13) % 256)
   i += 1
}
def int t0 = ticks()
mut pass = 0
while pass < 4 {
   mut y = 1
   while y < N - 1 {
      mut x = 1
      while x < N - 1 {
         mut sum = 0
         mut dy = -1
         while dy <= 1 {
            mut dx = -1
            while dx <= 1 {
               sum += i64buf_load(img, (y + dy) * N + x + dx)
               dx += 1
            }
            dy += 1
         }
         def avg = sum / 9
         def center = i64buf_load(img, y * N + x)
         mut diff = center - avg
         if diff < 0 { diff = -diff }
         mut edge = 0
         if diff > 20 { edge = 1 }
         i64buf_store(out, y * N + x, (avg + edge * 97) % 256)
         x += 1
      }
      y += 1
   }
   i = 0
   while i < N * N {
      i64buf_store(img, i, i64buf_load(out, i))
      i += 1
   }
   pass += 1
}
mut ck = 0
i = 0
while i < N * N {
   ck = (ck + i64buf_load(img, i) * (i % 251)) % 1000000007
   i += 1
}
def int t1 = ticks()
print("checksum=", ck)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int N = 256;
    int64_t *img = malloc((size_t)N * N * sizeof(int64_t));
    int64_t *out = malloc((size_t)N * N * sizeof(int64_t));
    for (int i = 0; i < N * N; i++) img[i] = (i * 17 + 13) % 256;
    int64_t t0 = now_ns();
    for (int pass = 0; pass < 4; pass++) {
        for (int y = 1; y < N - 1; y++)
            for (int x = 1; x < N - 1; x++) {
                int64_t sum = 0;
                for (int dy = -1; dy <= 1; dy++)
                    for (int dx = -1; dx <= 1; dx++)
                        sum += img[(y + dy) * N + x + dx];
                int64_t avg = sum / 9;
                int64_t diff = img[y * N + x] - avg;
                if (diff < 0) diff = -diff;
                out[y * N + x] = (avg + (diff > 20 ? 97 : 0)) % 256;
            }
        for (int i = 0; i < N * N; i++) img[i] = out[i];
    }
    int64_t ck = 0;
    for (int i = 0; i < N * N; i++)
        ck = (ck + img[i] * (i % 251)) % 1000000007LL;
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)ck);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    free(img); free(out);
    return 0;
}
C
}
