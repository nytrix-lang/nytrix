shape bench_dict {
  family "perf-real"
  generator "stress"
  features ["perf", "dict", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
def n = 50000 * argc()
mut d = dict()
mut i = 0
while i < n {
  d.set(to_str(i), i)
  i += 1
}
mut acc = 0
i = 0
def t0 = ticks()
while i < n {
  acc += d.get(to_str(i), 0)
  i += 1
}
def t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define HSIZE 131072

typedef struct { char key[16]; int val; int used; } Slot;

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static unsigned long hstr(const char *s) {
  unsigned long h = 5381;
  while (*s) h = h * 33 + (unsigned char)(*s++);
  return h;
}

int main(int argc, char **argv) {
  (void)argv;
  int n = 50000 * argc;
  Slot *tbl = (Slot *)calloc((size_t)HSIZE, sizeof(Slot));
  if (!tbl) return 2;
  char key[16];
  /* Insert (untimed, matching the set loop before t0). */
  for (int i = 0; i < n; i++) {
    snprintf(key, sizeof(key), "%d", i);
    unsigned long h = hstr(key) & (HSIZE - 1);
    while (tbl[h].used) h = (h + 1) & (HSIZE - 1);
    tbl[h].used = 1;
    tbl[h].val = i;
    strncpy(tbl[h].key, key, sizeof(tbl[h].key) - 1);
  }
  int64_t t0 = now_ns();
  int acc = 0;
  for (int i = 0; i < n; i++) {
    snprintf(key, sizeof(key), "%d", i);
    unsigned long h = hstr(key) & (HSIZE - 1);
    while (tbl[h].used && strcmp(tbl[h].key, key) != 0)
      h = (h + 1) & (HSIZE - 1);
    acc += tbl[h].val;
  }
  int64_t t1 = now_ns();
  free(tbl);
  printf("checksum=%d\n", acc);
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
