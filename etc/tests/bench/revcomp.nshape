shape revcomp {
  family "perf-real"
  generator "stress"
  features ["perf", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
;; Reverse-complement: generate a DNA code stream, then sum its
;; complemented reverse (3 - code). Byte-oriented memory benchmark.
def N = 100000
mut seed = 42
mut buf = []
mut i = 0
while i < N {
   seed = (seed * 3877 + 29573) % 139968
   buf = append(buf, seed % 4)
   i += 1
}
mut sum = 0
i = 0
def t0 = ticks()
while i < N {
   sum += 3 - buf[N - 1 - i]
   i += 1
}
def t1 = ticks()
print("checksum=", sum * 1000000 + N)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int N = 100000;
    unsigned char *buf = malloc((size_t)N);
    int seed = 42;
    for (int i = 0; i < N; i++) {
        seed = (seed * 3877 + 29573) % 139968;
        buf[i] = (unsigned char)(seed % 4);
    }
    int64_t sum = 0;
    int64_t start = now_ns();
    for (int i = 0; i < N; i++) sum += 3 - buf[N - 1 - i];
    int64_t end = now_ns();
    free(buf);
    printf("checksum=%lld\n", (long long)(sum * 1000000 + N));
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
