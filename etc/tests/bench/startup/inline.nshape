shape bench_inline {
  family "perf-real"
  generator "stress"
  features ["perf", "inline", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
;; Function Inlining (Benchmark)
fn add(int a, int b) int { a + b }
fn mul(int a, int b) int { a * b }
fn loop(int n) int {
  mut int sum = 0
  mut int i = 0
  while i < n {
    sum = add(sum, mul(i, 2))
    i += 1
  }
  sum
}
;; Keep the benchmark input identical across Ny and C launchers.
def int seed = 3
mut int r = 0
mut int i = 0
def int t0 = ticks()
while i < 50000 {
  r += loop(100 + (i + seed) % 5)
  i += 1
}
def int t1 = ticks()
print("checksum=", r)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int64_t add(int64_t a, int64_t b) { return a + b; }
static int64_t mul(int64_t a, int64_t b) { return a * b; }

static int64_t loop(int64_t n) {
    int64_t sum = 0;
    for (int64_t i = 0; i < n; i++) sum = add(sum, mul(i, 2));
    return sum;
}

int main(int argc, char **argv) {
    (void)argc;
    (void)argv;
    int64_t seed = 3;
    int64_t start = now_ns();
    int64_t r = 0;
    for (int i = 0; i < 50000; i++) r += loop(100 + (i + seed) % 5);
    int64_t end = now_ns();
    printf("checksum=%lld\n", (long long)r);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
