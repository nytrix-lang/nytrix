shape bench_currying_direct_residual_factory {
  family "perf-real"
  generator "stress"
  features ["perf", "calls", "currying", "c-vs-ny", "checksum", "time"]
  ;; Both sources publish every iteration through a global slot, so NYR/C is
  ;; the closure-call cost plus one store, not a sub-100ns clock sample. The
  ;; ceiling only catches a new blow-up.
  budget {
    max_native_c_ratio 8000.0
    max_native_llvm_ratio 4.0
  }
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time

fn step(int a, int b) int { a * 3 + b }

;; Both sides publish every result through a global slot so the timed loops
;; keep one store per iteration.  Without it clang folds the C loops into a
;; closed form and the comparison measures nothing.
mut int keep_slot = 0
fn keep(int v) int {
   keep_slot = v
   keep_slot
}

def int n = 2000 + argc()

mut int direct = 0
mut int i = 0
def int t0 = ticks()
while i < n {
   direct += keep(step(i, 1))
   i += 1
}
def int t1 = ticks()

def bound = step(1)
mut int residual = 0
i = 0
def int t2 = ticks()
while i < n {
   residual += keep(bound(i))
   i += 1
}
def int t3 = ticks()

mut int factory = 0
i = 0
def int t4 = ticks()
while i < n {
   def p = step(i)
   factory += keep(p(1))
   i += 1
}
def int t5 = ticks()

print("checksum=", direct + residual + factory)
print("direct_ns=", t1 - t0)
print("residual_ns=", t3 - t2)
print("factory_ns=", t5 - t4)
print("elapsed_ns=", (t1 - t0) + (t3 - t2) + (t5 - t4))
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

typedef struct { int64_t a; } Partial;

static int64_t step(int64_t a, int64_t b) { return a * 3 + b; }
static int64_t call_partial(Partial p, int64_t b) { return step(p.a, b); }

/*
 * Clang reduces the three loops to a closed form and the timed section
 * collapses onto the clock read (~80ns), which drops NYR/C. A volatile
 * publish keeps each iteration and the checksum.
 */
static volatile int64_t keep_slot;
static int64_t keep(int64_t v) {
  keep_slot = v;
  return keep_slot;
}

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(int argc, char **argv) {
  (void)argv;
  int64_t n = 2000 + argc;
  int64_t direct = 0, residual = 0, factory = 0, i;
  int64_t t0 = now_ns();
  for (i = 0; i < n; ++i) direct += keep(step(i, 1));
  int64_t t1 = now_ns();
  Partial bound = {1};
  for (i = 0; i < n; ++i) residual += keep(call_partial(bound, i));
  int64_t t3 = now_ns();
  for (i = 0; i < n; ++i) {
    Partial p = {i};
    factory += keep(call_partial(p, 1));
  }
  int64_t t5 = now_ns();
  printf("checksum=%lld\n", (long long)(direct + residual + factory));
  printf("direct_ns=%lld\n", (long long)(t1 - t0));
  printf("residual_ns=%lld\n", (long long)(t3 - t1));
  printf("factory_ns=%lld\n", (long long)(t5 - t3));
  printf("elapsed_ns=%lld\n", (long long)(t5 - t0));
  return 0;
}
C
}
