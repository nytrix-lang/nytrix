shape bench_native_oracle {
  family "runtime-native"
  generator "native"
  features ["native", "oracle", "x86_64", "checksum"]
  template ny-test-case
  flags "--native-backend x86_64 --native-result-oracle"
  expect compile_and_run
  source ny <<'NY'
use core
fn fib(n) {
  mut a = 0
  mut b = 1
  mut i = 2
  while i <= n {
    def c = a + b
    a = b
    b = c
    i += 1
  }
  return b
}
def r = fib(30)
print("checksum=", r)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>

int main(void) {
  int64_t a = 0;
  int64_t b = 1;
  for (int i = 2; i <= 30; i++) {
    int64_t next = a + b;
    a = b;
    b = next;
  }
  printf("checksum=%lld\n", (long long)b);
  return 0;
}
C
}
