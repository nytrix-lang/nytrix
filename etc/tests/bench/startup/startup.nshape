shape bench_startup {
  family "perf-real"
  generator "stress"
  features ["perf", "startup", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
;; Average many empty timer intervals so the floor estimate is not one noisy
;; clock read pair. The loop itself stays outside each measured interval.
def int samples = 1024
mut elapsed = 0
mut i = 0
while i < samples {
  def int t0 = ticks()
  def int t1 = ticks()
  elapsed += t1 - t0
  i += 1
}
print("checksum=0")
print("elapsed_ns=", elapsed / samples)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
  const int samples = 1024;
  int64_t elapsed = 0;
  for (int i = 0; i < samples; i++) {
    int64_t t0 = now_ns();
    int64_t t1 = now_ns();
    elapsed += t1 - t0;
  }
  printf("checksum=0\n");
  printf("elapsed_ns=%lld\n", (long long)(elapsed / samples));
  return 0;
}
C
}
