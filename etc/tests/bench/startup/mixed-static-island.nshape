shape mixed-static-island {
  family "perf-real"
  generator "stress"
  features ["perf", "dynamic-boundary", "static-island", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time

;; The dynamic value crosses the loop only once. The induction and accumulator
;; remain concrete integers; this catches representation contamination.
fn identity(any value) any { value }

def int N = 20000 + (argc() & 1)
mut int i = 0
mut int sum = 1
mut any dynamic = identity(7)
def int t0 = ticks()
while i < N {
   sum = ((sum ^ i) * 3 + 1) & 1073741823
   if i == N / 2 { dynamic = identity(dynamic) }
   i += 1
}
def int t1 = ticks()
print("checksum=", sum + dynamic)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(int argc, char **argv) {
    (void)argv;
    const int64_t n = 20000 + (argc & 1);
    int64_t dynamic = 7;
    int64_t sum = 1;
    int64_t start = now_ns();
    for (int64_t i = 0; i < n; ++i) {
        sum = ((sum ^ i) * 3 + 1) & 1073741823;
        if (i == n / 2) dynamic = dynamic;
    }
    int64_t end = now_ns();
    printf("checksum=%lld\n", (long long)(sum + dynamic));
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
