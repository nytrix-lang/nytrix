shape recursive_fibonacci {
  family "perf-real"
  generator "stress"
  features ["perf", "c-vs-ny", "checksum", "calls", "recursion"]
  budget {
    max_native_c_ratio 2.0
    max_native_llvm_ratio 2.0
  }
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.os.prim (env)
use core.common (parse_nonneg_int)

fn fib(int n) int {
   if n < 2 { return n }
   fib(n - 1) + fib(n - 2)
}

def int requested_n = parse_nonneg_int(env("NYTRIX_BENCH_FIB_N"))
def int n = requested_n >= 2 ? requested_n : 29
mut total = 0
def int start = ticks()
mut i = 0
while i < 5 {
   total += fib(n)
   i += 1
}
def int finish = ticks()
print("checksum=", total)
print("elapsed_ns=", finish - start)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(int argc, char **argv) {
    (void)argc;
    (void)argv;
    const char *requested_n = getenv("NYTRIX_BENCH_FIB_N");
    int64_t n = requested_n ? strtoll(requested_n, NULL, 10) : 0;
    if (n < 2) n = 29;
    int64_t start = now_ns();
    int64_t total = 0;
    for (int i = 0; i < 5; ++i) {
        int64_t a = 0, b = 1;
        for (int64_t j = 0; j < n; ++j) {
            int64_t next = a + b;
            a = b;
            b = next;
        }
        total += a;
    }
    int64_t finish = now_ns();
    printf("checksum=%lld\n", (long long)total);
    if (finish <= start) finish = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(finish - start));
    return 0;
}
C
}
