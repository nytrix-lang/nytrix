shape bench_matrix {
  family "perf-real"
  generator "stress"
  features ["perf", "matrix", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
fn zeros(int n) list {
   mut r = []
   mut i = 0
   while i < n {
      r = append(r, 0)
      i += 1
   }
   return r
}
fn dot(list a, list b) number {
  mut s = 0
  for i in 0..a.len-1 { s += a[i] * b[i] }
  s
}
def n = 128
mut row = zeros(n)
mut col = zeros(n)
def t0 = ticks()
mut acc = 0.0
for i in 0..n-1 {
  for j in 0..n-1 {
    row[j] = i * n + j
    col[j] = j * n + i
  }
  acc += dot(row, col)
}
def t1 = ticks()
print("checksum=", acc > 0.0)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static double dot(const int *a, const int *b, int n) {
  double s = 0.0;
  for (int i = 0; i < n; i++)
    s += (double)a[i] * b[i];
  return s;
}

int main(void) {
  int64_t t0 = now_ns();
  const int n = 128;
  int row[128], col[128];
  double acc = 0.0;
  for (int i = 0; i < n; i++) {
    for (int j = 0; j < n; j++) {
      row[j] = i * n + j;
      col[j] = j * n + i;
    }
    acc += dot(row, col, n);
  }
  int64_t t1 = now_ns();
  printf("checksum=%s\n", acc > 0.0 ? "true" : "false");
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
