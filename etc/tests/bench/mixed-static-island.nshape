shape mixed-static-island {
  family "perf-real"
  generator "stress"
  features ["perf", "dynamic-boundary", "static-island", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time

;; The dynamic value crosses the loop only once. The induction and accumulator
;; remain concrete integers; this catches representation contamination.
fn identity(any value) any { value }

def N = 10000
mut int i = 0
mut int sum = 0
mut any dynamic = identity(7)
def t0 = ticks()
while i < N {
   sum += i
   if i == N / 2 { dynamic = identity(dynamic) }
   i += 1
}
def t1 = ticks()
print("checksum=", sum)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const long n = 10000;
    long dynamic = 7;
    long sum = 0;
    int64_t start = now_ns();
    for (long i = 0; i < n; ++i) {
        sum += i;
        if (i == n / 2) dynamic = dynamic;
    }
    printf("checksum=%ld\n", sum);
    int64_t end = now_ns();
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
