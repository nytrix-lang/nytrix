shape bench_call_chain {
  family "perf-real"
  generator "stress"
  features ["perf", "call", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
fn add(int a, int b) int { a + b }
fn mul(int a, int b) int { a * b }
fn chain(int n) int {
  def a = add(n, 1)
  def b = mul(a, 2)
  def c = add(b, n)
  c
}
def seed = argc()
mut r = 0
mut i = 0
def t0 = ticks()
while i < 500000 {
  r += chain((i + seed) % 501)
  i += 1
}
def t1 = ticks()
print("checksum=", r)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int chain(int n) {
  int a = n + 1;
  int b = a * 2;
  return b + n;
}

int main(int argc, char **argv) {
  (void)argv;
  int seed = argc;
  int64_t t0 = now_ns();
  int r = 0;
  for (int i = 0; i < 500000; i++)
    r += chain((i + seed) % 501);
  int64_t t1 = now_ns();
  printf("checksum=%d\n", r);
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
