shape bench_loop_unswitch {
  family "perf-real"
  generator "stress"
  features ["perf", "loop_unswitch", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
;; Loop Unswitching (Benchmark)
fn loop(i64 n, i64 flag) i64 {
  mut sum = 0
  mut i = 0
  while i < 100 {
    if flag { sum = i + 1 } else { sum = i * 2 }
    i += 1
  }
  sum
}
def seed = argc()
mut r = 0
mut i = 0
def t0 = ticks()
while i < 50000 {
  r += loop(100, (i + seed) % 2)
  i += 1
}
def t1 = ticks()
print("checksum=", r)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int64_t cond_true(int64_t x) { return x + 1; }
static int64_t cond_false(int64_t x) { return x * 2; }

static int64_t loop(int64_t n, int64_t flag) {
    (void)n;
    volatile int64_t sum = 0;
    for (int64_t i = 0; i < 100; i++) {
        sum = flag ? (i + 1) : (i * 2);
    }
    return sum;
}

int main(int argc, char **argv) {
    (void)argv;
    int64_t seed = argc;
    int64_t start = now_ns();
    int64_t r = 0;
    for (int i = 0; i < 50000; i++) r += loop(100, (i + seed) % 2);
    int64_t end = now_ns();
    printf("checksum=%lld\n", (long long)r);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
