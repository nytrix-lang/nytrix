shape monte-carlo {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "monte-carlo", "search", "c-vs-ny", "native", "checksum", "time"]
  meta "Monte Carlo rollouts of a take-away game"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
;; Deterministic Monte Carlo rollouts of a take-away game (one to three pieces).
def GAMES = 200000
mut acc = 0
mut g = 0
def int t0 = ticks()
while g < GAMES {
   mut pile = 21
   mut moves = 0
   mut last = 0
   while pile > 0 {
      mut take = ((pile * 7 + g * 13 + moves * 3) % 3) + 1
      if take > pile { take = pile }
      pile -= take
      last = take
      moves += 1
   }
   acc = (acc + moves * 1000 + last) % 1000000007
   g += 1
}
def int t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int GAMES = 200000;
    int64_t acc = 0;
    int64_t t0 = now_ns();
    for (int g = 0; g < GAMES; g++) {
        int64_t pile = 21;
        int64_t moves = 0;
        int64_t last = 0;
        while (pile > 0) {
            int64_t take = ((pile * 7 + g * 13 + moves * 3) % 3) + 1;
            if (take > pile) take = pile;
            pile -= take;
            last = take;
            moves++;
        }
        acc = (acc + moves * 1000 + last) % 1000000007;
    }
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
