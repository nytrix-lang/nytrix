shape collision-detect {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "collision", "aabb", "c-vs-ny", "native", "checksum", "time"]
  meta "moving AABB collision counting"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.os.time
;; Two hundred moving boxes, pairwise axis-aligned overlap counting.
def N = 200
def ptr px = i64buf_new(N)
def ptr py = i64buf_new(N)
def ptr vx = i64buf_new(N)
def ptr vy = i64buf_new(N)
mut i = 0
while i < N {
   i64buf_store(px, i, (i * 37 + 11) % 1024)
   i64buf_store(py, i, (i * 53 + 7) % 1024)
   i64buf_store(vx, i, (i % 7) - 3)
   i64buf_store(vy, i, (i % 5) - 2)
   i += 1
}
mut acc = 0
def int t0 = ticks()
mut step = 0
while step < 200 {
   i = 0
   while i < N {
      mut x = i64buf_load(px, i) + i64buf_load(vx, i)
      mut y = i64buf_load(py, i) + i64buf_load(vy, i)
      mut dx = i64buf_load(vx, i)
      mut dy = i64buf_load(vy, i)
      if x < 0 { x = 0 dx = -dx }
      if x > 1024 { x = 1024 dx = -dx }
      if y < 0 { y = 0 dy = -dy }
      if y > 1024 { y = 1024 dy = -dy }
      i64buf_store(px, i, x)
      i64buf_store(py, i, y)
      i64buf_store(vx, i, dx)
      i64buf_store(vy, i, dy)
      i += 1
   }
   mut hits = 0
   i = 0
   while i < N {
      mut j = i + 1
      while j < N {
         mut ax = i64buf_load(px, i) - i64buf_load(px, j)
         mut ay = i64buf_load(py, i) - i64buf_load(py, j)
         if ax < 0 { ax = -ax }
         if ay < 0 { ay = -ay }
         if ax < 8 {
            if ay < 8 { hits += 1 }
         }
         j += 1
      }
      i += 1
   }
   acc = (acc + hits) % 1000000007
   step += 1
}
def int t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int N = 200;
    int64_t *px = calloc((size_t)N, sizeof(int64_t));
    int64_t *py = calloc((size_t)N, sizeof(int64_t));
    int64_t *vx = calloc((size_t)N, sizeof(int64_t));
    int64_t *vy = calloc((size_t)N, sizeof(int64_t));
    for (int i = 0; i < N; i++) {
        px[i] = (i * 37 + 11) % 1024;
        py[i] = (i * 53 + 7) % 1024;
        vx[i] = (i % 7) - 3;
        vy[i] = (i % 5) - 2;
    }
    int64_t acc = 0;
    int64_t t0 = now_ns();
    for (int step = 0; step < 200; step++) {
        for (int i = 0; i < N; i++) {
            int64_t x = px[i] + vx[i];
            int64_t y = py[i] + vy[i];
            int64_t dx = vx[i];
            int64_t dy = vy[i];
            if (x < 0) { x = 0; dx = -dx; }
            if (x > 1024) { x = 1024; dx = -dx; }
            if (y < 0) { y = 0; dy = -dy; }
            if (y > 1024) { y = 1024; dy = -dy; }
            px[i] = x; py[i] = y; vx[i] = dx; vy[i] = dy;
        }
        int64_t hits = 0;
        for (int i = 0; i < N; i++) {
            for (int j = i + 1; j < N; j++) {
                int64_t ax = px[i] - px[j];
                int64_t ay = py[i] - py[j];
                if (ax < 0) ax = -ax;
                if (ay < 0) ay = -ay;
                if (ax < 8 && ay < 8) hits++;
            }
        }
        acc = (acc + hits) % 1000000007;
    }
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
