shape event-heap {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "heap", "event-queue", "c-vs-ny", "native", "checksum", "time"]
  meta "discrete-event queue simulation with timestamp ordering"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.os.time
;; Discrete-event simulation over a binary min-heap keyed by event time.
def Q = 4096
def ptr ht = i64buf_new(Q + 8)
def ptr hid = i64buf_new(Q + 8)
mut count = 0
mut i = 0
while i < Q {
   def t = (i * 37 + 11) % 10000
   i64buf_store(ht, count, t)
   i64buf_store(hid, count, i)
   mut pos = count
   count += 1
   mut go = 1
   while go == 1 {
      if pos == 0 { go = 0 } else {
         def parent = (pos - 1) / 2
         def pv = i64buf_load(ht, parent)
         def cv = i64buf_load(ht, pos)
         if pv > cv {
            i64buf_store(ht, parent, cv)
            i64buf_store(ht, pos, pv)
            def pi = i64buf_load(hid, parent)
            def ci = i64buf_load(hid, pos)
            i64buf_store(hid, parent, ci)
            i64buf_store(hid, pos, pi)
            pos = parent
         } else { go = 0 }
      }
   }
   i += 1
}
mut acc = 0
mut k = 0
def int t0 = ticks()
while k < 131072 {
   def t = i64buf_load(ht, 0)
   def id = i64buf_load(hid, 0)
   acc = (acc + t * 3 + id) % 1000000007
   count -= 1
   i64buf_store(ht, 0, i64buf_load(ht, count))
   i64buf_store(hid, 0, i64buf_load(hid, count))
   mut pos = 0
   mut go = 1
   while go == 1 {
      def left = pos * 2 + 1
      if left >= count { go = 0 } else {
         mut small = left
         def right = left + 1
         if right < count {
            if i64buf_load(ht, right) < i64buf_load(ht, left) { small = right }
         }
         def sv = i64buf_load(ht, small)
         def pv = i64buf_load(ht, pos)
         if sv < pv {
            i64buf_store(ht, small, pv)
            i64buf_store(ht, pos, sv)
            def si = i64buf_load(hid, small)
            def pi = i64buf_load(hid, pos)
            i64buf_store(hid, small, pi)
            i64buf_store(hid, pos, si)
            pos = small
         } else { go = 0 }
      }
   }
   def nt = t + ((id * 17 + 5) % 97) + 1
   def nid = id + 1
   i64buf_store(ht, count, nt)
   i64buf_store(hid, count, nid)
   pos = count
   count += 1
   go = 1
   while go == 1 {
      if pos == 0 { go = 0 } else {
         def parent = (pos - 1) / 2
         def pv = i64buf_load(ht, parent)
         def cv = i64buf_load(ht, pos)
         if pv > cv {
            i64buf_store(ht, parent, cv)
            i64buf_store(ht, pos, pv)
            def pi = i64buf_load(hid, parent)
            def ci = i64buf_load(hid, pos)
            i64buf_store(hid, parent, ci)
            i64buf_store(hid, pos, pi)
            pos = parent
         } else { go = 0 }
      }
   }
   k += 1
}
def int t1 = ticks()
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int Q = 4096;
    int64_t *ht = calloc((size_t)Q + 8, sizeof(int64_t));
    int64_t *hid = calloc((size_t)Q + 8, sizeof(int64_t));
    int count = 0;
    for (int i = 0; i < Q; i++) {
        int64_t t = (i * 37 + 11) % 10000;
        ht[count] = t;
        hid[count] = i;
        int pos = count++;
        int go = 1;
        while (go) {
            if (pos == 0) { go = 0; break; }
            int parent = (pos - 1) / 2;
            if (ht[parent] > ht[pos]) {
                int64_t pv = ht[parent], cv = ht[pos];
                ht[parent] = cv; ht[pos] = pv;
                int64_t pi = hid[parent], ci = hid[pos];
                hid[parent] = ci; hid[pos] = pi;
                pos = parent;
            } else go = 0;
        }
    }
    int64_t acc = 0;
    int64_t t0 = now_ns();
    for (int k = 0; k < 131072; k++) {
        int64_t t = ht[0];
        int64_t id = hid[0];
        acc = (acc + t * 3 + id) % 1000000007;
        count--;
        ht[0] = ht[count];
        hid[0] = hid[count];
        int pos = 0;
        int go = 1;
        while (go) {
            int left = pos * 2 + 1;
            if (left >= count) { go = 0; break; }
            int small = left;
            int right = left + 1;
            if (right < count && ht[right] < ht[left]) small = right;
            if (ht[small] < ht[pos]) {
                int64_t sv = ht[small], pv = ht[pos];
                ht[small] = pv; ht[pos] = sv;
                int64_t si = hid[small], pi = hid[pos];
                hid[small] = pi; hid[pos] = si;
                pos = small;
            } else go = 0;
        }
        int64_t nt = t + ((id * 17 + 5) % 97) + 1;
        int64_t nid = id + 1;
        ht[count] = nt;
        hid[count] = nid;
        pos = count++;
        go = 1;
        while (go) {
            if (pos == 0) { go = 0; break; }
            int parent = (pos - 1) / 2;
            if (ht[parent] > ht[pos]) {
                int64_t pv = ht[parent], cv = ht[pos];
                ht[parent] = cv; ht[pos] = pv;
                int64_t pi = hid[parent], ci = hid[pos];
                hid[parent] = ci; hid[pos] = pi;
                pos = parent;
            } else go = 0;
        }
    }
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
