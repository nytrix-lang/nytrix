shape bench_matrix_raw {
  family "perf-real"
  generator "stress"
  features ["perf", "matrix", "raw-buffer", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.time
use std.core.tbuf

def n = 128
def row = i64buf_new(n)
def col = i64buf_new(n)
mut i = 0
mut acc = 0.0
mut t0 = ticks()
while i < n {
  mut j = 0
  while j < n {
    i64buf_store(row, j, i * n + j)
    i64buf_store(col, j, j * n + i)
    j += 1
  }
  mut k = 0
  mut dot = 0.0
  while k < n {
    dot += float(i64buf_load(row, k)) * float(i64buf_load(col, k))
    k += 1
  }
  acc += dot
  i += 1
}
mut t1 = ticks()
print("checksum=", acc > 0.0)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>
static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}
int main(void) {
  const int n = 128;
  int64_t row[128], col[128];
  double acc = 0.0;
  int64_t t0 = now_ns();
  for (int i = 0; i < n; ++i) {
    for (int j = 0; j < n; ++j) {
      row[j] = (int64_t)i * n + j;
      col[j] = (int64_t)j * n + i;
    }
    double dot = 0.0;
    for (int k = 0; k < n; ++k)
      dot += (double)row[k] * col[k];
    acc += dot;
  }
  int64_t t1 = now_ns();
  printf("checksum=%s\n", acc > 0.0 ? "true" : "false");
  printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
