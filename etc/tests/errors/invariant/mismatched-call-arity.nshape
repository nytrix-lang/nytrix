shape invariant-mismatched-call-arity {
  family "compiler-errors/type"
  generator "error"
  features ["error", "invariant", "arity", "call", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "expected fn(int, int)->int, got any"
  source ny <<'NY'
use std.core

fn add_pair(int a, int b) int {
   a + b
}

add_pair(42)
NY
}
