shape invariant-impossible-semantic-rep {
  family "compiler-errors/type"
  generator "error"
  features ["error", "invariant", "semantic-rep", "type", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "cannot assign string literal to int"
  source ny <<'NY'
use std.core

fn bad_rep() int {
   "hello"
}

print(bad_rep())
NY
}
