shape args-invalid-arm-float-abi {
  family "compiler-errors/args"
  generator "error"
  features ["args", "cli", "negative", "diagnostic"]
  template ny-compile-fail
  expect compile_fail

  flags "--arm-float-abi=bogus"
  expect_message "invalid arm float ABI"
  source ny <<'NY'
use std.core
print("ok")
NY
}
