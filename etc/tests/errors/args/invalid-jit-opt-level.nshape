shape args-invalid-jit-opt-level {
  family "compiler-errors/args"
  generator "error"
  features ["args", "cli", "negative", "diagnostic"]
  template ny-compile-fail
  expect compile_fail

  flags "--jit-opt-level=x"
  expect_message "invalid JIT opt level: x"
  source ny <<'NY'
use std.core
print("ok")
NY
}
