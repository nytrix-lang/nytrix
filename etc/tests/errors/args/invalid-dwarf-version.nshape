shape args-invalid-dwarf-version {
  family "compiler-errors/args"
  generator "error"
  features ["args", "cli", "negative", "diagnostic"]
  template ny-compile-fail
  expect compile_fail

  flags "--dwarf-version=abc"
  expect_message "invalid DWARF version"
  source ny <<'NY'
use std.core
print("ok")
NY
}
