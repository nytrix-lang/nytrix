shape args-invalid-max-errors {
  family "compiler-errors/args"
  generator "error"
  features ["args", "cli", "negative", "diagnostic"]
  template ny-compile-fail
  expect compile_fail

  flags "--max-errors=abc"
  expect_message "invalid max errors: abc"
  source ny <<'NY'
use std.core
print("ok")
NY
}
