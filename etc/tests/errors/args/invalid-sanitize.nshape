shape args-invalid-sanitize {
  family "compiler-errors/args"
  generator "error"
  features ["args", "cli", "negative", "diagnostic"]
  template ny-compile-fail
  expect compile_fail

  flags "--sanitize=bogus"
  expect_message "expected address|undefined|thread|leak"
  source ny <<'NY'
use std.core
print("ok")
NY
}
