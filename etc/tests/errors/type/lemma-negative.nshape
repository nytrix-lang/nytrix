shape type_lemma_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "proof", "lemma", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "not universally provable"
  source ny <<'NY'
use std.core

fn lemma invalid_sum(int x, int y) {
  x > 0 && y > 0 → x + y < 0
}

prove(invalid_sum(3, 4))
NY
}
