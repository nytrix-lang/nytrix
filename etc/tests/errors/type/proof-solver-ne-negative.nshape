shape type_proof_solver_ne_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "proof", "solver", "comparison", "soundness"]
  template ny-compile-fail
  flags "--proof-solver=presburger"
  expect compile_fail

  expect_message "reject 5 != 5"
  source ny <<'NY'
use std.core
prove(5 != 5, "reject 5 != 5")
NY
}
