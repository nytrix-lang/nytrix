shape stack_targets_enforce_native_bounds_checks {
  family "runtime/compiler"
  generator "cross-runner"
  features ["ny", "test", "cross-target", "bounds-check", "runtime"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os (file_remove, file_write, run_capture, temp_dir, pid)

def compiler = env("NYTRIX_NY_FULL_BIN")
assert(is_str(compiler) && compiler.len > 0,
       "test runner provides the compiler path")

fn checked_program(int index) str {
  "use core\n" +
  "fn load_unknown(int idx) int {\n" +
  "  def p = malloc(8)\n" +
  "  store64_i(p, 42, 0)\n" +
  "  load64_i(p, idx)\n" +
  "}\n" +
  "load_unknown(" + to_str(index) + ")\n"
}

fn stack_compile_args(str compiler, str backend, str abi,
                      str output, int index) list {
  mut args = [compiler, "--no-effect-require-known",
              "--no-alias-require-known", "--native-backend=" + backend,
              "--native-only", "--nyir-verify", "--emit-asm=" + output,
              "-no-std", "-emit-only", "-e", checked_program(index)]
  if abi.len > 0 {
    args.append("--native-abi=" + abi)
  }
  args
}

fn check_target(str backend, str triple, str qemu, str abi,
                str startup) bool {
  def stem = temp_dir() + "/ny-stack-bounds-" + backend + "-" + to_str(pid())
  def positive_asm = stem + "-positive.s"
  def negative_asm = stem + "-negative.s"
  def negative_index_asm = stem + "-negative-index.s"
  def start_path = stem + "-start.s"
  def runtime_path =
      stem + (backend == "powerpc" ? "-runtime.s" : "-runtime.c")
  def runtime_obj = stem + "-runtime.o"
  def positive_exe = stem + "-positive"
  def negative_exe = stem + "-negative"
  def negative_index_exe = stem + "-negative-index"
  def runtime_source =
      if backend == "powerpc" {
        ".text\n.globl rt_malloc_i64\nrt_malloc_i64:\n" +
        "  lis 3, cell@ha\n  addi 3, 3, cell@l\n  blr\n" +
        ".bss\n.align 3\ncell:\n  .zero 8\n"
      } else {
        "static unsigned long cell[1];\n" +
        "void *rt_malloc_i64(unsigned long size) {\n" +
        "  (void)size;\n  return cell;\n}\n"
      }
  assert(is_ok(file_write(start_path, startup)),
         "write cross-target process entry")
  assert(is_ok(file_write(runtime_path, runtime_source)),
         "write bounded allocation stub")
  mut runtime_build_args =
      ["clang", "--target=" + triple, "-ffreestanding",
       "-fno-stack-protector"]
  if backend == "mips" {
    runtime_build_args.append("-mno-abicalls")
    runtime_build_args.append("-fno-pic")
    runtime_build_args.append("-G0")
  }
  if backend == "powerpc" {
    runtime_build_args.append("-x")
    runtime_build_args.append("assembler")
  }
  runtime_build_args.append("-c")
  runtime_build_args.append(runtime_path)
  runtime_build_args.append("-o")
  runtime_build_args.append(runtime_obj)
  def runtime_build = run_capture(runtime_build_args, [], nil, false)
  def positive_emit =
      run_capture(stack_compile_args(compiler, backend, abi,
                                     positive_asm, 0), [], nil, false)
  def negative_emit =
      run_capture(stack_compile_args(compiler, backend, abi,
                                     negative_asm, 1), [], nil, false)
  def negative_index_emit =
      run_capture(stack_compile_args(compiler, backend, abi,
                                     negative_index_asm, -1), [], nil, false)
  def positive_link =
      if runtime_build.get("code", 127) == 0 &&
         positive_emit.get("code", 127) == 0 {
        run_capture(["clang", "--target=" + triple] +
                    (if backend == "mips"
                     { ["-mno-abicalls", "-fno-pic"] } else { [] }) +
                    ["-fuse-ld=lld",
                     "-nostdlib", "-static", "-Wl,-e,_start",
                     "-Wl,--build-id=none", "-o", positive_exe, positive_asm,
                     start_path, runtime_obj], [], nil, false)
      } else { run_capture(["false"], [], nil, false) }
  def negative_link =
      if runtime_build.get("code", 127) == 0 &&
         negative_emit.get("code", 127) == 0 {
        run_capture(["clang", "--target=" + triple] +
                    (if backend == "mips"
                     { ["-mno-abicalls", "-fno-pic"] } else { [] }) +
                    ["-fuse-ld=lld",
                     "-nostdlib", "-static", "-Wl,-e,_start",
                     "-Wl,--build-id=none", "-o", negative_exe, negative_asm,
                     start_path, runtime_obj], [], nil, false)
      } else { run_capture(["false"], [], nil, false) }
  def negative_index_link =
      if runtime_build.get("code", 127) == 0 &&
         negative_index_emit.get("code", 127) == 0 {
        run_capture(["clang", "--target=" + triple] +
                    (if backend == "mips"
                     { ["-mno-abicalls", "-fno-pic"] } else { [] }) +
                    ["-fuse-ld=lld",
                     "-nostdlib", "-static", "-Wl,-e,_start",
                     "-Wl,--build-id=none", "-o", negative_index_exe,
                     negative_index_asm, start_path, runtime_obj], [], nil,
                    false)
      } else { run_capture(["false"], [], nil, false) }
  def positive_run =
      if positive_link.get("code", 127) == 0 {
        run_capture(["sh", "-c", "ulimit -c 0; exec \"$@\"", "sh", qemu,
                     positive_exe], [], nil, false)
      } else { run_capture(["false"], [], nil, false) }
  def negative_run =
      if negative_link.get("code", 127) == 0 {
        run_capture(["sh", "-c", "ulimit -c 0; exec \"$@\"", "sh", qemu,
                     negative_exe], [], nil, false)
      } else { run_capture(["false"], [], nil, false) }
  def negative_index_run =
      if negative_index_link.get("code", 127) == 0 {
        run_capture(["sh", "-c", "ulimit -c 0; exec \"$@\"", "sh", qemu,
                     negative_index_exe], [], nil, false)
      } else { run_capture(["false"], [], nil, false) }
  def all_ok =
      runtime_build.get("code", 127) == 0 &&
      positive_emit.get("code", 127) == 0 &&
      negative_emit.get("code", 127) == 0 &&
      negative_index_emit.get("code", 127) == 0 &&
      positive_link.get("code", 127) == 0 &&
      negative_link.get("code", 127) == 0 &&
      negative_index_link.get("code", 127) == 0 &&
      positive_run.get("code", 127) == 85 &&
      negative_run.get("code", 0) != 0 &&
      negative_index_run.get("code", 0) != 0
  file_remove(positive_exe)
  file_remove(negative_exe)
  file_remove(negative_index_exe)
  file_remove(runtime_obj)
  file_remove(runtime_path)
  file_remove(start_path)
  file_remove(positive_asm)
  file_remove(negative_asm)
  file_remove(negative_index_asm)
  all_ok
}

def arm_start =
    ".syntax unified\n.arm\n.text\n.globl _start\n.type _start, %function\n" +
    "_start:\n  bl rt_main\n  mov r7, #1\n  svc #0\n"
def aarch64_start =
    ".text\n.globl _start\n.type _start, %function\n_start:\n" +
    "  bl rt_main\n  mov x8, #93\n  svc #0\n"
def i386_start =
    ".text\n.globl _start\n.type _start, @function\n_start:\n" +
    "  call rt_main\n  movl %eax, %ebx\n  movl $1, %eax\n  int $0x80\n"
def riscv_start =
    ".text\n.globl _start\n.type _start, @function\n_start:\n" +
    "  call rt_main\n  li a7, 93\n  ecall\n"
def mips_start =
    ".set noreorder\n.text\n.globl _start\n.type _start, @function\n_start:\n" +
    "  jal rt_main\n  nop\n  move $a0, $v0\n  li $v0, 5058\n  syscall\n"
def powerpc_start =
    ".text\n.globl _start\n.type _start, @function\n_start:\n" +
    "  bl rt_main\n  nop\n  li 0, 1\n  sc\n"

assert(check_target("arm", "armv7-linux-gnueabi", "qemu-arm", "aapcs",
                    arm_start),
       "ARM native bounds checks assemble, run in-range, and trap out-of-range")
assert(check_target("aarch64", "aarch64-linux-gnu", "qemu-aarch64", "",
                    aarch64_start),
       "AArch64 native bounds checks assemble, run in-range, and trap out-of-range")
assert(check_target("x86", "i386-linux-gnu", "qemu-i386", "", i386_start),
       "i386 native bounds checks assemble, run in-range, and trap out-of-range")
assert(check_target("riscv", "riscv64-linux-gnu", "qemu-riscv64", "",
                    riscv_start),
       "RISC-V native bounds checks assemble, run in-range, and trap out-of-range")
assert(check_target("mips", "mips64-unknown-linux-gnuabi64", "qemu-mips64",
                    "", mips_start),
       "MIPS64 portable bounds checks assemble, run in-range, and trap invalid indices")
assert(check_target("powerpc", "powerpc64-unknown-linux-gnu", "qemu-ppc64", "",
                    powerpc_start),
       "PowerPC64 portable bounds checks assemble, run in-range, and trap invalid indices")
print("STACK_TARGET_BOUNDS_RUNTIME_OK")
NY
}
