shape aarch64_elf64_internal_link_run_ssa_phi_edge_copy {
  family "runtime-native"
  generator "native"
  features [native object elf64 aarch64 internal-link ssa phi edge-copy parallel-copy loop]
  template ny-test-case
  flags "--native-backend aarch64 -O3 --nyir-verify -emit-only -o /tmp/nytrix-aarch64-phi-edge-copy.o"
  expect object_link_run_i64_21
  source ny <<'NY'
mut a = 1
mut b = 2
mut i = 0
while i < 5 {
  def t = a
  a = b
  b = t
  i = i + 1
}
a * 10 + b
NY
}
