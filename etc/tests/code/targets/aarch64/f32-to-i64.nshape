shape aarch64_elf64_internal_link_run_f32_to_i64 {
  family "runtime-native"
  generator "native"
  template ny-test-case
  features [native object elf64 aarch64 aapcs64 qemu f32 conversion]
  flags "--native-backend aarch64 --nyir-verify -emit-only -o /tmp/nytrix-aarch64-f32-to-i64.o"
  expect object_link_run_i64_0
source ny <<'NY'
@noinline
fn trunc32(f32 value) int {
  int(value)
}

@noinline
fn trunc64(f64 value) int {
  int(value)
}

trunc32(42.75) + trunc32(-42.75) +
trunc64(42.75) + trunc64(-42.75)
NY
}
