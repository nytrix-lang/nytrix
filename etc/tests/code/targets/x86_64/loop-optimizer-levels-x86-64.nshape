shape oracle_loop_optimizer_levels_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle loop optimizer regression]
  template ny-test-case
  flags_matrix "-O2 --native-result-oracle; -O3 --native-result-oracle"
  expect compile_and_run
  source ny <<'NY'
mut i = 0
mut sum = 0
while(i < 10){
  sum = sum + i
  i = i + 1
}
sum
NY
}
