shape oracle_addr_local_loop_phi_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle result pointer addr-local phi loop]
  template ny-test-case
  flags "--native-result-oracle=42 -O3"
  expect compile_and_run
  source ny <<'NY'
use core

@noinline
fn selected_address(int count) i64 {
  mut i64 left = 3
  mut i64 right = 39
  mut ptr selected = addr_of(left)
  mut i = 0
  while i < count {
    selected = addr_of(right)
    i += 1
  }
  load64_i(selected)
}

selected_address(0) + selected_address(1)
NY
}
