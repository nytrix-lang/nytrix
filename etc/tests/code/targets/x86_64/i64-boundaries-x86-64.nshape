shape oracle_i64_boundaries_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle i64 boundary]
  template ny-test-case
  flags_matrix "-O0 --native-result-oracle=0; -O3 --native-result-oracle=0"
  expect compile_and_run
  source ny <<'NY'
fn id(i64 x) i64 { x }
def i64 max = 9223372036854775807
def i64 min = -9223372036854775808
if id(max) == max && id(min) == min { 0 } else { 1 }
NY
}
