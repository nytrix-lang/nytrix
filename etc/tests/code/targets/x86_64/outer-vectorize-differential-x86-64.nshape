shape oracle_outer_vectorize_differential_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle outer-vectorize loop phi remainder wrap]
  template ny-test-case
  flags_matrix "-O0 --native-result-oracle=0; -O1 --native-result-oracle=0; -O2 --native-result-oracle=0; -O3 --native-result-oracle=0"
  expect compile_and_run
  source ny <<'NY'
use core

;; Loop shapes the outer vectorizer widens (NYTRIX_OUTER_VECTORIZE=1): an
;; induction loop with add-reductions over an inner loop counted by a uniform,
;; runtime trip count. Covers zero/short trips (scalar remainder only),
;; negative values through signed division, wrapping products, and an inlined
;; callee whose dead scalar PHI sits between live header PHIs.

fn mix(int depth, int seed) int {
   mut int x = seed + depth
   mut int acc = 1
   mut int i = 0
   while i < depth {
      if (x & 1) == 0 {
         acc = (acc * 3) + i + depth
      } else {
         acc = (acc * 5) - i + depth
      }
      x = (x / 2) + acc + i
      i += 1
   }
   acc
}

fn sweep(int n, int depth, int base) int {
   mut int total = 0
   mut int i = 0
   while i < n {
      total += mix(depth, base + i)
      i += 1
   }
   total
}

fn wrap(int n) int {
   mut int s = 0
   mut int t = 7
   mut int i = 0
   while i < n {
      mut int v = i * 1103515245 + 12345
      mut int k = 0
      while k < 9 {
         v = (v ^ (v / 8)) * 1000003 - k
         k += 1
      }
      s += v
      t += (v & 255) | 3
      i += 1
   }
   s ^ (t * 1000003)
}


mut int out = 0
mut int n = 0
while n < 10 {
   out = (out * 131) + sweep(n, 7, 0 - 50)
   out = (out * 137) + sweep(n, 11, 1000)
   out = (out * 139) + sweep(n + 3, 0, 5)
   out = (out * 149) + wrap(n)
   n += 1
}
def int short = out
out = (out * 151) + sweep(37, 18, 0 - int(9223372036854775800))
out = (out * 157) + wrap(41)
if short == 0 - int(3226323797593573905) &&
   out == 0 - int(9156399993749815989) {
  0
} else {
  1
}
NY
}
