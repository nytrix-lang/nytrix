shape avr_literal_panic_emits_and_executes_trap {
  family "runtime/compiler"
  generator "embedded"
  features ["ny", "test", "avr", "portable-text", "panic", "qemu"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os (file_exists, file_read, file_remove, file_write, run_capture,
             temp_dir, pid)

def compiler = env("NYTRIX_NY_FULL_BIN")
assert(is_str(compiler) && compiler.len > 0,
       "test runner provides the compiler path")
def stem = temp_dir() + "/ny-avr-panic-" + to_str(pid())
def asm_path = stem + ".s"
def start_path = stem + "-start.s"
def obj_path = stem + ".o"
def start_obj_path = stem + "-start.o"
def elf_path = stem + ".elf"
def rejected_path = stem + "-dynamic.s"
def start_source = ".text\n.global _start\n_start:\n  call rt_main\n1:\n  rjmp 1b\n"
assert(is_ok(file_write(start_path, start_source)),
       "write AVR panic startup wrapper")
def emitted = run_capture(
    [compiler, "--native-backend=avr", "--native-only", "--nyir-verify",
     "--emit-asm=" + asm_path, "-no-std", "-emit-only", "-e",
     "panic(\"avr panic marker\")"], [], nil, false)
assert(emitted.get("code", 127) == 0 && file_exists(asm_path),
       "NYIR-verified AVR literal panic emits")
def assembly_text = file_read(asm_path)
assert(is_ok(assembly_text) &&
       str_contains(unwrap(assembly_text), "break") &&
       str_contains(unwrap(assembly_text), ".Lny_panic_spin_"),
       "AVR literal panic lowers to a breakpoint and non-returning trap loop")
def assembled = run_capture(
    ["clang", "--target=avr", "-mmcu=atmega328p", "-c", asm_path,
     "-o", obj_path], [], nil, false)
def start_assembled = run_capture(
    ["clang", "--target=avr", "-mmcu=atmega328p", "-c", start_path,
     "-o", start_obj_path], [], nil, false)
def linked = run_capture(
    ["ld.lld", "-N", "--image-base=0", "-Ttext=0", "-e", "_start",
     start_obj_path, obj_path, "-o", elf_path], [], nil, false)
assert(assembled.get("code", 127) == 0 &&
       start_assembled.get("code", 127) == 0 &&
       linked.get("code", 127) == 0,
       "AVR panic trap assembles and links as an executable")
def execution = run_capture(
    ["timeout", "2s", "qemu-system-avr", "-M", "uno", "-display", "none",
     "-monitor", "none", "-serial", "none", "-bios", elf_path],
    [], nil, false)
assert(execution.get("code", 0) == 124,
       "QEMU executes the non-returning AVR panic path")
def rejected = run_capture(
    [compiler, "--native-backend=avr", "--native-only", "--nyir-verify",
     "--emit-asm=" + rejected_path, "-no-std", "-emit-only", "-e",
     "fn fail(int value) int { panic(\"value: \" + to_str(value)) }\n" +
     "fail(7)"], [], nil, false)
assert(rejected.get("code", 0) != 0 && !file_exists(rejected_path),
       "dynamic AVR panic messages remain fail-closed")
for path in [asm_path, start_path, obj_path, start_obj_path, elf_path] {
  if file_exists(path) { file_remove(path) }
}
assert(!file_exists(asm_path) && !file_exists(start_path) &&
       !file_exists(obj_path) && !file_exists(start_obj_path) &&
       !file_exists(elf_path),
       "remove AVR panic artifacts")
print("AVR_PANIC_RUNTIME_OK")
NY
}
