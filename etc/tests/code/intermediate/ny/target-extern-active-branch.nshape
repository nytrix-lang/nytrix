shape nyir_target_extern_active_branch {
  family "runtime-native"
  generator "native"
  features [native nyir extern target conditional platform regression]
  template ny-test-case
  flags_matrix "--host-triple=x86_64-unknown-linux-gnu --native-only -emit-only -o /tmp/nytrix-target-extern-linux.o; --host-triple=x86_64-pc-windows-msvc --native-only -emit-only -o /tmp/nytrix-target-extern-windows.obj"
  expect compile_and_run
  source ny <<'NY'
#windows {
   extern "" {
      fn _target_probe(i64 value) i64 as "rt_value_tag"
   }
} #else {
   extern "" {
      fn _target_probe(i64 value) i64 as "rt_len"
   }
} #endif
0
NY
}
