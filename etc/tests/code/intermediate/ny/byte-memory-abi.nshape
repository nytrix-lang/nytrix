shape native_byte_memory_abi {
  family "runtime-native"
  generator "native"
  features ["native", "nyir", "x86_64", "memory", "load8", "store8"]
  template ny-test-case
  flags "--native-only --native-backend=x86_64 -O3 --nyir-verify --native-result-oracle=0 --no-progress --color=never"
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.str as str

def p = zalloc(4)
store8(p, 65, 0)
assert(load8(p, 0) == 65, "raw byte memory round trip")
store8(p, load8("i", 0), 1)
assert(load8(p, 1) == 105, "nested byte producer stays raw at the store boundary")
assert(str.strip(" \tTitle i e a\r\n") == "Title i e a",
  "shared-library byte copies preserve odd byte values")

def bytes_loop = u8buf_new(64)
mut byte_sum = 0
mut byte_i = 0
while byte_i < 64 {
  bytes_loop = u8buf_store(bytes_loop, byte_i, byte_i)
  byte_sum += u8buf_load(bytes_loop, byte_i)
  byte_i += 1
}
assert(byte_sum == 2016, "typed byte load/store loop preserves raw values")

mut inferred_bytes = u8buf_new(64)
mut inferred_byte_sum = 0
mut inferred_byte_i = 0
while inferred_byte_i < 64 {
  inferred_bytes = u8buf_store(inferred_bytes, inferred_byte_i, inferred_byte_i)
  inferred_byte_sum += u8buf_load(inferred_bytes, inferred_byte_i)
  inferred_byte_i += 1
}
assert(inferred_byte_sum == 2016,
  "mutable pointer-returning initializer preserves the pointer ABI")

fn exercise_offsets(dict indices) {
  def index = indices.get("at")
  def bytes = init_str(malloc(25), 24)
  store8(bytes, 17, index)
  assert(load8(bytes, index) == 17, "byte offset decodes a numeric getter")
  store16(bytes, 4660, index + 2)
  assert(load16(bytes, index + 2) == 4660,
    "word offset decodes dynamic arithmetic")
  store32(bytes, 305419896, index + 5)
  assert(load32(bytes, index + 5) == 305419896,
    "dword offset decodes dynamic arithmetic")
  store64_i(bytes, 1000000007, index + 9)
  assert(load64_i(bytes, index + 9) == 1000000007,
    "qword offset decodes dynamic arithmetic")
  def integers = i64buf_new(3)
  i64buf_store(integers, index, 53)
  assert(i64buf_load(integers, index) == 53,
    "integer buffer index decodes a numeric getter")
  def floats = f64buf_new(3)
  f64buf_store(floats, index, 3.5)
  assert(f64buf_load(floats, index) == 3.5,
    "float buffer index decodes a numeric getter")
}
exercise_offsets({"at": 1})
0
NY
}
