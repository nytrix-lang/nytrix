shape effects-row-polymorphism {
  family "typing/effects"
  generator "regression"
  features ["ny" "native" "effects" "shape" "row" "capability" "typestate"]
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core

shape Point2D {
  int x
  int y
}

shape ColoredPoint : Point2D {
  int color
}

shape Named {
  int id
}

shape ComposedEntity {
  +Point2D
  +Named
  int extra
}

def p = Point2D(10, 20)
assert(Point2D_load_x(p) == 10, "Point2D x load")
assert(Point2D_load_y(p) == 20, "Point2D y load")
assert(__layout_size("Point2D") == 16, "Point2D size")

def cp = ColoredPoint(1, 2, 0xff00)
assert(ColoredPoint_load_x(cp) == 1, "ColoredPoint inherited x load")
assert(ColoredPoint_load_y(cp) == 2, "ColoredPoint inherited y load")
assert(ColoredPoint_load_color(cp) == 0xff00, "ColoredPoint color load")
assert(__layout_size("ColoredPoint") == 24, "ColoredPoint size")

def ce = ComposedEntity(100, 200, 999, 42)
assert(ComposedEntity_load_x(ce) == 100, "ComposedEntity x load")
assert(ComposedEntity_load_y(ce) == 200, "ComposedEntity y load")
assert(ComposedEntity_load_id(ce) == 999, "ComposedEntity id load")
assert(ComposedEntity_load_extra(ce) == 42, "ComposedEntity extra load")
assert(__layout_size("ComposedEntity") == 32, "ComposedEntity size")

@effects(e)
fn run_eff(fnptr f) int {
  return f()
}

@effects(cap(read))
fn op_read() int {
  return 10
}

@effects(cap(write))
fn op_write() int {
  return 20
}

@effects(cap(read, write))
fn op_rw() int {
  return op_read() + op_write()
}

@effects(state(Closed, Open))
fn op_open() int {
  return 1
}

@effects(state(Open, Closed))
fn op_close() int {
  return 0
}

@effects(state(Closed, Open))
fn op_open_through_contract() int {
  return op_open()
}

assert(run_eff(op_read) == 10, "effect variable unification at call site")
assert(op_rw() == 30, "capability composition")
assert(run_eff(op_rw) == 30, "multi-capability callback row substitution")
assert(op_open() == 1, "typestate transition closed->open")
assert(op_close() == 0, "typestate transition open->closed")
assert(op_open_through_contract() == 1,
       "matching typestate payload satisfies a declared effect row")
print("effects_row_polymorphism ok")
NY
}

shape typestate_effect_payload_mismatch_rejected {
  family "typing/effects"
  generator "error"
  features ["ny", "test", "typing", "effects", "row", "typestate", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "effect contract violation"
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  source ny <<'NY'
@effects(state(Closed, Open))
fn op_open() int {
  1
}

@effects(state(Open, Closed))
fn invalid_transition() int {
  op_open()
}

invalid_transition()
NY
}
