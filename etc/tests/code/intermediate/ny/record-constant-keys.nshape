shape record_constant_keys_native {
  family "runtime-native"
  generator "native"
  features [native nyir x86_64 dict record constant-keys]
  template ny-test-case
  flags "--native-only --native-backend=x86_64 -O3 --nyir-verify --native-result-oracle=0 --no-progress --color=never"
  expect compile_and_run
  source ny <<'NY'
use core

fn test_direct_literal_index() int {
   def v = {"a": 40, "b": 2}["a"] + {"a": 40, "b": 2}["b"]
   v
}

fn test_local_record_access() int {
   def point = {"x": 10, "y": 20, "z": 12}
   point["x"] + point.get("y", 0) + point["z"]
}

@effects(all)
fn test_record_len_has() int {
   def rec = {"alpha": 1, "beta": 2, "gamma": 3}
   def len_ok = rec.len() == 3
   def has_alpha = rec.has("alpha")
   def has_delta = !rec.has("delta")
   def fallback = rec.get("omega", 99) == 99
   if len_ok && has_alpha && has_delta && fallback { 42 } else { 0 }
}

fn test_int_keys() int {
   def m = {100: 21, 200: 21}
   if m[100] == 21 && m.get(200, 0) == 21 { 42 } else { 0 }
}

fn test_int_key_mixed_read_add() int {
   def m = {100: 21, 200: 21}
   def sum = m[100] + m.get(200, 0)
   if sum == 42 { 42 } else { 0 }
}

def r1 = test_direct_literal_index()
def r2 = test_local_record_access()
def r3 = test_record_len_has()
def r4 = test_int_keys()
def r5 = test_int_key_mixed_read_add()

if r1 == 42 && r2 == 42 && r3 == 42 && r4 == 42 && r5 == 42 { 0 } else { 1 }
NY
}
