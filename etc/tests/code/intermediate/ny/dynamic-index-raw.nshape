shape dynamic-index-raw {
  family "native-nyir"
  generator "regression"
  features ["ny", "native", "dynamic", "index"]
  template ny-test-case
  expect compile_and_run
  flags_matrix "-O0; -O2; -O3; --native-only -O0; --native-only -O2; --native-only -O3"
  timeout 25
  source ny <<'NY'
use core.math.logic.prolog as prolog
use core.math.logic.solve as solve
use core.iter as iter

def expression = prolog.term("mul", [
   prolog.term("add", [2, 3]), 4])
def result = solve.arithmetic(expression)
assert(result.get("decided") == true, "dynamic arithmetic is decided")
assert(result.get("value") == 20,
   "raw native indices preserve odd dynamic list positions")
def chunks = iter.chunk([1, 2, 3, 4, 5], 2)
def first = chunks[0]
def first_value = first[0]
def second_value = first[1]
assert(first_value == 1, "bound nested dynamic index preserves first scalar")
assert(second_value == 2, "bound nested dynamic index preserves odd scalar")
assert(first[0] == 1, "direct dynamic index comparison preserves first scalar")
assert(first[1] == 2, "direct dynamic index comparison preserves odd scalar")
;; Generic list slots carry raw values after indexing. Applying int(any) to
;; that already-raw payload must not low-bit-decode odd values a second time.
mut values = []
values = append(values, 4198747)
values = append(values, 4198760)
values = append(values, 4198767)
mut converted = []
mut i = 0
while i < values.len {
   converted = append(converted, int(values[i]))
   i += 1
}
assert(converted[0] == 4198747 && converted[1] == 4198760 &&
   converted[2] == 4198767,
   "int cast preserves raw odd and even dynamic-list values")
print("dynamic_index_raw ok")
NY
}
