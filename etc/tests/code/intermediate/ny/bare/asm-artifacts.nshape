         str(run_aarch64_string.get("stdout", "")) ==
             "hello world\nconverted\n1 0 1 0 1\n" +
             "true true true true true true\n6 0 0\ntrue false\nhello world 11\ntail head\n\nabc\né\nababab\n\n\n\n98 99 0\n4096\n" +
                 expected_large_text + "\n")),
       "AArch64 bare conversion, concatenation, chr, and repeat handle dynamic strings" +
       " (compile=" + to_str(int(compile_aarch64_string.get("code", 127))) +
       ", compiler-output=`" +
           str(compile_aarch64_string.get("stdout", "")) +
           str(compile_aarch64_string.get("stderr", "")) + "`" +
       ", readelf=" + to_str(int(aarch64_string_dynamic.get("code", 127))) +
       ", qemu=" + to_str(int(qemu_aarch64_available.get("code", 1))) +
