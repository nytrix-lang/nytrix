       (int(qemu_aarch64_available.get("code", 1)) != 0 ||
        int(run_aarch64_clock.get("code", 127)) == 8),
       "AArch64 bare monotonic ticks use the clock_gettime syscall")
assert(int(compile_aarch64_float.get("code", 127)) == 0 &&
       (int(qemu_aarch64_available.get("code", 1)) != 0 ||
        (int(run_aarch64_float.get("code", 127)) == 0 &&
         str(run_aarch64_float.get("stdout", "")) == "3.5\n")),
       "AArch64 bare float formatting executes without a hosted runtime")
assert(int(compile_unsupported_target.get("code", 0)) != 0 &&
       !file_exists(unsupported_target_binary),
       "bare output rejects targets without an in-process bare ELF path")
assert(is_ok(wrote_overflow) && int(compile_overflow.get("code", 0)) != 0 &&
       is_ok(wrote_divide_zero) && int(compile_divide_zero.get("code", 0)) != 0 &&
       is_ok(wrote_immutable) && int(compile_immutable.get("code", 0)) != 0,
       "bare constants reject overflow, division by zero, and immutable writes")
assert(int(run_bare.get("code", 127)) == 0 &&
       str(run_bare.get("stdout", "")) ==
           "first\nsecond\n27\nsum 3 27\nderived 42\nmutable 15\n" +
           "true false nil\nwarning\n4\n",
       "bare syscalls print folded integers and boolean constants")
assert(int(bare_sections.get("code", 127)) == 0 &&
       (str(bare_sections.get("stdout", ""))).contains("There are no sections") &&
       int(bare_dynamic.get("code", 127)) == 0 &&
       (str(bare_dynamic.get("stdout", ""))).contains("There is no dynamic section"),
       "bare ELF has no sections or dynamic libc linkage")
assert(int(bare_size.get("code", 127)) == 0 &&
       str(bare_size.get("stdout", "")) == "407\n",
       "bare syscall encodings keep the sectionless nine-write ELF at 407 bytes")
assert(int(compile_assembly.get("code", 127)) == 0 &&
       ((str(compile_assembly.get("stdout", "")) + str(compile_assembly.get("stderr", "")))).contains("Saved assembly: " + assembly) &&
       ((str(compile_assembly.get("stdout", "")) + str(compile_assembly.get("stderr", "")))).contains("KB;") &&
       ((str(compile_assembly.get("stdout", "")) + str(compile_assembly.get("stderr", "")))).contains("bytes") &&
       is_ok(assembly_text) &&
       !(unwrap(assembly_text)).contains("\t.section\t.rodata") &&
       !(unwrap(assembly_text)).contains("\t.section\t.data"),
       "assembly reports its size and omits unused literal sections")
assert(int(compile_literal_assembly.get("code", 127)) == 0 &&
       code_end >= 0 && literal_section > code_end &&
       (literal_text).contains("ny_str_0:") &&
       !(literal_text).contains(".p2align"),
       "string literal data follows generated code without alignment padding")
assert(is_ok(wrote_harness) && int(link_assembly.get("code", 127)) == 0 &&
       int(run_assembly.get("code", 127)) == 0,
       "frameless x86-64 integer leaves obey argument and return ABI")
assert(int(disassembled_assembly.get("code", 127)) == 0 &&
       (str(disassembled_assembly.get("stdout", ""))).contains("inc") &&
       (str(disassembled_assembly.get("stdout", ""))).contains("dec") &&
       (str(disassembled_assembly.get("stdout", ""))).contains("0x2a,%al"),
       "unit immediates and constant returns use compact valid encodings")
NY
}
