    }
def aarch64_list_length_dynamic =
    run_capture(["readelf", "-d", aarch64_list_length_binary], [], nil, false)
def compile_aarch64_pop_index = run_capture(
    ["env", "CC=/nonexistent", compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_pop_index_binary, "-e",
     "@effects(all)\nfn run() int { mut list<int> values = [10, 20, 30] " +
     "def popped = int(values.pop()) values[1] }\nprint(run())"],
