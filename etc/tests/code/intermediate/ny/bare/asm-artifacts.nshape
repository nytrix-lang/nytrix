shape multistatement_artifact_and_assembly_size {
  family "runtime/compiler"
  generator "embedded"
  features ["bare", "aot", "assembly", "artifact-size", "regression"]
  template ny-test-case
  expect compile_and_run
  ci windows-skip
  source ny <<'NY'
use core.os (file_exists, file_read, file_remove, file_write, pid, run_capture,
             temp_dir)

def compiler = env("NYTRIX_NY_FULL_BIN")
assert(is_str(compiler) && compiler.len > 0,
       "test runner provides the compiler path")
def stem = temp_dir() + "/ny-bare-artifact-" + to_str(pid())
def input = stem + ".ny"
def binary = stem + ".bin"
def inline_binary = stem + "-inline.bin"
def overflow_input = stem + "-overflow.ny"
def divide_zero_input = stem + "-divide-zero.ny"
def immutable_input = stem + "-immutable.ny"
def overflow_binary = stem + "-overflow.bin"
def divide_zero_binary = stem + "-divide-zero.bin"
def immutable_binary = stem + "-immutable.bin"
def control_flow_binary = stem + "-control-flow.bin"
def runtime_binary = stem + "-runtime.bin"
def clock_binary = stem + "-clock.bin"
def allocation_binary = stem + "-allocation.bin"
def heap_binary = stem + "-heap.bin"
def x86_string_binary = stem + "-x86-string.bin"
def x86_integer_output_binary = stem + "-x86-integer-output.bin"
def aarch64_binary = stem + "-aarch64.bin"
def aarch64_runtime_binary = stem + "-aarch64-runtime.bin"
def aarch64_function_string_binary = stem + "-aarch64-function-string.bin"
def aarch64_float_binary = stem + "-aarch64-float.bin"
def aarch64_eprint_binary = stem + "-aarch64-eprint.bin"
def aarch64_eprint_stderr = stem + "-aarch64-eprint.stderr"
def aarch64_runtime_call_binary = stem + "-aarch64-runtime-call.bin"
def aarch64_clock_binary = stem + "-aarch64-clock.bin"
def aarch64_heap_binary = stem + "-aarch64-heap.bin"
def aarch64_string_binary = stem + "-aarch64-string.bin"
def aarch64_buffer_binary = stem + "-aarch64-buffer.bin"
def aarch64_memory_binary = stem + "-aarch64-memory.bin"
def aarch64_list_length_binary = stem + "-aarch64-list-length.bin"
def aarch64_pop_index_binary = stem + "-aarch64-pop-index.bin"
def aarch64_pop_oob_binary = stem + "-aarch64-pop-oob.bin"
def aarch64_list_oob_binary = stem + "-aarch64-list-oob.bin"
def unsupported_target_binary = stem + "-unsupported-target.bin"
def assembly = stem + ".s"
def literal_assembly = stem + "-literal.s"
def harness = stem + "-harness.s"
def assembly_exe = stem + "-assembly"
def assembly_source =
    "fn small() int { 42 }\n" +
    "fn wide() int { 4294967296 }\n" +
    "fn add(int x, int y) int { x + y }\n" +
    "fn sub(int x, int y) int { x - y }\n" +
    "fn mul(int x, int y) int { x * y }\n" +
    "fn band(int x, int y) int { x & y }\n" +
    "fn bor(int x, int y) int { x | y }\n" +
    "fn bxor(int x, int y) int { x ^ y }\n" +
    "fn id(int x) int { x }\n" +
    "fn answer() int { 42 }\n" +
    "fn zero(int x) int { x - x }\n" +
    "fn inc(int x) int { x + 1 }\n" +
    "fn dec(int x) int { x - 1 }\n" +
    "fn chain(int x, int y) int { x + y + x }\n" +
    "fn sum3(int x, int y, int z) int { x + y + z }\n" +
    "fn sum_to(int n) int { mut int total = 0 mut int i = 0 " +
    "while i < n { total += i i += 1 } total }\n" +
    "small() + wide() + add(20, 22) + sub(20, 22) + mul(6, 7) + " +
    "band(42, 15) + bor(32, 10) + bxor(63, 21) + id(42) + answer() + " +
    "sum3(10, 20, 30) + zero(42) + inc(41) + dec(42) + chain(20, 22)"
def harness_source =
    ".globl _start\n_start:\n" +
    "movq $42, %rdi\ncall ny_fn_id\n" +
    "cmpq $42, %rax\njne .Lfail\n" +
    "call ny_fn_answer\ncmpq $42, %rax\njne .Lfail\n" +
    "movq $42, %rdi\ncall ny_fn_zero\ncmpq $0, %rax\njne .Lfail\n" +
    "movq $41, %rdi\ncall ny_fn_inc\ncmpq $42, %rax\njne .Lfail\n" +
    "movq $42, %rdi\ncall ny_fn_dec\ncmpq $41, %rax\njne .Lfail\n" +
    "movq $20, %rdi\nmovq $22, %rsi\ncall ny_fn_chain\n" +
    "cmpq $62, %rax\njne .Lfail\n" +
    "movq $10, %rdi\nmovq $20, %rsi\nmovq $30, %rdx\n" +
    "call ny_fn_sum3\ncmpq $60, %rax\njne .Lfail\n" +
    "movq $10, %rdi\ncall ny_fn_sum_to\n" +
    "cmpq $45, %rax\njne .Lfail\n" +
    "movq $20, %rdi\nmovq $22, %rsi\ncall ny_fn_add\n" +
    "cmpq $42, %rax\njne .Lfail\n" +
    "movq $20, %rdi\nmovq $22, %rsi\ncall ny_fn_sub\n" +
    "cmpq $-2, %rax\njne .Lfail\n" +
    "movq $6, %rdi\nmovq $7, %rsi\ncall ny_fn_mul\n" +
    "cmpq $42, %rax\njne .Lfail\n" +
    "movq $42, %rdi\nmovq $15, %rsi\ncall ny_fn_band\n" +
    "cmpq $10, %rax\njne .Lfail\n" +
    "movq $32, %rdi\nmovq $10, %rsi\ncall ny_fn_bor\n" +
    "cmpq $42, %rax\njne .Lfail\n" +
    "movq $63, %rdi\nmovq $21, %rsi\ncall ny_fn_bxor\n" +
    "cmpq $42, %rax\njne .Lfail\n" +
    "xorl %edi, %edi\nmovl $60, %eax\nsyscall\n" +
    ".Lfail:\nmovl $1, %edi\nmovl $60, %eax\nsyscall\n"
def wrote = file_write(input,
    "print('first') ; inline comment\nprint('second')\n" +
    "print((1 + 2) * (4 + 5))\n" +
    "print('sum', 1 + 2, (4 + 5) * 3)\n" +
    "def int base = 21\ndef int doubled = base * 2\n" +
    "print('derived', doubled)\n" +
    "mut int counter = 4\ncounter += 1\ncounter = counter * 3\n" +
    "print('mutable', counter)\n" +
    "print(true, false, nil)\n" +
    "eprint('warning')\neprint(8 / 2)\n")
assert(is_ok(wrote), "write the multi-statement bare source file")
def compile_bare = run_capture(
    ["env", "CC=/nonexistent", compiler, "--mode=bare", "--release", "-o",
     binary, input],
    [], nil, false)
def compile_inline = run_capture(
    ["env", "CC=/nonexistent", compiler, "--mode=bare", "--release", "-o",
     inline_binary, "-e",
     "def int seed = 20\nmut int value = seed + 1\nvalue *= 2\n" +
     "print('inline', value)\nprint('length', 'abc'.len)"],
    [], nil, false)
def run_inline = run_capture([inline_binary], [], nil, false)
def compile_control_flow = run_capture(
    ["env", "CC=/nonexistent", compiler, "--mode=bare", "--release", "-o",
     control_flow_binary, "-e",
     "fn sum_to(int n) int { mut int total = 0 mut int i = 0 " +
     "while i < n { total += i i += 1 } total } sum_to(7)"],
    [], nil, false)
def run_control_flow = run_capture([control_flow_binary], [], nil, false)
def control_flow_dynamic =
    run_capture(["readelf", "-d", control_flow_binary], [], nil, false)
def compile_runtime_dependency = run_capture(
    ["env", "CC=/nonexistent", compiler, "--mode=bare", "--release", "-o",
     runtime_binary, "-e",
     "fn show(int x) int { mut int y = x\ny += 1\nprint(y)\neprint(y)\ny } " +
     "show(41)\n0"],
    [], nil, false)
def run_runtime_dependency = run_capture([runtime_binary], [], nil, false)
def compile_clock = run_capture(
    ["env", "CC=/nonexistent", compiler, "--mode=bare", "--release", "-o",
     clock_binary, "-e",
     "use core.os.time:ticks\nprint(ticks())"],
    [], nil, false)
def run_clock = run_capture([clock_binary], [], nil, false)
def clock_dynamic = run_capture(["readelf", "-d", clock_binary], [], nil, false)
def compile_allocation = run_capture(
    ["env", "CC=/nonexistent", compiler, "--mode=bare", "--release", "-o",
     allocation_binary, "-e",
     "use core.tbuf (i64buf_new, i64buf_load, i64buf_store)\n" +
     "def values = i64buf_new(4)\ni64buf_store(values, 0, 17)\n" +
     "i64buf_store(values, 3, 25)\n" +
     "print(int(i64buf_load(values, 0)) + int(i64buf_load(values, 3)), " +
     "int(i64buf_load(values, 2)))"],
    [], nil, false)
def run_allocation = run_capture([allocation_binary], [], nil, false)
def allocation_dynamic = run_capture(["readelf", "-d", allocation_binary], [], nil, false)
def compile_heap = run_capture(
    ["env", "CC=/nonexistent", compiler, "--mode=bare", "--release", "-o",
     heap_binary, "-e",
     "@effects(all)\nfn run() int { def p = malloc(16384) " +
     "store64(p, 42, 8192) print(load64(p, 8192)) " +
     "print(free(p), free(0)) print(malloc(-1)) 0 } run()"],
    [], nil, false)
def run_heap = run_capture([heap_binary], [], nil, false)
def heap_dynamic = run_capture(["readelf", "-d", heap_binary], [], nil, false)
def compile_x86_string = run_capture(
    ["env", "CC=/nonexistent", compiler, "--mode=bare",
     "--release", "-o",
     x86_string_binary, "-e",
     'use core.str as str\n' +
     'fn join(str left, str right) str { left + right }\n' +
     'fn byte_at(str text, int idx) int { if idx < 0 { idx = text.len + idx } ' +
     'if idx < 0 || idx >= text.len { return 0 } return load8(text, idx) }\n' +
     'extern fn cstr_eq(ptr left, ptr right) int as "rt_cstr_eq"\n' +
     'extern fn cstr_cmp(ptr left, ptr right) int as "rt_cstr_cmp"\n' +
     'fn grow_text() str { mut str s = "x" mut int i = 0 ' +
     'while i < 12 { s = s + s i += 1 } return s }\n' +
     'print("assembler-free bare output")\n' +
     'print(join("hello", " world"))\n' +
     'def str text = join("hello", " world")\n' +
     'print(text, text.len)\n' +
     'print(join("", "tail"), join("head", ""))\n' +
     'print(join("", ""))\n' +
     'print(join(join("a", "b"), "c"))\n' +
     'print(cstr_eq("same", "same"), cstr_eq("same", "diff"), ' +
     'cstr_eq(0, 0), cstr_eq(0, "x"), cstr_eq("x", 0), ' +
     'cstr_eq("", ""), cstr_eq("same", join("sa", "me")))\n' +
     'print(cstr_cmp("a", "c") < 0, cstr_cmp("c", "a") > 0, ' +
     'cstr_cmp("same", "same") == 0, cstr_cmp(0, 0) == 0, ' +
     'cstr_cmp(0, "x") < 0, cstr_cmp("x", 0) > 0)\n' +
     'print(str.chr(233))\n' +
     'print(str.repeat("ab", 3))\n' +
     'print(str.repeat("ab", 0))\n' +
     'print(str.repeat("ab", -2))\n' +
     'print(str.repeat("", 4))\n' +
     'print(byte_at("abc", 1), byte_at("abc", -1), byte_at("abc", 3))\n' +
     'def str large = grow_text()\n' +
     'print(large.len)\nprint(large)'],
    [], nil, false)
def run_x86_string = run_capture([x86_string_binary], [], nil, false)
def x86_string_dynamic = run_capture(["readelf", "-d", x86_string_binary], [], nil, false)
def compile_x86_integer_output = run_capture(
    ["env", "CC=/nonexistent", compiler, "--mode=bare", "--release", "-o",
     x86_integer_output_binary, "-e",
     "fn show(int value) int { print(value) 0 } " +
     "show(0) show(42) show(-42) show(21 + 21) " +
     "show(-9223372036854775808)"],
    [], nil, false)
def run_x86_integer_output =
    run_capture([x86_integer_output_binary], [], nil, false)
def x86_integer_output_dynamic =
    run_capture(["readelf", "-d", x86_integer_output_binary], [], nil, false)
def compile_aarch64 = run_capture(
    ["env", "CC=/nonexistent", compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_binary, "-e",
     "@effects(none)\nfn run() int { 42 }\nrun()"],
    [], nil, false)
def compile_aarch64_runtime = run_capture(
    [compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_runtime_binary, "-e",
     'print("hello", 42, true, nil)'],
    [], nil, false)
def compile_aarch64_function_string = run_capture(
    ["env", "CC=/nonexistent", compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_function_string_binary, "-e",
     'fn greet() int { print("hello from function") 0 } greet()'],
    [], nil, false)
def qemu_aarch64_available =
    run_capture(["sh", "-c", "command -v qemu-aarch64 >/dev/null"], [], nil, false)
def run_aarch64_function_string =
    if int(qemu_aarch64_available.get("code", 1)) == 0 {
      run_capture(["qemu-aarch64", aarch64_function_string_binary], [], nil,
                  false)
    } else {
      nil
    }
def aarch64_function_string_dynamic =
    run_capture(["readelf", "-d", aarch64_function_string_binary], [], nil,
                false)
def compile_aarch64_eprint = run_capture(
    ["env", "CC=/nonexistent", compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_eprint_binary, "-e",
     'eprint("warning", 42, true)'],
    [], nil, false)
def aarch64_eprint_dynamic =
    run_capture(["readelf", "-d", aarch64_eprint_binary], [], nil, false)
def compile_aarch64_runtime_call = run_capture(
    ["env", "CC=/nonexistent", compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_runtime_call_binary, "-e",
     "fn show(int value) int { print(value) 0 }\n" +
     "fn show_bool() int { print(true) print(false) 0 }\n" +
     "show(42)\nshow(-7)\nshow(0)\nshow(-9223372036854775808)\n" +
     "show_bool()"],
    [], nil, false)
def compile_aarch64_clock = run_capture(
    ["env", "CC=/nonexistent", compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_clock_binary, "-e",
     "use core.os.time:ticks\nfn run() bool { ticks() > 0 }\nrun()"],
    [], nil, false)
def compile_aarch64_heap = run_capture(
    ["env", "CC=/nonexistent", compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_heap_binary, "-e",
     "@effects(all)\nfn run() int { def p = malloc(8192) " +
     "print(load64(p, 0)) store64(p, 42, 0) store64(p, 84, 4096) " +
     "print(load64(p, 0) + load64(p, 4096)) free(p) " +
     "def bad = malloc(-1) print(bad == 0) free(bad) 0 } run()"],
    [], nil, false)
def compile_aarch64_string = run_capture(
    ["env", "CC=/nonexistent", compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_string_binary, "-e",
     'use core.str as str\n' +
     'fn join(str left, str right) str { left + right }\n' +
     'fn byte_at(str text, int idx) int { if idx < 0 { idx = text.len + idx } ' +
     'if idx < 0 || idx >= text.len { return 0 } return load8(text, idx) }\n' +
     'extern fn promote_cstr(ptr text) str as "rt_cstr_to_str"\n' +
     'extern fn cstr_eq(ptr left, ptr right) int as "rt_cstr_eq"\n' +
     'extern fn cstr_cmp(ptr left, ptr right) int as "rt_cstr_cmp"\n' +
     'extern fn cstr_len(ptr text) int as "rt_cstr_len"\n' +
     'fn positive(int value) bool { value > 0 }\n' +
     'fn grow_text() str { mut str s = "x" mut int i = 0 ' +
     'while i < 12 { s = s + s i += 1 } return s }\n' +
     'print(join("hello", " world"))\n' +
     'print(promote_cstr("converted"))\n' +
     'print(cstr_eq("same", "same"), cstr_eq("same", "different"), ' +
     'cstr_eq(0, 0), cstr_eq(0, "x"), ' +
     'cstr_eq("same", join("sa", "me")))\n' +
     'print(cstr_cmp("a", "c") < 0, cstr_cmp("c", "a") > 0, ' +
     'cstr_cmp("same", "same") == 0, cstr_cmp(0, 0) == 0, ' +
     'cstr_cmp(0, "x") < 0, cstr_cmp("x", 0) > 0)\n' +
     'print(cstr_len("length"), cstr_len(""), cstr_len(0))\n' +
     'print(positive(1), positive(0))\n' +
     'def str text = join("hello", " world")\nprint(text, text.len)\n' +
     'print(join("", "tail"), join("head", ""))\n' +
     'print(join("", ""))\nprint(join(join("a", "b"), "c"))\n' +
     'print(str.chr(233))\n' +
     'print(str.repeat("ab", 3))\n' +
     'print(str.repeat("ab", 0))\n' +
     'print(str.repeat("ab", -2))\n' +
     'print(str.repeat("", 4))\n' +
     'print(byte_at("abc", 1), byte_at("abc", -1), byte_at("abc", 3))\n' +
     'def str large = grow_text()\nprint(large.len)\nprint(large)'],
    [], nil, false)
def run_aarch64_string =
    if int(qemu_aarch64_available.get("code", 1)) == 0 {
      run_capture(["qemu-aarch64", aarch64_string_binary], [], nil, false)
    } else {
      nil
    }
def aarch64_string_dynamic =
    run_capture(["readelf", "-d", aarch64_string_binary], [], nil, false)
def run_aarch64_heap =
    if int(qemu_aarch64_available.get("code", 1)) == 0 {
      run_capture(["qemu-aarch64", aarch64_heap_binary], [], nil, false)
    } else {
      nil
    }
def aarch64_heap_dynamic =
    run_capture(["readelf", "-d", aarch64_heap_binary], [], nil, false)
def compile_aarch64_buffer = run_capture(
    ["env", "CC=/nonexistent", compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_buffer_binary, "-e",
     "use core.tbuf (i64buf_new, i64buf_load, i64buf_store)\n" +
     "def values = i64buf_new(4)\n" +
     "i64buf_store(values, 0, 17)\ni64buf_store(values, 3, 25)\n" +
     "def oversized = i64buf_new(4611686018427387903)\n" +
     "print(int(i64buf_load(values, 0)) + int(i64buf_load(values, 3)), " +
     "int(i64buf_load(values, 2)), oversized == 0)"],
    [], nil, false)
def run_aarch64_buffer =
    if int(qemu_aarch64_available.get("code", 1)) == 0 {
      run_capture(["qemu-aarch64", aarch64_buffer_binary], [], nil, false)
    } else {
      nil
    }
def aarch64_buffer_dynamic =
    run_capture(["readelf", "-d", aarch64_buffer_binary], [], nil, false)
def compile_aarch64_memory = run_capture(
    ["env", "CC=/nonexistent", compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_memory_binary, "-e",
     "extern fn bytecmp(ptr a, ptr b, int n) int as \"rt_memcmp_raw\"\n" +
     "@effects(all)\nfn run() int { def dst = malloc(8) def src = malloc(8) " +
     "store64(src, 42, 0) memcpy(dst, src, 8) " +
     "store64(src, 43, 0) " +
     "if bytecmp(dst, src, 8) >= 0 { print('bad negative compare') } " +
     "if bytecmp(src, dst, 8) <= 0 { print('bad positive compare') } " +
     "if bytecmp(dst, src, 0) != 0 { print('bad empty compare') } " +
     "store64(src, 42, 0) if bytecmp(dst, src, 8) != 0 { print('bad equal compare') } " +
     "memcpy(dst, src, -1) memset(src, 0, 1) " +
     "if load8(src, 0) != 0 { print('bad memset') } " +
     "print(load64(dst, 0), load64(src, 0)) " +
     "free(dst) free(src) 0 } run()"],
    [], nil, false)
def run_aarch64_memory =
    if int(qemu_aarch64_available.get("code", 1)) == 0 {
      run_capture(["qemu-aarch64", aarch64_memory_binary], [], nil, false)
    } else {
      nil
    }
def aarch64_memory_dynamic =
    run_capture(["readelf", "-d", aarch64_memory_binary], [], nil, false)
def compile_aarch64_list_length = run_capture(
    ["env", "CC=/nonexistent", compiler, "--native-backend=aarch64",
     "--host-triple=aarch64-unknown-linux-gnu", "--mode=bare", "--native-only",
     "--release", "-o", aarch64_list_length_binary, "-e",
     "@effects(all)\nfn local_length() int { mut list<int> values = [10,20,30] values.len }\n" +
     "print(local_length())\ndef values = [10, 20, 30]\n" +
     "print(values.len, values[1], values[-1])\n" +
     "mut changed = [10, 20, 30]\nprint(int(changed.pop()), changed[1])\n" +
     "print(changed[2])"],
    [], nil, false)
def run_aarch64_list_length =
    if int(qemu_aarch64_available.get("code", 1)) == 0 {
      run_capture(["qemu-aarch64", aarch64_list_length_binary], [], nil, false)
    } else {
