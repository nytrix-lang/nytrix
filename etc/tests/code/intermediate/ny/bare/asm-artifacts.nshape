mut str expected_large_text = "x"
mut int expected_large_i = 0
while expected_large_i < 12 {
  expected_large_text = expected_large_text + expected_large_text
  expected_large_i += 1
}
def aarch64_string_run_code =
    if int(qemu_aarch64_available.get("code", 1)) == 0 {
      to_str(int(run_aarch64_string.get("code", 127)))
