shape vector_reduction_zero_trip_exit {
  family "codegen/loops/vectorize"
  generator "regression"
  features ["x86-64", "vectorize", "reduction", "regalloc", "loop-carry"]
  template ny-test-case
  flags "-O3 --native-only --native-backend=x86_64"
  timeout 60
  expect compile_and_run
  source ny <<'NY'
use core

;; `result += <loop-invariant call>` is vectorized into a vec8 accumulator with
;; a scalar remainder. For fewer than four iterations the vector loop runs zero
;; times and its accumulator is still reduced at the exit. The accumulator's
;; carried segment is marked spill for that exit edge, but block-entry seeding
;; dropped such segments, so the home was never written and the reduction read
;; stack garbage (three repetitions of 817 summed to 2491).
fn moves(int depth, int x, int y) int {
   if depth == 0 { return 1 }
   mut int total = 0
   mut int i = 0
   while i < 8 {
      def int pair = i >> 1
      def int dx = pair < 2 ? pair - 2 : pair - 1
      def int sign = (i & 1) == 0 ? -1 : 1
      def int magnitude = pair == 0 || pair == 3 ? 1 : 2
      def int dy = sign * magnitude
      def int nx = x + dx
      def int ny = y + dy
      if nx >= 0 && nx < 8 && ny >= 0 && ny < 8 { total += moves(depth - 1, nx, ny) }
      i += 1
   }
   total
}
fn repeat(int n) int {
   mut int result = 0
   mut int rep = 0
   while rep < n {
      result += moves(4, 2, 0)
      rep += 1
   }
   result
}
def one = moves(4, 2, 0)
assert(one == 817, "single search")
mut n = 0
while n <= 9 {
   assert(repeat(n) == one * n, "repeat " + to_str(n) + " times: " + to_str(repeat(n)) + " vs " + to_str(one * n))
   n += 1
}
assert(repeat(400) == one * 400, "400 repetitions")
NY
}
