shape semantic_any_attached_methods {
  family "runtime-native"
  generator "native"
  features [native nyir x86_64 semantic any attached_methods]
  template ny-test-case
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only; --native-only --native-backend=x86_64"
  expect compile_and_run
  source ny <<'NY'
use core

fn exercise(any value) int {
  value.set("answer", 42)
  if !value.contains("answer") { return 1 }
  if value.get("answer", 0) != 42 { return 2 }
  if value.len != 1 { return 3 }
  0
}

assert(exercise({}) == 0, "any receiver preserves attached member ABI")
NY
}
