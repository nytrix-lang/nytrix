shape tbuf_inferred_pointer_sieve {
  family "runtime-native"
  generator "native"
  features ["native", "nyir", "x86_64", "typed-buffer", "pointer-return"]
  template ny-test-case
  flags "--native-only --native-backend=x86_64 -O3 --nyir-verify --native-result-oracle=0"
  expect compile_and_run
  source ny <<'NY'
use core.tbuf

def n = 10000
mut flags = u8buf_new(n)
mut fill = 0
while fill < n {
  flags = u8buf_store(flags, fill, 1)
  fill += 1
}

mut primes = 0
mut i = 2
while i < n {
  if u8buf_load(flags, i) != 0 {
    primes += 1
    mut j = i + i
    while j < n {
      flags = u8buf_store(flags, j, 0)
      j += i
    }
  }
  i += 1
}
assert(primes == 1229, "inferred typed-buffer pointer survives sieve stores")
NY
}
