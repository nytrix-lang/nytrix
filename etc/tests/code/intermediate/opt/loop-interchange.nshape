shape optcheck_loop_interchange_legality {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle optcheck loop interchange legality negative-path]
  template ny-test-case
  flags "-O3 --native-backend x86_64 --native-oracle-per-pass --native-result-oracle=60 --nyir-pass-stats"
  expect compile_and_run
  source ny <<'NY'
fn rectangular_nest() i64 {
  mut sum = 0
  for(mut i = 0 i <= 2 i += 1) {
    for(mut j = 0 j <= 4 j += 1) { sum = sum + 1 }
  }
  sum
}
fn dependent_nest() i64 {
  mut sum = 0
  for(mut i = 0 i <= 2 i += 1) {
    for(mut j = 0 j <= 4 j += 1) { sum = sum + i + j }
  }
  sum
}
rectangular_nest() + dependent_nest()
NY
}
