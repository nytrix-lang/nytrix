shape optcheck_loop_last_overwrite {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle optcheck loop-last-overwrite]
  template ny-test-case
  flags "-O3 --native-backend x86_64 --native-oracle-per-pass --native-result-oracle=298 --nyir-verify --nyir-pass-stats"
  expect compile_and_run
  source ny <<'NY'
fn final_value(i64 flag) i64 {
  mut value = 0
  mut i = 0
  while i < 100 {
    if flag { value = i + 1 } else { value = i * 2 }
    i += 1
  }
  value
}
final_value(1) + final_value(0)
NY
}
