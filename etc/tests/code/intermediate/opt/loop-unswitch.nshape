shape optcheck_loop_unswitch {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle optcheck loop-unswitch]
  template ny-test-case
  flags "-O3 --native-backend x86_64 --native-oracle-per-pass --native-result-oracle=99 --nyir-verify --nyir-pass-stats"
  expect compile_and_run
  source ny <<'NY'
fn branch_sum(i64 flag) i64 {
  mut sum = 0
  mut i = 0
  while i < 3 {
    if flag != 0 { sum += 11 } else { sum += 22 }
    i += 1
  }
  sum
}
branch_sum(1) + branch_sum(0)
NY
}
