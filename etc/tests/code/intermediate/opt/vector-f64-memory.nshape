shape vector_f64_memory_backend_parity {
  family "runtime"
  generator "native"
  features [optimizer vectorization f64 memory backend-parity]
  template ny-test-case
  flags "-O2"
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf

def N = 16
mut input = f64buf_new(N)
mut output = f64buf_new(N)
mut i = 0
while i < N {
   f64buf_store(input, i, float(i))
   i += 1
}

mut total = 0
mut i = 1
while i < N - 1 {
   def value = (f64buf_load(input, i - 1) + f64buf_load(input, i + 1)) * 0.5
   f64buf_store(output, i, value)
   total += int(f64buf_load(output, i) * 1000.0)
   i += 1
}
assert(total == 105000, "f64 loop checksum")
print("vector-f64-memory=ok")
NY
}
