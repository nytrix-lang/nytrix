shape optcheck_loop_predication {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle optcheck loop predication pass-fires negative-path]
  template ny-test-case
  flags "-O3 --native-backend x86_64 --native-oracle-per-pass --native-result-oracle=547 --nyir-pass-stats"
  expect compile_and_run
  source ny <<'NY'
fn select_sum(i64 n) i64 {
  mut sum = 0
  for i in 0..n {
    def yes = i + 3
    def no = i - 2
    def chosen = if (i & 1) == 0 { yes } else { no }
    sum = sum + chosen
  }
  sum
}
fn unchanged_path(i64 n) i64 {
  mut sum = 0
  for i in 0..n {
    if (i & 1) == 0 { sum = sum + i } else { sum = sum - i }
  }
  sum
}
select_sum(32)
NY
}
