shape optcheck_cse_pure_call {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle optcheck cse pure-call]
  template ny-test-case
  flags "-O3 --native-backend x86_64 --native-oracle-per-pass --native-result-oracle=13958 --nyir-pass-stats"
  expect compile_and_run
source ny <<'NY'
use core
@pure
fn capped(int value) int {
  if value < 7 { value } else { 7 }
}
mut sum = 0
for(mut i = 0 i <= 1000 i += 1) {
  sum = sum + capped(i) + capped(i)
}
print(sum)
sum
NY
}
