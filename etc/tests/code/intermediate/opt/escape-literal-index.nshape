shape optcheck_escape_literal_index {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle optcheck escape]
  template ny-test-case
  flags "-O3 --native-backend x86_64 --native-oracle-per-pass --native-result-oracle=4950 --nyir-pass-stats"
  expect compile_and_run
  source ny <<'NY'
use core
mut i = 0
mut sum = 0
while i < 100 {
  mut list<int> value = [i]
  sum += value[0]
  i += 1
}
print(sum)
sum
NY
}
