shape wasm32_sret_aggregate_import_executes {
  family "runtime/compiler"
  generator "embedded"
  features ["ny", "test", "wasm", "aggregate", "sret", "c-abi", "nyir"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os (file_exists, file_remove, file_write, run_capture, temp_dir, pid)

def compiler = env("NYTRIX_NY_FULL_BIN")
assert(is_str(compiler) && compiler.len > 0,
       "test runner provides the compiler path")
def stem = temp_dir() + "/ny-wasm-sret-" + to_str(pid())
def host_wat = stem + "-host.wat"
def host_wasm = stem + "-host.wasm"
def provider_wat = stem + "-provider.wat"
def provider_wasm = stem + "-provider.wasm"
def host_source =
    "#include \"etc/tests/lang/interop/c/internal-byvalue-param-import.h\"\n" +
    "struct Triple { i64 first, i64 second, i64 third }\n" +
    "extern \"c\" { fn host_triple() Triple }\n" +
    "def pair = make_small_integer_pair()\n" +
    "def float_pair = make_small_float_pair()\n" +
    "def scalar_i32 = make_single_integer32()\n" +
    "host_triple()\npair != nil && float_pair != nil && " +
    "scalar_i32 != nil && inspect_single_integer32(scalar_i32) == 8 ? 0 : 1"
def compile = run_capture(
    [compiler, "--no-effect-require-known", "--native-backend=wasm",
     "--native-only", "--nyir-verify", "--emit-asm=" + host_wat,
     "-no-std", "-emit-only", "-e", host_source],
    [], nil, false)
def assemble = run_capture(["wat2wasm", host_wat, "-o", host_wasm],
                           [], nil, false)
def provider_write = file_write(
    provider_wat,
    "(module (memory 1)\n" +
    "  (func (export \"make_small_integer_pair\") (param i32)\n" +
    "    local.get 0\n" +
    "    i32.eqz\n" +
    "    if unreachable end\n" +
    "    local.get 0\n" +
    "    i32.const 7\n" +
    "    i32.store\n" +
    "    local.get 0\n" +
    "    i32.const 4\n" +
    "    i32.add\n" +
    "    i32.const 11\n" +
    "    i32.store)\n" +
    "  (func (export \"make_small_float_pair\") (param i32)\n" +
    "    local.get 0\n" +
    "    i32.eqz\n" +
    "    if unreachable end\n" +
    "    local.get 0\n" +
    "    f32.const 1.5\n" +
    "    f32.store\n" +
    "    local.get 0\n" +
    "    i32.const 4\n" +
    "    i32.add\n" +
    "    f32.const 2.5\n" +
    "    f32.store)\n" +
    "  (func (export \"make_single_integer32\") (result i32)\n" +
    "    i32.const 17)\n" +
    "  (func (export \"inspect_single_integer32\") (param i32) (result i64)\n" +
    "    local.get 0\n" +
    "    i32.const 17\n" +
    "    i32.eq\n" +
    "    if (result i64) i64.const 8 else i64.const 0 end)\n" +
    "  (func (export \"host_triple\") (param i32)\n" +
    "    local.get 0\n" +
    "    i32.eqz\n" +
    "    if unreachable end))\n")
def provider_assemble =
    run_capture(["wat2wasm", provider_wat, "-o", provider_wasm],
                [], nil, false)
def execute = run_capture(
    ["wasmtime", "run", "--preload", "env=" + provider_wasm,
     "--invoke", "rt_main", host_wasm],
    [], nil, false)
def removed_host_wasm =
    if file_exists(host_wasm) { is_ok(file_remove(host_wasm)) } else { true }
def removed_host_wat =
    if file_exists(host_wat) { is_ok(file_remove(host_wat)) } else { true }
def removed_provider_wasm =
    if file_exists(provider_wasm) { is_ok(file_remove(provider_wasm)) } else { true }
def removed_provider_wat =
    if file_exists(provider_wat) { is_ok(file_remove(provider_wat)) } else { true }
assert(removed_host_wasm && removed_host_wat &&
       removed_provider_wasm && removed_provider_wat,
       "remove generated aggregate-import artifacts")
assert(provider_write && compile.get("code", 127) == 0 &&
       assemble.get("code", 127) == 0 &&
       provider_assemble.get("code", 127) == 0,
       "sret aggregate import emits valid Wasm and provider modules")
assert(execute.get("code", 127) == 0 &&
       endswith(execute.get("stdout", ""), "1\n"),
       "Wasm sret import receives a non-null caller-owned result pointer")
NY
}
