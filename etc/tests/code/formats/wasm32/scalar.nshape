shape wasm32_native_scalar_assembly {
  family "runtime-native"
  generator "native"
  features [native object wasm32 scalar nyir]
  template ny-test-case
  flags "--native-backend wasm --nyir-verify --emit-asm=/tmp/nytrix-native-wasm32-scalar.s -no-std"
  expect compile_and_run
  source ny <<'NY'
fn mix(i64 a, i64 b) i64 {
  a + b
}

mix(22, 5)
NY
}
