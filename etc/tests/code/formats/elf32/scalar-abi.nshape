defaults {
  family "runtime-native"
  generator "native"
  template ny-test-case
}

shape i386_elf32_object_link_run_f32 {
  features [native object elf32 i386 x86 nyir link-run f32]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f32.o"
  expect object_link_run_f64_0.30000001192092896
  source ny <<'NY'
def f32 a = 0.1
def f32 b = 0.2
def f64 c = a + b
c
NY
}

shape i386_elf32_object_link_run_f32_call {
  features [native object elf32 i386 x86 nyir link-run f32 call]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f32-call.o"
  expect object_link_run_f64_0.30000001192092896
  source ny <<'NY'
fn add(f32 a, f32 b) f32 {
  a + b
}

def f64 y = add(0.1, 0.2)
y
NY
}

shape i386_elf32_object_link_run_f32_compare {
  features [native object elf32 i386 x86 nyir link-run f32 compare]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f32-compare.o"
  expect object_link_run_i64_1
  source ny <<'NY'
def f32 a = 0.1
def f32 b = 0.2
def f32 c = a + b
def f32 t = 0.30000001
c == t
NY
}

shape i386_elf32_object_link_run_f32_direct_return {
  features [native object elf32 i386 x86 nyir link-run f32 abi return]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f32-direct-return.o"
  expect object_link_run_f32_3.75
  source ny <<'NY'
def f32 x = 1.5f32
def f32 y = 2.25f32
x + y
NY
}

shape i386_elf32_object_link_run_f64 {
  features [native object elf32 i386 x86 nyir link-run f64]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f64.o"
  expect object_link_run_f64_3.75
  source ny <<'NY'
def a = 1.5
def b = 2.25
a + b
NY
}

shape i386_elf32_object_link_run_f64_call {
  features [native object elf32 i386 x86 nyir link-run f64 call]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f64-call.o"
  expect object_link_run_f64_3.75
  source ny <<'NY'
fn val() f64 {
  3.75
}

val()
NY
}

shape i386_elf32_object_link_run_f64_params {
  features [native object elf32 i386 x86 nyir link-run f64 call params]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f64-params.o"
  expect object_link_run_f64_3.75
  source ny <<'NY'
fn add(f64 x, f64 y) f64 {
  x + y
}

add(1.5, 2.25)
NY
}

shape i386_elf32_object_link_run_f64_cmp {
  features [native object elf32 i386 x86 nyir link-run f64 cmp]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-f64cmp.o"
  expect object_link_run_i64_1
  source ny <<'NY'
def a = 3.5
def b = 2.25
if a > b { 1 } else { 0 }
NY
}

shape i386_elf32_object_link_run_f64_cmp_all {
  features [native object elf32 i386 x86 nyir link-run f64 cmp]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-f64cmp-all.o"
  expect object_link_run_i64_1
  source ny <<'NY'
def a = 3.5
def b = 2.25
def c = 3.5
if a > b {
  if a >= c {
    if b < a {
      if b <= a {
        if a != b {
          if a == c {
            1
          } else { 0 }
        } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 }
} else { 0 }
NY
}

shape i386_elf32_object_link_run_f64_compare {
  features [native object elf32 i386 x86 nyir link-run f64 compare]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f64-compare.o"
  expect object_link_run_i64_1
  source ny <<'NY'
fn gt(f64 x, f64 y) bool {
  x > y
}

gt(2.25, 1.5)
NY
}

shape i386_elf32_object_link_run_f64_compare_lt {
  features [native object elf32 i386 x86 nyir link-run f64 compare]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f64-compare-lt.o"
  expect object_link_run_i64_1
  source ny <<'NY'
fn lt(f64 x, f64 y) bool {
  x < y
}

lt(1.5, 2.25)
NY
}

shape x86_elf32_object_link_run_i16_return {
  features [native object elf32 x86 nyir link-run abi]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-i16-return.o"
  expect object_link_run_i16_65535
  source ny <<'NY'
fn ret_i16() i16 {
  -1
}
ret_i16()
NY
}

shape x86_elf32_object_link_run_i64 {
  features [native object elf32 x86 nyir link-run]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-i64.o"
  expect object_link_run_i64_45
  source ny <<'NY'
def a = 40
def b = 5
a + b
NY
}

shape i386_elf32_object_link_run_int_cmp {
  features [native object elf32 i386 x86 nyir link-run cmp]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-elf32-intcmp.o"
  expect object_link_run_i64_1
  source ny <<'NY'
fn check(i64 a, i64 b) i64 {
  if a > b {
    if a >= b {
      if b < a {
        if b <= a {
          if a != b {
            1
          } else { 0 }
        } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 }
}
check(10, 3)
NY
}

shape x86_elf32_object_link_run_u32_return {
  features [native object elf32 x86 nyir link-run abi]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-u32-return.o"
  expect object_link_run_u32_4294967295
  source ny <<'NY'
fn ret_u32() u32 {
  4294967295
}
ret_u32()
NY
}

shape x86_elf32_object_link_run_u8_return {
  features [native object elf32 x86 nyir link-run abi]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-u8-return.o"
  expect object_link_run_u8_255
  source ny <<'NY'
fn ret_u8() u8 {
  255
}
ret_u8()
NY
}

shape x86_elf32_object_link_run_bool_return {
  features [native object elf32 x86 nyir link-run abi bool]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-bool-return.o"
  expect object_link_run_bool_1
  source ny <<'NY'
fn ret_bool(i64 a, i64 b) bool {
  a < b
}
ret_bool(3, 5)
NY
}

shape x86_elf32_object_link_run_call7 {
  features [native object elf32 x86 nyir link-run reloc call]
  flags "--nyir-verify --native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-call7.o"
  expect object_link_run_i64_28
  source ny <<'NY'
fn add7(i64 a, i64 b, i64 c, i64 d, i64 e, i64 f, i64 g) i64 {
  a + b + c + d + e + f + g
}

add7(1, 2, 3, 4, 5, 6, 7)
NY
}
