shape x86_64_elf64_native_runtime_print_int {
  family "runtime-native"
  generator "native"
  features [native object elf64 x86_64 nyir link-run runtime print]
  template ny-test-case
  flags_matrix "--nyr-verify --native --run; --nyr-verify --native-backend=llvm --jit --jit-engine=mcjit; --nyr-verify --native-backend=llvm --jit --jit-engine=orc; --nyr-verify --native-only"
  expect compile_and_run
  source ny <<'NY'
fn add(i64 a, i64 b) i64 {
  a + b
}
print(add(20, 22))
NY
}
