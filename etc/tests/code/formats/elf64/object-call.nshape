shape x86_64_elf64_object_call_reloc {
  family "runtime-native"
  generator "native"
  features ["native", "object", "elf", "reloc", "x86_64", "nyir"]
  template ny-test-case
  flags "--native-backend x86_64 --nyir-verify -emit-only -o /tmp/nytrix-native-elf64-object-call.o"
  expect compile_and_run
  source ny <<'NY'
fn add(i64 x, i64 y) i64 { x + y }
add(40, 2)
NY
}
shape elf64_object_call4 {
  family "runtime-native/elf64-object-call"
  generator "native"
  features [native object elf64 call]
  template ny-test-case
  flags "--native-backend x86_64 --nyir-verify -emit-only -o /tmp/nytrix-native-elf64-object-call4.o"
  expect compile_and_run
  source ny <<'NY'
fn add4(i64 a, i64 b, i64 c, i64 d) i64 { a + b + c + d }
add4(1, 2, 3, 4)
NY
}

shape elf64_object_call6 {
  family "runtime-native/elf64-object-call"
  generator "native"
  features [native object elf64 call]
  template ny-test-case
  flags "--native-backend x86_64 --nyir-verify -emit-only -o /tmp/nytrix-native-elf64-object-call6.o"
  expect compile_and_run
  source ny <<'NY'
fn add6(i64 a, i64 b, i64 c, i64 d, i64 e, i64 f) i64 { a + b + c + d + e + f }
add6(1, 2, 3, 4, 5, 6)
NY
}
