shape x86_64_elf64_object_link_run_unused_leading_f32 {
  family "runtime-native"
  generator "native"
  features [native object elf64 x86_64 nyir link-run]
  template ny-test-case
  flags "--nyir-verify --native-only --native-backend x86_64 -emit-only -o /tmp/nytrix-link-run-unused-leading-f32.o"
  expect object_host_link_run_i64_42
  source ny <<'NY'
fn pick(f32 unused, f32 value) f32 {
  value
}
def f64 result = pick(1.25, 3.75)
if result == 3.75 { 42 } else { 0 }
NY
}
