shape x86_64_elf64_object_link_run_bool_return {
  features [native object elf64 x86_64 nyir link-run abi bool]
  flags "--nyir-verify --native-only --native-backend x86_64 -emit-only -o /tmp/nytrix-link-run-bool-return.o"
  expect object_host_link_run_i64_42
