shape x86_64_elf64_object_link_run_i64 {
  features [native object elf64 x86_64 nyir link-run]
  flags "--native-only --native-backend x86_64 --nyir-verify -emit-only -o /tmp/nytrix-link-run-i64.o"
  expect object_host_link_run_i64_10
  source ny <<'NY'
fn add4(i64 a, i64 b, i64 c, i64 d) i64 {
  a + b + c + d
}
add4(1, 2, 3, 4)
NY
}

