shape x86_64_elf64_object_link_run_f64_call10 {
  features [native object elf64 x86_64 nyir link-run]
  flags "--nyir-verify --native-only --native-backend x86_64 -emit-only -o /tmp/nytrix-link-run-f64-call10.o"
  expect object_host_link_run_i64_42
  source ny <<'NY'
