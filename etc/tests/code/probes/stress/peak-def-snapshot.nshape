shape test_peak_def_snapshot {
  family "shapes/compiler/regressions/compiler"
  generator "embedded"
  features ["ny", "test"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
;; NY-008: Nytrix peak profile miscompiles an immutable def snapshot of a
;; mutable int when the snapshot is reused after mutating the original.
;;
;; Expected output from O0, O3, and non-peak O3 profiles:
;; -1
;;
;; Repro:
;;   ny-test fuzz compiler-known-bugs --only NY-008
;;
;; Current local bad output from peak on 2026-06-01:
;; 0
mut int: acc = 1
def int: row = acc
acc -= row
acc -= row
print(acc)
NY
}
