shape raw_int_list_mutation {
  family "compiler-lists"
  generator "stress"
  features [ny compiler mutation runtime-helper]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core

fn raw_mutation_case() int {
   mut xs = [1, 2, 3, 4, 5, 6, 7, 8]
   mut i = 0
   mut acc = 0
   while(i < len(xs)){
      def idx = (i * 3 + 1) % len(xs)
      def next = (get(xs, idx, 0) + i + acc) % 127
      xs = set_idx(xs, idx, next)
      acc += get(xs, idx, 0)
      i += 1
   }
   print(acc)
   0
}

fn raw_runtime_helper_case() int {
   mut a = [1, 2, 3, 4, 5, 6, 7, 8]
   mut b = [8, 7, 6, 5, 4, 3, 2, 1]
   mut c = [0, 0, 0, 0, 0, 0, 0, 0]
   mut int: i = 0
   mut int: acc = 0
   while(i < len(a)){
      def j = i % len(a)
      c = set_idx(c, j, get(a, j, 0) + get(b, j, 0))
      acc += get(c, j, 0)
      i += 1
   }
   print(acc + get(c, 99, 11))
   0
}

fn main() int {
   raw_mutation_case()
   raw_runtime_helper_case()
   0
}
NY
}
