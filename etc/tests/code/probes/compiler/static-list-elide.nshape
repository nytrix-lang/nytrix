shape static_list_elide {
  family "compiler-lists"
  generator "stress"
  features [ny compiler readonly mutation escape]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core

fn readonly_probe() int {
   def xs = [3, 5, 8, 13]
   mut i = 0
   mut acc = len(xs)
   while(i < len(xs)){
      acc += get(xs, i, 0)
      i += 1
   }
   acc
}
fn mutable_probe() int {
   mut xs = [1, 2, 3]
   xs = set_idx(xs, 1, 7)
   get(xs, 1, 0)
}
fn escaped_probe() int {
   def xs = [4, 6]
   print(xs)
   len(xs)
}
fn mixed_probe() int {
   def xs = [1, "x"]
   len(xs)
}
fn static_list_probe_case() int {
   print(readonly_probe())
   print(mutable_probe())
   print(escaped_probe())
   print(mixed_probe())
   0
}

fn sum_readonly(xs) int {
   mut i = 0
   mut acc = 0
   while(i < len(xs)){
      acc += get(xs, i, 0)
      i += 1
   }
   acc
}
fn static_list_runtime_case() int {
   def xs = [2, 4, 6, 8]
   print(sum_readonly(xs))
   0
}

fn main() int {
   static_list_probe_case()
   static_list_runtime_case()
   0
}
NY
}

shape static_list_elide_readonly_probe {
  family "probe-suite"
  generator "stress"
  features ["ny", "compiler"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'

NY
}
