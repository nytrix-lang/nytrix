shape test_file_read_result_abi {
  family "runtime/system"
  generator "embedded"
  features ["ny", "test", "filesystem"]
  template ny-test-case
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_and_run
  source ny <<'NY'
use core
use core.os
use core.os.sys (syscall, sys_open, sys_close_quiet)

match file_read("/dev/null") {
   ok(content) -> { assert(content.len == 0, "file_read handles EOF") }
   err(code) -> { assert(false, "file_read opens /dev/null") }
}
def int probe_fd = int(unwrap(sys_open("/dev/null", 0, 0)))
sys_close_quiet(probe_fd)
assert(syscall(1, probe_fd, 0, 0, 0, 0, 0) == -9,
   "sys_close_quiet closes the raw descriptor it receives")
NY
}
