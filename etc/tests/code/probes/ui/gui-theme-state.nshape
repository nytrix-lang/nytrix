shape gui-theme-state {
  family "probe-suite"
  generator "regression"
  features ["ny", "render", "gui"]
  template ny-test-case
  expect compile_and_run
  flags_matrix "--native-only -O0; --native-only -O3; --native-backend=llvm --jit --jit-engine=mcjit"
  expect_stdout "GUI-THEME-STATE-OK"
  source ny <<'NY'
use core
use core.os.ui.render.viewer.gui as gui
def initial = gui.accent()
assert(is_list(initial) && initial.len == 4, "default palette exists")
assert(float(initial.get(0)) == 0.714 && float(initial.get(2)) == 1.0, "default accent is the shared violet")
def dim = gui.theme_color("text_dim")
def txt = gui.theme_color("text")
def danger = gui.theme_color("danger")
def ok = gui.theme_color("ok")
;; Colours are read into locals first: `gui.theme_color(...).get(n)` chained
;; on the call result reads the list shifted by one element on this compiler.
assert(is_list(dim) && dim.len == 4 && float(dim.get(0)) < float(txt.get(0)), "dim text is darker than text")
assert(float(danger.get(0)) > float(danger.get(2)), "danger is a warm colour, not grey")
assert(float(ok.get(1)) > float(ok.get(0)), "ok is a green, not grey")
def success = gui.theme_color("success")
assert(float(success.get(1)) == float(ok.get(1)) && float(success.get(0)) == float(ok.get(0)), "token aliases resolve to the same colour")
assert(gui.set_theme_color("warn", [0.9, 0.7, 0.1, 1.0]), "known token accepts an override")
def warn = gui.theme_color("warn")
assert(float(warn.get(2)) == 0.1 && float(warn.get(0)) == 0.9, "token override applies")
assert(!gui.set_theme_color("no_such_token", [0.0, 0.0, 0.0, 1.0]), "unknown token is rejected")
assert(!gui.set_theme_color("text", [1.0]), "short colour list is rejected")
gui.set_accent([0.2, 0.4, 0.6, 0.8])
def changed = gui.accent()
assert(float(changed.get(0)) == 0.2 && float(changed.get(1)) == 0.4, "red and green")
assert(float(changed.get(2)) == 0.6 && float(changed.get(3)) == 0.8, "blue and alpha")
assert(float(gui.accent().get(0)) == 0.2, "initialization preserves chosen accent")
print("GUI-THEME-STATE-OK")
NY
}
