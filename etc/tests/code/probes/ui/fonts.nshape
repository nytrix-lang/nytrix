shape font {
  family "probe-suite"
  generator "stress"
  features ["ny", "sys"]
  ci skip
  template ny-test-case
  expect compile_and_run
  ci optional
  source ny <<'NY'
use core
use core.error
use core.os
use core.os.path as ospath
use core.os.ui.font.truetype as ttf
;; Keep the probe hermetic: CI images do not share a system font layout.
def path = ospath.resolve_repo_asset("etc/assets/fonts/jetbrains.ttf")
def info = ttf.load_path(path, 0)
assert(info != 0, "font probe load path")
def gi = ttf.get_glyph_index(info, 65)
print("gi A=" + to_str(gi))
def scale = ttf.scale_for_pixel_height(info, 32.0)
def bm = ttf.get_glyph_bitmap(info, scale, scale, gi)
assert(bm != 0, "font probe bitmap")
def w = bm.get("width", 0)
def h = bm.get("height", 0)
def data = bm.get("data", 0)
print("bitmap=" + to_str(w) + "x" + to_str(h) + " xoff=" + to_str(bm.get("xoff", 0)) + " yoff=" + to_str(bm.get("yoff", 0)))
mut y = 0
while y < h {
   mut line = ""
   mut x = 0
   while x < w {
      def a = load8(data, (y * w + x) * 4 + 3)
      line += a > 180 ? "#" : (a > 40 ? "+" : ".")
      x += 1
   }
   print(line)
   y += 1
}
ttf.unload(info)
NY
}

shape font-asset {
  family "probe-suite"
  generator "stress"
  features ["ny", "sys"]
  ci skip
  template ny-test-case
  expect compile_and_run
  ci optional
  source ny <<'NY'
use core
use core.error
use core.os
use core.os.path as ospath
use core.os.ui.font.truetype as ttf
fn probe(path){
   print("font " + path)
   if !file_exists(path) {
      print("  missing")
      return
   }
   def info = ttf.load_path(path, 0)
   assert(info != 0, "load " + path)
   def gi_a = ttf.get_glyph_index(info, 65)
   def gi_e = ttf.get_glyph_index(info, 69)
   def gi_q = ttf.get_glyph_index(info, 63)
   print("  gi A=" + to_str(gi_a) + " E=" + to_str(gi_e) + " ?=" + to_str(gi_q))
   def scale = ttf.scale_for_pixel_height(info, 32.0)
   def bm = ttf.get_glyph_bitmap(info, scale, scale, gi_a)
   assert(bm != 0, "bitmap " + path)
   def w = bm.get("width", 0)
   def h = bm.get("height", 0)
   def data = bm.get("data", 0)
   print("  bitmap=" + to_str(w) + "x" + to_str(h) + " xoff=" + to_str(bm.get("xoff", 0)) + " yoff=" + to_str(bm.get("yoff", 0)))
   mut y = 0
   while y < h {
      mut line = "  "
      mut x = 0
      while x < w {
         def a = load8(data, (y * w + x) * 4 + 3)
         line += a > 180 ? "#" : (a > 40 ? "+" : ".")
         x += 1
      }
      print(line)
      y += 1
   }
   ttf.unload(info)
}
probe(ospath.resolve_repo_asset("etc/assets/fonts/jetbrains.ttf"))
probe(ospath.resolve_repo_asset("etc/assets/fonts/maplemono.ttf"))
probe(ospath.resolve_repo_asset("etc/assets/fonts/monocraft.ttf"))
NY
}

shape font-text-codepoints {
  family "probe-suite"
  generator "regression"
  features ["ny", "render", "font", "unicode"]
  template ny-test-case
  expect compile_and_run
  timeout 180
  flags_matrix "--native-only -O0; --native-only -O3; --native-backend=llvm --jit --jit-engine=mcjit"
  expect_stdout "FONT-TEXT-CODEPOINTS-OK"
  source ny <<'SOURCE'
use core
use core.os.ui.render as gfx
assert(gfx.set_backend_type(gfx.BACKEND_MOCK), "mock renderer is available")
def font = gfx.font_load("etc/assets/fonts/maplemono.ttf", 16)
assert(font > 0, "bundled font loads")
gfx.draw_text(font, "Hé", 10.0, 10.0)
def keys = dict_keys(gfx._font_get(font).get("glyphs"))
mut ascii_seen = false
mut unicode_seen = false
mut i = 0
while i < keys.len {
   def int cp = int(keys.get(i))
   if cp == 72 { ascii_seen = true }
   if cp == 233 { unicode_seen = true }
   assert(cp != 145 && cp != 467, "codepoints are not interpreted as tagged integers")
   i += 1
}
assert(ascii_seen && unicode_seen, "ASCII and UTF-8 codepoints resolve")
print("FONT-TEXT-CODEPOINTS-OK")
SOURCE
}
