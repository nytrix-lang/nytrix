shape test_argv_oob {
  family "runtime/system/args"
  generator "embedded"
  features ["ny", "test"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
;; NY-006: core.os.args.argv out-of-range used to segfault instead of returning
;; a safe empty/null-like result.
;;
;; Historical bad signal:
;;   ny --compiler-asserts -c $'use core\nuse core.os.args\nprint(argv(2))'
;; exited with SIGSEGV when argc() == 1.
;;
;; Current local retest on 2026-06-01 exits 0 and prints an empty line, so this
;; is tracked as a fixed-candidate regression guard.
use core
use core.os.args

print(argv(argc() + 1))
NY
}
