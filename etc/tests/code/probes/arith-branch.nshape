shape diff_arith_branch {
  family "runtime-native"
  generator "native"
  features [native x86_64 nyir vm differential arith branch]
  template ny-test-case
  ; Merges former arith-native/vm + branch-native/vm into one matrix.
  flags_matrix "--native-backend x86_64; --native --run"
  expect compile_and_run
  source ny <<'NY'
use core
fn branch_result() i64 {
  if 1 {
    1 + 2 * 3 + 42
  } else {
    0
  }
}
assert(branch_result() == 49, "arithmetic branch result")
0
NY
}
