shape fmt_c_family_parity {
  family "probe/tools"
  generator "embedded"
  features ["formatter", "c-family", "parity"]
  template ny-test-case
  flags "--native-only"
  timeout 60
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.subprocess (run_capture)
use core.str as str

def ny = env("NYTRIX_NY_FULL_BIN")
def fmt = env("NYTRIX_TEST_FMT_BIN")
def cmake = env("NYTRIX_CMAKE_COMMAND")
assert(is_str(ny) && is_str(fmt) && is_str(cmake),
       "CTest provides formatter executables")
def dir = temp_dir() + "/fmt-c-family-" + to_str(pid())
def made = run_capture([cmake, "-E", "make_directory", dir], [], nil, false)
assert(made.get("code", 127) == 0, "create C family formatter directory")

fn compare(str name, str source) {
   def input = dir + "/" + name
   def c_path = dir + "/c-" + name
   def ny_path = dir + "/ny-" + name
   assert(is_ok(file_write(input, source)), "write C-family input " + name)
   assert(is_ok(file_write(c_path, source)), "write C oracle input " + name)
   assert(is_ok(file_write(ny_path, source)), "write Ny input " + name)
   def c_result = run_capture([fmt, "--fix", c_path], [], nil, false)
   def ny_result = run_capture([ny, "fmt", "--fix", ny_path], [], nil, false)
   assert(c_result.get("code", 127) == 0 && ny_result.get("code", 127) == 0 &&
          unwrap(file_read(c_path)) == unwrap(file_read(ny_path)),
          "C-family formatting differs for " + name + ": " +
          c_result.get("stdout", "") + "\n" + ny_result.get("stdout", ""))
}

compare("format.c",
   "#include <stdio.h>\n\n// ---- Section ----\n// ----\n\n/* First\n * ordinary\n * lines\n */\n\nvoid\tf() {}\r\n")
compare("format.hpp",
   "/* ---- Single heading ---- */\n\n/*\n * ordinary block\n * content   \n */\n\n/*\n * ---- Section ----\n * ----\n *\n * kept text\n */\n\nint x;\n")
def cleanup = run_capture([cmake, "-E", "rm", "-rf", dir], [], nil, false)
assert(cleanup.get("code", 127) == 0, "remove C family formatter directory")
print("FMT_C_FAMILY_PARITY_OK")
NY
}
