shape fmt_audit_corpus_parity {
  family "probe/tools"
  generator "embedded"
  features ["formatter", "audit-corpus", "parity"]
  template ny-test-case
  flags "--native-only"
  timeout 120
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.subprocess (run_capture)
use core.str as str
def ny = env("NYTRIX_NY_FULL_BIN")
def fmt = env("NYTRIX_TEST_FMT_BIN")
def cmake = env("NYTRIX_CMAKE_COMMAND")
def dir = temp_dir() + "/fmt-audit-corpus-" + to_str(pid())
def made = run_capture([cmake, "-E", "make_directory", dir], [], nil, false)
assert(made.get("code", 127) == 0, "create audit corpus directory")
def ny_source = dir + "/corpus.ny"
def c_source = dir + "/corpus.c"
def h_source = dir + "/corpus.h"
assert(is_ok(file_write(ny_source,
   "use core\n\nfn corpus_total(values) {\n   def grown = append([], 1)\n" +
   "   def grown2 = grown.append(2)\n" +
   "   def setting = values.get(\"mode\", list())\n" +
   "   return grown2.len + setting.len\n}\n")) &&
   is_ok(file_write(c_source,
   "void corpus_copy(char *dst, const char *src) {\n  strcpy(dst, src);\n" +
   "  if (1) { corpus_copy(dst, src); }\n" +
   "  const char *text = \"if (brace_like); { not_a_block }\";\n  /*\n" +
   "  extern fn fake_corpus_ffi() int\n  */\n" +
   "  int quotient = 8 / 0;\n  void *buffer = malloc(-1);\n}\n")) &&
   is_ok(file_write(h_source,
   "static inline char *corpus_read(char *buffer) {\n" +
   "  if (state == state) { return buffer; }\n  return gets(buffer);\n}\n")),
   "write frozen audit corpus")
def c = run_capture([fmt, "--audit", "--json", ny_source, c_source, h_source],
                    [], nil, false)
def embedded = run_capture(
   [ny, "fmt", "--audit", "--json", ny_source, c_source, h_source],
   [], nil, false)
def output = embedded.get("stdout", "")
assert(c.get("code", 127) == 0 && embedded.get("code", 127) == 0 &&
       c.get("stdout", "") == output, "frozen audit corpus parity")
for expected in ["NYAUD1102", "NYAUD1115", "NYAUD1118", "strcpy", "gets"] {
   assert(str.find(output, expected) >= 0, "corpus lacks " + expected)
}
assert(str.find(output, "fake_corpus_ffi") < 0,
       "commented fake extern is excluded")
def cleanup = run_capture([cmake, "-E", "rm", "-rf", dir], [], nil, false)
assert(cleanup.get("code", 127) == 0, "remove audit corpus directory")
print("FMT_AUDIT_CORPUS_PARITY_OK")
NY
}
