shape fmt_audit_overwrite_parity {
  family "probe/tools"
  generator "embedded"
  features ["formatter", "audit", "overwrite", "parity"]
  template ny-test-case
  flags "--native-only"
  timeout 60
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.subprocess (run_capture)
use core.str as str

def ny = env("NYTRIX_NY_FULL_BIN")
def fmt = env("NYTRIX_TEST_FMT_BIN")
def cmake = env("NYTRIX_CMAKE_COMMAND")
assert(is_str(ny) && is_str(fmt) && is_str(cmake),
       "CTest provides formatter executables")
def dir = temp_dir() + "/fmt-overwrite-" + to_str(pid())
def made = run_capture([cmake, "-E", "make_directory", dir], [], nil, false)
assert(made.get("code", 127) == 0, "create overwrite audit directory")
def path = dir + "/overwrite.ny"
assert(is_ok(file_write(path,
   "fn overwrite() {\n   x = 1\n   x = 2\n   y = 1\n" +
   "   consume(y)\n   y = 2\n   def z = 1\n   z = 2\n" +
   "   x = x + 1\n   open = make(1,\n   open = 2\n}\n")),
   "write overwrite audit source")
def c = run_capture([fmt, "--bugs", "--json", path], [], nil, false)
def embedded = run_capture([ny, "fmt", "--bugs", "--json", path], [], nil, false)
def output = embedded.get("stdout", "")
assert(c.get("code", 127) == 0 && embedded.get("code", 127) == 0 &&
       c.get("stdout", "") == output,
       "overwrite audit matches standalone C output: " + output)
assert(str.find(output, "NYAUD1117") >= 0 &&
       str.find(output, "assigned again before any intervening read") >= 0 &&
       str.find(output, "NYAUD1117:warning:3:") >= 0 &&
       str.find(output, "NYAUD1117:warning:11:") >= 0,
       "overwrite audit retains both intended findings: " + output)
mut count = 0
for line in str.split(output, "\n") {
   if str.find(line, "NYAUD1117:warning:") >= 0 { count += 1 }
}
assert(count == 2, "overwrite audit emits exactly two findings")
def cleanup = run_capture([cmake, "-E", "rm", "-rf", dir], [], nil, false)
assert(cleanup.get("code", 127) == 0, "remove overwrite audit directory")
print("FMT_AUDIT_OVERWRITE_PARITY_OK")
NY
}
