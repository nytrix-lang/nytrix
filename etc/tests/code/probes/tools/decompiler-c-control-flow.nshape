shape rev-decompiler-c-control-flow {
  suite "native"
  family "reverse-engineering"
  generator "deterministic"
  features [cfg dominators postdominators]
  timeout 60
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.dis.decomp.cfg as cfg

;; A diamond CFG with dynamically boxed addresses, matching the values produced
;; by decoded basic blocks without paying to compile or load a C executable.
def graph = {
   "entry": 0x1000,
   "nodes": [
      {"addr": 0x1000},
      {"addr": 0x1004},
      {"addr": 0x1008},
      {"addr": 0x100c}
   ],
   "edges": [
      {"from": 0x1000, "to": 0x1004},
      {"from": 0x1000, "to": 0x1008},
      {"from": 0x1004, "to": 0x100c},
      {"from": 0x1008, "to": 0x100c}
   ]
}

def post = cfg._cfg_postdominators_for_graph(graph)
def sets = post.get("postdominators", dict())
assert(post.get("converged", false), "postdominator fixed point converges")
assert(post.get("nodes", []).len == 4, "all synthetic graph nodes are retained")
assert(post.get("rounds", 0) > 0, "postdominator fixed point executes")
assert(sets.get("4096", []).len == 2,
   "entry postdominator set should contain itself and the join: " + str(sets))
assert(cfg._cfg_addr_has(sets.get("4096", []), 4108), "join address survives boxed/typed set matching")
def dom = cfg._cfg_dominators_for_graph(graph)
def dom_sets = dom.get("dominators", dict())
assert(dom.get("converged", false), "dominator fixed point converges")
assert(dom_sets.get("4108", []).len == 2, "join is dominated only by entry and itself")
assert(cfg._cfg_addr_has(dom_sets.get("4108", []), 4096), "entry address survives boxed/typed set matching")
print("✓ mixed-address CFG dominance regression passed")
NY
}
