shape fmt_operator_migration {
  family "probe/tools/fmt"
  features ["formatter", "operator-migration", "nshape-source"]
  template ny-test-case
  flags "--native-only"
  timeout 180
  expect compile_and_run
  source ny <<'TEST'
use core
use core.os.subprocess (run_capture)

def ny = env("NYTRIX_NY_FULL_BIN")
def cmake = env("NYTRIX_CMAKE_COMMAND")
assert(is_str(ny) && ny.len > 0, "test runner exports the full compiler")
assert(is_str(cmake) && cmake.len > 0, "CMake exposes its executable path")
def test_dir = temp_dir() + "/fmt-operator-migration-" + to_str(pid())
def setup = run_capture([cmake, "-E", "make_directory", test_dir], [], nil, false)
assert(setup.get("code", 127) == 0, "create operator migration directory")

fn migrate(str label, str path, str source, str expected, bool assume_legacy) {
   assert(is_ok(file_write(path, source)), label + " source write failed")
   mut argv = [ny, "fmt", "--migrate-operators"]
   if assume_legacy {
      argv = argv.append("--assume-legacy-operators")
   }
   argv = argv.append(path)
   def result = run_capture(argv, [], nil, false)
   assert(result.get("code", 127) == 0,
          label + " migration failed: " + result.get("stdout", ""))
   def actual = unwrap(file_read(path))
   assert(actual == expected,
          label + " migration changed source incorrectly:\n" + actual +
          "\nexpected:\n" + expected)
}

def legacy = test_dir + "/legacy-operators.ny"
migrate("legacy", legacy,
   "def power = 2 ^ 5\ndef xor = 6 ^^ 3\ndef text = \"2 ^ 5; 6 ^^ 3\"\n" +
   ";; keep ^ and ^^ in comments\nmut value = 2\nvalue ^= 4\nvalue ^^= 1\n",
   "def power = 2 ** 5\ndef xor = 6 ^ 3\ndef text = \"2 ^ 5; 6 ^^ 3\"\n" +
   ";; keep ^ and ^^ in comments\nmut value = 2\nvalue **= 4\nvalue ^= 1\n",
   true)

def conservative = test_dir + "/modern-xor-only.ny"
migrate("conservative", conservative,
   "def xor = 6 ^ 3\ndef power_alias = 2 ^^ 3\n",
   "def xor = 6 ^ 3\ndef power_alias = 2 ^^ 3\n", false)

def modern = test_dir + "/mixed-modern-operators.ny"
migrate("modern", modern,
   "def power = 2 ** 5\ndef xor = 6 ^ 3\ndef legacy_xor = 6 ^^ 3\n" +
   "mut value = 2\nvalue ^= 4\nvalue ^^= 1\n",
   "def power = 2 ** 5\ndef xor = 6 ^ 3\ndef legacy_xor = 6 ^^ 3\n" +
   "mut value = 2\nvalue ^= 4\nvalue ^^= 1\n", true)

def shape = test_dir + "/legacy-operators.nshape"
def shape_source = """
shape legacy {
  family "probe-suite"
  generator "stress"
  features ["ny", "lang"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
def power = 2 ^ 5
def xor = 6 ^^ 3
NY
}
shape modern {
  family "probe-suite"
  generator "stress"
  features ["ny", "lang"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
def power = 2 ** 5
def xor = 6 ^ 3
def alias = 2 ^^ 5
NY
}
"""
def migrated_shape = """
shape legacy {
  family "probe-suite"
  generator "stress"
  features ["ny", "lang"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
def power = 2 ** 5
def xor = 6 ^ 3
NY
}
shape modern {
  family "probe-suite"
  generator "stress"
  features ["ny", "lang"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
def power = 2 ** 5
def xor = 6 ^ 3
def alias = 2 ^^ 5
NY
}
"""
migrate("shape", shape, shape_source, migrated_shape, true)

def cleanup = run_capture([cmake, "-E", "rm", "-rf", test_dir], [], nil, false)
assert(cleanup.get("code", 127) == 0, "remove operator migration directory")
print("FMT_OPERATOR_MIGRATION_OK")
TEST
}
