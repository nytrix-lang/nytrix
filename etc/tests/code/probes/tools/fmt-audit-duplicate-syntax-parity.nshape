shape fmt_audit_duplicate_syntax_parity {
  family "probe/tools"
  generator "embedded"
  features ["formatter", "audit", "duplicate-syntax", "parity"]
  template ny-test-case
  flags "--native-only"
  timeout 60
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.subprocess (run_capture)
use core.str as str

def ny = env("NYTRIX_NY_FULL_BIN")
def fmt = env("NYTRIX_TEST_FMT_BIN")
def cmake = env("NYTRIX_CMAKE_COMMAND")
assert(is_str(ny) && is_str(fmt) && is_str(cmake),
       "CTest provides formatter executables")
def dir = temp_dir() + "/fmt-duplicate-syntax-" + to_str(pid())
def made = run_capture([cmake, "-E", "make_directory", dir], [], nil, false)
assert(made.get("code", 127) == 0, "create duplicate syntax directory")
def path = dir + "/duplicate-syntax.ny"
assert(is_ok(file_write(path,
   "fn duplicate_syntax() {\n   def first = {\n      \"key\": 1,\n" +
   "      \"key\": 2,\n      \"nested\": {\"key\": 3},\n" +
   "      \"nested\": {\"other\": 4}\n   }\n   def second = {\n" +
   "      \"key\": 5\n   }\n" +
   "   def text = \"\\\"key\\\": 9, case mode { 1 -> fake() }\"\n" +
   "   ;; \"key\": 10\n   case mode {\n      1 -> first\n" +
   "      1 -> second\n      2, 3 -> grouped\n   }\n" +
   "   case other {\n      1 -> separate_case\n   }\n}\n")),
   "write duplicate syntax source")
def c = run_capture([fmt, "--bugs", "--json", path], [], nil, false)
def embedded = run_capture([ny, "fmt", "--bugs", "--json", path], [], nil, false)
def output = embedded.get("stdout", "")
assert(c.get("code", 127) == 0 && embedded.get("code", 127) == 0 &&
       c.get("stdout", "") == output,
       "duplicate syntax audit matches standalone C output: " + output)
for expected in ["NYAUD1113", "NYAUD1114", "duplicate dictionary key",
                 "also appears on line", "case arm"] {
   assert(str.find(output, expected) >= 0,
          "duplicate syntax finding missing " + expected + ": " + output)
}
assert(str.find(output, "also appears on line 10") < 0,
       "duplicate-key finding does not cross dictionary scope")
def cleanup = run_capture([cmake, "-E", "rm", "-rf", dir], [], nil, false)
assert(cleanup.get("code", 127) == 0, "remove duplicate syntax directory")
print("FMT_AUDIT_DUPLICATE_SYNTAX_PARITY_OK")
NY
}
