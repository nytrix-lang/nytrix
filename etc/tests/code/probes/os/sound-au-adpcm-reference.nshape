shape au_adpcm_ffmpeg_reference {
  family "runtime/system/sound"
  generator "embedded"
  features ["sound", "au", "adpcm", "reference"]
  template ny-test-case
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_and_run
  source ny <<'NY'
use core
use core.math.bin as bin
use core.os.sound.au as au

;; FFmpeg 63.1.102 s16le output for the deterministic 120-byte payload below.
def references = [
"",
"",
"",
""
]
fn be32(bytes d, int at, int v) {
   mut i = 0
   while i < 4 { store8(d, (v >> ((3 - i) * 8)) & 255, at + i) i += 1 }
}
mut encoding = 23
while encoding <= 26 {
   def rate = encoding == 24 ? 16000 : 8000
   def data = bytes(144)
   store8(data, 46, 0)
   store8(data, 115, 1)
   store8(data, 110, 2)
   store8(data, 100, 3)
   be32(data, 4, 24)
   be32(data, 8, 120)
   be32(data, 12, encoding)
   be32(data, 16, rate)
   be32(data, 20, 1)
   mut i = 0
   while i < 120 { store8(data, ((i * 73) ^ (i >> 1) ^ 127) & 255, 24 + i) i += 1 }
   def expected = bin.base64_to_bytes(str(references[encoding - 23]))
   def src = au.decode_bytes(data)
   assert(is_list(src), "AU ADPCM source decodes")
   def meta = src.get(1)
   assert(int(meta.get("len")) == expected.len && int(meta.get("total_frames")) == expected.len / 2,
      "AU ADPCM exact PCM frame count")
   assert(int(meta.get("rate")) == rate && int(meta.get("channels")) == 1, "AU ADPCM metadata")
   i = 0
   while i < expected.len {
      assert(load8(meta.get("ptr"), i) == int(expected[i]), "AU ADPCM PCM matches FFmpeg")
      i += 1
   }
   free(meta.get("ptr"))
   be32(data, 8, 121)
   assert(au.decode_bytes(data) == 0, "AU ADPCM rejects truncated declared payload")
   encoding += 1
}
print("AU-ADPCM-REFERENCE-OK")
NY
}
