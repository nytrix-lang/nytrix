shape render-camera-contract {
  family "probe-suite"
  generator "stress"
  features ["ny", "sys", "render"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.ui.render as camera
use core.os.ui.render.matrix as matrix

def cam = camera.camera_init([8.0, 6.0, 11.0], -144.0, -18.0)
assert(is_list(cam), "camera is positional list")
assert(len(cam) >= 7, "camera has projection fields")
assert(cam.get(0).len == 3, "camera position is vec3")
assert(cam.get(1).len == 3, "camera target is vec3")
def view = matrix.mat4_look_at(cam.get(0), cam.get(1), cam.get(2))
assert(len(view) >= 18 && view.get(17) == 1.0, "camera vectors build look-at matrix")
assert(view.get(2) != 0.0 || view.get(6) != 0.0 || view.get(10) != 0.0, "camera side basis is not degenerate")
print("RENDER_CAMERA_CONTRACT_OK target=" + to_str(cam.get(1)))
NY
}
