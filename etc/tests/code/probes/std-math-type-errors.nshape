shape std_math_type_errors {
  family "probe-suite"
  generator "stress"
  features ["ny", "compiler"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core.math
fn bad_math_return(int: x) f64 {
   sqrt(x)
}
assert(bad_math_return(9) == 3.0, "sqrt accepts an integer and returns f64")
0
NY
}
