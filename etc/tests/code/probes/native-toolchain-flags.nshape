shape args-accept-native {
  family "runtime/system/args"
  generator "embedded"
  features ["args", "cli", "positive", "native"]
  template ny-test-case

  # These are argument acceptance checks, not backend behavior tests. Keep
  # alternative values in separate rows, and combine independent switches.
  flags_matrix "--native-backend=llvm --native-tier=baseline --native-hot-threshold=5 --native-cold-threshold=1000 --native-cache-score=9 --native-prefer-vm --native-enable-cf-mem2reg --native-tier-budget=50 --accel-target=none --dwarf-version=4 --gpu=off --gpu-min-work=1 --std-builtin-ops; --native-prefer-asm --gpu=auto"
  source ny <<'NY'
use core
def int a = 13
def int b = 8
assert_eq(a - b, 5, "native flag arithmetic")
print("args native toolchain flags passed")
NY
}
