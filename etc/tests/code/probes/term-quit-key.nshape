shape test_term_quit_key {
  family "native/backend"
  generator "embedded"
  features ["ny", "test"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.term
use core.os (file_exists)

assert_eq(is_quit_key(27), true)
assert_eq(is_quit_key(3), true)
assert_eq(is_quit_key(0), false)
assert_eq(is_quit_key(113), false)
assert_eq(file_exists("."), true)
NY
}
