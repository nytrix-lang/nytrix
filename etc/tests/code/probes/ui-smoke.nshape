defaults {
  family "runtime-native"
  generator "native"
  template ny-test-case
  flags "--native-only --native-backend=x86_64 --native-tier=baseline -emit-only --no-progress --color=never"
  expect compile_and_run
}

shape ui_native_animation {
  features [native ui animation x86_64]
  estimate_ms 103000
  timeout 180
  flags "--native-only --native-backend=x86_64 --native-tier=baseline -emit-only -o /tmp/nytrix-ui-animation.o --no-progress --color=never"
  source ny file "etc/projects/ui/animation.ny"
}

shape ui_native_editor {
  features [native ui editor x86_64]
  estimate_ms 112000
  timeout 180
  flags "--native-only --native-backend=x86_64 --native-tier=baseline -emit-only -o /tmp/nytrix-ui-editor.o --no-progress --color=never"
  source ny file "etc/projects/ui/editor.ny"
}

shape ui_native_engine {
  features [native ui engine x86_64]
  estimate_ms 117000
  timeout 300
  flags "--native-only --native-backend=x86_64 --native-tier=baseline -emit-only -o /tmp/nytrix-ui-engine.o --no-progress --color=never"
