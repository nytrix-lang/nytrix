shape test_inferred_scalar_abi {
  family "runtime/language"
  generator "embedded"
  features ["ny", "test"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core

;; PERF-E / NEWT-08: Inferred scalar integer and float ABI propagation
fn add_inferred(a, b) {
   a + b + 0
}

fn bitwise_inferred(a, b) {
   (a ^ b) + 1
}

fn mul_inferred_f64(x, y) {
   x * y * 1.0
}

fn poly_eval(x, a, b, c) {
   a * x * x + b * x + c + 0.0
}

fn f_recurse(x, n) {
   if n <= 0 {
      1.0
   } else {
      x * f_recurse(x, n - 1)
   }
}

;; Verify scalar int propagation
assert_eq(add_inferred(10, 25), 35, "inferred int addition")
assert_eq(bitwise_inferred(15, 7), 9, "inferred bitwise int")

;; Verify scalar float propagation
assert_eq(mul_inferred_f64(2.5, 4.0), 10.0, "inferred float multiplication")

;; Verify multi-arg scalar float polynomial
assert_eq(poly_eval(3.0, 2.0, 5.0, 1.0), 34.0, "inferred polynomial f64")

;; Verify recursive float
assert_eq(f_recurse(2.0, 3), 8.0, "recursive inferred float power")
NY
}
