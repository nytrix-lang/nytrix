use std.core
use std.math.big

def a0 = bf_from_int(-324407729)
def b0 = bf_from_int(856638038)
assert(bf_eq(bf_add(a0, b0), bf_from_int(532230309)), "add 0")
assert(bf_eq(bf_sub(a0, b0), bf_from_int(-1181045767)), "sub 0")
assert(bf_eq(bf_mul(a0, b0), bf_from_int(-277900000482595702)), "mul 0")
def q0 = bf_to_float(bf_div(a0, b0))
assert(q0 >= -0.3786987205907847 - 1e-12 && q0 <= -0.3786987205907847 + 1e-12, "div 0")
