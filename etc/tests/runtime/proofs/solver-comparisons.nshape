shape proof_solver_comparisons {
  family "runtime/proofs"
  generator "program"
  features ["proof", "solver", "comparison", "soundness"]
  template ny-test-case
  flags "--proof-solver=presburger --color=never"
  expect compile_and_run
  source ny <<'NY'
use std.core

;; Every true comparison form must be accepted by the Presburger path.
assert_compile(5 < 6, "5 < 6")
assert_compile(5 >= 4, "5 >= 4")
assert_compile(5 == 5, "5 == 5")
assert(true, "solver comparisons accepted")
NY
}
