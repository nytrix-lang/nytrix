shape diff_call_arity {
  family "runtime-native"
  generator "native"
  features [native x86_64 nyir vm differential call arity stack-args]
  template ny-test-case
  ; Merges former call0..call7 native/vm pairs (16 files) into one matrix.
  flags_matrix "--native-backend x86_64; --nyir-run"
  expect compile_and_run
  source ny <<'NY'
fn a0() i64 { 42 }
fn a1(i64 a) i64 { a }
fn a2(i64 a, i64 b) i64 { a + b }
fn a3(i64 a, i64 b, i64 c) i64 { a + b + c }
fn a4(i64 a, i64 b, i64 c, i64 d) i64 { a + b + c + d }
fn a5(i64 a, i64 b, i64 c, i64 d, i64 e) i64 { a + b + c + d + e }
fn a6(i64 a, i64 b, i64 c, i64 d, i64 e, i64 f) i64 {
  a + b + c + d + e + f
}
fn a7(i64 a, i64 b, i64 c, i64 d, i64 e, i64 f, i64 g) i64 {
  a + b + c + d + e + f + g
}
; 42+42+3+6+10+15+21+28 = 167
a0() + a1(42) + a2(1, 2) + a3(1, 2, 3) + a4(1, 2, 3, 4) +
  a5(1, 2, 3, 4, 5) + a6(1, 2, 3, 4, 5, 6) + a7(1, 2, 3, 4, 5, 6, 7)
NY
}
