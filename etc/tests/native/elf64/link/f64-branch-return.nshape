shape x86_64_elf64_object_link_run_f64_branch_return {
  family "runtime-native"
  generator "native"
  features [native object elf64 x86_64 nyir link-run machine-ir f64 cfg]
  template ny-test-case
  flags "--native-backend x86_64 -emit-only -o /tmp/nytrix-link-run-f64-branch-return.o"
  expect object_link_run_f64_2.0
  source ny <<'NY'
fn choose(int a, f64 left, int b, f64 right) f64 {
  if a < b { left } else { right }
}
choose(1, 2.0, 3, 4.0)
NY
}
