shape x86_64_elf64_object_link_run_unused_leading_f64 {
  family "runtime-native"
  generator "native"
  features [native object elf64 x86_64 nyir link-run]
  template ny-test-case
  flags "--native-backend x86_64 -emit-only -o /tmp/nytrix-link-run-unused-leading-f64.o"
  expect object_link_run_f64_3.75
  source ny <<'NY'
fn pick(f64 unused, f64 value) f64 {
  value
}
pick(1.25, 3.75)
NY
}
