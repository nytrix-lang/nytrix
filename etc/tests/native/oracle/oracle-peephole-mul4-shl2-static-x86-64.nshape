shape oracle_peephole_mul4_shl2_static_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle peephole mul-to-shl mul4 regression]
  template ny-test-case
  flags "--native-result-oracle=100 -O2"
  expect compile_and_run
  source ny <<'NY'
use std.core

; 25 * 4 = 100
fn quad(i64 x) i64 { x * 4 }
quad(25)
NY
}
