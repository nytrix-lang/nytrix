shape oracle_peephole_mul16_shl4_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle peephole mul-to-shl mul16 regression]
  template ny-test-case
  flags "--native-result-oracle=96 -O2"
  expect compile_and_run
  source ny <<'NY'
use std.core

; 6 * 16 = 96
fn hex(i64 x) i64 { x * 16 }
hex(6)
NY
}
