shape oracle_closed_form_accumulator_init_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle loop ivelim closed-form non-zero-init regression]
  template ny-test-case
  flags "--native-result-oracle=35 -O3"
  expect compile_and_run
  source ny <<'NY'
use std.core

mut s = 0
mut i = 5
while i < 10 {
  s = s + i
  i = i + 1
}
s
NY
}
