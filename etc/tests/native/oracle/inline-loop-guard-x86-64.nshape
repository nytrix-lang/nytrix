shape oracle_inline_loop_guard_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle inline loop guard regression]
  template ny-test-case
  flags_matrix "-O2 --native-result-oracle; -O3 --native-result-oracle"
  expect compile_and_run
  source ny <<'NY'
fn main() int {
  mut a = 0
  mut b = 1
  mut i = 0
  while i < 10 {
    mut t = a + b
    a = b
    b = t
    i = i + 1
  }
  a
}
NY
}
