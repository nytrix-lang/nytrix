shape oracle_sccp_divergent_phi_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle nyir sccp executable-edge divergent-phi]
  template ny-test-case
  flags_matrix "-O2 --native-enable-cf-mem2reg --native-result-oracle=16; -O3 --native-enable-cf-mem2reg --native-result-oracle=16"
  expect compile_and_run
  source ny <<'NY'
fn branch_value(i64 x) i64 {
  if x < 0 {
    x = 7
  } else {
    x = 9
  }
  x
}

branch_value(-3) + branch_value(4)
NY
}
