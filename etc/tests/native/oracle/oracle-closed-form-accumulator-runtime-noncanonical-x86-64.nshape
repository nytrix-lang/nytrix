shape oracle_closed_form_accumulator_runtime_noncanonical_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle loop ivelim closed-form runtime-init-step regression]
  template ny-test-case
  flags "--native-result-oracle=26 -O3"
  expect compile_and_run
  source ny <<'NY'
use std.core

fn sum_to_stride(n) i64 {
  mut s = 0
  mut i = 2
  while i < n {
    s = s + i
    i = i + 3
  }
  s
}

sum_to_stride(12)
NY
}
