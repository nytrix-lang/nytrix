shape oracle_loop_vec8_array_sum_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle loop vec8 i64 vectorizer regression]
  template ny-test-case
  flags_matrix "-O2 --native-result-oracle; -O3 --native-result-oracle"
  expect compile_and_run
  source ny <<'NY'
use std.core

fn vec8_loop() i64 {
  mut i = 0
  mut sum = 0
  while i < 8 {
    sum = sum + i
    i = i + 1
  }
  sum
}

vec8_loop()
NY
}
