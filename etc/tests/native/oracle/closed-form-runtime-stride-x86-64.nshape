shape oracle_closed_form_runtime_stride_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle closed form runtime bound noncanonical stride]
  template ny-test-case
  flags_matrix "-O2 --native-result-oracle; -O3 --native-result-oracle"
  expect compile_and_run
  source ny <<'NY'
use std.core

fn sum_to_stride(n) i64 {
  mut s = 0
  mut i = 2
  while i <= n {
    s = s + i
    i = i + 3
  }
  s
}

sum_to_stride(11)
NY
}
