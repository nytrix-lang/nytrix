shape oracle_peephole_mul2_shl1_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle peephole mul-to-shl mul2 regression]
  template ny-test-case
  flags "--native-result-oracle=84 -O2"
  expect compile_and_run
  source ny <<'NY'
use std.core

; 42 * 2 = 84
fn double(i64 x) i64 { x * 2 }
double(42)
NY
}
