shape oracle_closed_form_runtime_offset_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle loop ivelim closed-form runtime offset regression]
  template ny-test-case
  flags "--native-result-oracle=65 -O3"
  expect compile_and_run
  source ny <<'NY'
use std.core

; s = sum(2 + i) for i in [0,10) = 20 + 45 = 65
fn offset(n) i64 {
  mut s = 0
  mut i = 0
  while i < n {
    s = s + 2 + i
    i = i + 1
  }
  s
}
offset(10)
NY
}
