shape oracle_loop_vector_reduction_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle loop vector reduction phi regression]
  template ny-test-case
  flags_matrix "-O2 --native-result-oracle; -O3 --native-result-oracle"
  expect compile_and_run
  source ny <<'NY'
use std.core

fn sum_heap() i64 {
  def src = malloc(64)
  store64_i(src, 1, 0)
  store64_i(src, 2, 8)
  store64_i(src, 3, 16)
  store64_i(src, 4, 24)
  store64_i(src, 5, 32)
  store64_i(src, 6, 40)
  store64_i(src, 7, 48)
  store64_i(src, 8, 56)
  mut i = 0
  mut sum = 0
  while i < 8 {
    def v = load64_i(src, i * 8)
    sum = sum + v
    i = i + 1
  }
  free(src)
  sum
}

sum_heap()
NY
}
