shape oracle_closed_form_accumulator_canonical_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle loop ivelim closed-form accumulator regression]
  template ny-test-case
  flags "--native-result-oracle=4950 -O3"
  expect compile_and_run
  source ny <<'NY'
use std.core

mut s = 0
mut i = 0
while i < 100 {
  s = s + i
  i = i + 1
}
s
NY
}
