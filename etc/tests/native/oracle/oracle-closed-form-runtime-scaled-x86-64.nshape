shape oracle_closed_form_runtime_scaled_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle loop ivelim closed-form runtime scaled regression]
  template ny-test-case
  flags "--native-result-oracle=135 -O3"
  expect compile_and_run
  source ny <<'NY'
use std.core

; s = sum(i * 3) for i in [0,10) = 3 * 45 = 135
fn scaled(n) i64 {
  mut s = 0
  mut i = 0
  while i < n {
    s = s + i * 3
    i = i + 1
  }
  s
}
scaled(10)
NY
}
