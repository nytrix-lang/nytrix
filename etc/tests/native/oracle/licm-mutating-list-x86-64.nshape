shape oracle_licm_mutating_list_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle nyir licm alias list mutation]
  template ny-test-case
  flags_matrix "-O1 --native-result-oracle=0; -O2 --native-result-oracle=0; -O3 --native-result-oracle=0"
  expect compile_and_run
  source ny <<'NY'
fn product_sum() i64 {
  mut a = []
  mut b = []
  mut c = []
  mut i = 0
  while i < 16 {
    a = append(a, i + 1)
    b = append(b, i + 3)
    c = append(c, 0)
    i += 1
  }
  i = 0
  while i < 16 {
    c[i] = a[i] * b[i]
    i += 1
  }
  c[0] + c[15]
}
if product_sum() == 291 { 0 } else { 1 }
NY
}
