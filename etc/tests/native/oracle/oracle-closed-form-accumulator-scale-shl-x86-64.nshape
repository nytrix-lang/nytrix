shape oracle_closed_form_accumulator_scale_shl_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle loop ivelim closed-form scale-shl regression]
  template ny-test-case
  flags "--native-result-oracle=180 -O3"
  expect compile_and_run
  source ny <<'NY'
use std.core

mut s = 0
mut i = 0
while i < 10 {
  s = s + (i << 2)
  i = i + 1
}
s
NY
}
