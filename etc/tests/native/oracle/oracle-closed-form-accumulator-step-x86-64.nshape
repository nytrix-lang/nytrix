shape oracle_closed_form_accumulator_step_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle loop ivelim closed-form step-two regression]
  template ny-test-case
  flags "--native-result-oracle=2450 -O3"
  expect compile_and_run
  source ny <<'NY'
use std.core

mut s = 0
mut i = 0
while i < 100 {
  s = s + i
  i = i + 2
}
s
NY
}
