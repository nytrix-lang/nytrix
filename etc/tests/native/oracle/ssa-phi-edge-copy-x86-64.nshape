shape oracle_ssa_phi_edge_copy_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle ssa phi edge-copy parallel-copy loop regression]
  template ny-test-case
  flags_matrix "-O2 --nyir-verify --native-result-oracle=21; -O3 --nyir-verify --native-result-oracle=21"
  expect compile_and_run
  source ny <<'NY'
mut a = 1
mut b = 2
mut i = 0
while i < 5 {
  def t = a
  a = b
  b = t
  i = i + 1
}
a * 10 + b
NY
}
