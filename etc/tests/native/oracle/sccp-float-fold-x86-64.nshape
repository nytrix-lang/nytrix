shape oracle_sccp_float_fold_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle nyir sccp f64 f32 constant-fold]
  template ny-test-case
  flags_matrix "-O0 --native-result-oracle=1; -O1 --native-result-oracle=1; -O2 --native-enable-cf-mem2reg --native-result-oracle=1; -O3 --native-enable-cf-mem2reg --native-result-oracle=1"
  expect compile_and_run
  source ny <<'NY'
fn sccp_floats() bool {
  def a = 1.5
  def b = 2.5
  def c = a + b
  def d = c * 2.0
  def e = d - 1.0
  e > 6.0
}

sccp_floats()
NY
}
