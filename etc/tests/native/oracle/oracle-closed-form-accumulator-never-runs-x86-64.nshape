shape oracle_closed_form_accumulator_never_runs_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle loop ivelim closed-form never-runs regression]
  template ny-test-case
  flags "--native-result-oracle=0 -O3"
  expect compile_and_run
  source ny <<'NY'
use std.core

mut s = 0
mut i = 0
while i > 5 {
  s = s + i
  i = i + 1
}
s
NY
}
