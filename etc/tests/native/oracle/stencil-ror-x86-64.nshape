shape oracle_stencil_ror_x86_64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 stencil peephole ror regression]
  template ny-test-case
  flags "-O1 --native-tier=stencil --native-result-oracle=-1224658842671273011"
  expect compile_and_run
  source ny <<'NY'
use std.core

fn rotate_right_8(i64 x) i64 {
  (x >> 8) | (x << 56)
}

rotate_right_8(0x0123456789abcdef)
NY
}
