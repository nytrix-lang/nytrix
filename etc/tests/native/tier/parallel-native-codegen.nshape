shape parallel_native_codegen {
  family "runtime-native"
  generator "native"
  features [native parallel cse constfold peephole object codegen]
  template ny-test-case
  flags "--native-only --native-backend=x86_64 -O2 --parallel=threads --threads=4 --parallel-min-work=1 -emit-only -o /tmp/nytrix-parallel-native.o --no-progress --color=never"
  expect compile_and_run
  source ny <<'NY'
