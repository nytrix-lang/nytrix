shape nyir_pass_control_stop {
  family "runtime-native"
  generator "native"
  features [native nyir optimizer pass-control stop-after]
  template ny-test-case
  flags "--native-backend=x86_64 --native-only --nyir-stop-after=const_fold -O3 --native-result-oracle=0"
  expect compile_and_run
  source ny <<'NY'
mut x = 1
x = 2
if x == 2 { 0 } else { 1 }
NY
}
