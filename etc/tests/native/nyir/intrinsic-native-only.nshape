shape intrinsic_native_only_rejected {
  family "runtime-native"
  generator "native"
  features [native nyir intrinsic negative explicit-lowering]
  template ny-test-case
  flags "--native-only --native-backend=x86_64"
  expect compile_fail
  expect_message "intrinsic(...) is not supported by the Nytrix-owned native backend"
  source ny <<'NY'
intrinsic("ctpop.i64", 7)
NY
}
