shape cross_module_dict_global {
  family "runtime-native"
  generator "native"
  features [native nyir x86_64 modules mut globals dict]
  template ny-test-case
  flags "--native-only --native-backend=x86_64 -O3 --no-progress --color=never"
  expect compile_and_run
  source ny <<'NY'
module demo(state) {
  mut state = dict(4)
  fn write() int {
    state.set("x", 7)
    state.get("x", 0)
  }
}
print(demo.write())
NY
}
