shape nyir_verify_each_optimization_pass {
  family "runtime-native"
  generator "native"
  features [native nyir verifier optimizer cfg ssa]
  template ny-test-case
  flags "--native-backend=x86_64 --native-only --nyir-verify -O3 --native-result-oracle=43"
  expect compile_and_run
  source ny <<'NY'
mut x = 6
mut y = 7
if x < y {
  x = x * y
} else {
  x = x - y
}
x + 1
NY
}
