shape module-constant-reexport {
  family "native-nyir"
  generator "regression"
  features ["ny", "native", "std"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use std.core
use std.os.ui.render.compute as base_compute
use std.os.ui.render.vk.compute as comp

assert(base_compute.COMPUTE_FEATURE_REFRACTION == 1, "direct module constant")
assert(comp.COMPUTE_FEATURE_REFRACTION == 1, "re-exported module constant")
assert(comp.COMPUTE_FEATURE_MESH_INSTANCING == 32, "re-exported module constant tail")
print("module_constant_reexport ok")
NY
}
