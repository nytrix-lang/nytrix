shape nyir_extern_multi {
  family "runtime-native"
  generator "native"
  features ["native", "nyir", "extern", "call", "multi"]
  template ny-test-case
  flags "--native-backend x86 -no-std -emit-only -o /tmp/nytrix-extern-multi.o"
  link "etc/tests/native/nyir/extern-functions.a"
  expect object_link_run_i64_11
ci windows-skip
  source ny <<'NY'
extern "c" {
  fn add(i64 a, i64 b) i64
  fn mul(i64 a, i64 b) i64
  fn neg(i64 a) i64
}
add(mul(3, 4), neg(1))
NY
}
