shape nyir_for_c_style {
  family "runtime-native"
  generator "native"
  features ["native", "nyir", "for", "c-style", "continue", "scope", "vm"]
  template ny-test-case
  flags "--nyir-run"
  expect compile_and_run
  source ny <<'NY'
mut sum = 0
for mut i = 0 i < 6 ++i {
  if i == 2 { continue }
  sum += i
}
sum
NY
}
