shape nyir_metadata_bin_bad_effect {
  family "runtime-native"
  generator "native"
  features ["native", "nyir", "metadata", "binary", "negative"]
  template ny-test-case
  flags "--nyir-metadata-bin=etc/tests/native/fixtures/nyir-bad-effect.nyir"
  expect compile_fail
  expect_message "effect mask does not match opcode effects"
  source ny <<'NY'
1 + 2
NY
}
