shape nyir_inspect_user_scope {
  family "runtime-native"
  generator "native"
  features [native nyir inspect dump optimizer user-scope]
  template ny-test-case
  flags_matrix "-O3 --inspect --native-result-oracle=5; -O3 --dump --native-result-oracle=5; -O3 --inspect-runtime --native-result-oracle=5"
  expect compile_and_run
  source ny <<'NY'
fn user_add(int a, int b) int { a + b }
user_add(2, 3)
NY
}
