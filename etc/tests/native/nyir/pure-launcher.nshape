shape nyir_const_fold_native {
  family "runtime-native"
  generator "native"
  features ["native", "x86_64", "const-fold", "o3"]
  template ny-test-case
  ; Booleanized result keeps the process exit status successful while retaining
  ; the exact arithmetic check in both VM and native paths.
  flags "--native-only --native-backend=x86_64 -O3 --native-result-oracle=0 --no-progress --color=never"
  expect compile_and_run
  source ny <<'NY'
if 1 + 2 * 20 + 2 == 43 { 0 } else { 1 }
NY
}
