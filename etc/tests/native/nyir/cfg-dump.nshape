shape nyir_cfg_dump {
  family "runtime-native"
  generator "native"
  features [native nyir cfg dump control-flow]
  template ny-test-case
  flags "-emit-only --nyir-dump --nyir-dump-cfg"
  expect compile_and_run
  source ny <<'NY'
fn abs_next(i64 x) i64 {
  if x < 0 {
    x = -x
  } else {
    x = x + 1
  }
  x * 2
}

abs_next(2)
NY
}
