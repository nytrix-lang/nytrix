shape native_list_string_any_boundary {
  family "runtime-native"
  generator "native"
  features ["native", "nyir", "x86_64", "list", "string", "any", "tag", "length", "index"]
  template ny-test-case
  flags "--native-only --native-backend=x86_64 -O3 --nyir-verify --native-result-oracle=0 --no-progress --color=never"
  expect compile_and_run
  source ny <<'NY'
fn inspect(list paths) int {
  def raw = paths[1]
  if !is_str(raw) { return 90 }
  raw.len - 5
}

inspect(["a", "hello", "xyz"])
NY
}
