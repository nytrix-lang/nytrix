shape optcheck_loop_interchange_legality {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle optcheck loop interchange pass-fires negative-path]
  template ny-test-case
  flags "-O3 --native-backend x86_64 --native-oracle-per-pass --native-result-oracle=24 --nyir-pass-stats"
  expect compile_and_run
  source ny <<'NY'
fn rectangular_nest() i64 {
  mut sum = 0
  for i in 0..2 { for j in 0..4 { sum = sum + 1 } }
  sum
}
fn dependent_nest() i64 {
  mut sum = 0
  for i in 0..2 { for j in 0..4 { sum = sum + i + j } }
  sum
}
rectangular_nest() + dependent_nest()
NY
}
