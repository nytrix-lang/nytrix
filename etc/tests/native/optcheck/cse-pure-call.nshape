shape optcheck_cse_pure_call {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle optcheck cse pure-call]
  template ny-test-case
  flags "-O3 --native-backend x86_64 --native-oracle-per-pass --native-result-oracle=13944 --nyir-pass-stats"
  expect compile_and_run
  source ny <<'NY'
use std.core
mut sum = 0
for i in 0..1000 {
  sum = sum + min(i, 7) + min(i, 7)
}
print(sum)
NY
}
