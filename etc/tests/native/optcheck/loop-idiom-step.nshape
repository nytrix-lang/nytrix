shape optcheck_loop_idiom_step {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle optcheck loop idiom positive-step]
  template ny-test-case
  flags "-O3 --native-backend x86_64 --native-oracle-per-pass --native-result-oracle=40 --nyir-pass-stats"
  expect compile_and_run
  source ny <<'NY'
fn step_two() i64 {
  mut sum = 0
  mut i = 0
  while i < 10 {
    sum = sum + i * 2
    i = i + 2
  }
  sum
}
step_two()
NY
}
