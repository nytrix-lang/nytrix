shape optcheck_vector_f64 {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle f64 vector optcheck]
  template ny-test-case
  flags "-O2 --native-backend x86_64 --native-result-oracle=-104.124411"
  expect compile_and_run
  source ny <<'NY'
use std.core
mut sum = 0.0
for i in 1..1000 {
   def a = f64(i) * 0.001
   def b = f64(i % 37) * 0.027
   sum = sum + a * b - a / (b + 1.0)
}
sum
NY
}
