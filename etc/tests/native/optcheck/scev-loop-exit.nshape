shape optcheck_scev_loop_exit {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle optcheck scev loop-exit]
  template ny-test-case
  flags "-O3 --native-backend x86_64 --native-oracle-per-pass --native-result-oracle=49995000 --nyir-pass-stats"
  expect compile_and_run
  source ny <<'NY'
mut sum = 0
mut i = 0
while i < 10000 {
  sum += i
  i += 1
}
sum
NY
}
