shape optcheck_loop_peel {
  family "runtime-native"
  generator "native"
  features [native x86_64 oracle optcheck loop peel first-iteration-guard noncanonical-rejection]
  template ny-test-case
  flags "-O3 --native-backend x86_64 --nyir-verify --native-oracle-per-pass --native-result-oracle=31 --nyir-pass-stats"
  expect compile_and_run
  source ny <<'NY'
fn first_iteration_guard(i64 n) i64 {
  mut i = 0
  mut sum = 0
  while i < n {
    if i == 0 {
      sum = sum + 17
    } else {
      sum = sum + i
    }
    i = i + 1
  }
  sum
}

fn noncanonical_stride() i64 {
  mut i = 0
  mut step = 1
  mut sum = 0
  while i < 5 {
    sum = sum + i
    i = i + step
    step = step + 1
  }
  sum
}

first_iteration_guard(5) + noncanonical_stride()
NY
}
