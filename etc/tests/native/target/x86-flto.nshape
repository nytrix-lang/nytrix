shape native_x86_64_flto_whole_program {
  family "runtime-native"
  generator "native"
  features [native x86_64 nyir whole-program lto inline]
  template ny-test-case
  flags "--native-backend x86_64 -O0 -flto --native-result-oracle=42"
  expect compile_and_run
  source ny <<'NY'
fn seed(i64 value) i64 { value + 1 }
fn answer(i64 value) i64 { seed(value) * 2 }
answer(20)
NY
}
