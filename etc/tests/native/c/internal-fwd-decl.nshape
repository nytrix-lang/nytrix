shape internal_fwd_decl {
  family "runtime-native"
  generator "native"
  template ny-test-case
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-internal-fwd-decl.o"
  link "etc/tests/native/c/fwd_decl.a"
  expect object_link_run_i64_0
ci windows-skip
  source ny <<'NY'
extern "c" {
  fn take_fwd(any ptr) i64
}

take_fwd(nil)
NY
}
