shape x86_64_coff_debug_line_table {
  family "runtime-native"
  generator "native"
  features ["native", "object", "coff", "x86_64", "debug", "codeview-line"]
  template ny-test-case
  flags "--native-backend x86_64 --host-triple x86_64-w64-windows-gnu -g -emit-only -o /tmp/nytrix-native-coff64-debug-line.obj"
  expect compile_and_run
  source ny <<'NY'
fn add(int a, int b) int {
  def sum = a + b
  sum
}
assert(add(20, 22) == 42, "coff debug line object function")
NY
}
