shape x86_64_coff_object_ssa_phi {
  family "runtime-native"
  generator "native"
  features [native object coff x86_64 nyir ssa phi edge-copy]
  template ny-test-case
  flags "--native-backend x86_64 --host-triple x86_64-w64-windows-gnu -O3 --nyir-verify -emit-only -o /tmp/nytrix-coff64-ssa-phi.obj"
  expect compile_and_run
  source ny <<'NY'
mut a = 1
mut b = 2
mut i = 0
while i < 5 {
  def t = a
  a = b
  b = t
  i = i + 1
}
a * 10 + b
NY
}
