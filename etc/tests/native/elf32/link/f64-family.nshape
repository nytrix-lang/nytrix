defaults {
  family "runtime-native"
  generator "native"
  template ny-test-case
}

shape i386_elf32_object_link_run_f64 {
  features [native object elf32 i386 x86 nyir link-run f64]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f64.o"
  expect object_link_run_f64_3.75
  source ny <<'NY'
def a = 1.5
def b = 2.25
a + b
NY
}

shape i386_elf32_object_link_run_f64_call {
  features [native object elf32 i386 x86 nyir link-run f64 call]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f64-call.o"
  expect object_link_run_f64_3.75
  source ny <<'NY'
fn val() f64 {
  3.75
}

val()
NY
}

shape i386_elf32_object_link_run_f64_params {
  features [native object elf32 i386 x86 nyir link-run f64 call params]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f64-params.o"
  expect object_link_run_f64_3.75
  source ny <<'NY'
fn add(f64 x, f64 y) f64 {
  x + y
}

add(1.5, 2.25)
NY
}

shape i386_elf32_object_link_run_f64_cmp {
  features [native object elf32 i386 x86 nyir link-run f64 cmp]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-f64cmp.o"
  expect object_link_run_i64_1
  source ny <<'NY'
def a = 3.5
def b = 2.25
if a > b { 1 } else { 0 }
NY
}

shape i386_elf32_object_link_run_f64_cmp_all {
  features [native object elf32 i386 x86 nyir link-run f64 cmp]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-f64cmp-all.o"
  expect object_link_run_i64_1
  source ny <<'NY'
def a = 3.5
def b = 2.25
def c = 3.5
if a > b {
  if a >= c {
    if b < a {
      if b <= a {
        if a != b {
          if a == c {
            1
          } else { 0 }
        } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 }
} else { 0 }
NY
}

shape i386_elf32_object_link_run_f64_compare {
  features [native object elf32 i386 x86 nyir link-run f64 compare]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f64-compare.o"
  expect object_link_run_i64_1
  source ny <<'NY'
fn gt(f64 x, f64 y) bool {
  x > y
}

gt(2.25, 1.5)
NY
}

shape i386_elf32_object_link_run_f64_compare_lt {
  features [native object elf32 i386 x86 nyir link-run f64 compare]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f64-compare-lt.o"
  expect object_link_run_i64_1
  source ny <<'NY'
fn lt(f64 x, f64 y) bool {
  x < y
}

lt(1.5, 2.25)
NY
}
