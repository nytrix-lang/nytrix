defaults {
  family "runtime-native"
  generator "native"
  template ny-test-case
}

shape x86_elf32_object_link_run_i16_return {
  features [native object elf32 x86 nyir link-run abi]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-i16-return.o"
  expect object_link_run_i16_65535
  source ny <<'NY'
fn ret_i16() i16 {
  -1
}
ret_i16()
NY
}

shape x86_elf32_object_link_run_i64 {
  features [native object elf32 x86 nyir link-run]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-i64.o"
  expect object_link_run_i64_45
  source ny <<'NY'
def a = 40
def b = 5
a + b
NY
}

shape i386_elf32_object_link_run_int_cmp {
  features [native object elf32 i386 x86 nyir link-run cmp]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-intcmp.o"
  expect object_link_run_i64_1
  source ny <<'NY'
fn check(i64 a, i64 b) i64 {
  if a > b {
    if a >= b {
      if b < a {
        if b <= a {
          if a != b {
            1
          } else { 0 }
        } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 }
}
check(10, 3)
NY
}

shape x86_elf32_object_link_run_u32_return {
  features [native object elf32 x86 nyir link-run abi]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-u32-return.o"
  expect object_link_run_u32_4294967295
  source ny <<'NY'
fn ret_u32() u32 {
  4294967295
}
ret_u32()
NY
}

shape x86_elf32_object_link_run_u8_return {
  features [native object elf32 x86 nyir link-run abi]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-u8-return.o"
  expect object_link_run_u8_255
  source ny <<'NY'
fn ret_u8() u8 {
  255
}
ret_u8()
NY
}

shape x86_elf32_object_link_run_bool_return {
  features [native object elf32 x86 nyir link-run abi bool]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-bool-return.o"
  expect object_link_run_bool_1
  source ny <<'NY'
fn ret_bool(i64 a, i64 b) bool {
  a < b
}
ret_bool(3, 5)
NY
}

shape x86_elf32_object_link_run_call7 {
  features [native object elf32 x86 nyir link-run reloc call]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-native-elf32-link-run-call7.o"
  expect object_link_run_i64_28
  source ny <<'NY'
fn add7(i64 a, i64 b, i64 c, i64 d, i64 e, i64 f, i64 g) i64 {
  a + b + c + d + e + f + g
}

add7(1, 2, 3, 4, 5, 6, 7)
NY
}
