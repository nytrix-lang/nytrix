defaults {
  family "runtime-native"
  generator "native"
  template ny-test-case
}

shape i386_elf32_object_link_run_f32 {
  features [native object elf32 i386 x86 nyir link-run f32]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f32.o"
  expect object_link_run_f64_0.30000001192092896
  source ny <<'NY'
def f32 a = 0.1
def f32 b = 0.2
def f64 c = a + b
c
NY
}

shape i386_elf32_object_link_run_f32_call {
  features [native object elf32 i386 x86 nyir link-run f32 call]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f32-call.o"
  expect object_link_run_f64_0.30000001192092896
  source ny <<'NY'
fn add(f32 a, f32 b) f32 {
  a + b
}

def f64 y = add(0.1, 0.2)
y
NY
}

shape i386_elf32_object_link_run_f32_compare {
  features [native object elf32 i386 x86 nyir link-run f32 compare]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f32-compare.o"
  expect object_link_run_i64_1
  source ny <<'NY'
def f32 a = 0.1
def f32 b = 0.2
def f32 c = a + b
def f32 t = 0.30000001
c == t
NY
}

shape i386_elf32_object_link_run_f32_direct_return {
  features [native object elf32 i386 x86 nyir link-run f32 abi return]
  flags "--native-backend x86 -emit-only -o /tmp/nytrix-elf32-link-run-f32-direct-return.o"
  expect object_link_run_f32_3.75
  source ny <<'NY'
def f32 x = 1.5f32
def f32 y = 2.25f32
x + y
NY
}
