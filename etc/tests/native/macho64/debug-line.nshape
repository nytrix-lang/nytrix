shape x86_64_macho_debug_line_table {
  family "runtime-native"
  generator "native"
  features ["native", "object", "macho", "x86_64", "debug", "dwarf-line"]
  template ny-test-case
  flags "--native-backend x86_64 --host-triple x86_64-apple-darwin -g -emit-only -o /tmp/nytrix-native-macho64-debug-line.o"
  expect compile_and_run
  source ny <<'NY'
fn add(int a, int b) int {
  def sum = a + b
  sum
}
assert(add(20, 22) == 42, "macho debug line object function")
NY
}
