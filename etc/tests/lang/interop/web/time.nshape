shape test_time_now {
  family "interop/web"
  generator "embedded"
  ci skip
  features [browser wasm interop time clock]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
;; Keywords: browser time clock portability fixture
;; Browser time imports must return live wall-clock and monotonic values.
use core.os.time as time
use core.os.ui.render as gfx
use core.os.ui.window as window

def wall = time.now_ms()
def mono = time.monotonic_ns()
window.test_report_touch(wall, wall, mono)
def win = gfx.init_window(320, 180, "Nytrix browser clock", 0, true, false, 1)
gfx.begin_frame_clear(gfx.BLACK)
gfx.draw_rect(24.0, 24.0, 272.0, 132.0, gfx.WHITE)
gfx.end_frame()
NY
}

shape test_time_sleep {
  family "interop/web"
  generator "embedded"
  ci skip
  features [browser wasm interop time sleep]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
;; Keywords: browser time asyncify fixture
;; Verify that browser msleep suspends and resumes the same Wasm stack.
use core.os.time as time
use core.os.ui.window as window

def before = time.now_ms()
time.msleep(50)
def after = time.now_ms()
def elapsed = after - before
window.test_report_touch(elapsed, elapsed, elapsed)
elapsed
NY
}
