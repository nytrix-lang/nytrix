shape test_bare_dict_import_baseline {
  family "shapes/compiler/regressions/stdlib"
  generator "embedded"
  features ["ny", "test"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
;; NY-005 baseline: importing core first makes the core.dict submodule
;; import compile. The known-bug replay uses this to distinguish the bare import
;; diagnostic from a broader broken standard-library setup.
use core
use core.dict

0
NY
}
