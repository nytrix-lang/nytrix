shape project_std_module {
  family "compiler-errors/modules"
  generator "error"
  features ["error", "modules", "identity", "strict-types"]
  template ny-compile-fail
  expect compile_fail
  expect_message "hm-strict-dynamic-member"
  flags "--strict-types"
  source ny <<'NY'
module std.project(
   project_unknown_member
)

fn project_unknown_member(any value) {
   value.missing_project_member
}

project_unknown_member(1)
NY
}
