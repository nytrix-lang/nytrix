shape user_std_math_keeps_user_type_contract_origin {
  family "runtime/modules/use"
  generator "regression"
  features ["ny", "test", "modules", "identity", "legacy-llvm", "diagnostic"]
  template ny-test-case
  flags_matrix "--native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only --native-backend=x86_64"
  expect compile_and_run
  source ny <<'NY'
module core.math(
  sqrt
)

fn sqrt(str value) str { value }

#main {
  assert(core.math.sqrt("kept user declaration") == "kept user declaration",
         "a user core.math spelling must not inherit stdlib numeric type rules")
  0
}
NY
}
