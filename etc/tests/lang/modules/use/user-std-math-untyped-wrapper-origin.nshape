shape user_std_math_untyped_wrapper_keeps_user_callee_abi {
  family "runtime/modules/use"
  generator "regression"
  features ["ny", "test", "modules", "identity", "legacy-llvm", "f64"]
  template ny-test-case
  flags_matrix "--native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc"
  expect compile_and_run
  source ny <<'NY'
module core.math(
  sqrt
  apply
  apply_callable
)

fn sqrt(float value) float {
  value + 10.0
}

fn apply(value) {
  sqrt(value)
}

fn apply_callable(sqrt, value) {
  sqrt(value)
}

#main {
  assert(core.math.apply(2.0) == 12.0,
         "an untyped wrapper must retain the user-owned sqrt parameter ABI")
  assert(core.math.apply_callable(fn(value) { value + 10.0 }, 2.0) == 12.0,
         "a callable parameter named sqrt must not inherit the math intrinsic ABI")
  0
}
NY
}
