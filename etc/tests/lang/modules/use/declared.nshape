shape test_declared {
  family "runtime/modules/use"
  generator "embedded"
  features ["ny", "test"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
module DeclaredModuleProvider(
   make_report, make_report_any
)

use core

fn make_report() dict {
   mut out = dict(4)
   out = out.set("ok", true)
   out
}

fn make_report_any() any {
   mut out = dict(4)
   out = out.set("ok", true)
   out
}
NY
}
