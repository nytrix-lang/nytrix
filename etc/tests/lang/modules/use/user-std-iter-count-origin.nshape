shape user_std_iter_count_keeps_origin {
  family "runtime/modules/use"
  generator "regression"
  features ["ny" "test" "modules" "identity" "legacy-llvm"]
  template ny-test-case
  flags_matrix "--native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only --native-backend=x86_64"
  expect compile_and_run
  source ny <<'NY'
module core.iter(count)

fn count(seq xs) int { 99 }

#main {
  assert(core.iter.count([1, 2, 3]) == 99,
         "a user module with stdlib spelling keeps its count implementation")
  0
}
NY
}
