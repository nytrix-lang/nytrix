shape ownership_rule_borrow_store_collection {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "negative", "borrow", "collection"]
  template ny-compile-fail
  expect compile_fail
  flags "--ownership-strict"
  expect_message "a second-class borrow cannot be stored in a collection"
  source ny <<'NY'
use core

fn bad(int x) {
  mut list xs = []
  xs.append(&x)
  xs
}

bad(1)
NY
}
