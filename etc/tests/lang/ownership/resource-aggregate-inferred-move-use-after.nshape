shape ownership_resource_aggregate_inferred_move_use_after {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "resource", "aggregate", "inferred", "move", "use-after-move", "negative"]
  template ny-compile-fail
  expect compile_fail
  flags "--ownership-strict"
  expect_message "linear resource 'original.left' is used after it was moved"
  source ny <<'NY'
use core

linear layout File { int fd }
layout ResourcePair { File left, int tag }

fn transfer_then_read_source() int {
  def ResourcePair original = ResourcePair(File(11), 7)
  def transferred = original
  def observed = original.left.fd
  transferred.tag
}

transfer_then_read_source()
NY
}
