  expect compile_and_run
  source ny <<'NY'
use core

refine NonEmpty = list where(items) { items.len > 0 }

fn checked_length() int {
  mut list<int> items = [4, 5]
  if NonEmpty(items) {
    return items.len
  }
  0
}

assert(checked_length() == 2,
       "a fresh mutable aggregate keeps its checked refinement in a read-only arm")
NY
}

