shape mutable_aggregate_symbolic_integer_bound_transport {
  family "runtime/language"
  generator "regression"
  features [ny test typing refinement mutable aggregate symbolic integer bound store append positive]
  template ny-test-case
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

def threshold = 1 + 2
def safe = 2 + 3

refine AboveThreshold = list where(items) {
  items[1] > threshold
}
@effects(read) fn require_above_threshold(AboveThreshold items) int {
  return items.len
}
refine AboveLast = list where(items) {
  items[1] > threshold
}
@effects(read) fn require_above_last(AboveLast items) int {
  return items.len
}

fn store_preserves_proof() int {
  mut list<int> items = [9, 9]
  if AboveThreshold(items) {
    items[1] = safe
    return require_above_threshold(items)
  }
  0
}

fn append_preserves_proof() int {
  mut list<int> items = [1, 9]
  if AboveLast(items) {
    items = append(items, safe)
    return require_above_last(items)
  }
  0
}

assert(store_preserves_proof() == 2,
       "immutable signed-i64 expressions prove a relational store")
assert(append_preserves_proof() == 3,
       "immutable signed-i64 expressions prove an indexed append")
NY
}

shape mutable_aggregate_relation_preserved_by_reconstructing_stored_value {
  family "runtime/language"
  generator "regression"
  features [ny test typing refinement mutable aggregate content relation reconstruct store positive]
  template ny-test-case
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

refine EqualGap = list where(items) {
  items[0] == items[1] + 5
}
@effects(read) fn require_equal_gap(EqualGap items) int {
  return items.len
}

fn reconstruct_equal_value() int {
  mut list<int> items = [10, 5]
  if EqualGap(items) {
    items[0] = items[1] + 5
    return require_equal_gap(items)
  }
  0
}

fn append_after_equal_value() int {
  mut list<int> items = [10, 5]
  if EqualGap(items) {
    items = append(items, 99)
    return require_equal_gap(items)
  }
  0
}

refine EqualTail = list where(items) {
  items[-2] == items[-1]
}
@effects(read) fn require_equal_tail(EqualTail items) int {
  return items.len
}

fn append_copies_proven_tail() int {
  mut list<int> items = [5, 5]
  if EqualTail(items) {
    items = append(items, items[-1])
    return require_equal_tail(items)
  }
  0
}

refine EqualGapPositive = list where(items) {
  items[0] == items[1] + 5 && items[2] > 0
}
@effects(read) fn require_equal_gap_positive(EqualGapPositive items) int {
  return items.len
}

fn reconstruct_conjunctive_relation() int {
  mut list<int> items = [10, 5, 1]
  if EqualGapPositive(items) {
    items[0] = items[1] + 5
    return require_equal_gap_positive(items)
  }
  0
}

assert(reconstruct_equal_value() == 2,
       "storing the guarded expression preserves the content relation")
assert(append_after_equal_value() == 3,
       "append preserves a content relation over stable nonnegative indices")
assert(append_copies_proven_tail() == 3,
       "appending the proven previous tail preserves the new tail equality")
assert(reconstruct_conjunctive_relation() == 3,
       "reconstructing one conjunct preserves unaffected conjuncts")
NY
}

