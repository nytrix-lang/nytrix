shape mutable_aggregate_local_write_precedes_refinement_guard {
  family "runtime/language"
  generator "regression"
  features [ny test typing refinement mutable aggregate mutation guard positive]
  template ny-test-case
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

refine NonEmpty = list where(items) { items.len > 0 }

fn checked_after_local_write() int {
  mut list<int> items = [4, 5]
  items[0] = 8
  if NonEmpty(items) {
    return items.len
  }
  0
}

assert(checked_after_local_write() == 2,
       "a local write before the predicate is checked does not invalidate its later fact")
NY
}

