  expect_message "refinement obligation"
  source ny <<'NY'
use core

refine IndexedAlternative = list where(items) {
  items[0] > 0 || items[1] < 10
}
fn require_alternative(IndexedAlternative items) int { return items.len }

fn invalid_after_violation() int {
  mut list<int> items = [4, 12]
  if IndexedAlternative(items) {
    items[0] = 0
    return require_alternative(items)
  }
  0
}

invalid_after_violation()
