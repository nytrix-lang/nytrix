shape mutable_aggregate_monotone_content_length_survives_append {
  family "runtime/language"
  generator "regression"
  features [ny test typing refinement mutable aggregate content append positive]
  template ny-test-case
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

refine FirstBelowLength = list where(items) { items[0] < items.len }
fn require_first_below_length(FirstBelowLength items) int { return items.len }

fn checked_after_append() int {
  mut list<int> items = [0]
  if FirstBelowLength(items) {
    items = append(items, 9)
    return require_first_below_length(items)
  }
  0
}

assert(checked_after_append() == 2,
       "a fixed-index value below list length remains below it after append")
NY
}

