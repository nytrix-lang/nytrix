shape mutable_refinement_rejects_overloaded_operator_guard {
  family "compiler-errors/types"
  generator "error"
  features [error typing refinement mutable operator soundness negative]
  template ny-compile-fail
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  expect compile_fail
  expect_message "refinement obligation"
  source ny <<'NY'
use core

impl int {
  fn always_true(self left, int right) bool { true }
  operator > int: bool = always_true
}

refine Positive = int where(value) { value > 0 }

fn invalid_overloaded_guard(int input) Positive {
  mut value = input
  if value > 0 {
    return value
  }
  return 0
}

invalid_overloaded_guard(-1)
NY
}

