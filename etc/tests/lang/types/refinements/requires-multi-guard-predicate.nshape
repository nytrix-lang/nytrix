shape requires_predicate_inlines_multiple_guard_returns {
  family "typing/contracts"
  generator "regression"
  features ["ny", "test", "typing", "requires", "predicate-body"]
  template ny-test-case
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@pure
fn in_range(int value) bool {
  def lower = 0
  if value < lower { return false }
  if value > 10 { return false }
  return value >= lower && value <= 10
}

fn checked(int value) int requires in_range(value) {
  return value
}

fn forwarded(int value) int requires value >= 0 && value <= 10 {
  return checked(value)
}

assert(forwarded(5) == 5,
       "multiple early-return guards inline into the requires proof")
NY
}
