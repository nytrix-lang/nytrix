shape mutable_aggregate_content_predicate_survives_match_self_stores {
  family "runtime/language"
  generator "regression"
  features [ny test typing refinement mutable aggregate content-dependent match self-store positive]
  template ny-test-case
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

refine EqualGap = list where(items) { items[0] == items[1] + 5 }
@effects(read)
fn require_equal_gap(EqualGap items) int { return items.len }

fn checked_match_stores(bool choose) int {
  mut list<int> items = [10, 5]
  if EqualGap(items) {
    match choose {
      true -> { items[0] = items[0] }
      _ -> { items[1] = items[1] }
    }
    return require_equal_gap(items)
  }
  0
}

assert(checked_match_stores(true) == 2,
       "proved self-stores in every match arm preserve the content fact")
assert(checked_match_stores(false) == 2,
       "the default match arm also preserves the content fact")
NY
}
