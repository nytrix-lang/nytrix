shape gadt_negative_constructor_index {
  family "typing/dependent"
  generator "error"
  features [error typing dependent gadt negative]
  template ny-compile-fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_fail
  expect_message "expected 'Expr<int>', got 'Expr<bool>'"
  source ny <<'NY'
use core

enum Expr<t> {
  IntLit(int) where t is int,
  BoolLit(bool) where t is bool
}

;; Constructor evidence is not forgeable: BoolLit only produces Expr<bool>.
def Expr<int> forged = Expr.BoolLit(true)
print(forged)
NY
}
