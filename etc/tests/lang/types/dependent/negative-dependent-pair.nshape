shape dependent_negative_dependent_pair {
  family "typing/dependent"
  generator "error"
  features [error typing dependent negative]
  template ny-compile-fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_fail
  expect_message "expected dependent pair binder name"
  source ny <<'NY'
use core
;; A sigma annotation must bind a name for the index; omitting it is rejected.
def p exists(Fin<8>) list<f64> = [1.0]
print(p)
NY
}
