shape first_class_type_arity_negative {
  family "typing/dependent"
  generator "error"
  features [error typing dependent type-level negative]
  template ny-compile-fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_fail
  expect_message "wrong arity"
  source ny <<'NY'
use core
type Wrap<T> = list<T>
def Wrap<int, str> value = [1]
print(value)
NY
}
