shape test_stale_handle_validation {
  family "runtime/language"
  generator "embedded"
  features ["ny", "test"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core

;; Validate handle detection on null and arbitrary integers / stale addresses
assert(__handle_valid(0) == 0, "null handle must be invalid")
assert(__handle_valid(1) == 0, "tagged int 1 is not a valid handle")
assert(__handle_valid(42) == 0, "tagged int 42 is not a valid handle")
assert(__handle_valid(0x12345678) == 0, "unmapped address is not a valid handle")

;; Live heap allocation is valid
def p = __malloc(64)
assert(__handle_valid(p) == 1, "fresh heap allocation is valid")
__free(p)

;; Live dictionary handle is valid
def d = {"key": 42}
assert(__handle_valid(d) == 1, "live dict handle is valid")
print("ok")
NY
}
