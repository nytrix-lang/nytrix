shape assigned_list_append_rejects_missing_custom_callback_row {
  family "typing/effects"
  generator "error"
  features [error typing effects callback mutable list append assignment custom-row negative]
  template ny-compile-fail
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_fail
  expect_message "effect contract violation"
  source ny <<'NY'
use core

@effects(cap("project.storage.read"))
fn storage_callback() int { 9 }

@effects(none)
fn pure_callback() int { 7 }

@effects(alloc, read, write)
fn invoke_custom_appended_callback(int index) int {
  def source = [pure_callback, pure_callback]
  mut callbacks = source.append(storage_callback)
  callbacks[index]()
}

invoke_custom_appended_callback(2)
NY
}
