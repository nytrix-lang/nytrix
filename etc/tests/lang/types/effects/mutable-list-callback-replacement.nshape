shape mutable_list_slot_replacement_tracks_callback_effects {
  family "typing/effects"
  generator "regression"
  features [ny test typing effects callback capture mutable list exact indexed replacement positive]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(io)
fn io_callback() int {
  print("mutable callback slot\n")
  42
}

@effects(none)
fn pure_callback() int { 7 }

@effects(io, alloc, read, write)
fn invoke_replaced_callback() int {
  mut callbacks = [pure_callback]
  callbacks[0] = io_callback
  callbacks[0]()
}

assert(invoke_replaced_callback() == 42,
       "a mutable exact-index store transfers the replacement callback row")
NY
}

