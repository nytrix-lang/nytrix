shape mutating_dictionary_preserves_disjoint_list_callback_summary {
  family "typing/effects"
  generator "regression"
  features [ny test typing effects callback container-kind isolation positive]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(io)
fn io_callback() int {
  print("dictionary callback mutation\n")
  42
}

@effects(none)
fn pure_callback() int { 7 }

@effects(alloc, read, write)
fn mutate_dictionary_and_call_list() int {
  mut callbacks = [pure_callback]
  mut entries = {"run": pure_callback}
  entries["run"] = io_callback
  callbacks[0]()
}

assert(mutate_dictionary_and_call_list() == 7,
       "dictionary mutation does not invalidate a statically distinct list")
NY
}

shape mutable_callback_alias_join_survives_exact_container_store {
  family "typing/effects"
  generator "regression"
  features [ny test typing effects callback mutation branch join exact container store positive]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(io)
fn io_callback() int {
  print("joined mutable callback\n")
  42
}

@effects(none)
fn pure_callback() int { 7 }

@effects(io, alloc, read, write)
fn invoke_joined_callback(bool choose_io) int {
  mut selected = pure_callback
  if choose_io {
    selected = io_callback
  } else {
    selected = pure_callback
  }
  mut callbacks = [pure_callback]
  callbacks[0] = selected
  callbacks[0]()
}

assert(invoke_joined_callback(true) == 42,
       "a branch-joined local callback alias transfers into an exact list slot")
NY
}

