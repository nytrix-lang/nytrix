shape assigned_list_append_tracks_added_callback_effects {
  family "typing/effects"
  generator "regression"
  features [ny test typing effects callback mutable list append assignment summary positive]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(io)
fn io_callback() int {
  print("appended callback\n")
  42
}

@effects(none)
fn pure_callback() int { 7 }

@effects(io, alloc, read, write)
fn invoke_appended_callback(int index) int {
  def source = [pure_callback, pure_callback]
  mut callbacks = source.append(io_callback)
  assert(source[0]() == 7,
         "appending into a new binding preserves the source callback facts")
  callbacks[index]()
}

assert(invoke_appended_callback(2) == 42,
       "the assigned append result summary includes its new callback")
NY
}

