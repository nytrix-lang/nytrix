shape mutable_list_cow_alias_slot_effects_are_isolated {
  family "typing/effects"
  generator "regression"
  features [ny test typing effects callback mutable list copy-on-write alias exact slot positive]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(io)
fn io_callback() int {
  print("cow alias callback\n")
  42
}

@effects(none)
fn pure_callback() int { 7 }

@effects(io, alloc, read, write)
fn invoke_cow_alias() int {
  mut callbacks = [pure_callback]
  mut alias = callbacks
  alias[0] = io_callback
  assert(callbacks[0]() == 7,
         "writing the COW alias leaves the source callback pure")
  alias[0]()
}

assert(invoke_cow_alias() == 42,
       "the detached alias receives the replacement callback row")
NY
}

