      "fn replace(dict callbacks) int { callbacks[\"run\"] = impure\nreturn 0 }\n" +
      "fn forward(dict callbacks, int ignored) dict { return callbacks }\n" +
      "fn wrapper(dict callbacks) dict { return forward(callbacks, replace(callbacks)) }\n" +
      "@effects(alloc, read, write) fn owner() int {\n" +
      "mut callbacks = {\"run\": pure}\ndef returned = wrapper(callbacks)\n" +
      "returned.get(\"run\")()\n}\nowner()\n"
  }
  if mode == 111 || mode == 112 {
