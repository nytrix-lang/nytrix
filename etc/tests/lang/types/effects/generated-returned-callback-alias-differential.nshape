    mut int index = 0
    while index < 7 {
      if index > 0 {
        source += ", "
      }
      source += "bool choose_" + to_str(index)
      index += 1
    }
    index = 0
    while index < 7 {
      source += ", fnptr callback_" + to_str(index)
      index += 1
    }
    source += ", fnptr fallback) fnptr {\n"
    index = 0
    while index < 7 {
      source += "if choose_" + to_str(index) + " { return callback_" +
                to_str(index) + " }\n"
      index += 1
    }
    source += "return fallback\n}\n@effects(" + contract +
              ") fn owner() int {\ndef callback = select("
    index = 0
    while index < 7 {
      if index > 0 {
        source += ", "
      }
      source += "false"
      index += 1
    }
    index = 0
    while index < 7 {
      source += ", "
      source += index == 6 ? "impure" : "pure"
      index += 1
    }
    source += ", pure)\ncallback()\n}\nowner()\n"
    return source
  }
  if mode == 45 || mode == 46 {
