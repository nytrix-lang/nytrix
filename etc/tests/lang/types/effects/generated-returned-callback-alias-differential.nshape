shape generated_returned_callback_alias_effect_differential {
  family "typing/effects"
  generator "embedded"
  features [typing effects callback returned-alias generated differential]
  estimate_ms 27000
  timeout 180
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.subprocess as process
use core.os.prim (env)
use core.os.thread as thread

def compiler = env("NYTRIX_NY_FULL_BIN")
def core_bc = env("NYTRIX_TEST_CORE_BC")
def shared_core_bc = is_str(core_bc) ? core_bc : ""
assert(is_str(compiler) && compiler.len > 0,
       "runner supplies the compiler for callback alias flow cases")

fn generated_source(int mode) str {
  if mode == 120 || mode == 121 || mode == 122 || mode == 123 ||
     mode == 124 || mode == 125 {
    def contract = if mode == 120 || mode == 122 || mode == 124 {
      "alloc, read, write, io"
    } else {
      "alloc, read, write"
    }
    def forwarding = if mode >= 124 {
      "fn forward(list callbacks) list { return callbacks }\n" +
      "fn forward_again(list callbacks) list { return forward(callbacks) }\n"
    } else if mode >= 122 {
      "fn forward(list callbacks) list { return callbacks }\n"
    } else {
      ""
    }
    def returned = if mode >= 124 {
      "def returned = forward_again(make())\n"
    } else if mode >= 122 {
      "def returned = forward(make())\n"
    } else {
      "def returned = make()\n"
    }
    return "use core\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(io) fn impure() int { print(\"returned callback container\\n\")\nreturn 43 }\n" +
      "@effects(alloc, read, write) fn make() list {\n" +
      "mut callbacks = [pure]\ncallbacks[0] = impure\nreturn callbacks\n}\n" +
      forwarding +
      "@effects(" + contract + ") fn owner() int {\n" +
      returned + "returned[0]()\n}\nowner()\n"
  }
  if mode == 118 || mode == 119 {
    def contract = mode == 118 ? "alloc, io" : "alloc"
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"forwarded escaped closure\\n\")\nreturn 43 }\n" +
      "@effects(alloc) fn make() fnptr { return fn() { impure() } }\n" +
      "fn forward(fnptr callback) fnptr { return callback }\n" +
      "@effects(" + contract + ") fn owner() int {\n" +
      "def returned = forward(make())\nreturned()\n}\nowner()\n"
  }
  if mode == 116 || mode == 117 {
    def contract = mode == 116 ? "alloc, io" : "alloc"
    return "use core\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(io) fn impure() int { print(\"escaped closure callback\\n\")\nreturn 43 }\n" +
      "@effects(alloc) fn make() fnptr {\n" +
      "mut callback = pure\n" +
      "def returned = fn() { callback() }\n" +
      "callback = impure\nreturn returned\n}\n" +
      "@effects(" + contract + ") fn owner() int {\n" +
      "def returned = make()\nreturned()\n}\nowner()\n"
  }
  if mode == 114 || mode == 115 {
    def contract = mode == 114 ? "alloc, io, read" : "alloc, read"
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"aliased forward\\n\")\nreturn 43 }\n" +
      "@effects(none) fn alias_forward(dict callbacks) dict {\n" +
      "def alias = callbacks\nreturn alias\n}\n" +
      "fn forward_again(dict callbacks) dict { return alias_forward(callbacks) }\n" +
      "@effects(" + contract + ") fn owner() int {\n" +
      "mut callbacks = {\"run\": impure}\n" +
      "def returned = forward_again(callbacks)\nreturned.get(\"run\")()\n}\n" +
      "owner()\n"
  }
  if mode == 126 || mode == 127 {
    def contract = mode == 126 ? "alloc, io" : "alloc"
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"multiply forwarded closure\\n\")\nreturn 43 }\n" +
      "@effects(alloc) fn make() fnptr { return fn() { impure() } }\n" +
      "fn forward(fnptr callback) fnptr { return callback }\n" +
      "fn forward_again(fnptr callback) fnptr { return forward(callback) }\n" +
      "@effects(" + contract + ") fn owner() int {\n" +
