      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(" + contract + ") fn owner(str key) int {\n" +
      "mut callbacks = {\"first\": pure, \"second\": pure}\n" +
      "callbacks.set(key, restricted)\ncallbacks.get(key)()\n}\nowner(\"first\")\n"
  }
  if mode == 69 || mode == 70 {
    def contract =
        if mode == 69 { "alloc, read, write, io" }
        else { "alloc, read, write" }
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"dynamic dict index replacement\\n\")\nreturn 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(" + contract + ") fn owner(str key) int {\n" +
      "mut callbacks = {\"first\": pure, \"second\": pure}\n" +
      "callbacks[key] = impure\ncallbacks.get(key)()\n}\nowner(\"first\")\n"
  }
  if mode == 71 || mode == 72 {
    def custom_row = "cap(\"project.storage.read\")"
    def contract =
        if mode == 71 { "alloc, read, write, " + custom_row }
        else { "alloc, read, write" }
    return "use core\n" +
      "@effects(" + custom_row + ") fn restricted() int { return 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(" + contract + ") fn owner(str key) int {\n" +
      "mut callbacks = {\"first\": pure, \"second\": pure}\n" +
      "callbacks[key] = restricted\ncallbacks.get(key)()\n}\nowner(\"first\")\n"
  }
  if mode == 73 || mode == 74 {
    def contract =
        if mode == 73 { "alloc, read, write, io" }
        else { "alloc, read, write" }
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"returned mutable dictionary\\n\")\nreturn 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(alloc, read, write) fn make(str key) dict {\n" +
      "mut callbacks = {\"first\": pure, \"second\": pure}\n" +
      "callbacks.set(key, impure)\nreturn callbacks\n}\n" +
      "@effects(" + contract + ") fn owner(str key) int {\n" +
      "def callbacks = make(key)\ncallbacks.get(key)()\n}\nowner(\"first\")\n"
  }
  if mode == 75 || mode == 76 {
    def custom_row = "cap(\"project.storage.read\")"
    def contract =
        if mode == 75 { "alloc, read, write, " + custom_row }
        else { "alloc, read, write" }
    return "use core\n" +
      "@effects(" + custom_row + ") fn restricted() int { return 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(alloc, read, write) fn make(str key) dict {\n" +
      "mut callbacks = {\"first\": pure, \"second\": pure}\n" +
      "callbacks.set(key, restricted)\nreturn callbacks\n}\n" +
      "@effects(" + contract + ") fn owner(str key) int {\n" +
      "def callbacks = make(key)\ncallbacks.get(key)()\n}\nowner(\"first\")\n"
  }
  if mode == 77 || mode == 78 {
    def contract =
        if mode == 77 { "alloc, read, write, io" }
        else { "alloc, read, write" }
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"returned callback alias\\n\")\nreturn 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(alloc, read, write) fn make(str key) dict {\n" +
      "mut callbacks = {\"first\": pure, \"second\": pure}\n" +
      "callbacks.set(key, impure)\ndef result = callbacks\nreturn result\n}\n" +
      "@effects(" + contract + ") fn owner(str key) int {\n" +
      "def callbacks = make(key)\ncallbacks.get(key)()\n}\nowner(\"first\")\n"
  }
  if mode == 79 || mode == 80 {
    def contract =
        if mode == 79 { "alloc, read, write, io" }
        else { "alloc, read, write" }
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"returned aliased dictionary\\n\")\nreturn 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(alloc, read, write) fn make(str key) dict {\n" +
      "mut callbacks = {\"first\": pure, \"second\": pure}\n" +
      "def alias = callbacks\nalias.set(key, impure)\nreturn alias\n}\n" +
      "@effects(" + contract + ") fn owner(str key) int {\n" +
      "def callbacks = make(key)\ncallbacks.get(key)()\n}\nowner(\"first\")\n"
  }
  if mode == 81 || mode == 82 {
    def contract =
        if mode == 81 { "alloc, read, write, io" }
        else { "alloc, read, write" }
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"returned mutable list\\n\")\nreturn 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(alloc, read, write) fn make(int index) list {\n" +
      "mut callbacks = [pure, pure]\ncallbacks[index] = impure\n" +
      "return callbacks\n}\n" +
      "@effects(" + contract + ") fn owner(int index) int {\n" +
      "def callbacks = make(index)\ncallbacks.get(index)()\n}\nowner(0)\n"
  }
  if mode == 83 || mode == 84 {
    def contract =
        if mode == 83 { "alloc, read, write, io" }
        else { "alloc, read, write" }
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"returned branched dictionary\\n\")\nreturn 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(alloc, read, write) fn make(bool choose, str key) dict {\n" +
      "mut callbacks = {\"first\": pure, \"second\": pure}\n" +
      "if choose { callbacks.set(key, impure) } else { callbacks.set(key, pure) }\n" +
      "return callbacks\n}\n" +
      "@effects(" + contract + ") fn owner(bool choose, str key) int {\n" +
      "def callbacks = make(choose, key)\ncallbacks.get(key)()\n}\nowner(true, \"first\")\n"
  }
  if mode == 85 || mode == 86 {
    def contract =
        if mode == 85 { "alloc, read, write, io" }
        else { "alloc, read, write" }
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"returned branched list\\n\")\nreturn 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(alloc, read, write) fn make(bool choose, int index) list {\n" +
      "mut callbacks = [pure, pure]\n" +
      "if choose { callbacks[index] = impure } else { callbacks[index] = pure }\n" +
      "return callbacks\n}\n" +
      "@effects(" + contract + ") fn owner(bool choose, int index) int {\n" +
      "def callbacks = make(choose, index)\ncallbacks.get(index)()\n}\nowner(true, 0)\n"
  }
  if mode == 87 || mode == 88 {
    def contract =
        if mode == 87 { "alloc, read, write, io" }
        else { "alloc, read, write" }
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"returned aliased branch\\n\")\nreturn 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(alloc, read, write) fn make(bool choose, str key) dict {\n" +
      "mut callbacks = {\"first\": pure, \"second\": pure}\n" +
      "def alias = callbacks\n" +
      "if choose { alias.set(key, impure) } else { alias.set(key, pure) }\n" +
      "return alias\n}\n" +
      "@effects(" + contract + ") fn owner(bool choose, str key) int {\n" +
      "def callbacks = make(choose, key)\ncallbacks.get(key)()\n}\nowner(true, \"first\")\n"
  }
  if mode == 89 || mode == 90 {
    def contract =
        if mode == 89 { "alloc, read, write, io" }
        else { "alloc, read, write" }
    return "use core\n" +
      "@effects(io) fn impure() int { print(\"returned match dictionary\\n\")\nreturn 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n" +
      "@effects(alloc, read, write) fn make(bool choose, str key) dict {\n" +
      "mut callbacks = {\"first\": pure, \"second\": pure}\n" +
      "match choose { true -> { callbacks.set(key, impure) } " +
      "else { callbacks.set(key, pure) } }\nreturn callbacks\n}\n" +
      "@effects(" + contract + ") fn owner(bool choose, str key) int {\n" +
      "def callbacks = make(choose, key)\ncallbacks.get(key)()\n}\nowner(true, \"first\")\n"
  }
  if mode >= 22 && mode <= 24 {
    def contract = mode == 22 ? "alloc, io" : "alloc"
    mut str source =
      "use core\n@effects(io) fn impure() int { print(\"io\\n\")\nreturn 43 }\n" +
      "@effects(none) fn pure() int { return 42 }\n"
    if mode == 24 {
      source = source +
        "@effects(alloc, e) fn select(bool a, bool b, bool c, bool d, fnptr w, fnptr x, fnptr y, fnptr z, fnptr fallback) fnptr {\n" +
        "if a { return w }\nif b { return x }\nif c { return y }\nif d { return z }\nreturn fallback\n}\n"
    } else {
      source = source +
        "@effects(alloc, e) fn select(bool first, bool second, fnptr a, fnptr b, fnptr fallback) fnptr {\n" +
        "if first { return a }\nif second { return b }\nreturn fallback\n}\n"
    }
    mut str callback =
      "def callback = select(false, true, pure, impure, pure)\n"
    if mode == 24 {
      callback =
        "def callback = select(false, false, false, false, pure, pure, pure, pure, pure)\n"
    }
    source = source + "@effects(" + contract + ") fn owner() int {\n" +
      callback + "callback()\n}\nowner()\n"
    return source
  }
  if mode == 0 {
    return "use core\nfn pure() int { 42 }\n" +
      "fn forward(fnptr callback) fnptr { def alias = callback\nreturn alias }\n" +
      "@effects(none) fn owner() int { def callback = forward(pure)\ncallback() }\nowner()\n"
  }
  if mode == 1 || mode == 2 {
    def contract = if mode == 1 { "io" } else { "none" }
    return "use core\n@effects(io) fn impure() int { print(\"io\\n\")\n42 }\n" +
      "fn forward(fnptr callback) fnptr { def alias = callback\nreturn alias }\n" +
      "@effects(" + contract + ") fn owner() int { def callback = forward(impure)\ncallback() }\nowner()\n"
  }
  if mode == 5 || mode == 6 {
    def contract = if mode == 5 { "io" } else { "none" }
    return "use core\nfn pure() int { 42 }\n" +
      "@effects(io) fn impure() int { print(\"io\\n\")\n43 }\n" +
      "fn select(bool choose, fnptr first, fnptr second) fnptr { mut selected = first\n" +
      "if choose { selected = second }\nreturn selected }\n" +
      "@effects(" + contract + ") fn owner() int { def callback = select(true, pure, impure)\ncallback() }\nowner()\n"
  }
  if mode == 7 {
    return "use core\nfn pure() int { 42 }\n" +
      "@effects(io) fn impure() int { print(\"io\\n\")\n43 }\n" +
      "fn select(bool choose, fnptr first, fnptr second) fnptr { if choose { return second }\nreturn first }\n" +
      "@effects(none) fn owner() int { def callback = select(true, pure, impure)\ncallback() }\nowner()\n"
  }
  if mode == 8 || mode == 9 {
    def contract = if mode == 8 { "io" } else { "none" }
    return "use core\nfn pure() int { 42 }\n" +
      "@effects(io) fn impure() int { print(\"io\\n\")\n43 }\n" +
      "fn select(bool choose, fnptr first, fnptr second) fnptr { mut selected = first\n" +
      "match choose { true -> { selected = second } _ -> { selected = first } }\n" +
      "return selected }\n" +
      "@effects(" + contract + ") fn owner() int { def callback = select(true, pure, impure)\ncallback() }\nowner()\n"
  }
  if mode == 10 || mode == 11 {
    def contract = if mode == 10 { "io" } else { "none" }
    return "use core\nfn pure() int { 42 }\n" +
      "@effects(io) fn impure() int { print(\"io\\n\")\n43 }\n" +
      "fn select(bool choose, fnptr first, fnptr second) fnptr { def selected = choose ? second : first\n" +
      "return selected }\n" +
      "@effects(" + contract + ") fn owner() int { def callback = select(true, pure, impure)\ncallback() }\nowner()\n"
  }
  if mode == 12 || mode == 13 {
    def contract = if mode == 12 { "io" } else { "none" }
    return "use core\nfn pure() int { 42 }\n" +
      "@effects(io) fn impure() int { print(\"io\\n\")\n43 }\n" +
      "fn select(bool choose, fnptr first, fnptr second) fnptr { " +
      "if choose { return second }\nreturn first }\n" +
      "@effects(" + contract + ") fn owner() int { def callback = select(true, pure, impure)\ncallback() }\nowner()\n"
  }
  if mode == 14 || mode == 15 {
    def contract = if mode == 14 { "cap(read)" } else { "none" }
    return "use core\nfn pure() int { 42 }\n" +
      "@effects(cap(read)) fn restricted() int { 43 }\n" +
      "fn select(bool choose, fnptr first, fnptr second) fnptr { " +
      "if choose { return second }\nreturn first }\n" +
      "@effects(" + contract + ") fn owner() int { def callback = select(true, pure, restricted)\ncallback() }\nowner()\n"
  }
  if mode == 91 || mode == 92 {
    def contract = if mode == 91 { "alloc, read, write, io" } else { "alloc, read, write" }
    return "use core\n@effects(io) fn impure() int { print(\"io\\n\")\n42 }\n" +
      "@effects(none) fn forward(dict callbacks) dict { return callbacks }\n" +
      "@effects(" + contract + ") fn owner() int { " +
      "mut callbacks = {\"run\": impure}\ndef returned = forward(callbacks)\n" +
      "returned.get(\"run\")() }\nowner()\n"
  }
  if mode == 93 || mode == 94 {
    def contract = if mode == 93 { "alloc, read, write, io" } else { "alloc, read, write" }
    return "use core\n@effects(io) fn impure() int { print(\"io\\n\")\n42 }\n" +
      "@effects(none) fn forward(list callbacks) list { return callbacks }\n" +
      "@effects(" + contract + ") fn owner() int { " +
      "mut callbacks = [impure]\ndef returned = forward(callbacks)\n" +
      "returned[0]() }\nowner()\n"
  }
  if mode == 95 || mode == 96 {
    def contract = if mode == 95 { "alloc, read, write, io" } else { "alloc, read, write" }
    return "use core\n@effects(io) fn impure() int { print(\"io\\n\")\n42 }\n" +
      "@effects(none) fn forward(dict callbacks) dict { " +
      "def alias = callbacks\nreturn alias }\n" +
      "@effects(" + contract + ") fn owner() int { " +
      "mut callbacks = {\"run\": impure}\ndef returned = forward(callbacks)\n" +
      "returned.get(\"run\")() }\nowner()\n"
  }
  if mode == 97 || mode == 98 {
    def invoked = if mode == 97 { "unrelated.get(\"run\")()" }
                  else { "alias.get(\"run\")()" }
    return "use core\n@effects(none) fn pure() int { return 42 }\n" +
      "@effects(io) fn impure() int { print(\"io\\n\")\n43 }\n" +
      "@effects(alloc, read, write) fn owner() int {\n" +
      "mut callbacks = {\"run\": impure}\n" +
      "mut unrelated = {\"run\": pure}\n" +
      "mut alias = callbacks\nalias.set(\"run\", impure)\n" +
      invoked + "\n}\nowner()\n"
  }
  def contract = if mode == 3 { "alloc, io" } else { "alloc" }
  "use core\nfn make() fnptr { def alias = fn() { print(\"io\\n\")\n42 }\nreturn alias }\n" +
      "@effects(" + contract + ") fn owner() int { def callback = make()\ncallback() }\nowner()\n"
}

fn check_generated_modes(int first_mode) str {
   mut int mode = first_mode
   while mode < 130 {
      def source = generated_source(mode) + "\n0\n"
      mut args = []
      if shared_core_bc.len > 0 {
         args = args.append("--core-bc")
         args = args.append(shared_core_bc)
      }
      args = args.append("--effect-require-known")
      args = args.append("--native-only")
      args = args.append("--nyir-verify")
      if mode >= 45 {
         args = args.append("-emit-only")
         args = args.append("-o")
         args = args.append("/dev/null")
      }
      args = args.append("-c")
      args = args.append(source)
      def result = process.run_capture(compiler, args, nil, false)
      def output = result.get("stdout", "")
      def accepted = result.get("code", 127) == 0 && str.find(output, "error:") < 0
      def expected = mode == 0 || mode == 1 || mode == 3 || mode == 5 ||
                     mode == 8 || mode == 10 || mode == 12 || mode == 14 ||
                     mode == 22 || mode == 24 || mode == 25 || mode == 27 ||
                     mode == 29 ||
                     mode == 31 || mode == 32 || mode == 33 || mode == 35 ||
                     mode == 38 || mode == 40 || mode == 42 || mode == 45 ||
                     mode == 47 || mode == 49 || mode == 51 || mode == 53 ||
                     mode == 55 || mode == 57 || mode == 59 || mode == 61 ||
                     mode == 63 || mode == 65 || mode == 67 || mode == 69 ||
                     mode == 71 || mode == 73 || mode == 75 || mode == 77 ||
                     mode == 79 || mode == 81 || mode == 83 || mode == 85 ||
                     mode == 87 || mode == 89 || mode == 91 || mode == 93 ||
                     mode == 95 || mode == 97 || mode == 99 || mode == 101 ||
                     mode == 103 || mode == 105 || mode == 107 || mode == 109 ||
                     mode == 111 || mode == 114 || mode == 116 || mode == 118 ||
                     mode == 120 || mode == 122 || mode == 124 || mode == 126 ||
                     mode == 128
      if accepted != expected {
         return "returned callback alias mode " + to_str(mode) +
                " expected accepted=" + to_str(expected) + ": " + output +
                "\ngenerated source:\n" + source
      }
      if !expected && str.find(output, "effect contract violation") < 0 {
         return "underdeclared alias callback must fail for its effect row: " +
                output + "\ngenerated source:\n" + source
      }
      mode += 4
   }
   ""
}

def first_worker = thread.thread_spawn(check_generated_modes, 0)
def second_worker = thread.thread_spawn(check_generated_modes, 1)
def third_worker = thread.thread_spawn(check_generated_modes, 2)
def fourth_worker = thread.thread_spawn(check_generated_modes, 3)
def first_failure = thread.thread_join(first_worker)
def second_failure = thread.thread_join(second_worker)
def third_failure = thread.thread_join(third_worker)
def fourth_failure = thread.thread_join(fourth_worker)
assert(first_failure == "", first_failure)
assert(second_failure == "", second_failure)
assert(third_failure == "", third_failure)
assert(fourth_failure == "", fourth_failure)
NY
}
