shape divergent_custom_callback_alias_rows_fail_closed {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "row", "callback", "control-flow", "negative"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_fail
  expect_message "effect contract violation"
  source ny <<'NY'
use core

@effects(cap(read))
fn read_resource() int {
  1
}

@effects(cap(write))
fn write_resource() int {
  2
}

@effects(e)
fn run_callback(fnptr callback) int {
  callback()
}

@effects(none)
fn underdeclared_branch(bool choose_write) int {
  mut callback = read_resource
  if choose_write {
    callback = write_resource
  }
  run_callback(callback)
}

underdeclared_branch(false)
NY
}

