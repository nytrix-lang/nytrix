shape same_custom_callback_rows_survive_control_flow_joins {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "row", "callback", "control-flow"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(cap(read))
fn read_resource() int {
  1
}

@effects(e)
fn run_callback(fnptr callback) int {
  callback()
}

@effects(cap(read))
fn branch_alias_same_callback_row(bool choose_other) int {
  mut callback = read_resource
  if choose_other {
    callback = read_resource
  }
  run_callback(callback)
}

;; The declaration is effect-checked even though mutable fnptr invocation is
;; not the runtime behavior this row-analysis regression exercises.
assert(read_resource() == 1, "same custom callback rows survive branch joins")
NY
}

