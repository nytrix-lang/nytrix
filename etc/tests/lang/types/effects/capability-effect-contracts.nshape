shape matching_capability_rows_are_accepted {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "row"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(cap(read))
fn read_resource() int {
  1
}

@effects(cap(read))
fn forward_read() int {
  read_resource()
}

assert(forward_read() == 1, "matching named effect row is accepted")
NY
}

shape maximum_capability_effect_name_is_accepted {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "row", "boundary"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(cap(abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789a))
fn maximum_named_effect() int {
  7
}

@effects(cap(abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789a))
fn forward_maximum_named_effect() int {
  maximum_named_effect()
}

assert(forward_maximum_named_effect() == 7, "63-byte capability identity survives forwarding")
NY
}

shape mismatched_capability_rows_are_rejected {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "row", "negative"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_fail
  expect_message "effect contract violation"
  source ny <<'NY'
use core

@effects(cap(read))
fn read_resource() int {
  1
}

@effects(cap(write))
fn misdeclared() int {
  read_resource()
}

misdeclared()
NY
}

shape qualified_module_effect_rows_require_their_module_owner {
