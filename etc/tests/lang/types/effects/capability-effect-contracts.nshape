  expect compile_fail
  expect_message "effect contract violation"
  source ny <<'NY'
module project.storage(read_resource, nested_forward) {
  @effects(cap(read))
  fn read_resource() int {
    9
  }

  @effects(cap(read))
  fn nested_forward() int {
    @effects(none)
    fn local_read() int {
      read_resource()
    }
    local_read()
  }
}

@effects(cap("project.storage.read"))
fn underdeclared_nested_owner() int {
  project.storage.nested_forward()
}

underdeclared_nested_owner()
NY
}

