shape divergent_custom_callback_rows_union_at_if_join {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "row", "callback", "control-flow"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(cap(read))
fn read_resource() int {
  1
}

@effects(cap(write))
fn write_resource() int {
  2
}

@effects(e)
fn run_callback(fnptr callback) int {
  callback()
}

@effects(cap(read), cap(write))
fn branch_row_union(bool choose_write) int {
  mut callback = read_resource
  if choose_write {
    callback = write_resource
  }
  run_callback(callback)
}

assert(read_resource() == 1, "branch row union preserves normal execution")
NY
}

shape divergent_custom_callback_rows_union_at_loop_and_match_joins {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "row", "callback", "control-flow"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(cap(read))
fn read_resource() int {
  1
}

@effects(cap(write))
fn write_resource() int {
  2
}

@effects(e)
fn run_callback(fnptr callback) int {
  callback()
}

@effects(cap(read), cap(write))
fn loop_row_union() int {
  mut callback = read_resource
  for index in 0..1 {
    callback = write_resource
  }
  run_callback(callback)
}

@effects(cap(read), cap(write))
fn match_row_union(bool choose_write) int {
  mut callback = read_resource
  match choose_write {
    true -> { callback = write_resource }
    else { callback = read_resource }
  }
  run_callback(callback)
}

assert(read_resource() == 1, "loop and match joins retain both callback rows")
NY
}

shape nested_custom_effect_contract_is_accepted_by_matching_caller {
