shape returned_callback_containers_union_branch_effect_rows {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "row", "callback", "container", "control-flow"]
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(cap(read))
fn read_resource() int {
  1
}

@effects(cap(write))
fn write_resource() int {
  2
}

fn choose_callback(bool choose_write) tuple {
  if choose_write {
    return (write_resource, read_resource)
  }
  return (read_resource, write_resource)
}

@effects(e)
fn run_callback(fnptr callback) int {
  callback()
}

@effects(alloc, cap(read), cap(write))
fn invoke_returned_callback(bool choose_write, int index) int {
  def callbacks = choose_callback(choose_write)
  run_callback(callbacks[index])
}

0
NY
}

