shape ternary_callback_closure_rows_are_joined {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "row", "callback", "closure", "control-flow"]
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(cap(read))
fn read_resource() int {
  1
}

@effects(cap(write))
fn write_resource() int {
  2
}

@effects(cap(read), cap(write))
fn invoke_selected_callback(bool choose_write) int {
  def callback = choose_write ? write_resource : read_resource
  callback()
}
@effects(cap(read), cap(write))
fn invoke_literal_selected_callback(bool choose_write) int {
  def callback =
      choose_write ? (true ? write_resource : read_resource) : read_resource
  callback()
}

assert(invoke_selected_callback(false) == 1, "ternary callback keeps read row")
assert(invoke_selected_callback(true) == 2, "ternary callback keeps write row")
assert(invoke_literal_selected_callback(false) == 1,
       "literal ternary callback keeps the selected read ABI")
assert(invoke_literal_selected_callback(true) == 2,
       "nested literal ternary callback keeps the selected write ABI")
NY
}

