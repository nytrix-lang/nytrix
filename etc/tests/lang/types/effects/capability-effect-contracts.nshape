}

underdeclared()
NY
}

shape module_owned_capability_rows_match_qualified_contracts {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "modules"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

module project.storage(read_resource) {
  @effects(cap(read))
  fn read_resource() int {
    9
  }
}

@effects(cap("project.storage.read"))
fn matching_module_owner() int {
  project.storage.read_resource()
}

assert(matching_module_owner() == 9, "module-owned capability identity resolves")
NY
}

