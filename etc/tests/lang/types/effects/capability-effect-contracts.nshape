shape nested_module_function_effect_rows_use_lexical_call_names {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "modules", "nested"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

module project.storage(read_resource, nested_forward) {
  @effects(cap(read))
  fn read_resource() int {
    9
  }

  @effects(cap(read))
  fn nested_forward() int {
    @effects(cap(read))
    fn local_read() int {
      read_resource()
    }
    local_read()
  }
}

@effects(cap("project.storage.read"))
fn matching_nested_module_owner() int {
  project.storage.nested_forward()
}

assert(matching_nested_module_owner() == 9, "nested module effect rows retain lexical calls")
NY
}

shape nested_module_function_cannot_underdeclare_sibling_effects {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "capability", "modules", "nested", "negative"]
  template ny-test-case
