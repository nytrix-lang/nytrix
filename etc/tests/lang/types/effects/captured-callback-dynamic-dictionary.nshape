shape match_branch_dictionary_factory_joins_rows {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "callback", "factory", "branch", "match", "negative"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_fail
  expect_message "effect contract violation"
  source ny <<'NY'
use core

enum Choice { Storage, Audit }

@effects(cap("project.storage.read"))
fn storage_answer() int { 42 }

@effects(cap("project.audit.write"))
fn audit_answer() int { 7 }

@effects(alloc)
fn make_callbacks(Choice choice) dict {
  match choice {
    Choice.Storage -> { return {"run": storage_answer} }
    _ -> { return {"run": audit_answer} }
  }
}

@effects(alloc, read, cap("project.storage.read"))
fn invoke_factory_callback(Choice choice, str key) int {
  def callbacks = make_callbacks(choice)
  callbacks.get(key)()
}

invoke_factory_callback(Choice.Storage, "run")
NY
}

