shape dynamic_dictionary_callback_rows_union_for_lookup {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "callback", "capture", "dynamic-key"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_fail
  expect_message "effect contract violation"
  source ny <<'NY'
use core

@effects(cap("project.storage.read"))
fn storage_answer() int {
  42
}

@effects(cap("project.audit.write"))
fn audit_answer() int {
  7
}

@effects(alloc, read, cap("project.storage.read"))
fn invoke_dynamic_dictionary_callback(str key) int {
  def callbacks = {"storage": storage_answer, "audit": audit_answer}
  def captured = callbacks
  captured.get(key)() + captured[key]()
}

invoke_dynamic_dictionary_callback("storage")
NY
}

shape returned_literal_dictionary_callback_rows_are_tracked {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "callback", "capture", "factory", "negative"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_fail
  expect_message "effect contract violation"
  source ny <<'NY'
use core

@effects(cap("project.storage.read"))
fn storage_answer() int { 42 }

@effects(cap("project.audit.write"))
fn audit_answer() int { 7 }

@effects(alloc)
fn make_callbacks() dict {
  def original = {"storage": storage_answer, "audit": audit_answer}
  def callbacks = original
  return callbacks
}

@effects(alloc, read, cap("project.storage.read"))
fn invoke_factory_callback(str key) int {
  def callbacks = make_callbacks()
  callbacks.get(key)()
}

invoke_factory_callback("storage")
NY
}

shape callback_parameter_rows_flow_through_container_factory {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "callback", "factory", "parameter", "negative"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_fail
  expect_message "effect contract violation"
  source ny <<'NY'
use core

@effects(cap("project.storage.read"))
fn storage_answer() int { 42 }

@effects(alloc)
fn make_callbacks(fnptr callback) dict {
  def callback_alias = callback
  def callbacks = {"run": callback_alias}
  def result = callbacks
  return result
}

@effects(alloc, read)
fn invoke_factory_callback(str key) int {
  def local_callback = storage_answer
  def callback_alias = local_callback
  def callbacks = make_callbacks(callback_alias)
  callbacks.get(key)()
}

invoke_factory_callback("run")
NY
}

