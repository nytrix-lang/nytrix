shape mutated_dictionary_callback_rows_fail_closed {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "callback", "capture", "container", "negative"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_fail
  expect_message "effects are unknown"
  source ny <<'NY'
use core

@effects(io)
fn print_answer() int {
  print("answer through container\n")
  42
}

@effects(alloc, read, write, e)
fn make_container_callback(fnptr callback) fnptr {
  def callbacks = {"run": callback}
  def alias = callbacks
  alias.set("run", callback)
  return fn() { callbacks.get("run")() }
}

@effects(e)
fn run_eff(fnptr callback) int { callback() }

@effects(alloc, read, write)
fn invoke_container_callback() int {
  run_eff(make_container_callback(print_answer))
}

invoke_container_callback()
NY
}
