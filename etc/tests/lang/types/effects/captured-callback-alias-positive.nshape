shape captured_callback_alias_is_accepted_with_its_effect_row {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "callback", "alias", "capture"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(io)
fn print_answer() int {
  print("answer\n")
  42
}

@effects(e)
fn run_eff(fnptr callback) int {
  callback()
}

fn make_aliased_wrapped_callback(fnptr callback) fnptr {
  def captured = callback
  return fn() { captured() }
}

@effects(io, alloc)
fn invoke_aliased_wrapped_io_callback() int {
  run_eff(make_aliased_wrapped_callback(print_answer))
}

@effects(alloc, e)
fn make_nested_wrapped_callback(fnptr callback, bool choose) fnptr {
  mut captured = callback
  if choose {
    captured = callback
  } else {
    captured = callback
  }
  mut once = 1
  while once > 0 {
    captured = callback
    once -= 1
  }
  def first_wrapper = fn() { captured() }
  def forwarded = first_wrapper
  return fn() { forwarded() }
}

@effects(io, alloc)
fn invoke_nested_wrapped_io_callback() int {
  run_eff(make_nested_wrapped_callback(print_answer, true))
}

invoke_aliased_wrapped_io_callback()
invoke_nested_wrapped_io_callback()
print("captured callback row accepted")
NY
}

shape nested_captured_callback_requires_its_full_effect_row {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "callback", "alias", "capture", "negative"]
  template ny-test-case
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_fail
  expect_message "effect contract violation"
  source ny <<'NY'
use core

@effects(io)
fn print_answer() int {
  print("answer\n")
  42
}

@effects(e)
fn run_eff(fnptr callback) int {
  callback()
}

@effects(alloc, e)
fn make_nested_wrapped_callback(fnptr callback, bool choose) fnptr {
  mut captured = callback
  if choose {
    captured = callback
  } else {
    captured = callback
  }
  mut once = 1
  while once > 0 {
    captured = callback
    once -= 1
  }
  def first_wrapper = fn() { captured() }
  def forwarded = first_wrapper
  return fn() { forwarded() }
}

@effects(alloc)
fn invoke_nested_wrapped_io_callback() int {
  run_eff(make_nested_wrapped_callback(print_answer, false))
}

invoke_nested_wrapped_io_callback()
NY
}
