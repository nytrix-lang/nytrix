shape total_complement_measure_rejects_increase {
  family "runtime/proofs"
  generator "error"
  features ["proof", "termination", "total", "nonlinear-measure", "soundness"]
  template ny-compile-fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_fail
  expect_message "recursive termination is not certified"
  source ny <<'NY'
use core

@total
fn bad_complement_product_countdown(int value) int
    requires value >= 5 && value <= 10
    decreases(value * (10 - value)) {
  if value <= 5 { return 0 }
  bad_complement_product_countdown(value - 1)
}

bad_complement_product_countdown(10)
NY
}

shape total_nonlinear_measure_rejects_custom_operator {
  family "runtime/proofs"
  generator "error"
  features ["proof", "termination", "total", "operator", "soundness"]
  template ny-compile-fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_fail
  expect_message "recursive termination is not certified"
  source ny <<'NY'
use core

impl int {
  fn add_instead(self left, self right) int { left + right }
  operator * self: int = add_instead
}

@total
fn custom_square(int n) int
    requires n >= 0 && n <= 1
    decreases(n * n) {
  if n <= 0 { return 0 }
  custom_square(n - 1)
}

custom_square(1)
NY
}

shape bool_requires_rejects_false_actual {
  family "runtime/proofs"
  generator "error"
  features ["proof", "requires", "boolean", "soundness"]
  template ny-compile-fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_fail
  expect_message "precondition obligation failed"
  source ny <<'NY'
use core

fn needs_enabled(bool enabled) int requires enabled {
  1
}

needs_enabled(false)
NY
}
