shape total_boolean_measure_rejects_increase {
  family "runtime/proofs"
  generator "error"
  features ["proof", "termination", "total", "boolean-measure", "soundness"]
  template ny-compile-fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_fail
  expect_message "recursive termination is not certified"
  source ny <<'NY'
use core

@total
fn boolean_increase(bool active) int decreases(active) {
  if !active {
    return boolean_increase(true)
  }
  0
}

boolean_increase(false)
NY
}

shape total_mixed_boolean_integer_measure_rejects_increase {
  family "runtime/proofs"
  generator "error"
  features ["proof", "termination", "total", "lexicographic", "soundness"]
  template ny-compile-fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_fail
  expect_message "recursive termination is not certified"
  source ny <<'NY'
use core

@total
fn bad_mixed_measure(int remaining, bool active) int
    requires remaining >= 0 && remaining <= 100
    decreases((remaining, active)) {
  if active {
    return bad_mixed_measure(remaining, false)
  }
  if remaining < 10 {
    return bad_mixed_measure(remaining + 1, false)
  }
  0
}

bad_mixed_measure(0, true)
NY
}

shape total_boolean_prefix_integer_measure_rejects_increase {
  family "runtime/proofs"
  generator "error"
  features ["proof", "termination", "total", "lexicographic", "soundness"]
  template ny-compile-fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_fail
  expect_message "recursive termination is not certified"
  source ny <<'NY'
use core

@total
fn bad_boolean_prefix(bool active, int remaining) int
    requires remaining >= 0 && remaining <= 100
    decreases((active, remaining)) {
  if active {
    return bad_boolean_prefix(false, remaining)
  }
  if remaining < 100 {
    return bad_boolean_prefix(false, remaining + 1)
  }
  0
}

bad_boolean_prefix(true, 0)
NY
}

shape total_nonlinear_measure_requires_strict_descent {
  family "runtime/proofs"
  generator "error"
  features ["proof", "termination", "total", "nonlinear-measure", "soundness"]
