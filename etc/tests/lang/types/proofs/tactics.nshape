shape proof_tactics {
  family "runtime/proofs"
  generator "program"
  features ["proofs", "tactics"]
  template ny-test-case
  flags "--color=never"
  expect compile_and_run
  source ny <<'NY'
use core

fn lemma right_distrib(int a, int b, int c) {
   a * (b + c) == a * b + a * c
}

def proof p1 = prove(right_distrib(2, 3, 4), "by_fold by_range")
def proof p2 = prove(2 * 3 == 6, "by_fold")
def int n = 5
def proof p3 = prove(n > 0, "by_range")

assert(proof_matches(p1, right_distrib(2, 3, 4)), "p1 witness matches")
assert(proof_matches(p2, 2 * 3 == 6), "p2 witness matches")
assert(proof_matches(p3, n > 0), "p3 witness matches")
assert(true, "proof tactics complete")
NY
}
