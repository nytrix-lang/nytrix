  expect_message "'requires' condition is false or unproved for native lowering"
  source ny <<'NY'
fn quotient_at_most_zero(int value, int divisor) int
    requires value / divisor <= 0 {
  value
}

fn unsafe_zero_crossing(int value, int divisor) int
    requires value >= 0 && divisor >= -1 && divisor <= 1 {
  quotient_at_most_zero(value, divisor)
}

unsafe_zero_crossing(1, 1)
NY
}

