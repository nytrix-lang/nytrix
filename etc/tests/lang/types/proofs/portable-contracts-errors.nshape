  expect compile_fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect_message "'requires' condition is false or unproved for native lowering"
  source ny <<'NY'
@pure
fn match_positive_predicate(int value) bool {
  return match value {
    0 -> false
    else { value > 0 }
  }
}

fn needs_positive(int value) int
    requires match_positive_predicate(value) {
  value
}

fn weaker_premise(int value) int requires value != 0 {
  needs_positive(value)
}

weaker_premise(1)
NY
}

