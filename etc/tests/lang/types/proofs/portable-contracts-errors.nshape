shape unsupported_or_loop_guard_does_not_prove_relation {
  family "compiler-errors/proof"
  generator "error"
  features ["proof", "requires", "loop-flow", "soundness", "backend-parity"]
  template ny-compile-fail
  expect compile_fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect_message "'requires' condition is false or unproved for native lowering"
  source ny <<'NY'
fn greater_than(int lhs, int rhs) int requires lhs > rhs {
  lhs - rhs
}

fn unsafe_loop(int x, int y) int {
  mut i = 0
  while x > y || i < 2 {
    greater_than(x, y)
    i += 1
  }
  0
}

unsafe_loop(0, 1)
NY
}

shape loop_guard_fact_is_invalidated_after_parameter_rebind {
  family "compiler-errors/proof"
  generator "error"
  features ["proof", "requires", "loop-flow", "mutation", "soundness", "backend-parity"]
  template ny-compile-fail
  expect compile_fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect_message "'requires' condition is false or unproved for native lowering"
  source ny <<'NY'
fn positive(int value) int requires value > 0 {
  value
}

fn invalid_loop_rebind(int value) int {
  while value > 0 {
    value = 0
    positive(value)
  }
  0
}

invalid_loop_rebind(1)
NY
}

shape unsupported_or_c_style_for_guard_does_not_prove_relation {
  family "compiler-errors/proof"
  generator "error"
  features ["proof", "requires", "loop-flow", "for", "soundness", "backend-parity"]
  template ny-compile-fail
  expect compile_fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect_message "'requires' condition is false or unproved for native lowering"
  source ny <<'NY'
fn within(int index, int limit) int requires index >= 0 && index < limit {
  index
}

fn unsafe_for(int n) int {
  mut total = 0
  for (mut i = 0 i >= 0 || i < n i += 1) {
    total = total + within(i, n)
  }
  total
}

unsafe_for(5)
NY
}

