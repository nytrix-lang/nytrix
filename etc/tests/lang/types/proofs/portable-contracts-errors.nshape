shape iterable_range_fact_is_invalidated_when_bound_changes {
  family "compiler-errors/proof"
  generator "error"
  features ["proof", "requires", "iterable-range", "mutation", "soundness", "backend-parity"]
  template ny-compile-fail
  expect compile_fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect_message "'requires' condition is false or unproved for native lowering"
  source ny <<'NY'
fn within_inclusive(int index, int limit) int
    requires index >= 0 && index <= limit {
  index
}

fn caller(int initial_limit) int {
  mut limit = initial_limit
  mut total = 0
  for index in 0..limit {
    limit = 0
    total += within_inclusive(index, limit)
  }
  total
}

caller(5)
NY
}

