shape portable_range_match_pure_predicate {
  family "runtime/proofs"
  generator "program"
  features ["proofs", "requires", "match", "range-pattern", "backend-parity"]
  template ny-test-case
  expect compile_and_run
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  source ny <<'NY'
@pure
fn positive_in_range(int value) bool {
  return match value {
    1..10 -> true
    else { false }
  }
}

fn requires_range(int value) int requires positive_in_range(value) {
  value
}

fn forwards_range(int value) int requires value >= 1 && value <= 10 {
  requires_range(value)
}

assert(forwards_range(5) == 5, "closed integer range matches refine requires")
assert(forwards_range(1) == 1, "the lower range-match endpoint is included")
assert(forwards_range(10) == 10, "the upper range-match endpoint is included")
NY
}

shape portable_finite_match_exhaustiveness {
  family "runtime/proofs"
  generator "program"
  features ["proofs", "requires", "match", "finite-range", "backend-parity"]
  template ny-test-case
  expect compile_and_run
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  source ny <<'NY'
@pure
fn finite_positive(Fin<4> value) bool {
  return match value {
    0 -> false
    1..3 -> true
  }
}

fn needs_finite_positive(Fin<4> value) int requires finite_positive(value) {
  value
}

fn forwards_finite_match(Fin<4> value) int
    requires value >= 1 {
  needs_finite_positive(value)
}

assert(forwards_finite_match(3) == 3,
       "exhaustive Fin patterns prove the predicate without a default")
NY
}

shape portable_pure_predicate_if_initializer {
  family "runtime/proofs"
  generator "program"
  features ["proofs", "requires", "pure-predicate", "if-initializer", "backend-parity"]
  template ny-test-case
  expect compile_and_run
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  source ny <<'NY'
@pure
fn positive_from_local(int value) bool {
  if (def is_positive = value > 0 is_positive) {
    return true
  } else {
    return false
  }
}

fn requires_positive_local(int value) int
    requires positive_from_local(value) {
  value
}

fn forwards_positive_local(int value) int requires value >= 1 {
  requires_positive_local(value)
}

@pure
fn positive_from_early_guard(int value) bool {
  if (def is_positive = value > 0 is_positive) {
    return true
  }
  return false
}

fn requires_positive_early_guard(int value) int
    requires positive_from_early_guard(value) {
  value
}

fn forwards_positive_early_guard(int value) int requires value >= 1 {
  requires_positive_early_guard(value)
}

assert(forwards_positive_local(1) == 1,
       "pure predicate expansion substitutes immutable if initializer")
assert(forwards_positive_early_guard(2) == 2,
       "pure early-return guard substitutes immutable if initializer")
NY
}

shape portable_nested_expression_match_predicate {
  family "runtime/proofs"
  generator "program"
  features ["proofs", "requires", "pure-predicate", "match", "expression", "backend-parity"]
  template ny-test-case
  expect compile_and_run
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  source ny <<'NY'
@pure
fn nested_positive(int value) bool {
  return (match value {
    0 -> false
    else { value > 0 }
  }) || false
}

fn requires_nested_positive(int value) int requires nested_positive(value) {
  value
}

fn forwards_nested_positive(int value) int requires value >= 1 {
  requires_nested_positive(value)
}

@pure
fn preserve_boolean(bool value) bool { value }

@pure
fn nested_match_argument(int value) bool {
  return preserve_boolean(match value {
    0 -> false
    else { value > 0 }
  })
}

fn requires_nested_match_argument(int value) int
    requires nested_match_argument(value) {
  value
}

fn forwards_nested_match_argument(int value) int requires value >= 1 {
  requires_nested_match_argument(value)
}

assert(forwards_nested_positive(3) == 3,
       "a match nested in a boolean expression is lowered for proof")
assert(forwards_nested_match_argument(4) == 4,
       "a match nested in a pure-call argument is lowered for proof")
NY
}

shape portable_statement_range_match_predicate {
  family "runtime/proofs"
  generator "program"
  features ["proofs", "requires", "pure-predicate", "match", "range-pattern", "statement-match", "backend-parity"]
  template ny-test-case
