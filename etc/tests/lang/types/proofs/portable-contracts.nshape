shape portable_structural_measure_iterator_shadow_rejected {
  family "runtime/proofs"
  generator "error"
  features ["proofs", "decreases", "structural-measure", "loop-shadowing", "backend-parity"]
  template ny-compile-fail
  expect compile_fail
  expect_message "recursive termination is not certified"
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  source ny <<'NY'
enum ProofChain { Empty, Link(int value, ProofChain rest) }

@total
fn proof_chain_iterator_shadow(ProofChain chain, list<ProofChain> values) int
    decreases(chain) {
  match chain {
    ProofChain.Empty -> 0
    ProofChain.Link(_, rest) -> {
      for rest in values {
        proof_chain_iterator_shadow(rest, values)
      }
      0
    }
  }
}

print(proof_chain_iterator_shadow(ProofChain.Link(1, ProofChain.Empty), []))
NY
}

shape portable_nested_structural_measure_non_descending_rejected {
  family "runtime/proofs"
  generator "error"
  features ["proofs", "decreases", "structural-measure", "backend-parity"]
  template ny-compile-fail
  expect compile_fail
  expect_message "recursive termination is not certified"
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  source ny <<'NY'
enum ProofChain { Empty, Link(int value, ProofChain rest) }

@total
fn proof_chain_nested_stuck(ProofChain chain) int decreases(chain) {
  match chain {
    ProofChain.Empty -> 0
    ProofChain.Link(_, rest) -> {
      match rest {
        ProofChain.Empty -> 1
        ProofChain.Link(_, next) -> proof_chain_nested_stuck(chain)
      }
    }
  }
}

print(proof_chain_nested_stuck(ProofChain.Link(
    1, ProofChain.Link(2, ProofChain.Empty))))
NY
}

shape portable_contract_wide_guard_rejected {
  family "runtime/proofs"
  generator "error"
  features ["proofs", "requires", "integer-boundary", "backend-parity"]
