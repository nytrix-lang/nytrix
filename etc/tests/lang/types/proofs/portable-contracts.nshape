shape portable_structural_measure_shadowed_alias_rejected {
  family "runtime/proofs"
  generator "error"
  features ["proofs", "decreases", "structural-measure", "shadowing", "backend-parity"]
  template ny-compile-fail
  expect compile_fail
  expect_message "recursive termination is not certified"
  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  source ny <<'NY'
enum ProofChain { Empty, Link(int value, ProofChain rest) }

@total
fn proof_chain_shadowed_alias(ProofChain chain) int decreases(chain) {
  match chain {
    ProofChain.Empty -> 0
    ProofChain.Link(_, rest) -> {
      def smaller = rest
      if true {
        def smaller = chain
        return proof_chain_shadowed_alias(smaller)
      }
      1 + proof_chain_shadowed_alias(smaller)
    }
  }
}

print(proof_chain_shadowed_alias(ProofChain.Link(1, ProofChain.Empty)))
NY
}

shape portable_structural_measure_shadowed_sibling_rejected {
