  source ny <<'NY'
use core

fn negative(int n) int requires n < 0 {
  n
}

fn forward(int n) int requires n == 9223372036854775807 {
  if n < 9223372036854775808 {
    return negative(n)
  }
  0
}

print(forward(9223372036854775807i64))
NY
}

