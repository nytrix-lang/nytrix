  flags_matrix "--strict-types --native --run; --strict-types --native-backend=llvm --jit --jit-engine=mcjit; --strict-types --native-backend=llvm --jit --jit-engine=orc; --strict-types --native-only"
  source ny <<'NY'
@pure
fn positive_statement_range(int value) bool {
  match value {
    1..10 -> { return true }
    else { return false }
  }
}

fn requires_statement_range(int value) int
    requires positive_statement_range(value) {
  value
}

fn forwards_statement_range(int value) int
    requires value >= 1 && value <= 10 {
  requires_statement_range(value)
}

assert(forwards_statement_range(1) == 1,
       "statement range match includes its lower endpoint")
assert(forwards_statement_range(10) == 10,
       "statement range match includes its upper endpoint")
