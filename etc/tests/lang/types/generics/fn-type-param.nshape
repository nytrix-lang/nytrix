shape fn_type_param_dynamic_instantiation {
  family "runtime/language"
  generator "embedded"
  features [ny generics]
  template ny-test-case
  flags_matrix "--native-only -O0"
  expect compile_and_run
  expect_message "GENERIC-OK"
  source ny <<'NY'
use core

;; A declared type parameter is erased: `A x` lowers exactly like an
;; unannotated parameter, so one declaration serves int and str at runtime.
;; Per-instance static checking is not implemented; these calls prove the
;; erasure path reaches codegen for both value shapes.
fn id<A>(A x) A { x }
print(id(3))
print(id("s"))
print("GENERIC-OK")
NY
}

shape fn_type_param_multiple {
  family "runtime/language"
  generator "embedded"
  features [ny generics]
  template ny-test-case
  flags_matrix "--native-only -O0"
  expect compile_and_run
  expect_message "MULTI-OK"
  source ny <<'NY'
use core

;; Two declared parameters are independently erased; the call works without
;; naming them at the call site.
fn first<A, B>(A a, B b) A { a }
print(first(7, "ignored"))
print("MULTI-OK")
NY
}

shape fn_type_param_empty_list_negative {
  family "compiler-errors/frontend"
  generator "error"
  features [ny generics parse negative]
  template ny-compile-fail
  expect compile_fail
  expect_message "empty function type parameter list"
  source ny <<'NY'
fn id<>(int x) int { x }
NY
}

shape fn_type_param_unterminated_negative {
  family "compiler-errors/frontend"
  generator "error"
  features [ny generics parse negative]
  template ny-compile-fail
  expect compile_fail
  expect_message "expected '>' after function type parameters"
  source ny <<'NY'
fn id<A B>(int x) int { x }
NY
}

shape fn_implicit_type_binder {
  family "runtime/compiler"
  generator "embedded"
  features [ny generics implicit binders]
  template ny-test-case
  flags_matrix "--native-only; --native-backend=llvm --jit --jit-engine=orc"
  expect compile_and_run
  expect_stdout "IMPLICIT-OK"
  source ny <<'NY'
use core
;; `{Type A}` is the implicit-binder spelling of `<A>`: inferred per call,
;; never passed, and it may follow an explicit `<...>` list.
fn id{Type A}(A x) A { x }
fn first{Type A, B}(A a, B b) A { a }
fn both<A>{Type B}(A a, B b) A { a }
assert(id(3) == 3 && id("s") == "s", "implicit binder instantiates per call")
assert(first(7, "x") == 7 && both(4, 5) == 4, "mixed binder lists")
print("IMPLICIT-OK")
NY
}

shape fn_implicit_type_binder_inconsistent_negative {
  family "compiler-errors/type"
  generator "error"
  features [ny generics implicit binders negative]
  template ny-compile-fail
  expect compile_fail
  expect_message "instantiated inconsistently"
  source ny <<'NY'
use core
fn same{Type A}(A a, A b) A { a }
same(1, "s")
NY
}

