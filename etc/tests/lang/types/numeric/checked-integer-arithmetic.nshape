shape checked_integer_arithmetic
{
  family "runtime/types"
  generator "runtime"
  features ["integer", "checked", "overflow", "saturating"]
  template ny-test-case
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  source ny <<'NY'
use core
use core.error (ERR_DIV_ZERO, ERR_OVERFLOW, ERR_TYPE, error_kind)
use core.math.big (bigint, bigint_to_int)
use core.math.checked

def i64_min = bigint_to_int(bigint("-9223372036854775808"))
def i64_max = bigint_to_int(bigint("9223372036854775807"))
fn error_kind_of(any result) str { error_kind(__unwrap(result)) }

assert(unwrap(checked_add(20, 22)) == 42, "checked addition success")
assert(error_kind_of(checked_add(i64_max, 1)) == ERR_OVERFLOW, "checked addition overflow")
assert(unwrap(checked_sub(20, 22)) == -2, "checked subtraction success")
assert(error_kind_of(checked_sub(i64_min, 1)) == ERR_OVERFLOW, "checked subtraction overflow")
assert(unwrap(checked_mul(-7, 6)) == -42, "checked multiplication success")
assert(error_kind_of(checked_mul(i64_max, 2)) == ERR_OVERFLOW, "checked multiplication overflow")
assert(unwrap(checked_div(-7, 2)) == -3, "checked division truncates toward zero")
assert(error_kind_of(checked_div(i64_min, -1)) == ERR_OVERFLOW, "checked division overflow")
assert(error_kind_of(checked_div(1, 0)) == ERR_DIV_ZERO, "checked division by zero")
assert(error_kind_of(checked_neg(i64_min)) == ERR_OVERFLOW, "checked negation overflow")
assert(saturating_add(i64_max, 1) == i64_max, "saturating addition clamps")
assert(saturating_sub(i64_min, 1) == i64_min, "saturating subtraction clamps")
assert(saturating_mul(i64_min, 2) == i64_min, "saturating multiplication clamps negative overflow")
assert(error_kind_of(checked_add(1.5, 2)) == ERR_TYPE,
       "checked arithmetic rejects floats")
NY
}
