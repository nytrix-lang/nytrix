shape semantic_reflection_records {
  family "runtime/compiler"
  generator "embedded"
  features ["ny", "reflection", "semantic", "immutable", "versioned"]
  timeout 180
  template ny-test-case
  flags_matrix "--native --run; --native-only; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc"
  expect compile_and_run
  source ny <<'SRC'
use core
use core.reflect (semantic_snapshot, semantic_get, semantic_items,
                      semantic_functions, semantic_find_function,
                      semantic_find_function_at,
                      semantic_layouts, semantic_find_layout,
                      semantic_expressions, semantic_find_expression,
                      semantic_calls, semantic_find_call,
                      semantic_call_effects, semantic_obligations,
                      semantic_find_obligation,
                      semantic_statement_effects,
                      semantic_find_statement_effect,
                      semantic_diagnostics, semantic_find_diagnostic,
                      semantic_signature, semantic_parameters,
                      semantic_return, semantic_signature_effects,
                      semantic_expression_type,
                      semantic_expression_representation,
                      semantic_expression_ownership,
                      semantic_expression_mutable,
                      semantic_expression_alias_class,
                      semantic_expression_effects,
                      semantic_expression_custom_effect_row,
                      semantic_statement_custom_effect_row)

fn semantic_has_mutable_container(any value) bool {
   if is_dict(value) || is_list(value) { return true }
   if is_tuple(value) {
      mut i = 0
      while i < value.len {
         if semantic_has_mutable_container(value.get(i)) { return true }
         i += 1
      }
   }
   false
}

@effects(all)
fn test_semantic_snapshot() {
   def artifact = "{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[{\"name\":\"compute\",\"semantic_signature\":{\"schema\":\"nytrix.semantic.signature\",\"version\":1,\"effects\":{\"contract_known\":true}},\"expression_facts\":{\"schema\":\"nytrix.semantic.expressions\",\"version\":1,\"items\":[{\"kind\":\"call\",\"type_resolved\":true,\"type\":\"int\",\"representation\":\"raw_int\",\"ownership\":\"owned\",\"mutable\":false,\"alias_class\":4,\"source_origin\":{\"file\":\"semantic.ny\",\"line\":7,\"column\":4},\"expression_effects\":{\"schema\":\"nytrix.semantic.expression-effects\",\"version\":1,\"known\":true,\"expression_kind\":\"call\",\"inferred_builtin_row\":\"ny.effect-row.v1{}\"},\"callee_effects\":{\"schema\":\"nytrix.semantic.call-effects\",\"version\":1,\"known\":false},\"obligations\":{\"schema\":\"nytrix.semantic.obligations\",\"version\":1,\"call_origin\":{\"file\":\"semantic.ny\",\"line\":7,\"column\":4},\"requires\":{\"formula\":true,\"status\":\"proved\"},\"decreases\":{\"method\":\"integer_measure\",\"status\":\"proved\"}}}]}}],\"layouts\":{\"schema\":\"nytrix.semantic.layouts\",\"version\":1,\"items\":[{\"name\":\"Packet\",\"fields\":[{\"name\":\"tag\",\"type\":\"i32\",\"offset\":0}]}]},\"diagnostics\":[]}}"
   def decoded = semantic_snapshot(artifact)
   assert(decoded.get("ok"),
          "versioned typed semantic artifact is accepted: " +
             str(decoded.get("error")))
   def snapshot = decoded.get("value")
   assert(snapshot[0] == "nytrix.reflect.semantic" && snapshot[1] == 1,
          "semantic reflection exposes a versioned immutable envelope")
   def typed = snapshot[2]
   def functions = semantic_items(semantic_get(typed, "functions"))
   def function = functions.get(0)
   def semantic_sig = semantic_signature(function)
   assert(semantic_get(semantic_sig, "schema") ==
             "nytrix.semantic.signature" &&
          semantic_parameters(function).len == 0 &&
          is_nil(semantic_return(function)) &&
          semantic_get(semantic_signature_effects(function),
                       "contract_known"),
          "signature accessors preserve available facts and leave missing slots absent")
   assert(semantic_get(function, "name") == "compute",
          "semantic records support immutable field lookup")
   def signature = semantic_get(function, "semantic_signature")
   assert(semantic_get(signature, "schema") == "nytrix.semantic.signature" &&
          semantic_get(signature, "version") == 1 &&
          semantic_get(semantic_get(signature, "effects"), "contract_known"),
          "typed signature and effect facts preserve their versioned schemas")
   def expression_facts = semantic_get(function, "expression_facts")
   def expressions = semantic_items(semantic_get(expression_facts, "items"))
   def expression = expressions.get(0)
   def origin = semantic_get(expression, "source_origin")
   assert(semantic_get(expression, "type") == "int" &&
          semantic_expression_type(expression) == "int" &&
          semantic_expression_representation(expression) == "raw_int" &&
          semantic_expression_ownership(expression) == "owned" &&
          !bool(semantic_expression_mutable(expression)) &&
          semantic_expression_alias_class(expression) == 4 &&
          semantic_get(semantic_expression_effects(expression), "known") &&
          semantic_get(semantic_get(expression, "callee_effects"), "known") == false &&
          semantic_get(semantic_get(expression, "obligations"), "version") == 1 &&
          semantic_get(origin, "line") == 7,
          "type, ownership, effect, origin, and obligation records survive freezing")
   assert(semantic_calls(function).len == 1 &&
          semantic_find_call(function, 7, 4) == expression &&
          semantic_get(semantic_call_effects(expression), "known") == false &&
          is_nil(semantic_call_effects(origin)),
          "call lookup and effect access expose immutable call facts")
   def obligations = semantic_obligations(function)
   def located_obligation = semantic_find_obligation(
      function, "requires", 7, 4, "semantic.ny")
   assert(obligations.len == 1, "call obligation enumeration finds the record")
   assert(semantic_get(located_obligation, "schema") ==
             "nytrix.semantic.obligations",
          "requires lookup returns an obligation envelope")
   assert(semantic_get(semantic_get(located_obligation, "requires"),
                       "status") == "proved",
          "requires lookup preserves its checked status")
   assert(semantic_get(semantic_find_obligation(function, "decreases", 7,
                                                 4), "schema") ==
             "nytrix.semantic.obligations",
          "decreases lookup returns its checked record")
   assert(is_nil(semantic_find_obligation(function, "unknown", 7, 4)) &&
          is_nil(semantic_find_obligation(function, "requires", 8)),
          "invalid and missing obligation lookups fail closed")
   def statement_snapshot = semantic_snapshot(
      "{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[{\"name\":\"control\",\"statement_effects\":{\"schema\":\"nytrix.semantic.statements\",\"version\":1,\"items\":[{\"schema\":\"nytrix.semantic.statement-effects\",\"version\":1,\"kind\":\"if\",\"known\":true,\"source_origin\":{\"file\":\"control.ny\",\"line\":4,\"column\":2}},{\"schema\":\"nytrix.semantic.statement-effects\",\"version\":1,\"kind\":\"while\",\"known\":false,\"source_origin\":{\"file\":\"control.ny\",\"line\":8,\"column\":2}}]}}],\"layouts\":[],\"diagnostics\":[]}}")
   def control_function = semantic_find_function(statement_snapshot.get("value"),
                                                 "control")
   def if_effect = semantic_find_statement_effect(control_function, "if", 4,
                                                  2, "control.ny")
   assert(semantic_statement_effects(control_function).len == 2 &&
          semantic_get(if_effect, "known") == true &&
          semantic_get(semantic_find_statement_effect(control_function,
                            "while", 8), "known") == false &&
          is_nil(semantic_find_statement_effect(control_function, "if", 9)),
          "statement effects are queryable by kind and authored location")
   def diagnostic_snapshot = semantic_snapshot(
      "{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[],\"layouts\":[],\"diagnostics\":[{\"code\":\"E100\",\"message\":\"first\",\"file\":\"one.ny\",\"line\":3,\"col\":2},{\"code\":\"E100\",\"message\":\"second\",\"file\":\"two.ny\",\"line\":4,\"col\":1}]}}")
   def diagnostics = semantic_diagnostics(diagnostic_snapshot.get("value"))
   def first_diagnostic = semantic_find_diagnostic(
      diagnostic_snapshot.get("value"), "E100", "one.ny", 3, 2)
   assert(diagnostics.len == 2 &&
          semantic_get(first_diagnostic, "message") == "first" &&
          is_nil(semantic_find_diagnostic(diagnostic_snapshot.get("value"),
                                          "E100")) &&
          is_nil(semantic_find_diagnostic(diagnostic_snapshot.get("value"),
                                          "E404")),
          "diagnostics are immutable and ambiguous lookups fail closed")
   def custom_rows_snapshot = semantic_snapshot(
      "{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[{\"name\":\"rows\",\"expression_facts\":{\"schema\":\"nytrix.semantic.expressions\",\"version\":1,\"items\":[{\"kind\":\"binary\",\"expression_effects\":{\"schema\":\"nytrix.semantic.expression-effects\",\"version\":1,\"inferred_custom_row\":\"ny.effect-row.v1{example.effect=unit}\"}}]},\"statement_effects\":{\"schema\":\"nytrix.semantic.statements\",\"version\":1,\"items\":[{\"schema\":\"nytrix.semantic.statement-effects\",\"version\":1,\"kind\":\"return\",\"inferred_custom_row\":\"ny.effect-row.v1{example.effect=unit}\"}]}}],\"layouts\":[],\"diagnostics\":[]}}")
   def row_function = semantic_find_function(custom_rows_snapshot.get("value"),
                                             "rows")
   def row_expression = semantic_expressions(row_function).get(0)
   def row_statement = semantic_statement_effects(row_function).get(0)
   assert(semantic_expression_custom_effect_row(row_expression) ==
             "ny.effect-row.v1{example.effect=unit}" &&
          semantic_statement_custom_effect_row(row_statement) ==
             "ny.effect-row.v1{example.effect=unit}" &&
          is_nil(semantic_expression_custom_effect_row(expression)) &&
          is_nil(semantic_statement_custom_effect_row(if_effect)),
          "direct custom-row accessors preserve known rows and return nil for unknown rows")
   def layout_facts = semantic_get(typed, "layouts")
   def layouts = semantic_items(layout_facts)
   assert(layouts.len == 1, "versioned layout container exposes its items")
   assert(semantic_get(layouts.get(0), "name") == "Packet",
          "layout item name survives freezing")
   assert(semantic_items(semantic_get(layouts.get(0), "fields")).len == 1,
          "layout field container exposes its items")
   def first_field = semantic_items(semantic_get(layouts.get(0), "fields")).get(0)
   assert(semantic_get(first_field, "offset") == 0,
          "layout and field facts remain immutable records")
   def duplicate_names = semantic_snapshot(
      "{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[{\"name\":\"run\",\"owner\":\"left\",\"source_origin\":{\"file\":\"a.ny\",\"line\":1,\"column\":1}},{\"name\":\"run\",\"owner\":\"right\",\"source_origin\":{\"file\":\"b.ny\",\"line\":2,\"column\":1}}],\"layouts\":[{\"name\":\"Node\",\"owner\":\"left\"},{\"name\":\"Node\",\"owner\":\"right\"}],\"diagnostics\":[]}}")
   def duplicate_snapshot = duplicate_names.get("value")
   assert(semantic_functions(duplicate_snapshot).len == 2 &&
          is_nil(semantic_find_function(duplicate_snapshot, "run")) &&
          semantic_get(semantic_find_function(duplicate_snapshot, "run",
                                               "right"), "owner") == "right",
          "function lookup fails closed on duplicate names and accepts an owner")
   assert(semantic_get(semantic_find_function_at(duplicate_snapshot, "run",
                    2, 1, "b.ny"), "owner") == "right",
          "function lookup resolves same-named declarations by source origin")
   def ambiguous_origin_snapshot = semantic_snapshot(
      "{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[{\"name\":\"run\",\"source_origin\":{\"file\":\"a.ny\",\"line\":1,\"column\":1}},{\"name\":\"run\",\"source_origin\":{\"file\":\"a.ny\",\"line\":1,\"column\":1}}],\"layouts\":[],\"diagnostics\":[]}}")
   assert(is_nil(semantic_find_function_at(ambiguous_origin_snapshot,
                    "run", 1, 1, "a.ny")),
          "function lookup rejects duplicate declaration origins")
   def malformed_origin_snapshot = semantic_snapshot(
      "{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[{\"name\":\"run\",\"source_origin\":{\"file\":\"bad.ny\",\"line\":\"2\",\"column\":1},\"expression_facts\":{\"schema\":\"nytrix.semantic.expressions\",\"version\":1,\"items\":[{\"kind\":\"call\",\"source_origin\":{\"file\":\"bad.ny\",\"line\":2,\"column\":\"1\"}}]}}],\"layouts\":[],\"diagnostics\":[]}}")
   def malformed_origin_function = semantic_functions(
      malformed_origin_snapshot.get("value")).get(0)
   assert(is_nil(semantic_find_function_at(malformed_origin_snapshot.get("value"),
                    "run", 2, 1, "bad.ny")) &&
          is_nil(semantic_find_call(malformed_origin_function, 2, 1,
                                    "bad.ny")) &&
          is_nil(semantic_find_expression(malformed_origin_function,
                    "call", 2, 1, "bad.ny")),
          "location lookup rejects malformed source-origin fields")
   assert(semantic_layouts(duplicate_snapshot).len == 2 &&
          is_nil(semantic_find_layout(duplicate_snapshot, "Node")) &&
          semantic_get(semantic_find_layout(duplicate_snapshot, "Node",
                                            "right"), "owner") == "right",
          "layout lookup fails closed on duplicate names and accepts an owner")
   def duplicate_expression_snapshot = semantic_snapshot(
      "{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[{\"name\":\"lookup\",\"expression_facts\":{\"schema\":\"nytrix.semantic.expressions\",\"version\":1,\"items\":[{\"kind\":\"call\",\"source_origin\":{\"file\":\"lookup.ny\",\"line\":3,\"column\":2}},{\"kind\":\"call\",\"source_origin\":{\"file\":\"other.ny\",\"line\":3,\"column\":2}}]}}],\"layouts\":[],\"diagnostics\":[]}}")
   def lookup_function = semantic_find_function(
      duplicate_expression_snapshot.get("value"), "lookup")
   assert(semantic_expressions(lookup_function).len == 2 &&
          semantic_calls(lookup_function).len == 2 &&
          is_nil(semantic_find_expression(lookup_function, "call", 3, 2)) &&
          is_nil(semantic_find_call(lookup_function, 3, 2)) &&
          semantic_get(semantic_find_call(lookup_function, 3, 2,
                                           "other.ny"), "kind") == "call" &&
          semantic_get(semantic_find_expression(lookup_function, "call", 3,
                                                  2, "other.ny"), "kind") ==
             "call" &&
          is_nil(semantic_find_expression(lookup_function, "call", 4)),
          "expression lookup filters files and rejects ambiguous/missing locations")
   def duplicate_obligation_snapshot = semantic_snapshot(
      "{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[{\"name\":\"proofs\",\"expression_facts\":{\"schema\":\"nytrix.semantic.expressions\",\"version\":1,\"items\":[{\"kind\":\"call\",\"source_origin\":{\"file\":\"proofs.ny\",\"line\":9,\"column\":3},\"obligations\":{\"schema\":\"nytrix.semantic.obligations\",\"version\":1,\"call_origin\":{\"file\":\"proofs.ny\",\"line\":9,\"column\":3},\"requires\":{\"status\":\"proved\"}}},{\"kind\":\"call\",\"source_origin\":{\"file\":\"proofs.ny\",\"line\":9,\"column\":3},\"obligations\":{\"schema\":\"nytrix.semantic.obligations\",\"version\":1,\"call_origin\":{\"file\":\"proofs.ny\",\"line\":9,\"column\":3},\"requires\":{\"status\":\"proved\"}}}]}}],\"layouts\":[],\"diagnostics\":[]}}")
   def duplicate_obligation_function = semantic_find_function(
      duplicate_obligation_snapshot.get("value"), "proofs")
   assert(semantic_obligations(duplicate_obligation_function).len == 2 &&
          is_nil(semantic_find_obligation(duplicate_obligation_function,
                                          "requires", 9, 3,
                                          "proofs.ny")),
          "obligation lookup fails closed for ambiguous call origins")
   def invalid_version_artifact =
      "{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[{\"schema\":\"nytrix.semantic.signature\",\"version\":true}],\"layouts\":[],\"diagnostics\":[]}}"
   mut deeply_nested =
      "{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[{\"nested\":"
   mut depth = 0
   while depth < 70 {
      deeply_nested += "["
      depth += 1
   }
   deeply_nested += "0"
   while depth > 0 {
      deeply_nested += "]"
      depth -= 1
   }
   deeply_nested += "}],\"layouts\":[],\"diagnostics\":[]}}"
   assert(is_tuple(typed) && is_tuple(functions) && is_tuple(function) &&
          is_tuple(expressions) && is_tuple(expression) && is_tuple(origin),
          "nested JSON objects and arrays are converted to tuples")
   assert(!semantic_has_mutable_container(snapshot),
          "no mutable list or dictionary escapes in nested semantic facts")
   assert(!semantic_snapshot("{broken").get("ok"),
          "malformed JSON fails closed")
   assert(!semantic_snapshot("{\"schema\":\"typed_ast.v1\",\"stage\":\"ast\"}").get("ok"),
          "wrong-stage artifacts fail closed")
   assert(!semantic_snapshot("{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{}}").get("ok"),
          "incomplete artifacts fail closed")
   assert(!semantic_snapshot("{\"schema\":\"typed_ast.v1\",\"stage\":\"hm\",\"typed\":{\"schema\":\"typed_ast.v1\",\"engine\":\"type-pipeline-v1\",\"functions\":[{\"schema\":\"nytrix.semantic.future\",\"version\":9}],\"layouts\":[],\"diagnostics\":[]}}").get("ok"),
          "unknown schemas fail closed")
   assert(!semantic_snapshot(invalid_version_artifact).get("ok"),
          "invalid schema versions fail closed")
   assert(semantic_snapshot(deeply_nested).get("error") ==
             "semantic artifact exceeds nesting limit",
          "deeply nested artifacts fail closed")
}

test_semantic_snapshot()
SRC
}
