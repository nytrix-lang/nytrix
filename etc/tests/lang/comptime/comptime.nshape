assert(comptime_dict.get("nested").get("answer") == 42,
   "comptime nested dictionary")
def comptime_dict_duplicate = comptime{
   return {"key":1, "key":2}
}
assert(comptime_dict_duplicate.get("key") == 2 &&
       comptime_dict_duplicate.len == 1,
   "comptime dictionary literals preserve last-write and unique length")
