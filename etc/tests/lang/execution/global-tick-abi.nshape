shape test_global_tick_abi {
  family "runtime/execution"
  generator "embedded"
  features ["ny", "test"]
  template ny-test-case
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time (ticks)
use core.os.time as T

def t0 = ticks()
def t1 = ticks()
assert(t0 > 0, "inferred global tick is a positive raw nanosecond count")
assert(t1 >= t0 && t1 - t0 < 1000000000,
   "repeated inferred global ticks stay in the integer ABI")
assert(to_str(t0) == to_str(t0 + 0),
   "dynamic and arithmetic consumers agree on an inferred global tick")
def int typed_t0 = ticks()
def int typed_t1 = ticks()
assert(typed_t0 > 0, "typed global tick remains a positive raw count")
assert(typed_t1 >= typed_t0 && typed_t1 - typed_t0 < 1000000000,
   "typed global ticks stay in the integer ABI")

;; Dynamic-by-name module call path: fully qualified and alias-qualified
;; lookups must keep the same raw-int ABI as the named import.
def q0 = core.os.time.ticks()
def q1 = core.os.time.ticks()
assert(q0 > 0, "qualified inferred tick is a positive raw nanosecond count")
assert(q1 >= q0 && q1 - q0 < 1000000000,
   "repeated qualified ticks stay in the integer ABI")
def int typed_q0 = core.os.time.ticks()
assert(typed_q0 > 0, "qualified typed tick remains a positive raw count")
def a0 = T.ticks()
def int typed_a0 = T.ticks()
assert(a0 > 0, "alias-qualified inferred tick is a positive raw nanosecond count")
assert(typed_a0 > 0, "alias-qualified typed tick remains a positive raw count")
print("global tick ABI passed")
NY
}
