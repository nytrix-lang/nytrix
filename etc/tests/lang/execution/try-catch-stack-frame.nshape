shape try_catch_stack_frame {
  family "runtime/execution"
  generator "regression"
  features [ny try catch stack closure]
  template ny-test-case
  flags_matrix "--native --run; --native-only; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc"
  expect compile_and_run
  source ny <<'NY'
use core

@effects(all)
fn catch_value(fnptr thunk, int sentinel) int {
    mut result = sentinel
    try {
        thunk()
    } catch _ {
        result = sentinel + 2
    }
    return result
}

@effects(all)
fn raise_value() any {
    panic("stack-frame exception")
}

fn normal_value() int { 7 }

assert(catch_value(raise_value, 40) == 42,
    "jump buffer survives parameter initialization and catch preserves locals")
assert(catch_value(normal_value, 40) == 40,
    "normal try completion preserves the same parameter")
assert(catch_value(fn() { catch_value(raise_value, 10) }, 30) == 30,
    "nested exception frames restore the outer handler")
print("try-catch stack frame passed")
NY
}
