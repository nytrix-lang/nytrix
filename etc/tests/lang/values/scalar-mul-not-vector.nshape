shape scalar_mul_not_vector {
  family "runtime/values"
  generator "embedded"
  features ["ny", "test", "native", "scalar", "vector-dispatch"]
  estimate_ms 26000
  template ny-test-case
  flags_matrix "--native --run -O0; --native --run -O3; --native-backend=llvm --jit --jit-engine=mcjit -O0; --native-backend=llvm --jit --jit-engine=mcjit -O3; --native-backend=llvm --jit --jit-engine=orc -O0; --native-backend=llvm --jit --jit-engine=orc -O3; --native-only -O0; --native-only -O3"
  expect compile_and_run
  source ny <<'NY'
use core

mut n = 2
mut primes = 0
while n < 100 {
   mut d = 2
   mut prime = 1
   while d * d <= n {
      if n % d == 0 { prime = 0 }
      d += 1
   }
   if prime { primes += 1 }
   n += 1
}
assert(primes == 25, "integer multiplication stays scalar inside loop bounds")
NY
}
