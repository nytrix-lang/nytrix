shape test_dynamic_float_arithmetic_abi {
  family "runtime/values"
  generator "regression"
  features ["ny", "test", "runtime", "abi", "float"]
  template ny-test-case
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

def d = __flt_sqrt(4.0)
assert_eq(1.0 / d, 0.5, "static float divided by dynamic float")
assert_eq(d / 2.0, 1.0, "dynamic float divided by static float")
assert_eq(1.0 * d, 2.0, "static float multiplied by dynamic float")
assert_eq(d * 2.0, 4.0, "dynamic float multiplied by static float")
NY
}
