shape test_bool {
  family "native/values"
  generator "embedded"
  features ["ny", "test"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.error
use core.reflect
use core.io

; Boolean literals
assert_eq(true, true)
assert_eq(false, false)
assert_eq(!true, false)
assert_eq(!false, true)
assert_eq(!is_nil(0), true)
assert_eq(!is_nil(nil), false)
assert_eq(true && true, true)
assert_eq(true && false, false)
assert_eq(false || true, true)
assert_eq(false || false, false)

; Negation of comparisons
fn not_gt(i64 a, i64 b) bool { !(a > b) }
assert_eq(not_gt(3, 5), true)
assert_eq(not_gt(5, 3), false)

; Large constants
assert_eq(2147483647, 2147483647)
assert_eq(-2147483648, -2147483648)
assert_eq(0x7FFFFFFFFFFFFFFF, 9223372036854775807)

; Zero and negative constants
assert_eq(0, 0)
assert_eq(-0, 0)
assert_eq(-1, -1)

; Constant folding with mixed operations
fn complex_const() i64 { (2 + 3) * (10 - 4) / 3 }
assert_eq(complex_const(), 10)
print("✓ native boolean tests passed")
NY
}

shape tagged_zero_conditions {
  family "runtime/values"
  generator "regression"
  features ["ny", "bool", "dynamic", "abi"]
  template ny-test-case
  expect compile_and_run
  flags_matrix "--native --run -O0; --native --run -O3; --native-only -O0; --native-only -O3; --native-backend=llvm --jit --jit-engine=mcjit"
  source ny <<'NY'
use core
fn present(any values) bool {
   def value = values.get("value", 0)
   if value { return true }
   false
}
fn both(any values) bool {
   def value = values.get("value", 0)
   value && (1 < 2)
}
fn either(any values) bool {
   def value = values.get("value", 0)
   value || (2 < 1)
}
fn absent(any values) bool {
   def value = values.get("value", 0)
   !value
}
assert(!present({}))
assert(!present({"value": 0}))
assert(present({"value": 1}))
assert(present({"value": 2}))
assert(!present({"value": false}))
assert(present({"value": true}))
assert(!both({"value": 0}))
assert(both({"value": 1}))
assert(!either({"value": 0}))
assert(either({"value": 1}))
assert(absent({"value": 0}))
assert(!absent({"value": 1}))
assert(!absent({"value": 2}))
assert((1 < 2) && (2 < 3))
assert(!(2 < 1))
print("TAGGED-ZERO-CONDITIONS-OK")
NY
}
