shape bigint_short_arithmetic_oracle {
  family "runtime/values"
  generator "embedded"
  features ["ny", "test", "bigint", "division", "multiplication", "native", "oracle"]
  template ny-test-case
  flags_matrix "--native-only -O0; --native-only -O3; --native-backend=llvm --jit --jit-engine=mcjit -O3; --native-backend=llvm --jit --jit-engine=orc -O3"
  expect compile_and_run
  source ny <<'NY'
use core
use core.math.big

fn check(str left, str right, str product, str quotient, str remainder) {
  def a = bigint_from_str(left)
  def b = bigint_from_str(right)
  assert(bigint_to_str(bigint_mul(a, b)) == product, "exact product")
  assert(bigint_to_str(bigint_div(a, b)) == quotient, "truncated quotient")
  assert(bigint_to_str(bigint_mod(a, b)) == remainder, "floor remainder")
  assert(bigint_to_str(a) == left, "left input preserved")
  assert(bigint_to_str(b) == right, "right input preserved")
}
