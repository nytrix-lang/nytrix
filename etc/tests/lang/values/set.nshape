shape test_set {
  family "runtime/values"
  generator "embedded"
  features ["ny", "test"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.set_mod as set_mod

mut strings = set()
mut i = 0
while i < 300 {
   strings = strings.add("key-" + to_str(i))
   i += 1
}

assert(strings.contains("key-42"), "set contains dynamic string before duplicate")
strings = strings.add("key-42")
assert(strings.len == 300, "set duplicate string after many inserts must not grow")
assert(set_mod.len(strings) == 300, "set module length preserves the set count")
assert(set_mod.len([]) == 0, "set module length rejects non-set values")
mut ips = set()
ips = ips.add("227.15.198.129")
ips = ips.add("227.15.198.129")
assert(ips.len == 1, "set duplicate literal string must not grow")
print("✓ set tests passed")
NY
}
