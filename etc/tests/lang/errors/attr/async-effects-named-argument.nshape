shape async_effects_named_arguments_fail_closed {
  family "compiler-errors/attr"
  generator "error"
  features ["error", "attr", "async-effects", "negative", "diagnostic"]
  template ny-compile-fail
  expect compile_fail
  expect_message "async call syntax does not support named arguments"
  source ny <<'NY'
use core

@async_effects
@effects(io)
fn effectful_answer(base=41) int {
  print("")
  base + 1
}

await effectful_answer(base=8)
NY
}
