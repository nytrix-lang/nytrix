shape raw_memcmp_read_effect_cannot_be_omitted {
  family "typing/effects"
  generator "regression"
  features ["error", "typing", "effects", "runtime", "memory", "negative"]
  template ny-test-case
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "declared @effects(none) but inferred effects=read"
  source ny <<'NY'
use core

@effects(none)
fn bad_compare() int {
  rt_memcmp_raw(0, 0, 0)
}

bad_compare()
NY
}

