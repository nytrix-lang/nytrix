shape unknown_collection_callback_effects_remain_unknown {
  family "typing/effects"
  generator "regression"
  features ["ny" "test" "typing" "effects" "unknown" "callback"]
  template ny-test-case
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "effect policy violation in 'std.project.invoke': effects are unknown"
  source ny <<'NY'
module std.project(
  invoke
)

fn invoke(seq items, fnptr callback) {
  items.map(callback)
}

print("unreachable")
NY
}
