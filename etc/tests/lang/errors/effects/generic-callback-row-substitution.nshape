shape reassigned_callback_alias_row_reaches_caller_contract {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "higher-order", "callback", "row", "soundness"]
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "declared @effects(none) but inferred effects=io"
  source ny <<'NY'
module std.project(
  invalid, run_eff, pure_answer, print_answer
)

fn pure_answer() int { 24 }

@effects(io)
fn print_answer() int {
  print("answer\n")
  42
}

@effects(e)
fn run_eff(fnptr callback) int {
  callback()
}

@effects(none)
fn invalid() int {
  mut callback = pure_answer
  callback = print_answer
  run_eff(callback)
}

invalid()
NY
}

shape branch_reassigned_callback_joins_effect_rows {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "higher-order", "callback", "row", "soundness"]
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "declared @effects(none) but inferred effects=io"
  source ny <<'NY'
module std.project(
  invalid, run_eff, pure_answer, print_answer
)

fn pure_answer() int { 24 }

@effects(io)
fn print_answer() int {
  print("answer\n")
  42
}

@effects(e)
fn run_eff(fnptr callback) int {
  callback()
}

@effects(none)
fn invalid(bool select_io) int {
  mut callback = pure_answer
  if select_io {
    callback = print_answer
  }
  run_eff(callback)
}

invalid(false)
NY
}

shape loop_reassigned_callback_joins_effect_rows {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "higher-order", "callback", "row", "soundness"]
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "declared @effects(none) but inferred effects=io"
  source ny <<'NY'
module std.project(
  invalid, run_eff, pure_answer, print_answer
)

fn pure_answer() int { 24 }

@effects(io)
fn print_answer() int {
  print("answer\n")
  42
}

@effects(e)
fn run_eff(fnptr callback) int {
  callback()
}

@effects(none)
fn invalid(bool update_callback) int {
  mut callback = pure_answer
  while update_callback {
    callback = print_answer
    break
  }
  run_eff(callback)
}

invalid(false)
NY
}

shape match_reassigned_callback_joins_effect_rows {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "higher-order", "callback", "row", "soundness"]
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "declared @effects(none) but inferred effects=io"
  source ny <<'NY'
module std.project(
  invalid, run_eff, pure_answer, print_answer
)

fn pure_answer() int { 24 }

@effects(io)
fn print_answer() int {
  print("answer\n")
  42
}

@effects(e)
fn run_eff(fnptr callback) int {
  callback()
}

@effects(none)
fn invalid(bool select_io) int {
  mut callback = pure_answer
  match select_io {
    true -> { callback = print_answer }
    else { callback = pure_answer }
  }
  run_eff(callback)
}

invalid(false)
NY
}

