shape generic_callback_row_reaches_caller_contract {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "higher-order", "callback", "row", "soundness"]
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "declared @effects(none) but inferred effects=io"
  source ny <<'NY'
module std.project(
  invalid, run_eff, print_answer
)

@effects(io)
fn print_answer() int {
  print("answer\n")
  42
}

@effects(e)
fn run_eff(fnptr callback) int {
  callback()
}

@effects(none)
fn invalid() int {
  run_eff(print_answer)
}

invalid()
NY
}
shape returned_callback_row_reaches_caller_contract {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "higher-order", "callback", "row", "soundness"]
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "declared @effects(none) but inferred effects="
  source ny <<'NY'
module std.project(
  invalid, run_eff, make_answer
)

fn make_answer() fnptr {
  return fn() {
    print("returned answer\n")
    42
  }
}

@effects(e)
fn run_eff(fnptr callback) int {
  callback()
}

@effects(none)
fn invalid() int {
  run_eff(make_answer())
}

invalid()
NY
}
