shape unknown_query_callback_effects_remain_unknown {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "unknown", "callback", "query"]
  template ny-test-case
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "effect policy violation in 'std.project.invoke': effects are unknown"
  source ny <<'NY'
use core.query as query
module std.project(
  invoke
)

fn invoke(list rows, fnptr pred) any {
  mut q = query.from(rows)
  q = query.pipe(q, query.where(pred))
  query.run(q)
}

print("unreachable")
NY
}
