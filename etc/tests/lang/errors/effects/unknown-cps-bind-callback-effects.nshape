shape unknown_cps_bind_callback_effects_remain_unknown {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "unknown", "callback", "cps", "bind"]
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "effect policy violation in 'std.project.invoke': effects are unknown"
  source ny <<'SRC'
use core.cps as cps
module std.project(
  invoke
)

fn invoke(fnptr continuation) any {
  def computation = cps.cps_bind(cps.cps_return(1), continuation)
  cps.cps_run(computation)
}

print("unreachable")
SRC
}
