shape unknown_call_effects_are_not_reported_as_known {
  family "typing/effects"
  generator "regression"
  features ["ny" "test" "typing" "effects" "unknown"]
  template ny-test-case
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "effect policy violation in 'std.project.invoke': effects are unknown"
  source ny <<'NY'
module std.project(
  invoke, forwards
)

fn invoke(any callback) {
  callback()
}

fn forwards(any callback) {
  invoke(callback)
}

print("unreachable")
NY
}
