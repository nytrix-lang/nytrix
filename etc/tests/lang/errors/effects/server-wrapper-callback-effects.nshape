shape server_wrapper_composes_callback_effects {
  family "typing/effects"
  generator "regression"
  features ["ny" "test" "typing" "effects" "higher-order" "callback" "server"]
  flags_matrix "--effect-require-known --native --run; --effect-require-known --native-backend=llvm --jit --jit-engine=mcjit; --effect-require-known --native-backend=llvm --jit --jit-engine=orc; --effect-require-known --native-only"
  expect compile_fail
  expect_message "declared @effects(io|alloc) but inferred effects=io|alloc|thread|read|write"
  source ny <<'NY'
use core
use core.os.net.server as server
use core.os.thread as thread

@effects(io, alloc)
fn check_server_handler() dict {
  server.serve("127.0.0.1", 0, fn(req) {
    thread.thread_spawn(fn() { req })
  }, 1)
}

check_server_handler()
NY
}
