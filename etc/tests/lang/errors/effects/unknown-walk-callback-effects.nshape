shape unknown_walk_callback_effects_remain_unknown {
  family "typing/effects"
  generator "regression"
  features ["ny", "test", "typing", "effects", "unknown", "callback", "filesystem"]
  template ny-test-case
  flags_matrix "--effect-require-known"
  expect compile_fail
  expect_message "effect policy violation in 'std.project.invoke': effects are unknown"
  source ny <<'NY'
module std.project(
  invoke
)
use core.os as os

fn invoke(str root, fnptr callback) {
   os.walk(root, callback, 0)
}

print("unreachable")
NY
}
