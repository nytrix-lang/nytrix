shape comptime_empty_identifier_code_category_mismatch {
  family "compiler-errors/comptime"
  generator "error"
  features ["error", "comptime", "code", "category", "identifier", "empty", "negative", "diagnostic"]
  template ny-compile-fail
  expect compile_fail
  expect_message "comptime template code category mismatch"
  source ny <<'NY'
comptime template wants_identifier(value: code<ident>) {
   fn generated_identifier_category_mismatch() int { return ${value} }
}
comptime emit wants_identifier([])
NY
}
