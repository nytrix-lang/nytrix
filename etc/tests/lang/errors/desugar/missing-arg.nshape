shape desugar-missing-arg-multi {
  family "compiler-errors/desugar"
  generator "error"
  features ["error", "desugar", "partial", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "missing `c`, `d`"
  source ny <<'NY'
use core
fn f(int a, int b, int c, int d) int { a + b + c + d }
f(1, 2)
NY
}
shape desugar-missing-arg-single {
  family "compiler-errors/desugar"
  generator "error"
  features ["error", "desugar", "partial", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "missing `b`"
  source ny <<'NY'
use core
fn f(int a, int b) int { a + b }
f(1)
NY
}
shape desugar-missing-arg-multi-chain {
  family "compiler-errors/desugar"
  generator "error"
  features ["error", "desugar", "partial", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "missing `d`"
  source ny <<'NY'
use core
fn f(int a, int b, int c, int d) int { a + b + c + d }
f(1)(2)(3)
NY
}
