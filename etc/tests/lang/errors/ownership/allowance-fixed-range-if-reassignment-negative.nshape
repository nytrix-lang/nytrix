shape ownership_allowance_fixed_range_if_reassignment_negative {
  family "compiler-errors/ownership"
  generator "error"
  features [ownership allowance fixed-range conditional-reassignment negative]
  template ny-compile-fail
  flags "--ownership-strict --nyir-verify"
  expect compile_fail
  expect_message "ownership allowance exceeded"
  source ny <<'NY'
use core

@allowance(x, [0,1])
fn too_many(bool choose, int x) int {
  def before = x
  for index in 0..1 {
    if choose { x = 7 } else { x = 8 }
    def during = x
  }
  def after = x
  0
}

too_many(true, 3)

@allowance(y, [0,2])
fn too_many_on_one_sided_path(bool choose, int y) int {
  for index in 0..1 {
    if choose { y = 7 }
    def during = y
  }
  def after = y
  0
}

too_many_on_one_sided_path(false, 3)
NY
}
