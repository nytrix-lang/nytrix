shape ownership_return_borrow_divergent_match_alias {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "borrow", "return", "match"]
  template ny-compile-fail
  expect compile_fail
  flags "--ownership-strict"
  expect_message "returning a borrow requires @returns_borrow(param)"
  source ny <<'NY'
use core

@returns_borrow(a)
fn bad(int arm, any a, any b) any {
  def borrowed = &a
  match arm {
    0 -> { borrowed = &b }
    _ -> { borrowed = &a }
  }
  return borrowed
}

def int left = 1
def int right = 2
bad(0, left, right)
NY
}
