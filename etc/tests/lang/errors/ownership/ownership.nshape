shape ownership-allowance-exceeded {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "negative", "diagnostic", "case-allowance-exceeded"]
  template ny-compile-fail
  expect compile_fail

  expect_message "ownership allowance exceeded for 'y': observed 2 > allowance 1"
  flags "--ownership-strict"
  source ny <<'NY'
use core

@consumes(y)
@allowance(y, 1)
fn twice(any y) any {
   y + y
}

twice([1])
NY
}

shape ownership-borrow-syntax-release-while-borrowed {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "negative", "diagnostic", "case-borrow-syntax-release-while-borrowed"]
  template ny-compile-fail
  expect compile_fail

  expect_message "cannot release owned slot 'a' while borrow 'b' is live"
  flags "--ownership-strict"
  source ny <<'NY'
use core

fn bad() int {
   def a = [1]
   def b = &a
   release(a)
   len(b)
}

bad()
NY
}

shape ownership-double-release {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "negative", "diagnostic", "case-double-release"]
  template ny-compile-fail
  expect compile_fail

  expect_message "double release of owned slot 'a'"
  flags "--ownership-strict"
  source ny <<'NY'
use core

fn bad() int {
   def a = [1]
   release(a)
   release(a)
   0
}

bad()
NY
}

