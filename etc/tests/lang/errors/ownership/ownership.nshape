shape ownership-use-after-consume {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "negative", "diagnostic", "case-use-after-consume"]
  template ny-compile-fail
  expect compile_fail

  expect_message "use after move of owned slot 'a'"
  flags "--ownership-strict"
  source ny <<'NY'
use core

@consumes(x)
fn take(x) int {
   0
}

fn bad() int {
   def a = [1]
   take(a)
   len(a)
}

bad()
NY
}
