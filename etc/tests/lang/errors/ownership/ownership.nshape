  features ["error", "ownership", "negative", "diagnostic", "case-forget-while-borrowed"]
  template ny-compile-fail
  expect compile_fail

  expect_message "cannot forget owned slot 'a' while borrow 'b' is live"
  flags "--ownership-strict"
  source ny <<'NY'
use core

fn bad() int {
   def a = [1]
   def b = borrow(a)
   forget(a)
   len(b)
}

bad()
NY
}

shape ownership-move-while-borrowed {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "negative", "diagnostic", "case-move-while-borrowed"]
  template ny-compile-fail
  expect compile_fail

  expect_message "cannot move owned slot 'a' while borrow 'b' is live"
  flags "--ownership-strict"
  source ny <<'NY'
use core

@returns_owned
@consumes(x)
fn adopt(x) { x }

fn bad() int {
   def a = [1, 2]
   def b = borrow(a)
   def c = adopt(a)
   len(b) + len(c)
}

bad()
NY
}

shape ownership-mutate-while-borrowed {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "negative", "diagnostic", "case-mutate-while-borrowed"]
  template ny-compile-fail
  expect compile_fail

  expect_message "cannot mutate owned slot 'a' while borrow 'b' is live"
  flags "--ownership-strict"
  source ny <<'NY'
use core

@mutates(x)
fn touch(x) int {
   0
}

fn bad() int {
   def a = [1, 2]
   def b = borrow(a)
   touch(a)
   len(b)
}

bad()
NY
}

shape ownership-reassign-while-borrowed {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "negative", "diagnostic", "case-reassign-while-borrowed"]
  template ny-compile-fail
  expect compile_fail

  expect_message "cannot reassign owned slot 'a' while borrow 'b' is live"
  flags "--ownership-strict"
  source ny <<'NY'
use core

fn bad() int {
   mut a = [1]
   def b = borrow(a)
   a = [2]
   len(b)
}

bad()
NY
}

