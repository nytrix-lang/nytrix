shape ownership-return-local-borrow {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "negative", "diagnostic", "case-return-local-borrow"]
  template ny-compile-fail
  expect compile_fail

  expect_message "returning borrow of local owner 'a' would outlive its slot"
  flags "--ownership-strict"
  source ny <<'NY'
use core

@borrows(x)
@returns_borrow(x)
fn peek(x) { x }

fn bad() {
   def a = [1]
   return peek(a)
}

bad()
NY
}

shape ownership-return-owned-without-contract {
  family "compiler-errors/ownership"
  generator "error"
  features ["error", "ownership", "negative", "diagnostic", "case-return-owned-without-contract"]
  template ny-compile-fail
  expect compile_fail

  expect_message "returning owned slot 'a' requires @returns_owned"
  flags "--ownership-strict"
  source ny <<'NY'
use core

fn bad() {
   def a = [1]
   return a
}

bad()
NY
}

