shape type-impl-law-failed {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "trait", "law"]
  template ny-compile-fail
  expect compile_fail
  expect_message "law verification failed"
  source ny <<'NY'
use core

trait Show {
  fn show(any v) str
}

struct Point { int x, int y }

impl Show for Point {
  fn show(p) str { "point" }
  law { 1 == 2 }
}
NY
}
