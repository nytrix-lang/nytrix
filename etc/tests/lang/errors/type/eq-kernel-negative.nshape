  expect_message "function has side effects"
  source ny <<'NY'
use core
@total
fn loud(int n) int {
   print(n)
   n
}
loud(1)
NY
}

shape match_motive_arm_mismatch_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "match", "motive"]
  template ny-compile-fail
  expect compile_fail
  expect_message "cannot assign string literal to int"
  source ny <<'NY'
use core
enum Color { Red, Green }
def code = match Color.Red as int {
   Color.Red -> 1
   Color.Green -> "green"
}
NY
}

shape total_recursor_non_structural_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "total", "recursor", "soundness"]
  template ny-compile-fail
  expect compile_fail
  expect_message "recursive termination is not certified"
  source ny <<'NY'
use core
;; Relative totality covers the callback, not the recursion: calling the
;; recursor on the same value is still refused.
enum Nat { Zero, Succ(Nat n) }
@total
@effects(e)
fn nat_rec(Nat n, int z, fnptr step) int decreases(n) {
   match n { Nat.Zero -> z Nat.Succ(k) -> step(nat_rec(n, z, step)) }
}
NY
}

shape total_recursor_own_effect_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "total", "recursor", "effects"]
  template ny-compile-fail
  expect compile_fail
  expect_message "outside the open row"
  source ny <<'NY'
use core
;; Its own body stays effect-checked: printing is not the callback's effect.
enum Nat { Zero, Succ(Nat n) }
@total
@effects(e)
fn nat_rec(Nat n, int z, fnptr step) int decreases(n) {
   print(1)
   z
}
NY
}

shape match_motive_arm_proof_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "match", "motive", "proof"]
  template ny-compile-fail
  expect compile_fail
  expect_message "proof proposition does not match"
  source ny <<'NY'
use core
;; Each literal arm is checked against the motive at its pattern.
fn g(int n) int {
   def proof<n == n> p = match n as (v) -> proof<v == v> {
      0 -> prove(1 == 1)
      _ -> prove(n == n)
   }
   n
}
print(g(2))
NY
}

shape vec_index_construction_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "dependent", "index"]
  template ny-compile-fail
  expect compile_fail
  expect_message "type mismatch: expected 'Vec<int, 2>', got 'Vec<int, 1>'"
  source ny <<'NY'
use core
;; Construction computes the index: a one-element vector is not a Vec<int, 2>.
enum Vec<A, n> { Nil where n is 0, Cons(A head, Vec<A, k> tail) where n is k + 1 }
def Vec<int, 0> e = Vec.Nil
def Vec<int, 2> bad = Vec.Cons(5, e)
print(1)
NY
}

shape vec_index_impossible_arm_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "dependent", "index"]
  template ny-compile-fail
  expect compile_fail
  expect_message "cannot match 'Vec<int, 2>'"
  source ny <<'NY'
use core
;; A literal index rules out the constructor that cannot produce it.
enum Vec<A, n> { Nil where n is 0, Cons(A head, Vec<A, k> tail) where n is k + 1 }
fn h(Vec<int, 2> xs) int { match xs { Vec.Nil -> 0 Vec.Cons(a, t) -> a } }
print(1)
NY
}

shape vec_index_payload_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "dependent", "index"]
  template ny-compile-fail
  expect compile_fail
  expect_message "Vec<int, 1>"
  source ny <<'NY'
use core
;; The tail of a Vec<int, 2> is a Vec<int, 1>, not a Vec<int, 2>.
enum Vec<A, n> { Nil where n is 0, Cons(A head, Vec<A, k> tail) where n is k + 1 }
fn h(Vec<int, 2> xs) int { match xs { Vec.Cons(a, t) -> keep(t) } }
fn keep(Vec<int, 2> v) int { 0 }
print(1)
NY
}

shape eq_transport_index_missing_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "proof", "transport"]
  template ny-compile-fail
  expect compile_fail
  expect_message "expected 'Vec<int, m>', got 'Vec<int, n>'"
  source ny <<'NY'
use core
;; Without the equation the indices differ.
enum Vec<A, n> { Nil where n is 0, Cons(A head, Vec<A, k> tail) where n is k + 1 }
fn retag(int n, int m, Vec<int, n> xs) int {
   def Vec<int, m> ys = xs
   0
}
print(1)
NY
}

shape eq_transport_index_unrelated_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "proof", "transport"]
  template ny-compile-fail
  expect compile_fail
  expect_message "neither side of the equation"
  source ny <<'NY'
use core
;; An equation that names no index of the value's type moves nothing.
enum Vec<A, n> { Nil where n is 0, Cons(A head, Vec<A, k> tail) where n is k + 1 }
fn retag(int n, int a, int b, proof<a == b> p, Vec<int, n> xs) int {
   def Vec<int, b> ys = transport(p, xs)
   0
}
print(1)
NY
}

