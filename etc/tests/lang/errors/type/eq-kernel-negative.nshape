shape total_non_structural_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "total", "inductive", "soundness"]
  template ny-compile-fail
  expect compile_fail
  expect_message "recursive termination is not certified"
  source ny <<'NY'
use core
enum Nat { Zero, Succ(Nat n) }
@total
fn grow(Nat a) Nat decreases(a) { Nat.Succ(grow(Nat.Succ(a))) }
NY
}

