shape type-incomparable-refinement-guards-fail-closed {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "refinement", "relational-guard", "ambiguity", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "refinement obligation is not proved"
  source ny <<'NY'
use core

refine Positive = int where(v) { v > 0 }
refine Even = int where(n) { n % 2 == 0 }
fn accept_positive(Positive value) int { value }
fn incomparable_guards_are_ambiguous(int value) int {
  if value > 0 && value % 2 == 0 {
    accept_positive(value)
  } else {
    0
  }
}
NY
}

