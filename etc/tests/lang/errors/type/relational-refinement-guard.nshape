shape type-mutable-guard-does-not-prove-refinement {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "refinement", "mutable", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "refinement obligation is not proved"
  source ny <<'NY'
use core

refine Positive = int where(v) { v > 0 }
fn accept_positive(Positive value) int { value }
fn mutation_invalidates_guard(int input) int {
  mut value = input
  if value > 0 {
    value = -1
    accept_positive(value)
  } else {
    0
  }
}
NY
}

shape type-mutable-guard-through-closure-does-not-prove-refinement {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "refinement", "mutable", "closure", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "refinement obligation is not proved"
  source ny <<'NY'
use core

refine Positive = int where(v) { v > 0 }
fn accept_positive(Positive value) int { value }
fn mutation_via_closure(int input) int {
  mut value = input
  def invalidate = fn() { value = -1 }
  if value > 0 {
    invalidate()
    accept_positive(value)
  } else {
    0
  }
}
NY
}

shape type-mutable-guard-after-capture-does-not-prove-refinement {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "refinement", "mutable", "capture", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "refinement obligation is not proved"
  source ny <<'NY'
use core

refine Positive = int where(v) { v > 0 }
fn captured_binding(int input) Positive {
  mut value = input
  def later_write = fn() { value = -1 }
  if value > 0 {
    return value
  } else {
    return 1
  }
}
NY
}
