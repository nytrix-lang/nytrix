shape type-relational-refinement-guard-is-not-strong-enough {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "refinement", "relational-guard", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "refinement obligation is not proved"
  source ny <<'NY'
use core

refine Positive = int where(v) { v > 0 }
fn accept_positive(Positive value) int { value }
fn insufficient_guard(int value) int {
  if value >= 0 {
    accept_positive(value)
  } else {
    0
  }
}
NY
}

shape type-relational-implication-weak-bound-fails-closed {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "refinement", "relational-guard", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "refinement obligation is not proved"
  source ny <<'NY'
use core

refine AtLeastTwo = int where(value) { value >= 2 }
fn accept_at_least_two(AtLeastTwo value) int { value }
fn insufficient_lower_bound(int value) int {
  if value > 0 {
    accept_at_least_two(value)
  } else {
    0
  }
}
NY
}

