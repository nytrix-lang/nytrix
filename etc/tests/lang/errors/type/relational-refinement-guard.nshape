shape type-loop-refinement-fact-does-not-escape {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "refinement", "loop", "negative"]
  template ny-compile-fail
  expect compile_fail
  expect_message "refinement obligation is not proved"
  source ny <<'NY'
use core

refine Positive = int where(v) { v > 0 }
fn accept_positive(Positive value) int { value }
fn loop_fact_does_not_escape(int value) int {
  while value > 0 {
    break
  }
  accept_positive(value)
}
NY
}

