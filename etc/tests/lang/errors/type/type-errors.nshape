shape type-impl-law-failed {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "trait", "law", "backend-parity", "case-impl-law-failed"]
  template ny-compile-fail
  expect compile_fail
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect_message "law verification failed"
  source ny <<'NY'
use core

trait Show {
  fn show(any v) str
}

struct Point { int x, int y }

impl Show for Point {
  fn show(p) str { "point" }
  law { 1 == 2 }
}
NY
}

