shape type-effect-capability-name-too-long {
  family "compiler-errors/type"
  generator "error"
  features ["error", "effects", "capability", "length-boundary", "soundness"]
  template ny-compile-fail
  expect compile_fail
  expect_message "exceeds the 63-byte limit"
  source ny <<'NY'
@effects(io, cap(abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ab))
fn invalid_capability() int {
  1
}

invalid_capability()
NY
}
