def int index = runtime_index()
assert_compile_range(index, 0, 7, "unknown range claim")
NY
}

shape loop-range-assertion-rejects-false-induction-bound {
  family "compiler-errors/type"
  generator "error"
  features ["error", "proof", "range", "loop", "negative", "diagnostic"]
  template ny-compile-fail
  expect compile_fail
  flags_matrix "--native --run --color=never; --native-backend=llvm --jit --jit-engine=mcjit --color=never; --native-backend=llvm --jit --jit-engine=orc --color=never; --native-only --color=never"

  expect_message "assert_compile_range is not proven for loop execution"
  source ny <<'NY'
use core

fn main() int {
   mut int i = 0
   while i < 3 {
      assert_compile_range(i, 0, 1, "false second-iteration bound")
      i += 1
   }
   0
}
print(main())
NY
}

shape loop-range-assertion-rejects-unknown-induction-start {
  family "compiler-errors/type"
  generator "error"
  features ["error", "proof", "range", "loop", "negative", "diagnostic"]
  template ny-compile-fail
  expect compile_fail
  flags_matrix "--native --run --color=never; --native-backend=llvm --jit --jit-engine=mcjit --color=never; --native-backend=llvm --jit --jit-engine=orc --color=never; --native-only --color=never"

  expect_message "assert_compile_range is not proven for loop execution"
  source ny <<'NY'
use core

fn runtime_index() int { 0 }
fn main() int {
   mut int i = runtime_index()
   while i < 3 {
      assert_compile_range(i, 0, 2, "unknown starting value")
      i += 1
   }
   0
}
print(main())
NY
}

shape descending-loop-range-assertion-rejects-false-bound {
  family "compiler-errors/type"
  generator "error"
  features ["error", "proof", "range", "loop", "descending", "negative", "diagnostic"]
  template ny-compile-fail
  expect compile_fail
  flags_matrix "--native --run --color=never; --native-backend=llvm --jit --jit-engine=mcjit --color=never; --native-backend=llvm --jit --jit-engine=orc --color=never; --native-only --color=never"

  expect_message "assert_compile_range is not proven for loop execution"
  source ny <<'NY'
use core

fn main() int {
   mut int i = 7
   while i >= 2 {
      assert_compile_range(i, 3, 7, "false lower bound")
      i -= 1
   }
   0
}
print(main())
NY
}

