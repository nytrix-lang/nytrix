shape type-assert-compile-index {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "negative", "diagnostic", "case-assert-compile-index"]
  template ny-compile-fail
  expect compile_fail
  flags "--native-only"

  expect_message "static index proof failed"
  source ny <<'NY'
use core

def xs = [1, 2, 3]
def int i = 4
assert_compile_index(xs, i, "static index proof failed")
print(xs)
NY
}

shape type-assert-compile-range {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "negative", "diagnostic", "case-assert-compile-range"]
  template ny-compile-fail
  expect compile_fail
  flags "--native-only"

  expect_message "compile-time range assertion failed"
  source ny <<'NY'
use core

def int x = 9
assert_compile_range(x, 0, 3)
print(x)
NY
}

shape safe-mode-range-assert-is-not-an-assumption {
  family "compiler-errors/safety"
  generator "error"
  features ["error", "safety", "negative", "diagnostic"]
  template ny-compile-fail
  expect compile_fail
  flags "--safe-mode"

  expect_message "assert_compile_range is not proven in safe mode"
  source ny <<'NY'
use core

with ptr p = malloc(8) {
   def int index = 3
   assert_compile_range(index, 0, 1, "incorrect range claim")
   store8(p, 65, index)
}
NY
}

shape safe-mode-unknown-range-assertion-fails-closed {
  family "compiler-errors/safety"
  generator "error"
  features ["error", "safety", "negative", "diagnostic"]
