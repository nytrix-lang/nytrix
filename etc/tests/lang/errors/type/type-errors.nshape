shape type_proof_call_site_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "proof", "negative", "diagnostic", "case-proof-call-site-negative"]
  template ny-compile-fail
  expect compile_fail

  expect_message "mapped value ranges do not prove it"
  source ny <<'NY'
use core

;; The proof<P> proposition references callee parameter `m`. The witness is
;; valid for 200 > 100, but the call maps `m` to 50, so the check must reject
;; the call.
fn needs_big(int m, proof<m > 100> p) int { 2 }
def proof big = prove(200 > 100)
needs_big(50, big)
NY
}

shape type_proof_call_site_unknown_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "proof", "unknown", "soundness", "negative", "case-proof-call-site-unknown-negative"]
  template ny-compile-fail
  expect compile_fail

  expect_message "mapped value ranges do not prove it"
  source ny <<'NY'
use core

;; The proposition references no mapped callee parameter and no caller
;; binding with a known range: `n` is an unconstrained function parameter,
;; so its range is unknown at the call site.  Unknown must not be accepted
;; as proof even though the supplied witness proves a literal fact.
fn needs_big(proof<n > 100> p) int { 2 }
fn caller(int n) {
  def proof big = prove(200 > 100)
  needs_big(big)
}
caller(200)
NY
}

shape type_requires_unknown_native_call_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "proof", "requires", "unknown", "native", "soundness"]
  template ny-compile-fail
  expect compile_fail
  flags "--native-only"

  expect_message "'requires' condition is false or unproved for native lowering"
  source ny <<'NY'
use core

fn positive(int n) int requires n > 0 { n }

;; The argument is an unconstrained caller parameter. The native backend has
;; no proof context here, so it must reject the call instead of treating an
;; unknown requires condition as satisfied.
fn forward(int x) int {
  positive(x)
}

forward(1)
NY
}

shape type_total_recursive_measure_is_not_a_proof {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "termination", "total", "soundness"]
  template ny-compile-fail
  expect compile_fail

  expect_message "recursive termination is not certified"
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  source ny <<'NY'
use core

;; The canonical guarded countdown has a well-founded measure certificate.
;; An unrelated unmeasured recursive function must still be rejected.
@total
fn count_down(int n) int decreases(n) {
  if n <= 0 { return 0 }
  count_down(n - 1)
}

@total
fn spin(int n) int {
  spin(n)
}

count_down(4)
NY
}

