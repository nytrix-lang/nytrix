shape args-invalid-accel-target {
  family "compiler-errors/args"
  generator "error"
  features ["args", "cli", "negative", "diagnostic", "case-invalid-accel-target"]
  template ny-compile-fail
  expect compile_fail

  flags "--accel-target=bogus"
  expect_message "unknown accel target"
  source ny <<'NY'
use core
print("ok")
NY
}

