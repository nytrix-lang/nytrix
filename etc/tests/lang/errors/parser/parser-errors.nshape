shape parser-asm-constraint-arity {
  family "compiler-errors/parser"
  generator "error"
  features [error parser negative diagnostic asm case-asm-constraint-arity]
  template ny-compile-fail
  expect compile_fail

  expect_message "asm constraint/input count mismatch"
  source ny <<'NY'
use core

def value = asm("mov $1, $0", "=r", 7, 8)
NY
}

shape parser-asm-empty-structured {
  family "compiler-errors/parser"
  generator "error"
  features [error parser negative diagnostic asm case-asm-empty-structured]
  template ny-compile-fail
  expect compile_fail

  expect_message "structured asm requires an instruction"
  source ny <<'NY'
use core

def value = asm {
   in reg input = 7
}
NY
}

shape parser-asm-empty-template {
  family "compiler-errors/parser"
  generator "error"
  features [error parser negative diagnostic asm case-asm-empty-template]
  template ny-compile-fail
  expect compile_fail

  expect_message "asm template must not be empty"
  source ny <<'NY'
use core

def value = asm("   ", "=r")
NY
}

shape parser-asm-unsupported-constraint {
  family "compiler-errors/parser"
  generator "error"
  features [error parser negative diagnostic asm case-asm-unsupported-constraint]
  template ny-compile-fail
  expect compile_fail

  expect_message "unsupported asm constraint"
  source ny <<'NY'
use core

def value = asm("nop", "=z")
NY
}

shape parser-attribute-needs-function {
  family "compiler-errors/parser"
  generator "error"
  features ["error", "parser", "negative", "diagnostic", "case-attribute-needs-function"]
  template ny-compile-fail
  expect compile_fail

  expect_message "function attributes must be followed by 'fn'"
  source ny <<'NY'
use core

@inline
print(1)
NY
}

