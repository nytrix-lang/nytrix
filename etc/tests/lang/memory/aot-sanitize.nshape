shape sanitizer_aot_execution_matrix {
  family "runtime-sanitize"
  generator "runtime"
  features [sanitize address undefined aot execution]
  template ny-test-case
  flags_matrix "--sanitize=address --native-backend=llvm --no-progress; --sanitize=undefined --native-backend=llvm --no-progress"
  expect compile_and_run
  source ny <<'NY'
print(42)
NY
}
