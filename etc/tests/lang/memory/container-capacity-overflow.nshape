shape container_capacity_overflow {
  family "runtime/memory"
  generator "regression"
  features ["ny", "test", "integer-overflow", "memory-safety"]
  template ny-test-case
  flags "--native-only"
  timeout 240
  expect compile_and_run
  source ny <<'NY'
use core
use core.set_mod
use core.os (env, file_remove, file_write, pid, run_capture, temp_dir)

def ny = env("NYTRIX_NY_FULL_BIN")
assert(is_str(ny) && ny.len > 0, "full compiler is available")
def stem = temp_dir() + "/ny-container-capacity-" + to_str(pid())
def path = stem + ".ny"
def executable = stem + ".exe"
defer { file_remove(path) file_remove(executable) }
def source = "use core\nuse core.dict_mod as dict_mod\n" +
   "use core.set_mod as set_mod\nuse core.os (env)\n" +
   "def kind = env(\"NY_CONTAINER_KIND\")\n" +
   "if kind == \"dict\" { print(dict_mod.dict(134217729).len) }\n" +
   "else { print(set_mod.set(134217729).len) }\n"
assert(is_ok(file_write(path, source)), "write capacity probe")
def compiled = run_capture(
   ["env", "NYTRIX_STD_CACHE=0", "NYTRIX_STD_BC_CACHE_AUTO=0",
    ny, "--native-backend=llvm",
    "--run=none", "--output=" + executable, path], [], nil, false)
def compile_text =
   to_str(compiled.get("stdout", "")) + to_str(compiled.get("stderr", ""))
assert(compiled.get("code", 127) == 0,
       "compile bounded overflow probe: " + compile_text)
for kind in ["dict", "set"] {
   def result = run_capture(
      ["env", "NYTRIX_FAIL_ALLOC_AFTER=0", "NY_CONTAINER_KIND=" + kind,
       executable], [], nil, false)
   def text = to_str(result.get("stdout", "")) + to_str(result.get("stderr", ""))
   assert(result.get("code", 127) == 1 && text.contains("container capacity overflow"),
          kind + " rejects an overflowing capacity before allocation: " + text)
}
0
NY
}
