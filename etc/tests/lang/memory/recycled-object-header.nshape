shape test_recycled_object_header {
  family "runtime/memory"
  generator "embedded"
  features ["ny", "test"]
  template ny-test-case
  flags_matrix "--native --run --no-zero-init; --native-backend=llvm --jit --jit-engine=mcjit --no-zero-init; --native-backend=llvm --jit --jit-engine=orc --no-zero-init"
  expect compile_and_run
  source ny <<'NY'
use core
mut i = 0
while i < 32 {
   def buffer = malloc(16)
   store8(buffer, 120, 0)
   store8(buffer, 0, 1)
   def text = init_str(buffer, 12)
   free(text)
   def fresh = malloc(16)
   store8(fresh, 65, 0)
   store8(fresh, 0, 1)
   def converted = cstr_to_str(fresh)
   assert(__str_len(converted) == 1 && converted == "A", "fresh allocation has no stale string metadata")
   free(fresh)
   i += 1
}
def first = malloc(16)
store8(first, 65, 0)
store8(first, 0, 1)
def first_string = init_str(first, 1)
assert(__str_hash(first_string) == __str_hash(cstr_to_str("A")), "initial string hash")
free(first_string)
def second = malloc(16)
store8(second, 66, 0)
store8(second, 0, 1)
def second_string = init_str(second, 1)
assert(__str_hash(second_string) == __str_hash(cstr_to_str("B")), "reused address does not retain a string hash")
free(second_string)

; Releasing a long interned string must invalidate its table slot before the
; allocator can recycle the storage. Recreating the same contents must build a
; live string rather than return the released object.
def intern_builder_a = __str_builder_new(0)
__str_builder_append(intern_builder_a, "intern-table-entry-0123456789")
def intern_a = __str_builder_to_str(intern_builder_a)
__str_builder_free(intern_builder_a)
assert(__str_len(intern_a) == 29, "long string enters the intern table")
free(intern_a)
def intern_builder_b = __str_builder_new(0)
__str_builder_append(intern_builder_b, "intern-table-entry-0123456789")
def intern_b = __str_builder_to_str(intern_builder_b)
__str_builder_free(intern_builder_b)
assert(__str_len(intern_b) == 29 && intern_b == "intern-table-entry-0123456789",
       "intern lookup skips released entries")
NY
}
