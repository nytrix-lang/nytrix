shape mix_loop {
  family "probe-suite"
  generator "stress"
  features ["ny", "image"]
  template ny-test-case
  expect compile_and_run
  ci optional
  source ny <<'NY'
use std.core
use std.math.parse.img as img
fn main(){
   def path = "etc/assets/images/prototype/prototype_grid_light_small_text.png"
   assert(img.load(path), "decode " + path)
   print("decoded " + path)
   0
}
NY
}
