shape pi_call_call_site_substitution {
  family "runtime/language"
  generator "embedded"
  features ["ny", "test", "dependent"]
  template ny-test-case
  flags_matrix "--native --run; --native-backend=llvm --jit --jit-engine=mcjit; --native-backend=llvm --jit --jit-engine=orc; --native-only"
  expect compile_and_run
  source ny <<'NY'
use core

fn id(Fin<4> n) i32 {
  n
}

def result = id(2)
assert_eq(result, 2, "call-site substitution of argument into return type")
print("✓ pi-call ok")
NY
}
