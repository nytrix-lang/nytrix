shape type_proves_requires_reassigned_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "proof", "postcondition", "soundness"]
  template ny-compile-fail
  flags_matrix "--native-only; --native-backend=llvm --jit --jit-engine=orc"
  expect compile_fail
  expect_message "is not proved for a returned value range"
  source ny <<'NY'
use core
@proves(result > 1)
fn bad(int n) int requires n > 1 {
  n = 0
  return n
}
bad(5)
NY
}

shape type_proves_requires_weaker_negative {
  family "compiler-errors/type"
  generator "error"
  features ["error", "type", "proof", "postcondition", "soundness"]
  template ny-compile-fail
  flags_matrix "--native-only; --native-backend=llvm --jit --jit-engine=orc"
  expect compile_fail
  expect_message "is not proved for a returned value range"
  source ny <<'NY'
use core
@proves(result > 1)
fn bad(int n) int requires n > 0 { return n - 1 }
bad(5)
NY
}
