use core
use core.reflect (semantic_snapshot, semantic_get, semantic_find_function,
                  semantic_find_expression, semantic_expression_effects,
                  semantic_signature_effects, semantic_layouts,
                  semantic_find_layout, semantic_find_obligation,
                  semantic_callable_effect_row,
                  semantic_find_callable_effect,
                  semantic_proof_obligations)
use core.os.subprocess (run_capture)

fn test_real_semantic_artifact() {
   def str cmake = to_str(env("NYTRIX_CMAKE_COMMAND"))
   def source_result = run_capture(
      [cmake, "-E", "cat", "__SEMANTIC_ARTIFACT_PATH__"], [], nil, false)
   assert(int(source_result.get("code", 127)) == 0,
          "read generated compiler artifact")
   def str source = to_str(source_result.get("stdout", ""))
   def decoded = semantic_snapshot(source)
   assert(decoded.get("ok"), "real compiler artifact is accepted: " +
          str(decoded.get("error")))
   def snapshot = decoded.get("value")

   def caller = semantic_find_function(snapshot, "semantic_effect_caller")
   assert(str(semantic_get(caller, "name")) == "semantic_effect_caller",
          "native consumer finds a typed function in the compiler artifact")
   def signature = semantic_signature_effects(caller)
   assert(str(semantic_get(signature, "inferred_builtin_row")) ==
             "ny.effect-row.v1{std.effects.io=unit}",
          "native consumer reads the inferred function effect row")
   def call = semantic_find_expression(caller, "call", 12, 23)
   def call_effects = semantic_expression_effects(call)
   assert(semantic_get(call_effects, "known") &&
          str(semantic_get(call_effects, "inferred_builtin_row")) ==
             "ny.effect-row.v1{std.effects.io=unit}",
          "native consumer reads expression effects from authored source")

   def layout_record = semantic_find_layout(snapshot, "SemanticArtifactLayout")
   def layouts = semantic_layouts(snapshot)
   assert(layouts.len > 0 &&
          str(semantic_get(layout_record, "name")) == "SemanticArtifactLayout" &&
          int(semantic_get(layout_record, "alignment")) == 4,
          "native consumer reads resolved layout facts")
   def requirement = semantic_find_obligation(snapshot, "requires", 72)
   assert(str(semantic_get(semantic_get(requirement, "requires"), "status")) ==
             "proved",
          "native consumer reads a proved caller obligation")

   def io_callable = semantic_find_callable_effect(snapshot,
                                                   "semantic_effect_io", 0)
   assert(str(semantic_callable_effect_row(io_callable)) ==
             "ny.effect-row.v1{std.effects.io=unit}",
          "native consumer reads a unit-wide callable effect row")
   assert(semantic_proof_obligations(snapshot).len >= 9,
          "native consumer reads versioned proof obligation records")
   print("semantic artifact consumer passed")
}

test_real_semantic_artifact()
