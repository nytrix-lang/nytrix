shape nyir_metadata_bin_bad_phi_predecessor {
  family "runtime-native"
  generator "native"
  features ["native", "nyir", "phi", "metadata", "binary", "negative"]
  template ny-test-case
  flags "--nyr-metadata-bin=etc/labs/tests/code/intermediate/fixtures/nyr-bad-phi-predecessor.nyr"
  expect compile_fail
  expect_message "invalid value operands"
  source ny <<'NY'
1 + 2
NY
}
