shape nyir_metadata_bin {
  family "runtime-native"
  generator "native"
  features ["native", "nyir", "metadata", "binary"]
  template ny-test-case
  flags "--dump-nyr=build/nyr-metadata-bin.nyr --nyr-metadata=build/nyr-metadata-bin.txt --nyr-metadata-bin=build/nyr-metadata-bin.nyr"
  expect compile_and_run
  source ny <<'NY'
print(1 + 2)
NY
}
