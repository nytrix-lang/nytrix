fn otp_case_4__otp_minimal_period(key){
   def n = len(key)
   mut period = 1
   while(period <= n){
      if(n % period == 0){
         mut ok = true
         mut i = 0
         while(i < n && ok){
            if(get(key, i) != get(key, i % period)){ ok = false }
            i = i + 1
         }
         if(ok){
            mut out = list(0)
            mut j = 0
            while(j < period){
               out = append(out, get(key, j))
               j = j + 1
            }
            return out
         }
      }
      period = period + 1
   }
   key
}
fn otp_case_4_otp_apply_key(data, key){
   def n = len(data)
   def kn = len(key)
   if(kn == 0){ return _clone_list(data) }
   mut out = list(0)
   mut i = 0
   while(i < n){
      out = append(out, get(data, i) ^ get(key, i % kn))
      i = i + 1
   }
   out
}
if(comptime{__main()}){
   print("ok b2a")
}

fn otp_case_5__otp_lower(b){ (b >= 65 && b <= 90) ? (b + 32) : b }
fn otp_case_5__otp_default_weight(b){
   def c = otp_case_5__otp_lower(b)
   if(c == 32){ return 130 }
   if(c >= 33 && c <= 126){ return 1 }
   0
}
fn otp_case_5__otp_freq_weight(char_frequencies, b, char_floor){
   if(char_frequencies == nil){ return otp_case_5__otp_default_weight(b) }
   char_floor
}
fn otp_case_5_otp_score_english(bytes, char_frequencies=nil, char_floor=-5){
   mut score = 0
   mut i = 0
   while(i < len(bytes)){
      def b = get(bytes, i)
      if(!((b >= 32 && b <= 126) || b == 9 || b == 10 || b == 13)){ return nil }
      score = score + otp_case_5__otp_freq_weight(char_frequencies, b, char_floor)
      i = i + 1
   }
   score
}
fn otp_case_5__otp_transpose(ciphertexts, offset, key_size){ [] }
fn otp_case_5__otp_frequency_key_byte(bytes, char_frequencies, char_floor){ 0 }
fn otp_case_5__otp_minimal_period(key){ key }
fn otp_case_5_otp_apply_key(data, key){ data }
fn otp_case_5_otp_recover_reused_key(ciphertexts, key_size=nil, max_key_size=nil, char_frequencies=nil, char_floor=-5){
   def sizes = (key_size == nil) ? [3] : [key_size]
   mut best_key = nil
   mut best_score = nil
   mut si = 0
   while(si < len(sizes)){
      def ks = get(sizes, si)
      mut key = list(0)
      mut ok = true
      mut i = 0
      while(i < ks && ok){
         def column = otp_case_5__otp_transpose(ciphertexts, i, ks)
         def kb = otp_case_5__otp_frequency_key_byte(column, char_frequencies, char_floor)
         if(kb == nil){ ok = false } else { key = append(key, kb) }
         i = i + 1
      }
      if(ok){
         key = otp_case_5__otp_minimal_period(key)
         mut total_score = 0
         mut ci = 0
         while(ci < len(ciphertexts) && ok){
            def plain = otp_case_5_otp_apply_key(get(ciphertexts, ci), key)
            def score = otp_case_5_otp_score_english(plain, char_frequencies, char_floor)
            if(score == nil){ ok = false } else { total_score = total_score + score }
            ci = ci + 1
         }
         if(ok && (best_score == nil || total_score > best_score)){
            best_score = total_score
            best_key = key
         }
      }
      si = si + 1
   }
   best_key
}
