shape image_decode_routes {
  family "runtime/ui"
  generator "regression"
  features [ny image png jpeg file bytes dispatch]
  template ny-test-case
  timeout 120
  flags_matrix "--native-only -O0; --native --run -O0"
  expect compile_and_run
  expect_message "IMAGE-DECODE-ROUTES-OK"
  source ny <<'NY'
use core
use core.os
use core.math.parse.img as img
use core.math.parse.img.png as png
use core.math.parse.img.jpeg as jpeg

;; Both routes of a module decode the same bytes. The environment selects the
;; route, so this fixture runs unchanged either way:
;;   * PNG: libpng when present, the in-tree decoder otherwise
;;     (`NY_PNG_DISABLE_LIBPNG=1` forces the in-tree route).
;;   * JPEG: libjpeg-turbo when present; without it the module fails closed
;;     with a diagnostic that names the turbojpeg route.
def png_bytes = file_read("etc/labs/tests/code/probes/ui/fixtures/ui-rgba.png")
assert(is_ok(png_bytes), "png fixture readable")
def png_img = png.decode(unwrap(png_bytes))
assert(is_dict(png_img), "png decodes on the selected route")
assert(int(png_img.get("width")) == 2 && int(png_img.get("height")) == 2, "png dimensions")
def png_px = png_img.get("data")
assert(len(png_px) == 16, "png RGBA buffer size")
assert(load8(png_px, 0) == 255 && load8(png_px, 1) == 0 && load8(png_px, 3) == 255, "png red pixel")
assert(load8(png_px, 5) == 255 && load8(png_px, 7) == 128, "png half-alpha green pixel")
assert(load8(png_px, 10) == 255 && load8(png_px, 15) == 0, "png blue and transparent pixels")
def loaded = img.load("etc/labs/tests/code/probes/ui/fixtures/ui-rgba.png")
assert(is_dict(loaded), "png image loader dispatches on disk")

def jpeg_bytes = file_read("etc/labs/tests/code/probes/ui/fixtures/ui-baseline.jpg")
assert(is_ok(jpeg_bytes), "jpeg fixture readable")
def jpeg_img = jpeg.decode(unwrap(jpeg_bytes))
if is_dict(jpeg_img) {
   assert(is_dict(jpeg_img), "jpeg decodes through the turbojpeg route")
   assert(int(jpeg_img.get("width")) == 17 && int(jpeg_img.get("height")) == 11, "jpeg dimensions")
   def jpeg_px = jpeg_img.get("data")
   assert(len(jpeg_px) == 17 * 11 * 4, "jpeg RGBA buffer size")
   assert(load8(jpeg_px, 3) == 255, "jpeg alpha")
} else {
   assert(!is_dict(jpeg_img) || !jpeg_img, "jpeg fails closed without a decode backend")
}
print("IMAGE-DECODE-ROUTES-OK")
NY
}
