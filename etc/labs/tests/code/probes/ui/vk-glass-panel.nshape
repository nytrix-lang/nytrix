shape vk_glass_panel {
  family "runtime/ui"
  generator "regression"
  features [ui vulkan sdf glass blur framebuffer]
  template ny-test-case
  flags_matrix "--native-only -O0; --native-only -O3; --native-backend=llvm --jit --jit-engine=mcjit -O0"
  expect compile_and_run
  expect_stdout "GLASS-PANEL-OK"
  source ny <<'NY'
use core
use core.common as common
use core.os.ui.render as gfx

def backend = common.env_trim("NY_UI_GLASS_PROBE_BACKEND")
def want = backend == "" ? "mock" : backend
assert(gfx.apply_backend_name(want), "select renderer")
def win = gfx.init_window(96, 64, "Vulkan glass panel probe", 0, false, false, 1)
assert(win && gfx.get_active_backend_name() == want, "requested backend is active: " + gfx.get_active_backend_name())
mut int frame = 0
while frame < 3 {
   if frame == 2 { gfx.request_frame_capture() }
   assert(gfx.begin_frame_clear([0.0, 0.0, 0.0, 1.0]), "begin frame")
   gfx.set_ortho_2d(0.0, 96.0, 64.0, 0.0)
   mut int stripe = 0
   while stripe < 48 {
      def shade = (stripe % 4 < 2) ? 0.0 : 1.0
      assert(gfx.draw_rect(float(stripe), 0.0, 1.0, 64.0, [shade, shade, shade, 1.0]), "draw backdrop stripes")
      stripe += 1
   }
   assert(gfx.draw_glass_panel(4.0, 12.0, 40.0, 40.0, 10.0, [1.0, 1.0, 1.0, 0.98], 8.0, 1.5, 2.0, 0.30), "draw frosted panel")
   assert(gfx.draw_glass_panel(56.0, 12.0, 32.0, 40.0, 7.0, [1.0, 1.0, 1.0, 0.98], 0.0, 0.0, 5.0, 0.75), "draw rim panel")
   assert(gfx.end_frame(), "present frame")
   frame += 1
}
def framebuffer = gfx.read_framebuffer()
def fb_width = is_dict(framebuffer) ? int(framebuffer.get("width", 0)) : 0
def fb_height = is_dict(framebuffer) ? int(framebuffer.get("height", 0)) : 0
assert(fb_width > 0 && fb_height > 0, "read back rendered frame")
def ptr pixels = __ffi_untag_ptr(framebuffer.get("data", 0))
assert(pixels, "framebuffer pixels are available")
fn sample(ptr pixels, int width, int height, int x, int y) int {
   def int px = min(width - 1, (x * width) / 96)
   def int py = min(height - 1, (y * height) / 64)
   load8(pixels, (py * width + px) * 4) & 255
}
def int outside = sample(pixels, fb_width, fb_height, 0, 30)
def int center = sample(pixels, fb_width, fb_height, 24, 30)
def int rim_center = sample(pixels, fb_width, fb_height, 72, 30)
def int rim = sample(pixels, fb_width, fb_height, 57, 30)
free(pixels)
if want != "mock" {
   assert(center > 70 && center < 220 && outside < 16 && rim > rim_center + 25,
      "glass blurs stripes and brightens the dark panel rim: " + to_str([outside, center, rim_center, rim]))
}
gfx.close_window()
print("GLASS-PANEL-OK " + want)
NY
}
