shape editor-multi-buffer-search {
  family "runtime-ui"
  generator "embedded"
  features [ui editor search selection palette]
  template ny-test-case
  flags "--native --run -O0 --no-progress"
  timeout 600
  expect compile_and_run
  expect_stdout "EDITOR-MULTI-BUFFER-SEARCH-OK"
  source ny <<'NY'
use core
use core.str as str
use core.os.subprocess (run_capture)
def compiler = to_str(env("NYTRIX_NY_FULL_BIN"))
assert(compiler.len > 0, "runner supplies the compiler")
def result = run_capture(["env", "NY_UI_HEADLESS=1", "NY_EDITOR_PROBE_BUFFER_SEARCH=1", "NYTRIX_UI_REPLAY=1",
   "NYTRIX_UI_REPLAY_HASH=0", "NYTRIX_FIXTURE_FRAMES=3", compiler, "--native-only", "-O0", "etc/labs/editor.ny"], [], nil, false)
def out = to_str(result.get("stdout", ""))
def assertion = str.find(out, "Nytrix assertion failed:")
def error_at = assertion >= 0 ? assertion : max(0, out.len - 420)
assert(int(result.get("code", 127)) == 0, "editor search probe exits cleanly: " + str.str_slice(out, error_at, out.len))
assert(out.contains("EDITOR-MULTI-BUFFER-SEARCH-OK"), "editor search probe reached the exact selection assertion")
print("EDITOR-MULTI-BUFFER-SEARCH-OK")
NY
}
