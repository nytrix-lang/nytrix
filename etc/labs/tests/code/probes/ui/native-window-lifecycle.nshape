shape native-window-lifecycle {
  family "probe-suite"
  generator "regression"
  features ["ny", "ui", "win32", "cocoa"]
  template ny-test-case
  expect compile_and_run
  flags_matrix "--native-backend=llvm --jit -O0; --native-backend=llvm --jit -O3"
  expect_stdout "NATIVE-WINDOW-LIFECYCLE-OK"
  source ny <<'NY'
use core
use core.os (msleep)
use core.os.ui.window as window
use core.os.ui.window.consts as event_kind
use core.os.ui.window.platform as platform

def target = to_str(__env_get("NY_TEST_ELM_PLATFORM"))
if target == "win32" || target == "cocoa" {
   window.window_hint(window.CLIENT_API, window.NO_API)
   def first = window.open_window("First", 0, 0, 80, 50)
   defer { window.close(first) }
   def second = window.open_window("Second", 100, 0, 80, 50)
   defer { window.close(second) }
   assert(window.backend() == target && window.id(first) && window.id(second), "two native windows on the requested backend")
   def first_id, second_id = window.id(first), window.id(second)
   assert(platform.set_size(first, 115, 70), "resize the first native window")
   assert(platform.set_size(second, 155, 90), "resize the second native window")
   mut seen_first, seen_second = false, false
   mut attempts = 0
   while attempts < 100 && !(seen_first && seen_second) {
      window.poll_events()
      mut event = window.check_event(first)
      while event {
         if window.event_type(event) == event_kind.EVENT_WINDOW_RESIZED && window.event_window_id(event) == first_id && int(window.event_data(event).get("w", 0)) == 115 {
            seen_first = true
         }
         event = window.check_event(first)
      }
      event = window.check_event(second)
      while event {
         if window.event_type(event) == event_kind.EVENT_WINDOW_RESIZED && window.event_window_id(event) == second_id && int(window.event_data(event).get("w", 0)) == 155 {
            seen_second = true
         }
         event = window.check_event(second)
      }
      msleep(5)
      attempts += 1
   }
   assert(seen_first && seen_second, "native resize events retain each source window ID")
} else {
   print("Skipped: set NY_TEST_ELM_PLATFORM under a native display")
}
print("NATIVE-WINDOW-LIFECYCLE-OK")
NY
}
