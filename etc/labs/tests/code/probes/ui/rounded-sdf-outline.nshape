shape rounded_sdf_outline {
  family "runtime/ui"
  generator "regression"
  features [ui sdf outline framebuffer]
  template ny-test-case
  flags_matrix "--native-only -O2"
  expect compile_and_run
  expect_stdout "ROUNDED-OUTLINE-OK"
  source ny <<'NY'
use core
use core.os.ui.render as gfx

assert(gfx.apply_backend_name("mock"), "select software backend")
def win = gfx.init_window(64, 64, "rounded outline probe", 0, false, false, 1)
assert(win && gfx.get_active_backend_name() == "mock", "software backend active")
mut int frame = 0
while frame < 2 {
   if frame == 1 { gfx.request_frame_capture() }
   assert(gfx.begin_frame_clear([1.0, 1.0, 1.0, 1.0]), "begin frame")
   gfx.set_ortho_2d(0.0, 64.0, 64.0, 0.0)
   assert(gfx.draw_rect_rounded_sdf_outline(10.0, 10.0, 44.0, 44.0, 10.0, 4.0, [1.0, 0.0, 0.0, 1.0]), "submit rounded outline")
   assert(gfx.end_frame(), "present frame")
   frame += 1
}
def framebuffer = gfx.read_framebuffer()
assert(is_dict(framebuffer) && int(framebuffer.get("width", 0)) == 64, "read back frame")
def ptr pixels = __ffi_untag_ptr(framebuffer.get("data", 0))
assert(pixels, "framebuffer pixels")
def int edge_r = load8(pixels, (10 * 64 + 32) * 4) & 255
def int edge_g = load8(pixels, (10 * 64 + 32) * 4 + 1) & 255
def int center_r = load8(pixels, (32 * 64 + 32) * 4) & 255
def int center_g = load8(pixels, (32 * 64 + 32) * 4 + 1) & 255
def int center_b = load8(pixels, (32 * 64 + 32) * 4 + 2) & 255
def int outside_r = load8(pixels, (4 * 64 + 32) * 4) & 255
free(pixels)
assert(edge_r > 200 && edge_g < 40, "stroke covers the rounded edge")
assert(center_r > 245 && center_g > 245 && center_b > 245, "outline leaves the center clear")
assert(outside_r > 245, "outline stays inside its bounds")
gfx.close_window()
print("ROUNDED-OUTLINE-OK")
NY
}
