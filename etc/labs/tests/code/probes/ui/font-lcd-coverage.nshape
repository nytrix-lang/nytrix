shape font_lcd_coverage {
  family "probe-suite"
  generator "regression"
  flags_matrix "--native-only -O0; --native-only -O3"
  features ["ny", "font", "freetype", "lcd", "subpixel"]
  template ny-test-case
  expect compile_and_run
  expect_stdout "FONT-LCD-COVERAGE-OK"
  source ny <<'NY'
use core
use core.common as common
use core.os.ui.font.truetype as font
use core.os.ui.render as ui
use core.os.ui.render.vk as vk
use core.os.ui.render.gl as gl

fn check_gpu_lcd(int font_id, str backend, bool grayscale=false) {
   assert(ui.apply_backend_name(backend), "select LCD test renderer")
   assert(ui.init_window(128, 80, "LCD coverage", 0, false, false, 1), "create LCD test window")
   assert(ui.get_active_backend_name() == backend, "selected renderer remains active")
   if backend == "vulkan" {
      assert(vk._get_device(), "create Vulkan device")
   } else {
      assert(bool(gl.capabilities().get("software_upload", false)) == grayscale, "select the expected OpenGL drawing mode")
   }
   mut fb = 0
   mut frame = 0
   while frame < 3 {
      if frame == 2 && backend == "vulkan" { assert(ui.request_frame_capture(), "request Vulkan readback") }
      assert(ui.begin_frame_clear([0.4, 0.4, 0.4, 1.0]), "begin LCD frame")
      ui.set_ortho_2d(0.0, 128.0, 80.0, 0.0)
      assert(ui.draw_text(font_id, "A", 24.0, 26.0, [0.0, 0.0, 0.0, 1.0]), "draw black LCD glyph")
      assert(ui.draw_text_runs(font_id, [["A", 80.0, 26.0]], [1.0, 1.0, 1.0, 1.0]), "draw white LCD glyph")
      if frame == 2 && backend == "opengl" { fb = ui.read_framebuffer() }
      assert(ui.end_frame(), "present LCD frame")
      frame += 1
   }
   if backend == "vulkan" { fb = ui.read_framebuffer() }
   def data = fb.get("data", 0)
   def width = int(fb.get("width", 0))
   def height = int(fb.get("height", 0))
   assert(data && width > 0 && height > 0, "read LCD framebuffer pixels")
   def background = load8(data, 0)
   mut dark_edge = false
   mut light_edge = false
   mut i = 0
   while i < width * height {
      def red = load8(data, i * 4)
      def green = load8(data, i * 4 + 1)
      def blue = load8(data, i * 4 + 2)
      if grayscale { assert(red == green && green == blue, "grayscale fallback has no colored pixels") }
      if (red == green && green == blue) == grayscale {
         if i % width < width / 2 && int(min(red, min(green, blue))) < background { dark_edge = true }
         if i % width >= width / 2 && int(max(red, max(green, blue))) > background { light_edge = true }
      }
      i += 1
   }
   free(data)
   assert(dark_edge && light_edge, backend + " composites the expected coverage for both black and white glyphs")
   ui.font_destroy(font_id)
   ui.close_window()
}

def info = font.load_path("etc/assets/fonts/jetbrains.ttf")
assert(is_dict(info), "bundled font loads")
def gi = font.get_glyph_index(info, 65)
def scale = font.scale_for_pixel_height(info, 18.0)
def bitmap = font.get_glyph_bitmap_lcd(info, scale, scale, gi)
assert(is_dict(bitmap) && bitmap.get("is_lcd", false), "FreeType returns LCD coverage")
def int w = int(bitmap.get("width"))
def int h = int(bitmap.get("height"))
def pixels = bitmap.get("data")
assert(w > 0 && w < 64 && h > 0 && h < 64 && pixels, "LCD bitmap dimensions and storage")
mut differing = false
mut visible = false
mut i = 0
while i < w * h {
   def off = i * 4
   def r = load8(pixels, off)
   def g = load8(pixels, off + 1)
   def b = load8(pixels, off + 2)
   def a = load8(pixels, off + 3)
   if r != g || g != b { differing = true }
   if a > 0 { visible = true }
   assert(a == (r + g + b + 1) / 3, "alpha stores average LCD coverage")
   i += 1
}
assert(visible && differing, "LCD channels carry independent subpixel coverage")
font.unload(info)
def ui_font_id = ui.font_load_lcd("etc/assets/fonts/jetbrains.ttf", 18, ui.FONT_FILTER_NEAREST, "A")
assert(ui_font_id > 0, "LCD-enabled UI font loads")
def initial_font = ui._font_get(ui_font_id)
assert(is_dict(initial_font) && initial_font.get("lcd", false), "UI font retains LCD raster mode")
assert(ui.font_prepare(ui_font_id, "A") == ui_font_id, "LCD font glyph atlas prepares")
def ui_font = ui._font_get(ui_font_id)
def glyph_items = dict_items(ui_font.get("glyphs", dict(0)))
assert(glyph_items.len > 0, "LCD font caches primed glyphs")
def glyph_pair = glyph_items.get(0, [])
def glyph_entry = glyph_pair.get(1, 0)
def lcd_bitmap = glyph_entry ? glyph_entry.get("bitmap", 0) : 0
assert(is_dict(lcd_bitmap) && lcd_bitmap.get("is_lcd", false), "resolved UI glyph uses LCD raster")
def atlas = lcd_bitmap.get("atlas", nil)
def uv = lcd_bitmap.get("uv", [])
assert(is_dict(atlas) && uv.len == 4, "LCD glyph is packed in a real atlas region")
def atlas_width = int(atlas.get("width"))
def atlas_height = int(atlas.get("height"))
def atlas_pixels = atlas.get("cpu_buf", 0)
assert(atlas_pixels, "LCD atlas has CPU pixels")
def atlas_x = int(float(uv.get(0)) * float(atlas_width) + 0.5)
def atlas_y = int(float(uv.get(1)) * float(atlas_height) + 0.5)
assert(atlas_x >= 0 && atlas_x + w <= atlas_width && atlas_y >= 0 && atlas_y + h <= atlas_height, "LCD atlas glyph is in bounds")
mut row = 0
while row < h {
   mut col = 0
   while col < w {
      def atlas_offset = ((atlas_y + row) * atlas_width + atlas_x + col) * 4
      assert(load32(atlas_pixels, atlas_offset) == load32(pixels, (row * w + col) * 4), "atlas preserves each LCD coverage channel")
      col += 1
   }
   row += 1
}
free(pixels)
if common.env_truthy("NYTRIX_TEST_LCD_VULKAN") { check_gpu_lcd(ui_font_id, "vulkan") }
elif common.env_truthy("NYTRIX_TEST_LCD_OPENGL") { check_gpu_lcd(ui_font_id, "opengl", common.env_truthy("NY_GL_SOFTWARE_DRAW")) }
else { ui.font_destroy(ui_font_id) }
print("FONT-LCD-COVERAGE-OK")
NY
}
