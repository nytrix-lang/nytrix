shape font_lcd_coverage {
  family "probe-suite"
  generator "regression"
  features ["ny", "font", "freetype", "lcd", "subpixel"]
  template ny-test-case
  expect compile_and_run
  expect_stdout "FONT-LCD-COVERAGE-OK"
  source ny <<'NY'
use core
use core.os.ui.font.truetype as font

def info = font.load_path("etc/assets/fonts/jetbrains.ttf")
assert(is_dict(info), "bundled font loads")
def gi = font.get_glyph_index(info, 65)
def scale = font.scale_for_pixel_height(info, 18.0)
def bitmap = font.get_glyph_bitmap_lcd(info, scale, scale, gi)
assert(is_dict(bitmap) && bitmap.get("is_lcd", false), "FreeType returns LCD coverage")
def int w = int(bitmap.get("width"))
def int h = int(bitmap.get("height"))
def pixels = bitmap.get("data")
assert(w > 0 && w < 64 && h > 0 && h < 64 && pixels, "LCD bitmap dimensions and storage")
mut differing = false
mut visible = false
mut i = 0
while i < w * h {
   def off = i * 4
   def r = load8(pixels, off)
   def g = load8(pixels, off + 1)
   def b = load8(pixels, off + 2)
   def a = load8(pixels, off + 3)
   if r != g || g != b { differing = true }
   if a > 0 { visible = true }
   assert(a == (r + g + b + 1) / 3, "alpha stores average LCD coverage")
   i += 1
}
assert(visible && differing, "LCD channels carry independent subpixel coverage")
free(pixels)
font.unload(info)
print("FONT-LCD-COVERAGE-OK")
NY
}
