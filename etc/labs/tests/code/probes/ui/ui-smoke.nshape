defaults {
  family "runtime-ui"
  generator "embedded"
  features [ui replay native jit vm bounded]
  template ny-test-case
  flags "--native --run -O0 --no-progress"
  timeout 420
  expect compile_and_run
  expect_message "UI-REPLAY-OK"
}

shape ui_replay_animation {
  source ny <<'NY'
use core
use core.os.subprocess (run_capture)
def test_bin = env("NYTRIX_NY_TEST_BIN")
def compiler = env("NYTRIX_NY_FULL_BIN")
assert(is_str(test_bin) && test_bin.len > 0, "runner provides ny-test executable")
assert(is_str(compiler) && compiler.len > 0, "runner provides compiler")
def result = run_capture([test_bin, "ui-replay", "--compiler", compiler, "--apps", "animation", "--timeout", "290"], [], nil, false)
print(result.get("stdout", ""))
print(result.get("stderr", ""))
assert(int(result.get("code", 127)) == 0, "animation native, JIT, and VM replay pass")
NY
}

