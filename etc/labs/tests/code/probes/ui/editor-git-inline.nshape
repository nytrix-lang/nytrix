shape editor_git_inline {
  family "runtime-ui"
  generator "embedded"
  features ["ui", "editor", "git"]
  template ny-test-case
  flags "--native --run -O0 --no-progress"
  timeout 600
  expect compile_and_run
  expect_stdout "EDITOR-GIT-INLINE-OK"
  source ny <<'NY'
use core
use core.os.subprocess (run_capture)
def compiler = env("NYTRIX_NY_FULL_BIN")
assert(is_str(compiler) && compiler.len > 0, "runner provides compiler")
def result = run_capture(["env", "NY_UI_HEADLESS=1", "NY_EDITOR_PROBE_GIT_INLINE=1", "NYTRIX_UI_REPLAY=1",
   "NYTRIX_UI_REPLAY_HASH=0", "NYTRIX_FIXTURE_FRAMES=120", compiler, "--native-only", "-O0", "etc/labs/editor.ny"], [], nil, false)
def out = to_str(result.get("stdout", ""))
assert(int(result.get("code", 127)) == 0, "editor git inline probe exits cleanly: " + out + to_str(result.get("stderr", "")))
assert(out.contains("EDITOR-GIT-INLINE-OK"), "real blame reaches the editor frame")
print("EDITOR-GIT-INLINE-OK")
NY
}
