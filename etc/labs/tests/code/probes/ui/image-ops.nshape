shape image_ops {
  family "image"
  generator "embedded"
  features ["ny", "image"]
  template ny-test-case
  flags_matrix "--native-only -O0; --native-only -O3; --native-backend=llvm --jit --jit-engine=mcjit"
  expect compile_and_run
  expect_stdout "image operations passed"
  source ny <<'NY'
use core
use core.math.parse.img as img
use core.os.ui.font.truetype as ttf
def source = img.create(2, 1, [255, 0, 0, 255])
def data = source.get("data")
store8(data, 0, 4) store8(data, 0, 5) store8(data, 255, 6) store8(data, 0, 7)
def copied = img.crop(source, 1, 0, 1, 1)
assert(load8(copied.get("data"), 2) == 255 && load8(copied.get("data"), 3) == 0, "crop copies the selected pixel")
store8(copied.get("data"), 1, 2)
assert(load8(data, 6) == 255, "crop owns its pixels")
assert(!img.crop(source, 1, 0, 2, 1) && !img.crop(source, -1, 0, 1, 1), "invalid crop rejected")
def near = img.resize(source, 4, 1, "nearest")
assert(load8(near.get("data"), 0) == 255 && load8(near.get("data"), 8 + 2) == 255, "nearest pixel selection")
def smooth = img.resize(source, 3, 1)
def pixels = smooth.get("data")
assert(load8(pixels, 4) == 255 && load8(pixels, 6) == 0 && load8(pixels, 7) == 128, "bilinear interpolates premultiplied alpha")
assert(!img.resize(source, 0, 1) && !img.resize(source, 1, 1, "unknown"), "invalid resize rejected")
def gray = img.create(4, 1, [128, 73])
def quant = img.dither(gray, 1)
def q = quant.get("data")
assert(load8(q, 0) == 255 && load8(q, 2) == 0 && load8(q, 4) == 255 && load8(q, 6) == 0, "dither diffuses quantization error")
assert(load8(q, 1) == 73 && load8(gray.get("data"), 0) == 128 && !img.dither(gray, 0), "dither preserves alpha and input")
def grid = img.create(2, 3, [0])
def gd = grid.get("data")
mut int gi = 0
while gi < 6 { store8(gd, gi + 1, gi) gi += 1 }
def cw = img.rotate90(grid)
assert(cw.get("width") == 3 && cw.get("height") == 2 && load8(cw.get("data"), 0) == 5 && load8(cw.get("data"), 5) == 2, "clockwise rotation of non-square image")
def ccw = img.rotate90(cw, false)
gi = 0
while gi < 6 { assert(load8(ccw.get("data"), gi) == gi + 1, "inverse rotations") gi += 1 }
def mirrored = img.flip(grid, true, true)
assert(load8(mirrored.get("data"), 0) == 6 && load8(mirrored.get("data"), 5) == 1, "mirror both axes")
def padded = img.canvas(grid, 2, 2, -1, 1, [9])
assert(load8(padded.get("data"), 0) == 9 && load8(padded.get("data"), 2) == 2 && load8(padded.get("data"), 3) == 9, "canvas clips and fills")
def extracted = img.channel(source, 2)
assert(load8(extracted.get("data"), 0) == 0 && load8(extracted.get("data"), 1) == 255 && !img.channel(source, 4), "channel extraction")
def inverted = img.invert(source)
assert(load8(inverted.get("data"), 0) == 0 && load8(inverted.get("data"), 1) == 255 && load8(inverted.get("data"), 3) == 255 && load8(inverted.get("data"), 7) == 0, "invert preserves alpha")
def check = img.checked(3, 2, 2, 1, [10], [20])
assert(load8(check.get("data"), 0) == 10 && load8(check.get("data"), 2) == 20 && load8(check.get("data"), 3) == 20 && load8(check.get("data"), 5) == 10, "checkerboard cells")
def color_pixel = img.create(2, 1, [255, 0, 0, 128])
store8(color_pixel.get("data"), 0, 4) store8(color_pixel.get("data"), 255, 5) store8(color_pixel.get("data"), 0, 6) store8(color_pixel.get("data"), 64, 7)
def gray_pixels = img.grayscale(color_pixel)
assert(load8(gray_pixels.get("data"), 0) == 76 && load8(gray_pixels.get("data"), 4) == 150 && load8(gray_pixels.get("data"), 7) == 64, "grayscale luminance preserves alpha")
def tinted = img.tint(color_pixel, [128, 255, 255, 128])
assert(load8(tinted.get("data"), 0) == 128 && load8(tinted.get("data"), 3) == 64 && load8(color_pixel.get("data"), 0) == 255, "tint multiplies all channels and copies")
def brighter = img.brightness(color_pixel, 20)
assert(load8(brighter.get("data"), 0) == 255 && load8(brighter.get("data"), 1) == 20 && load8(brighter.get("data"), 3) == 128 && !img.brightness(color_pixel, 256), "brightness clamps colors and preserves alpha")
def contrast_zero = img.contrast(color_pixel, 0)
assert(load8(contrast_zero.get("data"), 0) == 255 && load8(contrast_zero.get("data"), 1) == 0 && !img.contrast(color_pixel, 101), "zero contrast is identity and range validated")
def replaced = img.replace_color(color_pixel, [255, 0, 0, 128], [1, 2, 3, 4])
assert(load8(replaced.get("data"), 0) == 1 && load8(replaced.get("data"), 3) == 4 && load8(replaced.get("data"), 4) == 0, "exact color replacement")
def premultiplied = img.alpha_premultiply(color_pixel)
assert(load8(premultiplied.get("data"), 0) == 128 && load8(premultiplied.get("data"), 3) == 128 && load8(premultiplied.get("data"), 4) == 0 && load8(premultiplied.get("data"), 7) == 64, "premultiplication and copy")
def mask = img.create(2, 1, [128])
def masked = img.alpha_mask(color_pixel, mask)
assert(load8(masked.get("data"), 3) == 64 && load8(masked.get("data"), 7) == 32 && !img.alpha_mask(color_pixel, img.create(1, 1, [255])), "mask multiplies existing alpha and validates size")
def alpha_box = img.create(4, 3, [0, 0, 0, 0])
store8(alpha_box.get("data"), 10, (1 * 4 + 1) * 4 + 3)
store8(alpha_box.get("data"), 200, (2 * 4 + 2) * 4 + 3)
def alpha_cropped = img.alpha_crop(alpha_box, 0.0)
def alpha_rect = img.alpha_bounds(alpha_box, 0.0)
assert(alpha_rect.get("x") == 1 && alpha_rect.get("y") == 1 && alpha_rect.get("width") == 2 && alpha_rect.get("height") == 2 && alpha_cropped.get("width") == 2 && alpha_cropped.get("height") == 2 && load8(alpha_cropped.get("data"), 3) == 10 && load8(alpha_cropped.get("data"), 15) == 200 && alpha_box.get("width") == 4, "alpha bounds and crop find inclusive visible rectangle")
def alpha_empty = img.alpha_crop(img.create(2, 2, [4, 5, 6, 0]), 0.0)
def empty_bounds = img.alpha_bounds(img.create(2, 2, [4, 5, 6, 0]), 0.0)
def opaque_bounds = img.alpha_bounds(img.create(3, 2, [4, 5, 6]), 0.0)
assert(alpha_empty.get("width") == 2 && alpha_empty.get("height") == 2 && empty_bounds.get("width") == 0 && empty_bounds.get("height") == 0 && opaque_bounds.get("x") == 0 && opaque_bounds.get("y") == 0 && opaque_bounds.get("width") == 3 && opaque_bounds.get("height") == 2 && !img.alpha_crop(alpha_box, 1.1), "empty/opaque alpha bounds and threshold limits")
def cleared = img.alpha_clear(alpha_box, [20, 40, 60, 128], 0.0)
assert(load8(cleared.get("data"), 0) == 20 && load8(cleared.get("data"), 1) == 40 && load8(cleared.get("data"), 2) == 60 && load8(cleared.get("data"), 3) == 128 && load8(cleared.get("data"), (1 * 4 + 1) * 4 + 3) == 10 && load8(alpha_box.get("data"), 0) == 0, "alpha clear replaces transparent pixels and preserves visible pixels")
def gray_alpha_clear = img.alpha_clear(img.create(1, 1, [90, 0]), [200, 20, 10], 0.0)
assert(load8(gray_alpha_clear.get("data"), 0) == 73 && load8(gray_alpha_clear.get("data"), 1) == 255, "gray-alpha clear maps color and default alpha")
assert(img.pixel(color_pixel, 0, 0).get(0) == 255 && img.pixel(color_pixel, 1, 0).get(3) == 64 && !img.pixel(color_pixel, 2, 0), "pixel read and bounds")
def linear = img.gradient_linear(2, 2, 0, [0, 0, 0, 255], [255, 255, 255, 0])
assert(load8(linear.get("data"), 0) == 0 && load8(linear.get("data"), 4) == 0 && load8(linear.get("data"), 8) == 255 && load8(linear.get("data"), 15) == 0, "linear gradient direction and alpha interpolation")
def linear_h = img.gradient_linear(2, 1, 90, [0, 0, 0, 255], [255, 255, 255, 255])
assert(load8(linear_h.get("data"), 0) == 0 && load8(linear_h.get("data"), 4) == 255, "horizontal linear gradient")
def radial = img.gradient_radial(4, 4, 0.0, [7, 8, 9, 255], [200, 201, 202, 0])
assert(load8(radial.get("data"), (2 * 4 + 2) * 4) == 7 && load8(radial.get("data"), 0) == 200 && load8(radial.get("data"), 3) == 0 && !img.gradient_radial(1, 1, 1.0, [0, 0, 0, 0], [1, 1, 1, 1]), "radial gradient center, edge and density validation")
def square = img.gradient_square(4, 4, 0.0, [3, 0, 0, 255], [240, 0, 0, 255])
assert(load8(square.get("data"), (2 * 4 + 2) * 4) == 3 && load8(square.get("data"), 0) == 240 && !img.gradient_square(1, 1, 1.0, [0, 0, 0, 0], [1, 1, 1, 1]), "square gradient distance and validation")
def rotate_source = img.create(2, 1, [10])
store8(rotate_source.get("data"), 200, 1)
def rotated = img.rotate(rotate_source, 90)
assert(rotated.get("width") == 1 && rotated.get("height") == 2, "arbitrary rotation bounds")
assert(load8(rotated.get("data"), 0) == 10 && load8(rotated.get("data"), 1) == 200, "arbitrary rotation samples")
assert(!img.rotate(0, 90), "arbitrary rotation rejects invalid image")
def convolve_source = img.create(3, 1, [0])
store8(convolve_source.get("data"), 100, 1)
def blurred = img.convolve(convolve_source, [0.0, 0.0, 0.0, 0.25, 0.5, 0.25, 0.0, 0.0, 0.0])
assert(load8(blurred.get("data"), 0) == 25 && load8(blurred.get("data"), 1) == 50 && load8(blurred.get("data"), 2) == 25 && load8(convolve_source.get("data"), 1) == 100 && !img.convolve(convolve_source, [1.0, 2.0]), "convolution edge replication and ownership")
def blur_source = img.create(5, 1, [0, 0, 0, 255])
store8(blur_source.get("data"), 255, (2 * 4)) store8(blur_source.get("data"), 255, (2 * 4) + 1) store8(blur_source.get("data"), 255, (2 * 4) + 2)
def blur_result = img.blur(blur_source, 1)
assert(load8(blur_result.get("data"), 2 * 4) < 255 && load8(blur_result.get("data"), 1 * 4) > 0 && load8(blur_result.get("data"), 3 * 4) > 0 && load8(blur_result.get("data"), 2 * 4 + 3) == 255 && load8(blur_source.get("data"), 2 * 4) == 255 && !img.blur(blur_source, 0), "blur smooths, preserves opaque alpha, and copies")
def white_a = img.white_noise(16, 8, 0.5, 42)
def white_b = img.white_noise(16, 8, 0.5, 42)
def white_c = img.white_noise(16, 8, 0.5, 43)
def wa = white_a.get("data")
def wb = white_b.get("data")
def wc = white_c.get("data")
mut bool white_diff = false
mut int wi = 0
while wi < 16 * 8 * 4 { assert(load8(wa, wi) == load8(wb, wi), "white noise is reproducible") if load8(wa, wi) != load8(wc, wi) { white_diff = true } wi += 1 }
assert(white_diff && !img.white_noise(0, 8, 0.5), "white noise seed and dimensions")
def perlin_a = img.perlin_noise(9, 5, 0, 0, 3.0, 17)
def perlin_b = img.perlin_noise(9, 5, 0, 0, 3.0, 17)
def perlin_c = img.perlin_noise(9, 5, 1, 0, 3.0, 17)
mut bool perlin_diff = false
mut int pi = 0
while pi < 9 * 5 * 4 { assert(load8(perlin_a.get("data"), pi) == load8(perlin_b.get("data"), pi), "Perlin noise is reproducible") if load8(perlin_a.get("data"), pi) != load8(perlin_c.get("data"), pi) { perlin_diff = true } pi += 1 }
assert(perlin_diff && !img.perlin_noise(9, 5, 0, 0, -1.0), "Perlin offsets and scale bounds")
def cells_a = img.cellular(12, 9, 3, 7)
def cells_b = img.cellular(12, 9, 3, 7)
def cells_c = img.cellular(12, 9, 3, 8)
mut bool cells_diff = false
mut int ci = 0
while ci < 12 * 9 * 4 { assert(load8(cells_a.get("data"), ci) == load8(cells_b.get("data"), ci), "cellular noise is reproducible") if load8(cells_a.get("data"), ci) != load8(cells_c.get("data"), ci) { cells_diff = true } ci += 1 }
assert(cells_diff, "cellular seed changes pattern")
assert(!img.cellular(12, 9, 0), "cellular validates tile size")
def draw_base = img.create(5, 4, [0, 0, 0])
def dp = img.draw_pixel(draw_base, 1, 1, [255, 0, 0, 80])
assert(load8(dp.get("data"), (1 * 5 + 1) * 3) == 255 && load8(dp.get("data"), (1 * 5 + 1) * 3 + 1) == 0 && load8(draw_base.get("data"), (1 * 5 + 1) * 3) == 0, "draw pixel maps RGB and copies")
def dr = img.draw_rect(draw_base, -1, 1, 3, 2, [0, 255, 0])
assert(load8(dr.get("data"), (1 * 5) * 3 + 1) == 255 && load8(dr.get("data"), (2 * 5 + 1) * 3 + 1) == 255 && load8(dr.get("data"), (1 * 5 + 2) * 3 + 1) == 0, "filled rectangle clips to bounds")
def dl = img.draw_line(draw_base, -2, 0, 4, 3, [0, 0, 255])
assert(load8(dl.get("data"), (1 * 5) * 3 + 2) == 255 && load8(dl.get("data"), (3 * 5 + 4) * 3 + 2) == 255 && load8(dl.get("data"), (0 * 5 + 4) * 3 + 2) == 0, "line clipping and octant traversal")
def dc = img.draw_circle(draw_base, 2, 2, 1, [255, 255, 0])
assert(load8(dc.get("data"), (2 * 5 + 2) * 3) == 255 && load8(dc.get("data"), (1 * 5 + 2) * 3) == 255 && load8(dc.get("data"), (0 * 5 + 0) * 3) == 0 && !img.draw_circle(draw_base, 2, 2, -1, [0, 0, 0]), "filled circle and radius validation")
def draw_gray = img.draw_pixel(img.create(1, 1, [0]), 0, 0, [255, 0, 0])
assert(load8(draw_gray.get("data"), 0) == 76 && !img.draw_rect(draw_base, 0, 0, -1, 2, [1, 2, 3]), "drawing converts color channels and validates geometry")
def outline = img.draw_rect_outline(draw_base, 1, 1, 3, 2, [255, 255, 255])
assert(load8(outline.get("data"), (1 * 5 + 1) * 3) == 255 && load8(outline.get("data"), (1 * 5 + 2) * 3) == 255 && load8(outline.get("data"), (1 * 5 + 2) * 3 + 1) == 255 && load8(outline.get("data"), (1 * 5 + 2) * 3 + 2) == 255 && load8(outline.get("data"), (1 * 5 + 2) * 3) == 255, "rectangle outline draws perimeter")
def circle_outline = img.draw_circle_outline(draw_base, 2, 2, 1, [0, 255, 255])
assert(load8(circle_outline.get("data"), (2 * 5 + 1) * 3 + 1) == 255 && load8(circle_outline.get("data"), (2 * 5 + 3) * 3 + 2) == 255 && load8(circle_outline.get("data"), (2 * 5 + 2) * 3 + 1) == 0, "circle outline leaves center empty")
def blit_dst = img.create(3, 1, [0, 0, 255, 255])
def blit_src = img.create(2, 1, [255, 0, 0, 128])
def blit = img.draw_image(blit_dst, blit_src, -1, 0)
assert(load8(blit.get("data"), 0) == 129 && load8(blit.get("data"), 2) == 126 && load8(blit.get("data"), 3) == 255 && load8(blit_src.get("data"), 0) == 255 && load8(blit_dst.get("data"), 0) == 0, "image blit clips, alpha blends and copies")
def tinted_blit = img.draw_image(blit_dst, img.create(1, 1, [100, 100, 100]), 1, 0, [255, 0, 255])
assert(load8(tinted_blit.get("data"), 4) == 100 && load8(tinted_blit.get("data"), 5) == 0 && load8(tinted_blit.get("data"), 6) == 100 && load8(tinted_blit.get("data"), 7) == 255, "image blit tint and three-channel default alpha")
def triangle_base = img.create(5, 4, [0])
def triangle = img.draw_triangle(triangle_base, 0, 0, 4, 0, 0, 3, [200, 20, 10])
def triangle_reverse = img.draw_triangle(triangle_base, 0, 3, 4, 0, 0, 0, [200, 20, 10])
assert(load8(triangle.get("data"), 0) == 73 && load8(triangle.get("data"), 1 * 5 + 1) == 73 && load8(triangle.get("data"), 3 * 5) == 73 && load8(triangle.get("data"), 3 * 5 + 4) == 0, "filled triangle interior and clipping")
mut int ti = 0
while ti < 20 { assert(load8(triangle.get("data"), ti) == load8(triangle_reverse.get("data"), ti), "triangle winding is invariant") ti += 1 }
def triangle_line = img.draw_triangle_outline(triangle_base, -1, 0, 4, 0, 2, 3, [255, 0, 0])
assert(load8(triangle_line.get("data"), 0) == 76 && load8(triangle_line.get("data"), 4) == 76 && !img.draw_triangle(0, 0, 0, 1, 1, 2, 2, [1, 2, 3]), "triangle outline clipping and invalid input")
def triangle_gradient = img.draw_triangle_gradient(triangle_base, 0, 0, [255, 0, 0], 4, 0, [0, 255, 0], 0, 3, [0, 0, 255])
assert(load8(triangle_gradient.get("data"), 0) == 76 && load8(triangle_gradient.get("data"), 4) == 150 && load8(triangle_gradient.get("data"), 3 * 5) == 29 && load8(triangle_gradient.get("data"), 19) == 0, "gradient triangle vertex colors and coverage")
def scale_src = img.create(2, 1, [10])
store8(scale_src.get("data"), 200, 1)
def scaled = img.draw_image_scaled(img.create(4, 3, [0]), scale_src, 0, 0, 4, 2)
assert(load8(scaled.get("data"), 0) == 10 && load8(scaled.get("data"), 1) == 10 && load8(scaled.get("data"), 2) == 200 && load8(scaled.get("data"), 4 + 3) == 200, "nearest scaled image mapping")
def rotated_blit = img.draw_image_ex(img.create(4, 4, [0]), scale_src, 2, 0, 90.0)
assert(load8(rotated_blit.get("data"), 1) == 10 && load8(rotated_blit.get("data"), 5) == 200, "rotated image uses source top-left origin")
def rgba_to_gray = img.convert_channels(color_pixel, 1)
def rgba_to_ga = img.convert_channels(color_pixel, 2)
def rgba_to_rgb = img.convert_channels(color_pixel, 3)
def ga_to_rgba = img.convert_channels(masked, 4)
assert(rgba_to_gray.get("channels") == 1 && load8(rgba_to_gray.get("data"), 0) == 76 && rgba_to_ga.get("channels") == 2 && load8(rgba_to_ga.get("data"), 1) == 128 && rgba_to_rgb.get("channels") == 3 && load8(rgba_to_rgb.get("data"), 0) == 255 && ga_to_rgba.get("channels") == 4 && load8(ga_to_rgba.get("data"), 0) == 255 && load8(ga_to_rgba.get("data"), 3) == 64, "channel conversion preserves color and alpha")
assert(!img.convert_channels(color_pixel, 5), "channel conversion validates destination format")
def pot_source = img.create(3, 2, [9, 8, 7])
def pot = img.to_pot(pot_source, [1, 2, 3])
assert(pot.get("width") == 4 && pot.get("height") == 2 && load8(pot.get("data"), 9) == 1 && load8(pot.get("data"), 10) == 2 && load8(pot.get("data"), 11) == 3 && load8(pot.get("data"), 6) == 9 && !img.to_pot(pot_source, [0]), "power-of-two padding and channel validation")
def mip_source = img.create(3, 2, [100, 50, 25, 255])
def mip_chain = img.mipmaps(mip_source)
assert(mip_chain.len == 2 && mip_chain.get(0).get("width") == 3 && mip_chain.get(0).get("height") == 2 && mip_chain.get(1).get("width") == 1 && mip_chain.get(1).get("height") == 1 && load8(mip_chain.get(1).get("data"), 0) == 100 && mip_source.get("width") == 3, "mipmap chain includes base and odd-size endpoint")
def mip_tall = img.mipmaps(img.create(1, 4, [77]))
assert(mip_tall.len == 3 && mip_tall.get(2).get("height") == 1 && !img.mipmaps(0), "mipmap chain handles one-wide inputs")
def palette_image = img.create(4, 1, [0, 0, 0, 0])
def palette_bytes = palette_image.get("data")
store8(palette_bytes, 255, 0) store8(palette_bytes, 0, 1) store8(palette_bytes, 0, 2) store8(palette_bytes, 255, 3)
store8(palette_bytes, 255, 4) store8(palette_bytes, 0, 5) store8(palette_bytes, 0, 6) store8(palette_bytes, 255, 7)
store8(palette_bytes, 0, 8) store8(palette_bytes, 255, 9) store8(palette_bytes, 0, 10) store8(palette_bytes, 0, 11)
store8(palette_bytes, 0, 12) store8(palette_bytes, 0, 13) store8(palette_bytes, 255, 14) store8(palette_bytes, 128, 15)
def colors = img.rgba_colors(palette_image)
def color_palette = img.palette(palette_image, 8)
def limited_palette = img.palette(palette_image, 1)
assert(colors.len == 4 && colors.get(0).get(0) == 255 && colors.get(1).get(3) == 255 && colors.get(2).get(3) == 0 && color_palette.len == 2 && color_palette.get(0).get(0) == 255 && color_palette.get(1).get(2) == 255 && limited_palette.len == 1 && !img.palette(palette_image, 0), "RGBA color extraction and visible first-seen palette")
def gray_colors = img.rgba_colors(img.create(2, 1, [40]))
assert(gray_colors.get(1).get(0) == 40 && gray_colors.get(1).get(1) == 40 && gray_colors.get(1).get(2) == 40 && gray_colors.get(1).get(3) == 255, "grayscale color expansion")
def font = ttf.load_path("etc/assets/fonts/monocraft.ttf")
def text_base = img.create(40, 40, [0, 0, 0, 0])
def text_image = img.draw_text(text_base, font, "A\nA", -2, 0, 16, [255, 32, 16, 255])
mut text_visible = 0
mut text_lower_visible = 0
mut text_pixel = 0
while text_pixel < 40 * 40 {
   if load8(text_image.get("data"), text_pixel * 4 + 3) > 0 {
      text_visible += 1
      if text_pixel / 40 >= 16 { text_lower_visible += 1 }
      assert(load8(text_image.get("data"), text_pixel * 4) == 255 && load8(text_image.get("data"), text_pixel * 4 + 1) == 32, "text tint applied to covered glyph pixels")
   }
   text_pixel += 1
}
assert(text_visible > 0 && text_lower_visible > 0 && load8(text_base.get("data"), 3) == 0 && !img.draw_text(text_base, font, "A", 0, 0, 0), "TrueType text rasterization, multiline advance, clipping, and input ownership")
def opaque_text = img.draw_text(img.create(32, 24, [0, 0, 0, 255]), font, "A", 0, 0, 16, [255, 32, 16, 255])
mut blended_glyph = false
mut opaque_pixel = 0
while opaque_pixel < 32 * 24 {
   if load8(opaque_text.get("data"), opaque_pixel * 4 + 1) > 0 { blended_glyph = true }
   if load8(opaque_text.get("data"), opaque_pixel * 4 + 3) != 255 { assert(false, "text blends while preserving opaque destination alpha") }
   opaque_pixel += 1
}
assert(blended_glyph, "TrueType antialiasing blends onto opaque destination")
ttf.unload(font)
def packed_src = img.create(3, 1, [255, 0, 0, 255])
store8(packed_src.get("data"), 0, 4) store8(packed_src.get("data"), 255, 5) store8(packed_src.get("data"), 0, 6) store8(packed_src.get("data"), 127, 7)
store8(packed_src.get("data"), 0, 8) store8(packed_src.get("data"), 0, 9) store8(packed_src.get("data"), 255, 10) store8(packed_src.get("data"), 128, 11)
def rgb565 = img.pack16(packed_src, "rgb565")
def rgba5551 = img.pack16(packed_src, "rgba5551")
def rgba4444 = img.pack16(packed_src, "rgba4444")
assert(rgb565.get("bits_per_pixel") == 16, "packed word metadata")
assert(load8(rgb565.get("data"), 0) == 0 && load8(rgb565.get("data"), 1) == 248, "RGB565 word layout")
assert(load8(rgba5551.get("data"), 0) == 1 && load8(rgba5551.get("data"), 1) == 248, "RGBA5551 word layout")
assert(load8(rgba4444.get("data"), 0) == 15 && load8(rgba4444.get("data"), 1) == 240, "RGBA4444 word layout")
def rgb565_round = img.unpack16(rgb565)
def rgba5551_round = img.unpack16(rgba5551)
def rgba4444_round = img.unpack16(rgba4444)
assert(rgb565_round.get("channels") == 4 && load8(rgb565_round.get("data"), 0) == 255 && load8(rgb565_round.get("data"), 3) == 255 && load8(rgba5551_round.get("data"), 7) == 0 && load8(rgba5551_round.get("data"), 11) == 255 && load8(rgba4444_round.get("data"), 3) == 255 && !img.pack16(packed_src, "unknown") && !img.unpack16(0), "packed formats roundtrip and validate")
def gradient_rect = img.draw_rect_gradient(img.create(3, 3, [0]), 0.0, 0.0, 2.0, 2.0, [0, 0, 0], [100, 100, 100], [200, 200, 200], [100, 100, 100])
assert(load8(gradient_rect.get("data"), 0) == 0 && load8(gradient_rect.get("data"), 1) == 50 && load8(gradient_rect.get("data"), 4) == 100 && load8(gradient_rect.get("data"), 2) == 0, "rectangle gradient interpolates corners and clips")
def gradient_circle = img.draw_circle_gradient(img.create(5, 5, [0]), 2.0, 2.0, 2.0, [0, 0, 0], [255, 255, 255])
assert(load8(gradient_circle.get("data"), 2 * 5 + 2) < load8(gradient_circle.get("data"), 2 * 5) && load8(gradient_circle.get("data"), 2 * 5) > 0 && load8(gradient_circle.get("data"), 0) == 0 && !img.draw_circle_gradient(gradient_circle, 2.0, 2.0, 0.0, [0, 0, 0], [255, 255, 255]), "circle gradient center, edge and validation")
def encoded = img.encode(source, "png")
def decoded = img.decode(encoded)
def roundtrip = img.crop(decoded, 0, 0, 2, 1)
assert(load8(roundtrip.get("data"), 0) == 255 && load8(roundtrip.get("data"), 6) == 255, "decoded image works")
print("image operations passed")
NY
}
