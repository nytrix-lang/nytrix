shape editor_lsp_tokens {
  family "ui/editor"
  generator "embedded"
  features ["ny", "editor", "lsp"]
  template ny-test-case
  flags_matrix "--native-only -O0; --native-only -O3; --native-backend=llvm --jit --jit-engine=mcjit -O0"
  expect compile_and_run
  expect_stdout "editor lsp tokens passed"
  source ny <<'NY'
use core
use core.os.ui.render.viewer.editor.lsp as lsp
use core.math.parse.syntax as syntax

fn merged_kind(list runs, int col) int {
   for run in runs {
      def int start = int(run.get(1, 0))
      if col >= start && col < start + int(run.get(2, 0)) { return int(run.get(0, -1)) }
   }
   -1
}

def st = lsp.new()
st["caps"] = {"semanticTokensProvider": {"legend": {"tokenTypes": ["variable", "function"], "tokenModifiers": ["declaration", "readonly"]}}}
def tokens = lsp.decode_semantic_tokens(st, {"data": [0, 2, 3, 0, 1, 0, 4, 2, 1, 2, 2, 1, 5, 0, 3]})
assert(tokens.len == 3 && int(tokens.get(1).get("col")) == 6 && int(tokens.get(2).get("line")) == 2 && int(tokens.get(2).get("col")) == 1, "relative semantic positions")
assert(to_str(tokens.get(1).get("type")) == "function" && tokens.get(2).get("modifiers").len == 2, "semantic legend and modifiers")
assert(lsp.decode_semantic_tokens(st, {"data": [0, 0, 1, 99, 0]}).len == 0 && lsp.decode_semantic_tokens(st, {"data": [1]}).len == 0, "invalid token data rejected")
st["encoding"] = "utf-16"
def merged = lsp.merge_semantic_tokens(st, "a😀b", [[syntax.TOK_COMMENT, 0, 6]], [{"col": 3, "length": 1, "type": "function"}])
assert(merged.len == 2 && int(merged.get(0).get(1)) == 0 && int(merged.get(0).get(2)) == 5 && int(merged.get(1).get(0)) == syntax.TOK_FUNCTION && int(merged.get(1).get(1)) == 5, "semantic UTF-16 spans overlay lexical bytes")
def fallback = lsp.merge_semantic_tokens(st, "abc", [[syntax.TOK_COMMENT, 0, 3]], [{"col": 0, "length": 2, "type": "unknown"}])
assert(fallback.len == 1 && int(fallback.get(0).get(0)) == syntax.TOK_COMMENT, "unknown types preserve syntax")
def modifier_runs = lsp.merge_semantic_tokens(st, "a b c d e", [[syntax.TOK_VARIABLE, 0, 9]], [
   {"col": 0, "length": 1, "type": "variable", "modifiers": ["readonly"]},
   {"col": 2, "length": 1, "type": "function", "modifiers": ["deprecated"]},
   {"col": 4, "length": 1, "type": "variable", "modifiers": ["declaration"]},
   {"col": 6, "length": 1, "type": "method", "modifiers": ["async"]},
   {"col": 8, "length": 1, "type": "variable", "modifiers": ["modification"]}
])
assert(merged_kind(modifier_runs, 0) == 10008 && merged_kind(modifier_runs, 2) == 10007 && merged_kind(modifier_runs, 4) == 10009 && merged_kind(modifier_runs, 6) == 10010 && merged_kind(modifier_runs, 8) == 10011, "LSP modifiers select distinct editor styles")
def standard_modifiers = lsp.merge_semantic_tokens(st, "a b c d", [[syntax.TOK_VARIABLE, 0, 7]], [
   {"col": 0, "length": 1, "type": "variable", "modifiers": ["static"]},
   {"col": 2, "length": 1, "type": "class", "modifiers": ["abstract"]},
   {"col": 4, "length": 1, "type": "string", "modifiers": ["documentation"]},
   {"col": 6, "length": 1, "type": "variable", "modifiers": ["defaultLibrary"]}
])
assert(merged_kind(standard_modifiers, 0) == 10012 && merged_kind(standard_modifiers, 2) == 10013 && merged_kind(standard_modifiers, 4) == 10014 && merged_kind(standard_modifiers, 6) == 10015, "remaining standard semantic modifiers select visible editor styles")
st["caps"] = {"semanticTokensProvider": {"legend": {"tokenTypes": ["event", "decorator", "label", "other", "method"]}}}
def standard = lsp.decode_semantic_tokens(st, {"data": [0, 0, 3, 0, 0, 0, 4, 3, 1, 0, 0, 4, 3, 2, 0, 0, 4, 3, 3, 0, 0, 4, 3, 4, 0]})
def standard_runs = lsp.merge_semantic_tokens(st, "abc def ghi jkl mno", [[syntax.TOK_COMMENT, 0, 19]], standard)
assert(merged_kind(standard_runs, 1) == syntax.TOK_PROPERTY && merged_kind(standard_runs, 5) == syntax.TOK_DIRECTIVE && merged_kind(standard_runs, 9) == syntax.TOK_LABEL && merged_kind(standard_runs, 13) == syntax.TOK_TEXT && merged_kind(standard_runs, 17) == syntax.TOK_FUNCTION, "all remaining standard semantic token kinds overlay lexical colors")
def hints = lsp.decode_inlay_hints([{"position": {"line": 1, "character": 3}, "label": [{"value": ": "}, {"value": "i32"}], "paddingLeft": true}])
def hint = hints.get(0, dict(0))
assert(hints.len == 1 && to_str(hint.get("label", "")) == ": i32" && bool(hint.get("padding_left", false)), "inlay label parts and padding")
def lenses = lsp.decode_code_lenses([
   {"range": {"start": {"line": 2, "character": 0}, "end": {"line": 2, "character": 0}}, "command": {"title": "Run", "command": "nytrix.run", "arguments": [{"uri": "file:///tmp/a.ny", "line": 2}]}},
   {"range": {"start": {"line": 4, "character": 1}, "end": {"line": 4, "character": 1}}, "command": "legacy.lens", "arguments": []},
   {"range": {"start": {"line": 6, "character": 0}, "end": {"line": 6, "character": 0}}, "command": {"title": "Unresolved", "command": ""}},
   {"range": {"start": {"line": 7, "character": 0}, "end": {"line": 7, "character": 0}}}
])
assert(lenses.len == 2, "resolved code lenses only")
assert(int(lenses.get(0).get("line", -1)) == 2 && to_str(lenses.get(0).get("title", "")) == "Run" && to_str(lenses.get(0).get("command", dict(0)).get("command", "")) == "nytrix.run" && lenses.get(0).get("command", dict(0)).get("arguments", []).len == 1, "code lens range and command arguments")
assert(to_str(lenses.get(1).get("command", dict(0)).get("command", "")) == "legacy.lens", "string code lens commands normalize")
def folds = lsp.decode_folding_ranges([
   {"startLine": 1, "endLine": 4, "kind": "region"},
   {"startLine": 6, "endLine": 6},
   {"startLine": -1, "endLine": 8},
   {"startLine": 9, "endLine": 9, "collapsedText": "..."}
])
assert(folds.len == 1 && int(folds.get(0).get("start", -1)) == 1 && int(folds.get(0).get("end", -1)) == 4 && to_str(folds.get(0).get("kind", "")) == "region", "folding ranges normalize and reject empty spans")
print("editor lsp tokens passed")
NY
}
