shape rounded_sdf_clip {
  family "runtime/ui"
  generator "regression"
  features [ui sdf clip framebuffer]
  template ny-test-case
  flags_matrix "--native-only -O2"
  expect compile_and_run
  expect_stdout "ROUNDED-CLIP-OK"
  source ny <<'NY'
use core
use core.os.ui.render as gfx

assert(gfx.apply_backend_name("mock"), "select software backend")
def win = gfx.init_window(64, 64, "rounded clip probe", 0, false, false, 1)
assert(win && gfx.get_active_backend_name() == "mock", "software backend active")
mut int frame = 0
while frame < 2 {
   if frame == 1 { gfx.request_frame_capture() }
   assert(gfx.begin_frame_clear([1.0, 1.0, 1.0, 1.0]), "begin frame")
   gfx.set_ortho_2d(0.0, 64.0, 64.0, 0.0)
   assert(gfx.draw_rect_rounded_sdf_clipped(10.0, 10.0, 44.0, 44.0, 10.0, [1.0, 0.0, 0.0, 1.0], [24.0, 24.0, 20.0, 20.0]), "submit clipped rounded rect")
   assert(gfx.draw_rect_rounded_sdf(2.0, 2.0, 12.0, 12.0, 4.0, [0.0, 0.0, 1.0, 1.0]), "submit after clip")
   assert(gfx.end_frame(), "present frame")
   frame += 1
}
def framebuffer = gfx.read_framebuffer()
assert(is_dict(framebuffer) && int(framebuffer.get("width", 0)) == 64, "read back frame")
def ptr pixels = __ffi_untag_ptr(framebuffer.get("data", 0))
assert(pixels, "framebuffer pixels")
def int inside_r = load8(pixels, (34 * 64 + 34) * 4) & 255
def int inside_g = load8(pixels, (34 * 64 + 34) * 4 + 1) & 255
def int left = load8(pixels, (34 * 64 + 18) * 4) & 255
def int above = load8(pixels, (18 * 64 + 34) * 4) & 255
def int after_b = load8(pixels, (8 * 64 + 8) * 4 + 2) & 255
free(pixels)
assert(inside_r > 200 && inside_g < 40, "inside the clip is red")
assert(left > 245 && above > 245, "outside the clip stays background")
assert(after_b > 200, "scissor was restored after the clipped draw")
gfx.close_window()
print("ROUNDED-CLIP-OK")
NY
}
