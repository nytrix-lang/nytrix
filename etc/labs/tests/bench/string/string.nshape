shape bench_string {
  family "perf-real"
  generator "stress"
  features ["perf", "string", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.str
def int t0 = ticks()
mut s = ""
for i in 0..100000 {
  s = s + "abc"
}
def int t1 = ticks()
def int len = s.len
def int checksum = len * 1000 + str.byte_at(s, 0) +
                   str.byte_at(s, len / 2) + str.byte_at(s, len - 1)
print("checksum=", checksum)
print("bench_elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
  int64_t t0 = now_ns();
  char s[300004];
  size_t used = 0;
  for (int i = 0; i <= 100000; i++) {
    memcpy(s + used, "abc", 3);
    used += 3;
  }
  s[used] = '\0';
  int64_t t1 = now_ns();
  size_t len = strlen(s);
  size_t checksum = len * 1000 + (unsigned char)s[0] +
                    (unsigned char)s[len / 2] + (unsigned char)s[len - 1];
  printf("checksum=%zu\n", checksum);
  printf("bench_elapsed_ns=%lld\n", (long long)(t1 - t0));
  return 0;
}
C
}
