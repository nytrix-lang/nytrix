shape crc32 {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "bitops", "c-vs-ny", "native", "checksum", "time"]
  meta "table-driven CRC-32 over a 1 KiB block, 4000 passes"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.os.time
;; Reflected CRC-32/ISO-HDLC: build the 256-entry table once, then chew the block.
def N = 1024
def buf = i64buf_new(N)
mut i = 0
while i < N {
   i64buf_store(buf, i, (i * 37 + 11) & 0xFF)
   i += 1
}
def tab = i64buf_new(256)
mut n = 0
while n < 256 {
   mut c = n
   mut k = 0
   while k < 8 {
      if (c & 1) == 1 {
         c = 0xEDB88320 ^ (c >> 1)
      } else {
         c = c >> 1
      }
      k += 1
   }
   i64buf_store(tab, n, c & 0xFFFFFFFF)
   n += 1
}
def int t0 = ticks()
mut crc = 0xFFFFFFFF
mut pass = 0
while pass < 4000 {
   mut j = 0
   while j < N {
      def idx = (crc ^ i64buf_load(buf, j)) & 0xFF
      crc = (i64buf_load(tab, idx) ^ (crc >> 8)) & 0xFFFFFFFF
      j += 1
   }
   pass += 1
}
crc = crc ^ 0xFFFFFFFF
def int t1 = ticks()
print("checksum=", crc & 0xFFFFFFFF)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    enum { N = 1024 };
    int64_t buf[N];
    for (int i = 0; i < N; i++) buf[i] = (i * 37 + 11) & 0xFF;
    int64_t tab[256];
    for (int n = 0; n < 256; n++) {
        int64_t c = n;
        for (int k = 0; k < 8; k++) {
            if ((c & 1) == 1)
                c = 0xEDB88320LL ^ (c >> 1);
            else
                c = c >> 1;
        }
        tab[n] = c & 0xFFFFFFFFLL;
    }
    int64_t t0 = now_ns();
    int64_t crc = 0xFFFFFFFFLL;
    for (int pass = 0; pass < 4000; pass++) {
        for (int j = 0; j < N; j++) {
            int64_t idx = (crc ^ buf[j]) & 0xFF;
            crc = (tab[idx] ^ (crc >> 8)) & 0xFFFFFFFFLL;
        }
    }
    crc = crc ^ 0xFFFFFFFFLL;
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)(crc & 0xFFFFFFFFLL));
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
