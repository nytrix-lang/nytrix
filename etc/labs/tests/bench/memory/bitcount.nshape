shape bitcount {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "bitops", "c-vs-ny", "native", "checksum", "time"]
  meta "Parallel bit-hack population counts over 8 MiB of words"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Population count through the SWAR reduction, eight passes over 2^20 words.
def N = 1048576
def w = i64buf_new(N)
mut i = 0
while i < N {
   i64buf_store(w, i, (i * 2654435761) & 0xFFFFFFFF)
   i += 1
}
def int t0 = ticks()
mut total = 0
mut rep = 0
while rep < 8 {
   mut sum = 0
   i = 0
   while i < N {
      mut v = i64buf_load(w, i) & 0xFFFFFFFF
      v = v - ((v >> 1) & 0x55555555)
      v = (v & 0x33333333) + ((v >> 2) & 0x33333333)
      v = (v + (v >> 4)) & 0x0F0F0F0F
      sum += ((v * 0x01010101) & 0xFFFFFFFF) >> 24
      i += 1
   }
   total = (total + sum) % 1000000007
   rep += 1
}
def int t1 = ticks()
print("checksum=", total)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int N = 1048576;
    uint32_t *w = malloc((size_t)N * sizeof(uint32_t));
    for (int i = 0; i < N; i++)
        w[i] = (uint32_t)((int64_t)i * 2654435761LL);
    int64_t t0 = now_ns();
    int64_t total = 0;
    for (int rep = 0; rep < 8; rep++) {
        int64_t sum = 0;
        for (int i = 0; i < N; i++) {
            uint32_t v = w[i];
            v = v - ((v >> 1) & 0x55555555u);
            v = (v & 0x33333333u) + ((v >> 2) & 0x33333333u);
            v = (v + (v >> 4)) & 0x0F0F0F0Fu;
            sum += (v * 0x01010101u) >> 24;
        }
        total = (total + sum) % 1000000007LL;
    }
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)total);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    free(w);
    return 0;
}
C
}
