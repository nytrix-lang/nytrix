shape transpose {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "memory", "c-vs-ny", "native", "checksum", "time"]
  meta "blocked 256x256 matrix transpose, 16x16 tiles"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.os.time
;; Blocked integer matrix transpose, repeated to make the memory traffic dominate.
def N = 256
def B = 16
def src = i64buf_new(N * N)
def dst = i64buf_new(N * N)
mut i = 0
while i < N * N {
   i64buf_store(src, i, (i * 2654435761) % 1000)
   i64buf_store(dst, i, 0)
   i += 1
}
def int t0 = ticks()
mut rep = 0
while rep < 8 {
   mut bi = 0
   while bi < N {
      mut bj = 0
      while bj < N {
         mut y = 0
         while y < B {
            mut x = 0
            while x < B {
               i64buf_store(dst, (bj + x) * N + (bi + y),
                            i64buf_load(src, (bi + y) * N + (bj + x)))
               x += 1
            }
            y += 1
         }
         bj += B
      }
      bi += B
   }
   rep += 1
}
def int t1 = ticks()
mut acc = 0
mut k = 0
while k < N * N {
   acc = (acc + i64buf_load(dst, k)) % 1000000007
   k += 1
}
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    enum { N = 256, B = 16 };
    int64_t *src = (int64_t *)calloc((size_t)N * N, sizeof(int64_t));
    int64_t *dst = (int64_t *)calloc((size_t)N * N, sizeof(int64_t));
    for (int i = 0; i < N * N; i++)
        src[i] = ((int64_t)i * 2654435761LL) % 1000;
    int64_t t0 = now_ns();
    for (int rep = 0; rep < 8; rep++) {
        for (int bi = 0; bi < N; bi += B) {
            for (int bj = 0; bj < N; bj += B) {
                for (int y = 0; y < B; y++) {
                    for (int x = 0; x < B; x++) {
                        dst[(bj + x) * N + (bi + y)] =
                            src[(bi + y) * N + (bj + x)];
                    }
                }
            }
        }
    }
    int64_t t1 = now_ns();
    int64_t acc = 0;
    for (int k = 0; k < N * N; k++)
        acc = (acc + dst[k]) % 1000000007LL;
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    free(src);
    free(dst);
    return 0;
}
C
}
