shape stream-triad {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "memory", "stream", "c-vs-ny", "native", "checksum", "time"]
  meta "STREAM triad over four integer buffers"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.os.time
;; STREAM-style triad: a = b + scalar * c over three arrays.
def N = 262144
def ptr a = i64buf_new(N)
def ptr b = i64buf_new(N)
def ptr c = i64buf_new(N)
mut i = 0
while i < N {
   i64buf_store(a, i, 0)
   i64buf_store(b, i, i * 3 + 1)
   i64buf_store(c, i, (i * 5 + 2) % 1000)
   i += 1
}
def int t0 = ticks()
mut rep = 0
while rep < 64 {
   def scalar = 3 + rep % 7
   i = 0
   while i < N {
      i64buf_store(a, i, i64buf_load(b, i) + scalar * i64buf_load(c, i))
      i += 1
   }
   rep += 1
}
def int t1 = ticks()
mut acc = 0
i = 0
while i < N {
   acc = (acc + i64buf_load(a, i)) % 1000000007
   i += 1
}
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int N = 262144;
    int64_t *a = calloc((size_t)N, sizeof(int64_t));
    int64_t *b = calloc((size_t)N, sizeof(int64_t));
    int64_t *c = calloc((size_t)N, sizeof(int64_t));
    for (int i = 0; i < N; i++) {
        a[i] = 0;
        b[i] = i * 3 + 1;
        c[i] = (i * 5 + 2) % 1000;
    }
    int64_t t0 = now_ns();
    for (int rep = 0; rep < 64; rep++) {
        int64_t scalar = 3 + rep % 7;
        for (int i = 0; i < N; i++) a[i] = b[i] + scalar * c[i];
    }
    int64_t t1 = now_ns();
    int64_t acc = 0;
    for (int i = 0; i < N; i++) acc = (acc + a[i]) % 1000000007;
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
