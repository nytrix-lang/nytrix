shape matmul-int {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "matrix", "c-vs-ny", "native", "checksum", "time"]
  meta "Dense 64x64 integer matrix multiply, 40 repetitions"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf

def n = 64
def a = i64buf_new(n * n)
def b = i64buf_new(n * n)
def c = i64buf_new(n * n)
mut i = 0
while i < n {
  mut j = 0
  while j < n {
    def idx = i * n + j
    i64buf_store(a, idx, (i * 3 + j * 7 + 1) % 97)
    i64buf_store(b, idx, (i * 5 + j * 11 + 2) % 89)
    i64buf_store(c, idx, 0)
    j = j + 1
  }
  i = i + 1
}
mut rep = 0
while rep < 40 {
  i = 0
  while i < n {
    mut j = 0
    while j < n {
      mut sum = 0
      mut k = 0
      while k < n {
        sum = sum + i64buf_load(a, i * n + k) * i64buf_load(b, k * n + j)
        k = k + 1
      }
      i64buf_store(c, i * n + j, sum)
      j = j + 1
    }
    i = i + 1
  }
  rep = rep + 1
}
mut checksum = 0
i = 0
while i < n * n {
  checksum = checksum + i64buf_load(c, i)
  i = i + 1
}
print("checksum=", checksum)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

int main(void) {
  int n = 64;
  int64_t *a = (int64_t *)malloc((size_t)n * n * sizeof(int64_t));
  int64_t *b = (int64_t *)malloc((size_t)n * n * sizeof(int64_t));
  int64_t *c = (int64_t *)malloc((size_t)n * n * sizeof(int64_t));
  for (int i = 0; i < n; ++i) {
    for (int j = 0; j < n; ++j) {
      int idx = i * n + j;
      a[idx] = (i * 3 + j * 7 + 1) % 97;
      b[idx] = (i * 5 + j * 11 + 2) % 89;
      c[idx] = 0;
    }
  }
  for (int rep = 0; rep < 40; ++rep) {
    for (int i = 0; i < n; ++i) {
      for (int j = 0; j < n; ++j) {
        int64_t sum = 0;
        for (int k = 0; k < n; ++k) sum += a[i * n + k] * b[k * n + j];
        c[i * n + j] = sum;
      }
    }
  }
  int64_t checksum = 0;
  for (int i = 0; i < n * n; ++i) checksum += c[i];
  printf("checksum=%lld\n", (long long)checksum);
  free(a); free(b); free(c);
  return 0;
}
C
}
