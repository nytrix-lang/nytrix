shape jacobi-2d {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "stencil", "grid", "c-vs-ny", "native", "checksum", "time"]
  meta "Jacobi 2D five-point relaxation over 192x192, 30 sweeps"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Out-of-place five-point Jacobi sweep. Distinct from sor, which updates the
;; grid in place with an over-relaxation factor.
def N = 192
def a = i64buf_new(N * N)
def b = i64buf_new(N * N)
mut i = 0
while i < N * N {
   def v = (i * 7 + 11) % 1000
   i64buf_store(a, i, v)
   i64buf_store(b, i, v)
   i += 1
}
def int t0 = ticks()
mut sweep = 0
while sweep < 30 {
   mut y = 1
   while y < N - 1 {
      mut x = 1
      while x < N - 1 {
         def idx = y * N + x
         i64buf_store(b, idx,
            (i64buf_load(a, idx - 1) + i64buf_load(a, idx + 1) +
             i64buf_load(a, idx - N) + i64buf_load(a, idx + N)) / 4)
         x += 1
      }
      y += 1
   }
   i = 0
   while i < N * N {
      i64buf_store(a, i, i64buf_load(b, i))
      i += 1
   }
   sweep += 1
}
mut ck = 0
i = 0
while i < N * N {
   ck = (ck + i64buf_load(a, i)) % 1000000007
   i += 1
}
def int t1 = ticks()
print("checksum=", ck)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int N = 192;
    int64_t *a = malloc((size_t)N * N * sizeof(int64_t));
    int64_t *b = malloc((size_t)N * N * sizeof(int64_t));
    for (int i = 0; i < N * N; i++) a[i] = b[i] = (i * 7 + 11) % 1000;
    int64_t t0 = now_ns();
    for (int sweep = 0; sweep < 30; sweep++) {
        for (int y = 1; y < N - 1; y++)
            for (int x = 1; x < N - 1; x++) {
                int idx = y * N + x;
                b[idx] = (a[idx - 1] + a[idx + 1] + a[idx - N] + a[idx + N]) / 4;
            }
        for (int i = 0; i < N * N; i++) a[i] = b[i];
    }
    int64_t ck = 0;
    for (int i = 0; i < N * N; i++) ck = (ck + a[i]) % 1000000007LL;
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)ck);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    free(a); free(b);
    return 0;
}
C
}
