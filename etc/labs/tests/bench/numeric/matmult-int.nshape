shape matmult-int {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "matmul", "c-vs-ny", "native", "checksum", "time"]
  meta "integer 32x32 matrix multiply, 40 accumulated passes"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.os.time
;; Integer counterpart to numeric/dgemm: same access pattern, no floating point.
def M = 32
def A = i64buf_new(M * M)
def B = i64buf_new(M * M)
def C = i64buf_new(M * M)
mut i = 0
while i < M * M {
   i64buf_store(A, i, (i * 7) % 97)
   i64buf_store(B, i, (i * 13) % 89)
   i64buf_store(C, i, 0)
   i += 1
}
def int t0 = ticks()
mut rep = 0
while rep < 40 {
   mut r = 0
   while r < M {
      mut k = 0
      while k < M {
         def a = i64buf_load(A, r * M + k)
         mut c = 0
         while c < M {
            i64buf_store(C, r * M + c,
                         i64buf_load(C, r * M + c) + a * i64buf_load(B, k * M + c))
            c += 1
         }
         k += 1
      }
      r += 1
   }
   rep += 1
}
def int t1 = ticks()
mut acc = 0
mut q = 0
while q < M * M {
   acc = (acc + i64buf_load(C, q)) % 1000000007
   q += 1
}
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    enum { M = 32 };
    int64_t *A = (int64_t *)calloc((size_t)M * M, sizeof(int64_t));
    int64_t *B = (int64_t *)calloc((size_t)M * M, sizeof(int64_t));
    int64_t *C = (int64_t *)calloc((size_t)M * M, sizeof(int64_t));
    for (int i = 0; i < M * M; i++) {
        A[i] = (i * 7) % 97;
        B[i] = (i * 13) % 89;
        C[i] = 0;
    }
    int64_t t0 = now_ns();
    for (int rep = 0; rep < 40; rep++) {
        for (int r = 0; r < M; r++) {
            for (int k = 0; k < M; k++) {
                int64_t a = A[r * M + k];
                for (int c = 0; c < M; c++)
                    C[r * M + c] += a * B[k * M + c];
            }
        }
    }
    int64_t t1 = now_ns();
    int64_t acc = 0;
    for (int q = 0; q < M * M; q++)
        acc = (acc + C[q]) % 1000000007LL;
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    free(A);
    free(B);
    free(C);
    return 0;
}
C
}
