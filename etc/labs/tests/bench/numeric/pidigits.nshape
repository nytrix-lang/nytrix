shape pidigits {
  family "perf-real"
  generator "stress"
  features ["perf", "fixed-limb", "pi", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Machin formula pi = 16*atan(1/5) - 4*atan(1/239), fixed-point 10^50.
;; Same algorithm and representation as the C reference: eight base-1e9
;; limbs in a fixed buffer (slot 8 holds the used length), no allocation in
;; the series. Arbitrary-precision library cost is measured by bigint-oracle.

fn big_set(ptr a, int v) int {
   mut i = 0
   while i < 8 {
      i64buf_store(a, i, 0)
      i += 1
   }
   i64buf_store(a, 0, v)
   i64buf_store(a, 8, 1)
   0
}
fn big_mul_small(ptr a, int m) int {
   mut c = 0
   mut n = i64buf_load(a, 8)
   mut i = 0
   while i < n {
      def t = i64buf_load(a, i) * m + c
      i64buf_store(a, i, t % 1000000000)
      c = t / 1000000000
      i += 1
   }
   while c != 0 && n < 8 {
      i64buf_store(a, n, c % 1000000000)
      c = c / 1000000000
      n += 1
   }
   i64buf_store(a, 8, n)
   0
}
fn big_div_small(ptr a, int m) int {
   mut rem = 0
   mut n = i64buf_load(a, 8)
   mut i = n - 1
   while i >= 0 {
      def cur = rem * 1000000000 + i64buf_load(a, i)
      i64buf_store(a, i, cur / m)
      rem = cur % m
      i -= 1
   }
   while n > 1 && i64buf_load(a, n - 1) == 0 { n -= 1 }
   i64buf_store(a, 8, n)
   0
}
fn big_is_zero(ptr a) bool { i64buf_load(a, 8) == 1 && i64buf_load(a, 0) == 0 }
fn big_add(ptr r, ptr a, ptr b) int {
   def an = i64buf_load(a, 8)
   def bn = i64buf_load(b, 8)
   def n = an > bn ? an : bn
   mut c = 0
   mut i = 0
   while i < n {
      mut s = c
      if i < an { s += i64buf_load(a, i) }
      if i < bn { s += i64buf_load(b, i) }
      i64buf_store(r, i, s % 1000000000)
      c = s / 1000000000
      i += 1
   }
   mut rn = n
   if c != 0 {
      i64buf_store(r, n, c)
      rn += 1
   }
   i64buf_store(r, 8, rn)
   0
}
fn big_sub(ptr r, ptr a, ptr b) int {
   def an = i64buf_load(a, 8)
   def bn = i64buf_load(b, 8)
   mut borrow = 0
   mut i = 0
   while i < an {
      mut s = i64buf_load(a, i) - borrow
      if i < bn { s -= i64buf_load(b, i) }
      if s < 0 {
         s += 1000000000
         borrow = 1
      } else { borrow = 0 }
      i64buf_store(r, i, s)
      i += 1
   }
   mut n = an
   while n > 1 && i64buf_load(r, n - 1) == 0 { n -= 1 }
   i64buf_store(r, 8, n)
   0
}
fn atan_inv(ptr initial, int x) ptr {
   def term = i64buf_new(9)
   def scratch = i64buf_new(9)
   mut ptr acc = initial
   mut ptr next = scratch
   big_set(acc, 0)
   big_set(term, 1)
   mut i = 0
   while i < 50 {
      big_mul_small(term, 10)
      i += 1
   }
   big_div_small(term, x)
   mut k = 0
   while true {
      if k % 2 == 0 { big_add(next, acc, term) } else { big_sub(next, acc, term) }
      def prior = acc
      acc = next
      next = prior
      k += 1
      big_mul_small(term, 2 * k - 1)
      big_div_small(term, 2 * k + 1)
      big_div_small(term, x * x)
      if big_is_zero(term) { break }
   }
   acc
}
mut ptr a5 = i64buf_new(9)
mut ptr a239 = i64buf_new(9)
def p = i64buf_new(9)
def int t0 = ticks()
a5 = atan_inv(a5, 5)
a239 = atan_inv(a239, 239)
big_mul_small(a5, 16)
big_mul_small(a239, 4)
big_sub(p, a5, a239)
big_div_small(p, 10)
mut n = i64buf_load(p, 8)
mut i = 0
while i < n - 1 {
   i64buf_store(p, i, i64buf_load(p, i + 1))
   i += 1
}
def ck = (i64buf_load(p, 1) % 10) * 1000000000 + i64buf_load(p, 0)
def int t1 = ticks()
print("checksum=", ck)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

typedef struct { uint32_t d[8]; int n; } Big;
static void big_set(Big *a, uint32_t v){ for(int i=0;i<8;i++) a->d[i]=0; a->d[0]=v; a->n=1; }
static void big_mul_small(Big *a, uint32_t m){ uint64_t c=0; for(int i=0;i<a->n;i++){ uint64_t t=(uint64_t)a->d[i]*m+c; a->d[i]=(uint32_t)(t%1000000000u); c=t/1000000000u; } while(c && a->n<8){ a->d[a->n++]=(uint32_t)(c%1000000000u); c/=1000000000u; } }
static void big_div_small(Big *a, uint32_t m){ uint64_t rem=0; for(int i=a->n-1;i>=0;i--){ uint64_t cur=rem*1000000000u+a->d[i]; a->d[i]=(uint32_t)(cur/m); rem=cur%m; } while(a->n>1 && a->d[a->n-1]==0) a->n--; }
static int big_is_zero(const Big *a){ return a->n==1 && a->d[0]==0; }
static void big_add(Big *r, const Big *a, const Big *b){ uint64_t c=0; int n=a->n>b->n?a->n:b->n; for(int i=0;i<n;i++){ uint64_t s=c; if(i<a->n)s+=a->d[i]; if(i<b->n)s+=b->d[i]; r->d[i]=(uint32_t)(s%1000000000u); c=s/1000000000u; } r->n=n; if(c){ r->d[n]=(uint32_t)c; r->n++; } }
static void big_sub(Big *r, const Big *a, const Big *b){ int64_t borrow=0; r->n=a->n; for(int i=0;i<a->n;i++){ int64_t s=(int64_t)a->d[i]-borrow-(i<b->n?b->d[i]:0); if(s<0){ s+=1000000000; borrow=1; } else borrow=0; r->d[i]=(uint32_t)s; } while(r->n>1 && r->d[r->n-1]==0) r->n--; }
static Big atan_inv(uint32_t x){ Big acc, term, t; big_set(&acc,0); big_set(&term,1); for(int i=0;i<50;i++) big_mul_small(&term,10); big_div_small(&term,x); uint64_t k=0; for(;;){ if((k&1)==0){ big_add(&t,&acc,&term); acc=t; } else { big_sub(&t,&acc,&term); acc=t; } k++; big_mul_small(&term,(uint32_t)(2*k-1)); big_div_small(&term,(uint32_t)(2*k+1)); big_div_small(&term,x*x); if(big_is_zero(&term)) break; } return acc; }

int main(void) {
    int64_t start = now_ns();
    Big a5 = atan_inv(5);
    Big a239 = atan_inv(239);
    Big p;
    big_mul_small(&a5, 16);
    big_mul_small(&a239, 4);
    big_sub(&p, &a5, &a239);
    big_div_small(&p, 10);
    for (int i = 0; i < p.n - 1; i++) p.d[i] = p.d[i + 1];
    p.n--;
    uint64_t ck = (uint64_t)(p.d[1] % 10) * 1000000000u + p.d[0];
    int64_t end = now_ns();
    printf("checksum=%llu\n", (unsigned long long)ck);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
