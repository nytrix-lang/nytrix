shape bce-matrix {
  family "perf-real"
  generator "stress"
  features ["perf", "bounds-check", "bce", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  flags_matrix "--native-only --native-backend=x86_64 --native-tier=opt -O3 --nyr-verify"
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf (i64buf_new, i64buf_load, i64buf_store)

;; Use the same contiguous 64-bit element layout as the C reference.
fn matrix_sum() int {
   ;; Flattened row-major traversal keeps each checked index in one induction variable.
   def M = 100
   def passes = 2048
   def a = i64buf_new(M * M)
   mut int i = 0
   while i < M*M {
      i64buf_store(a, i, i)
      i += 1
   }
   def int length = M * M
   if length < M * M {
      panic("matrix fill must produce the indexed length")
   }
   def int t0 = ticks()
   mut int acc = 0
   mut int pass = 0
   mut int state = 0
   while pass < passes {
      ;; Feed changing state into the reduction so optimizing routes cannot
      ;; fold the matrix traversal into a constant result.
      state += pass + 1
      mut int idx = 0
      while idx < length {
         acc += i64buf_load(a, idx) + state
         idx += 1
      }
      pass += 1
   }
   def int t1 = ticks()
   print("checksum=", acc)
   print("bench_elapsed_ns=", t1 - t0)
   0
}
def _matrix_checksum = matrix_sum()
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    int M = 100;
    int passes = 2048;
    long *a = (long *)malloc((size_t)M * M * sizeof(long));
    if (!a) return 2;
    for (int i = 0; i < M * M; i++) a[i] = i;
    int64_t start = now_ns();
    long acc = 0;
    long state = 0;
    for (int pass = 0; pass < passes; pass++) {
        state += pass + 1;
        for (int i = 0; i < M * M; i++)
            acc += a[i] + state;
    }
    int64_t end = now_ns();
    printf("checksum=%ld\n", acc);
    if (end <= start) end = start + 1;
    printf("bench_elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
