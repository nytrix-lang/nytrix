shape doitgen {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "tensor", "stencil", "c-vs-ny", "native", "checksum", "time"]
  meta "3D tensor contraction, 32x32x32, two passes"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Multiresolution-style tensor contraction: for each (i,j), contract the k
;; axis against a 32x32 coefficient matrix, then write the result back.
def N = 32
def A = i64buf_new(N * N * N)
def C = i64buf_new(N * N)
def sum = i64buf_new(N)
mut i = 0
while i < N * N * N {
   i64buf_store(A, i, (i * 7 + 3) % 97)
   i += 1
}
i = 0
while i < N * N {
   i64buf_store(C, i, (i * 11 + 5) % 89)
   i += 1
}
def int t0 = ticks()
mut rep = 0
while rep < 2 {
   mut r = 0
   while r < N {
      mut c = 0
      while c < N {
         def base = (r * N + c) * N
         mut p = 0
         while p < N {
            i64buf_store(sum, p, 0)
            p += 1
         }
         mut k = 0
         while k < N {
            def a = i64buf_load(A, base + k)
            p = 0
            while p < N {
               i64buf_store(sum, p,
                  i64buf_load(sum, p) + a * i64buf_load(C, k * N + p))
               p += 1
            }
            k += 1
         }
         p = 0
         while p < N {
            i64buf_store(A, base + p, i64buf_load(sum, p) % 1000000007)
            p += 1
         }
         c += 1
      }
      r += 1
   }
   rep += 1
}
mut ck = 0
i = 0
while i < N * N * N {
   ck = (ck + i64buf_load(A, i)) % 1000000007
   i += 1
}
def int t1 = ticks()
print("checksum=", ck)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int N = 32;
    int64_t *A = malloc((size_t)N * N * N * sizeof(int64_t));
    int64_t *C = malloc((size_t)N * N * sizeof(int64_t));
    int64_t *sum = malloc((size_t)N * sizeof(int64_t));
    for (int i = 0; i < N * N * N; i++) A[i] = (i * 7 + 3) % 97;
    for (int i = 0; i < N * N; i++) C[i] = (i * 11 + 5) % 89;
    int64_t t0 = now_ns();
    for (int rep = 0; rep < 2; rep++) {
        for (int r = 0; r < N; r++) {
            for (int c = 0; c < N; c++) {
                int base = (r * N + c) * N;
                for (int p = 0; p < N; p++) sum[p] = 0;
                for (int k = 0; k < N; k++) {
                    int64_t a = A[base + k];
                    for (int p = 0; p < N; p++)
                        sum[p] += a * C[k * N + p];
                }
                for (int p = 0; p < N; p++)
                    A[base + p] = sum[p] % 1000000007LL;
            }
        }
    }
    int64_t ck = 0;
    for (int i = 0; i < N * N * N; i++) ck = (ck + A[i]) % 1000000007LL;
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)ck);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    free(A); free(C); free(sum);
    return 0;
}
C
}
