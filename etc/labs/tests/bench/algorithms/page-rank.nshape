shape page-rank {
  family "perf-real"
  generator "stress"
  features ["perf", "graph", "fp", "c-vs-ny", "native", "checksum", "time"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Power-iteration PageRank on a star graph (all nodes -> node 0).
def N = 100
def ITERS = 50
def damping = 0.85
fn checksum_rank(ptr values) int {
   mut int checksum = 0
   mut int k = 0
   while k < N {
      def v = f64buf_load(values, k)
      def int scaled = int(v * 10000.0 + 0.5)
      checksum += (k + 1) * scaled
      k += 1
   }
   checksum
}
mut rank = f64buf_new(N)
mut newrank = f64buf_new(N)
mut i = 0
while i < N {
   f64buf_store(rank, i, 1.0 / float(N))
   i += 1
}
def int t0 = ticks()
mut it = 0
while it < ITERS {
   mut j = 0
   while j < N {
      f64buf_store(newrank, j, (1.0 - damping) / float(N))
      j += 1
   }
   i = 0
   while i < N {
      def contrib = f64buf_load(rank, i) * damping
      f64buf_store(newrank, 0, f64buf_load(newrank, 0) + contrib)
      i += 1
   }
   def tmp = rank
   rank = newrank
   newrank = tmp
   it += 1
}
def int t1 = ticks()
def checksum = checksum_rank(rank)
print("checksum=", checksum)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int64_t checksum_rank(const double *rank, int n) {
    int64_t checksum = 0;
    for (int i = 0; i < n; i++)
        checksum += (int64_t)(i + 1) * (int64_t)(rank[i] * 10000.0 + 0.5);
    return checksum;
}

int main(void) {
    int N = 100, ITERS = 50;
    double damping = 0.85;
    double *rank = (double *)malloc((size_t)N * sizeof(double));
    double *newrank = (double *)malloc((size_t)N * sizeof(double));
    for (int i = 0; i < N; i++) { rank[i] = 1.0 / N; newrank[i] = 0.0; }
    int64_t start = now_ns();
    for (int it = 0; it < ITERS; it++) {
        for (int j = 0; j < N; j++) newrank[j] = (1.0 - damping) / N;
        for (int i = 0; i < N; i++) {
            double contrib = rank[i] * damping;
            newrank[0] += contrib;
        }
        double *tmp = rank; rank = newrank; newrank = tmp;
    }
    int64_t end = now_ns();
    printf("checksum=%lld\n", (long long)checksum_rank(rank, N));
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
