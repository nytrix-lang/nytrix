shape sssp {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "graph", "c-vs-ny", "native", "checksum", "time"]
  meta "Bellman-Ford single-source shortest path"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.os.time
;; Bellman-Ford over a deterministic 1024-vertex graph with out-degree 4.
def V = 1024
def D = 4
def INF = 1000000000
def ev = i64buf_new(V * D)
def ew = i64buf_new(V * D)
mut i = 0
while i < V * D {
   def u = i / D
   def e = i % D
   i64buf_store(ev, i, (u * 37 + e * 13) % V)
   i64buf_store(ew, i, ((u + e) % 23) + 1)
   i += 1
}
def dist = i64buf_new(V)
mut j = 0
while j < V {
   i64buf_store(dist, j, INF)
   j += 1
}
i64buf_store(dist, 0, 0)
def int t0 = ticks()
mut round = 0
while round < V - 1 {
   mut u = 0
   while u < V {
      def du = i64buf_load(dist, u)
      if du < INF {
         mut e = 0
         while e < D {
            def k = u * D + e
            def v = i64buf_load(ev, k)
            def nd = du + i64buf_load(ew, k)
            if nd < i64buf_load(dist, v) { i64buf_store(dist, v, nd) }
            e += 1
         }
      }
      u += 1
   }
   round += 1
}
def int t1 = ticks()
mut acc = 0
mut s = 0
while s < V {
   def d = i64buf_load(dist, s)
   if d < INF { acc = (acc + d) % 1000000007 }
   s += 1
}
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    enum { V = 1024, D = 4 };
    const int64_t INF = 1000000000LL;
    int64_t *ev = (int64_t *)calloc((size_t)V * D, sizeof(int64_t));
    int64_t *ew = (int64_t *)calloc((size_t)V * D, sizeof(int64_t));
    for (int i = 0; i < V * D; i++) {
        int64_t u = i / D;
        int64_t e = i % D;
        ev[i] = (u * 37 + e * 13) % V;
        ew[i] = ((u + e) % 23) + 1;
    }
    int64_t *dist = (int64_t *)calloc((size_t)V, sizeof(int64_t));
    for (int j = 0; j < V; j++) dist[j] = INF;
    dist[0] = 0;
    int64_t t0 = now_ns();
    for (int round = 0; round < V - 1; round++) {
        for (int u = 0; u < V; u++) {
            int64_t du = dist[u];
            if (du < INF) {
                for (int e = 0; e < D; e++) {
                    int k = u * D + e;
                    int64_t v = ev[k];
                    int64_t nd = du + ew[k];
                    if (nd < dist[v]) dist[v] = nd;
                }
            }
        }
    }
    int64_t t1 = now_ns();
    int64_t acc = 0;
    for (int s = 0; s < V; s++) {
        int64_t d = dist[s];
        if (d < INF) acc = (acc + d) % 1000000007LL;
    }
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    free(ev);
    free(ew);
    free(dist);
    return 0;
}
C
}
