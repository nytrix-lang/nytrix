shape knucleotide {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "array", "checksum", "time", "c"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
mut i32 seed = 42
mut i64 checksum = 0
def int t0 = ticks()
seed = (seed * 3877 + 29573) % 139968
mut i32 previous = seed % 4
mut i32 i = 1
while i < 100000 {
   seed = (seed * 3877 + 29573) % 139968
   def i32 current = seed % 4
   checksum += previous * 4 + current + 1
   previous = current
   i += 1
}
def int t1 = ticks()
print("checksum=", checksum)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
  struct timespec ts;
  if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
    return 0;
  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
  const int N = 100000;
  int seed = 42;
  int64_t ck = 0;
  int64_t start = now_ns();
  seed = (seed * 3877 + 29573) % 139968;
  int previous = seed % 4;
  for (int i = 1; i < N; i++) {
    seed = (seed * 3877 + 29573) % 139968;
    int current = seed % 4;
    ck += previous * 4 + current + 1;
    previous = current;
  }
  int64_t end = now_ns();
  printf("checksum=%lld\n", (long long)ck);
  if (end <= start)
    end = start + 1;
  printf("elapsed_ns=%lld\n", (long long)(end - start));
  return 0;
}
C
}
