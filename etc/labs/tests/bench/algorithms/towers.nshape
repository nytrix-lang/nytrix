shape towers {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "recursion", "c-vs-ny", "native", "checksum", "time"]
  meta "Tower of Hanoi recursion, eight 20-disk solves"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
;; Recursive Tower of Hanoi. The checksum folds each move's peg pair so the
;; traversal order, not just the move count, is compared against C.
fn hanoi(int n, int from, int to, int via) int {
   if n == 0 { return 0 }
   mut acc = hanoi(n - 1, from, via, to)
   acc = (acc * 31 + from * 3 + to) % 1000000007
   acc = (acc + hanoi(n - 1, via, to, from)) % 1000000007
   acc
}
def int t0 = ticks()
mut total = 0
mut rep = 0
while rep < 8 {
   total = (total + hanoi(19 + (total & 1), 0, 2, 1)) % 1000000007
   rep += 1
}
def int t1 = ticks()
print("checksum=", total)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static volatile int zero;

static __attribute__((noinline)) int64_t hanoi(int n, int from, int to, int via) {
    if (n == 0) return 0;
    int64_t acc = hanoi(n - 1, from, via, to);
    acc = (acc * 31 + from * 3 + to) % 1000000007LL;
    acc = (acc + hanoi(n - 1, via, to, from)) % 1000000007LL;
    return acc;
}

int main(void) {
    int64_t t0 = now_ns();
    int64_t total = 0;
    for (int rep = 0; rep < 8; rep++)
        total = (total + hanoi(19 + (int)(total & 1), zero, 2, 1)) % 1000000007LL;
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)total);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
