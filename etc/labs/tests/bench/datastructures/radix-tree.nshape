shape radix-tree {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "trie", "lookup", "c-vs-ny", "native", "checksum", "time"]
  meta "20-bit binary radix table, 65536 inserts and 1M probes"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.tbuf
;; Fixed-depth binary radix indexing. The leaf index is assembled one key bit
;; at a time; every probe is a dependent shift/branch chain plus one leaf load.
;; The loops are inline because the helper-function form currently miscompiles
;; at -O2/-O3 in the native backend.
def BITS = 20
def CAP = 2097152
def keys = i64buf_new(CAP)
mut seed = 12345
mut i = 0
def int t0 = ticks()
while i < 65536 {
   seed = (seed * 1103515245 + 12345) % 2147483648
   def keyval = seed % 1048576
   mut node = 1
   mut depth = BITS - 1
   while depth >= 0 {
      if ((keyval >> depth) & 1) != 0 { node = node * 2 + 1 } else { node = node * 2 }
      depth -= 1
   }
   i64buf_store(keys, node, keyval + 1)
   i += 1
}
mut hits = 0
i = 0
while i < 1000000 {
   def keyval = (i * 37 + 11) % 1048576
   mut node = 1
   mut depth = BITS - 1
   while depth >= 0 {
      if ((keyval >> depth) & 1) != 0 { node = node * 2 + 1 } else { node = node * 2 }
      depth -= 1
   }
   if i64buf_load(keys, node) == keyval + 1 { hits += 1 }
   i += 1
}
def int t1 = ticks()
print("checksum=", hits)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int BITS = 20, CAP = 2097152;
    int64_t *keys = calloc((size_t)CAP, sizeof(int64_t));
    int64_t seed = 12345;
    int64_t t0 = now_ns();
    for (int i = 0; i < 65536; i++) {
        seed = (seed * 1103515245 + 12345) % 2147483648LL;
        int64_t keyval = seed % 1048576;
        int node = 1;
        for (int depth = BITS - 1; depth >= 0; depth--)
            node = ((keyval >> depth) & 1) ? node * 2 + 1 : node * 2;
        keys[node] = keyval + 1;
    }
    int64_t hits = 0;
    for (int i = 0; i < 1000000; i++) {
        int64_t keyval = (i * 37 + 11) % 1048576;
        int node = 1;
        for (int depth = BITS - 1; depth >= 0; depth--)
            node = ((keyval >> depth) & 1) ? node * 2 + 1 : node * 2;
        if (keys[node] == keyval + 1) hits++;
    }
    int64_t t1 = now_ns();
    printf("checksum=%lld\n", (long long)hits);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    free(keys);
    return 0;
}
C
}
