shape bench_licm {
  family "perf-real"
  generator "stress"
  features ["perf", "licm", "c-vs-ny", "checksum"]
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
use core.os.prim (env)
use core.common (parse_nonneg_int)
;; LICM (Loop Invariant Code Motion) (Benchmark)
fn compute(i64 base, i64 n) i64 {
  mut sum = 0
  mut i = 0
  while i < n {
    ; Keep base runtime-opaque so C cannot replace the recurrence with a
    ; closed-form constant while Ny still executes the loop.
    sum = sum + (base * 2) + i
    i += 1
  }
  sum
}
;; The harness supplies the same opaque runtime input to both implementations.
def input = parse_nonneg_int(env("NYTRIX_BENCH_LICM_BASE"))
def base = input == 0 ? 100 : input
def seed = 3
mut r = 0
mut i = 0
def int t0 = ticks()
while i < 50000 {
  r += compute(base, 100 + (i + seed) % 5)
  i += 1
}
def int t1 = ticks()
print("checksum=", r)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int64_t compute(int64_t base, int64_t n) {
    int64_t sum = 0;
    for (int64_t i = 0; i < n; i++) {
        sum = sum + (base * 2) + i;
    }
    return sum;
}

int main(int argc, char **argv) {
    (void)argc;
    (void)argv;
    const char *input = getenv("NYTRIX_BENCH_LICM_BASE");
    int64_t base = input ? strtoll(input, NULL, 10) : 0;
    if (base <= 0) base = 100;
    int64_t seed = 3;
    int64_t start = now_ns();
    int64_t r = 0;
    for (int i = 0; i < 50000; i++) r += compute(base, 100 + (i + seed) % 5);
    int64_t end = now_ns();
    printf("checksum=%lld\n", (long long)r);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
