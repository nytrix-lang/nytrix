shape bench_loop_unswitch {
  family "perf-real"
  generator "stress"
  features ["perf", "loop_unswitch", "c-vs-ny", "checksum"]
  budget {
    max_native_c_ratio 2.0
    max_native_llvm_ratio 2.0
  }
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
;; Loop Unswitching (Benchmark)
fn loop(i64 n, i64 flag, i64 salt) i64 {
  mut sum = 0
  mut i = 0
  while i < n {
    if flag { sum = (sum * 33 + i + salt) % 1000003 }
    else { sum = (sum * 33 + i * 2 + salt) % 1000003 }
    i += 1
  }
  sum
}
def seed = argc()
mut r = 0
mut i = 0
def int t0 = ticks()
while i < 10000 {
  r += loop(100, (i + seed) % 2, seed)
  i += 1
}
def int t1 = ticks()
print("checksum=", r)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static int64_t loop(int64_t n, int64_t flag, int64_t salt) {
    int64_t sum = 0;
    for (int64_t i = 0; i < n; i++) {
        if (flag) sum = (sum * 33 + i + salt) % 1000003;
        else sum = (sum * 33 + i * 2 + salt) % 1000003;
    }
    return sum;
}

int main(int argc, char **argv) {
    (void)argv;
    int64_t seed = argc - 1;
    int64_t start = now_ns();
    int64_t r = 0;
    for (int i = 0; i < 10000; i++) r += loop(100, (i + seed) % 2, seed);
    int64_t end = now_ns();
    printf("checksum=%lld\n", (long long)r);
    if (end <= start) end = start + 1;
    printf("elapsed_ns=%lld\n", (long long)(end - start));
    return 0;
}
C
}
