shape bench_time_profile {
  family "runtime-native"
  generator "native"
  features ["native", "time", "phase", "checksum"]
  template ny-test-case
  flags "--native-backend x86_64 -time -vv"
  expect compile_and_run
  source ny <<'NY'
use core
use core.os.time
def n = 50000
def t0 = ticks()
mut x = 1
for i in 0..n {
  x = (x * 1103515245 + 12345) % 2147483648
  x = (x + i) % 1000000007
}
def t1 = ticks()
print("checksum=", x)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdio.h>
#include <stdint.h>

int main(void) {
  const int64_t n = 50000;
  int64_t x = 1;
  for (int64_t i = 0; i <= n; i++) {
    x = (x * 1103515245 + 12345) % 2147483648LL;
    x = (x + i) % 1000000007LL;
  }
  printf("checksum=%lld\n", (long long)x);
  return 0;
}
C
}
