shape image-convolve {
  family "perf-real"
  generator "stress"
  features ["perf", "integer", "image", "convolution", "c-vs-ny", "native", "checksum", "time"]
  meta "3x3 sharpen convolution with saturation, two passes"
  timeout 180
  template ny-test-case
  expect compile_and_run
  source ny <<'NY'
use core
use core.tbuf
use core.os.time
;; Two sharpen passes over a generated 128x128 8-bit image.
def W = 128
def H = 128
mut ptr src = i64buf_new(W * H)
mut ptr dst = i64buf_new(W * H)
mut i = 0
while i < W * H {
   i64buf_store(src, i, 0)
   i64buf_store(dst, i, 0)
   i += 1
}
i = 0
while i < W * H {
   i64buf_store(src, i, (i * 37 + 11) % 251)
   i += 1
}
def int t0 = ticks()
mut pass = 0
while pass < 2 {
   mut y = 1
   while y < H - 1 {
      mut x = 1
      while x < W - 1 {
         def idx = y * W + x
         def c = i64buf_load(src, idx)
         mut v = (5 * c - i64buf_load(src, idx - W) - i64buf_load(src, idx + W)
                - i64buf_load(src, idx - 1) - i64buf_load(src, idx + 1))
         if v < 0 { v = 0 }
         if v > 255 { v = 255 }
         i64buf_store(dst, idx, v)
         x += 1
      }
      y += 1
   }
   def ptr tmp = src
   src = dst
   dst = tmp
   pass += 1
}
def int t1 = ticks()
mut acc = 0
i = 0
while i < W * H {
   acc = (acc + i64buf_load(src, i)) % 1000000007
   i += 1
}
print("checksum=", acc)
print("elapsed_ns=", t1 - t0)
NY
  source c <<'C'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

static int64_t now_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

int main(void) {
    const int W = 128, H = 128;
    int64_t *src = calloc((size_t)W * H, sizeof(int64_t));
    int64_t *dst = calloc((size_t)W * H, sizeof(int64_t));
    for (int i = 0; i < W * H; i++) src[i] = (i * 37 + 11) % 251;
    int64_t t0 = now_ns();
    for (int pass = 0; pass < 2; pass++) {
        for (int y = 1; y < H - 1; y++) {
            for (int x = 1; x < W - 1; x++) {
                int idx = y * W + x;
                int64_t c = src[idx];
                int64_t v = 5 * c - src[idx - W] - src[idx + W]
                          - src[idx - 1] - src[idx + 1];
                if (v < 0) v = 0;
                if (v > 255) v = 255;
                dst[idx] = v;
            }
        }
        int64_t *tmp = src;
        src = dst;
        dst = tmp;
    }
    int64_t t1 = now_ns();
    int64_t acc = 0;
    for (int i = 0; i < W * H; i++) acc = (acc + src[i]) % 1000000007;
    printf("checksum=%lld\n", (long long)acc);
    if (t1 <= t0) t1 = t0 + 1;
    printf("elapsed_ns=%lld\n", (long long)(t1 - t0));
    return 0;
}
C
}
