fn ease_out_back(f64 x) f64 {
   def c1 = 1.70158
   def c3 = c1 + 1.0
   1.0 + c3 * math.pow(x - 1.0, 3.0) + c1 * math.pow(x - 1.0, 2.0)
}

fn pixel_rect(f64 x, f64 y, f64 w, f64 h, any color, f64 alpha) int {
   if alpha <= 0.0 { return 0 }
   gfx.draw_rect(
      math.round(x),
      math.round(y),
      math.ceil(w),
      math.ceil(h),
      gfx.color_alpha(color, alpha)
   )
   0
}

fn draw_static_logo(f64 alpha) int {
   mut i = 0
   while i < LOGO_COUNT {
      pixel_rect(
         LOGO_X0 + LOGO_X[i] + SHADOW_X,
         LOGO_Y0 + LOGO_Y[i] + SHADOW_Y,
         CELL,
         CELL,
         SHADOW_COLOR,
         SHADOW_ALPHA * alpha
      )
      i += 1
   }

   i = 0
   while i < LOGO_COUNT {
      pixel_rect(
         LOGO_X0 + LOGO_X[i],
         LOGO_Y0 + LOGO_Y[i],
         CELL,
         CELL,
         LOGO_COLORS[LOGO_COLOR[i]],
         alpha
      )
      i += 1
   }
   0
}

fn draw_spawn_logo(f64 elapsed, f64 alpha) int {
   def shadow_alpha = math.clamp01(
      (elapsed - (ASSEMBLE_END - SHADOW_WINDOW)) / SHADOW_WINDOW
   ) * alpha

   if shadow_alpha > 0.0 {
      mut i = 0
      while i < LOGO_COUNT {
         pixel_rect(
            LOGO_X0 + LOGO_X[i] + SHADOW_X,
            LOGO_Y0 + LOGO_Y[i] + SHADOW_Y,
            CELL,
            CELL,
            SHADOW_COLOR,
            SHADOW_ALPHA * shadow_alpha
         )
         i += 1
      }
   }

   mut i = 0
   while i < LOGO_COUNT {
      def raw = math.clamp01((elapsed - LOGO_DELAY[i]) / POP_DURATION)
      if raw > 0.0 {
         def color = LOGO_COLORS[LOGO_COLOR[i]]
         if raw >= POP_VISIBLE {
            pixel_rect(LOGO_X0 + LOGO_X[i], LOGO_Y0 + LOGO_Y[i], CELL, CELL, color, alpha)
         } else {
            def scale = ease_out_back(raw)
            def size = math.max(1.0, math.round(CELL * scale))
            def cx = LOGO_X[i] + CELL * 0.5
            def cy = LOGO_Y[i] + CELL * 0.5
            pixel_rect(
               LOGO_X0 + cx - size * 0.5,
               LOGO_Y0 + cy - size * 0.5,
               size,
               size,
               color,
               math.clamp01(raw * POP_ALPHA_RAMP) * alpha
            )
         }
      }
      i += 1
   }
   0
}

fn draw_label(list xs, list ys, list ids, int total, int visible,
   f64 ox, f64 oy, f64 cell, any color, f64 alpha) int {
   mut i = 0
   while i < total {
      if int(ids[i]) < visible {
         pixel_rect(ox + float(xs[i]), oy + float(ys[i]), cell, cell, color, alpha)
      }
      i += 1
   }
   0
}

def win = gfx.init_window(
   WIN_W, WIN_H, "Made with Nytrix", key.WINDOW_CENTER, true, false, 1
)
if !win { panic("could not create the Nytrix splash window") }
defer { gfx.close_window() }

mut timeline = 0.0

while !gfx.window_should_close(win) {
   if window.key_pressed(win, key.KEY_ESCAPE) {
      window.set_should_close(win, true)
   }

   def frame_fit = gfx.begin_frame_layout(BG_COLOR, VIEW_W, VIEW_H)
   if !frame_fit { continue }

   ;; Clamp long stalls from resizing/minimizing so the reveal stays smooth.
   timeline = math.fmod(
      timeline + math.clamp(gfx.get_delta_time(), 0.0, 0.10) * 1000.0,
      CYCLE
   )

   mut alpha = 1.0
   if timeline > HOLD_END {
      alpha = 1.0 - math.clamp01((timeline - HOLD_END) / FADE_DURATION)
   }

   if timeline < ASSEMBLE_END {
      draw_spawn_logo(timeline, alpha)
   } else {
      draw_static_logo(alpha)
   }

   if timeline >= TAG_START {
      def visible = int(math.min(
         9.0,
         math.floor((timeline - TAG_START) / TAG_INTERVAL) + 1.0
      ))
      draw_label(
         TAG_X, TAG_Y, TAG_I, TAG_COUNT, visible,
         TAG_X0, TAG_Y0, TAG_CELL, TAG_COLOR, 0.90 * alpha
      )
   }

   if timeline >= WORD_START {
      def visible = int(math.min(
         6.0,
         math.floor((timeline - WORD_START) / WORD_INTERVAL) + 1.0
      ))
      draw_label(
         LETTER_X, LETTER_Y, LETTER_INDEX, LETTER_COUNT, visible,
         WORD_X0, WORD_Y0, WORD_CELL, WORD_COLOR, alpha
      )
   }

   gfx.end_frame()
}
