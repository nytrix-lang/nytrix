fn _clean_addr_string_literal_arg(str arg0) str {
   def arg = str.strip(arg0)
   if str.startswith(arg, "&\"") && str.endswith(arg, "\"") {
      return slice(arg, 1, arg.len, 1)
   }
   arg0
}

fn _clean_libc_string_literal_arg(str name0, int idx) bool {
   def name = str.strip(name0)
   if name == "puts" || name == "printf" || name == "scanf" { return idx == 0 }
   if name == "fprintf" || name == "sprintf" || name == "sscanf" { return idx == 1 }
   if name == "snprintf" { return idx == 2 }
   if name == "fopen" || name == "fdopen" { return idx == 1 }
   if name == "freopen" || name == "popen" { return idx == 0 || idx == 1 }
   if name == "strcmp" || name == "strncmp" || name == "memcmp" { return idx == 0 || idx == 1 }
   false
}

fn _clean_normalize_libc_string_literal_args(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      mut line = lines[i]
      def call = _clean_rendered_line_call_expr_parts(line)
      if call.len > 0 {
         mut args = _clean_call_args(call.get("args", ""))
         mut j = 0
         mut line_changed = false
         while j < args.len {
            if _clean_libc_string_literal_arg(call.get("name", ""), j) {
               def repl = _clean_addr_string_literal_arg(args[j])
               if repl != args[j] {
                  args = _clean_list_replace_at(args, j, repl)
                  changed = true
                  line_changed = true
               }
            }
            j += 1
         }
         if line_changed {
            line = _clean_rendered_line_with_call_args(line, call, args)
         }
      }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_string_compare_arg(str arg0) str {
   def arg = str.strip(arg0)
   if str.startswith(arg, "&\"") && str.endswith(arg, "\"") {
      return slice(arg, 1, arg.len, 1)
   }
   if str.startswith(arg, "&") {
      def tail = str.strip(slice(arg, 1, arg.len, 1))
      if _clean_simple_render_name(tail) { return tail }
   }
   arg
}

fn _clean_string_literal_operand(str arg0) bool {
   _clean_rendered_string_literal(_clean_string_compare_arg(arg0)).len > 0
}

fn _clean_stringish_compare_operand(str arg0) bool {
   def arg = _clean_string_compare_arg(arg0)
   if _clean_rendered_string_literal(arg).len > 0 { return true }
   if _clean_literal_int_value(arg).get("ok", false) { return false }
   arg == "input" || arg == "expected" || arg == "password" || arg == "correct" ||
   arg == "input_buf" || arg == "argv[1]" || str.endswith(arg, "_buf")
}

fn _clean_string_compare_rewrite_safe(str lhs, str rhs) bool {
   if _clean_rendered_string_literal(lhs).len > 0 || _clean_rendered_string_literal(rhs).len > 0 {
      return !_clean_literal_int_value(lhs).get("ok", false) && !_clean_literal_int_value(rhs).get("ok", false)
   }
   _clean_stringish_compare_operand(lhs) && _clean_stringish_compare_operand(rhs)
}

fn _clean_simplify_strcmp_zero_expr(str expr0) str {
   def expr = str.strip(expr0)
   mut op = ""
   if str.endswith(expr, " == 0") {
      op = " == "
   } elif str.endswith(expr, " != 0") {
      op = " != "
   } else {
      return expr0
   }
   def call_text = str.strip(slice(expr, 0, expr.len - 5, 1))
   def call = _clean_rendered_call_expr_parts(call_text)
   if call.len == 0 || call.get("name", "") != "strcmp" { return expr0 }
   def args = _clean_call_args(call.get("args", ""))
   if args.len < 2 { return expr0 }
   mut lhs = _clean_string_compare_arg(args[0])
   mut rhs = _clean_string_compare_arg(args[1])
   if _clean_string_literal_operand(lhs) && !_clean_string_literal_operand(rhs) {
      def tmp = lhs
      lhs = rhs
      rhs = tmp
   }
   if !_clean_string_compare_rewrite_safe(lhs, rhs) { return expr0 }
   lhs + op + rhs
}

fn _clean_simplify_strncmp_zero_expr(str expr0) str {
   def expr = str.strip(expr0)
   mut equal = false
   if str.endswith(expr, " == 0") {
      equal = true
   } elif !str.endswith(expr, " != 0") {
      return expr0
   }
   def call_text = str.strip(slice(expr, 0, expr.len - 5, 1))
   def call = _clean_rendered_call_expr_parts(call_text)
   if call.len == 0 || call.get("name", "") != "strncmp" { return expr0 }
   def args = _clean_call_args(call.get("args", ""))
   if args.len < 3 { return expr0 }
   def limit = _clean_literal_int_value(args[2])
   if !limit.get("ok", false) || int(limit.get("value", 0)) <= 0 { return expr0 }
   mut lhs = _clean_string_compare_arg(args[0])
   mut rhs = _clean_string_compare_arg(args[1])
   mut lhs_lit = _clean_rendered_string_literal_value(lhs)
   mut rhs_lit = _clean_rendered_string_literal_value(rhs)
   if lhs_lit.len > 0 && rhs_lit.len == 0 {
      def tmp = lhs
      lhs = rhs
      rhs = tmp
      rhs_lit = lhs_lit
      lhs_lit = dict()
   }
   if rhs_lit.len == 0 || lhs_lit.len > 0 { return expr0 }
   if int(limit.get("value", 0)) != rhs_lit.get("value", "").len { return expr0 }
   if _clean_literal_int_value(lhs).get("ok", false) { return expr0 }
   def pred = "startswith(" + lhs + ", " + rhs + ")"
   equal ? pred : "!" + pred
}

fn _clean_simplify_string_compare_expr(str expr0) str {
   def expr = _clean_simplify_strcmp_zero_expr(expr0)
   _clean_simplify_strncmp_zero_expr(expr)
}

