   def raw = str.strip(raw0)
   (str.startswith(raw, "fail(") || str.startswith(raw, "succeed(")) && str.endswith(raw, ")")
}

fn _clean_drop_return_after_challenge_terminal_calls(str text) str {
   if str.find(text, "fail(") < 0 && str.find(text, "succeed(") < 0 { return text }
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if _clean_challenge_terminal_call(lines[i]) {
         def j = _clean_next_nonblank_index(lines, i + 1)
         if (j < lines.len && _clean_line_indent(lines[j]) == _clean_line_indent(lines[i]) &&
            str.strip(lines[j]) == "return"){
            skip = skip.set(to_str(j), true)
            changed = true
         }
      }
      i += 1
   }
   if !changed { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) { b = str.builder_append(b, lines[i] + "\n") }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_name_terminal_input_helper(str text) str {
   def lines = str.split(text, "\n")
   if lines.len == 0 { return text }
   def first = str.strip(lines[0])
   def lower = str.lower(text)
   if str.find(text, "exit(") < 0 { return text }
   if first == "fn fail(arg0){" && contains(lower, "not correct") && contains(text, "arg0") {
      return _clean_replace_token_code(text, "arg0", "input")
   }
   if first == "fn succeed(arg0){" && contains(lower, "correct") && contains(text, "arg0") {
      return _clean_replace_token_code(text, "arg0", "input")
   }
   text
}

fn _clean_prompt_name_for_line(str raw0) str {
   def raw = str.lower(raw0)
   if str.find(raw, "username") >= 0 || str.find(raw, "user name") >= 0 { return "username" }
   if str.find(raw, "password") >= 0 || str.find(raw, "passphrase") >= 0 { return "password" }
   ""
}

fn _clean_name_prompt_read_buffers(str text) str {
   if str.find(text, "read(0, &local_") < 0 { return text }
   def lower = str.lower(text)
   if (str.find(lower, "username") < 0 && str.find(lower, "password") < 0 &&
      str.find(lower, "passphrase") < 0){ return text }
   def lines = str.split(text, "\n")
   mut prompt = ""
   mut renames = dict()
   mut i = 0
   while i < lines.len {
      def raw = str.strip(lines[i])
      def next_prompt = _clean_prompt_name_for_line(raw)
      if next_prompt.len > 0 { prompt = next_prompt }
      def args = _type_rendered_named_call_args(raw, "read")
      if args.len >= 3 && str.strip(args[0]) == "0" && prompt.len > 0 {
         def lname = _type_local_name_from_arg(args[1])
         def n = str.strip(args[2])
         if lname.len > 0 && _looks_int_literal(n) && _parse_int_piece(n) > 1 {
            renames = renames.set(lname, prompt)
            prompt = ""
         }
      }
      i += 1
   }
   renames.len > 0 ? _clean_apply_render_renames(text, renames) : text
}

fn _clean_ref_symbol_arg(str arg0) str {
   mut arg = str.strip(arg0)
   if str.startswith(arg, "&") { arg = str.strip(slice(arg, 1, arg.len, 1)) }
   _symbol_token_ok(arg) ? arg : ""
}

fn _clean_unused_one_byte_stdin_read_symbol(str line0) str {
   def call = _clean_rendered_line_call_expr_parts(line0)
   if call.get("mode", "") != "statement" || call.get("name", "") != "read" { return "" }
   def args = _clean_call_args(call.get("args", ""))
   if args.len < 3 || str.strip(args[0]) != "0" { return "" }
   def n = _clean_literal_int_value(args[2])
   if !n.get("ok", false) || int(n.get("value", 0)) != 1 { return "" }
   _clean_ref_symbol_arg(args[1])
}

fn _clean_discard_unused_one_byte_reads(str text) str {
   if str.find(text, "read(0, &") < 0 || str.find(text, ", 1)") < 0 { return text }
   def lines = str.split(text, "\n")
   mut candidates = dict()
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def sym = _clean_unused_one_byte_stdin_read_symbol(lines[i])
      if sym.len > 0 { candidates = candidates.set(sym, true) }
      i += 1
   }
   if candidates.len == 0 { return text }
   mut live = dict()
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def read_sym = _clean_unused_one_byte_stdin_read_symbol(lines[i])
      def keys = candidates.keys()
      mut ki = 0
      while ki < keys.len {
         def sym = to_str(keys[ki])
         if sym != read_sym && _clean_render_text_has_alias(lines[i], sym) {
            live = live.set(sym, true)
         }
         ki += 1
      }
      i += 1
   }
   mut b = str.Builder(text.len)
   mut changed = false
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def sym = _clean_unused_one_byte_stdin_read_symbol(lines[i])
      if sym.len > 0 && !live.get(sym, false) {
         b = str.builder_append(b, _clean_line_indent(lines[i]) + "discard_stdin_byte()\n")
         changed = true
      } else {
         b = str.builder_append(b, lines[i] + "\n")
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_name_libc_resource_values(str text) str {
   def lines = str.split(text, "\n")
   mut aliases = dict()
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw_assign = _clean_rendered_assignment_parts(lines[i])
      if raw_assign.len > 0 && aliases.contains(str.strip(raw_assign.get("lhs", ""))) {
         aliases = aliases.remove(str.strip(raw_assign.get("lhs", "")))
      }
      mut line = _clean_apply_render_alias_uses(lines[i], aliases)
      if line != lines[i] { changed = true }
      def assign = _clean_rendered_assignment_parts(line)
      if assign.len > 0 {
         def rhs_call = _clean_rendered_call_expr_parts(assign.get("rhs", ""))
         if rhs_call.len > 0 && _clean_libc_resource_lhs_ok(assign.get("lhs", "")) {
            def resource = _clean_libc_resource_name(rhs_call.get("name", ""))
            if resource.len > 0 {
               aliases = aliases.set(str.strip(assign.get("lhs", "")), resource)
               line = _clean_line_indent(line) + resource + " = " + rhs_call.get("expr", "")
               changed = true
            }
         }
      }
      def call = _clean_rendered_line_call_expr_parts(line)
      if call.len > 0 {
         def args = _clean_call_args(call.get("args", ""))
         def buf_idx = _clean_libc_input_buffer_index(call.get("name", ""), args)
         if buf_idx >= 0 && buf_idx < args.len {
            def buf = str.strip(args[buf_idx])
            if _clean_libc_buffer_expr_ok(buf) {
               aliases = aliases.set(buf, "input_buf")
               line = _clean_rendered_line_with_call_args(line, call,
                  _clean_list_replace_at(args, buf_idx, "input_buf"))
               changed = true
            }
         }
      }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_file_open_call_name(str name0) bool {
   def name = str.strip(name0)
   name == "fopen" || name == "fdopen" || name == "freopen" || name == "popen"
}

fn _clean_file_read_call_name(str name0) bool {
   def name = str.strip(name0)
   name == "fgets" || name == "fread" || name == "fgetc" || name == "getc"
}

fn _clean_file_close_alias_ok(str arg0) bool {
   def arg = str.strip(arg0)
   str.startswith(arg, "stack_") || str.startswith(arg, "local_") || _clean_rendered_value_temp_reg(arg)
}

fn _clean_repair_fclose_resource_aliases(str text) str {
   if str.find(text, "fclose(") < 0 || str.find(text, "fopen(") < 0 { return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut file = ""
   mut saw_read = false
   mut age = 0
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      mut line = lines[i]
      def raw = str.strip(line)
      if str.startswith(raw, "fn ") {
         file = ""
         saw_read = false
         age = 0
      }
      if file.len > 0 {
         age += 1
         if age > 24 {
            file = ""
            saw_read = false
            age = 0
         }
      }
      def call = _clean_rendered_line_call_expr_parts(line)
      if call.len > 0 {
         def args = _clean_call_args(call.get("args", ""))
         if call.get("mode", "") == "assignment" && _clean_file_open_call_name(call.get("name", "")) {
            def lhs = str.strip(call.get("lhs", ""))
            if _symbol_token_ok(lhs) {
               file = lhs
               saw_read = false
               age = 0
            }
         } elif file.len > 0 && _clean_file_read_call_name(call.get("name", "")) {
            mut ai = 0
            while ai < args.len {
               if str.strip(args[ai]) == file { saw_read = true }
               ai += 1
            }
         } elif file.len > 0 && call.get("name", "") == "fclose" && args.len >= 1 {
            def close_arg = str.strip(args[0])
            if saw_read && close_arg != file && _clean_file_close_alias_ok(close_arg) {
               line = _clean_rendered_line_with_call_args(line, call, _clean_list_replace_at(args, 0, file))
               changed = true
            }
            file = ""
            saw_read = false
            age = 0
         }
      }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_recent_call_result_alias(list rows, int idx, str raw0) str {
   def family = _rows_family(rows)
   def reg = _canonical_value_reg(family, raw0)
   if reg.len == 0 || !_list_has(_abi_profile(family).get("returns", []), reg) { return "" }
   mut j = idx - 1
   mut scanned = 0
   while j >= 0 && scanned < 16 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "call" {
         def name = r.get("target_name", "")
         if name == "__errno_location" { return "__errno_location()" }
         return ""
      }
      if _symbols_intersect(_row_defs(r), _slice_symbol_aliases(reg)) { return "" }
      if op == "return" || op == "syscall" { return "" }
      j -= 1
      scanned += 1
   }
   ""
}

fn _clean_callee_saved_restore_expr(str expr0) bool {
   def expr = str.strip(expr0)
   str.startswith(expr, "stack_") || str.startswith(expr, "local_")
}

fn _clean_render_alias_assignment_lhs(str text, int start, int end) bool {
   mut j = start - 1
   while j >= 0 && (load8(text, j) == 32 || load8(text, j) == 9) { j -= 1 }
   if j >= 0 && load8(text, j) != 10 { return false }
   mut k = end
   while k < text.len && (load8(text, k) == 32 || load8(text, k) == 9) { k += 1 }
   k < text.len && load8(text, k) == 61 && (k + 1 >= text.len || load8(text, k + 1) != 61)
}

fn _clean_replace_token_code_uses(str text, str needle, str repl) str {
   if needle.len == 0 || repl.len == 0 || text.len < needle.len { return text }
   mut b = str.Builder(text.len + repl.len)
   mut quote = 0
   mut i = 0
   while i < text.len {
      def ch = load8(text, i)
      if quote != 0 {
         b = str.builder_append(b, slice(text, i, i + 1, 1))
         if ch == 92 && i + 1 < text.len {
            i += 1
            b = str.builder_append(b, slice(text, i, i + 1, 1))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         b = str.builder_append(b, slice(text, i, i + 1, 1))
         i += 1
         continue
      }
      if i + needle.len <= text.len && slice(text, i, i + needle.len, 1) == needle {
         def before_ok = i == 0 || !_clean_token_char(load8(text, i - 1))
         def after_ok = i + needle.len >= text.len || !_clean_token_char(load8(text, i + needle.len))
         if before_ok && after_ok && !_clean_render_alias_assignment_lhs(text, i, i + needle.len) {
            b = str.builder_append(b, repl)
            i += needle.len
            continue
         }
      }
      b = str.builder_append(b, slice(text, i, i + 1, 1))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_callee_saved_render_aliases(dict bin, dict sig, list rows) dict {
   mut out = dict()
   if rows.len == 0 { return out }
   def family = _rows_family(rows)
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      def canon = _canonical_value_reg(family, r.get("dst", ""))
      if canon.len > 0 && _callee_saved_value_reg(family, canon) {
         def op = r.get("op", "")
         if (op == "assign" || op == "arith") && r.get("dst_kind", "") == "reg" {
            def raw = _resolve_reg_row_value(bin, rows, i, r, 0)
            def call_alias = _clean_recent_call_result_alias(rows, i, raw)
            def mapped0 = _clean_expr_with_sig_bin(bin, sig, rows, call_alias.len > 0 ? call_alias : raw)
            def mapped_alias = _clean_apply_render_alias_uses(mapped0, out)
            def mapped = _clean_param_index_text(sig, mapped_alias)
            if _clean_render_alias_expr_ok(mapped) && !_clean_render_text_has_alias(mapped, canon) {
               out = out.set(canon, mapped)
               out = out.set(str.strip(r.get("dst", "")), mapped)
            } elif (raw.len > 0 && !_clean_render_alias_expr_ok(mapped) &&
               !_clean_callee_saved_restore_expr(mapped)){
               out = out.remove(canon)
               out = out.remove(str.strip(r.get("dst", "")))
            }
         }
      }
      i += 1
   }
   out
}

fn _clean_apply_render_alias_uses(str text, any aliases0) str {
   if !is_dict(aliases0) || aliases0.len == 0 { return text }
   mut out = text
   def keys = aliases0.keys()
   mut i = 0
   while i < keys.len {
      def k = str.strip(to_str(keys[i]))
      def v = str.strip(to_str(aliases0.get(keys[i], "")))
      if k.len > 0 && v.len > 0 && k != v {
         out = _clean_replace_token_code_uses(out, k, v)
      }
      i += 1
   }
   out
}

fn _clean_type_field_map(any trec0) dict {
   if !is_dict(trec0) { return dict() }
   mut out = dict()
   def locals = trec0.get("locals", [])
   mut i = 0
   while i < locals.len {
      def lr = locals[i]
      def name = lr.get("name", "")
      def fields0 = lr.get("fields", [])
      def shape = lr.get("shape", "")
      if (name.len > 0 && fields0.len >= 2 &&
         (shape == "heap_struct" || shape == "local_struct" || shape == "list_node" ||
            lr.get("type", "") == "struct*")){
         mut fields = dict()
         mut fi = 0
         while fi < fields0.len {
            def f = fields0[fi]
            def off = int(f.get("offset", 0))
            def fname = _safe_name(f.get("name", "field_" + str.to_hex(_iabs(off), 0)),
               "field_" + str.to_hex(_iabs(off), 0))
            fields = fields.set(to_str(off), fname)
            fi += 1
         }
         if fields.len > 0 {
            out = out.set(name, fields)
            def sname = lr.get("suggested_name", "")
            if sname.len > 0 { out = out.set(sname, fields) }
         }
      }
      i += 1
   }
   out
}

fn _clean_apply_render_type_fields(str text, any trec0) str {
   def fmap = _clean_type_field_map(trec0)
   if fmap.len == 0 || text.len == 0 { return text }
   mut b = str.Builder(text.len)
   mut quote = 0
   mut i = 0
   while i < text.len {
      def ch = load8(text, i)
      if quote != 0 {
         b = str.builder_append(b, chr(ch))
         if ch == 92 && i + 1 < text.len {
            i += 1
            b = str.builder_append(b, chr(load8(text, i)))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         b = str.builder_append(b, chr(ch))
         i += 1
         continue
      }
      if _symbol_is_name_char(ch) {
         def start = i
         while i < text.len && _symbol_is_name_char(load8(text, i)) { i += 1 }
         def tok = slice(text, start, i, 1)
         if fmap.contains(tok) && i < text.len && load8(text, i) == 91 {
            mut j = i + 1
            mut depth = 1
            while j < text.len && depth > 0 {
               def cj = load8(text, j)
               if cj == 91 { depth += 1 }
               elif cj == 93 { depth -= 1 }
               j += 1
            }
            if depth == 0 {
               def idx = str.strip(slice(text, i + 1, j - 1, 1))
               if _looks_int_literal(idx) {
                  def field = fmap.get(tok, dict()).get(to_str(_parse_int_piece(idx)), "")
                  if field.len > 0 {
                     b = str.builder_append(b, tok + "." + field)
                     i = j
                     continue
                  }
               }
            }
         }
         b = str.builder_append(b, tok)
         continue
      }
      b = str.builder_append(b, chr(ch))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_byte_at_zero_cast_expr(str rhs0) str {
   def rhs = str.strip(rhs0)
   if _clean_call_end_at(rhs, 0, "byte_at") != rhs.len { return "" }
   def args = _clean_call_args(slice(rhs, 8, rhs.len - 1, 1))
   if args.len != 2 || !_clean_zero_operand(args[1]) { return "" }
   def expr = str.strip(args[0])
   expr.len > 0 ? "byte(" + expr + ")" : ""
}

fn _clean_simplify_named_byte_field_casts(str text) str {
   if str.find(text, ".byte") < 0 || str.find(text, "byte_at(") < 0 { return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
