fn _clean_simplify_string_len_expr(str expr0) str {
   def expr = str.strip(expr0)
   def ops = [" == ", " != ", " <= ", " >= ", " < ", " > "]
   mut i = 0
   while i < ops.len {
      def op = ops[i]
      def p = _clean_top_level_find(expr, op)
      if p >= 0 {
