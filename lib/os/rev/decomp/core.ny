      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_any_assignment_parts(lines[i])
      if parts.len > 0 && str.endswith(str.strip(parts.get("lhs", "")), ".byte") {
         def cast = _clean_byte_at_zero_cast_expr(parts.get("rhs", ""))
         if cast.len > 0 {
            b = str.builder_append(b, _clean_line_indent(lines[i]) + parts.get("lhs", "") + " = " + cast + "\n")
            changed = true
            i += 1
