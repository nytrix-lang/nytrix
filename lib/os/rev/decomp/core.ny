fn _clean_normalize_terminal_success_fail_guards(str text) str {
   if str.find(text, "succeed(") < 0 || str.find(text, "fail(") < 0 { return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def open = _clean_structured_if_open_parts(lines[i])
      if open.len > 0 && i + 3 < lines.len && str.find(lines[i + 1], "succeed(") >= 0 {
         def close = _clean_matching_block_close(lines, i)
         if (close == i + 2 && close + 1 < lines.len &&
            _clean_line_indent(lines[i]) == _clean_line_indent(lines[close + 1])){
            def ok = _clean_terminal_challenge_call_parts(lines[i + 1], "succeed")
            def bad = _clean_terminal_challenge_call_parts(lines[close + 1], "fail")
            if ok.len > 0 && bad.len > 0 && ok.get("args", "") == bad.get("args", "") {
               def pad = _clean_line_indent(lines[i])
               b = str.builder_append(b, pad + "if " + _clean_readable_negated_condition_expr(open.get("expr", "")) + "{\n")
               b = str.builder_append(b, pad + "  " + bad.get("text", "") + "\n")
               b = str.builder_append(b, pad + "}\n")
               b = str.builder_append(b, pad + ok.get("text", "") + "\n")
               changed = true
               i = close + 2
               continue
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

