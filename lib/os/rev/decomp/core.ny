         def rhs0 = str.strip(slice(expr, p + op.len, expr.len, 1))
         def lhs = _clean_len_call_expr(lhs0, rhs0)
         def rhs = _clean_len_call_expr(rhs0, lhs0)
         if lhs != lhs0 || rhs != rhs0 { return lhs + op + rhs }
         return expr0
      }
      i += 1
   }
   expr0
}

