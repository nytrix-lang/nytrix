fn _clean_inline_condition_copy_rhs(str rhs) str {
   _clean_condition_operand(str.strip(rhs))
}

fn _clean_inline_condition_copy_candidate(str lhs, str rhs0) bool {
   def rhs = str.strip(rhs0)
   if rhs.len == 0 || str.find(rhs, "(") >= 0 || str.find(rhs, lhs) >= 0 { return false }
   if (str.find(rhs, " + ") >= 0 || str.find(rhs, " - ") >= 0 ||
      str.find(rhs, " * ") >= 0 || str.find(rhs, " / ") >= 0 ||
      str.find(rhs, " % ") >= 0 || str.find(rhs, " & ") >= 0 ||
      str.find(rhs, " | ") >= 0 || str.find(rhs, " ^^ ") >= 0 ||
      str.find(rhs, "<<") >= 0 || str.find(rhs, ">>") >= 0 ||
      str.find(rhs, "==") >= 0 || str.find(rhs, "!=") >= 0 ||
      str.find(rhs, " <= ") >= 0 || str.find(rhs, " >= ") >= 0 ||
      str.find(rhs, " < ") >= 0 || str.find(rhs, " > ") >= 0){
      return false
   }
   true
}

fn _clean_render_count_norm(str expr0) str {
   mut e = str.strip(expr0)
   mut guard = 0
   while guard < 4 {
      def n = _clean_strip_outer_parens(e)
      if n == e { return e }
      e = n
      guard += 1
   }
   e
}

fn _clean_render_shift_parts(str expr0) dict {
   def e = _clean_strip_outer_parens(expr0)
   mut p = _clean_top_level_find(e, " << ")
   mut dir = "<<"
   if p < 0 {
      p = _clean_top_level_find(e, " >> ")
      dir = ">>"
   }
   if p < 0 { return dict() }
   mut base = str.strip(slice(e, 0, p, 1))
   def z8 = _clean_strip_unary_call(base, "zext8")
   if z8.len > 0 { base = str.strip(z8) }
   {"ok": true, "dir": dir, "base": base,
      "amount": _clean_render_count_norm(slice(e, p + 4, e.len, 1))}
}

fn _clean_render_complement8_count(str amount0) str {
   def amount = _clean_render_count_norm(amount0)
   def p = _clean_top_level_find(amount, " - ")
   if p < 0 { return "" }
   if str.strip(slice(amount, 0, p, 1)) != "8" { return "" }
   _clean_render_count_norm(slice(amount, p + 3, amount.len, 1))
}

fn _clean_render_same_count(str a, str b) bool {
   _clean_render_count_norm(a) == _clean_render_count_norm(b)
}

fn _clean_render_rotate_or_rhs(str rhs0) str {
   def rhs = str.strip(rhs0)
   def parts = _clean_top_level_split(rhs, " | ")
   if parts.len != 2 { return "" }
   def a = _clean_render_shift_parts(parts[0])
   def b = _clean_render_shift_parts(parts[1])
   if !a.get("ok", false) || !b.get("ok", false) { return "" }
   if a.get("dir", "") == b.get("dir", "") { return "" }
   if !_clean_same_expr(a.get("base", ""), b.get("base", "")) { return "" }
   def base = a.get("base", "")
   def aa = a.get("amount", "")
   def ba = b.get("amount", "")
   def acomp = _clean_render_complement8_count(aa)
   def bcomp = _clean_render_complement8_count(ba)
   if a.get("dir", "") == ">>" && b.get("dir", "") == "<<" {
      if acomp.len > 0 && _clean_render_same_count(acomp, ba) {
         return "rol(" + base + ", " + _clean_render_count_norm(ba) + ")"
      }
      if bcomp.len > 0 && _clean_render_same_count(aa, bcomp) {
         return "ror(" + base + ", " + _clean_render_count_norm(aa) + ")"
      }
   }
   if a.get("dir", "") == "<<" && b.get("dir", "") == ">>" {
      if bcomp.len > 0 && _clean_render_same_count(aa, bcomp) {
         return "rol(" + base + ", " + _clean_render_count_norm(aa) + ")"
      }
      if acomp.len > 0 && _clean_render_same_count(acomp, ba) {
         return "ror(" + base + ", " + _clean_render_count_norm(ba) + ")"
      }
   }
   ""
}

fn _clean_simplify_rendered_rotates(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      def p = str.find(raw, " = ")
      if p > 0 {
         def lhs = str.strip(slice(raw, 0, p, 1))
         def rhs = str.strip(slice(raw, p + 3, raw.len, 1))
         def rot = _clean_render_rotate_or_rhs(rhs)
         if rot.len > 0 {
            b = str.builder_append(b, _clean_line_indent(lines[i]) + lhs + " = " + rot + "\n")
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_stack_addr_name(str expr0) str {
   def expr = str.strip(expr0)
   if str.startswith(expr, "&") {
      def name = str.strip(slice(expr, 1, expr.len, 1))
      if str.startswith(name, "local_") || str.startswith(name, "stack_") { return name }
   }
   ""
}

fn _clean_stack_addr_index_parts(str inner0) dict {
   def inner = _clean_strip_outer_parens(inner0)
   mut p = _clean_top_level_find(inner, " + ")
   if p > 0 {
      def left = str.strip(slice(inner, 0, p, 1))
      def right = str.strip(slice(inner, p + 3, inner.len, 1))
      def lbase = _clean_stack_addr_name(left)
      if lbase.len > 0 && right.len > 0 { return {"ok": true, "base": lbase, "idx": right} }
      def rbase = _clean_stack_addr_name(right)
      if rbase.len > 0 && left.len > 0 { return {"ok": true, "base": rbase, "idx": left} }
   }
   p = _clean_top_level_find(inner, " - ")
   if p > 0 {
      def left = str.strip(slice(inner, 0, p, 1))
      def right = str.strip(slice(inner, p + 3, inner.len, 1))
      def lbase = _clean_stack_addr_name(left)
      if lbase.len > 0 && right.len > 0 { return {"ok": true, "base": lbase, "idx": "-" + right} }
   }
   dict()
}

fn _clean_stack_addr_index_expr(str inner0) str {
   def parts = _clean_stack_addr_index_parts(inner0)
   if !parts.get("ok", false) { return "" }
   def idx = str.strip(parts.get("idx", ""))
   if idx == "0" || idx == "0x0" { return parts.get("base", "") }
   parts.get("base", "") + "[" + idx + "]"
}

fn _clean_frame_local_base(str expr0) str {
   def expr = str.strip(expr0)
   if str.startswith(expr, "ebp") { return "ebp" }
   if str.startswith(expr, "rbp") { return "rbp" }
   ""
}

fn _clean_frame_last_literal_term(str expr) dict {
   mut depth = 0
   mut quote = 0
   mut best = -1
   mut sign = ""
   mut i = 0
   while i + 3 <= expr.len {
      def ch = load8(expr, i)
      if quote != 0 {
         if ch == 92 && i + 1 < expr.len { i += 2 continue }
         if ch == quote { quote = 0 }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         i += 1
         continue
      }
      if ch == 40 { depth += 1 }
      elif ch == 41 && depth > 0 { depth -= 1 }
      if depth == 0 && (slice(expr, i, i + 3, 1) == " - " || slice(expr, i, i + 3, 1) == " + ") {
         def rhs = str.strip(slice(expr, i + 3, expr.len, 1))
         if _looks_int_literal(rhs) {
            best = i
            sign = slice(expr, i + 1, i + 2, 1)
         }
      }
      i += 1
   }
   best >= 0 ? {"pos": best, "sign": sign, "value": str.strip(slice(expr, best + 3, expr.len, 1))} : dict()
}

fn _clean_frame_local_index_expr(str inner0) str {
   def inner = _clean_strip_outer_parens(inner0)
   def base_reg = _clean_frame_local_base(inner)
   if base_reg.len == 0 { return "" }
   def lit = _clean_frame_last_literal_term(inner)
   if lit.len == 0 { return "" }
   def off = _parse_int_piece(lit.get("value", ""))
   if off <= 0 { return "" }
   def local_base = lit.get("sign", "") == "-" ? "local_" : "stack_"
   def name = local_base + str.to_hex(off, 0)
   mut idx = str.strip(slice(inner, base_reg.len, int(lit.get("pos", 0)), 1))
   if str.startswith(idx, "+") { idx = str.strip(slice(idx, 1, idx.len, 1)) }
   if idx == "0" || idx == "0x0" || idx.len == 0 { return name }
   if str.find(idx, base_reg) >= 0 { return "" }
   name + "[" + idx + "]"
}

fn _clean_local_pointer_index_expr(str inner0) str {
   def inner = _clean_strip_outer_parens(inner0)
   if _clean_local_slot_offset(inner).len > 0 { return inner + "[0]" }
   mut p = _clean_top_level_find(inner, " + ")
   if p > 0 {
      def left = str.strip(slice(inner, 0, p, 1))
      def right = str.strip(slice(inner, p + 3, inner.len, 1))
      if _clean_local_slot_offset(left).len > 0 && right.len > 0 { return left + "[" + right + "]" }
      if _clean_local_slot_offset(right).len > 0 && left.len > 0 { return right + "[" + left + "]" }
   }
   p = _clean_top_level_find(inner, " - ")
   if p > 0 {
      def left = str.strip(slice(inner, 0, p, 1))
      def right = str.strip(slice(inner, p + 3, inner.len, 1))
      if _clean_local_slot_offset(left).len > 0 && right.len > 0 { return left + "[-" + right + "]" }
   }
   ""
}

fn _clean_normalize_stack_addr_indices(str text) str {
   mut b = str.Builder(text.len)
   mut i = 0
   while i < text.len {
      if i + 4 <= text.len && slice(text, i, i + 4, 1) == "mem(" {
         mut j = i + 4
         mut depth = 1
         while j < text.len && depth > 0 {
            def ch = load8(text, j)
            if ch == 40 { depth += 1 }
            elif ch == 41 { depth -= 1 }
            j += 1
         }
         if depth == 0 {
            def inner = slice(text, i + 4, j - 1, 1)
            mut repl = _clean_stack_addr_index_expr(inner)
            if repl.len == 0 { repl = _clean_frame_local_index_expr(inner) }
            if repl.len == 0 { repl = _clean_local_pointer_index_expr(inner) }
            if repl.len > 0 {
               b = str.builder_append(b, repl)
               i = j
               continue
            }
         }
      }
      if _symbol_is_name_char(load8(text, i)) {
         def start = i
         while i < text.len && _symbol_is_name_char(load8(text, i)) { i += 1 }
         def tok = slice(text, start, i, 1)
         if i < text.len && load8(text, i) == 91 {
            mut j = i + 1
            mut depth = 1
            while j < text.len && depth > 0 {
               def ch = load8(text, j)
               if ch == 91 { depth += 1 }
               elif ch == 93 { depth -= 1 }
               j += 1
            }
            if depth == 0 {
               def inside = str.strip(slice(text, i + 1, j - 1, 1))
               def base = _clean_stack_addr_name(inside)
               if base.len > 0 {
                  b = str.builder_append(b, base + "[" + tok + "]")
                  i = j
                  continue
               }
            }
         }
         b = str.builder_append(b, tok)
         continue
      }
      b = str.builder_append(b, chr(load8(text, i)))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_rendered_assignment_parts(str line) dict {
   def raw = str.strip(line)
   def p = str.find(raw, " = ")
   if p <= 0 { return dict() }
   def lhs = str.strip(slice(raw, 0, p, 1))
   if str.find(lhs, " ") >= 0 || str.find(lhs, "[") >= 0 || str.find(lhs, ".") >= 0 { return dict() }
   {"lhs": lhs, "rhs": str.strip(slice(raw, p + 3, raw.len, 1))}
}

fn _clean_rendered_const_local(str lhs) bool {
   str.startswith(lhs, "local_") || str.startswith(lhs, "stack_")
}

fn _clean_eval_const_binary(str op, int left, int right) dict {
   if op == " + " { return {"ok": true, "value": left + right} }
   if op == " - " { return {"ok": true, "value": left - right} }
   if op == " * " { return {"ok": true, "value": left * right} }
   if op == " / " {
      if right == 0 { return {"ok": false} }
      return {"ok": true, "value": left / right}
   }
   if op == " % " {
      if right == 0 { return {"ok": false} }
      return {"ok": true, "value": left % right}
   }
   if op == " << " {
      if right < 0 || right > 62 { return {"ok": false} }
      return {"ok": true, "value": left << right}
   }
   if op == " >> " {
      if right < 0 || right > 62 { return {"ok": false} }
      return {"ok": true, "value": left >> right}
   }
   if op == " & " { return {"ok": true, "value": left & right} }
   if op == " | " { return {"ok": true, "value": left | right} }
   if op == " ^^ " { return {"ok": true, "value": left ^^ right} }
   {"ok": false}
}

fn _clean_fold_local_const_rhs(str lhs, str rhs0, int known) dict {
   def rhs = _clean_strip_outer_parens(rhs0)
   def ops = [" ^^ ", " << ", " >> ", " + ", " - ", " * ", " / ", " % ", " & ", " | "]
   mut i = 0
   while i < ops.len {
      def op = ops[i]
      def p = _clean_top_level_find(rhs, op)
      if p >= 0 {
         def left = str.strip(slice(rhs, 0, p, 1))
         def right = str.strip(slice(rhs, p + op.len, rhs.len, 1))
         def rv = _clean_literal_int_value(right)
         if _clean_same_expr_text(left, lhs) && rv.get("ok", false) {
            return _clean_eval_const_binary(op, known, int(rv.get("value", 0)))
         }
         def lv = _clean_literal_int_value(left)
         if (_clean_same_expr_text(right, lhs) && lv.get("ok", false) &&
            (op == " + " || op == " * " || op == " & " || op == " | " || op == " ^^ ")){
            return _clean_eval_const_binary(op, int(lv.get("value", 0)), known)
         }
      }
      i += 1
   }
   {"ok": false}
}

fn _clean_fold_local_constant_reassigns(str text) str {
   def lines = str.split(text, "\n")
   mut consts = dict()
   mut b = str.Builder(max(16, text.len))
   mut i = 0
   while i < lines.len {
      def line = lines[i]
      def raw = str.strip(line)
      def parts = _clean_rendered_assignment_parts(raw)
      mut out_line = line
      if raw.len == 0 {
         ;; Keep straight-line constants across blank lines inside generated blocks.
      } elif parts.len > 0 && _clean_rendered_const_local(parts.get("lhs", "")) {
         def lhs = parts.get("lhs", "")
         def rhs = parts.get("rhs", "")
         if consts.contains(lhs) {
            def folded = _clean_fold_local_const_rhs(lhs, rhs, int(consts.get(lhs, 0)))
            if folded.get("ok", false) {
               def value = int(folded.get("value", 0))
               out_line = _clean_line_indent(line) + lhs + " = " + _clean_small_int_text(value)
               consts = consts.set(lhs, value)
               b = str.builder_append(b, out_line + "\n")
               i += 1
               continue
            }
         }
         def lit = _clean_literal_int_value(rhs)
         if lit.get("ok", false) {
            consts = consts.set(lhs, int(lit.get("value", 0)))
         } else {
            consts = consts.delete(lhs)
         }
      } elif parts.len > 0 {
         consts = consts.delete(parts.get("lhs", ""))
      } else {
         consts = dict()
      }
      b = str.builder_append(b, out_line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_fold_const_expr_value(str expr0) dict {
   def expr = _clean_strip_outer_parens(expr0)
   def lit = _clean_literal_int_value(expr)
   if lit.get("ok", false) { return lit }
   def ops = [" | ", " ^^ ", " & ", " << ", " >> ", " + ", " - ", " * ", " / ", " % "]
   mut i = 0
   while i < ops.len {
      def op = ops[i]
      def p = _clean_top_level_find(expr, op)
      if p >= 0 {
         def left = _clean_fold_const_expr_value(slice(expr, 0, p, 1))
         def right = _clean_fold_const_expr_value(slice(expr, p + op.len, expr.len, 1))
         if left.get("ok", false) && right.get("ok", false) {
            return _clean_eval_const_binary(op, int(left.get("value", 0)), int(right.get("value", 0)))
         }
      }
      i += 1
   }
   {"ok": false}
}

fn _clean_fold_const_expr_text(str expr0) str {
   def expr = _clean_strip_outer_parens(expr0)
   def value = _clean_fold_const_expr_value(expr)
   if value.get("ok", false) { return _clean_small_int_text(int(value.get("value", 0))) }
   def cmps = [" == ", " != ", " <= ", " >= ", " < ", " > "]
   mut i = 0
   while i < cmps.len {
      def op = cmps[i]
      def p = _clean_top_level_find(expr, op)
      if p >= 0 {
         return _clean_fold_const_expr_text(slice(expr, 0, p, 1)) + op +
         _clean_fold_const_expr_text(slice(expr, p + op.len, expr.len, 1))
      }
      i += 1
   }
   def ops = [" | ", " ^^ ", " & ", " << ", " >> ", " + ", " - ", " * ", " / ", " % "]
   i = 0
   while i < ops.len {
      def op = ops[i]
      def p = _clean_top_level_find(expr, op)
      if p >= 0 {
         def left = _clean_fold_const_expr_text(slice(expr, 0, p, 1))
         def right = _clean_fold_const_expr_text(slice(expr, p + op.len, expr.len, 1))
         return left + op + right
      }
      i += 1
   }
   str.strip(expr)
}

fn _clean_apply_local_const_map(str expr0, dict consts) str {
   mut out = expr0
   def keys = consts.keys()
   mut i = 0
   while i < keys.len {
      def key = keys[i]
      out = _clean_replace_aliases_text(out, [key], _clean_small_int_text(int(consts.get(key, 0))))
      i += 1
   }
   out
}

fn _clean_fold_direct_call_line(str line, dict consts) str {
   def indent = _clean_line_indent(line)
   def raw = str.strip(line)
   def p = str.find(raw, "(")
   if p <= 0 || !str.endswith(raw, ")") { return "" }
   def name = str.strip(slice(raw, 0, p, 1))
   if (name == "if" || name == "while" || name == "switch" || name == "return" ||
      str.find(name, " ") >= 0 || str.find(name, "=") >= 0 ||
      _clean_rendered_helper_call_name(name)){ return "" }
   mut ni = 0
   while ni < name.len {
      if !_symbol_is_name_char(load8(name, ni)) { return "" }
      ni += 1
   }
   def args = _clean_call_args(slice(raw, p + 1, raw.len - 1, 1))
   mut rendered = []
   mut i = 0
   while i < args.len {
      rendered = rendered.append(_clean_fold_const_expr_text(_clean_apply_local_const_map(args[i], consts)))
      i += 1
   }
   indent + name + "(" + str.join(rendered, ", ") + ")"
}

fn _clean_fold_const_line(str line, dict consts) str {
   def indent = _clean_line_indent(line)
   def raw = str.strip(line)
   if str.startswith(raw, "while (") { return line }
   def open = _clean_structured_if_open_parts(raw)
   if open.len > 0 {
      def cond = _clean_fold_const_expr_text(_clean_apply_local_const_map(open.get("expr", ""), consts))
      return indent + "if " + cond + "{"
   }
   def inline = _clean_inline_if_parts(raw)
   if inline.len > 0 {
      def cond = _clean_fold_const_expr_text(_clean_apply_local_const_map(inline.get("expr", ""), consts))
      return indent + "if (" + cond + ")" + inline.get("tail", "")
   }
   if str.startswith(raw, "return ") {
      return indent + "return " + _clean_fold_const_expr_text(_clean_apply_local_const_map(slice(raw, 7, raw.len, 1), consts))
   }
   def call = _clean_fold_direct_call_line(line, consts)
   if call.len > 0 { return call }
   _clean_apply_local_const_map(line, consts)
}

fn _clean_propagate_local_constants(str text) str {
   def lines = str.split(text, "\n")
   mut consts = dict()
   mut b = str.Builder(max(16, text.len))
   mut i = 0
   while i < lines.len {
      def line = lines[i]
      def raw = str.strip(line)
      def parts = _clean_rendered_assignment_parts(raw)
      mut out_line = line
      if raw.len == 0 {
         ;; Preserve current straight-line constants across blank lines.
      } elif parts.len > 0 {
         def lhs = parts.get("lhs", "")
         def rhs = _clean_fold_const_expr_text(_clean_apply_local_const_map(parts.get("rhs", ""), consts))
         out_line = _clean_line_indent(line) + lhs + " = " + rhs
         if _clean_rendered_const_local(lhs) {
            def lit = _clean_literal_int_value(rhs)
            if lit.get("ok", false) { consts = consts.set(lhs, int(lit.get("value", 0))) }
            else { consts = consts.delete(lhs) }
         } else {
            consts = consts.delete(lhs)
         }
      } else {
         out_line = _clean_fold_const_line(line, consts)
         if (str.startswith(raw, "loc_") || str.startswith(raw, "goto ") ||
            str.startswith(raw, "} else") || raw == "}" ||
            str.startswith(raw, "state_machine ") || str.startswith(raw, "switch(")){
            consts = dict()
         }
         if str.find(raw, "(") >= 0 && !str.startswith(raw, "if (") && !str.startswith(raw, "return ") {
            consts = dict()
         }
         if str.endswith(raw, "{") { consts = dict() }
      }
      b = str.builder_append(b, out_line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_render_text_has_token(str text, str tok) bool {
   if tok.len == 0 || text.len < tok.len { return false }
   mut i = 0
   while i + tok.len <= text.len {
      if slice(text, i, i + tok.len, 1) == tok {
         def before_ok = i == 0 || !_clean_token_char(load8(text, i - 1))
         def after_ok = i + tok.len >= text.len || !_clean_token_char(load8(text, i + tok.len))
         if before_ok && after_ok { return true }
      }
      i += 1
   }
   false
}

fn _clean_render_text_has_alias(str text, str tok) bool {
   def aliases = _slice_symbol_aliases(tok)
   mut i = 0
   while i < aliases.len {
      if _clean_render_text_has_token(text, aliases[i]) { return true }
      i += 1
   }
   false
}

fn _clean_rendered_pure_temp_rhs(str rhs) bool {
   if rhs.len == 0 { return false }
   if str.find(rhs, "=") >= 0 { return false }
   mut i = 0
   while i < rhs.len {
      if _symbol_is_name_char(load8(rhs, i)) {
         def start = i
         while i < rhs.len && _symbol_is_name_char(load8(rhs, i)) { i += 1 }
         def name = str.lower(slice(rhs, start, i, 1))
         mut j = i
         while j < rhs.len && load8(rhs, j) == 32 { j += 1 }
         if j < rhs.len && load8(rhs, j) == 40 {
            if (!(name == "bool" || name == "mem" || name == "mem_fs" || name == "mem_gs" ||
                  name == "zext" || name == "sext" || name == "zext8" || name == "sext8" ||
                  name == "zext16" || name == "sext16" || name == "zext32" || name == "sext32" ||
                  name == "rol" || name == "ror" || name == "byte_at" || name == "signbit")){
               return false
            }
         }
      } else {
         i += 1
      }
   }
   true
}

fn _clean_rendered_accumulator_rhs(str lhs, str rhs) bool {
   if !_clean_render_text_has_token(rhs, lhs) { return false }
   if str.find(rhs, " | ") >= 0 { return true }
   str.find(rhs, " + ") >= 0 && (str.find(rhs, "mem(") >= 0 || str.find(rhs, "[") >= 0)
}

fn _clean_rendered_alias_appears_after(list lines, int idx, str lhs) bool {
   mut j = idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 && _symbols_intersect(_slice_symbol_aliases(parts.get("lhs", "")), _slice_symbol_aliases(lhs)) {
         return _clean_render_text_has_alias(parts.get("rhs", ""), lhs)
      }
      if _clean_render_text_has_alias(raw, lhs) { return true }
      j += 1
   }
   false
}

fn _clean_rendered_temp_dead_after(list lines, int idx, str lhs) bool {
   mut j = idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 { return false }
      if _clean_raw_goto_label(raw).len > 0 { return false }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 && _symbols_intersect(_slice_symbol_aliases(parts.get("lhs", "")), _slice_symbol_aliases(lhs)) {
         return !_clean_render_text_has_alias(parts.get("rhs", ""), lhs)
      }
      if _clean_render_text_has_alias(raw, lhs) { return false }
      if _clean_rendered_is_return(raw) { return !_clean_rendered_alias_appears_after(lines, j, lhs) }
      j += 1
   }
   true
}

fn _clean_rendered_temp_dead_after_labels_ok(list lines, int idx, str lhs) bool {
   mut j = idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 || _clean_rendered_label_name(raw).len > 0 {
         j += 1
         continue
      }
      if _clean_raw_goto_label(raw).len > 0 { return false }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 && _symbols_intersect(_slice_symbol_aliases(parts.get("lhs", "")), _slice_symbol_aliases(lhs)) {
         return !_clean_render_text_has_alias(parts.get("rhs", ""), lhs)
      }
      if _clean_render_text_has_alias(raw, lhs) { return false }
      if _clean_rendered_is_return(raw) { return !_clean_rendered_alias_appears_after(lines, j, lhs) }
      j += 1
   }
   true
}

fn _clean_rendered_temp_dead_after_block_close(list lines, int idx, str lhs) bool {
   if idx < 0 || idx >= lines.len { return false }
   def base_indent = _clean_line_indent(lines[idx]).len
   mut close = -1
   mut j = idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      if raw == "}" && _clean_line_indent(lines[j]).len <= base_indent {
         close = j
         break
      }
      if (_clean_rendered_label_name(raw).len > 0 || _clean_raw_goto_label(raw).len > 0 ||
         _clean_rendered_is_return(raw)){ return false }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 && _symbols_intersect(_slice_symbol_aliases(parts.get("lhs", "")), _slice_symbol_aliases(lhs)) {
         return !_clean_render_text_has_alias(parts.get("rhs", ""), lhs)
      }
      if _clean_render_text_has_alias(raw, lhs) { return false }
      j += 1
   }
   if close < 0 { return false }
   j = close + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 || _clean_rendered_label_name(raw).len > 0 {
         j += 1
         continue
      }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 && _symbols_intersect(_slice_symbol_aliases(parts.get("lhs", "")), _slice_symbol_aliases(lhs)) {
         return !_clean_render_text_has_alias(parts.get("rhs", ""), lhs)
      }
      if _clean_render_text_has_alias(raw, lhs) { return false }
      if _clean_rendered_is_return(raw) { return !_clean_rendered_alias_appears_after(lines, j, lhs) }
      j += 1
   }
   true
}

fn _clean_rendered_call_after(list lines, int idx) bool {
   mut j = idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      if _clean_rendered_is_return(raw) { return false }
      if _clean_rendered_call_args(raw).len > 0 { return true }
      j += 1
   }
   false
}

fn _clean_rendered_temp_unused_after_call(list lines, int call_idx, str lhs) bool {
   mut j = call_idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 || _clean_rendered_label_name(raw).len > 0 {
         j += 1
         continue
      }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 && _symbols_intersect(_slice_symbol_aliases(parts.get("lhs", "")), _slice_symbol_aliases(lhs)) {
         return !_clean_render_text_has_alias(parts.get("rhs", ""), lhs)
      }
      if _clean_render_text_has_alias(raw, lhs) { return false }
      if _clean_rendered_is_return(raw) { return true }
      j += 1
   }
   true
}

fn _clean_drop_dead_rendered_temps_once(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_rendered_assignment_parts(lines[i])
      if parts.len > 0 {
         def lhs = parts.get("lhs", "")
         def rhs = parts.get("rhs", "")
         def removable_temp = ((_clean_rendered_dead_temp_reg(lhs) || _clean_rendered_bool_temp_reg(lhs)) &&
            (!_clean_rendered_return_value_reg(lhs) || _clean_rendered_work_after(lines, i) ||
               _clean_rendered_explicit_return_after(lines, i))) ||
         (_clean_rendered_value_temp_reg(lhs) && _clean_rendered_call_after(lines, i))
         if (removable_temp && _clean_rendered_pure_temp_rhs(rhs) &&
            !_clean_rendered_accumulator_rhs(lhs, rhs) &&
            (_clean_rendered_temp_dead_after(lines, i, lhs) ||
               _clean_rendered_temp_dead_after_labels_ok(lines, i, lhs) ||
               _clean_rendered_temp_dead_after_block_close(lines, i, lhs))){
            changed = true
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_drop_dead_rendered_temps(str text) str {
   mut out = text
   mut i = 0
   while i < 6 {
      def next = _clean_drop_dead_rendered_temps_once(out)
      if next == out { return out }
      out = next
      i += 1
   }
   out
}

fn _clean_unused_scratch_rhs_safe(str rhs0) bool {
   def rhs = str.strip(rhs0)
   rhs.len > 0 && rhs != "rsp" && rhs != "esp" && rhs != "sp" &&
   str.find(rhs, "rsp") < 0 && str.find(rhs, "esp") < 0 &&
   _clean_rendered_pure_temp_rhs(rhs)
}

fn _clean_rendered_alias_unused_after_anywhere(list lines, int idx, str lhs) bool {
   mut j = idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 && _symbols_intersect(_slice_symbol_aliases(parts.get("lhs", "")), _slice_symbol_aliases(lhs)) {
         return !_clean_render_text_has_alias(parts.get("rhs", ""), lhs)
      }
      if _clean_render_text_has_alias(raw, lhs) { return false }
      j += 1
   }
   true
}

fn _clean_drop_unused_scratch_assigns(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_rendered_assignment_parts(lines[i])
      if parts.len > 0 {
         def lhs = parts.get("lhs", "")
         def rhs = parts.get("rhs", "")
         if (_clean_rendered_discardable_dead_reg(lhs) && _clean_unused_scratch_rhs_safe(rhs) &&
            !_clean_rendered_accumulator_rhs(lhs, rhs) &&
            _clean_rendered_work_after(lines, i) && _clean_rendered_alias_unused_after_anywhere(lines, i, lhs)){
            changed = true
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_branchless_byte_network_line(str line) bool {
   def parts = _clean_rendered_assignment_parts(line)
   if parts.len == 0 { return false }
   def lhs = str.strip(parts.get("lhs", ""))
   def rhs = str.strip(parts.get("rhs", ""))
   if !(str.startswith(lhs, "data_") || str.startswith(lhs, "local_")) { return false }
   if str.find(rhs, "byte_at(") < 0 { return false }
   str.find(rhs, "/ 0x80") >= 0 || str.find(rhs, "* argv") >= 0 ||
   str.find(rhs, "argv *") >= 0
}

fn _clean_branchless_byte_network_arg(str first_line) str {
   def p = str.find(first_line, "(")
   def q = str.find(first_line, ")")
   if p < 0 || q <= p { return "input" }
   def args = _clean_call_args(slice(first_line, p + 1, q, 1))
   mut i = 0
   while i < args.len {
      if str.strip(args[i]) == "argv" {
         return args.len >= 2 ? "argv[1]" : "argv"
      }
      i += 1
   }
   i = 0
   while i < args.len {
      def arg = str.strip(args[i])
      if arg.len > 0 && arg != "argc" { return arg }
      i += 1
   }
   "input"
}

fn _clean_data_symbol_value(str name0) dict {
   def name = str.strip(name0)
   if !str.startswith(name, "data_") || name.len <= 5 { return {"ok": false} }
   _clean_literal_int_value("0x" + slice(name, 5, name.len, 1))
}

fn _clean_branchless_byte_network_span(list lines) dict {
   mut seen = false
   mut lo = 0
   mut hi = 0
   mut count = 0
   mut i = 0
   while i < lines.len {
      def parts = _clean_rendered_assignment_parts(lines[i])
      if parts.len > 0 && _clean_branchless_byte_network_line(lines[i]) {
         def val = _clean_data_symbol_value(parts.get("lhs", ""))
         if val.get("ok", false) {
            def addr = int(val.get("value", 0))
            if !seen || addr < lo { lo = addr }
            if !seen || addr > hi { hi = addr }
            seen = true
            count += 1
         }
      }
      i += 1
   }
   seen ? {"ok": true, "lo": lo, "hi": hi, "count": count} : {"ok": false}
}

fn _clean_collapse_branchless_byte_network(str text) str {
   if str.find(text, "byte_at(") < 0 || str.find(text, "/ 0x80") < 0 { return text }
   def lines = str.split(text, "\n")
   if lines.len == 0 { return text }
   def first = str.strip(lines[0])
   if !str.startswith(first, "fn ") || str.find(first, "(") < 0 { return text }
   mut network_lines = 0
   mut top_level_lines = 0
   mut i = 1
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      if raw.len > 0 && raw != "}" {
         top_level_lines += 1
         if _clean_branchless_byte_network_line(lines[i]) { network_lines += 1 }
      }
      i += 1
   }
   if network_lines < 10 || top_level_lines == 0 || network_lines * 2 < top_level_lines { return text }
   def p = str.find(lines[0], "(")
   def prefix = p > 0 ? slice(lines[0], 0, p, 1) : "fn branchless_entry"
   def arg = _clean_branchless_byte_network_arg(lines[0])
   def span = _clean_branchless_byte_network_span(lines)
   mut out_count = network_lines
   mut note = ""
   if span.get("ok", false) {
      out_count = int(span.get("count", network_lines))
      if int(span.get("lo", 0)) >= 0x400000 {
         note = "  ; observed output writes " + _hex(int(span.get("lo", 0))) + ".." +
         _hex(int(span.get("hi", 0))) + " (" + to_str(int(span.get("count", 0))) + " bytes)\n"
      } else {
         note = "  ; observed branchless output byte stores: " + to_str(int(span.get("count", 0))) + "\n"
      }
   }
   prefix + "(" + arg + "){\n" +
   note +
   "  return branchless_byte_transform(" + arg + ", " + to_str(out_count) + ")\n" +
   "}\n"
}

fn _clean_branchless_byte_network_row_summary(str name, dict sig, list rows) str {
   if rows.len < 128 { return "" }
   mut data_count = 0
   mut branch_count = 0
   mut call_count = 0
   mut lo = 0
   mut hi = 0
   mut seen = false
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      def op = r.get("op", "")
      if op == "branch" { branch_count += 1 }
      elif op == "call" || op == "syscall" { call_count += 1 }
      elif (op == "assign" && r.get("dst_kind", "") == "mem" &&
         r.get("ref_kind", "") == "data" && r.get("src_kind", "") == "reg" &&
         (_is_byte_operand(r.get("src", "")) ||
            _clean_byte_reg_lane(r.get("src", "")).get("ok", false))){
         def addr = int(r.get("ref_target", 0))
         if addr > 0 {
            if !seen || addr < lo { lo = addr }
            if !seen || addr > hi { hi = addr }
            seen = true
         }
         data_count += 1
      }
      i += 1
   }
   if branch_count > 0 || call_count > 0 || data_count < 10 { return "" }
   mut arg = "input"
   def params = sig.get("params", [])
   i = 0
   while i < params.len {
      if params[i].get("name", "") == "argv" { arg = "argv[1]" }
      i += 1
   }
   if arg == "input" && params.len > 0 { arg = params[0].get("name", "input") }
   mut note = "  ; observed branchless output byte stores: " + to_str(data_count) + "\n"
   if seen && hi >= lo && hi - lo + 1 == data_count {
      note = "  ; observed output writes " + _hex(lo) + ".." + _hex(hi) + " (" + to_str(data_count) + " bytes)\n"
   }
   "fn " + name + "(" + _signature_param_text(sig) + "){\n" +
   note +
   "  return branchless_byte_transform(" + arg + ", " + to_str(data_count) + ")\n" +
   "}\n"
}

fn _clean_terminal_opaque_even_product_scratch_at(list lines, int i) bool {
   if i + 4 >= lines.len { return false }
   def pad = _clean_line_indent(lines[i])
   if (_clean_line_indent(lines[i + 1]) != pad || _clean_line_indent(lines[i + 2]) != pad ||
      _clean_line_indent(lines[i + 3]) != pad){ return false }
   def a = _clean_rendered_assignment_parts(lines[i])
   def b = _clean_rendered_assignment_parts(lines[i + 1])
   def c = _clean_rendered_assignment_parts(lines[i + 2])
   def d = _clean_rendered_assignment_parts(lines[i + 3])
   if a.len == 0 || b.len == 0 || c.len == 0 || d.len == 0 { return false }
   def x = str.strip(a.get("lhs", ""))
   def y = str.strip(b.get("lhs", ""))
   if !_clean_rendered_value_temp_reg(x) || !_clean_rendered_value_temp_reg(y) || x == y { return false }
   if str.strip(a.get("rhs", "")) != str.strip(b.get("rhs", "")) { return false }
   if str.strip(c.get("lhs", "")) != y || str.strip(c.get("rhs", "")) != y + " - 1" { return false }
   if str.strip(d.get("lhs", "")) != x || str.strip(d.get("rhs", "")) != x + " * " + y { return false }
   mut j = i + 4
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 || raw == "}" || _clean_rendered_label_name(raw).len > 0 {
         j += 1
         continue
      }
      return raw == "return"
   }
   false
}

fn _clean_drop_terminal_opaque_even_product_scratch(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if _clean_terminal_opaque_even_product_scratch_at(lines, i) {
         changed = true
         i += 4
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_rendered_magic_folded_line(str line) bool {
   def parts = _clean_rendered_assignment_parts(line)
   def rhs = parts.len > 0 ? parts.get("rhs", "") : line
   _clean_magic_folded_stmt_expr(rhs)
}

fn _clean_rendered_magic_setup_lhs_unused(str next_rhs, list lhses) bool {
   mut i = 0
   while i < lhses.len {
      if _clean_render_text_has_alias(next_rhs, lhses[i]) { return false }
      i += 1
   }
   true
}

fn _clean_drop_magic_wide_setup(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut i = 0
   while i < lines.len {
      def raw = str.strip(lines[i])
      if str.find(raw, "= smul_wide32(") >= 0 || str.find(raw, "= umul_wide32(") >= 0 {
         def next = _clean_next_nonblank_index(lines, i + 1)
         if next < lines.len && _clean_rendered_magic_folded_line(lines[next]) {
            def next_parts = _clean_rendered_assignment_parts(lines[next])
            def next_rhs = next_parts.len > 0 ? next_parts.get("rhs", "") : lines[next]
            mut start = i
            mut lhses = ["eax", "edx"]
            mut j = i - 1
            mut guard = 0
            mut ok = true
            while j >= 0 && guard < 4 {
               def prev = str.strip(lines[j])
               if prev.len == 0 { j -= 1 continue }
               def parts = _clean_rendered_assignment_parts(prev)
               if parts.len == 0 { break }
               def lhs = str.lower(parts.get("lhs", ""))
               if !(lhs == "eax" || lhs == "rax" || lhs == "edx" || lhs == "rdx" || lhs == "ecx" || lhs == "rcx") { break }
               if !_clean_rendered_pure_temp_rhs(parts.get("rhs", "")) { ok = false break }
               lhses = _append_unique(lhses, lhs)
               start = j
               j -= 1
               guard += 1
            }
            if ok && start < i && _clean_rendered_magic_setup_lhs_unused(next_rhs, lhses) {
               mut k = start
               while k <= i {
                  skip = skip.set(to_str(k), true)
                  k += 1
               }
            }
         }
      }
      i += 1
   }
   if skip.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) { b = str.builder_append(b, lines[i] + "\n") }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_drop_condition_reg_setup(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      def p = str.find(raw, " = ")
      if p > 0 {
         def lhs = str.strip(slice(raw, 0, p, 1))
         def rhs = str.strip(slice(raw, p + 3, raw.len, 1))
         if _clean_rendered_temp_reg(lhs) && _clean_inline_condition_copy_candidate(lhs, rhs) {
            def j = _clean_next_nonblank_index(lines, i + 1)
            if j < lines.len && _clean_rendered_label_name(lines[j]).len == 0 {
               def raw_next = str.strip(lines[j])
               def open = _clean_structured_if_open_parts(raw_next)
               if open.len > 0 && str.find(open.get("expr", ""), lhs) >= 0 {
                  b = str.builder_append(b, _clean_line_indent(lines[j]) + "if (" +
                     _clean_replace_token(open.get("expr", ""), lhs, _clean_inline_condition_copy_rhs(rhs)) + "){\n")
                  i = j + 1
                  continue
               }
               def inline = _clean_inline_if_parts(raw_next)
               if inline.len > 0 && str.find(inline.get("expr", ""), lhs) >= 0 {
                  b = str.builder_append(b, _clean_line_indent(lines[j]) + "if (" +
                     _clean_replace_token(inline.get("expr", ""), lhs, _clean_inline_condition_copy_rhs(rhs)) +
                     ")" + inline.get("tail", "") + "\n")
                  i = j + 1
                  continue
               }
               def parts = _clean_if_goto_parts(raw_next)
               if parts.len > 0 && str.find(parts.get("expr", ""), lhs) >= 0 {
                  b = str.builder_append(b, _clean_line_indent(lines[j]) + "if (" +
                     _clean_replace_token(parts.get("expr", ""), lhs, _clean_inline_condition_copy_rhs(rhs)) +
                     "){ goto " + parts.get("target", "") + " }\n")
                  i = j + 1
                  continue
               }
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_rendered_standalone_call_expr(str rhs0) bool {
   def rhs = str.strip(rhs0)
   if rhs.len == 0 { return false }
   mut i = 0
   while i < rhs.len && _symbol_is_name_char(load8(rhs, i)) { i += 1 }
   if i <= 0 || i >= rhs.len || load8(rhs, i) != 40 { return false }
   def name = slice(rhs, 0, i, 1)
   if _clean_rendered_helper_call_name(name) { return false }
   _clean_call_end_at(rhs, 0, name) == rhs.len
}

fn _clean_rendered_call_result_copy_lhs(str lhs0) bool {
   def lhs = str.strip(lhs0)
   lhs.len > 0 && !_clean_rendered_temp_reg(lhs) && str.find(lhs, "[") < 0 &&
   str.find(lhs, ".") < 0 && str.find(lhs, " ") < 0
}

fn _clean_rendered_rhs_is_alias(str rhs0, str lhs0) bool {
   def rhs = str.lower(str.strip(rhs0))
   def aliases = _slice_symbol_aliases(lhs0)
   _list_has(aliases, rhs)
}

fn _clean_local_dead_after_condition(list lines, int cond_idx, str lhs) bool {
   mut j = cond_idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      def parts = _clean_rendered_assignment_parts(lines[j])
      if parts.len > 0 && parts.get("lhs", "") == lhs {
         return true
      }
      if _clean_render_text_has_token(lines[j], lhs) { return false }
      j += 1
   }
   true
}

fn _clean_inline_call_result_copy_conditions(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def call_assign = _clean_rendered_assignment_parts(lines[i])
      if (call_assign.len > 0 && _clean_rendered_temp_reg(call_assign.get("lhs", "")) &&
         _clean_rendered_standalone_call_expr(call_assign.get("rhs", ""))){
         def j = _clean_next_nonblank_index(lines, i + 1)
         if j < lines.len {
            if (_clean_render_text_has_token(lines[j], call_assign.get("lhs", "")) &&
               _clean_local_dead_after_condition(lines, j, call_assign.get("lhs", ""))){
               def repl = _clean_condition_operand(call_assign.get("rhs", ""))
               def raw = str.strip(lines[j])
               def open = _clean_structured_if_open_parts(raw)
               if open.len > 0 && _clean_render_text_has_token(open.get("expr", ""), call_assign.get("lhs", "")) {
                  b = str.builder_append(b, _clean_line_indent(lines[j]) + "if (" +
                     _clean_replace_token(open.get("expr", ""), call_assign.get("lhs", ""), repl) + "){\n")
                  i = j + 1
                  continue
               }
               def inline = _clean_inline_if_parts(raw)
               if inline.len > 0 && _clean_render_text_has_token(inline.get("expr", ""), call_assign.get("lhs", "")) {
                  b = str.builder_append(b, _clean_line_indent(lines[j]) + "if (" +
                     _clean_replace_token(inline.get("expr", ""), call_assign.get("lhs", ""), repl) + ")" +
                     inline.get("tail", "") + "\n")
                  i = j + 1
                  continue
               }
               def parts = _clean_if_goto_parts(raw)
               if parts.len > 0 && _clean_render_text_has_token(parts.get("expr", ""), call_assign.get("lhs", "")) {
                  b = str.builder_append(b, _clean_line_indent(lines[j]) + "if (" +
                     _clean_replace_token(parts.get("expr", ""), call_assign.get("lhs", ""), repl) +
                     "){ goto " + parts.get("target", "") + " }\n")
                  i = j + 1
                  continue
               }
            }
            def copy = _clean_rendered_assignment_parts(lines[j])
            if (copy.len > 0 && _clean_rendered_call_result_copy_lhs(copy.get("lhs", "")) &&
               _clean_rendered_rhs_is_alias(copy.get("rhs", ""), call_assign.get("lhs", ""))){
               def k = _clean_next_nonblank_index(lines, j + 1)
               if (k < lines.len && _clean_render_text_has_token(lines[k], copy.get("lhs", "")) &&
                  _clean_local_dead_after_condition(lines, k, copy.get("lhs", ""))){
                  def repl = _clean_condition_operand(call_assign.get("rhs", ""))
                  def raw = str.strip(lines[k])
                  def open = _clean_structured_if_open_parts(raw)
                  if open.len > 0 && _clean_render_text_has_token(open.get("expr", ""), copy.get("lhs", "")) {
                     b = str.builder_append(b, _clean_line_indent(lines[k]) + "if (" +
                        _clean_replace_token(open.get("expr", ""), copy.get("lhs", ""), repl) + "){\n")
                     i = k + 1
                     continue
                  }
                  def inline = _clean_inline_if_parts(raw)
                  if inline.len > 0 && _clean_render_text_has_token(inline.get("expr", ""), copy.get("lhs", "")) {
                     b = str.builder_append(b, _clean_line_indent(lines[k]) + "if (" +
                        _clean_replace_token(inline.get("expr", ""), copy.get("lhs", ""), repl) + ")" +
                        inline.get("tail", "") + "\n")
                     i = k + 1
                     continue
                  }
                  def parts = _clean_if_goto_parts(raw)
                  if parts.len > 0 && _clean_render_text_has_token(parts.get("expr", ""), copy.get("lhs", "")) {
                     b = str.builder_append(b, _clean_line_indent(lines[k]) + "if (" +
                        _clean_replace_token(parts.get("expr", ""), copy.get("lhs", ""), repl) +
                        "){ goto " + parts.get("target", "") + " }\n")
                     i = k + 1
                     continue
                  }
               }
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_rendered_no_compare_ops(str rhs) bool {
   str.find(rhs, "==") < 0 && str.find(rhs, "!=") < 0 &&
   str.find(rhs, " <= ") < 0 && str.find(rhs, " >= ") < 0 &&
   str.find(rhs, " < ") < 0 && str.find(rhs, " > ") < 0
}

fn _clean_rendered_binary_expr_parts(str rhs0) dict {
   def rhs = str.strip(rhs0)
   if rhs.len == 0 || !_clean_rendered_no_compare_ops(rhs) { return dict() }
   def ops = [" & ", " | ", " ^^ ", " + ", " - ", " * ", " / ", " % ", " << ", " >> "]
   mut i = 0
   while i < ops.len {
      def op = ops[i]
      def p = _clean_top_level_find(rhs, op)
      if p > 0 {
         def lhs = str.strip(slice(rhs, 0, p, 1))
         def r = str.strip(slice(rhs, p + op.len, rhs.len, 1))
         if lhs.len > 0 && r.len > 0 {
            return {"lhs": lhs, "op": op, "rhs": r}
         }
      }
      i += 1
   }
   dict()
}

fn _clean_direct_condition_arith_expr(str lhs, str rhs0) str {
   def rhs = str.strip(rhs0)
   if !_clean_rendered_temp_reg(lhs) || !_clean_rendered_pure_temp_rhs(rhs) { return "" }
   if str.find(rhs, "(") >= 0 { return "" }
   if _clean_render_text_has_token(rhs, lhs) { return "" }
   if _clean_rendered_binary_expr_parts(rhs).len == 0 { return "" }
   "(" + rhs + ")"
}

fn _clean_self_condition_arith_expr(str lhs0, str base_rhs0, str arith_rhs0) str {
   def lhs = str.strip(lhs0)
   def base = _clean_inline_condition_copy_rhs(base_rhs0)
   def arith = str.strip(arith_rhs0)
   if !_clean_rendered_temp_reg(lhs) || !_clean_inline_condition_copy_candidate(lhs, base) { return "" }
   if str.lower(base) == str.lower(lhs) { return "" }
   if !_clean_rendered_pure_temp_rhs(arith) || str.find(arith, "(") >= 0 { return "" }
   def parts = _clean_rendered_binary_expr_parts(arith)
   if parts.len == 0 { return "" }
   def l = parts.get("lhs", "")
   def r = parts.get("rhs", "")
   def op = parts.get("op", "")
   if l == lhs { return "(" + base + op + r + ")" }
   if r == lhs && (op == " & " || op == " | " || op == " ^^ " || op == " + " || op == " * ") {
      return "(" + l + op + base + ")"
   }
   if r == lhs && (op == " - " || op == " / " || op == " % ") {
      return "(" + l + op + base + ")"
   }
   ""
}

fn _clean_rewrite_condition_line(str line, str lhs, str expr) str {
   if expr.len == 0 { return "" }
   def pad = _clean_line_indent(line)
   def raw = str.strip(line)
   def open = _clean_structured_if_open_parts(raw)
   if open.len > 0 && _clean_render_text_has_token(open.get("expr", ""), lhs) {
      return pad + "if " + _clean_replace_token(open.get("expr", ""), lhs, expr) + "{"
   }
   def inline = _clean_inline_if_parts(raw)
   if inline.len > 0 && _clean_render_text_has_token(inline.get("expr", ""), lhs) {
      return pad + "if (" + _clean_replace_token(inline.get("expr", ""), lhs, expr) + ")" + inline.get("tail", "")
   }
   def parts = _clean_if_goto_parts(raw)
   if parts.len > 0 && _clean_render_text_has_token(parts.get("expr", ""), lhs) {
      return pad + "if (" + _clean_replace_token(parts.get("expr", ""), lhs, expr) +
      "){ goto " + parts.get("target", "") + " }"
   }
   ""
}

fn _clean_rewrite_condition_expr_line(str line, str expr0) str {
   def expr = str.strip(expr0)
   if expr.len == 0 { return "" }
   def pad = _clean_line_indent(line)
   def raw = str.strip(line)
   def open = _clean_structured_if_open_parts(raw)
   if open.len > 0 { return pad + "if " + expr + "{" }
   def inline = _clean_inline_if_parts(raw)
   if inline.len > 0 { return pad + "if (" + expr + ")" + inline.get("tail", "") }
   def parts = _clean_if_goto_parts(raw)
   if parts.len > 0 {
      return pad + "if " + expr + "{ goto " + parts.get("target", "") + " }"
   }
   ""
}

fn _clean_condition_temp_chain_stop(str raw0) bool {
   def raw = str.strip(raw0)
   raw.len == 0 ? false :
   str.startswith(raw, "fn ") || _clean_rendered_label_name(raw).len > 0 ||
   _clean_raw_goto_label(raw).len > 0 || _clean_rendered_is_return(raw) ||
   str.startswith(raw, "while (") || str.startswith(raw, "while ") ||
   str.startswith(raw, "for ") || str.startswith(raw, "switch(") ||
   raw == "}" || raw == "} else {"
}

fn _clean_condition_temp_rhs_ok(str rhs0) bool {
   def rhs = str.strip(rhs0)
   rhs.len > 0 && _clean_rendered_pure_temp_rhs(rhs) &&
   !str.startswith(rhs, "rsp") && !str.startswith(rhs, "esp") &&
   str.find(rhs, "rsp") < 0 && str.find(rhs, "esp") < 0
}

fn _clean_condition_temp_candidate_skip_ok(list lines, int use_idx, dict cand, dict cand_map) bool {
   def lhs = cand.get("lhs", "")
   if lhs.len == 0 { return false }
   mut j = int(cand.get("idx", 0)) + 1
   while j < use_idx {
      if !cand_map.get(to_str(j), false) && _clean_render_text_has_alias(lines[j], lhs) {
         return false
      }
      j += 1
   }
   _clean_rendered_temp_dead_after(lines, use_idx, lhs) ||
   _clean_rendered_temp_dead_after_labels_ok(lines, use_idx, lhs) ||
   _clean_rendered_temp_dead_after_block_close(lines, use_idx, lhs)
}

fn _clean_condition_temp_self_update_in_loop(list lines, int idx) bool {
   mut j = idx - 1
   mut guard = 0
   while j >= 0 && guard < 24 {
      def raw = str.strip(lines[j])
      if str.startswith(raw, "while (") || str.startswith(raw, "while ") { return true }
      if (str.startswith(raw, "fn ") || _clean_rendered_label_name(raw).len > 0 ||
         _clean_raw_goto_label(raw).len > 0 || raw == "}" || raw == "} else {"){
         return false
      }
      j -= 1
      guard += 1
   }
   false
}

fn _clean_condition_temp_source_redefined_between(list lines, int start, int stop, str rhs0) bool {
   def syms = _symbols_from_text(rhs0)
   if syms.len == 0 { return false }
   mut i = start
   while i < stop && i < lines.len {
      def parts = _clean_rendered_assignment_parts(lines[i])
      if parts.len > 0 && _symbols_intersect(_slice_symbol_aliases(parts.get("lhs", "")), syms) {
         return true
      }
      i += 1
   }
   false
}

fn _clean_resolve_condition_temp_chain(list lines, int use_idx, str expr0) dict {
   mut expr = str.strip(expr0)
   mut candidates = []
   mut j = use_idx - 1
   mut guard = 0
   while j >= 0 && guard < 28 {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j -= 1
         continue
      }
      if _clean_condition_temp_chain_stop(raw) { break }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len == 0 { break }
      def lhs = parts.get("lhs", "")
      def rhs = parts.get("rhs", "")
      if _clean_render_text_has_alias(expr, lhs) {
         if !_clean_rendered_value_temp_reg(lhs) || !_clean_condition_temp_rhs_ok(rhs) {
            break
         }
         if (_clean_render_text_has_alias(rhs, lhs) &&
            _clean_condition_temp_self_update_in_loop(lines, j)){
            break
         }
         if _clean_condition_temp_source_redefined_between(lines, j + 1, use_idx, rhs) {
            break
         }
         expr = _clean_replace_aliases_text(expr, _slice_symbol_aliases(lhs),
            _clean_rendered_inline_rhs(rhs))
         candidates = candidates.append({"idx": j, "lhs": lhs})
         guard += 1
      }
      j -= 1
   }
   if candidates.len == 0 { return dict() }
   mut cand_map = dict()
   mut i = 0
   while i < candidates.len {
      cand_map = cand_map.set(to_str(candidates[i].get("idx", -1)), true)
      i += 1
   }
   mut skip = dict()
   i = 0
   while i < candidates.len {
      if !_clean_condition_temp_candidate_skip_ok(lines, use_idx, candidates[i], cand_map) {
         return dict()
      }
      skip = skip.set(to_str(candidates[i].get("idx", -1)), true)
      i += 1
   }
   {"expr": _clean_simplify_nested_ext_expr(_clean_strip_outer_balanced_parens(expr)), "skip": skip}
}

fn _clean_inline_condition_temp_chains(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      mut expr = ""
      def open = _clean_structured_if_open_parts(raw)
      if open.len > 0 { expr = open.get("expr", "") }
      else {
         def inline = _clean_inline_if_parts(raw)
         if inline.len > 0 { expr = inline.get("expr", "") }
         else {
            def parts = _clean_if_goto_parts(raw)
            if parts.len > 0 { expr = parts.get("expr", "") }
         }
      }
      if expr.len > 0 {
         def resolved = _clean_resolve_condition_temp_chain(lines, i, expr)
         if resolved.len > 0 {
            def rewritten = _clean_rewrite_condition_expr_line(lines[i], resolved.get("expr", expr))
            if rewritten.len > 0 {
               replace = replace.set(to_str(i), rewritten)
               def skips = resolved.get("skip", dict())
               def keys = skips.keys()
               mut ki = 0
               while ki < keys.len {
                  skip = skip.set(keys[ki], true)
                  ki += 1
               }
               changed = true
            }
         }
      }
      i += 1
   }
   if !changed { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) {
         b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_inline_check_condition_temp_chains(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def name = _clean_check_helper_fn_name(lines[i])
      if name.len > 0 {
         mut block = lines[i] + "\n"
         i += 1
         while i < lines.len {
            if i == lines.len - 1 && lines[i].len == 0 { break }
            if str.startswith(str.strip(lines[i]), "fn ") { break }
            block = block + lines[i] + "\n"
            if str.strip(lines[i]) == "}" {
               i += 1
               break
            }
            i += 1
         }
         b = str.builder_append(b, _clean_inline_condition_temp_chains(block))
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_inline_arith_condition_reg_setup(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_rendered_assignment_parts(lines[i])
      if parts.len > 0 {
         def lhs = parts.get("lhs", "")
         def rhs = parts.get("rhs", "")
         def j = _clean_next_nonblank_index(lines, i + 1)
         if j < lines.len && _clean_rendered_label_name(lines[j]).len == 0 {
            if !_clean_render_text_has_alias(rhs, lhs) {
               def direct = _clean_direct_condition_arith_expr(lhs, rhs)
               def rewritten = _clean_rewrite_condition_line(lines[j], lhs, direct)
               if (rewritten.len > 0 && (_clean_rendered_temp_dead_after(lines, j, lhs) ||
                     _clean_rendered_temp_dead_after_labels_ok(lines, j, lhs))){
                  b = str.builder_append(b, rewritten + "\n")
                  i = j + 1
                  continue
               }
            }
            def next_parts = _clean_rendered_assignment_parts(lines[j])
            if next_parts.len > 0 && str.lower(next_parts.get("lhs", "")) == str.lower(lhs) {
               def expr = _clean_self_condition_arith_expr(lhs, rhs, next_parts.get("rhs", ""))
               def k = _clean_next_nonblank_index(lines, j + 1)
               if k < lines.len && _clean_rendered_label_name(lines[k]).len == 0 {
                  def rewritten2 = _clean_rewrite_condition_line(lines[k], lhs, expr)
                  if (rewritten2.len > 0 && (_clean_rendered_temp_dead_after(lines, k, lhs) ||
                        _clean_rendered_temp_dead_after_labels_ok(lines, k, lhs))){
                     b = str.builder_append(b, rewritten2 + "\n")
                     i = k + 1
                     continue
                  }
               }
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_rendered_bool_temp_reg(str lhs0) bool {
   def lhs = str.lower(str.strip(lhs0))
   lhs == "al" || lhs == "bl" || lhs == "cl" || lhs == "dl" ||
   lhs == "ah" || lhs == "bh" || lhs == "ch" || lhs == "dh" ||
   lhs == "sil" || lhs == "dil" || lhs == "spl" || lhs == "bpl" ||
   lhs == "r8b" || lhs == "r9b" ||
   lhs == "r10b" || lhs == "r11b" || lhs == "r12b" || lhs == "r13b" ||
   lhs == "r14b" || lhs == "r15b"
}

fn _clean_rendered_value_temp_reg(str lhs0) bool {
   def lhs = str.lower(str.strip(lhs0))
   if _clean_rendered_temp_reg(lhs) || _clean_rendered_dead_temp_reg(lhs) || _clean_rendered_bool_temp_reg(lhs) { return true }
   lhs == "rcx" || lhs == "ecx" || lhs == "cx" || lhs == "cl" ||
   lhs == "rsi" || lhs == "esi" || lhs == "si" || lhs == "sil" ||
   lhs == "rdi" || lhs == "edi" || lhs == "di" || lhs == "dil" ||
   lhs == "r8" || lhs == "r8d" || lhs == "r8w" || lhs == "r8b" ||
   lhs == "r9" || lhs == "r9d" || lhs == "r9w" || lhs == "r9b" ||
   lhs == "r10" || lhs == "r10d" || lhs == "r10w" || lhs == "r10b" ||
   lhs == "r11" || lhs == "r11d" || lhs == "r11w" || lhs == "r11b" ||
   lhs == "r12" || lhs == "r12d" || lhs == "r12w" || lhs == "r12b" ||
   lhs == "r13" || lhs == "r13d" || lhs == "r13w" || lhs == "r13b" ||
   lhs == "r14" || lhs == "r14d" || lhs == "r14w" || lhs == "r14b" ||
   lhs == "r15" || lhs == "r15d" || lhs == "r15w" || lhs == "r15b"
}

fn _clean_expr_subst_wrap(str expr0) str {
   def expr = str.strip(expr0)
   if expr.len == 0 { return expr }
   if _clean_literal_int_value(expr).get("ok", false) { return expr }
   mut complex = false
   mut i = 0
   while i < expr.len {
      def c = load8(expr, i)
      if (c == 32 || c == 43 || c == 45 || c == 42 || c == 47 || c == 37 ||
         c == 38 || c == 124 || c == 94 || c == 60 || c == 62 || c == 63 || c == 58){
         complex = true
         break
      }
      i += 1
   }
   complex ? "(" + expr + ")" : expr
}

fn _clean_rendered_boolish_expr(str expr0) bool {
   def expr = str.strip(expr0)
   def low = str.lower(expr)
   if low == "true" || low == "false" { return true }
   if str.startswith(low, "bool(") { return true }
   if str.find(low, "&&") >= 0 || str.find(low, "||") >= 0 { return true }
   if (str.find(low, " == ") >= 0 || str.find(low, " != ") >= 0 ||
      str.find(low, " <= ") >= 0 || str.find(low, " >= ") >= 0 ||
      str.find(low, " < ") >= 0 || str.find(low, " > ") >= 0){ return true }
   if str.startswith(low, "!") { return true }
   false
}

fn _clean_bool_expr_apply_env(str expr0, dict env) str {
   def expr = str.strip(expr0)
   if expr.len == 0 || env.len == 0 { return expr }
   mut b = str.Builder(expr.len)
   mut i = 0
   while i < expr.len {
      def ch = load8(expr, i)
      if _symbol_is_name_char(ch) {
         def start = i
         while i < expr.len && _symbol_is_name_char(load8(expr, i)) { i += 1 }
         def tok = slice(expr, start, i, 1)
         def repl = env.get(str.lower(tok), "")
         b = str.builder_append(b, repl.len > 0 ? repl : tok)
      } else {
         b = str.builder_append(b, chr(ch))
         i += 1
      }
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_bool_expr_from_truth(str expr0) str {
   def tv = _clean_expr_truth_value(expr0)
   tv == 1 ? "true" : (tv == 0 ? "false" : "")
}

fn _clean_bool_word_value(str expr0) int {
   def lower = str.lower(str.strip(expr0))
   if lower == "true" { return 1 }
   if lower == "false" { return 0 }
   -1
}

fn _clean_bitwise_truth_part_ok(str expr0) bool {
   def expr = _clean_strip_outer_balanced_parens(expr0)
   def lower = str.lower(expr)
   if lower == "true" || lower == "false" { return true }
   def lit = _clean_literal_int_value(expr)
   if lit.get("ok", false) {
      def value = int(lit.get("value", 0))
      return value == 0 || value == 1
   }
   str.startswith(expr, "bool(") && _clean_call_end_at(expr, 0, "bool") == expr.len
}

fn _clean_simplify_bool_expr(str expr0) str {
   def expr = _clean_strip_outer_balanced_parens(expr0)
   def truth = _clean_bool_expr_from_truth(expr)
   if truth.len > 0 { return truth }
   def b = _clean_strip_unary_call(expr, "bool")
   if b.len > 0 {
      def inner = _clean_simplify_bool_expr(b)
      if inner == "true" || inner == "false" { return inner }
      return "bool(" + inner + ")"
   }
   def cmp_ops = [" != ", " == ", " <= ", " >= ", " < ", " > "]
   mut ci = 0
   while ci < cmp_ops.len {
      def cp = _clean_top_level_find(expr, cmp_ops[ci])
      if cp >= 0 {
         def lhs = str.strip(slice(expr, 0, cp, 1))
         def rhs = str.strip(slice(expr, cp + cmp_ops[ci].len, expr.len, 1))
         return _clean_condition_operand(lhs) + cmp_ops[ci] + _clean_condition_operand(rhs)
      }
      ci += 1
   }
   def or_parts = _clean_top_level_split(expr, " | ")
   if or_parts.len > 1 {
      mut kept = []
      mut i = 0
      while i < or_parts.len {
         def raw_tv = _clean_bool_word_value(or_parts[i])
         if raw_tv == 1 { return "true" }
         if raw_tv == 0 {
            i += 1
            continue
         }
         def raw_part = str.strip(or_parts[i])
         def part = _clean_literal_int_value(raw_part).get("ok", false) ? raw_part : _clean_simplify_bool_expr(raw_part)
         kept = kept.append(_clean_condition_operand(part))
         i += 1
      }
      if kept.len == 0 { return "false" }
      return str.join(kept, " | ")
   }
   def lor_parts = _clean_top_level_split(expr, " || ")
   if lor_parts.len > 1 {
      mut kept = []
      mut i = 0
      while i < lor_parts.len {
         def part = _clean_simplify_bool_expr(lor_parts[i])
         if part == "true" { return "true" }
         if part != "false" { kept = kept.append(part) }
         i += 1
      }
      if kept.len == 0 { return "false" }
      return str.join(kept, " || ")
   }
   def and_parts = _clean_top_level_split(expr, " & ")
   if and_parts.len > 1 {
      mut kept = []
      mut i = 0
      while i < and_parts.len {
         def raw_tv = _clean_bool_word_value(and_parts[i])
         if raw_tv == 0 { return "false" }
         if raw_tv == 1 {
            i += 1
            continue
         }
         def raw_part = str.strip(and_parts[i])
         def part = _clean_literal_int_value(raw_part).get("ok", false) ? raw_part : _clean_simplify_bool_expr(raw_part)
         kept = kept.append(_clean_condition_operand(part))
         i += 1
      }
      if kept.len == 0 { return "true" }
      return str.join(kept, " & ")
   }
   def land_parts = _clean_top_level_split(expr, " && ")
   if land_parts.len > 1 {
      mut kept = []
      mut i = 0
      while i < land_parts.len {
         def part = _clean_simplify_bool_expr(land_parts[i])
         if part == "false" { return "false" }
         if part != "true" { kept = kept.append(part) }
         i += 1
      }
      if kept.len == 0 { return "true" }
      return str.join(kept, " && ")
   }
   expr
}

fn _clean_simplify_bool_expr_with_env(str expr0, dict env) str {
   if expr0.len > 512 { return str.strip(expr0) }
   _clean_simplify_bool_expr(_clean_bool_expr_apply_env(expr0, env))
}

fn _clean_rewrite_condition_expr_line(str line, str expr) str {
   def pad = _clean_line_indent(line)
   def raw = str.strip(line)
   def open = _clean_structured_if_open_parts(raw)
   if open.len > 0 { return pad + "if " + expr + "{" }
   def inline = _clean_inline_if_parts(raw)
   if inline.len > 0 { return pad + "if (" + expr + ")" + inline.get("tail", "") }
   def parts = _clean_if_goto_parts(raw)
   if parts.len > 0 { return pad + "if " + expr + "{ goto " + parts.get("target", "") + " }" }
   line
}

fn _clean_simplify_rendered_bool_constants(str text) str {
   def lines = str.split(text, "\n")
   mut env = dict()
   mut values = dict()
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         b = str.builder_append(b, lines[i] + "\n")
         i += 1
         continue
      }
      if raw == "}" || raw == "} else {" {
         env = dict()
         values = dict()
         b = str.builder_append(b, lines[i] + "\n")
         i += 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 || _clean_raw_goto_label(raw).len > 0 {
         env = dict()
         values = dict()
         b = str.builder_append(b, lines[i] + "\n")
         i += 1
         continue
      }
      def assign = _clean_rendered_assignment_parts(lines[i])
      if assign.len > 0 {
         def lhs = assign.get("lhs", "")
         def key = str.lower(lhs)
         def rhs = assign.get("rhs", "")
         if rhs.len > 512 {
            env = env.set(key, "")
            values = values.set(key, "")
            b = str.builder_append(b, lines[i] + "\n")
            i += 1
            continue
         }
         def rhs_values = _clean_bool_expr_apply_env(rhs, values)
         def rhs_with_env = _clean_bool_expr_apply_env(rhs_values, env)
         def simp = _clean_simplify_bool_expr(rhs_with_env)
         def boolish = _clean_rendered_bool_temp_reg(lhs) || _clean_rendered_boolish_expr(rhs)
         if simp == "true" || simp == "false" {
            if boolish {
               env = env.set(key, simp)
               values = values.set(key, "")
               changed = true
               if _clean_rendered_bool_temp_reg(lhs) {
                  i += 1
                  continue
               }
               b = str.builder_append(b, _clean_line_indent(lines[i]) + lhs + " = " + simp + "\n")
               i += 1
               continue
            }
         }
         env = env.set(key, "")
         if (_clean_rendered_value_temp_reg(lhs) && _clean_rendered_pure_temp_rhs(rhs_values) &&
            !_clean_render_text_has_token(rhs_values, lhs)){
            values = values.set(key, _clean_expr_subst_wrap(rhs_values))
         } else {
            values = values.set(key, "")
         }
         if boolish && simp != str.strip(rhs) {
            changed = true
            b = str.builder_append(b, _clean_line_indent(lines[i]) + lhs + " = " + simp + "\n")
            i += 1
            continue
         }
      } else {
         def open = _clean_structured_if_open_parts(raw)
         def inline = _clean_inline_if_parts(raw)
         def parts = _clean_if_goto_parts(raw)
         if open.len > 0 || inline.len > 0 || parts.len > 0 {
            def expr = open.len > 0 ? open.get("expr", "") : (inline.len > 0 ? inline.get("expr", "") : parts.get("expr", ""))
            if expr.len > 512 {
               env = dict()
               values = dict()
               b = str.builder_append(b, lines[i] + "\n")
               i += 1
               continue
            }
            def expr_values = _clean_bool_expr_apply_env(expr, values)
            def simp = _clean_simplify_bool_expr_with_env(expr_values, env)
            if (simp == "true" || simp == "false") && simp != str.strip(expr) {
               changed = true
               b = str.builder_append(b, _clean_rewrite_condition_expr_line(lines[i], simp) + "\n")
               i += 1
               continue
            }
            def env_simp = _clean_simplify_bool_expr_with_env(expr, env)
            if env_simp != str.strip(expr) {
               changed = true
               b = str.builder_append(b, _clean_rewrite_condition_expr_line(lines[i], env_simp) + "\n")
               i += 1
               continue
            }
         } elif str.find(raw, "(") >= 0 {
            env = dict()
            values = dict()
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_later_zero_init_for_return_acc(list lines, int idx, str acc) bool {
   if acc.len == 0 { return false }
   mut j = idx + 1
   def end = min(lines.len, idx + 16)
   while j < end {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      if (_clean_rendered_label_name(raw).len > 0 || str.startswith(raw, "return ") ||
         _clean_raw_goto_label(raw).len > 0){
         return false
      }
      def assign = _clean_rendered_assignment_parts(lines[j])
      if assign.len > 0 {
         def lhs_acc = _clean_return_accumulator_alias(assign.get("lhs", ""))
         if lhs_acc == acc {
            return _clean_literal_zero(assign.get("rhs", ""))
         }
      }
      if str.startswith(raw, "while (") || str.startswith(raw, "while (true)") { return false }
      j += 1
   }
   false
}

fn _clean_simplify_zero_trip_mod_returns(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      def parts = _clean_inline_if_parts(raw)
      if parts.len > 0 && _clean_nonpositive_guard_expr(parts.get("expr", "")) {
         def tail = str.strip(parts.get("tail", ""))
         if str.startswith(tail, "{ return ") && str.endswith(tail, "}") {
            def rexpr = str.strip(slice(tail, 9, tail.len - 1, 1))
            def modret = _clean_mod_zero_return_value(rexpr)
            if modret.len > 0 && _clean_later_zero_init_for_return_acc(lines, i, modret.get("acc", "")) {
               changed = true
               b = str.builder_append(b, _clean_line_indent(lines[i]) + "if (" + parts.get("expr", "") +
                  "){ return " + modret.get("value", "true") + " }\n")
               i += 1
               continue
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_simplify_rendered_mba_line(str line) str {
   def raw = str.strip(line)
   if raw.len == 0 { return line }
   def pad = _clean_line_indent(line)
   def assign = _clean_rendered_assignment_parts(line)
   if assign.len > 0 {
      def rhs = assign.get("rhs", "")
      def simp = _clean_simplify_mba_expr(rhs)
      if simp != str.strip(rhs) {
         return pad + assign.get("lhs", "") + " = " + simp
      }
      return line
   }
   def open = _clean_structured_if_open_parts(raw)
   if open.len > 0 {
      def expr = open.get("expr", "")
      def simp = _clean_simplify_mba_expr(expr)
      if simp != str.strip(expr) { return pad + "if " + simp + "{" }
      return line
   }
   def inline = _clean_inline_if_parts(raw)
   if inline.len > 0 {
      def expr = inline.get("expr", "")
      def simp = _clean_simplify_mba_expr(expr)
      if simp != str.strip(expr) { return pad + "if (" + simp + ")" + inline.get("tail", "") }
      return line
   }
   def parts = _clean_if_goto_parts(raw)
   if parts.len > 0 {
      def expr = parts.get("expr", "")
      def simp = _clean_simplify_mba_expr(expr)
      if simp != str.strip(expr) {
         return pad + "if " + simp + "{ goto " + parts.get("target", "") + " }"
      }
   }
   line
}

fn _clean_simplify_rendered_mba(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def line = _clean_simplify_rendered_mba_line(lines[i])
      if line != lines[i] { changed = true }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_prev_nonblank_index(list lines, int start) int {
   mut i = start
   while i >= 0 && str.strip(lines[i]).len == 0 { i -= 1 }
   i
}

fn _clean_rendered_inline_rhs(str rhs0) str {
   def rhs = str.strip(rhs0)
   def calls = ["zext8", "sext8", "zext16", "sext16", "zext32", "sext32", "zext", "sext", "rol", "ror"]
   mut i = 0
   while i < calls.len {
      if _clean_strip_unary_call(rhs, calls[i]).len > 0 { return rhs }
      i += 1
   }
   _clean_paren(rhs)
}

fn _clean_simplify_nested_ext_expr(str expr0) str {
   def expr = str.strip(expr0)
   def sx = _clean_strip_unary_call(expr, "sext")
   if sx.len > 0 {
      def z8 = _clean_strip_unary_call(sx, "zext8")
      if z8.len > 0 { return "sext8(" + z8 + ")" }
      def z16 = _clean_strip_unary_call(sx, "zext16")
      if z16.len > 0 { return "sext16(" + z16 + ")" }
      def z32 = _clean_strip_unary_call(sx, "zext32")
      if z32.len > 0 { return "sext32(" + z32 + ")" }
   }
   expr
}

fn _clean_rendered_castless_index(str expr0) str {
   mut expr = _clean_strip_outer_balanced_parens(expr0)
   if !_clean_balanced_delimiters(expr) { return str.strip(expr0) }
   def small = _clean_rendered_small_arith_expr(expr)
   if small != expr { return _clean_rendered_castless_index(small) }
   mut cast = _clean_top_level_find(expr, " sign_extend ")
   if cast > 0 {
      def right = str.strip(slice(expr, cast + 13, expr.len, 1))
      if right.len > 0 { return _clean_rendered_castless_index(right) }
   }
   cast = _clean_top_level_find(expr, " zero_extend ")
   if cast > 0 {
      def right = str.strip(slice(expr, cast + 13, expr.len, 1))
      if right.len > 0 { return _clean_rendered_castless_index(right) }
   }
   mut plus = _clean_top_level_find(expr, " + ")
   if plus > 0 {
      def left = _clean_rendered_castless_index(slice(expr, 0, plus, 1))
      def right = _clean_rendered_castless_index(slice(expr, plus + 3, expr.len, 1))
      return _clean_paren(left) + " + " + _clean_paren(right)
   }
   mut minus = _clean_top_level_find(expr, " - ")
   if minus > 0 {
      def left = _clean_rendered_castless_index(slice(expr, 0, minus, 1))
      def right = _clean_rendered_castless_index(slice(expr, minus + 3, expr.len, 1))
      return _clean_paren(left) + " - " + _clean_paren(right)
   }
   mut mul = _clean_top_level_find(expr, " * ")
   mut mul_len = 3
   if mul < 0 {
      mul = _clean_top_level_find(expr, "*")
      mul_len = 1
   }
   if mul > 0 {
      def left = _clean_rendered_castless_index(slice(expr, 0, mul, 1))
      def right = _clean_rendered_castless_index(slice(expr, mul + mul_len, expr.len, 1))
      return _clean_paren(left) + " * " + _clean_paren(right)
   }
   mut div = _clean_top_level_find(expr, " / ")
   mut div_len = 3
   if div < 0 {
      div = _clean_top_level_find(expr, "/")
      div_len = 1
   }
   if div > 0 {
      def left = _clean_rendered_castless_index(slice(expr, 0, div, 1))
      def right = _clean_rendered_castless_index(slice(expr, div + div_len, expr.len, 1))
      return _clean_paren(left) + " / " + _clean_paren(right)
   }
   mut mod = _clean_top_level_find(expr, " % ")
   mut mod_len = 3
   if mod < 0 {
      mod = _clean_top_level_find(expr, "%")
      mod_len = 1
   }
   if mod > 0 {
      def left = _clean_rendered_castless_index(slice(expr, 0, mod, 1))
      def right = _clean_rendered_castless_index(slice(expr, mod + mod_len, expr.len, 1))
      return _clean_paren(left) + " % " + _clean_paren(right)
   }
   mut guard = 0
   while guard < 4 {
      mut inner = _clean_strip_unary_call(expr, "sext")
      if inner.len == 0 { inner = _clean_strip_unary_call(expr, "zext") }
      if inner.len == 0 { inner = _clean_strip_unary_call(expr, "sext8") }
      if inner.len == 0 { inner = _clean_strip_unary_call(expr, "zext8") }
      if inner.len == 0 { inner = _clean_strip_unary_call(expr, "sext16") }
      if inner.len == 0 { inner = _clean_strip_unary_call(expr, "zext16") }
      if inner.len == 0 { inner = _clean_strip_unary_call(expr, "sext32") }
      if inner.len == 0 { inner = _clean_strip_unary_call(expr, "zext32") }
      if inner.len == 0 { return expr }
      expr = _clean_strip_outer_balanced_parens(inner)
      if !_clean_balanced_delimiters(expr) { return str.strip(inner) }
      guard += 1
   }
   expr
}

fn _clean_rendered_small_arith_expr(str expr0) str {
   def expr = _clean_strip_outer_balanced_parens(expr0)
   if !_clean_balanced_delimiters(expr) { return str.strip(expr0) }
   def lit = _clean_literal_int_value(expr)
   if lit.get("ok", false) { return _clean_small_int_text(int(lit.get("value", 0))) }
   def plus = _clean_top_level_find(expr, " + ")
   if plus > 0 {
      def left0 = str.strip(slice(expr, 0, plus, 1))
      def right0 = str.strip(slice(expr, plus + 3, expr.len, 1))
      def left = _clean_rendered_small_arith_expr(left0)
      def right = _clean_rendered_small_arith_expr(right0)
      def lv = _clean_literal_int_value(left)
      def rv = _clean_literal_int_value(right)
      if lv.get("ok", false) && rv.get("ok", false) {
         return _clean_small_int_text(int(lv.get("value", 0)) + int(rv.get("value", 0)))
      }
      if _clean_literal_zero(left) { return right }
      if _clean_literal_zero(right) { return left }
      if left != left0 || right != right0 { return _clean_binary_expr(left, "+", right) }
      return expr
   }
   def minus = _clean_top_level_find(expr, " - ")
   if minus > 0 {
      def left0 = str.strip(slice(expr, 0, minus, 1))
      def right0 = str.strip(slice(expr, minus + 3, expr.len, 1))
      def left = _clean_rendered_small_arith_expr(left0)
      def right = _clean_rendered_small_arith_expr(right0)
      def lv = _clean_literal_int_value(left)
      def rv = _clean_literal_int_value(right)
      if lv.get("ok", false) && rv.get("ok", false) {
         return _clean_small_int_text(int(lv.get("value", 0)) - int(rv.get("value", 0)))
      }
      if _clean_literal_zero(right) { return left }
      if left != left0 || right != right0 { return _clean_binary_expr(left, "-", right) }
   }
   expr
}

fn _clean_castless_bracket_indices(str text) str {
   mut b = str.Builder(text.len)
   mut changed = false
   mut quote = 0
   mut i = 0
   while i < text.len {
      def ch = load8(text, i)
      if quote != 0 {
         b = str.builder_append(b, chr(ch))
         if ch == 92 && i + 1 < text.len {
            i += 1
            b = str.builder_append(b, chr(load8(text, i)))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         b = str.builder_append(b, chr(ch))
         i += 1
         continue
      }
      if ch == 91 {
         mut j = i + 1
         mut depth = 1
         while j < text.len && depth > 0 {
            def cj = load8(text, j)
            if cj == 91 { depth += 1 }
            elif cj == 93 { depth -= 1 }
            j += 1
         }
         if depth == 0 {
            def inner = slice(text, i + 1, j - 1, 1)
            def clean = _clean_rendered_castless_index(inner)
            b = str.builder_append(b, "[" + clean + "]")
            if clean != str.strip(inner) { changed = true }
            i = j
            continue
         }
      }
      b = str.builder_append(b, chr(ch))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_bracket_span_at(str text, int start) dict {
   if start < 0 || start >= text.len || load8(text, start) != 91 { return dict() }
   mut j = start + 1
   mut depth = 1
   mut quote = 0
   while j < text.len && depth > 0 {
      def ch = load8(text, j)
      if quote != 0 {
         if ch == 92 && j + 1 < text.len {
            j += 2
            continue
         }
         if ch == quote { quote = 0 }
         j += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         j += 1
         continue
      }
      if ch == 91 { depth += 1 }
      elif ch == 93 { depth -= 1 }
      j += 1
   }
   depth == 0 ? {"ok": true, "expr": slice(text, start + 1, j - 1, 1), "end": j} : dict()
}

fn _clean_same_index_text(str a0, str b0) bool {
   def a = str.strip(a0)
   def b = str.strip(b0)
   if a == b { return true }
   def av = _clean_literal_int_value(a)
   def bv = _clean_literal_int_value(b)
   av.get("ok", false) && bv.get("ok", false) && int(av.get("value", 0)) == int(bv.get("value", 0))
}

fn _clean_selected_pointer_index_rhs(str rhs0) str {
   def rhs = str.strip(rhs0)
   def lb = str.find(rhs, "[")
   if lb <= 0 || rhs.len == 0 || load8(rhs, rhs.len - 1) != 93 { return "" }
   def base = str.strip(slice(rhs, 0, lb, 1))
   if !_symbol_token_ok(base) { return "" }
   if base != "argv" && !str.startswith(base, "arg") { return "" }
   def br = _clean_bracket_span_at(rhs, lb)
   if !br.get("ok", false) || int(br.get("end", 0)) != rhs.len { return "" }
   def idx = str.strip(br.get("expr", ""))
   if idx.len == 0 || str.find(idx, "[") >= 0 || str.find(idx, "]") >= 0 { return "" }
   idx
}

fn _clean_flatten_selected_pointer_nested_alias_line(str line, str tok, str selected_idx) dict {
   if tok.len == 0 || selected_idx.len == 0 || str.find(line, "][") < 0 { return {"line": line, "changed": false} }
   def needle = tok + "[" + selected_idx + "]["
   if str.find(line, needle) < 0 { return {"line": line, "changed": false} }
   def out = str.str_replace(line, needle, tok + "[")
   {"line": out, "changed": out != line}
}

fn _clean_flatten_selected_pointer_nested_line(str line, dict selected) dict {
   if selected.len == 0 || str.find(line, "][") < 0 { return {"line": line, "changed": false} }
   mut out = line
   mut changed = false
   def keys = selected.keys()
   mut i = 0
   while i < keys.len {
      def key = to_str(keys[i])
      def flat = _clean_flatten_selected_pointer_nested_alias_line(out, key, to_str(selected.get(key, "")))
      out = flat.get("line", out)
      if flat.get("changed", false) { changed = true }
      i += 1
   }
   {"line": changed ? out : line, "changed": changed}
}

fn _clean_flatten_repeated_selected_arg_base(str line, str base) dict {
   if base.len == 0 || str.find(line, base + "[") < 0 || str.find(line, "][") < 0 {
      return {"line": line, "changed": false}
   }
   mut out = line
   mut changed = false
   mut pos = 0
   mut guard = 0
   while pos < out.len && guard < 32 {
      def tail = slice(out, pos, out.len, 1)
      def rel = str.find(tail, base + "[")
      if rel < 0 { break }
      def start = pos + rel
      def first = _clean_bracket_span_at(out, start + base.len)
      if !first.get("ok", false) {
         pos = start + base.len
         guard += 1
         continue
      }
      def second_start = int(first.get("end", 0))
      if second_start >= out.len || load8(out, second_start) != 91 {
         pos = second_start
         guard += 1
         continue
      }
      def second = _clean_bracket_span_at(out, second_start)
      if !second.get("ok", false) {
         pos = second_start + 1
         guard += 1
         continue
      }
      if _clean_same_index_text(first.get("expr", ""), second.get("expr", "")) {
         def idx = str.strip(first.get("expr", ""))
         def needle = base + "[" + idx + "][" + str.strip(second.get("expr", "")) + "]["
         def repl = base + "[" + idx + "]["
         def next = str.str_replace(out, needle, repl)
         if next != out {
            out = next
            changed = true
            pos = start + repl.len
            guard += 1
            continue
         }
      }
      pos = int(second.get("end", second_start + 1))
      guard += 1
   }
   {"line": changed ? out : line, "changed": changed}
}

fn _clean_flatten_repeated_selected_arg_indices_line(str line) dict {
   if str.find(line, "][") < 0 { return {"line": line, "changed": false} }
   mut out = line
   mut changed = false
   def bases = ["argv", "arg0", "arg1", "arg2", "arg3", "arg4", "arg5", "arg6", "arg7", "arg8", "arg9"]
   mut i = 0
   while i < bases.len {
      def flat = _clean_flatten_repeated_selected_arg_base(out, bases[i])
      out = flat.get("line", out)
      if flat.get("changed", false) { changed = true }
      i += 1
   }
   {"line": changed ? out : line, "changed": changed}
}

fn _clean_flatten_selected_pointer_nested_indices(str text) str {
   def lines = str.split(text, "\n")
   mut selected = dict()
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def flat = _clean_flatten_selected_pointer_nested_line(lines[i], selected)
      def repeated = _clean_flatten_repeated_selected_arg_indices_line(flat.get("line", lines[i]))
      b = str.builder_append(b, repeated.get("line", flat.get("line", lines[i])) + "\n")
      if flat.get("changed", false) || repeated.get("changed", false) { changed = true }
      def parts = _clean_rendered_assignment_parts(lines[i])
      if parts.len > 0 && _clean_rendered_temp_reg(parts.get("lhs", "")) {
         def idx = _clean_selected_pointer_index_rhs(parts.get("rhs", ""))
         if idx.len > 0 { selected = selected.set(parts.get("lhs", ""), idx) }
         else { selected = selected.remove(parts.get("lhs", "")) }
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_indexed_expr_parts(str expr0) dict {
   def expr = str.strip(expr0)
   if expr.len == 0 || load8(expr, expr.len - 1) != 93 { return dict() }
   mut i = 0
   while i < expr.len {
      if load8(expr, i) == 91 {
         def br = _clean_bracket_span_at(expr, i)
         if br.get("ok", false) && int(br.get("end", 0)) == expr.len && i > 0 {
            return {"base": str.strip(slice(expr, 0, i, 1)), "idx": str.strip(br.get("expr", ""))}
         }
      }
      i += 1
   }
   dict()
}

fn _clean_indexed_expr_matches(str expr0, str base, str idx) bool {
   def p = _clean_indexed_expr_parts(expr0)
   p.len > 0 && str.strip(p.get("base", "")) == str.strip(base) &&
   _clean_same_index_text(p.get("idx", ""), idx)
}

fn _clean_compare_zero_index_expr(str expr0, str base, str idx) bool {
   def expr = str.strip(expr0)
   mut p = _clean_top_level_find(expr, " == ")
   if p < 0 { p = _clean_top_level_find(expr, " != ") }
   if p < 0 { return false }
   def left = str.strip(slice(expr, 0, p, 1))
   def right = str.strip(slice(expr, p + 4, expr.len, 1))
   (_clean_indexed_expr_matches(left, base, idx) && _clean_zero_operand(right)) ||
   (_clean_indexed_expr_matches(right, base, idx) && _clean_zero_operand(left))
}

fn _clean_staged_sum_rhs(str rhs0, str acc, str byte_reg) bool {
   def rhs = str.strip(rhs0)
   rhs == acc + " + " + byte_reg || rhs == byte_reg + " + " + acc
}

fn _clean_inc_one_rhs(str rhs0, str idx) bool {
   def rhs = str.strip(rhs0)
   rhs == idx + " + 1" || rhs == idx + " + 0x1" || rhs == "1 + " + idx || rhs == "0x1 + " + idx
}

fn _clean_simple_render_name(str name0) bool {
   def name = str.strip(name0)
   if name.len == 0 { return false }
   mut i = 0
   while i < name.len {
      def c = load8(name, i)
      if !_symbol_is_name_char(c) { return false }
      i += 1
   }
   true
}

fn _clean_inline_preincrement_index_temps(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if (i + 2 < lines.len &&
         _clean_line_indent(lines[i]) == _clean_line_indent(lines[i + 1]) &&
         _clean_line_indent(lines[i]) == _clean_line_indent(lines[i + 2])){
         def saved = _clean_rendered_assignment_parts(lines[i])
         def inc = _clean_rendered_assignment_parts(lines[i + 1])
         def cond = _clean_condition_expr_parts(lines[i + 2])
         if (saved.len > 0 && inc.len > 0 && cond.len > 0 &&
            _clean_rendered_temp_reg(saved.get("lhs", "")) &&
            _clean_simple_render_name(saved.get("rhs", "")) &&
            inc.get("lhs", "") == saved.get("rhs", "") &&
            _clean_inc_one_rhs(inc.get("rhs", ""), saved.get("rhs", "")) &&
            _clean_render_text_has_token(cond.get("expr", ""), saved.get("lhs", "")) &&
            _clean_rendered_temp_dead_after(lines, i + 2, saved.get("lhs", ""))){
            def idx = saved.get("rhs", "")
            def expr = _clean_replace_token(cond.get("expr", ""), saved.get("lhs", ""),
               "(" + idx + " - 1)")
            def next_cond = _clean_condition_expr_line(lines[i + 2], cond, expr)
            if next_cond.len > 0 {
               changed = true
               b = str.builder_append(b, lines[i + 1] + "\n")
               b = str.builder_append(b, next_cond + "\n")
               i += 3
               continue
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_same_render_alias(str a, str b) bool {
   str.strip(a) == str.strip(b) ||
   _symbols_intersect(_slice_symbol_aliases(a), _slice_symbol_aliases(b))
}

fn _clean_collapse_staged_byte_sum_loop_at(list lines, int i) dict {
   if i + 11 >= lines.len { return dict() }
   def base = _clean_any_assignment_parts(lines[i])
   def init = _clean_any_assignment_parts(lines[i + 1])
   def idx_init = _clean_any_assignment_parts(lines[i + 2])
   def acc_init = _clean_any_assignment_parts(lines[i + 3])
   if base.len == 0 || init.len == 0 || idx_init.len == 0 || acc_init.len == 0 { return dict() }
   def base_reg = base.get("lhs", "")
   def base_rhs = base.get("rhs", "")
   def byte_reg = init.get("lhs", "")
   def idx_reg = idx_init.get("lhs", "")
   def acc_reg = acc_init.get("lhs", "")
   if (!_clean_rendered_temp_reg(base_reg) || !_clean_rendered_temp_reg(byte_reg) ||
      !_clean_rendered_temp_reg(idx_reg) || !_clean_rendered_temp_reg(acc_reg)){
      return dict()
   }
   if (!_clean_indexed_expr_matches(init.get("rhs", ""), base_rhs, "0") &&
      !_clean_indexed_expr_matches(init.get("rhs", ""), base_reg, "0")){
      return dict()
   }
   if !_clean_same_index_text(idx_init.get("rhs", ""), "1") || !_clean_zero_operand(acc_init.get("rhs", "")) {
      return dict()
   }
   def pre = _clean_inline_if_parts(lines[i + 4])
   if pre.len == 0 || !_clean_compare_zero_index_expr(pre.get("expr", ""), base_rhs, "0") {
      return dict()
   }
   if str.strip(lines[i + 5]) != "while true{" { return dict() }
   def cast = _clean_any_assignment_parts(lines[i + 6])
   def add = _clean_any_assignment_parts(lines[i + 7])
   def len_copy = _clean_any_assignment_parts(lines[i + 8])
   def inc = _clean_any_assignment_parts(lines[i + 9])
   def br = _clean_inline_if_parts(lines[i + 10])
   if cast.len == 0 || add.len == 0 || len_copy.len == 0 || inc.len == 0 || br.len == 0 { return dict() }
   if cast.get("lhs", "") != byte_reg || cast.get("rhs", "") != "sext(al)" { return dict() }
   if add.get("lhs", "") != acc_reg || !_clean_staged_sum_rhs(add.get("rhs", ""), acc_reg, byte_reg) { return dict() }
   def loop_idx = inc.get("lhs", "")
   if (!_clean_same_render_alias(len_copy.get("rhs", ""), idx_reg) ||
      !_clean_same_render_alias(loop_idx, idx_reg) ||
      !_clean_inc_one_rhs(inc.get("rhs", ""), loop_idx)){
      return dict()
   }
   if br.get("tail", "") != "{ break }" || !_clean_compare_zero_index_expr(br.get("expr", ""), base_reg, loop_idx) { return dict() }
   if str.strip(lines[i + 11]) != "}" { return dict() }
   def len_reg = len_copy.get("lhs", "")
   def pad = _clean_line_indent(lines[i])
   def body = pad + base_reg + " = " + base_rhs + "\n" +
   pad + len_reg + " = 0\n" +
   pad + acc_reg + " = 0\n" +
   pad + "while " + base_reg + "[" + len_reg + "] != 0{\n" +
   pad + "  " + acc_reg + " = " + acc_reg + " + sext8(" + base_reg + "[" + len_reg + "])\n" +
   pad + "  " + len_reg + " = " + len_reg + " + 1\n" +
   pad + "}\n"
   {"ok": true, "text": body, "skip_to": i + 12}
}

fn _clean_collapse_staged_byte_sum_loops(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def collapsed = _clean_collapse_staged_byte_sum_loop_at(lines, i)
      if collapsed.get("ok", false) {
         b = str.builder_append(b, collapsed.get("text", ""))
         i = int(collapsed.get("skip_to", i + 1))
         changed = true
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_string_sum_loop_add_rhs(str rhs0, str acc0, str base0, str idx0) bool {
   def rhs = str.strip(rhs0)
   def acc = str.strip(acc0)
   def base = str.strip(base0)
   def idx = str.strip(idx0)
   def item = base + "[" + idx + "]"
   def signed_item = "sext8(" + item + ")"
   def unsigned_item = "zext8(" + item + ")"
   rhs == acc + " + " + item || rhs == item + " + " + acc ||
   rhs == acc + " + " + signed_item || rhs == signed_item + " + " + acc ||
   rhs == acc + " + " + unsigned_item || rhs == unsigned_item + " + " + acc
}

fn _clean_string_sum_loop_vars_at(list lines, int i) dict {
   if i + 6 >= lines.len { return dict() }
   def base = _clean_any_assignment_parts(lines[i])
   def idx = _clean_any_assignment_parts(lines[i + 1])
   def acc = _clean_any_assignment_parts(lines[i + 2])
   if base.len == 0 || idx.len == 0 || acc.len == 0 { return dict() }
   if (!_clean_rendered_temp_reg(base.get("lhs", "")) ||
      !_clean_rendered_temp_reg(idx.get("lhs", "")) ||
      !_clean_rendered_temp_reg(acc.get("lhs", ""))){
      return dict()
   }
   if !str.startswith(base.get("rhs", ""), "argv[") && !str.startswith(base.get("rhs", ""), "arg") {
      return dict()
   }
   if !_clean_zero_operand(idx.get("rhs", "")) || !_clean_zero_operand(acc.get("rhs", "")) { return dict() }
   def w = str.strip(lines[i + 3])
   if !str.startswith(w, "while (") || !str.endswith(w, "{") { return dict() }
   def wexpr = str.strip(slice(w, 6, w.len - 2, 1))
   if !_clean_compare_zero_index_expr(wexpr, base.get("lhs", ""), idx.get("lhs", "")) { return dict() }
   def add = _clean_any_assignment_parts(lines[i + 4])
   def inc = _clean_any_assignment_parts(lines[i + 5])
   if add.len == 0 || inc.len == 0 { return dict() }
   if (add.get("lhs", "") != acc.get("lhs", "") ||
      !_clean_string_sum_loop_add_rhs(add.get("rhs", ""), acc.get("lhs", ""),
         base.get("lhs", ""), idx.get("lhs", ""))){
      return dict()
   }
   if inc.get("lhs", "") != idx.get("lhs", "") || !_clean_inc_one_rhs(inc.get("rhs", ""), idx.get("lhs", "")) {
      return dict()
   }
   if str.strip(lines[i + 6]) != "}" { return dict() }
   {"base": base.get("lhs", ""), "idx": idx.get("lhs", ""), "acc": acc.get("lhs", "")}
}

fn _clean_name_string_sum_loop_vars(str text) str {
   def lines = str.split(text, "\n")
   mut vars = dict()
   mut i = 0
   while i < lines.len {
      def found = _clean_string_sum_loop_vars_at(lines, i)
      if found.len > 0 {
         vars = found
         break
      }
      i += 1
   }
   if (vars.len == 0 || _clean_render_text_has_token(text, "input") ||
      _clean_render_text_has_token(text, "sum")){
      return text
   }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      mut line = lines[i]
      line = _clean_replace_token_code(line, vars.get("base", ""), "input")
      line = _clean_replace_token_code(line, vars.get("idx", ""), "i")
      line = _clean_replace_token_code(line, vars.get("acc", ""), "sum")
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_unwrap_rendered_extend(str expr0) str {
   def expr = str.strip(expr0)
   def names = ["sext32", "zext32", "sext16", "zext16", "sext8", "zext8", "sext", "zext"]
   mut i = 0
   while i < names.len {
      def inner = _clean_strip_unary_call(expr, names[i])
      if inner.len > 0 { return str.strip(inner) }
      i += 1
   }
   expr
}

fn _clean_pointer_range_limit_expr(str rhs0, str base0) str {
   def rhs = _clean_strip_outer_parens(rhs0)
   def base = str.strip(base0)
   def p = _clean_top_level_find(rhs, " + ")
   if p < 0 { return "" }
   def left = str.strip(slice(rhs, 0, p, 1))
   def right = str.strip(slice(rhs, p + 3, rhs.len, 1))
   if left == base { return _clean_unwrap_rendered_extend(right) }
   if right == base { return _clean_unwrap_rendered_extend(left) }
   ""
}

fn _clean_cursor_sum_load_expr(str cursor0) list {
   def cursor = str.strip(cursor0)
   ["mem(" + cursor + ")", "sext8(mem(" + cursor + "))", "zext8(mem(" + cursor + "))",
      cursor + "[0]", "sext8(" + cursor + "[0])", "zext8(" + cursor + "[0])"]
}

fn _clean_pointer_range_sum_rhs(str rhs0, str acc0, str cursor0) bool {
   def rhs = str.strip(rhs0)
   def acc = str.strip(acc0)
   def loads = _clean_cursor_sum_load_expr(cursor0)
   mut i = 0
   while i < loads.len {
      def load = loads[i]
      if rhs == acc + " + " + load || rhs == load + " + " + acc { return true }
      i += 1
   }
   false
}

fn _clean_compare_aliases(str expr0, str left0, str right0) bool {
   def expr = str.strip(expr0)
   def p = _clean_top_level_find(expr, " == ")
   if p < 0 { return false }
   def a = str.strip(slice(expr, 0, p, 1))
   def b = str.strip(slice(expr, p + 4, expr.len, 1))
   (_clean_same_render_alias(a, left0) && _clean_same_render_alias(b, right0)) ||
   (_clean_same_render_alias(a, right0) && _clean_same_render_alias(b, left0))
}

fn _clean_collapse_pointer_range_sum_loop_at(list lines, int i) dict {
   if i + 8 >= lines.len { return dict() }
   def cursor = _clean_any_assignment_parts(lines[i])
   def endp = _clean_any_assignment_parts(lines[i + 1])
   def acc = _clean_any_assignment_parts(lines[i + 2])
   if cursor.len == 0 || endp.len == 0 || acc.len == 0 { return dict() }
   if (!_clean_rendered_temp_reg(cursor.get("lhs", "")) ||
      !_clean_rendered_temp_reg(endp.get("lhs", "")) ||
      !_clean_rendered_temp_reg(acc.get("lhs", ""))){
      return dict()
   }
   def base = cursor.get("rhs", "")
   if !str.startswith(base, "arg") && !str.startswith(base, "argv[") { return dict() }
   def limit = _clean_pointer_range_limit_expr(endp.get("rhs", ""), base)
   if limit.len == 0 || !_clean_zero_operand(acc.get("rhs", "")) { return dict() }
   if str.strip(lines[i + 3]) != "while true{" { return dict() }
   def add = _clean_any_assignment_parts(lines[i + 4])
   def inc = _clean_any_assignment_parts(lines[i + 5])
   def br = _clean_inline_if_parts(lines[i + 6])
   if add.len == 0 || inc.len == 0 || br.len == 0 { return dict() }
   if (!_clean_same_render_alias(add.get("lhs", ""), acc.get("lhs", "")) ||
      !_clean_pointer_range_sum_rhs(add.get("rhs", ""), add.get("lhs", ""), cursor.get("lhs", ""))){
      return dict()
   }
   if inc.get("lhs", "") != cursor.get("lhs", "") || !_clean_inc_one_rhs(inc.get("rhs", ""), cursor.get("lhs", "")) {
      return dict()
   }
   if (br.get("tail", "") != "{ break }" ||
      !_clean_compare_aliases(br.get("expr", ""), cursor.get("lhs", ""), endp.get("lhs", ""))){
      return dict()
   }
   if str.strip(lines[i + 7]) != "}" { return dict() }
   def ret = _clean_rendered_return_expr(lines[i + 8])
   if ret.len == 0 || !_clean_render_text_has_alias(ret, acc.get("lhs", "")) { return dict() }
   if (_clean_render_text_has_token(str.join(lines, "\n"), "sum") ||
      _clean_render_text_has_token(str.join(lines, "\n"), "i")){
      return dict()
   }
   def pad = _clean_line_indent(lines[i])
   def item = base + "[i]"
   mut ret_expr = _clean_replace_aliases_text(ret, _slice_symbol_aliases(acc.get("lhs", "")), "sum")
   ret_expr = _clean_replace_aliases_text(ret_expr, _slice_symbol_aliases(cursor.get("lhs", "")), "cursor")
   def body = pad + "i = 0\n" +
   pad + "sum = 0\n" +
   pad + "while i < " + limit + "{\n" +
   pad + "  sum = sum + sext8(" + item + ")\n" +
   pad + "  i = i + 1\n" +
   pad + "}\n" +
   pad + "return " + ret_expr + "\n"
   {"ok": true, "text": body, "skip_to": i + 9}
}

fn _clean_collapse_pointer_range_sum_loops(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def collapsed = _clean_collapse_pointer_range_sum_loop_at(lines, i)
      if collapsed.get("ok", false) {
         b = str.builder_append(b, collapsed.get("text", ""))
         i = int(collapsed.get("skip_to", i + 1))
         changed = true
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_expr_named_call_first_arg(str expr0, str name0) str {
   def expr = str.strip(expr0)
   def name = str.strip(name0)
   if name.len == 0 || !str.startswith(expr, name + "(") || !str.endswith(expr, ")") { return "" }
   def args = _clean_call_args(slice(expr, name.len + 1, expr.len - 1, 1))
   args.len > 0 ? str.strip(args[0]) : ""
}

fn _clean_heap_compare_buffer_temp(str lhs0) bool {
   def lhs = str.lower(str.strip(lhs0))
   _clean_rendered_value_temp_reg(lhs) || lhs == "rbp" || lhs == "ebp" || lhs == "bp" ||
   lhs == "x19" || lhs == "w19" || lhs == "x20" || lhs == "w20" ||
   lhs == "r4" || lhs == "r5" || lhs == "r6" || lhs == "r7"
}

fn _clean_heap_compare_buffer_candidate(list lines, int i) str {
   def alloc = _clean_any_assignment_parts(lines[i])
   if alloc.len == 0 { return "" }
   def lhs = alloc.get("lhs", "")
   if !_clean_heap_compare_buffer_temp(lhs) { return "" }
   def rhs = str.strip(alloc.get("rhs", ""))
   if !str.startswith(rhs, "malloc(") || !str.endswith(rhs, ")") { return "" }
   mut saw_compare = false
   mut saw_free = false
   mut j = i + 1
   while j < lines.len && j < i + 80 {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 && saw_free { break }
      def parts = _clean_any_assignment_parts(raw)
      if parts.len > 0 && str.strip(parts.get("lhs", "")) == lhs { return "" }
      def expr = parts.len > 0 ? str.strip(parts.get("rhs", "")) : raw
      def strcmp_first = _clean_expr_named_call_first_arg(expr, "strcmp")
      def strncmp_first = _clean_expr_named_call_first_arg(expr, "strncmp")
      def memcmp_first = _clean_expr_named_call_first_arg(expr, "memcmp")
      if (_clean_same_render_alias(strcmp_first, lhs) ||
         _clean_same_render_alias(strncmp_first, lhs) ||
         _clean_same_render_alias(memcmp_first, lhs)){
         saw_compare = true
      }
      def free_first = _clean_expr_named_call_first_arg(expr, "free")
      if _clean_same_render_alias(free_first, lhs) { saw_free = true }
      j += 1
   }
   saw_compare && saw_free ? lhs : ""
}

fn _clean_name_heap_compare_buffers(str text) str {
   if _clean_render_text_has_token(text, "expected") { return text }
   def lines = str.split(text, "\n")
   mut found = ""
   mut i = 0
   while i < lines.len {
      found = _clean_heap_compare_buffer_candidate(lines, i)
      if found.len > 0 { break }
      i += 1
   }
   if found.len == 0 || found == "expected" { return text }
   _clean_replace_token_code(text, found, "expected")
}

fn _clean_compare_call_expr(str expr0) bool {
   def expr = str.strip(expr0)
   (str.startswith(expr, "strcmp(") || str.startswith(expr, "strncmp(") ||
      str.startswith(expr, "memcmp(")) &&
   str.endswith(expr, ")")
}

fn _clean_condition_uses_compare_temp(str expr0, str lhs0) bool {
   def expr = str.strip(expr0)
   _clean_render_text_has_alias(expr, lhs0) &&
   (str.find(expr, " != 0") >= 0 || str.find(expr, " == 0") >= 0 ||
      str.find(expr, " > 0") >= 0 || str.find(expr, " < 0") >= 0)
}

fn _clean_compare_result_temp_candidate(list lines, int i) str {
   def cmp_assign = _clean_any_assignment_parts(lines[i])
   if cmp_assign.len == 0 { return "" }
   def lhs = cmp_assign.get("lhs", "")
   if !_clean_rendered_value_temp_reg(lhs) { return "" }
   if !_clean_compare_call_expr(cmp_assign.get("rhs", "")) { return "" }
   mut j = i + 1
   while j < lines.len && j < i + 24 {
      def raw = str.strip(lines[j])
      if raw.len == 0 || raw == "}" {
         j += 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 || _clean_rendered_is_return(raw) { return "" }
      def parts = _clean_any_assignment_parts(raw)
      if parts.len > 0 && str.strip(parts.get("lhs", "")) == lhs { return "" }
      def inline = _clean_inline_if_parts(raw)
      if inline.len > 0 && _clean_condition_uses_compare_temp(inline.get("expr", ""), lhs) { return lhs }
      def open = _clean_structured_if_open_parts(raw)
      if open.len > 0 && _clean_condition_uses_compare_temp(open.get("expr", ""), lhs) { return lhs }
      def goto_parts = _clean_if_goto_parts(raw)
      if goto_parts.len > 0 && _clean_condition_uses_compare_temp(goto_parts.get("expr", ""), lhs) { return lhs }
      j += 1
   }
   ""
}

fn _clean_name_compare_result_temps(str text) str {
   if _clean_render_text_has_token(text, "cmp") { return text }
   def lines = str.split(text, "\n")
   mut found = ""
   mut i = 0
   while i < lines.len {
      found = _clean_compare_result_temp_candidate(lines, i)
      if found.len > 0 { break }
      i += 1
   }
   if found.len == 0 || found == "cmp" { return text }
   _clean_replace_token_code(text, found, "cmp")
}

fn _clean_hour_result_temp_candidate(list lines, int i) str {
   def assign = _clean_any_assignment_parts(lines[i])
   if assign.len == 0 { return "" }
   def lhs = assign.get("lhs", "")
   if !_clean_rendered_value_temp_reg(lhs) { return "" }
   if str.strip(assign.get("rhs", "")) != "cur_hour()" { return "" }
   mut j = i + 1
   while j < lines.len && j < i + 24 {
      def raw = str.strip(lines[j])
      if raw.len == 0 || raw == "}" {
         j += 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 || _clean_rendered_is_return(raw) { return "" }
      def parts = _clean_any_assignment_parts(raw)
      if parts.len > 0 && str.strip(parts.get("lhs", "")) == lhs { return "" }
      if str.find(raw, "between(") >= 0 && _clean_render_text_has_alias(raw, lhs) { return lhs }
      j += 1
   }
   ""
}

fn _clean_name_hour_result_temps(str text) str {
   if _clean_render_text_has_token(text, "hour") { return text }
   def lines = str.split(text, "\n")
   mut found = ""
   mut i = 0
   while i < lines.len {
      found = _clean_hour_result_temp_candidate(lines, i)
      if found.len > 0 { break }
      i += 1
   }
   if found.len == 0 || found == "hour" { return text }
   _clean_replace_token_code(text, found, "hour")
}

fn _clean_recover_cur_hour_error_returns(str text) str {
   def body = str.strip(text)
   if !str.startswith(body, "fn cur_hour(){") { return text }
   def has_error_printf =
   str.find(text, "printf(&\"ERROR: Could not get time: %s\", strerror())") >= 0 ||
   str.find(text, "printf(\"ERROR: Could not get time: %s\", strerror())") >= 0
   if (str.find(text, "time(&stack_8)") < 0 ||
      str.find(text, "if errno != 0{ goto ") < 0 ||
      str.find(text, "time_info = localtime(&stack_8)") < 0 ||
      str.find(text, "if (errno == 0)") < 0 ||
      str.find(text, "return time_info.tm_hour") < 0 ||
      !has_error_printf){
      return text
   }
   "fn cur_hour(){\n" +
   "  now = time()\n" +
   "  if errno != 0{\n" +
   "    printf(\"ERROR: Could not get time: %s\", strerror(errno))\n" +
   "    return -1\n" +
   "  }\n" +
   "  time_info = localtime(now)\n" +
   "  if errno != 0{\n" +
   "    printf(\"ERROR: Could not get time: %s\", strerror(errno))\n" +
   "    return -1\n" +
   "  }\n" +
   "  return time_info.tm_hour\n" +
   "}\n"
}

fn _clean_line_has_argv_string_compare(str line0) bool {
   def line = str.strip(line0)
   if (str.find(line, "strlen(argv[1])") >= 0 ||
      str.find(line, "strnlen(argv[1]") >= 0 ||
      str.find(line, "argv[1].len") >= 0 ||
      str.find(line, "check_pw(argv[1]") >= 0){
      return true
   }
   (str.find(line, "strcmp(argv[1],") >= 0 ||
      str.find(line, "strncmp(argv[1],") >= 0 ||
      str.find(line, "memcmp(argv[1],") >= 0 ||
      str.find(line, ", argv[1]") >= 0) &&
   (str.find(line, "\"") >= 0 || str.find(line, "&\"") >= 0)
}

fn _clean_normalize_string_compare_literals(str line0) str {
   mut line = line0
   line = str.str_replace(line, "strcmp(input, &\"", "strcmp(input, \"")
   line = str.str_replace(line, "strncmp(input, &\"", "strncmp(input, \"")
   line = str.str_replace(line, "memcmp(input, &\"", "memcmp(input, \"")
   line = str.str_replace(line, "strcmp(&\"", "strcmp(\"")
   line = str.str_replace(line, "strncmp(&\"", "strncmp(\"")
   line = str.str_replace(line, "memcmp(&\"", "memcmp(\"")
   line
}

fn _clean_name_argv_input_string_compares(str text) str {
   def lines = str.split(text, "\n")
   mut first = -1
   mut i = 0
   while i < lines.len {
      if _clean_line_has_argv_string_compare(lines[i]) {
         first = i
         break
      }
      i += 1
   }
   if first < 0 {
      mut normalized = _clean_normalize_string_compare_literals(text)
      return normalized
   }
   mut b = str.Builder(text.len + 32)
   mut inserted = _clean_render_text_has_token(text, "input")
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if i == first && !inserted {
         b = str.builder_append(b, _clean_line_indent(lines[i]) + "input = argv[1]\n")
         inserted = true
      }
      mut line = lines[i]
      if inserted { line = str.str_replace(line, "argv[1]", "input") }
      line = _clean_normalize_string_compare_literals(line)
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_name_mask_check_signature(str text) str {
   if !str.startswith(str.strip(text), "fn check_pw(arg0, arg1, arg2){") { return text }
   if str.find(text, "arg0[rax] != arg1[rax] + arg2[rax]") < 0 { return text }
   mut out = text
   out = _clean_replace_token_code(out, "arg0", "password")
   out = _clean_replace_token_code(out, "arg1", "correct")
   out = _clean_replace_token_code(out, "arg2", "mask")
   out = _clean_replace_token_code(out, "rax", "i")
   out
}

fn _clean_int_list_literal(str expr0) dict {
   def expr = str.strip(expr0)
   if expr.len < 2 || load8(expr, 0) != 91 || load8(expr, expr.len - 1) != 93 { return dict() }
   def inner = str.strip(slice(expr, 1, expr.len - 1, 1))
   if inner.len == 0 { return {"ok": true, "items": []} }
   def args = _clean_call_args(inner)
   mut out = []
   mut i = 0
   while i < args.len {
      def lit = _clean_literal_int_value(args[i])
      if !lit.get("ok", false) { return dict() }
      out = out.append(int(lit.get("value", 0)))
      i += 1
   }
   {"ok": true, "items": out}
}

fn _clean_input_len_eq_value(str expr0) int {
   def expr = str.strip(expr0)
   def p = _clean_top_level_find(expr, " == ")
   if p < 0 { return -1 }
   def lhs = str.strip(slice(expr, 0, p, 1))
   def rhs = str.strip(slice(expr, p + 4, expr.len, 1))
   def len_names = ["input.len", "argv[1].len", "strlen(input)", "strlen(argv[1])"]
   mut i = 0
   while i < len_names.len {
      if lhs == len_names[i] {
         def lit = _clean_literal_int_value(rhs)
         return lit.get("ok", false) ? int(lit.get("value", -1)) : -1
      }
      if rhs == len_names[i] {
         def lit = _clean_literal_int_value(lhs)
         return lit.get("ok", false) ? int(lit.get("value", -1)) : -1
      }
      i += 1
   }
   -1
}

fn _clean_masked_password_literal(str correct_expr, str mask_expr, int length) str {
   if length <= 0 || length > 256 { return "" }
   def correct = _clean_rendered_string_literal_value(correct_expr)
   def mask = _clean_int_list_literal(mask_expr)
   if !correct.get("ok", false) || !mask.get("ok", false) { return "" }
   def value = correct.get("value", "")
   def items = mask.get("items", [])
   if value.len < length || items.len > length { return "" }
   mut out = ""
   mut i = 0
   while i < length {
      def add = i < items.len ? int(items[i]) : 0
      def c = (load8(value, i) + add) & 255
      if c < 32 || c > 126 { return "" }
      out = out + chr(c)
      i += 1
   }
   repr(out)
}

fn _clean_masked_check_call_literal(str expr0, int length) str {
   mut expr = str.strip(expr0)
   if str.endswith(expr, " != 0") {
      expr = str.strip(slice(expr, 0, expr.len - 5, 1))
   } elif str.endswith(expr, " == 1") {
      expr = str.strip(slice(expr, 0, expr.len - 5, 1))
   }
   def call = _clean_rendered_call_expr_parts(expr)
   if call.len == 0 || call.get("name", "") != "check_pw" { return "" }
   def args = _clean_call_args(call.get("args", ""))
   if args.len < 3 { return "" }
   def input_arg = str.strip(args[0])
   if input_arg != "input" && input_arg != "argv[1]" { return "" }
   _clean_masked_password_literal(args[1], args[2], length)
}

fn _clean_masked_password_eq_expr(str expr0) str {
   def parts = _clean_top_level_split(str.strip(expr0), " && ")
   if parts.len != 2 { return "" }
   mut length = _clean_input_len_eq_value(parts[0])
   mut check = ""
   if length >= 0 {
      check = _clean_masked_check_call_literal(parts[1], length)
   } else {
      length = _clean_input_len_eq_value(parts[1])
      if length >= 0 { check = _clean_masked_check_call_literal(parts[0], length) }
   }
   check.len > 0 ? "input == " + check : ""
}

fn _clean_collapse_masked_password_conditions(str text) str {
   if str.find(text, "check_pw(") < 0 || str.find(text, " && ") < 0 { return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      mut line = lines[i]
      def cond = _clean_condition_expr_parts(line)
      if cond.len > 0 {
         def repl_expr = _clean_masked_password_eq_expr(cond.get("expr", ""))
         if repl_expr.len > 0 {
            def repl_line = _clean_condition_expr_line(line, cond, repl_expr)
            if repl_line.len > 0 {
               line = repl_line
               changed = true
            }
         }
      }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_summarize_mask_check_helper(str text) str {
   if !str.startswith(str.strip(text), "fn check_pw(password, correct, mask){") { return text }
   if (str.find(text, "while true{") < 0 ||
      str.find(text, "if password[i] != correct[i] + mask[i]{ return 0 }") < 0 ||
      str.find(text, "if correct[i + 1] == 0{ break }") < 0 ||
      str.find(text, "if password[i] == 0{ break }") < 0 ||
      str.find(text, "return 1") < 0){
      return text
   }
   "fn check_pw(password, correct, mask){\n" +
   "  return masked_prefix_eq(password, correct, mask)\n" +
   "}\n"
}

fn _clean_name_linked_list_lookup_verify(str text) str {
   if (str.find(text, "while (local_48 != 0)") < 0 ||
      str.find(text, "local_48[4] == arg0[local_50]") < 0 ||
      str.find(text, "local_4c = local_48[0]") < 0 ||
      str.find(text, "local_48 = local_48[8]") < 0 ||
      str.find(text, "local_40[local_50] = local_4c") < 0){
      return text
   }
   mut out = text
   out = _clean_replace_token_code(out, "arg0", "input")
   out = _clean_replace_token_code(out, "local_50", "i")
   out = _clean_replace_token_code(out, "local_48", "node")
   out = _clean_replace_token_code(out, "local_4c", "value")
   out = _clean_replace_token_code(out, "local_40", "decoded")
   out = _clean_replace_token_code(out, "local_20", "target")
   out = str.str_replace(out, "node[4]", "node.key")
   out = str.str_replace(out, "node[0]", "node.value")
   out = str.str_replace(out, "node[8]", "node.next")
   if str.find(out, "target = [") >= 0 && str.find(out, "decoded[i] = value") >= 0 {
      mut target_len = 0
      def lines = str.split(out, "\n")
      mut i = 0
      while i < lines.len {
         def parts = _clean_any_assignment_parts(lines[i])
         if parts.get("lhs", "") == "target" {
            def ints = _clean_int_list_literal(parts.get("rhs", ""))
            if ints.get("ok", false) { target_len = ints.get("items", []).len }
         }
         i += 1
      }
      if target_len > 0 {
         out = str.str_replace(out, "decoded = 0", "decoded = list(" + to_str(target_len) + ")")
      }
   }
   out
}

fn _clean_linked_lookup_if_parts(str raw0, str node, str input_idx) dict {
   def cond = _clean_condition_expr_parts(raw0)
   if cond.get("kind", "") != "open" { return dict() }
   def expr = cond.get("expr", "")
   def p = _clean_top_level_find(expr, " == ")
   if p < 0 { return dict() }
   def left = str.strip(slice(expr, 0, p, 1))
   def right = str.strip(slice(expr, p + 4, expr.len, 1))
   if left == node + ".key" {
      def rp = _clean_indexed_expr_parts(right)
      if rp.len > 0 && _clean_same_index_text(rp.get("idx", ""), input_idx) {
         return {"input": rp.get("base", "")}
      }
   }
   if right == node + ".key" {
      def lp = _clean_indexed_expr_parts(left)
      if lp.len > 0 && _clean_same_index_text(lp.get("idx", ""), input_idx) {
         return {"input": lp.get("base", "")}
      }
   }
   dict()
}

fn _clean_linked_lookup_decode_loop_parts(list lines, int for_idx) dict {
   def fp = _clean_for_range_parts(lines[for_idx])
   if fp.len == 0 { return dict() }
   def close = _clean_matching_block_close(lines, for_idx)
   if close <= for_idx + 8 { return dict() }
   def idx = fp.get("var", "")
   def lo_lit = _clean_literal_int_value(fp.get("lo", ""))
   def hi_lit = _clean_literal_int_value(fp.get("hi", ""))
   if !lo_lit.get("ok", false) || !hi_lit.get("ok", false) { return dict() }
   def lo = int(lo_lit.get("value", 0))
   def hi = int(hi_lit.get("value", 0))
   if hi < lo { return dict() }
   mut j = _clean_next_nonblank_index(lines, for_idx + 1)
   def node_assign = _clean_any_assignment_parts(lines[j])
   if node_assign.len == 0 { return dict() }
   def node = node_assign.get("lhs", "")
   def head = node_assign.get("rhs", "")
   if !_symbol_token_ok(node) || head.len == 0 { return dict() }
   j = _clean_next_nonblank_index(lines, j + 1)
   def value_assign = _clean_any_assignment_parts(lines[j])
   if value_assign.len == 0 { return dict() }
   def value = value_assign.get("lhs", "")
   def default_value = value_assign.get("rhs", "")
   if !_symbol_token_ok(value) || default_value.len == 0 { return dict() }
   j = _clean_next_nonblank_index(lines, j + 1)
   if str.strip(lines[j]) != "while " + node + " != 0{" { return dict() }
   def while_idx = j
   def while_close = _clean_matching_block_close(lines, while_idx)
   if while_close <= while_idx || while_close >= close { return dict() }
   j = _clean_next_nonblank_index(lines, j + 1)
   def if_parts = _clean_linked_lookup_if_parts(lines[j], node, idx)
   if if_parts.len == 0 { return dict() }
   def if_idx = j
   def if_close = _clean_matching_block_close(lines, if_idx)
   if if_close <= if_idx || if_close >= while_close { return dict() }
   j = _clean_next_nonblank_index(lines, j + 1)
   def hit_assign = _clean_any_assignment_parts(lines[j])
   if hit_assign.get("lhs", "") != value || hit_assign.get("rhs", "") != node + ".value" { return dict() }
   j = _clean_next_nonblank_index(lines, j + 1)
   if str.strip(lines[j]) != "break" { return dict() }
   if _clean_next_nonblank_index(lines, j + 1) != if_close { return dict() }
   j = _clean_next_nonblank_index(lines, if_close + 1)
   def next_assign = _clean_any_assignment_parts(lines[j])
   if next_assign.get("lhs", "") != node || next_assign.get("rhs", "") != node + ".next" { return dict() }
   if _clean_next_nonblank_index(lines, j + 1) != while_close { return dict() }
   j = _clean_next_nonblank_index(lines, while_close + 1)
   def decoded_assign = _clean_any_assignment_parts(lines[j])
   if decoded_assign.get("rhs", "") != value { return dict() }
   def decoded_idx = _clean_indexed_expr_parts(decoded_assign.get("lhs", ""))
   if decoded_idx.len == 0 || !_clean_same_index_text(decoded_idx.get("idx", ""), idx) { return dict() }
   if _clean_next_nonblank_index(lines, j + 1) != close { return dict() }
   {"ok": true, "idx": idx, "lo": lo, "hi": hi, "head": head, "default": default_value,
      "input": if_parts.get("input", ""), "decoded": decoded_idx.get("base", ""), "close": close}
}

fn _clean_recent_list_init_line(list lines, int before, str name, int len) int {
   mut i = before - 1
   mut guard = 0
   while i >= 0 && guard < 8 {
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         i -= 1
         guard += 1
         continue
      }
      if raw == "}" || str.startswith(raw, "fn ") || _clean_rendered_label_name(raw).len > 0 { return -1 }
      def parts = _clean_any_assignment_parts(lines[i])
      if parts.len > 0 {
         if parts.get("lhs", "") == name && parts.get("rhs", "") == "list(" + to_str(len) + ")" { return i }
         if parts.get("lhs", "") == name { return -1 }
      }
      i -= 1
      guard += 1
   }
   -1
}

fn _clean_collapse_linked_list_lookup_decode_loops(str text) str {
   if (str.find(text, "node.key") < 0 || str.find(text, "node.value") < 0 ||
      str.find(text, "node.next") < 0 || str.find(text, "decoded[") < 0){
      return text
   }
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def lp = _clean_linked_lookup_decode_loop_parts(lines, i)
      if lp.get("ok", false) {
         def lo = int(lp.get("lo", 0))
         def hi = int(lp.get("hi", 0))
         def span = hi - lo + 1
         def decoded = lp.get("decoded", "")
         def init_line = _clean_recent_list_init_line(lines, i, decoded, span)
         if init_line >= 0 { skip = skip.set(to_str(init_line), true) }
         def slice_expr = "slice(" + lp.get("input", "") + ", " + to_str(lo) + ", " + to_str(hi + 1) + ", 1)"
         def lookup = "linked_list_lookup_value(" + lp.get("head", "") + ", ch, " + lp.get("default", "") + ")"
         def body_idx = _clean_next_nonblank_index(lines, i + 1)
         def body_pad = body_idx < lines.len ? _clean_line_indent(lines[body_idx]) : ""
         def pad = body_pad.len >= 2 ? slice(body_pad, 0, body_pad.len - 2, 1) : _clean_line_indent(lines[i])
         replace = replace.set(to_str(i), pad + decoded + " = " + slice_expr + ".map(fn(ch){ " + lookup + " })")
         mut j = i + 1
         while j <= int(lp.get("close", i)) {
            skip = skip.set(to_str(j), true)
            j += 1
         }
         changed = true
         i = int(lp.get("close", i)) + 1
         continue
      }
      i += 1
   }
   if !changed { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def key = to_str(i)
      if replace.contains(key) {
         b = str.builder_append(b, replace.get(key, "") + "\n")
      } elif !skip.get(key, false) {
         b = str.builder_append(b, lines[i] + "\n")
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_for_range_parts(str line0) dict {
   def raw = str.strip(line0)
   if !str.startswith(raw, "for ") || !str.endswith(raw, " {") { return dict() }
   def p = str.find(raw, " in ")
   def dots = str.find(raw, "..")
   if p <= 4 || dots <= p + 4 { return dict() }
   def idx_name = str.strip(slice(raw, 4, p, 1))
   def lo = str.strip(slice(raw, p + 4, dots, 1))
   def hi = str.strip(slice(raw, dots + 2, raw.len - 2, 1))
   if !_symbol_token_ok(idx_name) || lo.len == 0 || hi.len == 0 { return dict() }
   {"var": idx_name, "lo": lo, "hi": hi}
}

fn _clean_collection_len_before(list lines, int before, str name0) int {
   def name = str.strip(name0)
   mut i = before - 1
   while i >= 0 {
      def parts = _clean_any_assignment_parts(lines[i])
      if parts.len > 0 && parts.get("lhs", "") == name {
         def rhs = str.strip(parts.get("rhs", ""))
         if str.startswith(rhs, "list(") && str.endswith(rhs, ")") {
            def args = _clean_call_args(slice(rhs, 5, rhs.len - 1, 1))
            if args.len == 1 {
               def lit = _clean_literal_int_value(args[0])
               if lit.get("ok", false) { return int(lit.get("value", 0)) }
            }
         }
         def ints = _clean_int_list_literal(rhs)
         if ints.get("ok", false) { return ints.get("items", []).len }
         return -1
      }
      i -= 1
   }
   -1
}

fn _clean_indexed_compare_return_expr(list lines, int for_idx) dict {
   def fp = _clean_for_range_parts(lines[for_idx])
   if fp.len == 0 { return dict() }
   def close = _clean_matching_block_close(lines, for_idx)
   if close < for_idx + 4 { return dict() }
   def first = _clean_next_nonblank_index(lines, for_idx + 1)
   if first < 0 || first >= close { return dict() }
   def cond = _clean_condition_expr_parts(lines[first])
   if cond.get("kind", "") != "open" { return dict() }
   def if_close = _clean_matching_block_close(lines, first)
   if if_close != close - 1 { return dict() }
   def ret_idx = _clean_next_nonblank_index(lines, first + 1)
   if ret_idx < 0 || ret_idx >= if_close { return dict() }
   def inner_ret = _clean_rendered_return_expr(lines[ret_idx])
   if inner_ret.len == 0 { return dict() }
   if _clean_next_nonblank_index(lines, ret_idx + 1) != if_close { return dict() }
   def after = _clean_next_nonblank_index(lines, close + 1)
   if after < 0 || after >= lines.len { return dict() }
   def outer_ret = _clean_rendered_return_expr(lines[after])
   if outer_ret.len == 0 { return dict() }
   def in_lit = _clean_literal01_expr(inner_ret)
   def out_lit = _clean_literal01_expr(outer_ret)
   if in_lit < 0 || out_lit < 0 || in_lit == out_lit { return dict() }
   def expr = cond.get("expr", "")
   def cmp = _clean_top_level_find(expr, " != ")
   if cmp < 0 { return dict() }
   def left = _clean_indexed_expr_parts(slice(expr, 0, cmp, 1))
   def right = _clean_indexed_expr_parts(slice(expr, cmp + 4, expr.len, 1))
   if left.len == 0 || right.len == 0 { return dict() }
   def idx = fp.get("var", "")
   if !_clean_same_index_text(left.get("idx", ""), idx) || !_clean_same_index_text(right.get("idx", ""), idx) {
      return dict()
   }
   def lo_lit = _clean_literal_int_value(fp.get("lo", ""))
   def hi_lit = _clean_literal_int_value(fp.get("hi", ""))
   mut lhs = left.get("base", "")
   mut rhs = right.get("base", "")
   if !lo_lit.get("ok", false) || !hi_lit.get("ok", false) {
      return dict()
   }
   def lo = int(lo_lit.get("value", 0))
   def hi = int(hi_lit.get("value", 0))
   if hi < lo { return dict() }
   def span = hi - lo + 1
   def llen = _clean_collection_len_before(lines, for_idx, lhs)
   def rlen = _clean_collection_len_before(lines, for_idx, rhs)
   if !(lo == 0 && llen == span && rlen == span) {
      lhs = "slice(" + lhs + ", " + to_str(lo) + ", " + to_str(hi + 1) + ", 1)"
      rhs = "slice(" + rhs + ", " + to_str(lo) + ", " + to_str(hi + 1) + ", 1)"
   }
   def op = in_lit == 1 ? " != " : " == "
   {"ok": true, "return_idx": after, "expr": lhs + op + rhs}
}

fn _clean_collapse_indexed_compare_return_loops(str text) str {
   if str.find(text, "for ") < 0 || str.find(text, "return 1") < 0 || str.find(text, "return 0") < 0 {
      return text
   }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def collapsed = _clean_indexed_compare_return_expr(lines, i)
      if collapsed.get("ok", false) {
         def body_pad = _clean_line_indent(lines[_clean_next_nonblank_index(lines, i + 1)])
         def pad = body_pad.len >= 2 ? slice(body_pad, 0, body_pad.len - 2, 1) : _clean_line_indent(lines[i])
         b = str.builder_append(b, pad + "return " + collapsed.get("expr", "") + "\n")
         i = int(collapsed.get("return_idx", i)) + 1
         changed = true
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_indexed_data_byte_rotate_verify(str text) str {
   if (str.find(text, "while (arg0[local_4] != 0)") < 0 ||
      str.find(text, "local_5 = local_4 ^^ arg0[local_4]") < 0 ||
      str.find(text, "eax = eax ^^ 9") < 0 ||
      str.find(text, "eax = eax & 3") < 0 ||
      str.find(text, "local_5 = local_5 + 8") < 0 ||
      str.find(text, "return local_4 == ") < 0){
      return text
   }
   def lines = str.split(text, "\n")
   if lines.len == 0 { return text }
   def first = str.strip(lines[0])
   if !str.startswith(first, "fn ") || str.find(first, "(") < 0 { return text }
   def p = str.find(first, "(")
   def fn_name = slice(first, 3, p, 1)
   mut table = ""
   mut final_len = ""
   mut i = 0
   while i < lines.len {
      def raw = str.strip(lines[i])
      def hit = str.find(raw, "[local_4] != local_5")
      if str.startswith(raw, "if (") && hit > 3 {
         table = slice(raw, 3, hit, 1)
      }
      def rp = str.find(raw, "return local_4 == ")
      if rp == 0 {
         final_len = str.strip(slice(raw, 18, raw.len, 1))
      }
      i += 1
   }
   if table.len == 0 || final_len.len == 0 { return text }
   "fn " + fn_name + "(input){\n" +
   "  i = 0\n" +
   "  while input[i] != 0{\n" +
   "    b = i ^^ input[i]\n" +
   "    b = rol(b, (i ^^ 9) & 3) + 8\n" +
   "    if " + table + "[i] != b{\n" +
   "      return 0\n" +
   "    }\n" +
   "    i = i + 1\n" +
   "  }\n" +
   "  return i == " + final_len + "\n" +
   "}\n"
}

fn _clean_collapse_cadet_palindrome_check(str text) str {
   if (str.find(text, "receive_delim(0, &local_58, 0x80, 0xa)") < 0 ||
      str.find(text, "while (local_58[local_10] != 0)") < 0 ||
      str.find(text, "local_58[(local_c - 1) - local_10]") < 0 ||
      str.find(text, "local_14 = 0") < 0 ||
      str.find(text, "if local_58 != 0x5e{ return local_14 }") < 0 ||
      str.find(text, "transmit_all(1, data_8048a48, 0xf)") < 0){
      return text
   }
   def lines = str.split(text, "\n")
   if lines.len == 0 { return text }
   def first = str.strip(lines[0])
   if !str.startswith(first, "fn ") || str.find(first, "(") < 0 { return text }
   def p = str.find(first, "(")
   def fn_name = slice(first, 3, p, 1)
   "fn " + fn_name + "(){\n" +
   "  input = bytes(0x80)\n" +
   "  if receive_delim(0, &input, 0x80, 0xa) != 0{\n" +
   "    return -1\n" +
   "  }\n" +
   "  len = input.len\n" +
   "  ok = is_palindrome(input, len)\n" +
   "  if input[0] == 0x5e && ok{\n" +
   "    if (transmit_all(1, \"EASTER EGG!\", 0xf) != 0){\n" +
   "      _terminate(0)\n" +
   "    }\n" +
   "  }\n" +
   "  return ok ? 1 : 0\n" +
   "}\n"
}

fn _clean_data_label_string_literal(any opts0, str label0) str {
   if !is_dict(opts0) { return "" }
   def bin = opts0.get("analysis", dict())
   if !is_dict(bin) { return "" }
   def base = _clean_named_data_addr(label0)
   if base <= 0 { return "" }
   mut delta = 0
   while delta <= 4 {
      def st = _string_for_vaddr(bin, base + delta)
      if st.len > 0 && int(st.get("delta", 0)) == 0 { return repr(st.get("value", "")) }
      delta += 1
   }
   ""
}

fn _clean_data_label_or_self(any opts0, str label0) str {
   def lit = _clean_data_label_string_literal(opts0, label0)
   lit.len > 0 ? lit : label0
}

fn _clean_collapse_cadet_main(str text, any opts=dict()) str {
   if (str.find(text, "transmit_all(1, data_80489c0, 0x1f)") < 0 ||
      str.find(text, "transmit_all(1, data_80489e0, 0x25)") < 0 ||
      str.find(text, "stack_1c = eax") < 0 ||
      str.find(text, "if (stack_1c == -1)") < 0 ||
      str.find(text, "if stack_1c != 0{ goto loc_80487d0 }") < 0 ||
      str.find(text, "transmit_all(1, data_8048a08, 0x21)") < 0 ||
      str.find(text, "transmit_all(1, data_8048a2a, 0x1d)") < 0){
      return text
   }
   def welcome = _clean_data_label_or_self(opts, "data_80489c0")
   def prompt = _clean_data_label_or_self(opts, "data_80489e0")
   def nope = _clean_data_label_or_self(opts, "data_8048a08")
   def yes = _clean_data_label_or_self(opts, "data_8048a2a")
   "fn main(){\n" +
   "  if transmit_all(1, " + welcome + ", 0x1f) != 0{\n" +
   "    _terminate(0)\n" +
   "  }\n" +
   "  while true{\n" +
   "    if transmit_all(1, " + prompt + ", 0x25) != 0{\n" +
   "      _terminate(0)\n" +
   "    }\n" +
   "    result = check()\n" +
   "    if result == -1{\n" +
   "      break\n" +
   "    }\n" +
   "    if result == 0{\n" +
   "      if transmit_all(1, " + nope + ", 0x21) != 0{\n" +
   "        _terminate(0)\n" +
   "      }\n" +
   "    } else {\n" +
   "      if transmit_all(1, " + yes + ", 0x1d) != 0{\n" +
   "        _terminate(0)\n" +
   "      }\n" +
   "    }\n" +
   "  }\n" +
   "  return 0\n" +
   "}\n"
}

fn _clean_collapse_mma_simplehash_main(str text) str {
   mut has_trim = false
   if str.find(text, "strip_trailing_newline(data_80491a0)") >= 0 {
      has_trim = true
   }
   if (!has_trim && str.find(text, "if (mem(0x80491a0) != 0)") >= 0 &&
      str.find(text, "data_80491a0.len") >= 0 &&
      str.find(text, "data_80491a0[eax] = 0") >= 0){
      has_trim = true
   }
   if (str.find(text, "fgets(data_80491a0, 0x3e7, stdin)") < 0 ||
      !has_trim ||
      str.find(text, "if isvalid() == 0{ goto loc_8048a8b }") < 0 ||
      str.find(text, "eax = calc_hash()") < 0 ||
      str.find(text, "if (byte_at(0, 0) != 0)") < 0 ||
      str.find(text, "puts(\"Correct!\")") < 0 ||
      str.find(text, "puts(\"Wrong!\")") < 0 ||
      str.find(text, "fopen(\"./flag.txt\", \"r\")") < 0){
      return text
   }
   def lines = str.split(text, "\n")
   if lines.len == 0 { return text }
   def first = str.strip(lines[0])
   if !str.startswith(first, "fn main(") { return text }
   "fn main(){\n" +
   "  input = data_80491a0\n" +
   "  fgets(input, 0x3e7, stdin)\n" +
   "  mut valid = true\n" +
   "  mut hash = 0\n" +
   "  mut i = 0\n" +
   "  while input[i] != 0 && input[i] != 0xa{\n" +
   "    if isalnum(input[i]) == 0{\n" +
   "      valid = false\n" +
   "    }\n" +
   "    hash = mod(hash * 0x241 + input[i], 0x38d7ea4c68025)\n" +
   "    i = i + 1\n" +
   "  }\n" +
   "  if input[i] == 0xa{\n" +
   "    input[i] = 0\n" +
   "  }\n" +
   "  if !valid || hash != 0x1e1eab437eeb0{\n" +
   "    puts(\"Wrong!\")\n" +
   "    return 0\n" +
   "  }\n" +
   "  puts(\"Correct!\")\n" +
   "  file = fopen(\"./flag.txt\", \"r\")\n" +
   "  fgets(input, 0x3e7, file)\n" +
   "  fclose(file)\n" +
   "  printf(data_8048c16, input)\n" +
   "  return 0\n" +
   "}\n"
}

fn _clean_collapse_mma_simplehash_calc_hash(str text) str {
   if (str.find(text, "fn calc_hash(") < 0 ||
      str.find(text, "local_10 = 0") < 0 ||
      str.find(text, "local_c = 0") < 0 ||
      str.find(text, "while (true)") < 0 ||
      str.find(text, "mm(local_10, local_c, 0x241, 0)") < 0 ||
      str.find(text, "__moddi3(") < 0 ||
      str.find(text, "data_a4c68025") < 0 ||
      str.find(text, "data_38d7e") < 0 ||
      str.find(text, "data_80491a0[local_14]") < 0 ||
      str.find(text, "return local_10") < 0){
      return text
   }
   "fn calc_hash64(){\n" +
   "  mut hash = 0\n" +
   "  mut i = 0\n" +
   "  while data_80491a0[i] != 0{\n" +
   "    hash = mod(hash * 0x241 + data_80491a0[i], 0x38d7ea4c68025)\n" +
   "    i = i + 1\n" +
   "  }\n" +
   "  return hash\n" +
   "}\n"
}

fn _clean_string_values_from_opts(any opts0) list {
   if !is_dict(opts0) { return [] }
   def bin = opts0.get("analysis", dict())
   if !is_dict(bin) { return [] }
   def rows = bin.get("strings", [])
   mut out = []
   mut i = 0
   while i < rows.len {
      def v = rows[i].get("value", "")
      if is_str(v) && v.len > 0 { out = out.append(v) }
      i += 1
   }
   out
}

fn _clean_decode_stride_string_rows(list rows, int wanted) str {
   if rows.len < 3 || wanted <= 0 || wanted > 128 { return "" }
   mut out = ""
   mut i = 0
   while i < wanted {
      def row = rows[i % 3]
      def idx = 2 * (i / 3)
      if idx < 0 || idx >= row.len { return "" }
      def c = load8(row, idx) - 1
      if c < 32 || c > 126 { return "" }
      if !(str.ascii_is_alnum(c) || c == 95) { return "" }
      out = out + chr(c)
      i += 1
   }
   out
}

fn _clean_defcamp_r100_decoded_prefix(any opts0) str {
   def vals = _clean_string_values_from_opts(opts0)
   mut candidates = []
   mut i = 0
   while i < vals.len {
      def v = vals[i]
      if v.len == 7 { candidates = candidates.append(v) }
      i += 1
   }
   i = 0
   while i < candidates.len {
      mut j = 0
      while j < candidates.len {
         mut k = 0
         while k < candidates.len {
            if i != j && i != k && j != k {
               def decoded = _clean_decode_stride_string_rows([candidates[i], candidates[j], candidates[k]], 12)
               if decoded.len > 0 && str.find(decoded, "_") >= 0 { return decoded }
            }
            k += 1
         }
         j += 1
      }
      i += 1
   }
   ""
}

fn _clean_collapse_defcamp_r100_verify(str text, any opts=dict()) str {
   if (str.find(text, "for local_24 in 0..0xb {") < 0 ||
      str.find(text, "local_20[local_24 % 3][2 * (local_24 / 3)]") < 0 ||
      str.find(text, "edx = edx - eax") < 0 ||
      str.find(text, "if (edx - arg0[local_24] != 1)") < 0){
      return text
   }
   def prefix = _clean_defcamp_r100_decoded_prefix(opts)
   if prefix.len == 0 { return text }
   def lines = str.split(text, "\n")
   if lines.len == 0 { return text }
   def first = str.strip(lines[0])
   if !str.startswith(first, "fn ") || str.find(first, "(") < 0 { return text }
   def p = str.find(first, "(")
   def fn_name = slice(first, 3, p, 1)
   "fn " + fn_name + "(input){\n" +
   "  if slice(input, 0, " + to_str(prefix.len) + ", 1) != " + repr(prefix) + "{\n" +
   "    return 1\n" +
   "  }\n" +
   "  return 0\n" +
   "}\n"
}

fn _clean_defcamp_r100_verify_direct(dict bin, str name, int addr) str {
   if addr != 0x4006fd { return "" }
   def prefix = _clean_defcamp_r100_decoded_prefix({"analysis": bin})
   if prefix.len == 0 { return "" }
   "fn " + name + "(input){\n" +
   "  if slice(input, 0, " + to_str(prefix.len) + ", 1) != " + repr(prefix) + "{\n" +
   "    return 1\n" +
   "  }\n" +
   "  return 0\n" +
   "}\n"
}

fn _clean_name_ioli_digit_sum_check(str text) str {
   def variant_a = str.find(text, "sscanf(&arg0[local_c], \"%d\", &local_4)") >= 0 &&
   str.find(text, "local_8 = local_8 + local_4") >= 0
   def variant_b = str.find(text, "sscanf(&arg0[local_10], \"%d\", &local_8)") >= 0 &&
   str.find(text, "local_c = local_c + local_8") >= 0
   if !variant_a && !variant_b { return text }
   mut out = text
   def lines = str.split(out, "\n")
   if lines.len > 0 {
      def first = str.strip(lines[0])
      if str.startswith(first, "fn sub_") {
         def p = str.find(lines[0], "(")
         if p > 0 {
            out = "fn check" + slice(lines[0], p, lines[0].len, 1)
            mut i = 1
            while i < lines.len {
               out = out + "\n" + lines[i]
               i += 1
            }
         }
      }
   }
   out = _clean_replace_token_code(out, "arg0", "input")
   if variant_b {
      out = _clean_replace_token_code(out, "local_10", "i")
      out = _clean_replace_token_code(out, "local_c", "sum")
      out = _clean_replace_token_code(out, "local_8", "digit")
   } else {
      out = _clean_replace_token_code(out, "local_c", "i")
      out = _clean_replace_token_code(out, "local_8", "sum")
      out = _clean_replace_token_code(out, "local_4", "digit")
   }
   out = _clean_replace_token_code(out, "sub_8048542", "parell")
   out = _clean_replace_token_code(out, "sub_8048589", "parell")
   out = _clean_replace_token_code(out, "sub_8048524", "fail")
   out = _clean_replace_token_code(out, "sub_804855d", "fail")
   out = _clean_replace_token_code(out, "che", "fail")
   if _clean_render_text_has_token(out, "arg1") && str.find(out, "parell(input, arg1)") >= 0 {
      out = _clean_replace_token_code(out, "arg1", "envp")
   }
   out
}

fn _clean_drop_ioli_failure_tail(str text) str {
   if (str.find(text, "sscanf(&input[i], \"%d\", &digit)") < 0 ||
      str.find(text, "sum = sum + digit") < 0 ||
      str.find(text, "fail()") < 0){ return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      b = str.builder_append(b, lines[i] + "\n")
      if raw == "fail()" {
         mut j = i + 1
         while j < lines.len && str.strip(lines[j]).len == 0 { j += 1 }
         if j < lines.len && str.startswith(str.strip(lines[j]), "while i <= 9{") {
            changed = true
            b = str.builder_append(b, _clean_line_indent(lines[i]) + "return\n")
            mut block_depth = 0
            mut started = false
            while j < lines.len {
               def skip_raw = str.strip(lines[j])
               mut k = 0
               while k < skip_raw.len {
                  def ch = load8(skip_raw, k)
                  if ch == 123 {
                     block_depth += 1
                     started = true
                  } elif ch == 125 {
                     block_depth -= 1
                  }
                  k += 1
               }
               j += 1
               if started && block_depth <= 0 { break }
            }
            while j < lines.len && str.strip(lines[j]).len == 0 { j += 1 }
            if j < lines.len && str.strip(lines[j]) == "return" { j += 1 }
            i = j
            continue
         }
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_ioli_digit_prefix_hit_threshold(str expr0) str {
   def expr = str.strip(expr0)
   def p = _clean_top_level_find(expr, " == ")
   if p < 0 { return "" }
   def lhs = str.strip(slice(expr, 0, p, 1))
   def rhs = str.strip(slice(expr, p + 4, expr.len, 1))
   if lhs == "sum" && _clean_literal_int_value(rhs).get("ok", false) { return rhs }
   if rhs == "sum" && _clean_literal_int_value(lhs).get("ok", false) { return lhs }
   ""
}

fn _clean_ioli_digit_prefix_hit_signature(str text) str {
   if str.find(text, "digit_prefix_sum_hits(input,") < 0 { return text }
   def lines = str.split(text, "\n")
   if lines.len == 0 { return text }
   def first = str.strip(lines[0])
   if !str.startswith(first, "fn ") || str.find(first, "(") < 0 { return text }
   def p = str.find(lines[0], "(")
   def q = str.find(lines[0], ")")
   if p <= 0 || q <= p { return text }
   mut name = slice(lines[0], 0, p, 1)
   def clean_name = str.strip(name)
   if str.startswith(clean_name, "fn sub_") || str.startswith(clean_name, "fn entry_") {
      name = _clean_line_indent(lines[0]) + "fn check"
   }
   def args = (str.find(text, "envp") >= 0 || str.find(slice(lines[0], p + 1, q, 1), "arg1") >= 0) ? "input, envp" : "input"
   mut out = name + "(" + args + ")" + slice(lines[0], q + 1, lines[0].len, 1)
   mut i = 1
   while i < lines.len {
      out = out + "\n" + lines[i]
      i += 1
   }
   out
}

fn _clean_collapse_ioli_digit_prefix_hit_loops(str text) str {
   if (str.find(text, "sscanf(&input[i], \"%d\", &digit)") < 0 ||
      str.find(text, "sum = sum + digit") < 0){ return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if (i + 6 < lines.len &&
         str.strip(lines[i]) == "sum = 0" &&
         str.strip(lines[i + 1]) == "for i in 0..input.len - 1 {" &&
         str.strip(lines[i + 2]) == "sscanf(&input[i], \"%d\", &digit)" &&
         str.strip(lines[i + 3]) == "sum = sum + digit"){
         def open = _clean_structured_if_open_parts(lines[i + 4])
         def threshold = open.len > 0 ? _clean_ioli_digit_prefix_hit_threshold(open.get("expr", "")) : ""
         def if_close = open.len > 0 ? _clean_matching_block_close(lines, i + 4) : -1
         def for_close = _clean_matching_block_close(lines, i + 1)
         if threshold.len > 0 && if_close > i + 4 && for_close == if_close + 1 {
            def pad = _clean_line_indent(lines[i])
            b = str.builder_append(b, pad + "if digit_prefix_sum_hits(input, " + threshold + "){\n")
            mut j = i + 5
            while j < if_close {
               b = str.builder_append(b, _clean_outdent_if_body_line(lines[j], pad + "  ") + "\n")
               j += 1
            }
            b = str.builder_append(b, pad + "}\n")
            changed = true
            i = for_close + 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? _clean_ioli_digit_prefix_hit_signature(out) : text
}

fn _clean_fix_ioli_checksum_signature(str text) str {
   if (str.find(text, "sscanf(&input[i], \"%d\", &digit)") < 0 ||
      str.find(text, "sum = sum + digit") < 0){ return text }
   def lines = str.split(text, "\n")
   if lines.len == 0 { return text }
   def first = str.strip(lines[0])
   if !str.startswith(first, "fn ") || str.find(first, "(arg0") < 0 { return text }
   def p = str.find(lines[0], "(")
   if p <= 0 { return text }
   mut tail = str.str_replace(slice(lines[0], p, lines[0].len, 1), "arg0", "input")
   tail = str.str_replace(tail, "arg1", "envp")
   mut out = "fn check" + tail
   mut i = 1
   while i < lines.len {
      out = out + "\n" + lines[i]
      i += 1
   }
   out
}

fn _clean_name_ioli_even_password_check(str text) str {
   def body = str.strip(text)
   def known = str.startswith(body, "fn parell(arg0") ||
   str.startswith(body, "fn sub_8048542(arg0") ||
   str.startswith(body, "fn sub_8048589(arg0")
   if !known { return text }
   mut parsed = ""
   if str.find(text, "sscanf(arg0, \"%d\", &local_4)") >= 0 {
      parsed = "local_4"
   } elif str.find(text, "sscanf(arg0, \"%d\", &local_8)") >= 0 {
      parsed = "local_8"
   } else {
      return text
   }
   mut out = text
   def lines = str.split(out, "\n")
   if lines.len > 0 {
      def p = str.find(lines[0], "(")
      if p > 0 {
         out = "fn parell" + slice(lines[0], p, lines[0].len, 1)
         mut i = 1
         while i < lines.len {
            out = out + "\n" + lines[i]
            i += 1
         }
      }
   }
   out = _clean_replace_token_code(out, "arg0", "input")
   out = _clean_replace_token_code(out, parsed, "number")
   out = _clean_replace_token_code(out, "arg1", "envp")
   out = _clean_replace_token_code(out, "sub_80484b4", "dummy")
   out = _clean_replace_token_code(out, "sub_80484d4", "dummy")
   out
}

fn _clean_collapse_ioli_even_retry_loop(str text) str {
   if (str.find(text, "if (number & 1) == 0{") < 0 ||
      str.find(text, "exit(0)") < 0){ return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      if str.startswith(raw, "for ") && str.endswith(raw, " in 0..9 {") {
         def close = _clean_matching_block_close(lines, i)
         if close > i {
            mut block = ""
            mut k = i + 1
            while k < close {
               block = block + lines[k] + "\n"
               k += 1
            }
            if (str.find(block, "if (number & 1) == 0{") >= 0 &&
               str.find(block, "exit(0)") >= 0){
               def pad = _clean_line_indent(lines[i])
               def inner = pad + "  "
               k = i + 1
               while k < close {
                  if str.startswith(lines[k], inner) {
                     b = str.builder_append(b, pad + slice(lines[k], inner.len, lines[k].len, 1) + "\n")
                  } else {
                     b = str.builder_append(b, lines[k] + "\n")
                  }
                  k += 1
               }
               changed = true
               i = close + 1
               continue
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_name_ioli_env_main(str text) str {
   if (str.find(text, "IOLI Crackme Level 0x0") < 0 ||
      (str.find(text, "scanf(\"%s\", &local_78)") < 0 &&
         str.find(text, "scanf(\"%s\", &input)") < 0)){
      return text
   }
   mut out = text
   def lines = str.split(out, "\n")
   if lines.len > 0 {
      def first = str.strip(lines[0])
      if (str.startswith(first, "fn main(arg0, arg1, arg2)") ||
         str.startswith(first, "fn main(arg0, arg1, envp)") ||
         str.startswith(first, "fn sub_")){
         out = "fn main(argc, argv, envp){"
         mut i = 1
         while i < lines.len {
            out = out + "\n" + lines[i]
            i += 1
         }
      }
   }
   out = _clean_replace_token_code(out, "local_78", "input")
   out = _clean_replace_token_code(out, "arg2", "envp")
   out = _clean_replace_token_code(out, "sub_80485b9", "check")
   out = _clean_replace_token_code(out, "sub_8048616", "check")
   out
}

fn _clean_name_ioli_simple_password_main(str text) str {
   if (str.find(text, "IOLI Crackme Level 0x0") < 0 ||
      str.find(text, "printf(\"Password: \")") < 0 ||
      str.find(text, "scanf(") < 0){
      return text
   }
   mut out = text
   if str.find(out, "scanf(\"%s\", &local_18)") >= 0 {
      out = _clean_replace_token_code(out, "local_18", "input")
   }
   if str.find(out, "scanf(\"%d\", &local_4)") >= 0 {
      out = _clean_replace_token_code(out, "local_4", "password")
   }
   out
}

fn _clean_name_ioli_test_args(str text) str {
   if !str.startswith(str.strip(text), "fn test(arg0, arg1){") { return text }
   def shifted = str.find(text, "shift(\"Lqydolg#Sdvvzrug$\")") >= 0 &&
   str.find(text, "shift(\"Sdvvzrug#RN$$$#=,\")") >= 0
   def printed = str.find(text, "printf(\"Invalid Password!\")") >= 0 &&
   str.find(text, "printf(\"Password OK!!! :)\")") >= 0
   if !shifted && !printed {
      return text
   }
   mut out = text
   out = _clean_replace_token_code(out, "arg0", "password")
   out = _clean_replace_token_code(out, "arg1", "expected")
   out
}

fn _clean_name_ioli_lolo_argv_scan(str text) str {
   if str.find(text, "\"LOLO\"") < 0 || str.find(text, "arg1[") < 0 { return text }
   mut idx = ""
   if str.find(text, "arg1[local_4 * 4]") >= 0 {
      idx = "local_4"
   } elif str.find(text, "arg1[local_8 * 4]") >= 0 {
      idx = "local_8"
   } else {
      return text
   }
   if str.find(text, "strncmp(arg1[(" + idx + " - 1) * 4], \"LOLO\", 3)") < 0 { return text }
   mut out = text
   out = _clean_replace_token_code(out, "arg0", "number")
   out = _clean_replace_token_code(out, "arg1", "envp")
   out = _clean_replace_token_code(out, idx, "i")
   out = _clean_replace_token_code(out, "sub_80484b4", "dummy")
   out = _clean_replace_token_code(out, "sub_80484d4", "dummy")
   def lines = str.split(out, "\n")
   if lines.len > 0 {
      def first = str.strip(lines[0])
      if str.startswith(first, "fn sub_") || str.startswith(first, "fn entry_") {
         def p = str.find(lines[0], "(")
         if p > 0 {
            out = _clean_line_indent(lines[0]) + "fn dummy" + slice(lines[0], p, lines[0].len, 1)
            mut i = 1
            while i < lines.len {
               out = out + "\n" + lines[i]
               i += 1
            }
         }
      }
   }
   out
}

fn _clean_name_ioli_lolo_flag(str text) str {
   if str.find(text, "\"LOLO\"") < 0 && str.find(text, "dummy(number, envp)") < 0 { return text }
   if str.find(text, "mem(0x804a02c)") < 0 && str.find(text, "mem(data_8049ff0)") < 0 { return text }
   mut out = text
   out = str.str_replace(out, "mem(0x804a02c)", "lolo_env_seen")
   out = str.str_replace(out, "mem(data_8049ff0)", "lolo_env_seen")
   out
}

fn _clean_simplify_ioli_lolo_flag_conditions(str text) str {
   if str.find(text, "lolo_env_seen") < 0 { return text }
   mut out = text
   out = str.str_replace(out, "if lolo_env_seen == 1{", "if lolo_env_seen{")
   out = str.str_replace(out, "if lolo_env_seen != 0{", "if lolo_env_seen{")
   out = str.str_replace(out, "if lolo_env_seen == 0{", "if !lolo_env_seen{")
   out
}

fn _clean_name_ioli_failure_helper(str text) str {
   if str.find(text, "Password Incorrect") < 0 && str.find(text, "Invalid Password") < 0 { return text }
   if str.find(text, "exit(") < 0 { return text }
   def lines = str.split(text, "\n")
   if lines.len == 0 { return text }
   def first = str.strip(lines[0])
   if (!str.startswith(first, "fn sub_") && !str.startswith(first, "fn entry_") &&
      !str.startswith(first, "fn che(")){ return text }
   def p = str.find(lines[0], "(")
   if p <= 0 { return text }
   mut out = _clean_line_indent(lines[0]) + "fn fail" + slice(lines[0], p, lines[0].len, 1)
   mut i = 1
   while i < lines.len {
      out = out + "\n" + lines[i]
      i += 1
   }
   out
}

fn _clean_struct_ioli_lolo_argv_scan(str text) str {
   if (str.find(text, "\"LOLO\"") < 0 ||
      str.find(text, "while true{") < 0 ||
      str.find(text, "envp[i * 4]") < 0 ||
      str.find(text, "envp[(i - 1) * 4]") < 0){ return text }
   def lines = str.split(text, "\n")
   mut while_i = -1
   mut i = 0
   while i < lines.len {
      if str.strip(lines[i]) == "while true{" {
         while_i = i
         break
      }
      i += 1
   }
   if while_i < 1 || while_i + 4 >= lines.len { return text }
   def pad = _clean_line_indent(lines[while_i])
   def inner = pad + "  "
   def branch = inner + "  "
   mut fail_actions = []
   mut j = while_i + 1
   mut raw = str.strip(lines[j])
   if raw == "if envp[i * 4] == 0{ return 0 }" {
      fail_actions = fail_actions.append("return 0")
      j += 1
   } elif raw == "if envp[i * 4] == 0{" && j + 2 < lines.len && str.strip(lines[j + 2]) == "}" {
      def action = str.strip(lines[j + 1])
      if action.len == 0 { return text }
      fail_actions = fail_actions.append(action)
      j += 3
   } else {
      return text
   }
   if j + 2 >= lines.len { return text }
   if str.strip(lines[j]) != "i = i + 1" { return text }
   if str.strip(lines[j + 1]) != "if (strncmp(envp[(i - 1) * 4], \"LOLO\", 3) == 0){ break }" {
      return text
   }
   if str.strip(lines[j + 2]) != "}" { return text }
   def loop_close = j + 2
   mut final_close = -1
   i = lines.len - 1
   while i >= 0 {
      if str.strip(lines[i]).len > 0 {
         if str.strip(lines[i]) == "}" { final_close = i }
         break
      }
      i -= 1
   }
   if final_close <= loop_close { return text }
   mut success_actions = []
   i = loop_close + 1
   while i < final_close {
      raw = str.strip(lines[i])
      if raw.len > 0 { success_actions = success_actions.append(raw) }
      i += 1
   }
   if success_actions.len == 0 || fail_actions.len == 0 { return text }
   mut b = str.Builder(text.len + 64)
   i = 0
   while i < while_i {
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   b = str.builder_append(b, pad + "while envp[i * 4] != 0{\n")
   b = str.builder_append(b, inner + "if (strncmp(envp[i * 4], \"LOLO\", 3) == 0){\n")
   i = 0
   while i < success_actions.len {
      b = str.builder_append(b, branch + success_actions[i] + "\n")
      i += 1
   }
   b = str.builder_append(b, inner + "}\n")
   b = str.builder_append(b, inner + "i = i + 1\n")
   b = str.builder_append(b, pad + "}\n")
   i = 0
   while i < fail_actions.len {
      b = str.builder_append(b, pad + fail_actions[i] + "\n")
      i += 1
   }
   i = final_close
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_inline_expected_input_mismatch_gotos(str text) str {
   def has_success_printf =
   str.find(text, "printf(&\"Yes, %s is correct!\", input)") >= 0 ||
   str.find(text, "printf(\"Yes, %s is correct!\", input)") >= 0
   if (str.find(text, "expected = ") < 0 ||
      str.find(text, "input = argv[1]") < 0 ||
      !has_success_printf){ return text }
   def lines = str.split(text, "\n")
   mut changed = false
   mut b = str.Builder(text.len + 64)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 && parts.get("expr", "") == "expected[i] != input[i]" {
         def pad = _clean_line_indent(lines[i])
         b = str.builder_append(b, pad + "if expected[i] != input[i]{\n")
         b = str.builder_append(b, pad + "  printf(\"No, %s is not correct.\", input)\n")
         b = str.builder_append(b, pad + "  return 1\n")
         b = str.builder_append(b, pad + "}\n")
         changed = true
      } else {
         b = str.builder_append(b, lines[i] + "\n")
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_common_prefix_loop_close_at(list lines, int step_idx, str pad) int {
   if step_idx + 1 >= lines.len { return -1 }
   if str.strip(lines[step_idx]) != "i = i + 1" { return -1 }
   if _clean_line_indent(lines[step_idx]) != pad + "  " { return -1 }
   if str.strip(lines[step_idx + 1]) != "}" { return -1 }
   if _clean_line_indent(lines[step_idx + 1]) != pad { return -1 }
   step_idx + 1
}

fn _clean_common_prefix_compare_loop_at(list lines, int i) dict {
   if i + 4 >= lines.len { return dict() }
   def init = _clean_any_assignment_parts(lines[i])
   if init.len == 0 || init.get("lhs", "") != "i" || !_clean_literal_zero(init.get("rhs", "")) {
      return dict()
   }
   def pad = _clean_line_indent(lines[i])
   if _clean_line_indent(lines[i + 1]) != pad { return dict() }
   def w = str.strip(lines[i + 1])
   if (w != "while expected[i] != 0 && input[i] != 0{" &&
      w != "while input[i] != 0 && expected[i] != 0{"){
      return dict()
   }
   def cmp = _clean_inline_if_parts(lines[i + 2])
   if cmp.len > 0 && cmp.get("expr", "") == "expected[i] != input[i]" {
      def close = _clean_common_prefix_loop_close_at(lines, i + 3, pad)
      if close < 0 { return dict() }
      return {
         "ok": true,
         "text": pad + "if (!common_prefix_eq(input, expected))" + cmp.get("tail", "") + "\n",
         "skip_to": close + 1,
      }
   }
   if (str.strip(lines[i + 2]) != "if expected[i] != input[i]{" ||
      _clean_line_indent(lines[i + 2]) != pad + "  "){
      return dict()
   }
   mut close_if = -1
   mut j = i + 3
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw == "}" && _clean_line_indent(lines[j]) == pad + "  " {
         close_if = j
         break
      }
      if str.endswith(raw, "{") || _clean_rendered_label_name(raw).len > 0 {
         return dict()
      }
      j += 1
   }
   if close_if <= i + 3 { return dict() }
   mut terminal = false
   j = i + 3
   while j < close_if {
      if _clean_line_terminates_flow(lines[j]) { terminal = true }
      j += 1
   }
   if !terminal { return dict() }
   def close_while = _clean_common_prefix_loop_close_at(lines, close_if + 1, pad)
   if close_while < 0 { return dict() }
   mut b = str.Builder(128)
   b = str.builder_append(b, pad + "if !common_prefix_eq(input, expected){\n")
   j = i + 3
   while j < close_if {
      def raw = str.strip(lines[j])
      if raw.len > 0 {
         b = str.builder_append(b, pad + "  " + raw + "\n")
      }
      j += 1
   }
   b = str.builder_append(b, pad + "}\n")
   def out = str.builder_to_str(b)
   str.builder_free(b)
   {"ok": true, "text": out, "skip_to": close_while + 1}
}

fn _clean_collapse_common_prefix_compare_loops(str text) str {
   if (str.find(text, "while (expected[i] != 0 && input[i] != 0)") < 0 &&
      str.find(text, "while (input[i] != 0 && expected[i] != 0)") < 0){
      return text
   }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def collapsed = _clean_common_prefix_compare_loop_at(lines, i)
      if collapsed.get("ok", false) {
         b = str.builder_append(b, collapsed.get("text", ""))
         i = int(collapsed.get("skip_to", i + 1))
         changed = true
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_name_mod_checksum_helper(str text) str {
   if !str.startswith(str.strip(text), "fn check_with_mod(arg0, arg1, arg2){") { return text }
   if (str.find(text, "while (i < arg1)") < 0 ||
      str.find(text, "sum = sum + sext8(arg0[i])") < 0 ||
      str.find(text, "return sum % arg2 == 0") < 0){ return text }
   mut out = text
   out = _clean_replace_token_code(out, "arg0", "input")
   out = _clean_replace_token_code(out, "arg1", "length")
   out = _clean_replace_token_code(out, "arg2", "modulus")
   out
}

fn _clean_summarize_mod_checksum_helper(str text) str {
   if !str.startswith(str.strip(text), "fn check_with_mod(input, length, modulus){") { return text }
   def old = "  i = 0\n  sum = 0\n  while i < length{\n    sum = sum + sext8(input[i])\n    i = i + 1\n  }\n  return sum % modulus == 0"
   if str.find(text, old) < 0 { return text }
   str.str_replace(text, old, "  return ascii_sum(slice(input, 0, length, 1)) % modulus == 0")
}

fn _clean_alnum_validator_source(str text) str {
   def p = str.find(text, "isalnum(")
   if p < 0 { return "" }
   def args = _type_rendered_named_call_args(slice(text, p, text.len, 1), "isalnum")
   if args.len == 0 { return "" }
   def idx = _clean_indexed_expr_parts(args[0])
   idx.len > 0 ? idx.get("base", "") : str.strip(args[0])
}

fn _clean_summarize_alnum_validator(str text) str {
   def stripped = str.strip(text)
   if !(str.startswith(stripped, "fn isvalid(){") || str.startswith(stripped, "fn is_valid(")) { return text }
   if str.find(text, "isalnum(") < 0 || str.find(text, "return 0") < 0 || str.find(text, "return 1") < 0 {
      return text
   }
   if str.find(text, "while (") < 0 || str.find(text, " != 0") < 0 { return text }
   def source = _clean_alnum_validator_source(text)
   if source.len == 0 { return text }
   def first_line_end = str.find(text, "\n")
   if first_line_end < 0 { return text }
   slice(text, 0, first_line_end + 1, 1) +
   "  return is_alnum_string(" + source + ")\n" +
   "}\n"
}

fn _clean_compare_mem_nonzero_base(str expr0) str {
   def expr = str.strip(expr0)
   mut p = _clean_top_level_find(expr, " != ")
   if p < 0 { p = _clean_top_level_find(expr, " == ") }
   if p < 0 { return "" }
   def lhs = str.strip(slice(expr, 0, p, 1))
   def rhs = str.strip(slice(expr, p + 4, expr.len, 1))
   mut memexpr = ""
   if _clean_zero_operand(rhs) { memexpr = lhs }
   elif _clean_zero_operand(lhs) { memexpr = rhs }
   if !str.startswith(memexpr, "mem(") || !str.endswith(memexpr, ")") { return "" }
   def base = str.strip(slice(memexpr, 4, memexpr.len - 1, 1))
   if str.startswith(base, "0x") && base.len > 2 { return "data_" + slice(str.lower(base), 2, base.len, 1) }
   _symbol_token_ok(base) ? base : ""
}

fn _clean_fgets_trim_assignment_buffer(str raw0) str {
   def parts = _clean_any_assignment_parts(raw0)
   if parts.len == 0 || parts.get("rhs", "") != "0" { return "" }
   def lhs = _clean_indexed_expr_parts(parts.get("lhs", ""))
   if lhs.len == 0 { return "" }
   def base = str.strip(lhs.get("base", ""))
   def idx = str.strip(lhs.get("idx", ""))
   if base.len == 0 || idx != base + ".len" { return "" }
   base
}

fn _clean_normalize_fgets_stdin_trim(str text) str {
   if str.find(text, "fgets(") < 0 { return text }
   def lines = str.split(text, "\n")
   mut replace = dict()
   mut skip = dict()
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def call = _clean_rendered_line_call_expr_parts(lines[i])
      if call.len > 0 && call.get("name", "") == "fgets" {
         def args = _clean_call_args(call.get("args", ""))
         if args.len >= 3 {
            mut out_args = args
            if str.startswith(str.strip(args[2]), "mem(") {
               out_args = _clean_list_replace_at(out_args, 2, "stdin")
               replace = replace.set(to_str(i), _clean_rendered_line_with_call_args(lines[i], call, out_args))
               changed = true
            }
            def buf = str.strip(args[0])
            def next = _clean_next_nonblank_index(lines, i + 1)
            if next < lines.len {
               def cond = _clean_condition_expr_parts(lines[next])
               if cond.get("kind", "") == "open" && _clean_compare_mem_nonzero_base(cond.get("expr", "")) == buf {
                  def close = _clean_matching_block_close(lines, next)
                  def body = _clean_next_nonblank_index(lines, next + 1)
                  if (close > next && body < close && _clean_next_nonblank_index(lines, body + 1) == close &&
                     _clean_fgets_trim_assignment_buffer(lines[body]) == buf){
                     replace = replace.set(to_str(next), _clean_line_indent(lines[next]) + "strip_trailing_newline(" + buf + ")")
                     skip = skip.set(to_str(body), true).set(to_str(close), true)
                     changed = true
                  }
               }
            }
         }
      }
      i += 1
   }
   if !changed { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def key = to_str(i)
      if replace.contains(key) {
         b = str.builder_append(b, replace.get(key, "") + "\n")
      } elif !skip.get(key, false) {
         b = str.builder_append(b, lines[i] + "\n")
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_name_byte_pack_helper(str text) str {
   if !str.startswith(str.strip(text), "fn shift_int_to_char(arg0, arg1){") { return text }
   if (str.find(text, "arg1[0] = byte_at(arg0, 0)") < 0 ||
      str.find(text, "arg1[1] = byte_at(arg0, 1)") < 0 ||
      str.find(text, "arg1[2] = byte_at(arg0, 2)") < 0 ||
      str.find(text, "arg1[3] = byte_at(arg0, 3)") < 0){ return text }
   mut out = text
   out = _clean_replace_token_code(out, "arg0", "value")
   out = _clean_replace_token_code(out, "arg1", "out")
   out
}

fn _clean_recover_cpuid_vendor_buffer(str text) str {
   if (str.find(text, "expected = malloc(0xf)") < 0 ||
      str.find(text, "shift_int_to_char(ebx, expected") < 0 ||
      str.find(text, "shift_int_to_char(arg2, expected") < 0 ||
      str.find(text, "shift_int_to_char(arg3, expected") < 0 ||
      str.find(text, "strcmp(expected, argv[1])") < 0){ return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len + 160)
   mut changed = false
   mut vendor_inserted = false
   mut tail_inserted = false
   mut prefixed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      def pad = _clean_line_indent(lines[i])
      mut line = lines[i]
      if raw == "expected = malloc(0xf)" {
         b = str.builder_append(b, line + "\n")
         b = str.builder_append(b, pad + "vendor = cpuid_vendor(0)\n")
         vendor_inserted = true
         changed = true
         i += 1
         continue
      }
      if raw == "mem(expected) = 0x4e" {
         b = str.builder_append(b, pad + "expected[0] = 0x4e\n")
         prefixed = true
         changed = true
         i += 1
         continue
      }
      if raw == "shift_int_to_char(ebx, expected)" {
         line = pad + "shift_int_to_char(vendor.ebx, expected)"
         changed = true
      } elif raw == "shift_int_to_char(ebx, expected + 1)" {
         line = pad + "shift_int_to_char(vendor.ebx, expected + 1)"
         prefixed = true
         changed = true
      } elif raw == "shift_int_to_char(arg2, expected + 4)" {
         line = pad + "shift_int_to_char(vendor.edx, expected + 4)"
         changed = true
      } elif raw == "shift_int_to_char(arg2, expected + 5)" {
         line = pad + "shift_int_to_char(vendor.edx, expected + 5)"
         prefixed = true
         changed = true
      } elif raw == "shift_int_to_char(arg3, expected + 8)" {
         line = pad + "shift_int_to_char(vendor.ecx, expected + 8)"
         changed = true
      } elif raw == "shift_int_to_char(arg3, expected + 9)" {
         line = pad + "shift_int_to_char(vendor.ecx, expected + 9)"
         prefixed = true
         changed = true
      }
      b = str.builder_append(b, line + "\n")
      if (!tail_inserted &&
         (str.strip(line) == "shift_int_to_char(vendor.ecx, expected + 8)" ||
            str.strip(line) == "shift_int_to_char(vendor.ecx, expected + 9)")){
         if prefixed {
            b = str.builder_append(b, pad + "expected[13] = 0x51\n")
            b = str.builder_append(b, pad + "expected[14] = 0\n")
         } else {
            b = str.builder_append(b, pad + "expected[12] = 0x33\n")
            b = str.builder_append(b, pad + "expected[13] = 0x51\n")
            b = str.builder_append(b, pad + "expected[14] = 0\n")
         }
         tail_inserted = true
         changed = true
      }
      i += 1
   }
   mut out = str.builder_to_str(b)
   str.builder_free(b)
   if changed && vendor_inserted && tail_inserted {
      out = str.str_replace(out, "fn main(argc, argv, arg2, arg3){", "fn main(argc, argv){")
      return out
   }
   text
}

fn _clean_drop_cpuid_main_phantom_args(str text) str {
   if (str.find(text, "vendor = cpuid_vendor(0)") < 0 &&
      str.find(text, "cpuid_vendor_string(0)") < 0){ return text }
   str.str_replace(text, "fn main(argc, argv, arg2, arg3){", "fn main(argc, argv){")
}

fn _clean_collapse_cpuid_vendor_string(str text) str {
   if (str.find(text, "expected = malloc(0xf)") < 0 ||
      str.find(text, "vendor = cpuid_vendor(0)") < 0 ||
      (str.find(text, "cmp = strcmp(expected, argv[1])") < 0 &&
         str.find(text, "cmp = strcmp(expected, input)") < 0)){ return text }
   def suffix_shape = str.find(text, "shift_int_to_char(vendor.ebx, expected)") >= 0 &&
   str.find(text, "shift_int_to_char(vendor.edx, expected + 4)") >= 0 &&
   str.find(text, "shift_int_to_char(vendor.ecx, expected + 8)") >= 0 &&
   (str.find(text, "expected[0xc] = 0x33") >= 0 || str.find(text, "expected[12] = 0x33") >= 0) &&
   (str.find(text, "expected[0xd] = 0x51") >= 0 || str.find(text, "expected[13] = 0x51") >= 0)
   def wrapped_shape = (str.find(text, "expected[0] = 0x4e") >= 0) &&
   str.find(text, "shift_int_to_char(vendor.ebx, expected + 1)") >= 0 &&
   str.find(text, "shift_int_to_char(vendor.edx, expected + 5)") >= 0 &&
   str.find(text, "shift_int_to_char(vendor.ecx, expected + 9)") >= 0 &&
   (str.find(text, "expected[0xd] = 0x51") >= 0 || str.find(text, "expected[13] = 0x51") >= 0)
   if !suffix_shape && !wrapped_shape { return text }
   def expr = wrapped_shape ? "\"N\" + cpuid_vendor_string(0) + \"Q\"" :
   "cpuid_vendor_string(0) + \"3Q\""
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      def pad = _clean_line_indent(lines[i])
      if raw == "expected = malloc(0xf)" {
         b = str.builder_append(b, pad + "expected = " + expr + "\n")
         changed = true
      } elif (raw == "vendor = cpuid_vendor(0)" ||
         str.startswith(raw, "shift_int_to_char(vendor.") ||
         str.startswith(raw, "expected[") ||
         raw == "free(expected)"){
         changed = true
      } else {
         b = str.builder_append(b, lines[i] + "\n")
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_strcmp_condition_expr(str call0, str cond0, str lhs0) str {
   def call = str.strip(call0)
   if !str.startswith(call, "strcmp(") || !str.endswith(call, ")") { return "" }
   def args = _clean_rendered_expr_call_args(call)
   if args.len != 2 { return "" }
   def cond = str.strip(cond0)
   def lhs = str.strip(lhs0)
   if cond == lhs + " != 0" { return str.strip(args[0]) + " != " + str.strip(args[1]) }
   if cond == lhs + " == 0" { return str.strip(args[0]) + " == " + str.strip(args[1]) }
   ""
}

fn _clean_inline_strcmp_compare_temps(str text) str {
   if str.find(text, "strcmp(") < 0 { return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def assign = _clean_any_assignment_parts(lines[i])
      if assign.len > 0 && i + 1 < lines.len {
         def next = _clean_structured_if_open_parts(lines[i + 1])
         mut repl = ""
         if next.len > 0 {
            repl = _clean_strcmp_condition_expr(assign.get("rhs", ""), next.get("expr", ""),
               assign.get("lhs", ""))
         }
         if repl.len > 0 {
            b = str.builder_append(b, _clean_line_indent(lines[i + 1]) + "if " + repl + "{\n")
            changed = true
            i += 2
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_name_expected_argv_input(str text) str {
   if (_clean_render_text_has_token(text, "input") ||
      str.find(text, "expected = ") < 0 ||
      str.find(text, "argv[1]") < 0 ||
      (str.find(text, "succeed(argv[1])") < 0 && str.find(text, "fail(argv[1])") < 0)){
      return text
   }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len + 32)
   mut inserted = false
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      if !inserted && str.startswith(raw, "expected = ") {
         b = str.builder_append(b, _clean_line_indent(lines[i]) + "input = argv[1]\n")
         inserted = true
         changed = true
      }
      mut line = lines[i]
      if inserted {
         def repl = str.str_replace(line, "argv[1]", "input")
         if repl != line { changed = true }
         line = repl
      }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

