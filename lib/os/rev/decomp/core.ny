   def ops = [" != ", " == ", " <= ", " >= ", " < ", " > "]
   mut i = 0
   while i < ops.len {
      def op = ops[i]
      def p = _clean_top_level_find(expr, op)
      if p >= 0 {
         def lhs = str.strip(slice(expr, 0, p, 1))
         def rhs = str.strip(slice(expr, p + op.len, expr.len, 1))
         if lhs == "i" { return "input.len" + op + rhs }
         if rhs == "i" { return lhs + op + "input.len" }
      }
      i += 1
   }
   expr0
}

fn _clean_collapse_ascii_sum_input_loop(str text) str {
   def lines = str.split(text, "\n")
