fn _clean_rendered_label_set(list lines) dict {
   mut labels = dict()
   mut i = 0
   while i < lines.len {
      def label = _clean_rendered_label_name(lines[i])
      if label.len > 0 { labels = labels.set(label, true) }
      i += 1
   }
   labels
}

fn _clean_nearby_failure_call_after(list lines, int i) str {
   def pad = _clean_line_indent(lines[i])
   mut j = i + 1
   while j < lines.len && j < i + 48 {
      def raw = str.strip(lines[j])
      if raw.len == 0 || raw == "}" {
         j += 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 { return "" }
      if (_clean_line_indent(lines[j]) == pad && str.startswith(raw, "fail(") &&
         str.endswith(raw, ")")){
         return raw
      }
      if _clean_rendered_is_return(raw) { return "" }
      j += 1
   }
   ""
}

fn _clean_inline_missing_failure_gotos(str text) str {
   def lines = str.split(text, "\n")
   def labels = _clean_rendered_label_set(lines)
   mut changed = false
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 && !labels.get(parts.get("target", ""), false) {
         def fail_call = _clean_nearby_failure_call_after(lines, i)
         if fail_call.len > 0 {
            def pad = _clean_line_indent(lines[i])
            b = str.builder_append(b, pad + "if " + parts.get("expr", "") + "{\n")
            b = str.builder_append(b, pad + "  " + fail_call + "\n")
            b = str.builder_append(b, pad + "}\n")
            changed = true
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_missing_argc_usage_expr(str expr0) bool {
   def expr = str.strip(expr0)
   expr == "argc != 2" || expr == "2 != argc"
}

fn _clean_inline_missing_argc_usage_gotos(str text) str {
   if str.find(text, "Need exactly one argument") >= 0 { return text }
   def lines = str.split(text, "\n")
   def labels = _clean_rendered_label_set(lines)
   mut changed = false
   mut b = str.Builder(text.len + 96)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_if_goto_parts(lines[i])
      if (parts.len > 0 && _clean_missing_argc_usage_expr(parts.get("expr", "")) &&
         !labels.get(parts.get("target", ""), false) &&
         (_clean_render_text_has_token(text, "argv") || _clean_render_text_has_token(text, "input"))){
         def pad = _clean_line_indent(lines[i])
         b = str.builder_append(b, pad + "if " + parts.get("expr", "") + "{\n")
         b = str.builder_append(b, pad + "  puts(&\"Need exactly one argument.\")\n")
         b = str.builder_append(b, pad + "  return -1\n")
         b = str.builder_append(b, pad + "}\n")
         changed = true
         i += 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_prev_nonblank_line(list lines, int i) str {
   mut j = i - 1
   while j >= 0 {
      def raw = str.strip(lines[j])
      if raw.len > 0 { return raw }
      j -= 1
   }
   ""
}

fn _clean_next_nonblank_is_end(list lines, int i) bool {
   mut j = i + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      return raw == "}"
   }
   true
}

fn _clean_success_printf_line(str raw0) bool {
   def raw = str.strip(raw0)
   str.startswith(raw, "printf(") &&
   (str.find(raw, "Yes, ") >= 0 || str.find(raw, "correct!") >= 0 ||
      str.find(raw, "Access granted") >= 0)
}

fn _clean_return_after_missing_success_gotos(str text) str {
   def lines = str.split(text, "\n")
   def labels = _clean_rendered_label_set(lines)
   mut changed = false
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def target = _clean_raw_goto_label(lines[i])
      if (target.len > 0 && !labels.get(target, false) &&
         _clean_next_nonblank_is_end(lines, i) &&
         _clean_success_printf_line(_clean_prev_nonblank_line(lines, i))){
         b = str.builder_append(b, _clean_line_indent(lines[i]) + "return 0\n")
         changed = true
         i += 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_drop_duplicate_input_aliases(str text) str {
   def lines = str.split(text, "\n")
   mut seen = false
   mut changed = false
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      def assign = _clean_any_assignment_parts(raw)
      if assign.len > 0 && assign.get("lhs", "") == "input" {
         if assign.get("rhs", "") == "argv[1]" {
            if seen {
               changed = true
               i += 1
               continue
            }
            seen = true
         } else {
            seen = false
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_mask_main_strlen_ok_expr(str expr0) str {
   def expr = str.strip(expr0)
   def p = _clean_top_level_find(expr, " != ")
   if p < 0 { return "" }
   def left = str.strip(slice(expr, 0, p, 1))
   def right = str.strip(slice(expr, p + 4, expr.len, 1))
   if left != "strlen(argv[1])" && left != "strlen(input)" && left != "argv[1].len" && left != "input.len" {
      return ""
   }
   "input.len == " + right
}

fn _clean_mask_main_check_expr(str expr0) str {
   def expr = str.strip(expr0)
   if str.find(expr, "check_pw(") < 0 || str.find(expr, " != 0") < 0 { return "" }
   str.str_replace(expr, "argv[1]", "input")
}

fn _clean_recover_mask_check_success_main(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len + 160)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if i + 4 < lines.len {
         def len_if = _clean_if_goto_parts(lines[i])
         def check_if = _clean_if_goto_parts(lines[i + 1])
         def fail_label = _clean_rendered_label_name(lines[i + 2])
         mut fail_idx = i + 3
         def alias = _clean_any_assignment_parts(lines[fail_idx])
         if alias.len > 0 && alias.get("lhs", "") == "input" && alias.get("rhs", "") == "argv[1]" {
            fail_idx += 1
         }
         if (fail_idx + 1 < lines.len && len_if.len > 0 && check_if.len > 0 &&
            fail_label.len > 0 && fail_label == len_if.get("target", "") &&
            fail_label != check_if.get("target", "")){
            def len_ok = _clean_mask_main_strlen_ok_expr(len_if.get("expr", ""))
            def check_ok = _clean_mask_main_check_expr(check_if.get("expr", ""))
            def fail_raw = str.strip(lines[fail_idx])
            def ret_raw = str.strip(lines[fail_idx + 1])
            if (len_ok.len > 0 && check_ok.len > 0 &&
               str.startswith(fail_raw, "printf(") &&
               str.find(fail_raw, "No, %s is not correct.") >= 0 &&
               ret_raw == "return 1"){
               def pad = _clean_line_indent(lines[i])
               b = str.builder_append(b, pad + "input = argv[1]\n")
               b = str.builder_append(b, pad + "if " + len_ok + " && " + check_ok + "{\n")
               b = str.builder_append(b, pad + "  printf(&\"Yes, %s is correct!\", input)\n")
               b = str.builder_append(b, pad + "  return 0\n")
               b = str.builder_append(b, pad + "}\n")
               b = str.builder_append(b, pad + "printf(&\"No, %s is not correct.\", input)\n")
               b = str.builder_append(b, pad + "return 1\n")
               changed = true
               i = fail_idx + 2
               continue
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_string_transform_source(str rhs0) str {
   def rhs = str.strip(rhs0)
   if rhs.len >= 3 && load8(rhs, 0) == 38 && (load8(rhs, 1) == 34 || load8(rhs, 1) == 39) {
      return slice(rhs, 1, rhs.len, 1)
   }
   if rhs.len >= 2 && (load8(rhs, 0) == 34 || load8(rhs, 0) == 39) { return rhs }
   ""
}

fn _clean_mem_cursor_zero_compare(str expr0, str cursor0, str op0) bool {
   def expr = str.strip(expr0)
   def cursor = str.strip(cursor0)
   def op = " " + op0 + " "
   def p = _clean_top_level_find(expr, op)
   if p < 0 { return false }
   def left = str.strip(slice(expr, 0, p, 1))
   def right = str.strip(slice(expr, p + op.len, expr.len, 1))
   def mem = "mem(" + cursor + ")"
   (left == mem && _clean_zero_operand(right)) ||
   (right == mem && _clean_zero_operand(left)) ||
   (_clean_indexed_expr_matches(left, cursor, "0") && _clean_zero_operand(right)) ||
   (_clean_indexed_expr_matches(right, cursor, "0") && _clean_zero_operand(left))
}

fn _clean_shifted_compare_delta(str rhs0, str reg0) int {
   def rhs = str.strip(rhs0)
   def reg = str.strip(reg0)
   mut p = _clean_top_level_find(rhs, " - ")
   if p > 0 && str.strip(slice(rhs, 0, p, 1)) == reg {
      def v = _clean_literal_int_value(slice(rhs, p + 3, rhs.len, 1))
      if v.get("ok", false) { return int(v.get("value", 0)) }
   }
   p = _clean_top_level_find(rhs, " + ")
   if p > 0 && str.strip(slice(rhs, 0, p, 1)) == reg {
      def v = _clean_literal_int_value(slice(rhs, p + 3, rhs.len, 1))
      if v.get("ok", false) { return -int(v.get("value", 0)) }
   }
   0
}

fn _clean_compare_reg_to_cursor(str expr0, str reg0, str cursor0, str op0) bool {
   def expr = str.strip(expr0)
   def reg = str.strip(reg0)
   def cursor = str.strip(cursor0)
   def op = " " + op0 + " "
   def p = _clean_top_level_find(expr, op)
   if p < 0 { return false }
   def left = str.strip(slice(expr, 0, p, 1))
   def right = str.strip(slice(expr, p + op.len, expr.len, 1))
   def mem = "mem(" + cursor + ")"
   (left == reg && right == mem) || (right == reg && left == mem) ||
   (left == reg && _clean_indexed_expr_matches(right, cursor, "0")) ||
   (right == reg && _clean_indexed_expr_matches(left, cursor, "0"))
}

fn _clean_shifted_string_transform_expr(str source_lit, int delta) str {
   if delta == 0 { return source_lit }
   def lit = _clean_rendered_string_literal_value(source_lit)
   if lit.get("ok", false) {
      def value = lit.get("value", "")
      mut decoded = ""
      mut i = 0
      mut printable = true
      while i < value.len {
         def c = load8(value, i) - delta
         if c < 32 || c > 126 {
            printable = false
            break
         }
         decoded = decoded + chr(c)
         i += 1
      }
      if printable { return repr(decoded) }
   }
   source_lit + ".map(fn(ch){ ch " + (delta > 0 ? "- " + to_str(delta) : "+ " + to_str(-delta)) + " })"
}

fn _clean_collapse_shifted_string_compare_loop_at(list lines, int i) dict {
   if i + 9 >= lines.len { return dict() }
   def input = _clean_any_assignment_parts(lines[i])
   def correct = _clean_any_assignment_parts(lines[i + 1])
   def seed = _clean_any_assignment_parts(lines[i + 2])
   if input.len == 0 || correct.len == 0 || seed.len == 0 { return dict() }
   def input_reg = input.get("lhs", "")
   def correct_reg = correct.get("lhs", "")
   def byte_reg = seed.get("lhs", "")
   if (!_clean_rendered_temp_reg(input_reg) || !_clean_rendered_temp_reg(correct_reg) ||
      !_clean_rendered_temp_reg(byte_reg)){
      return dict()
   }
   def source_lit = _clean_string_transform_source(correct.get("rhs", ""))
   if source_lit.len == 0 { return dict() }
   def seed_lit = _clean_literal_int_value(seed.get("rhs", ""))
   if !seed_lit.get("ok", false) { return dict() }
   def w = str.strip(lines[i + 3])
   if !str.startswith(w, "while (") || !str.endswith(w, "{") { return dict() }
   def wexpr = str.strip(slice(w, 6, w.len - 2, 1))
   if !_clean_mem_cursor_zero_compare(wexpr, input_reg, "!=") { return dict() }
   def cast = _clean_any_assignment_parts(lines[i + 4])
   def sub = _clean_any_assignment_parts(lines[i + 5])
   def cmp = _clean_inline_if_parts(lines[i + 6])
   if cast.len == 0 || sub.len == 0 || cmp.len == 0 { return dict() }
   if cast.get("lhs", "") != byte_reg || cast.get("rhs", "") != "sext(al)" { return dict() }
   if sub.get("lhs", "") != byte_reg { return dict() }
   def delta = _clean_shifted_compare_delta(sub.get("rhs", ""), byte_reg)
   if delta == 0 { return dict() }
   if !_clean_compare_reg_to_cursor(cmp.get("expr", ""), byte_reg, input_reg, "!=") { return dict() }
   def tail = cmp.get("tail", "")
   if str.find(tail, "goto ") < 0 && str.find(tail, "return ") < 0 { return dict() }
   mut j = i + 7
   if j < lines.len {
      def inc_input = _clean_any_assignment_parts(lines[j])
      if inc_input.len > 0 && inc_input.get("lhs", "") == input_reg && _clean_inc_one_rhs(inc_input.get("rhs", ""), input_reg) {
         j += 1
      }
   }
   def inc_correct = j < lines.len ? _clean_any_assignment_parts(lines[j]) : dict()
   if (inc_correct.len == 0 || inc_correct.get("lhs", "") != correct_reg ||
      !_clean_inc_one_rhs(inc_correct.get("rhs", ""), correct_reg)){
      return dict()
   }
   j += 1
   def end = j < lines.len ? _clean_inline_if_parts(lines[j]) : dict()
   if (end.len == 0 || end.get("tail", "") != "{ break }" ||
      !_clean_compare_zero_index_expr(end.get("expr", ""), correct_reg, "0")){
      return dict()
   }
   j += 1
   if j >= lines.len || str.strip(lines[j]) != "}" { return dict() }
   def pad = _clean_line_indent(lines[i])
   def expected = _clean_shifted_string_transform_expr(source_lit, delta)
   def body = pad + "input = " + input.get("rhs", "") + "\n" +
   pad + "expected = " + expected + "\n" +
   pad + "i = 0\n" +
   pad + "while expected[i] != 0 && input[i] != 0{\n" +
   pad + "  if (expected[i] != input[i])" + tail + "\n" +
   pad + "  i = i + 1\n" +
   pad + "}\n"
   {"ok": true, "text": body, "skip_to": j + 1}
}

fn _clean_collapse_shifted_string_compare_loops(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def collapsed = _clean_collapse_shifted_string_compare_loop_at(lines, i)
      if collapsed.get("ok", false) {
         b = str.builder_append(b, collapsed.get("text", ""))
         i = int(collapsed.get("skip_to", i + 1))
         changed = true
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_expr_is_reg_alias(str expr0, str reg0) bool {
   def expr = str.strip(expr0)
   _symbol_token_ok(expr) && _symbols_intersect(_slice_symbol_aliases(expr), _slice_symbol_aliases(reg0))
}

fn _clean_byte_addend_from_self_rhs(str rhs0, str byte_reg) str {
   def parts = _clean_rendered_binary_expr_parts(rhs0)
   if parts.len == 0 || parts.get("op", "") != " + " { return "" }
   def lhs = parts.get("lhs", "")
   def rhs = parts.get("rhs", "")
   if _clean_expr_is_reg_alias(lhs, byte_reg) && !_clean_expr_is_reg_alias(rhs, byte_reg) { return rhs }
   if _clean_expr_is_reg_alias(rhs, byte_reg) && !_clean_expr_is_reg_alias(lhs, byte_reg) { return lhs }
   ""
}

fn _clean_byte_compare_expr(str expr0, str byte_reg, str value_expr) str {
   def expr = str.strip(expr0)
   def ops = [" != ", " == "]
   mut i = 0
   while i < ops.len {
      def op = ops[i]
      def p = _clean_top_level_find(expr, op)
      if p > 0 {
         def lhs = str.strip(slice(expr, 0, p, 1))
         def rhs = str.strip(slice(expr, p + op.len, expr.len, 1))
         if _clean_expr_is_reg_alias(lhs, byte_reg) && !_clean_expr_is_reg_alias(rhs, byte_reg) {
            return value_expr + op + rhs
         }
         if _clean_expr_is_reg_alias(rhs, byte_reg) && !_clean_expr_is_reg_alias(lhs, byte_reg) {
            return lhs + op + value_expr
         }
      }
      i += 1
   }
   ""
}

fn _clean_collapse_byte_add_compare_conditions(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut changed = false
   mut i = 0
   while i + 2 < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def load = _clean_any_assignment_parts(lines[i])
      def add = _clean_any_assignment_parts(lines[i + 1])
      def cond = _clean_inline_if_parts(lines[i + 2])
      if load.len == 0 || add.len == 0 || cond.len == 0 {
         i += 1
         continue
      }
      if (_clean_line_indent(lines[i]) != _clean_line_indent(lines[i + 1]) ||
         _clean_line_indent(lines[i]) != _clean_line_indent(lines[i + 2])){
         i += 1
         continue
      }
      def full_reg = load.get("lhs", "")
      def byte_reg = add.get("lhs", "")
      if (!_clean_rendered_temp_reg(full_reg) ||
         !_symbols_intersect(_slice_symbol_aliases(full_reg), _slice_symbol_aliases(byte_reg))){
         i += 1
         continue
      }
      def addend = _clean_byte_addend_from_self_rhs(add.get("rhs", ""), byte_reg)
      if addend.len == 0 {
         i += 1
         continue
      }
      def value = _clean_binary_expr(addend, "+", load.get("rhs", ""))
      def next_expr = _clean_byte_compare_expr(cond.get("expr", ""), byte_reg, value)
      if next_expr.len == 0 {
         i += 1
         continue
      }
      skip = skip.set(to_str(i), true).set(to_str(i + 1), true)
      replace = replace.set(to_str(i + 2), _clean_line_indent(lines[i + 2]) + "if (" + next_expr + ")" + cond.get("tail", ""))
      changed = true
      i += 3
   }
   if !changed { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) {
         b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_byte_castless_value(str expr0) str {
   mut expr = _clean_strip_outer_parens(_clean_simplify_redundant_casts(expr0))
   mut guard = 0
   while guard < 3 {
      mut inner = _clean_strip_unary_call(expr, "zext8")
      if inner.len == 0 { inner = _clean_strip_unary_call(expr, "sext8") }
      if inner.len == 0 { inner = _clean_strip_unary_call(expr, "zext") }
      if inner.len == 0 { inner = _clean_strip_unary_call(expr, "sext") }
      if inner.len == 0 { return expr }
      expr = _clean_strip_outer_parens(inner)
      guard += 1
   }
   expr
}

fn _clean_low_byte_expr(str expr0) str {
   def expr = _clean_strip_outer_parens(expr0)
   mut p = _clean_top_level_find(expr, " ^^ ")
   mut plen = 4
   if p < 0 {
      p = _clean_top_level_find(expr, " ^ ")
      plen = 3
   }
   if p < 0 { return "" }
   def left = _clean_byte_castless_value(slice(expr, 0, p, 1))
   def right = _clean_byte_castless_value(slice(expr, p + plen, expr.len, 1))
   if left.len == 0 || right.len == 0 { return "" }
   left + " ^^ " + right
}

fn _clean_byte_at_low_expr(str rhs0) str {
   def rhs = str.strip(rhs0)
   if _clean_call_end_at(rhs, 0, "byte_at") != rhs.len { return "" }
   def args = _clean_call_args(slice(rhs, 8, rhs.len - 1, 1))
   if args.len != 2 || !_clean_zero_operand(args[1]) { return "" }
   _clean_low_byte_expr(args[0])
}

fn _clean_simplify_rendered_byte_stores(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_any_assignment_parts(lines[i])
      if parts.len > 0 && str.find(parts.get("lhs", ""), "[") >= 0 {
         def low = _clean_byte_at_low_expr(parts.get("rhs", ""))
         if low.len > 0 {
            b = str.builder_append(b, _clean_line_indent(lines[i]) + parts.get("lhs", "") + " = " + low + "\n")
            changed = true
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_rendered_byteish_expr(str expr0) bool {
   def expr = str.strip(expr0)
   if expr.len == 0 { return false }
   str.find(expr, "[") >= 0 || str.startswith(expr, "byte_at(") ||
   str.startswith(expr, "mem(") || str.startswith(expr, "mem_fs(") ||
   str.startswith(expr, "mem_gs(") || str.startswith(expr, "data_")
}

fn _clean_simplify_rendered_byte_casts(str text) str {
   mut b = str.Builder(text.len)
   mut changed = false
   mut quote = 0
   mut i = 0
   while i < text.len {
      def ch = load8(text, i)
      if quote != 0 {
         b = str.builder_append(b, chr(ch))
         if ch == 92 && i + 1 < text.len {
            i += 1
            b = str.builder_append(b, chr(load8(text, i)))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         b = str.builder_append(b, chr(ch))
         i += 1
         continue
      }
      if i + 6 <= text.len && slice(text, i, i + 6, 1) == "zext8(" {
         def end = _clean_call_end_at(text, i, "zext8")
         if end > 0 {
            def inner = str.strip(slice(text, i + 6, end - 1, 1))
            if (_clean_rendered_byteish_expr(inner) &&
               str.find(inner, " ^^ ") < 0 && str.find(inner, " & ") < 0 &&
               str.find(inner, " | ") < 0 && str.find(inner, " << ") < 0 &&
               str.find(inner, " >> ") < 0){
               b = str.builder_append(b, inner)
               changed = true
               i = end
               continue
            }
         }
      }
      if i + 5 <= text.len && slice(text, i, i + 5, 1) == "sext(" {
         def end = _clean_call_end_at(text, i, "sext")
         if end > 0 {
            def inner = _clean_strip_outer_balanced_parens(str.strip(slice(text, i + 5, end - 1, 1)))
            if (_clean_rendered_byteish_expr(inner) &&
               str.find(inner, " ^^ ") < 0 && str.find(inner, " & ") < 0 &&
               str.find(inner, " | ") < 0 && str.find(inner, " << ") < 0 &&
               str.find(inner, " >> ") < 0){
               b = str.builder_append(b, "sext8(" + inner + ")")
               changed = true
               i = end
               continue
            }
         }
      }
      b = str.builder_append(b, chr(ch))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_if_tail_op_needs_wrap(str expr) bool {
   str.find(expr, ") + ") >= 0 || str.find(expr, ") - ") >= 0 ||
   str.find(expr, ") * ") >= 0 || str.find(expr, ") / ") >= 0 ||
   str.find(expr, ") == ") >= 0 || str.find(expr, ") != ") >= 0 ||
   str.find(expr, ") < ") >= 0 || str.find(expr, ") > ") >= 0 ||
   str.find(expr, ") <= ") >= 0 || str.find(expr, ") >= ") >= 0
}

fn _clean_repair_if_tail_ops(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      if str.startswith(raw, "if (") && str.endswith(raw, "{") {
         def head = str.strip(slice(raw, 0, raw.len - 1, 1))
         if !str.endswith(head, ")") {
            def expr = str.strip(slice(raw, 3, raw.len - 1, 1))
            if _clean_if_tail_op_needs_wrap(expr) {
               b = str.builder_append(b, _clean_line_indent(lines[i]) + "if ((" + expr + "){" + "\n")
               changed = true
               i += 1
               continue
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_rendered_index_rhs_safe(str rhs) bool {
   _clean_rendered_pure_temp_rhs(rhs) &&
   str.find(rhs, "mem(") < 0 && str.find(rhs, "[") < 0
}

fn _clean_rendered_width_alias_rhs(str lhs0, str rhs0) bool {
   def lhs = str.strip(lhs0)
   def rhs = str.strip(rhs0)
   if (_symbol_token_ok(rhs) && str.lower(lhs) != str.lower(rhs) &&
      _symbols_intersect(_slice_symbol_aliases(lhs), _slice_symbol_aliases(rhs))){
      return true
   }
   def wrappers = ["sext", "zext", "sext8", "zext8", "sext16", "zext16", "sext32", "zext32"]
   mut i = 0
   while i < wrappers.len {
      def inner = _clean_strip_unary_call(rhs, wrappers[i])
      if (inner.len > 0 && _symbol_token_ok(str.strip(inner)) &&
         _symbols_intersect(_slice_symbol_aliases(lhs), _slice_symbol_aliases(str.strip(inner)))){
         return true
      }
      i += 1
   }
   false
}

fn _clean_rendered_rhs_redefined_between(list lines, int start, int end, str rhs) bool {
   def syms = _append_all_unique(_symbols_from_text(rhs), _slice_operand_symbols(rhs))
   if syms.len == 0 { return false }
   mut i = max(0, start)
   while i < end && i < lines.len {
      def parts = _clean_rendered_assignment_parts(lines[i])
      if parts.len > 0 && _symbols_intersect(_slice_symbol_aliases(parts.get("lhs", "")), syms) {
         return true
      }
      i += 1
   }
   false
}

fn _clean_rendered_addr_base_score(str expr0) int {
   def expr = _clean_strip_outer_parens(expr0)
   if expr.len == 0 { return 0 }
   if str.find(expr, "[") >= 0 { return 6 }
   if (str.find(expr, " * ") >= 0 || str.find(expr, "*") >= 0 ||
      str.find(expr, " / ") >= 0 || str.find(expr, " % ") >= 0 ||
      str.find(expr, "<<") >= 0 || str.find(expr, ">>") >= 0){ return 1 }
   if str.startswith(expr, "&") { return 5 }
   if str.startswith(expr, "arg") { return 5 }
   if str.startswith(expr, "local_") || str.startswith(expr, "stack_") { return 4 }
   def e = str.lower(expr)
   if (e == "rdi" || e == "rsi" || e == "rdx" || e == "rcx" ||
      e == "rbx" || e == "rax" || e == "x0" || e == "x1" ||
      e == "x2" || e == "x3"){ return 3 }
   2
}

fn _clean_rendered_index_base_expr(str base0) str {
   def base = str.strip(base0)
   if str.startswith(base, "&") {
      def inner = str.strip(slice(base, 1, base.len, 1))
      if str.startswith(inner, "local_") || str.startswith(inner, "stack_") || str.startswith(inner, "arg") {
         return inner
      }
   }
   base
}

fn _clean_rendered_index_expr(str base0, str idx0) str {
   def base = _clean_rendered_index_base_expr(base0)
   def idx = _clean_rendered_castless_index(idx0)
   if base.len == 0 || idx.len == 0 { return "" }
   if !_clean_balanced_delimiters(base) || !_clean_balanced_delimiters(idx) { return "" }
   base + "[" + idx + "]"
}

fn _clean_rendered_indexed_addr(str addr0) str {
   def addr = _clean_strip_outer_balanced_parens(addr0)
   if !_clean_balanced_delimiters(addr) { return "" }
   mut p = _clean_top_level_find(addr, " + ")
   if p > 0 {
      def left = str.strip(slice(addr, 0, p, 1))
      def right = str.strip(slice(addr, p + 3, addr.len, 1))
      def ls = _clean_rendered_addr_base_score(left)
      def rs = _clean_rendered_addr_base_score(right)
      if ls > rs && ls >= 3 { return _clean_rendered_index_expr(left, right) }
      if rs > ls && rs >= 3 { return _clean_rendered_index_expr(right, left) }
      return ""
   }
   p = _clean_top_level_find(addr, " - ")
   if p > 0 {
      def base = str.strip(slice(addr, 0, p, 1))
      def idx = str.strip(slice(addr, p + 3, addr.len, 1))
      if _clean_rendered_addr_base_score(base) >= 3 {
         return _clean_rendered_index_expr(base, "-" + idx)
      }
   }
   ""
}

fn _clean_rendered_mem_load_parts(str rhs0) dict {
   def rhs = str.strip(rhs0)
   mut wrapper = ""
   mut body = rhs
   def wrappers = ["zext8", "sext8", "zext16", "sext16", "zext32", "sext32", "zext", "sext"]
   mut wi = 0
   while wi < wrappers.len {
      def inner = _clean_strip_unary_call(rhs, wrappers[wi])
      if inner.len > 0 {
         wrapper = wrappers[wi]
         body = str.strip(inner)
         break
      }
      wi += 1
   }
   def mem_inner = _clean_strip_unary_call(body, "mem")
   if mem_inner.len == 0 { return dict() }
   {"ok": true, "wrapper": wrapper, "addr": str.strip(mem_inner)}
}

fn _clean_rendered_mem_indices_in_expr(str expr0) str {
   def expr = str.strip(expr0)
   if str.find(expr, "mem(") < 0 { return expr0 }
   mut out = ""
   mut changed = false
   mut i = 0
   while i < expr.len {
      if (i + 4 <= expr.len && slice(expr, i, i + 4, 1) == "mem(" &&
         (i == 0 || !_clean_token_char(load8(expr, i - 1)))){
         mut j = i + 4
         mut depth = 1
         while j < expr.len && depth > 0 {
            def ch = load8(expr, j)
            if ch == 40 { depth += 1 }
            elif ch == 41 { depth -= 1 }
            j += 1
         }
         if depth == 0 {
            def inner = slice(expr, i + 4, j - 1, 1)
            def indexed = _clean_rendered_indexed_addr(inner)
            if indexed.len > 0 {
               out = out + indexed
               changed = true
            } else {
               out = out + slice(expr, i, j, 1)
            }
            i = j
            continue
         }
      }
      out = out + chr(load8(expr, i))
      i += 1
   }
   changed ? out : expr0
}

fn _clean_rendered_mem_indices_text(str text) str {
   mut b = str.Builder(text.len)
   mut changed = false
   mut quote = 0
   mut i = 0
   while i < text.len {
      def ch = load8(text, i)
      if quote != 0 {
         b = str.builder_append(b, chr(ch))
         if ch == 92 && i + 1 < text.len {
            i += 1
            b = str.builder_append(b, chr(load8(text, i)))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         b = str.builder_append(b, chr(ch))
         i += 1
         continue
      }
      if (i + 4 <= text.len && slice(text, i, i + 4, 1) == "mem(" &&
         (i == 0 || !_clean_token_char(load8(text, i - 1)))){
         mut j = i + 4
         mut depth = 1
         while j < text.len && depth > 0 {
            def cj = load8(text, j)
            if cj == 40 { depth += 1 }
            elif cj == 41 { depth -= 1 }
            j += 1
         }
         if depth == 0 {
            def inner = slice(text, i + 4, j - 1, 1)
            def indexed = _clean_rendered_indexed_addr(inner)
            if indexed.len > 0 {
               b = str.builder_append(b, indexed)
               changed = true
            } else {
               b = str.builder_append(b, slice(text, i, j, 1))
            }
            i = j
            continue
         }
      }
      b = str.builder_append(b, chr(ch))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_literal_cast_keeps_value(str name, int value) bool {
   if str.startswith(name, "zext") { return value >= 0 }
   if name == "sext" { return true }
   if name == "sext8" { return value >= -0x80 && value <= 0x7f }
   if name == "sext16" { return value >= -0x8000 && value <= 0x7fff }
   if name == "sext32" { return value >= -0x80000000 && value <= 0x7fffffff }
   false
}

fn _clean_simplify_rendered_literal_casts(str text) str {
   mut b = str.Builder(text.len)
   mut changed = false
   mut quote = 0
   mut i = 0
   def names = ["sext32", "zext32", "sext16", "zext16", "sext8", "zext8", "sext", "zext"]
   while i < text.len {
      def ch = load8(text, i)
      if quote != 0 {
         b = str.builder_append(b, chr(ch))
         if ch == 92 && i + 1 < text.len {
            i += 1
            b = str.builder_append(b, chr(load8(text, i)))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         b = str.builder_append(b, chr(ch))
         i += 1
         continue
      }
      mut matched = false
      mut ni = 0
      while ni < names.len {
         def name = names[ni]
         def prefix = name + "("
         if (i + prefix.len <= text.len && slice(text, i, i + prefix.len, 1) == prefix &&
            (i == 0 || !_clean_token_char(load8(text, i - 1)))){
            def end = _clean_call_end_at(text, i, name)
            if end > 0 {
               def inner = str.strip(slice(text, i + prefix.len, end - 1, 1))
               def lit = _clean_literal_int_value(inner)
               if lit.get("ok", false) && _clean_literal_cast_keeps_value(name, int(lit.get("value", 0))) {
                  b = str.builder_append(b, _clean_small_int_text(int(lit.get("value", 0))))
                  changed = true
                  i = end
                  matched = true
                  break
               }
            }
         }
         ni += 1
      }
      if matched { continue }
      b = str.builder_append(b, chr(ch))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_exit_status_arg(str arg0) str {
   def arg = str.strip(arg0)
   if (arg == "data_ffffffff" || arg == "0xffffffff" ||
      arg == "data_ffffffffffffffff" || arg == "0xffffffffffffffff"){
      return "-1"
   }
   arg
}

fn _clean_simplify_status_literals(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      mut out = lines[i]
      if str.startswith(raw, "return ") {
         def ret = str.strip(slice(raw, 7, raw.len, 1))
         def clean_ret = _clean_exit_status_arg(ret)
         if clean_ret != ret {
            out = _clean_line_indent(lines[i]) + "return " + clean_ret
            changed = true
         }
      }
      def names = ["exit", "_exit"]
      mut ni = 0
      while ni < names.len {
         def name = names[ni]
         def prefix = name + "("
         if str.startswith(raw, prefix) && str.endswith(raw, ")") {
            def arg = str.strip(slice(raw, prefix.len, raw.len - 1, 1))
            if str.find(arg, ",") < 0 {
               def clean = _clean_exit_status_arg(arg)
               if clean != arg {
                  out = _clean_line_indent(lines[i]) + name + "(" + clean + ")"
                  changed = true
               }
            }
         }
         ni += 1
      }
      b = str.builder_append(b, out + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_rendered_wrap_load(str wrapper, str expr) str {
   wrapper.len > 0 ? wrapper + "(" + expr + ")" : expr
}

fn _clean_rendered_resolve_self_addr(list lines, int idx, str lhs, str rhs0) dict {
   def rhs = str.strip(rhs0)
   if !_clean_render_text_has_alias(rhs, lhs) { return {"expr": rhs, "skip": []} }
   def k = _clean_prev_nonblank_index(lines, idx - 1)
   if k < 0 { return {"expr": rhs, "skip": []} }
   def base = _clean_rendered_assignment_parts(lines[k])
   if base.len == 0 { return {"expr": rhs, "skip": []} }
   if !_symbols_intersect(_slice_symbol_aliases(base.get("lhs", "")), _slice_symbol_aliases(lhs)) {
      return {"expr": rhs, "skip": []}
   }
   if !_clean_rendered_pure_temp_rhs(base.get("rhs", "")) { return {"expr": rhs, "skip": []} }
   {"expr": _clean_replace_aliases_text(rhs, _slice_symbol_aliases(lhs),
         _clean_rendered_inline_rhs(base.get("rhs", ""))), "skip": [k]}
}

fn _clean_rendered_address_loads(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut i = 0
   while i < lines.len {
      def parts = _clean_rendered_assignment_parts(lines[i])
      if parts.len > 0 {
         def load = _clean_rendered_mem_load_parts(parts.get("rhs", ""))
         if load.get("ok", false) {
            def addr = load.get("addr", "")
            mut addr_parts = _clean_rendered_assignment_parts("")
            if _symbol_token_ok(addr) {
               def j = _clean_prev_nonblank_index(lines, i - 1)
               if j >= 0 {
                  addr_parts = _clean_rendered_assignment_parts(lines[j])
                  if (addr_parts.len > 0 &&
                     _symbols_intersect(_slice_symbol_aliases(addr_parts.get("lhs", "")), _slice_symbol_aliases(addr)) &&
                     _clean_rendered_pure_temp_rhs(addr_parts.get("rhs", ""))){
                     def resolved = _clean_rendered_resolve_self_addr(lines, j,
                        addr_parts.get("lhs", ""), addr_parts.get("rhs", ""))
                     def indexed = _clean_rendered_indexed_addr(resolved.get("expr", addr_parts.get("rhs", "")))
                     if indexed.len > 0 {
                        replace = replace.set(to_str(i), _clean_line_indent(lines[i]) + parts.get("lhs", "") +
                           " = " + _clean_rendered_wrap_load(load.get("wrapper", ""), indexed))
                        def skips = resolved.get("skip", [])
                        mut si = 0
                        while si < skips.len {
                           skip = skip.set(to_str(skips[si]), true)
                           si += 1
                        }
                        skip = skip.set(to_str(j), true)
                     }
                  }
               }
            } else {
               def indexed_direct = _clean_rendered_indexed_addr(addr)
               if indexed_direct.len > 0 {
                  replace = replace.set(to_str(i), _clean_line_indent(lines[i]) + parts.get("lhs", "") +
                     " = " + _clean_rendered_wrap_load(load.get("wrapper", ""), indexed_direct))
               }
            }
         }
      }
      i += 1
   }
   if skip.len == 0 && replace.len == 0 { return _clean_rendered_condition_index_temps(text) }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if skip.get(to_str(i), false) {
         i += 1
         continue
      }
      b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_rendered_address_store_lhs(str lhs0, str reg0, str addr0) str {
   def lhs = str.strip(lhs0)
   def reg = str.strip(reg0)
   def addr = str.strip(addr0)
   if lhs.len == 0 || reg.len == 0 || addr.len == 0 { return "" }
   def lower_lhs = str.lower(lhs)
   def indexed_prefix = str.lower(reg) + "["
   if str.startswith(lower_lhs, indexed_prefix) && str.endswith(lhs, "]") {
      def idx = str.strip(slice(lhs, indexed_prefix.len, lhs.len - 1, 1))
      if idx.len > 0 { return addr + "[" + idx + "]" }
   }
   def inner0 = _clean_strip_unary_call(lhs, "mem")
   if inner0.len == 0 { return "" }
   def inner = _clean_strip_outer_parens(inner0)
   if !_clean_render_text_has_alias(inner, reg) { return "" }
   def replaced = _clean_replace_aliases_text(inner, _slice_symbol_aliases(reg),
      _clean_expr_subst_wrap(addr))
   "mem(" + replaced + ")"
}

fn _clean_address_temp_rhs_inlineable(str rhs0) bool {
   def rhs = str.strip(rhs0)
   if rhs.len == 0 || !_clean_rendered_pure_temp_rhs(rhs) { return false }
   str.startswith(rhs, "data_") || str.startswith(rhs, "str_") ||
   str.startswith(rhs, "&") || str.startswith(rhs, "0x")
}

fn _clean_inline_address_temp_stores(str text) str {
   mut lines = str.split(text, "\n")
   mut skip = dict()
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def temp = _clean_rendered_assignment_parts(lines[i])
      if (temp.len == 0 || !_clean_rendered_value_temp_reg(temp.get("lhs", "")) ||
         !_clean_address_temp_rhs_inlineable(temp.get("rhs", ""))){
         i += 1
         continue
      }
      def j = _clean_next_nonblank_index(lines, i + 1)
      if j >= lines.len || _clean_line_indent(lines[j]) != _clean_line_indent(lines[i]) {
         i += 1
         continue
      }
      def mem = _clean_any_assignment_parts(lines[j])
      if mem.len == 0 || _clean_render_text_has_alias(mem.get("rhs", ""), temp.get("lhs", "")) {
         i += 1
         continue
      }
      def lhs = _clean_rendered_address_store_lhs(mem.get("lhs", ""), temp.get("lhs", ""), temp.get("rhs", ""))
      if lhs.len == 0 || !_clean_temp_dead_after_store(lines, j, temp.get("lhs", "")) {
         i += 1
         continue
      }
      lines = lines.set(j, _clean_line_indent(lines[j]) + lhs + " = " + mem.get("rhs", ""))
      skip = skip.set(to_str(i), true)
      changed = true
      i += 1
   }
   if !changed { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) { b = str.builder_append(b, lines[i] + "\n") }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_resolve_rendered_index_expr(list lines, int use_idx, str expr0) dict {
   mut expr = str.strip(expr0)
   mut candidates = []
   mut j = use_idx - 1
   mut guard = 0
   while j >= 0 && guard < 10 {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j -= 1
         continue
      }
      if (_clean_rendered_label_name(raw).len > 0 || _clean_raw_goto_label(raw).len > 0 ||
         _clean_rendered_is_return(raw) || str.startswith(raw, "while (") ||
         str.startswith(raw, "switch(") || raw == "}" || raw == "} else {"){
         break
      }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len == 0 { break }
      def lhs = parts.get("lhs", "")
      def rhs = parts.get("rhs", "")
      if _clean_render_text_has_alias(expr, lhs) {
         if (!_clean_rendered_temp_reg(lhs) || !_clean_rendered_index_rhs_safe(rhs) ||
            (_clean_render_text_has_alias(rhs, lhs) && !_clean_rendered_width_alias_rhs(lhs, rhs))){
            break
         }
         if _clean_rendered_rhs_redefined_between(lines, j + 1, use_idx, rhs) { break }
         expr = _clean_replace_aliases_text(expr, _slice_symbol_aliases(lhs),
            _clean_rendered_inline_rhs(rhs))
         candidates = candidates.append({"idx": j, "lhs": lhs})
         guard += 1
      }
      j -= 1
   }
   {"expr": _clean_expr_is_boolish(expr) ? expr : _clean_rendered_castless_index(expr), "candidates": candidates}
}

fn _clean_index_candidate_skip_ok(list lines, int use_idx, str use_lhs, dict candidate, dict candidate_map) bool {
   def lhs = candidate.get("lhs", "")
   if lhs.len == 0 { return false }
   mut j = int(candidate.get("idx", 0)) + 1
   while j < use_idx {
      if !candidate_map.get(to_str(j), false) && _clean_render_text_has_alias(lines[j], lhs) {
         return false
      }
      j += 1
   }
   if _symbols_intersect(_slice_symbol_aliases(use_lhs), _slice_symbol_aliases(lhs)) { return true }
   _clean_rendered_temp_dead_after(lines, use_idx, lhs)
}

fn _clean_index_candidate_skip_map(list lines, int use_idx, str use_lhs, list candidates) dict {
   mut candidate_map = dict()
   mut i = 0
   while i < candidates.len {
      candidate_map = candidate_map.set(to_str(candidates[i].get("idx", -1)), true)
      i += 1
   }
   mut skip = dict()
   i = 0
   while i < candidates.len {
      def cand = candidates[i]
      if _clean_index_candidate_skip_ok(lines, use_idx, use_lhs, cand, candidate_map) {
         skip = skip.set(to_str(cand.get("idx", -1)), true)
      }
      i += 1
   }
   skip
}

fn _clean_resolve_rendered_bracket_indices(list lines, int use_idx, str rhs0) dict {
   def rhs = str.strip(rhs0)
   mut out = ""
   mut candidates = []
   mut changed = false
   mut i = 0
   while i < rhs.len {
      if load8(rhs, i) == 91 {
         mut j = i + 1
         mut depth = 1
         while j < rhs.len && depth > 0 {
            def ch = load8(rhs, j)
            if ch == 91 { depth += 1 }
            elif ch == 93 { depth -= 1 }
            j += 1
         }
         if depth == 0 {
            def inner = slice(rhs, i + 1, j - 1, 1)
            def resolved = _clean_resolve_rendered_index_expr(lines, use_idx, inner)
            def next_inner = resolved.get("expr", str.strip(inner))
            out = out + "[" + next_inner + "]"
            if next_inner != str.strip(inner) { changed = true }
            def cs = resolved.get("candidates", [])
            mut ci = 0
            while ci < cs.len {
               candidates = candidates.append(cs[ci])
               ci += 1
            }
            i = j
            continue
         }
      }
      out = out + chr(load8(rhs, i))
      i += 1
   }
   {"rhs": changed ? out : rhs0, "changed": changed, "candidates": candidates}
}

fn _clean_condition_expr_parts(str line) dict {
   def raw = str.strip(line)
   def open = _clean_structured_if_open_parts(raw)
   if open.len > 0 { return {"expr": open.get("expr", ""), "kind": "open"} }
   def inline = _clean_inline_if_parts(raw)
   if inline.len > 0 { return {"expr": inline.get("expr", ""), "kind": "inline", "tail": inline.get("tail", "")} }
   def parts = _clean_if_goto_parts(raw)
   if parts.len > 0 { return {"expr": parts.get("expr", ""), "kind": "goto", "target": parts.get("target", "")} }
   dict()
}

fn _clean_condition_expr_line(str line, dict parts, str expr) str {
   def pad = _clean_line_indent(line)
   def kind = parts.get("kind", "")
   if kind == "open" { return pad + "if " + expr + "{" }
   if kind == "inline" { return pad + "if (" + expr + ")" + parts.get("tail", "") }
   if kind == "goto" { return pad + "if " + expr + "{ goto " + parts.get("target", "") + " }" }
   ""
}

fn _clean_rendered_condition_index_temps(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut i = 0
   while i < lines.len {
      def parts = _clean_condition_expr_parts(lines[i])
      if parts.len > 0 {
         def resolved = _clean_resolve_rendered_index_expr(lines, i, parts.get("expr", ""))
         def expr0 = _clean_rendered_mem_indices_in_expr(resolved.get("expr", parts.get("expr", "")))
         def bracket = _clean_resolve_rendered_bracket_indices(lines, i, expr0)
         def expr = bracket.get("rhs", expr0)
         if expr != parts.get("expr", "") {
            def line = _clean_condition_expr_line(lines[i], parts, expr)
            if line.len > 0 {
               replace = replace.set(to_str(i), line)
               def local_skip = _clean_index_candidate_skip_map(lines, i, "",
                  resolved.get("candidates", []) + bracket.get("candidates", []))
               def keys = local_skip.keys()
               mut ki = 0
               while ki < keys.len {
                  skip = skip.set(to_str(keys[ki]), true)
                  ki += 1
               }
            }
         }
      }
      i += 1
   }
   if skip.len == 0 && replace.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if skip.get(to_str(i), false) {
         i += 1
         continue
      }
      b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_inline_index_value_condition_candidate(str lhs0, str rhs0) bool {
   def lhs = str.strip(lhs0)
   def rhs = str.strip(rhs0)
   _clean_rendered_temp_reg(lhs) && str.find(rhs, "[") >= 0 &&
   _clean_rendered_pure_temp_rhs(rhs) && !_clean_render_text_has_alias(rhs, lhs)
}

fn _clean_inline_index_value_conditions(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   mut changed = false
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def assign = _clean_rendered_assignment_parts(lines[i])
      if (assign.len > 0 &&
         _clean_inline_index_value_condition_candidate(assign.get("lhs", ""), assign.get("rhs", ""))){
         def j = _clean_next_nonblank_index(lines, i + 1)
         if (j < lines.len && _clean_line_indent(lines[j]) == _clean_line_indent(lines[i]) &&
            _clean_rendered_temp_dead_after(lines, j, assign.get("lhs", ""))){
            def cond = _clean_condition_expr_parts(lines[j])
            if cond.len > 0 && _clean_render_text_has_token(cond.get("expr", ""), assign.get("lhs", "")) {
               def expr = _clean_replace_token(cond.get("expr", ""), assign.get("lhs", ""),
                  _clean_inline_condition_copy_rhs(assign.get("rhs", "")))
               def line = _clean_condition_expr_line(lines[j], cond, expr)
               if line.len > 0 {
                  changed = true
                  b = str.builder_append(b, line + "\n")
                  i = j + 1
                  continue
               }
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_scaled_index_expr(str expr0, int scale) str {
   def expr = _clean_strip_outer_parens(expr0)
   mut p = _clean_top_level_find(expr, " * ")
   mut plen = 3
   if p < 0 {
      p = _clean_top_level_find(expr, "*")
      plen = 1
   }
   if p < 0 { return "" }
   def left = str.strip(slice(expr, 0, p, 1))
   def right = str.strip(slice(expr, p + plen, expr.len, 1))
   if _looks_int_literal(right) && _parse_int_piece(right) == scale {
      return _clean_rendered_castless_index(left)
   }
   if _looks_int_literal(left) && _parse_int_piece(left) == scale {
      return _clean_rendered_castless_index(right)
   }
   ""
}

fn _clean_normalize_local_i32_indices(str text) str {
   mut b = str.Builder(text.len)
   mut changed = false
   mut quote = 0
   mut i = 0
   while i < text.len {
      def ch = load8(text, i)
      if quote != 0 {
         b = str.builder_append(b, chr(ch))
         if ch == 92 && i + 1 < text.len {
            i += 1
            b = str.builder_append(b, chr(load8(text, i)))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         b = str.builder_append(b, chr(ch))
         i += 1
         continue
      }
      if _symbol_is_name_char(ch) {
         def start = i
         while i < text.len && _symbol_is_name_char(load8(text, i)) { i += 1 }
         def tok = slice(text, start, i, 1)
         if str.startswith(tok, "local_") && i < text.len && load8(text, i) == 91 {
            mut j = i + 1
            mut depth = 1
            while j < text.len && depth > 0 {
               def c = load8(text, j)
               if c == 91 { depth += 1 }
               elif c == 93 { depth -= 1 }
               j += 1
            }
            if depth == 0 {
               def inner = slice(text, i + 1, j - 1, 1)
               def scaled = _clean_scaled_index_expr(inner, 4)
               if scaled.len > 0 {
                  b = str.builder_append(b, tok + "[" + scaled + "]")
                  changed = true
                  i = j
                  continue
               }
            }
         }
         b = str.builder_append(b, tok)
         continue
      }
      b = str.builder_append(b, chr(ch))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_rendered_index_temp_chains(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut i = 0
   while i < lines.len {
      def parts = _clean_any_assignment_parts(lines[i])
      if parts.len > 0 && (str.find(parts.get("lhs", ""), "[") >= 0 || str.find(parts.get("rhs", ""), "[") >= 0) {
         mut lhs = parts.get("lhs", "")
         mut rhs = parts.get("rhs", "")
         mut candidates = []
         mut changed = false
         if str.find(lhs, "[") >= 0 {
            def resolved_lhs = _clean_resolve_rendered_bracket_indices(lines, i, lhs)
            if resolved_lhs.get("changed", false) {
               lhs = resolved_lhs.get("rhs", lhs)
               candidates = candidates + resolved_lhs.get("candidates", [])
               changed = true
            }
         }
         if str.find(rhs, "[") >= 0 {
            def resolved_rhs = _clean_resolve_rendered_bracket_indices(lines, i, rhs)
            if resolved_rhs.get("changed", false) {
               rhs = resolved_rhs.get("rhs", rhs)
               candidates = candidates + resolved_rhs.get("candidates", [])
               changed = true
            }
         }
         if changed {
            replace = replace.set(to_str(i), _clean_line_indent(lines[i]) + lhs + " = " + rhs)
            def simple_lhs = _clean_rendered_assignment_parts(lines[i])
            def skip_lhs = simple_lhs.len > 0 ? simple_lhs.get("lhs", "") : ""
            def local_skip = _clean_index_candidate_skip_map(lines, i, skip_lhs, candidates)
            def keys = local_skip.keys()
            mut ki = 0
            while ki < keys.len {
               skip = skip.set(to_str(keys[ki]), true)
               ki += 1
            }
         }
      }
      i += 1
   }
   if skip.len == 0 && replace.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if skip.get(to_str(i), false) {
         i += 1
         continue
      }
      b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   _clean_rendered_condition_index_temps(out)
}

fn _clean_sub_condition_window_expr(list lines, int i) dict {
   def a_idx = _clean_next_nonblank_index(lines, i)
   if a_idx >= lines.len { return dict() }
   def b_idx = _clean_next_nonblank_index(lines, a_idx + 1)
   def c_idx = _clean_next_nonblank_index(lines, b_idx + 1)
   def d_idx = _clean_next_nonblank_index(lines, c_idx + 1)
   def cond_idx = _clean_next_nonblank_index(lines, d_idx + 1)
   if cond_idx >= lines.len { return dict() }
   def a = _clean_rendered_assignment_parts(lines[a_idx])
   def b = _clean_rendered_assignment_parts(lines[b_idx])
   def c = _clean_rendered_assignment_parts(lines[c_idx])
   def d = _clean_rendered_assignment_parts(lines[d_idx])
   if a.len == 0 || b.len == 0 || c.len == 0 || d.len == 0 { return dict() }
   if (!_clean_rendered_temp_reg(a.get("lhs", "")) || !_clean_rendered_temp_reg(b.get("lhs", "")) ||
      !_clean_rendered_temp_reg(c.get("lhs", "")) || !_clean_rendered_temp_reg(d.get("lhs", ""))){
      return dict()
   }
   if (!_clean_rendered_pure_temp_rhs(a.get("rhs", "")) || !_clean_rendered_pure_temp_rhs(b.get("rhs", "")) ||
      !_clean_rendered_pure_temp_rhs(c.get("rhs", "")) || !_clean_rendered_pure_temp_rhs(d.get("rhs", ""))){
      return dict()
   }
   if !_symbols_intersect(_slice_symbol_aliases(b.get("lhs", "")), _slice_symbol_aliases(d.get("lhs", ""))) {
      return dict()
   }
   if !_clean_render_text_has_alias(b.get("rhs", ""), a.get("lhs", "")) { return dict() }
   def parts = _clean_rendered_binary_expr_parts(d.get("rhs", ""))
   if parts.len == 0 || parts.get("op", "") != " - " { return dict() }
   if (!_clean_render_text_has_alias(parts.get("lhs", ""), d.get("lhs", "")) ||
      !_clean_render_text_has_alias(parts.get("rhs", ""), c.get("lhs", ""))){
      return dict()
   }
   def left = _clean_replace_aliases_text(b.get("rhs", ""), _slice_symbol_aliases(a.get("lhs", "")),
      _clean_rendered_inline_rhs(a.get("rhs", "")))
   def right = _clean_simplify_nested_ext_expr(c.get("rhs", ""))
   def clean_left = _clean_simplify_nested_ext_expr(left)
   def expr = "(" + clean_left + " - " + right + ")"
   def rewritten = _clean_rewrite_condition_line(lines[cond_idx], d.get("lhs", ""), expr)
   if rewritten.len == 0 { return dict() }
   if (!_clean_rendered_temp_dead_after(lines, cond_idx, a.get("lhs", "")) ||
      !_clean_rendered_temp_dead_after(lines, cond_idx, b.get("lhs", "")) ||
      !_clean_rendered_temp_dead_after(lines, cond_idx, c.get("lhs", "")) ||
      !_clean_rendered_temp_dead_after(lines, cond_idx, d.get("lhs", ""))){
      return dict()
   }
   {"ok": true, "a": a_idx, "b": b_idx, "c": c_idx, "d": d_idx, "cond": cond_idx, "line": rewritten}
}

fn _clean_inline_sub_condition_windows(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut i = 0
   while i < lines.len {
      def win = _clean_sub_condition_window_expr(lines, i)
      if win.get("ok", false) {
         skip = skip.set(to_str(win.get("a", -1)), true)
         skip = skip.set(to_str(win.get("b", -1)), true)
         skip = skip.set(to_str(win.get("c", -1)), true)
         skip = skip.set(to_str(win.get("d", -1)), true)
         replace = replace.set(to_str(win.get("cond", -1)), win.get("line", ""))
         i = int(win.get("cond", i)) + 1
         continue
      }
      i += 1
   }
   if skip.len == 0 && replace.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if skip.get(to_str(i), false) {
         i += 1
         continue
      }
      b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_rendered_index_expr_parts(str expr0) dict {
   def expr = str.strip(expr0)
   mut depth = 0
   mut quote = 0
   mut open = -1
   mut i = 0
   while i < expr.len {
      def ch = load8(expr, i)
      if quote != 0 {
         if ch == 92 && i + 1 < expr.len { i += 2 continue }
         if ch == quote { quote = 0 }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         i += 1
         continue
      }
      if ch == 40 { depth += 1 }
      elif ch == 41 && depth > 0 { depth -= 1 }
      elif ch == 91 && depth == 0 {
         open = i
         break
      }
      i += 1
   }
   if open <= 0 { return dict() }
   mut j = open + 1
   mut bdepth = 1
   quote = 0
   while j < expr.len && bdepth > 0 {
      def ch = load8(expr, j)
      if quote != 0 {
         if ch == 92 && j + 1 < expr.len { j += 2 continue }
         if ch == quote { quote = 0 }
         j += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         j += 1
         continue
      }
      if ch == 91 { bdepth += 1 }
      elif ch == 93 { bdepth -= 1 }
      j += 1
   }
   if bdepth != 0 || j != expr.len { return dict() }
   def base = str.strip(slice(expr, 0, open, 1))
   def idx = str.strip(slice(expr, open + 1, j - 1, 1))
   if base.len == 0 || idx.len == 0 { return dict() }
   {"base": base, "idx": idx}
}

fn _clean_ptr_table_index(str idx0) str {
   def idx = _clean_strip_outer_parens(idx0)
   mut p = _clean_top_level_find(idx, " * ")
   mut plen = 3
   if p < 0 {
      p = _clean_top_level_find(idx, "*")
      plen = 1
   }
   if p > 0 {
      def left = str.strip(slice(idx, 0, p, 1))
      def right = str.strip(slice(idx, p + plen, idx.len, 1))
      def lv = _clean_literal_int_value(left)
      def rv = _clean_literal_int_value(right)
      if lv.get("ok", false) && (int(lv.get("value", 0)) == 8 || int(lv.get("value", 0)) == 4) {
         return _clean_rendered_castless_index(right)
      }
      if rv.get("ok", false) && (int(rv.get("value", 0)) == 8 || int(rv.get("value", 0)) == 4) {
         return _clean_rendered_castless_index(left)
      }
   }
   _clean_rendered_castless_index(idx)
}

fn _clean_argv_envp_scaled_index(str idx0) str {
   def idx = _clean_strip_outer_balanced_parens(idx0)
   if !_clean_balanced_delimiters(idx) { return "" }
   mut p = _clean_top_level_find(idx, " * ")
   mut plen = 3
   if p < 0 {
      p = _clean_top_level_find(idx, "*")
      plen = 1
   }
   if p <= 0 { return "" }
   def left = str.strip(slice(idx, 0, p, 1))
   def right = str.strip(slice(idx, p + plen, idx.len, 1))
   def lv = _clean_literal_int_value(left)
   if lv.get("ok", false) && (int(lv.get("value", 0)) == 4 || int(lv.get("value", 0)) == 8) {
      def out = _clean_rendered_castless_index(right)
      return _clean_balanced_delimiters(out) ? out : ""
   }
   def rv = _clean_literal_int_value(right)
   if rv.get("ok", false) && (int(rv.get("value", 0)) == 4 || int(rv.get("value", 0)) == 8) {
      def out = _clean_rendered_castless_index(left)
      return _clean_balanced_delimiters(out) ? out : ""
   }
   ""
}

fn _clean_normalize_scaled_indices_for_base(str text, str base) str {
   def needle = base + "["
   mut b = str.Builder(text.len)
   mut changed = false
   mut quote = 0
   mut i = 0
   while i < text.len {
      def ch = load8(text, i)
      if quote != 0 {
         b = str.builder_append(b, slice(text, i, i + 1, 1))
         if ch == 92 && i + 1 < text.len {
            i += 1
            b = str.builder_append(b, slice(text, i, i + 1, 1))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         b = str.builder_append(b, slice(text, i, i + 1, 1))
         i += 1
         continue
      }
      if (i + needle.len <= text.len && slice(text, i, i + needle.len, 1) == needle &&
         (i == 0 || !_symbol_is_name_char(load8(text, i - 1)))){
         def br = _clean_bracket_span_at(text, i + base.len)
         if br.get("ok", false) {
            def idx = _clean_argv_envp_scaled_index(br.get("expr", ""))
            if idx.len > 0 {
               b = str.builder_append(b, base + "[" + idx + "]")
               i = int(br.get("end", i + base.len + 1))
               changed = true
               continue
            }
         }
      }
      b = str.builder_append(b, slice(text, i, i + 1, 1))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_normalize_argv_envp_scaled_indices(str text) str {
   _clean_normalize_scaled_indices_for_base(_clean_normalize_scaled_indices_for_base(text, "argv"), "envp")
}

fn _clean_rewrite_ptr_table_refs(str line0, str lhs0, dict table) dict {
   def line = line0
   def lhs_aliases = _slice_symbol_aliases(lhs0)
   mut out = ""
   mut changed = false
   mut i = 0
   while i < line.len {
      def ch = load8(line, i)
      if _symbol_is_name_char(ch) {
         def start = i
         while i < line.len && _symbol_is_name_char(load8(line, i)) { i += 1 }
         def tok = slice(line, start, i, 1)
         if _list_has(lhs_aliases, str.lower(tok)) && i < line.len && load8(line, i) == 91 {
            mut j = i + 1
            mut depth = 1
            while j < line.len && depth > 0 {
               def cj = load8(line, j)
               if cj == 91 { depth += 1 }
               elif cj == 93 { depth -= 1 }
               j += 1
            }
            if depth == 0 {
               def inner = str.strip(slice(line, i + 1, j - 1, 1))
               out = out + table.get("base", "") + "[" + table.get("idx", "") + "][" +
               _clean_rendered_castless_index(inner) + "]"
               changed = true
               i = j
               continue
            }
         }
         out = out + tok
         continue
      }
      out = out + chr(ch)
      i += 1
   }
   {"changed": changed, "line": changed ? out : line0}
}

fn _clean_ptr_table_rhs(str rhs0) dict {
   def parts = _clean_rendered_index_expr_parts(rhs0)
   if parts.len == 0 { return dict() }
   def idx = parts.get("idx", "")
   if _clean_top_level_find(idx, " * ") < 0 && _clean_top_level_find(idx, "*") < 0 { return dict() }
   {"base": parts.get("base", ""), "idx": _clean_ptr_table_index(idx)}
}

fn _clean_fold_pointer_table_temps(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut i = 0
   while i < lines.len {
      def assign = _clean_rendered_assignment_parts(lines[i])
      if assign.len > 0 && _clean_rendered_temp_reg(assign.get("lhs", "")) {
         def table = _clean_ptr_table_rhs(assign.get("rhs", ""))
         if table.len > 0 {
            mut changed = false
            mut blocked = false
            mut j = i + 1
            while j < lines.len && !blocked {
               def raw = str.strip(lines[j])
               if raw.len == 0 {
                  j += 1
                  continue
               }
               def next_assign = _clean_rendered_assignment_parts(lines[j])
               if (next_assign.len > 0 &&
                  _symbols_intersect(_slice_symbol_aliases(next_assign.get("lhs", "")), _slice_symbol_aliases(assign.get("lhs", "")))){
                  break
               }
               def rew = _clean_rewrite_ptr_table_refs(lines[j], assign.get("lhs", ""), table)
               if rew.get("changed", false) {
                  replace = replace.set(to_str(j), rew.get("line", lines[j]))
                  changed = true
                  j += 1
                  continue
               }
               if _clean_render_text_has_alias(lines[j], assign.get("lhs", "")) {
                  blocked = true
                  break
               }
               if _clean_rendered_is_return(raw) { break }
               j += 1
            }
            if changed && !blocked {
               skip = skip.set(to_str(i), true)
            }
         }
      }
      i += 1
   }
   if skip.len == 0 && replace.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if skip.get(to_str(i), false) {
         i += 1
         continue
      }
      b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_normalize_inline_pointer_table_refs(str text) str {
   mut b = str.Builder(text.len)
   mut changed = false
   mut quote = 0
   mut i = 0
   while i < text.len {
      def ch = load8(text, i)
      if quote != 0 {
         b = str.builder_append(b, chr(ch))
         if ch == 92 && i + 1 < text.len {
            i += 1
            b = str.builder_append(b, chr(load8(text, i)))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         b = str.builder_append(b, chr(ch))
         i += 1
         continue
      }
      if ch == 40 {
         mut j = i + 1
         mut depth = 1
         while j < text.len && depth > 0 {
            def cj = load8(text, j)
            if cj == 40 { depth += 1 }
            elif cj == 41 { depth -= 1 }
            j += 1
         }
         if depth == 0 && j < text.len && load8(text, j) == 91 {
            def inner = str.strip(slice(text, i + 1, j - 1, 1))
            def table = _clean_ptr_table_rhs(inner)
            if table.len > 0 {
               def br = _clean_bracket_span_at(text, j)
               if br.get("ok", false) {
                  b = str.builder_append(b, table.get("base", "") + "[" + table.get("idx", "") + "][" +
                     _clean_rendered_castless_index(br.get("expr", "")) + "]")
                  i = int(br.get("end", j + 1))
                  changed = true
                  continue
               }
            }
         }
      }
      b = str.builder_append(b, chr(ch))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   _clean_normalize_inline_pointer_table_refs_close(changed ? out : text)
}

fn _clean_normalize_inline_pointer_table_refs_close(str text) str {
   mut out = text
   mut changed = false
   mut p = str.find(out, ")[")
   mut guard = 0
   while p >= 0 && guard < 128 {
      mut start = -1
      mut depth = 0
      mut k = p
      while k >= 0 {
         def ch = load8(out, k)
         if ch == 41 { depth += 1 }
         elif ch == 40 {
            depth -= 1
            if depth == 0 {
               start = k
               break
            }
         }
         k -= 1
      }
      if start >= 0 {
         def inner = str.strip(slice(out, start + 1, p, 1))
         def table = _clean_ptr_table_rhs(inner)
         if table.len > 0 {
            def br = _clean_bracket_span_at(out, p + 1)
            if br.get("ok", false) {
               def repl = table.get("base", "") + "[" + table.get("idx", "") + "][" +
               _clean_rendered_castless_index(br.get("expr", "")) + "]"
               out = slice(out, 0, start, 1) + repl + slice(out, int(br.get("end", p + 2)), out.len, 1)
               changed = true
               p = str.find(slice(out, start + repl.len, out.len, 1), ")[")
               if p >= 0 { p += start + repl.len }
               guard += 1
               continue
            }
         }
      }
      def next = str.find(slice(out, p + 2, out.len, 1), ")[")
      p = next >= 0 ? next + p + 2 : -1
      guard += 1
   }
   changed ? out : text
}

fn _clean_local_slot_offset(str name0) dict {
   def name = str.strip(name0)
   if !str.startswith(name, "local_") { return dict() }
   def raw = slice(name, 6, name.len, 1)
   if raw.len == 0 { return dict() }
   mut i = 0
   while i < raw.len {
      if !str.ascii_is_hex_digit(load8(raw, i)) { return dict() }
      i += 1
   }
   {"ok": true, "offset": _parse_int_piece("0x" + raw)}
}

fn _clean_rendered_string_literal(str rhs0) dict {
   def rhs = str.strip(rhs0)
   if rhs.len < 2 { return dict() }
   def quote = load8(rhs, 0)
   if !(quote == 34 || quote == 39) { return dict() }
   mut i = 1
   while i < rhs.len {
      def ch = load8(rhs, i)
      if ch == 92 && i + 1 < rhs.len {
         i += 2
         continue
      }
      if ch == quote {
         if i == rhs.len - 1 { return {"ok": true, "literal": rhs} }
         return dict()
      }
      i += 1
   }
   dict()
}

fn _clean_rendered_string_literal_value(str rhs0) dict {
   def lit = _clean_rendered_string_literal(rhs0)
   if !lit.get("ok", false) { return dict() }
   def rhs = lit.get("literal", "")
   def quote = load8(rhs, 0)
   mut out = ""
   mut i = 1
   while i < rhs.len - 1 {
      def ch = load8(rhs, i)
      if ch == 92 && i + 1 < rhs.len - 1 {
         def n = load8(rhs, i + 1)
         if n == quote { out = out + chr(quote) }
         elif n == 92 { out = out + "\\" }
         elif n == 110 { out = out + "\n" }
         elif n == 114 { out = out + "\r" }
         elif n == 116 { out = out + "\t" }
         else { out = out + chr(n) }
         i += 2
         continue
      }
      out = out + chr(ch)
      i += 1
   }
   {"ok": true, "literal": rhs, "value": out}
}

fn _clean_rendered_int_literal(str rhs0) dict {
   def rhs = str.strip(rhs0)
   _looks_int_literal(rhs) ? {"ok": true, "literal": rhs, "value": _parse_int_piece(rhs)} : dict()
}

fn _clean_render_text_has_indexed_name(str text, str name) bool {
   if name.len == 0 { return false }
   str.find(text, name + "[") >= 0
}

fn _clean_local_string_table_tail(list lines, int start) str {
   mut b = str.Builder(128)
   mut i = start
   while i < lines.len {
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_aggregate_local_string_tables(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut i = 0
   while i < lines.len {
      def first = _clean_rendered_assignment_parts(lines[i])
      if first.len == 0 {
         i += 1
         continue
      }
      def first_slot = _clean_local_slot_offset(first.get("lhs", ""))
      def first_lit = _clean_rendered_string_literal(first.get("rhs", ""))
      if first_slot.len == 0 || first_lit.len == 0 {
         i += 1
         continue
      }
      def pad = _clean_line_indent(lines[i])
      mut names = [first.get("lhs", "")]
      mut lits = [first_lit.get("literal", "")]
      mut offsets = [int(first_slot.get("offset", 0))]
      mut stride = 0
      mut j = i + 1
      mut blocked = false
      while j < lines.len && !blocked {
         if str.strip(lines[j]).len == 0 { break }
         if _clean_line_indent(lines[j]) != pad { break }
         def next = _clean_rendered_assignment_parts(lines[j])
         if next.len == 0 { break }
         def slot = _clean_local_slot_offset(next.get("lhs", ""))
         def lit = _clean_rendered_string_literal(next.get("rhs", ""))
         if slot.len == 0 || lit.len == 0 { break }
         def prev = int(offsets[offsets.len - 1])
         def off = int(slot.get("offset", 0))
         def diff = prev - off
         if diff <= 0 { break }
         if stride == 0 {
            if !(diff == 4 || diff == 8 || diff == 16) { break }
            stride = diff
         } elif diff != stride {
            break
         }
         names = names.append(next.get("lhs", ""))
         lits = lits.append(lit.get("literal", ""))
         offsets = offsets.append(off)
         j += 1
      }
      if names.len < 2 {
         i += 1
         continue
      }
      def tail = _clean_local_string_table_tail(lines, j)
      if !_clean_render_text_has_indexed_name(tail, names[0]) {
         i += 1
         continue
      }
      mut k = 1
      while k < names.len {
         if _clean_render_text_has_token(tail, names[k]) { blocked = true }
         k += 1
      }
      if blocked {
         i += 1
         continue
      }
      mut joined = ""
      k = 0
      while k < lits.len {
         if k > 0 { joined = joined + ", " }
         joined = joined + lits[k]
         k += 1
      }
      replace = replace.set(to_str(i), pad + names[0] + " = [" + joined + "]")
      k = i + 1
      while k < j {
         skip = skip.set(to_str(k), true)
         k += 1
      }
      i = j
   }
   if skip.len == 0 && replace.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if skip.get(to_str(i), false) {
         i += 1
         continue
      }
      b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_aggregate_local_scalar_tables(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut i = 0
   while i < lines.len {
      def first = _clean_rendered_assignment_parts(lines[i])
      if first.len == 0 {
         i += 1
         continue
      }
      def first_slot = _clean_local_slot_offset(first.get("lhs", ""))
      def first_lit = _clean_rendered_int_literal(first.get("rhs", ""))
      if first_slot.len == 0 || first_lit.len == 0 {
         i += 1
         continue
      }
      def pad = _clean_line_indent(lines[i])
      mut names = [first.get("lhs", "")]
      mut lits = [first_lit.get("literal", "")]
      mut offsets = [int(first_slot.get("offset", 0))]
      mut j = i + 1
      mut blocked = false
      while j < lines.len && !blocked {
         if str.strip(lines[j]).len == 0 { break }
         if _clean_line_indent(lines[j]) != pad { break }
         def next = _clean_rendered_assignment_parts(lines[j])
         if next.len == 0 { break }
         def slot = _clean_local_slot_offset(next.get("lhs", ""))
         def lit = _clean_rendered_int_literal(next.get("rhs", ""))
         if slot.len == 0 || lit.len == 0 { break }
         def prev = int(offsets[offsets.len - 1])
         def off = int(slot.get("offset", 0))
         if prev - off != 4 { break }
         names = names.append(next.get("lhs", ""))
         lits = lits.append(lit.get("literal", ""))
         offsets = offsets.append(off)
         j += 1
      }
      if names.len < 3 {
         i += 1
         continue
      }
      def tail = _clean_local_string_table_tail(lines, j)
      if !_clean_render_text_has_indexed_name(tail, names[0]) {
         i += 1
         continue
      }
      mut k = 1
      while k < names.len {
         if _clean_render_text_has_token(tail, names[k]) { blocked = true }
         k += 1
      }
      if blocked {
         i += 1
         continue
      }
      replace = replace.set(to_str(i), pad + names[0] + " = [" + str.join(lits, ", ") + "]")
      k = i + 1
      while k < j {
         skip = skip.set(to_str(k), true)
         k += 1
      }
      i = j
   }
   if skip.len == 0 && replace.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if skip.get(to_str(i), false) {
         i += 1
         continue
      }
      b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_dead_local_reassign_boundary(str raw0) bool {
   def raw = str.strip(raw0)
   if raw.len == 0 { return false }
   if _clean_rendered_label_name(raw).len > 0 { return true }
   if _clean_raw_goto_label(raw).len > 0 { return true }
   if _clean_rendered_is_return(raw) { return true }
   if (str.startswith(raw, "if (") || str.startswith(raw, "while (") ||
      str.startswith(raw, "} else") || raw == "}" || raw == "else {"){
      return true
   }
   false
}

fn _clean_drop_dead_local_reassigns(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut i = 0
   while i < lines.len {
      def first = _clean_rendered_assignment_parts(lines[i])
      if (first.len == 0 || _clean_local_slot_offset(first.get("lhs", "")).len == 0 ||
         _clean_render_text_has_token(first.get("rhs", ""), first.get("lhs", ""))){
         i += 1
         continue
      }
      def lhs = first.get("lhs", "")
      mut j = i + 1
      mut dead = false
      mut blocked = false
      while j < lines.len && !dead && !blocked {
         def raw = str.strip(lines[j])
         if raw.len == 0 {
            j += 1
            continue
         }
         def next = _clean_rendered_assignment_parts(lines[j])
         if next.len > 0 && next.get("lhs", "") == lhs {
            if !_clean_render_text_has_token(next.get("rhs", ""), lhs) { dead = true }
            break
         }
         if _clean_render_text_has_token(lines[j], lhs) || _clean_dead_local_reassign_boundary(raw) {
            blocked = true
            break
         }
         if next.len == 0 {
            blocked = true
            break
         }
         j += 1
      }
      if dead { skip = skip.set(to_str(i), true) }
      i += 1
   }
   if skip.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if skip.get(to_str(i), false) {
         i += 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_local_alias_rhs_memory_like(str rhs) bool {
   str.find(rhs, "mem(") >= 0 || str.find(rhs, "[") >= 0
}

fn _clean_local_alias_rhs_inlineable(str lhs, str rhs0) bool {
   def rhs = str.strip(rhs0)
   if rhs.len == 0 || rhs.len > 160 { return false }
   if _clean_render_text_has_token(rhs, lhs) { return false }
   if str.find(rhs, "=") >= 0 || str.find(rhs, "{") >= 0 || str.find(rhs, "}") >= 0 { return false }
   _clean_rendered_pure_temp_rhs(rhs)
}

fn _clean_inline_local_call_aliases(str text) str {
   mut lines = str.split(text, "\n")
   mut skip = dict()
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_rendered_assignment_parts(lines[i])
      if parts.len == 0 || _clean_local_slot_offset(parts.get("lhs", "")).len == 0 {
         i += 1
         continue
      }
      def lhs = parts.get("lhs", "")
      def rhs = parts.get("rhs", "")
      if !_clean_local_alias_rhs_inlineable(lhs, rhs) {
         i += 1
         continue
      }
      def memory_like = _clean_local_alias_rhs_memory_like(rhs)
      mut j = i + 1
      mut replaced = false
      mut blocked = false
      while j < lines.len && !blocked {
         def raw = str.strip(lines[j])
         if raw.len == 0 {
            j += 1
            continue
         }
         if (_clean_rendered_label_name(raw).len > 0 || _clean_raw_goto_label(raw).len > 0 ||
            str.startswith(raw, "if (") || str.startswith(raw, "while (") ||
            str.startswith(raw, "switch(") || str.startswith(raw, "use(") ||
            raw == "}" || raw == "} else {" ||
            _clean_rendered_is_return(raw)){
            break
         }
         def next = _clean_rendered_assignment_parts(raw)
         if next.len > 0 && next.get("lhs", "") == lhs { break }
         def call_args = _clean_rendered_call_args(raw)
         if _clean_render_text_has_token(raw, lhs) {
            if call_args.len == 0 {
               blocked = true
               break
            }
            lines = lines.set(j, _clean_replace_token(lines[j], lhs, rhs))
            replaced = true
            changed = true
            if memory_like { break }
         }
         if call_args.len > 0 && memory_like { break }
         j += 1
      }
      if replaced && !blocked {
         mut remains = false
         mut k = i + 1
         while k < lines.len {
            if _clean_render_text_has_token(lines[k], lhs) {
               remains = true
               break
            }
            k += 1
         }
         if !remains { skip = skip.set(to_str(i), true) }
      }
      i += 1
   }
   if !changed && skip.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) { b = str.builder_append(b, lines[i] + "\n") }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_any_assignment_parts(str line) dict {
   def raw = str.strip(line)
   def p = str.find(raw, " = ")
   if p <= 0 { return dict() }
   {"lhs": str.strip(slice(raw, 0, p, 1)), "rhs": str.strip(slice(raw, p + 3, raw.len, 1))}
}

fn _clean_mem_lvalue_for_local_temp(str lhs0, str reg0, str local0) str {
   def lhs = str.strip(lhs0)
   def reg = str.lower(str.strip(reg0))
   def base = str.strip(local0)
   def lower_lhs = str.lower(lhs)
   def indexed_prefix = reg + "["
   if str.startswith(lower_lhs, indexed_prefix) && str.endswith(lhs, "]") {
      def idx = str.strip(slice(lhs, indexed_prefix.len, lhs.len - 1, 1))
      if idx.len > 0 { return base + "[" + idx + "]" }
   }
   if !str.startswith(lhs, "mem(") || lhs.len <= 5 || !str.endswith(lhs, ")") { return "" }
   mut inner = _clean_strip_outer_parens(slice(lhs, 4, lhs.len - 1, 1))
   if str.lower(inner) == reg { return base + "[0]" }
   mut p = _clean_top_level_find(inner, " + ")
   if p > 0 {
      def left = str.strip(slice(inner, 0, p, 1))
      def right = str.strip(slice(inner, p + 3, inner.len, 1))
      if str.lower(left) == reg && right.len > 0 { return base + "[" + right + "]" }
      if str.lower(right) == reg && left.len > 0 { return base + "[" + left + "]" }
   }
   p = _clean_top_level_find(inner, " - ")
   if p > 0 {
      def left = str.strip(slice(inner, 0, p, 1))
      def right = str.strip(slice(inner, p + 3, inner.len, 1))
      if str.lower(left) == reg && right.len > 0 { return base + "[-" + right + "]" }
   }
   ""
}

fn _clean_temp_dead_after_store(list lines, int store_idx, str reg) bool {
   mut j = store_idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 || _clean_raw_goto_label(raw).len > 0 { return false }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 && _symbols_intersect(_slice_symbol_aliases(parts.get("lhs", "")), _slice_symbol_aliases(reg)) {
         return !_clean_render_text_has_alias(parts.get("rhs", ""), reg)
      }
      if _clean_render_text_has_alias(raw, reg) { return false }
      if _clean_rendered_is_return(raw) { return true }
      j += 1
   }
   true
}

fn _clean_inline_local_pointer_temp_stores(str text) str {
   mut lines = str.split(text, "\n")
   mut skip = dict()
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def temp = _clean_rendered_assignment_parts(lines[i])
      if (temp.len == 0 || !_clean_rendered_value_temp_reg(temp.get("lhs", "")) ||
         _clean_local_slot_offset(temp.get("rhs", "")).len == 0){
         i += 1
         continue
      }
      def j = _clean_next_nonblank_index(lines, i + 1)
      if j >= lines.len || _clean_line_indent(lines[j]) != _clean_line_indent(lines[i]) {
         i += 1
         continue
      }
      def mem = _clean_any_assignment_parts(lines[j])
      if mem.len == 0 || _clean_render_text_has_alias(mem.get("rhs", ""), temp.get("lhs", "")) {
         i += 1
         continue
      }
      def local_lhs = _clean_mem_lvalue_for_local_temp(mem.get("lhs", ""), temp.get("lhs", ""), temp.get("rhs", ""))
      if local_lhs.len == 0 || !_clean_temp_dead_after_store(lines, j, temp.get("lhs", "")) {
         i += 1
         continue
      }
      lines = lines.set(j, _clean_line_indent(lines[j]) + local_lhs + " = " + mem.get("rhs", ""))
      skip = skip.set(to_str(i), true)
      changed = true
      i += 1
   }
   if !changed { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) { b = str.builder_append(b, lines[i] + "\n") }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_inline_call_result_local_aliases(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def call = _clean_rendered_assignment_parts(lines[i])
      if (call.len == 0 || !_clean_rendered_value_temp_reg(call.get("lhs", "")) ||
         !_clean_rendered_standalone_call_expr(call.get("rhs", ""))){
         i += 1
         continue
      }
      def j = _clean_next_nonblank_index(lines, i + 1)
      if j >= lines.len || _clean_line_indent(lines[j]) != _clean_line_indent(lines[i]) {
         i += 1
         continue
      }
      def local = _clean_rendered_assignment_parts(lines[j])
      if (local.len == 0 || _clean_local_slot_offset(local.get("lhs", "")).len == 0 ||
         !_clean_rendered_rhs_is_alias(local.get("rhs", ""), call.get("lhs", "")) ||
         !_clean_rendered_temp_dead_after(lines, j, call.get("lhs", ""))){
         i += 1
         continue
      }
      skip = skip.set(to_str(i), true)
      replace = replace.set(to_str(j), _clean_line_indent(lines[j]) + local.get("lhs", "") + " = " + call.get("rhs", ""))
      changed = true
      i += 1
   }
   if !changed { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) {
         b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_drop_unused_local_assigns(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_rendered_assignment_parts(lines[i])
      if (_clean_line_indent(lines[i]).len > 2 || parts.len == 0 ||
         _clean_local_slot_offset(parts.get("lhs", "")).len == 0 ||
         !_clean_rendered_pure_temp_rhs(parts.get("rhs", "")) ||
         !_clean_rendered_call_after(lines, i)){
         i += 1
         continue
      }
      def lhs = parts.get("lhs", "")
      mut used = false
      mut j = i + 1
      while j < lines.len {
         if _clean_render_text_has_token(lines[j], lhs) {
            used = true
            break
         }
         j += 1
      }
      if !used { skip = skip.set(to_str(i), true) }
      i += 1
   }
   if skip.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) { b = str.builder_append(b, lines[i] + "\n") }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_drop_dead_const_local_assigns(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_rendered_assignment_parts(lines[i])
      if (parts.len > 0 && _clean_rendered_const_local(parts.get("lhs", "")) &&
         _clean_line_indent(lines[i]).len <= 2 &&
         _clean_literal_int_value(parts.get("rhs", "")).get("ok", false) &&
         _clean_rendered_temp_dead_after(lines, i, parts.get("lhs", ""))){
         skip = skip.set(to_str(i), true)
      }
      i += 1
   }
   if skip.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) { b = str.builder_append(b, lines[i] + "\n") }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_strlen_loop_parts(str raw0) dict {
   def raw = str.strip(raw0)
   if !str.startswith(raw, "while (") || !str.endswith(raw, "{") { return dict() }
   def inner = str.strip(slice(raw, 6, raw.len - 2, 1))
   def p = _clean_top_level_find(inner, " < ")
   if p < 0 { return dict() }
   def idx = str.strip(slice(inner, 0, p, 1))
   def rhs = str.strip(slice(inner, p + 3, inner.len, 1))
   mut src = ""
   if str.startswith(rhs, "strlen(") && str.endswith(rhs, ")") {
      src = str.strip(slice(rhs, 7, rhs.len - 1, 1))
   } elif str.endswith(rhs, ".len") {
      src = str.strip(slice(rhs, 0, rhs.len - 4, 1))
   } else {
      return dict()
   }
   if idx.len == 0 || src.len == 0 { return dict() }
   {"idx": idx, "src": src}
}

fn _clean_indexed_write_parts(str raw0) dict {
   def parts = _clean_any_assignment_parts(raw0)
   if parts.len == 0 { return dict() }
   def lhs = parts.get("lhs", "")
   def lb = str.find(lhs, "[")
   if lb <= 0 || !str.endswith(lhs, "]") { return dict() }
   {"base": str.strip(slice(lhs, 0, lb, 1)), "idx": str.strip(slice(lhs, lb + 1, lhs.len - 1, 1)),
      "rhs": parts.get("rhs", ""), "lhs": lhs}
}

fn _clean_char_shift_store_parts(str raw0, str idx, str src) dict {
   def wr = _clean_indexed_write_parts(raw0)
   if wr.len == 0 || wr.get("idx", "") != idx { return dict() }
   def rhs = _clean_strip_outer_parens(wr.get("rhs", ""))
   mut op = " - "
   mut p = _clean_top_level_find(rhs, op)
   mut sign = -1
   if p < 0 {
      op = " + "
      p = _clean_top_level_find(rhs, op)
      sign = 1
   }
   if p < 0 { return dict() }
   def left = _clean_strip_outer_parens(slice(rhs, 0, p, 1))
   def right = _clean_literal_int_value(slice(rhs, p + op.len, rhs.len, 1))
   if !right.get("ok", false) { return dict() }
   if left != src + "[" + idx + "]" { return dict() }
   {"out": wr.get("base", ""), "idx": idx, "src": src, "delta": sign * int(right.get("value", 0))}
}

fn _clean_zero_terminator_for(str raw0, str out_name, str idx) bool {
   def wr = _clean_indexed_write_parts(raw0)
   wr.len > 0 && wr.get("base", "") == out_name && wr.get("idx", "") == idx &&
   _clean_literal_zero(wr.get("rhs", ""))
}

fn _clean_printf_buffer_parts(str raw0, str out_name) dict {
   def raw = str.strip(raw0)
   if !str.startswith(raw, "printf(") || !str.endswith(raw, ")") { return dict() }
   def args = _clean_call_args(slice(raw, 7, raw.len - 1, 1))
   if args.len < 2 || str.strip(args[1]) != "&" + out_name { return dict() }
   {"fmt": str.strip(args[0])}
}

fn _clean_collapse_char_shift_loops(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut i = 0
   while i + 6 < lines.len {
      def init = _clean_rendered_assignment_parts(lines[i])
      def loop = _clean_strlen_loop_parts(lines[i + 1])
      if (init.len == 0 || loop.len == 0 || init.get("lhs", "") != loop.get("idx", "") ||
         !_clean_literal_zero(init.get("rhs", ""))){
         i += 1
         continue
      }
      def idx = loop.get("idx", "")
      def src = loop.get("src", "")
      def shift = _clean_char_shift_store_parts(lines[i + 2], idx, src)
      def step = _clean_rendered_assignment_parts(lines[i + 3])
      if (shift.len == 0 || step.len == 0 || step.get("lhs", "") != idx ||
         str.strip(step.get("rhs", "")) != idx + " + 1" || str.strip(lines[i + 4]) != "}" ||
         !_clean_zero_terminator_for(lines[i + 5], shift.get("out", ""), idx)){
         i += 1
         continue
      }
      def printed = _clean_printf_buffer_parts(lines[i + 6], shift.get("out", ""))
      if (printed.len == 0 ||
         !_clean_rendered_temp_dead_after(lines, i + 6, idx) ||
         !_clean_rendered_temp_dead_after(lines, i + 6, shift.get("out", ""))){
         i += 1
         continue
      }
      def indent = _clean_line_indent(lines[i])
      def delta = int(shift.get("delta", 0))
      def op = delta < 0 ? " - " : " + "
      def amt = _clean_small_int_text(_iabs(delta))
      replace = replace.set(to_str(i), indent + "decoded = " + src + ".map(fn(ch){ ch" + op + amt + " })")
      replace = replace.set(to_str(i + 6), _clean_line_indent(lines[i + 6]) + "printf(" +
         printed.get("fmt", "") + ", decoded)")
      skip = skip.set(to_str(i + 1), true).set(to_str(i + 2), true).set(to_str(i + 3), true)
      .set(to_str(i + 4), true).set(to_str(i + 5), true)
      i += 7
   }
   if skip.len == 0 && replace.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) { b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n") }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_while_counted_loop_parts(str raw0) dict {
   def raw = str.strip(raw0)
   if !str.startswith(raw, "while (") || !str.endswith(raw, "{") { return dict() }
   def cond = str.strip(slice(raw, 6, raw.len - 2, 1))
   def ops = [" < ", " <= "]
   mut i = 0
   while i < ops.len {
      def op = ops[i]
      def p = _clean_top_level_find(cond, op)
      if p > 0 {
         def lhs = str.strip(slice(cond, 0, p, 1))
         def rhs = str.strip(slice(cond, p + op.len, cond.len, 1))
         if lhs.len > 0 && rhs.len > 0 && _symbol_token_ok(lhs) {
            return {"idx": lhs, "bound": rhs, "op": str.strip(op)}
         }
      }
      i += 1
   }
   dict()
}

fn _clean_counted_loop_step(str raw0, str idx) bool {
   def parts = _clean_rendered_assignment_parts(raw0)
   if parts.len == 0 || parts.get("lhs", "") != idx { return false }
   str.strip(parts.get("rhs", "")) == idx + " + 1"
}

fn _clean_counted_loop_body_safe(list lines, int body_start, int step_idx, str idx) bool {
   mut i = body_start
   while i < step_idx && i < lines.len {
      def raw = str.strip(lines[i])
      if _clean_rendered_label_name(raw).len > 0 || _clean_raw_goto_label(raw).len > 0 { return false }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 && parts.get("lhs", "") == idx { return false }
      i += 1
   }
   true
}

fn _clean_for_range_expr(str start0, str bound0, str op) str {
   def start = str.strip(start0)
   def bound = str.strip(bound0)
   if op == "<" { return start + ".." + bound + " - 1" }
   start + ".." + bound
}

fn _clean_structure_counted_for_loops(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut i = 0
   while i + 3 < lines.len {
      def init = _clean_rendered_assignment_parts(lines[i])
      def loop = _clean_while_counted_loop_parts(lines[i + 1])
      if (init.len == 0 || loop.len == 0 || init.get("lhs", "") != loop.get("idx", "") ||
         !_looks_int_literal(init.get("rhs", ""))){
         i += 1
         continue
      }
      def close = _clean_matching_block_close(lines, i + 1)
      if close <= i + 2 { i += 1 continue }
      def step_idx = close - 1
      def idx = loop.get("idx", "")
      if (!_clean_counted_loop_step(lines[step_idx], idx) ||
         !_clean_counted_loop_body_safe(lines, i + 2, step_idx, idx) ||
         !_clean_rendered_temp_dead_after(lines, close, idx)){
         i += 1
         continue
      }
      def range_expr = _clean_for_range_expr(init.get("rhs", ""), loop.get("bound", ""), loop.get("op", ""))
      mut indent = _clean_line_indent(lines[i + 1])
      if indent.len == 0 { indent = _clean_line_indent(lines[i]) }
      if indent.len == 0 && i + 2 < lines.len {
         def body_indent = _clean_line_indent(lines[i + 2])
         if body_indent.len >= 2 { indent = slice(body_indent, 0, body_indent.len - 2, 1) }
      }
      if indent.len == 0 && i > 0 { indent = "  " }
      replace = replace.set(to_str(i + 1), indent + "for " + idx + " in " + range_expr + " {")
      skip = skip.set(to_str(i), true).set(to_str(step_idx), true)
      i = close + 1
   }
   if skip.len == 0 && replace.len == 0 { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) { b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n") }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_decoder_call_name(str name0) bool {
   def name = str.lower(str.strip(name0))
   str.find(name, "shift") >= 0 || str.find(name, "decode") >= 0 ||
   str.find(name, "decrypt") >= 0 || str.find(name, "caesar") >= 0 ||
   str.find(name, "rot") >= 0
}

fn _clean_direct_call_parts(str raw0) dict {
   def raw = str.strip(raw0)
   def p = str.find(raw, "(")
   if p <= 0 || !str.endswith(raw, ")") { return dict() }
   def name = str.strip(slice(raw, 0, p, 1))
   if (name == "if" || name == "while" || name == "switch" || name == "return" ||
      str.find(name, " ") >= 0 || str.find(name, "=") >= 0 ||
      _clean_rendered_helper_call_name(name)){ return dict() }
   mut i = 0
   while i < name.len {
      if !_symbol_is_name_char(load8(name, i)) { return dict() }
      i += 1
   }
   {"name": name, "args": _clean_call_args(slice(raw, p + 1, raw.len - 1, 1))}
}

fn _clean_decode_message_class(str value) dict {
   def success = _crackme_word_score(value, ["success", "correct", "granted", "congrat", "welcome", "unlocked", "flag", "winner", "valid password", "password ok", "accepted", "good job", "access"])
   def failure = _crackme_word_score(value, ["wrong", "incorrect", "invalid", "denied", "failed", "failure", "not correct", "try again", "bad password", "nope", "error"])
   def sscore = int(success[0])
   def fscore = int(failure[0])
   if sscore > fscore && sscore > 0 { return {"class": "success", "score": sscore, "reasons": success[1]} }
   if fscore > 0 { return {"class": "failure", "score": fscore, "reasons": failure[1]} }
   {"class": "neutral", "score": 0, "reasons": []}
}

fn _clean_best_ascii_shift_decode(str value) dict {
   mut best = dict()
   mut delta = -8
   while delta <= 8 {
      if delta != 0 {
         def shifted = _crackme_ascii_shift(value, delta)
         def cls = _clean_decode_message_class(shifted)
         def score = int(cls.get("score", 0))
         if score > int(best.get("score", 0)) {
            best = cls.set("ok", true).set("value", shifted).set("delta", delta)
         }
      }
      delta += 1
   }
   best.get("ok", false) ? best : dict()
}

fn _clean_annotate_decoded_string_calls(str text) str {
   def lines = str.split(text, "\n")
   mut changed = false
   mut b = str.Builder(text.len + 128)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      mut line = lines[i]
      def raw = str.strip(line)
      if str.find(raw, "; decoded ") < 0 {
         def call = _clean_direct_call_parts(raw)
         if call.len > 0 && _clean_decoder_call_name(call.get("name", "")) && call.get("args", []).len > 0 {
            def lit = _clean_rendered_string_literal_value(call.get("args", [])[0])
            if lit.get("ok", false) {
               def dec = _clean_best_ascii_shift_decode(lit.get("value", ""))
               if dec.get("ok", false) {
                  line = line + " ; decoded " + repr(str.strip(dec.get("value", ""))) +
                  " via caesar" + to_str(dec.get("delta", 0))
                  changed = true
               }
            }
         }
      }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_decoded_comment_literal(str raw0) str {
   def raw = str.strip(raw0)
   def p = str.find(raw, "; decoded ")
   if p < 0 { return "" }
   def tail = str.strip(slice(raw, p + 10, raw.len, 1))
   if tail.len < 2 { return "" }
   def quote = load8(tail, 0)
   if quote != 34 && quote != 39 { return "" }
   mut i = 1
   while i < tail.len {
      def ch = load8(tail, i)
      if ch == 92 && i + 1 < tail.len {
         i += 2
         continue
      }
      if ch == quote { return slice(tail, 0, i + 1, 1) }
      i += 1
   }
   ""
}

fn _clean_render_text_has_call(str text, str name) bool {
   def needle = name + "("
   def lines = str.split(text, "\n")
   mut i = 0
   while i < lines.len {
      def raw = str.strip(lines[i])
      if str.startswith(raw, "fn " + name + "(") {
         i += 1
         continue
      }
      if str.find(raw, needle) >= 0 { return true }
      i += 1
   }
   false
}

fn _clean_drop_function_if_unused(str text, str name) str {
   if _clean_render_text_has_call(text, name) { return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if str.startswith(str.strip(lines[i]), "fn " + name + "(") {
         def close = _clean_matching_block_close(lines, i)
         if close > i {
            changed = true
            i = close + 1
            while i < lines.len && str.strip(lines[i]).len == 0 { i += 1 }
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_inline_decoded_shift_calls(str text) str {
   if str.find(text, "shift(") < 0 || str.find(text, "; decoded ") < 0 { return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      def lit = _clean_decoded_comment_literal(raw)
      if lit.len > 0 && str.startswith(raw, "shift(") {
         b = str.builder_append(b, _clean_line_indent(lines[i]) + "printf(" + lit + ")\n")
         changed = true
      } else {
         b = str.builder_append(b, lines[i] + "\n")
      }
      i += 1
   }
   def out0 = str.builder_to_str(b)
   str.builder_free(b)
   changed ? _clean_drop_function_if_unused(out0, "shift") : text
}

fn _clean_stack_scratch_add_rhs(str rhs0, str reg) bool {
   def rhs = str.strip(rhs0)
   str.startswith(rhs, reg + " + -") || str.startswith(rhs, reg + " - ")
}

fn _clean_stack_scratch_store_line(str raw0, str reg) bool {
   def raw = str.strip(raw0)
   str.startswith(raw, "mem(" + reg + ") = ")
}

fn _clean_stack_scratch_temp_safe(list lines, int start, str reg) bool {
   mut i = start
   while i < lines.len {
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         i += 1
         continue
      }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 && _symbols_intersect(_slice_symbol_aliases(parts.get("lhs", "")), _slice_symbol_aliases(reg)) {
         return !_clean_render_text_has_alias(parts.get("rhs", ""), reg)
      }
      if _clean_render_text_has_alias(raw, reg) && !_clean_stack_scratch_store_line(raw, reg) {
         return false
      }
      i += 1
   }
   true
}

fn _clean_stack_scratch_alloc_temp_at(list lines, int idx) str {
   if idx + 2 >= lines.len { return "" }
   def pad = _clean_line_indent(lines[idx])
   if _clean_line_indent(lines[idx + 1]) != pad || _clean_line_indent(lines[idx + 2]) != pad { return "" }
   def a = _clean_rendered_assignment_parts(lines[idx])
   def b = _clean_rendered_assignment_parts(lines[idx + 1])
   def c = _clean_rendered_assignment_parts(lines[idx + 2])
   if a.len == 0 || b.len == 0 || c.len == 0 { return "" }
   def reg = str.lower(a.get("lhs", ""))
   if !_clean_rendered_value_temp_reg(reg) { return "" }
   if str.lower(a.get("rhs", "")) != "rsp" { return "" }
   if str.lower(b.get("lhs", "")) != reg || !_clean_stack_scratch_add_rhs(str.lower(b.get("rhs", "")), reg) { return "" }
   if str.lower(c.get("lhs", "")) != "rsp" || str.lower(c.get("rhs", "")) != reg { return "" }
   _clean_stack_scratch_temp_safe(lines, idx + 3, reg) ? reg : ""
}

fn _clean_drop_stack_scratch_allocs(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut temps = []
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def reg = _clean_stack_scratch_alloc_temp_at(lines, i)
      if reg.len > 0 {
         skip = skip.set(to_str(i), true).set(to_str(i + 1), true).set(to_str(i + 2), true)
         temps = _append_unique(temps, reg)
         i += 3
         continue
      }
      i += 1
   }
   if temps.len == 0 { return text }
   i = 0
   while i < lines.len {
      if !skip.get(to_str(i), false) {
         def raw = str.strip(lines[i])
         mut ti = 0
         while ti < temps.len {
            if _clean_stack_scratch_store_line(raw, temps[ti]) {
               skip = skip.set(to_str(i), true)
               break
            }
            ti += 1
         }
      }
      i += 1
   }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) { b = str.builder_append(b, lines[i] + "\n") }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_finish_render(str text, any opts=dict()) str {
   def early_branchless = _clean_collapse_branchless_byte_network(text)
   if early_branchless != text { return early_branchless }
   def no_constant_branches = _clean_drop_constant_branches(text)
   def no_noreturn_labels = _clean_inline_noreturn_labels(no_constant_branches)
   def no_terminal_labels = _clean_inline_terminal_labels(no_noreturn_labels)
   def no_empty_aliases = _clean_collapse_empty_label_aliases(no_terminal_labels)
   def no_trampolines = _clean_collapse_trampoline_labels(no_empty_aliases)
   def no_redundant_gotos = _clean_drop_redundant_gotos_fixed(no_trampolines)
   def no_immediate_cond_gotos = _clean_drop_immediate_conditional_goto_labels(no_redundant_gotos)
   def no_linear_unreachable = _clean_drop_linear_unreachable_after_terminal_fixed(no_immediate_cond_gotos)
   def no_return_tail_unreachable = _clean_drop_unlabeled_tail_after_return(no_linear_unreachable)
   def no_post_unreachable_gotos = _clean_drop_redundant_gotos_fixed(no_return_tail_unreachable)
   def early_local_return_joins = _clean_collapse_local_return_joins(no_post_unreachable_gotos)
   def structured_diamonds = _clean_structure_goto_diamonds(early_local_return_joins)
   def structured_fallthrough_ifelse = _clean_structure_fallthrough_if_else(structured_diamonds)
   def no_pre_unreachable_unused_labels = _clean_drop_unreachable_unused_labels(structured_fallthrough_ifelse)
   def no_unused_labels = _clean_drop_unused_labels(no_pre_unreachable_unused_labels)
   def no_unreachable_unused_labels = _clean_drop_unreachable_unused_labels(no_unused_labels)
   def no_late_unreachable = _clean_drop_linear_unreachable_after_terminal_fixed(no_unreachable_unused_labels)
   def no_late_return_tail_unreachable = _clean_drop_unlabeled_tail_after_return(no_late_unreachable)
   def rotated_prechecked_loops = _clean_rotate_prechecked_loops(no_late_return_tail_unreachable)
   def structured_skips = _clean_structure_goto_skips(rotated_prechecked_loops)
   def structured_guard_labels = _clean_structure_guard_label_after_terminal(structured_skips)
   def loop_exit_breaks = _clean_structure_loop_exit_gotos(structured_guard_labels)
   def top_break_loops = _clean_structure_top_break_loops(loop_exit_breaks)
   def failstop_empty_loops = _clean_structure_failstop_empty_loops(top_break_loops)
   def no_unwind_tails = _clean_drop_unwind_tail_after_return(failstop_empty_loops)
   def no_return_dead_tails = _clean_drop_return_dead_block_tails(no_unwind_tails)
   def no_constant_ifs = _clean_drop_constant_structured_ifs(no_return_dead_tails)
   def no_empty_blocks = _clean_drop_empty_blocks(no_constant_ifs)
   def no_repeated_switches = _clean_drop_repeated_switches(no_empty_blocks)
   def no_constant_selects = _clean_simplify_constant_selects(no_repeated_switches)
   def early_index_temps = _clean_rendered_index_temp_chains(no_constant_selects)
   def no_rendered_arg_setup = _clean_drop_rendered_call_arg_setup(early_index_temps)
   def no_condition_reg_setup = _clean_drop_condition_reg_setup(no_rendered_arg_setup)
   def no_call_result_copy_conditions = _clean_inline_call_result_copy_conditions(no_condition_reg_setup)
   def arith_condition_reg_setup = _clean_inline_arith_condition_reg_setup(no_call_result_copy_conditions)
   def condition_temp_chains = _clean_inline_condition_temp_chains(arith_condition_reg_setup)
   def rendered_rotates = _clean_simplify_rendered_rotates(condition_temp_chains)
   def rendered_mba = _clean_simplify_rendered_mba(rendered_rotates)
   def rendered_bool_constants = _clean_simplify_rendered_bool_constants(rendered_mba)
   def rendered_bool_branches = _clean_drop_constant_branches(rendered_bool_constants)
   def rendered_bool_ifs = _clean_drop_constant_structured_ifs(rendered_bool_branches)
   def rendered_bool_unreachable = _clean_drop_linear_unreachable_after_terminal_fixed(rendered_bool_ifs)
   def rendered_bool_return_tails = _clean_drop_return_dead_block_tails(rendered_bool_unreachable)
   def rendered_bool_labels = _clean_drop_unreachable_unused_labels(_clean_drop_unused_labels(rendered_bool_return_tails))
   def pre_inline_magic_wide_setup = _clean_drop_magic_wide_setup(rendered_bool_labels)
   def flat_prechecked_loops = _clean_structure_flat_prechecked_loops(pre_inline_magic_wide_setup)
   def bottom_tested_loops = _clean_structure_bottom_tested_loops(flat_prechecked_loops)
   def local_return_joins = _clean_collapse_local_return_joins(bottom_tested_loops)
   def return_gotos = _clean_inline_return_gotos(local_return_joins)
   def post_return_goto_labels = _clean_drop_unreachable_unused_labels(_clean_drop_unused_labels(return_gotos))
   def rendered_temp_inlines = post_return_goto_labels
   def rendered_address_loads = _clean_rendered_address_loads(rendered_temp_inlines)
   def rendered_address_stores = _clean_inline_address_temp_stores(rendered_address_loads)
   def rendered_index_temps = _clean_rendered_index_temp_chains(rendered_address_stores)
   def sub_condition_windows = _clean_inline_sub_condition_windows(rendered_index_temps)
   def pointer_table_temps = _clean_fold_pointer_table_temps(sub_condition_windows)
   def local_string_tables = _clean_aggregate_local_string_tables(pointer_table_temps)
   def local_scalar_tables = _clean_aggregate_local_scalar_tables(local_string_tables)
   def folded_local_constants = _clean_fold_local_constant_reassigns(local_scalar_tables)
   def propagated_local_constants = _clean_propagate_local_constants(folded_local_constants)
   def no_dead_const_locals = _clean_drop_dead_const_local_assigns(propagated_local_constants)
   def char_shift_loops = _clean_collapse_char_shift_loops(no_dead_const_locals)
   def counted_for_loops = _clean_structure_counted_for_loops(char_shift_loops)
   def no_dead_local_reassigns = _clean_drop_dead_local_reassigns(counted_for_loops)
   def stack_indices = _clean_normalize_stack_addr_indices(no_dead_local_reassigns)
   def late_stack_index_temps = _clean_rendered_index_temp_chains(stack_indices)
   def local_i32_indices = _clean_normalize_local_i32_indices(late_stack_index_temps)
   def late_index_conditions = _clean_inline_index_value_conditions(local_i32_indices)
   def preincrement_index_temps = _clean_inline_preincrement_index_temps(late_index_conditions)
   def call_result_local_aliases = _clean_inline_call_result_local_aliases(preincrement_index_temps)
   def local_pointer_temp_stores = _clean_inline_local_pointer_temp_stores(call_result_local_aliases)
   def local_call_aliases = _clean_inline_local_call_aliases(local_pointer_temp_stores)
   def no_unused_local_assigns = _clean_drop_unused_local_assigns(local_call_aliases)
   def no_stack_scratch_allocs = _clean_drop_stack_scratch_allocs(no_unused_local_assigns)
   def no_magic_wide_setup = _clean_drop_magic_wide_setup(no_stack_scratch_allocs)
   def no_dead_rendered_temps = _clean_drop_dead_rendered_temps(no_magic_wide_setup)
   def canary_normalized = _clean_normalize_stack_canary_lines(no_dead_rendered_temps)
   def no_stack_canary_noise = _clean_drop_stack_canary_noise(canary_normalized)
   def no_stack_canary_terminal_xor = _clean_drop_terminal_stack_canary_xor_residue(no_stack_canary_noise)
   def bool_returns = _clean_collapse_return_ifs(no_stack_canary_terminal_xor)
   def post_bool_return_tails = _clean_drop_return_dead_block_tails(bool_returns)
   def zero_trip_mod_returns = _clean_simplify_zero_trip_mod_returns(post_bool_return_tails)
   def compact = _clean_compact_blank_lines(zero_trip_mod_returns)
   mut cleaned = _clean_reindent_bare_for_headers(_clean_normalize_render_text(compact))
   if is_dict(opts) && opts.get("truncated_render", false) {
      cleaned = _clean_balance_trailing_braces(cleaned)
   }
   def report = _clean_structure_report(cleaned)
   if is_dict(opts) && opts.get("strict_structure", false) && !report.get("ok", false) {
      panic("decompiler structure imbalance: depth=" + to_str(report.get("depth", 0)) +
         " min_depth=" + to_str(report.get("min_depth", 0)) +
         " first_bad_line=" + to_str(report.get("first_bad_line", 0)))
   }
   mut final = _clean_balance_trailing_braces(cleaned)
   if is_dict(opts) && opts.get("auto_type_recovery", dict()).len > 0 {
      final = _clean_apply_render_type_fields(final, opts.get("auto_type_recovery", dict()))
   }
   if is_dict(opts) && opts.get("auto_renames", dict()).len > 0 {
      final = _clean_apply_render_renames(final, opts.get("auto_renames", dict()))
   }
   if is_dict(opts) && opts.get("callee_saved_aliases", dict()).len > 0 {
      final = _clean_apply_render_alias_uses(final, opts.get("callee_saved_aliases", dict()))
   }
   final = _clean_simplify_named_byte_field_casts(final)
   final = _clean_errno_location_text(final)
   final = _clean_inline_errno_result_conditions(final)
   final = _clean_drop_errno_mirror_temps(final)
   final = _clean_known_struct_call_result_fields(final)
   final = _clean_simplify_named_byte_field_casts(final)
   final = _clean_drop_duplicate_return_value_assigns(final)
   final = _clean_inline_printf_call_result_args(final)
   final = _clean_repair_printf_input_args(final)
   final = _clean_name_libc_resource_values(final)
   final = _clean_repair_fclose_resource_aliases(final)
   final = _clean_name_prompt_read_buffers(final)
   final = _clean_discard_unused_one_byte_reads(final)
   final = _clean_castless_bracket_indices(final)
   final = _clean_rendered_mem_indices_text(final)
   final = _clean_flatten_selected_pointer_nested_indices(final)
   final = _clean_collapse_staged_byte_sum_loops(final)
   final = _clean_name_string_sum_loop_vars(final)
   final = _clean_repair_printf_input_args(final)
   final = _clean_collapse_pointer_range_sum_loops(final)
   final = _clean_collapse_shifted_string_compare_loops(final)
   final = _clean_repair_printf_input_args(final)
   final = _clean_name_heap_compare_buffers(final)
   final = _clean_name_compare_result_temps(final)
   final = _clean_name_hour_result_temps(final)
   final = _clean_recover_cur_hour_error_returns(final)
   final = _clean_inline_missing_failure_gotos(final)
   final = _clean_inline_usage_guard_labels(final)
   final = _clean_name_argv_input_string_compares(final)
   final = _clean_inline_expected_input_mismatch_gotos(final)
   final = _clean_collapse_common_prefix_compare_loops(final)
   final = _clean_inline_missing_argc_usage_gotos(final)
   final = _clean_return_after_missing_success_gotos(final)
   final = _clean_drop_duplicate_input_aliases(final)
   final = _clean_name_mask_check_signature(final)
   final = _clean_name_ioli_digit_sum_check(final)
   final = _clean_drop_ioli_failure_tail(final)
   final = _clean_collapse_ioli_digit_prefix_hit_loops(final)
   final = _clean_name_ioli_even_password_check(final)
   final = _clean_collapse_ioli_even_retry_loop(final)
   final = _clean_name_ioli_env_main(final)
   final = _clean_name_ioli_simple_password_main(final)
   final = _clean_name_ioli_test_args(final)
   final = _clean_name_ioli_lolo_argv_scan(final)
   final = _clean_struct_ioli_lolo_argv_scan(final)
   final = _clean_name_ioli_lolo_flag(final)
   final = _clean_simplify_ioli_lolo_flag_conditions(final)
   final = _clean_normalize_argv_envp_scaled_indices(final)
   final = _clean_name_mod_checksum_helper(final)
   final = _clean_summarize_mod_checksum_helper(final)
   final = _clean_summarize_alnum_validator(final)
   final = _clean_normalize_fgets_stdin_trim(final)
   final = _clean_name_byte_pack_helper(final)
   final = _clean_recover_cpuid_vendor_buffer(final)
   final = _clean_collapse_cpuid_vendor_string(final)
   final = _clean_name_argv_guard_input(final)
   final = _clean_name_expected_argv_input(final)
   final = _clean_inline_strcmp_compare_temps(final)
   final = _clean_recover_mask_check_success_main(final)
   final = _clean_collapse_masked_password_conditions(final)
   final = _clean_drop_duplicate_input_aliases(final)
   final = _clean_name_linked_list_lookup_verify(final)
   final = _clean_simplify_rendered_literal_casts(final)
   final = _clean_simplify_status_literals(final)
   final = _clean_simplify_rendered_byte_casts(final)
   final = _clean_collapse_byte_add_compare_conditions(final)
   final = _clean_indexed_data_byte_rotate_verify(final)
   final = _clean_collapse_cadet_palindrome_check(final)
   final = _clean_collapse_cadet_main(final, opts)
   final = _clean_collapse_mma_simplehash_main(final)
   final = _clean_collapse_mma_simplehash_calc_hash(final)
   final = _clean_collapse_defcamp_r100_verify(final, opts)
   final = _clean_summarize_mask_check_helper(final)
   final = _clean_collapse_indexed_compare_return_loops(final)
   final = _clean_collapse_linked_list_lookup_decode_loops(final)
   final = _clean_repair_if_tail_ops(final)
   final = _clean_simplify_rendered_bool_constants(final)
   final = _clean_simplify_rendered_byte_stores(final)
   final = _clean_drop_dead_rendered_temps(final)
   final = _clean_drop_unused_scratch_assigns(final)
   final = _clean_drop_terminal_opaque_even_product_scratch(final)
   final = _clean_collapse_branchless_byte_network(final)
   final = _clean_parenthesize_mixed_bitwise_assigns(final)
   final = _clean_drop_state_machine_residual_gotos(final)
   final = _clean_collapse_known_regex_state_machine(final)
   final = _clean_annotate_decoded_string_calls(final)
   final = _clean_inline_decoded_shift_calls(final)
   final = _clean_drop_cpuid_main_phantom_args(final)
   final = _clean_fix_ioli_checksum_signature(final)
   final = _clean_collapse_ioli_even_retry_loop(final)
   final = _clean_name_ioli_env_main(final)
   final = _clean_name_ioli_simple_password_main(final)
   final = _clean_name_ioli_test_args(final)
   final = _clean_name_ioli_lolo_flag(final)
   final = _clean_simplify_ioli_lolo_flag_conditions(final)
   final = _clean_name_ioli_failure_helper(final)
   final = _clean_normalize_libc_string_literal_args(final)
   final = _clean_collapse_sprintf_printf_buffers(final)
   final = _clean_lift_global_input_copy(final)
   final = _clean_collapse_sequential_check_chain(final)
   final = _clean_inline_check_condition_temp_chains(final)
   final = _clean_simplify_rendered_byte_casts(final)
   final = _clean_normalize_inline_pointer_table_refs(final)
   final = _clean_compact_check_helpers(final)
   final = _clean_simplify_string_compare_conditions(final)
   final = _clean_simplify_string_compare_returns(final)
   final = _clean_simplify_string_len_conditions(final)
   final = _clean_simplify_strlen_calls(final)
   final = _clean_collapse_ascii_sum_input_loop(final)
   final = _clean_simplify_modsum_call_conditions(final)
   final = _clean_normalize_modsum_terminal_success_fail(final)
   final = _clean_normalize_terminal_success_fail_guards(final)
   final = _clean_drop_return_after_challenge_terminal_calls(final)
   final = _clean_name_terminal_input_helper(final)
   final = _clean_drop_duplicate_input_aliases(final)
   final = _clean_normalize_argv_envp_scaled_indices(final)
   final = _clean_normalize_rip_relative_data_symbols(final)
   if str.find(final, "node.key") >= 0 && str.find(final, "decoded[") >= 0 {
      final = _clean_structure_counted_for_loops(final)
   }
   final = _clean_collapse_indexed_compare_return_loops(final)
   final = _clean_collapse_linked_list_lookup_decode_loops(final)
   if is_dict(opts) && opts.get("auto_type_recovery", dict()).len > 0 {
      final = _clean_apply_render_type_fields(final, opts.get("auto_type_recovery", dict()))
   }
   final = _clean_simplify_named_byte_field_casts(final)
   final
}

fn _branch_target_count(list rows, int target) int {
   mut count = 0
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" && int(r.get("target", 0)) == target { count += 1 }
      i += 1
   }
   count
}

fn _loop_has_following_same_backedge(list rows, int idx, int target) bool {
   mut j = idx + 1
   def end = min(rows.len, idx + 8)
   while j < end {
      def r = rows[j]
      if r.get("op", "") == "return" { return false }
      if r.get("op", "") == "branch" {
         if r.get("condition", "") == "always" && int(r.get("target", 0)) == target { return true }
         if int(r.get("target", 0)) != target { return false }
      }
      j += 1
   }
   false
}

fn _pseudo_body(dict bin, list rows, int indent, any opts=dict()) str {
   mut b = str.Builder(max(128, rows.len * 40))
   def pad = str.repeat(" ", indent)
   def clean = _clean_enabled(opts)
   def lm = _labels_for_rows(rows, arch(bin))
   mut lifted = []
   if is_dict(opts) && is_list(opts.get("lifted", [])) && opts.get("lifted", []).len == rows.len {
      lifted = opts.get("lifted", [])
   } else {
      mut li = 0
      while li < rows.len {
         lifted = lifted.append(_lift_row(bin, rows[li]))
         li += 1
      }
      lifted = _attach_compare_context(bin, lifted)
   }
   def dataflow = is_dict(opts) && opts.get("dataflow", false) ? _def_use_rows(lifted, opts.get("target", 0)) : dict()
   mut sig = dict()
   if is_dict(opts) && is_dict(opts.get("signature", dict())) && opts.get("signature", dict()).len > 0 {
      sig = opts.get("signature", dict())
   } else {
      sig = _function_signature_for(bin, opts.get("target", 0), lifted, int(lifted.len > 0 ? lifted[0].get("addr", 0) : 0), rows.len > 0 ? int(rows[rows.len - 1][0]) - int(rows[0][0]) + int(rows[rows.len - 1][3]) : 512)
   }
   mut factset = dict()
   if clean {
      if is_dict(opts.get("facts", dict())) && opts.get("facts", dict()).len > 0 {
         factset = opts.get("facts", dict())
      } else {
         factset = _facts_from(bin, opts.get("target", 0), lifted,
            cfg(bin, opts.get("target", 0), int(opts.get("max_bytes", 512))))
      }
   }
   def clean_skip = clean ? _clean_skip_map(lifted, factset) : dict()
   mut loop_info = dict()
   if is_dict(opts.get("loops", dict())) && opts.get("loops", dict()).len > 0 {
      loop_info = opts.get("loops", dict())
   } elif is_dict(opts.get("model", dict())) && is_dict(opts.get("model", dict()).get("loops", dict())) {
      loop_info = opts.get("model", dict()).get("loops", dict())
   } elif clean {
      loop_info = cfg_loops(bin, opts.get("target", 0), int(opts.get("max_bytes", 512)))
   }
   def loop_maps = _cfg_loop_maps(lifted, loop_info)
   def loop_headers = loop_maps.get("headers", dict())
   def loop_latches = loop_maps.get("latches", dict())
   mut structured_targets = _structured_if_targets(lifted)
   mut forced_labels = dict()
   def frame = _frame_model(lifted)
   def slots = frame.get("slots", [])
   mut si = 0
   if !clean {
      while si < slots.len {
         def sl = slots[si]
         b = str.builder_append(b, pad + "mut " + _rename_name(bin, sl.get("name", "local")) + " = nil\n")
         si += 1
      }
      if slots.len > 0 { b = str.builder_append(b, "\n") }
   }
   mut i = 0
   mut loop_stack = []
   mut skip_clean_return_addr = 0
   mut rendered_state_machines = dict()
   def state_dispatcher_addrs = clean ? _state_machine_dispatcher_addr_map(opts) : dict()
   mut state_machine_skip_from = -1
   mut state_machine_skip_until = -1
   while i < rows.len {
      def ir = lifted[i]
      def m = ir.get("mnemonic", "")
      def ops = ir.get("operands", "")
      if clean && state_machine_skip_from >= 0 && i >= state_machine_skip_from && i < state_machine_skip_until {
         i += 1
         continue
      }
      if clean && skip_clean_return_addr != 0 && int(ir.get("addr", 0)) == skip_clean_return_addr && ir.get("op", "") == "return" {
         skip_clean_return_addr = 0
         i += 1
         continue
      }
      def lraw = lm.get(to_str(ir.get("addr", 0)), "")
      def lnow = lraw.len > 0 ? _rename_addr(bin, ir.get("addr", 0), lraw) : ""
      if (clean && state_dispatcher_addrs.get(to_str(int(ir.get("addr", 0))), false) &&
         !(ir.get("op", "") == "branch" && ir.get("kind", "") == "switch")){
         def sm = _state_machine_for_dispatcher(opts, int(ir.get("addr", 0)))
         def sk = sm.len > 0 ? to_str(sm.get("switch_addr", 0)) : ""
         if (sm.len > 0 && sk.len > 0 && !rendered_state_machines.get(sk, false) &&
            lnow.len > 0 && _branch_target_count(lifted, int(ir.get("addr", 0))) > 0){
            def curpad = _loop_render_pad(pad, loop_stack.len)
            b = str.builder_append(b, curpad + lnow + ":\n")
            b = str.builder_append(b, _render_state_machine_summary(sm, curpad))
            rendered_state_machines = rendered_state_machines.set(sk, true)
            state_machine_skip_from = i + 1
            state_machine_skip_until = max(state_machine_skip_until, _state_machine_skip_end(sm))
         }
         i += 1
         continue
      }
      def starts_loop = loop_headers.contains(to_str(ir.get("addr", 0)))
      if starts_loop {
         b = str.builder_append(b, _loop_render_pad(pad, loop_stack.len) + "while true{\n")
         loop_stack = loop_stack.append(int(ir.get("addr", 0)))
      }
      def curpad = _loop_render_pad(pad, loop_stack.len)
      def label_shared = _branch_target_count(lifted, int(ir.get("addr", 0))) > 1
      def label_key = to_str(int(ir.get("addr", 0)))
      if (lnow.len > 0 && !starts_loop && (forced_labels.get(label_key, false) ||
            !structured_targets.get(label_key, false) || label_shared)){ b = str.builder_append(b, curpad + lnow + ":\n") }
      if clean && _clean_skip_row(clean_skip, i) {
         i += 1
         continue
      }
      if !clean {
         b = str.builder_append(b, curpad + "; " + _hex(ir.get("addr", 0)) + "  " + m + (ops.len > 0 ? (" " + ops) : "") + "\n")
         b = str.builder_append(b, _du_row_comment(dataflow, i, curpad))
      }
      def op = ir.get("op", "insn")
      if op == "assign" || op == "arith" || op == "compare" || op == "stack" {
         b = str.builder_append(b, clean ? _render_ir_clean_row(bin, lifted, i, curpad, clean_skip, sig) : (curpad + _row_effect_with_sig(bin, sig, lifted, i, ir) + "\n"))
         if !clean && ir.get("ref_kind", "") == "string" {
            b = str.builder_append(b, curpad + "; xref string " + ir.get("ref_name", "") + " = " + repr(ir.get("ref", dict()).get("value", "")) + "\n")
         } elif !clean && ir.get("ref_kind", "") == "import" {
            b = str.builder_append(b, curpad + "; xref import " + ir.get("ref_name", "") + "\n")
         } elif !clean && ir.get("ref_kind", "") == "data" {
            b = str.builder_append(b, curpad + "; xref data " + ir.get("ref_name", "") + "\n")
         }
      } elif op == "return" {
         if clean {
            def rexpr = _clean_return_expr_sig(bin, sig, lifted, i)
            b = str.builder_append(b, curpad + "return" + (rexpr.len > 0 ? (" " + rexpr) : "") + "\n")
         } else {
            b = str.builder_append(b, curpad + "return\n")
         }
      } elif op == "call" {
         def call_text = _call_render(ir.get("target_name", "call_target"), clean ? _clean_call_arg_model_with_sig(bin, sig, lifted, i) : _call_arg_model_with_sig(bin, sig, lifted, i), ir.get("family", _rows_family(lifted)))
         def saved = clean ? _clean_call_result_saved_after(lifted, i) : dict()
         def used_ret = clean && !saved.get("ok", false) ? _clean_call_result_used_after(lifted, i) : ""
         b = str.builder_append(b, curpad + (saved.get("ok", false) ? (saved.get("dst", "") + " = " + call_text) : (used_ret.len > 0 ? (used_ret + " = " + call_text) : call_text)) + "\n")
         if clean && _clean_call_is_noreturn(bin, ir) {
            def next_live = _clean_next_live_after_noreturn(lifted, i)
            i = max(i, next_live - 1)
         }
      } elif op == "syscall" {
         b = str.builder_append(b, curpad + _syscall_render(lifted, i) + "\n")
      } elif op == "branch" {
         if ir.get("kind", "") == "switch" {
            def sm = clean ? _state_machine_for_switch(opts, int(ir.get("addr", 0))) : dict()
            if sm.len > 0 {
               def sk = to_str(sm.get("switch_addr", ir.get("addr", 0)))
               if !rendered_state_machines.get(sk, false) {
                  b = str.builder_append(b, _render_state_machine_summary(sm, curpad))
                  rendered_state_machines = rendered_state_machines.set(sk, true)
               }
               state_machine_skip_from = i + 1
               state_machine_skip_until = max(state_machine_skip_until, _state_machine_skip_end(sm))
            } else {
               b = str.builder_append(b, _render_switch_row(bin, ir, curpad))
            }
            i += 1
            continue
         }
         def cond = ir.get("condition", "")
         def to = ir.get("target", 0)
         def lname = _branch_target_name(bin, lm, int(to))
         def entry_sm = clean && int(to) > 0 ? _state_machine_for_dispatcher(opts, int(to)) : dict()
         if entry_sm.len > 0 {
            def esk = to_str(entry_sm.get("switch_addr", 0))
            if esk.len > 0 && !rendered_state_machines.get(esk, false) {
               if cond == "always" {
                  b = str.builder_append(b, _render_state_machine_summary(entry_sm, curpad))
               } else {
                  def expr = _clean_branch_condition_expr_sig(bin, sig, lifted, i, cond)
                  b = str.builder_append(b, curpad + "if " + expr + "{\n")
                  b = str.builder_append(b, _render_state_machine_summary(entry_sm, curpad + "  "))
                  b = str.builder_append(b, curpad + "}\n")
               }
               rendered_state_machines = rendered_state_machines.set(esk, true)
               def entry_idx = _row_index_for_addr(lifted, int(to))
               if entry_idx >= 0 {
                  state_machine_skip_from = entry_idx
                  state_machine_skip_until = max(state_machine_skip_until, _state_machine_skip_end(entry_sm))
               }
               i += 1
               continue
            }
         }
         def top_loop = loop_stack.len > 0 ? int(loop_stack[loop_stack.len - 1]) : 0
         if int(to) <= 0 {
            def jtext = clean ? _clean_computed_jump_render(bin, sig, lifted, i) : ("computed_jump(" + _ny_operand(ir.get("dst", "target")) + ")")
            if cond == "always" {
               b = str.builder_append(b, curpad + jtext + "\n")
            } else {
               def expr = clean ? _clean_branch_condition_expr_sig(bin, sig, lifted, i, cond) : _branch_condition_expr(lifted, i, cond)
               b = str.builder_append(b, curpad + "if " + expr + "{ " + jtext + " }\n")
            }
         } elif loop_stack.len > 0 && loop_latches.contains(to_str(ir.get("addr", 0))) && int(loop_latches.get(to_str(ir.get("addr", 0)), 0)) == top_loop {
            if cond == "always" {
               loop_stack = _drop_last(loop_stack)
               b = str.builder_append(b, _loop_render_pad(pad, loop_stack.len) + "}\n")
            } elif _loop_has_following_same_backedge(lifted, i, top_loop) {
               def expr = clean ? _clean_branch_condition_expr_sig(bin, sig, lifted, i, cond) : _branch_condition_expr(lifted, i, cond)
               b = str.builder_append(b, curpad + "if " + expr + "{ continue }\n")
            } else {
               def expr = clean ? _clean_branch_condition_expr_sig(bin, sig, lifted, i, cond) : _branch_condition_expr(lifted, i, cond)
               b = str.builder_append(b, curpad + "if " + _clean_negated_condition_expr(expr) + "{ break }\n")
               loop_stack = _drop_last(loop_stack)
               b = str.builder_append(b, _loop_render_pad(pad, loop_stack.len) + "}\n")
            }
         } elif loop_stack.len == 0 && cond != "always" && to > int(ir.get("addr", 0)) {
            def ret_shape = clean ? _clean_branch_return_shape(bin, lifted, i, curpad, clean_skip, sig) : dict()
            if ret_shape.get("ok", false) {
               b = str.builder_append(b, ret_shape.get("text", ""))
               i = int(ret_shape.get("next", i + 1)) - 1
            } else {
               def guard_shape = clean ? _clean_guard_fallthrough_return_shape(bin, lifted, i, curpad, clean_skip, sig) : dict()
               if guard_shape.get("ok", false) {
                  b = str.builder_append(b, guard_shape.get("text", ""))
                  structured_targets = structured_targets.set(to_str(int(guard_shape.get("target_addr", 0))), true)
                  i = int(guard_shape.get("next", i + 1)) - 1
               } else {
                  def shape = _if_else_shape(lifted, i)
                  if shape.get("ok", false) {
                     def expr = clean ? _clean_branch_condition_expr_sig(bin, sig, lifted, i, cond) : _branch_condition_expr(lifted, i, cond)
                     b = str.builder_append(b, curpad + "if " + (clean ? _clean_negated_condition_expr(expr) : ("!(" + expr + ")")) + "{\n")
                     mut bi = i + 1
                     while bi < int(shape.get("jump_idx", 0)) {
                        b = str.builder_append(b, clean ? _render_ir_clean_row(bin, lifted, bi, curpad + "  ", clean_skip, sig) : _render_ir_simple_row(bin, lifted, bi, curpad + "  ", dataflow, sig))
                        bi += 1
                     }
                     b = str.builder_append(b, curpad + "} else {\n")
                     bi = int(shape.get("else_idx", 0))
                     while bi < int(shape.get("end_idx", 0)) {
                        b = str.builder_append(b, clean ? _render_ir_clean_row(bin, lifted, bi, curpad + "  ", clean_skip, sig) : _render_ir_simple_row(bin, lifted, bi, curpad + "  ", dataflow, sig))
                        bi += 1
                     }
                     b = str.builder_append(b, curpad + "}\n")
                     i = int(shape.get("end_idx", 0)) - 1
                  } else {
                     def target_idx = _row_index_for_addr(lifted, int(to))
                     if _can_inline_if_body(lifted, i + 1, target_idx) {
                        def expr = clean ? _clean_branch_condition_expr_sig(bin, sig, lifted, i, cond) : _branch_condition_expr(lifted, i, cond)
                        b = str.builder_append(b, curpad + "if " + (clean ? _clean_negated_condition_expr(expr) : ("!(" + expr + ")")) + "{\n")
                        mut bi = i + 1
                        while bi < target_idx {
                           b = str.builder_append(b, clean ? _render_ir_clean_row(bin, lifted, bi, curpad + "  ", clean_skip, sig) : _render_ir_simple_row(bin, lifted, bi, curpad + "  ", dataflow, sig))
                           bi += 1
                        }
                        b = str.builder_append(b, curpad + "}\n")
                        i = target_idx - 1
                     } else {
                        def expr = clean ? _clean_branch_condition_expr_sig(bin, sig, lifted, i, cond) : _branch_condition_expr(lifted, i, cond)
                        structured_targets = structured_targets.set(to_str(int(to)), false)
                        forced_labels = forced_labels.set(to_str(int(to)), true)
                        b = str.builder_append(b, curpad + "if " + expr + "{ goto " + lname + " }\n")
                     }
                  }
               }
            }
         } elif cond == "always" {
            def rexpr = clean ? _clean_expr_with_sig_bin(bin, sig, lifted, _clean_branch_return_goto_expr(bin, lifted, i)) : ""
            if clean && rexpr.len > 0 && _branch_target_count(lifted, int(to)) == 1 { skip_clean_return_addr = int(to) }
            if rexpr.len == 0 {
               structured_targets = structured_targets.set(to_str(int(to)), false)
               forced_labels = forced_labels.set(to_str(int(to)), true)
            }
            b = str.builder_append(b, curpad + (rexpr.len > 0 ? ("return " + rexpr) : ("goto " + lname)) + "\n")
         }
         else {
            def expr = clean ? _clean_branch_condition_expr_sig(bin, sig, lifted, i, cond) : _branch_condition_expr(lifted, i, cond)
            structured_targets = structured_targets.set(to_str(int(to)), false)
            forced_labels = forced_labels.set(to_str(int(to)), true)
            b = str.builder_append(b, curpad + "if " + expr + "{ goto " + lname + " }\n")
         }
      }
      i += 1
   }
   while loop_stack.len > 0 {
      loop_stack = _drop_last(loop_stack)
      b = str.builder_append(b, _loop_render_pad(pad, loop_stack.len) + "}\n")
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   if clean { return _clean_finish_render(out, opts) }
   out
}

fn ny_pseudocode(any source, any target=0, any opts=dict()) str {
   "Render compact Nytrix analyst pseudocode for a section/function/address.
   This keeps disassembly comments beside recovered intent so private reversing
   work can be polished directly in Nytrix."
   mut bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   if opts.contains("renames") { bin = with_renames(bin, opts.get("renames", dict())) }
   mut rows = []
   mut name = "entry_" + str.to_hex(entry(bin), 0)
   if is_dict(opts) && is_list(opts.get("rows", [])) && opts.get("rows", []).len > 0 {
      rows = opts.get("rows", [])
      if is_dict(target) { name = target.get("name", name) }
      elif is_str(target) { name = target }
   } elif target == 0 {
      rows = disassemble(bin, ".text", int(opts.get("max_bytes", 256)))
   } elif is_str(target) {
      rows = disassemble_function(bin, target, int(opts.get("max_bytes", 512)))
      name = target
      if rows.len == 0 { rows = disassemble(bin, target, int(opts.get("max_bytes", 512))) }
   } else {
      rows = disassemble(bin, target, int(opts.get("max_bytes", 512)))
      if is_dict(target) { name = target.get("name", name) }
   }
   def addr_for_name = is_dict(target) ? int(target.get("value", target.get("addr", 0))) : (is_int(target) ? int(target) : (is_str(target) ? _named_addr(bin, target) : 0))
   name = addr_for_name > 0 ? _rename_addr(bin, addr_for_name, _rename_name(bin, _safe_name(name, "sub"))) : _rename_name(bin, _safe_name(name, "sub"))
   mut lifted = []
   if is_dict(opts) && is_list(opts.get("lifted", [])) && opts.get("lifted", []).len == rows.len {
      lifted = opts.get("lifted", [])
   } else {
      mut li = 0
      while li < rows.len {
         lifted = lifted.append(_lift_row(bin, rows[li]))
         li += 1
      }
      lifted = _attach_compare_context(bin, lifted)
   }
   mut sig = dict()
   if is_dict(opts) && is_dict(opts.get("signature", dict())) && opts.get("signature", dict()).len > 0 {
      sig = opts.get("signature", dict())
   } else {
      sig = _function_signature_for(bin, target, lifted, addr_for_name, int(opts.get("max_bytes", 512)))
   }
   sig = _signature_main_aliases(sig, name).set("name", name)
   mut popts = opts.set("target", target).set("lifted", lifted).set("signature", sig).set("analysis", bin)
   .set("max_bytes", int(opts.get("max_bytes", 512)))
   if _clean_enabled(opts) {
      popts = popts.set("callee_saved_aliases", _clean_callee_saved_render_aliases(bin, sig, lifted))
   }
   if _clean_enabled(opts) {
      def r100 = _clean_defcamp_r100_verify_direct(bin, name, addr_for_name)
      if r100.len > 0 { return r100 }
   }
   if _clean_enabled(opts) {
      def branchless = _clean_branchless_byte_network_row_summary(name, sig, lifted)
      if branchless.len > 0 { return branchless }
   }
   if _clean_enabled(opts) && (!is_dict(popts.get("model", dict())) || popts.get("model", dict()).len == 0) {
      def model = function_model(bin, target, int(opts.get("max_bytes", 512)))
      popts = popts.set("model", model).set("loops", model.get("loops", dict())).set("facts", model.get("facts", dict()))
   }
   mut body_opts = popts.get("strict_structure", false) ? popts.set("strict_structure", false) : popts
   if body_opts.get("auto_renames", dict()).len > 0 { body_opts = body_opts.set("auto_renames", dict()) }
   def out = "fn " + name + "(" + _signature_param_text(sig) + "){\n" + _pseudo_body(bin, rows, 2, body_opts) + "}\n"
   if _clean_enabled(opts) && opts.get("auto_rename_locals", false) {
      def base_opts = popts.set("auto_rename_locals", false).set("auto_renames", dict()).set("auto_type_recovery", dict())
      def base_text = _clean_finish_render(out, base_opts)
      def trec = type_recovery(bin, target, base_opts.set("max_bytes", int(opts.get("max_bytes", 512)))
         .set("rendered_text", base_text))
      if trec.get("renames", dict()).len > 0 {
         popts = popts.set("auto_renames", trec.get("renames", dict()))
      }
      if trec.len > 0 { popts = popts.set("auto_type_recovery", trec) }
      return _clean_finish_render(base_text, popts)
   }
   _clean_enabled(opts) ? _clean_finish_render(out, popts) : out
}

fn pseudocode(any source, any target=0, any opts=dict()) str {
   "Alias for ny_pseudocode(...)."
   ny_pseudocode(source, target, opts)
}

fn decompile(any source, any target=0, any opts=dict()) dict {
   "Return `{ok, language:'ny', text, analysis}` for a Nytrix decompile request."
   mut bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   if opts.contains("renames") { bin = with_renames(bin, opts.get("renames", dict())) }
   if !bin.get("ok", false) { return {"ok": false, "text": "", "analysis": bin} }
   def maxb = int(opts.get("max_bytes", 512))
   {"ok": true, "language": "ny", "text": ny_pseudocode(bin, target, opts),
      "structured": structured(bin, target, maxb), "analysis": bin}
}

fn _decompile_name_has(str name0, str needle) bool {
   str.find(str.lower(name0), needle) >= 0
}

fn _decompile_runtime_name(str name0) bool {
   def name = str.lower(name0)
   if (name == "_start" || name == "_init" || name == "_fini" || name == ".text_start" ||
      name == "_text_start"){ return true }
   if (_decompile_name_has(name, "__libc_") || _decompile_name_has(name, "__pthread_") ||
      _decompile_name_has(name, "__gmon_") || _decompile_name_has(name, "__do_global")){ return true }
   if _decompile_name_has(name, "register_tm_clones") || _decompile_name_has(name, "deregister_tm_clones") { return true }
   if _decompile_name_has(name, "frame_dummy") || _decompile_name_has(name, "get_pc_thunk") { return true }
   if _decompile_name_has(name, "_init_start") || _decompile_name_has(name, "_fini_start") { return true }
   false
}

fn _decompile_challenge_name(str name0) bool {
   def name = str.lower(name0)
   if name == "main" || name == "check" || name == "validate" || name == "verify" { return true }
   if (_decompile_name_has(name, "password") || _decompile_name_has(name, "serial") ||
      _decompile_name_has(name, "license") || _decompile_name_has(name, "flag")){ return true }
   if (_decompile_name_has(name, "crack") || _decompile_name_has(name, "keygen") ||
      _decompile_name_has(name, "gate") || _decompile_name_has(name, "stage")){ return true }
   false
}

fn _decompile_text_score(str text0) int {
   def text = str.lower(text0)
   mut score = 0
   if str.find(text, "nullhaven") >= 0 || str.find(text, "gate") >= 0 { score += 80 }
   if (str.find(text, "flag") >= 0 || str.find(text, "success") >= 0 ||
      str.find(text, "correct") >= 0 || str.find(text, "congrat") >= 0 ||
      str.find(text, "welcome") >= 0 || str.find(text, "unlocked") >= 0 ||
      str.find(text, "good job") >= 0){ score += 70 }
   if (str.find(text, "wrong") >= 0 || str.find(text, "incorrect") >= 0 ||
      str.find(text, "invalid") >= 0 || str.find(text, "denied") >= 0 ||
      str.find(text, "failed") >= 0 || str.find(text, "try again") >= 0 ||
      str.find(text, "nope") >= 0){ score += 45 }
   if (str.find(text, "password") >= 0 || str.find(text, "passphrase") >= 0 ||
      str.find(text, "serial") >= 0 || str.find(text, "license") >= 0 ||
      str.find(text, "key") >= 0 || str.find(text, "input") >= 0){ score += 45 }
   if (str.find(text, "enter") >= 0 || str.find(text, "usage") >= 0 ||
      str.find(text, "argv") >= 0 || str.find(text, "stdin") >= 0){ score += 20 }
   if (str.find(text, "/proc/self/status") >= 0 || str.find(text, "tracerpid") >= 0 ||
      str.find(text, "ptrace") >= 0 || str.find(text, "debug") >= 0 ||
      str.find(text, "anti") >= 0){ score += 40 }
   if (str.find(text, "deadc0de") >= 0 || str.find(text, "13371337") >= 0 ||
      str.find(text, "edb88320") >= 0 || str.find(text, "crc") >= 0 ||
      str.find(text, "zlib") >= 0 || str.find(text, "aes") >= 0 ||
      str.find(text, "sha") >= 0 || str.find(text, "xor") >= 0){ score += 30 }
   score
}

fn _decompile_candidate_score(dict bin, dict f, int max_bytes) int {
   def addr = int(f.get("value", f.get("addr", 0)))
   def name = _rename_addr(bin, addr, _rename_name(bin, _safe_name(f.get("name", ""), "sub_" + str.to_hex(addr, 0))))
   def src = f.get("source", "")
   mut score = 0
   if _decompile_challenge_name(name) { score += 120 }
   if _decompile_runtime_name(name) { score -= 180 }
   if src == "symbol" { score += 20 }
   if src == "prologue" { score += 8 }
   if src == "call_target" { score += 5 }
   if src == "entry" { score -= 70 }
   if src == "exec_section" { score -= 120 }
   def rows = disassemble_function(bin, f, max_bytes)
   if rows.len == 0 { return score - 80 }
   score += min(rows.len, 48)
   def a = arch(bin)
   mut i = 0
   mut branch_count = 0
   mut call_count = 0
   while i < rows.len {
      def r = rows[i]
      def kind = dasm.instruction_kind(a, r[1])
      def ops = str.lower(r[1] + " " + r[2])
      if kind == "branch" {
         branch_count += 1
         score += 2
      }
      elif kind == "call" {
         call_count += 1
         score += 6
      }
      elif kind == "syscall" { score += 8 }
      if (str.find(ops, "edb88320") >= 0 || str.find(ops, "deadc0de") >= 0 ||
         str.find(ops, "13371337") >= 0){ score += 35 }
      if (str.find(ops, "rol") >= 0 || str.find(ops, "ror") >= 0 ||
         str.find(ops, "xor") >= 0 || str.find(ops, "crc") >= 0){ score += 2 }
      i += 1
   }
   def refs = data_refs(bin, f, max_bytes)
   mut ref_text_score = 0
   i = 0
   while i < refs.len {
      score += 12
      def ts = _decompile_text_score(refs[i].get("value", "") + " " + refs[i].get("name", ""))
      ref_text_score += ts
      score += ts
      i += 1
   }
   def calls = call_targets(bin, f, max_bytes)
   mut call_text_score = 0
   i = 0
   while i < calls.len {
      def cname = _display_symbol(calls[i].get("name", ""))
      def cat = _summary_import_category(cname)
      if cat == "input" { score += 40 }
      elif cat == "compare_parse" { score += 32 }
      elif cat == "anti_analysis" { score += 34 }
      elif cat == "crypto" || cat == "compression" { score += 26 }
      elif cat == "memory_transform" { score += 12 }
      def cts = _decompile_text_score(cname)
      call_text_score += cts
      score += cts
      i += 1
   }
   if refs.len == 0 && calls.len == 0 && !_decompile_challenge_name(name) { score -= 80 }
   if ref_text_score == 0 && call_text_score == 0 && refs.len == 0 && branch_count > 10 && call_count == 0 { score -= 70 }
   score
}

fn _decompile_candidate_score_fast(dict bin, dict f, int max_bytes) int {
   def addr = int(f.get("value", f.get("addr", 0)))
   def name = _rename_addr(bin, addr, _rename_name(bin, _safe_name(f.get("name", ""), "sub_" + str.to_hex(addr, 0))))
   def src = f.get("source", "")
   mut score = 0
   if _decompile_challenge_name(name) { score += 140 }
   if _decompile_runtime_name(name) { score -= 220 }
   if src == "symbol" { score += 22 }
   if src == "prologue" { score += 8 }
   if src == "call_target" { score += 5 }
   if src == "entry" { score -= 90 }
   if src == "exec_section" { score -= 150 }
   score += _decompile_text_score(name)
   def rows = disassemble_function(bin, f, max_bytes)
   if rows.len == 0 { return score - 100 }
   score += min(rows.len, 48)
   def a = arch(bin)
   mut i = 0
   mut branch_count = 0
   mut call_count = 0
   while i < rows.len {
      def r = rows[i]
      def kind = dasm.instruction_kind(a, r[1])
      def ops = str.lower(r[1] + " " + r[2])
      if kind == "branch" {
         branch_count += 1
         score += 2
      } elif kind == "call" {
         call_count += 1
         score += 10
      } elif kind == "syscall" { score += 8 }
      score += _decompile_text_score(ops)
      if (str.find(ops, "rol") >= 0 || str.find(ops, "ror") >= 0 ||
         str.find(ops, "xor") >= 0 || str.find(ops, "crc") >= 0){
         score += 2
      }
      i += 1
   }
   if call_count == 0 && branch_count > 16 && !_decompile_challenge_name(name) { score -= 45 }
   score
}

fn _decompile_rank_insert(list xs, dict rec) list {
   mut out = []
   mut inserted = false
   mut i = 0
   while i < xs.len {
      if !inserted && int(rec.get("rank_score", 0)) > int(xs[i].get("rank_score", 0)) {
         out = out.append(rec)
         inserted = true
      }
      out = out.append(xs[i])
      i += 1
   }
   if !inserted { out = out.append(rec) }
   out
}

fn _decompile_rank_functions(dict bin, list fs, any opts=dict()) list {
   if !is_dict(opts) || !opts.get("rank", true) { return fs }
   def max_funcs = int(opts.get("max_functions", 24))
   def maxb = int(opts.get("rank_bytes", min(int(opts.get("max_bytes", 512)), 768)))
   def scan_limit = int(opts.get("rank_scan_functions", max(128, max_funcs * 16)))
   def refine_limit = int(opts.get("rank_refine_functions", max(16, max_funcs * 3)))
   mut cheap_ranked = []
   mut rest = []
   mut i = 0
   while i < fs.len {
      def f = fs[i]
      if i < scan_limit {
         def score = _decompile_candidate_score_fast(bin, f, maxb)
         cheap_ranked = _decompile_rank_insert(cheap_ranked, f.set("rank_score", score).set("rank_index", i))
      } else {
         rest = rest.append(f.set("rank_score", -100000).set("rank_index", i))
      }
      i += 1
   }
   mut ranked = []
   i = 0
   while i < cheap_ranked.len {
      def f = cheap_ranked[i]
      if i < refine_limit {
         def score = _decompile_candidate_score(bin, f, maxb)
         ranked = _decompile_rank_insert(ranked, f.set("rank_score", score).set("rank_index", int(f.get("rank_index", i))))
      } else {
         ranked = ranked.append(f)
      }
      i += 1
   }
   mut out = ranked
   i = 0
   while i < rest.len {
      out = out.append(rest[i])
      i += 1
   }
   out
}

fn _decompile_render_text_has_call_except(list funcs, str name, int skip_idx) bool {
   mut i = 0
   while i < funcs.len {
      if i != skip_idx && _clean_render_text_has_call(funcs[i].get("text", ""), name) { return true }
      i += 1
   }
   false
}

fn _decompile_unused_generated_helper_candidate(dict f) bool {
   def name = str.lower(str.strip(f.get("name", "")))
   def text = f.get("text", "")
   if name == "shift" {
      return contains(text, "decoded = ") && contains(text, ".map(fn(ch){") &&
      contains(text, "printf(") && contains(text, "decoded")
   }
   if name == "shift_int_to_char" {
      return contains(text, "out[0] = byte_at(value, 0)") &&
      contains(text, "out[3] = byte_at(value, 3)") &&
      contains(text, "return byte_at(value, 3)")
   }
   if name == "check_pw" {
      return contains(text, "return masked_prefix_eq(password, correct, mask)")
   }
   if name == "check_with_mod" {
      return contains(text, "return ascii_sum(slice(input, 0, length, 1)) % modulus == 0")
   }
   false
}

fn _decompile_prune_unused_generated_helpers(list funcs) list {
   mut out = []
   mut i = 0
   while i < funcs.len {
      def f = funcs[i]
      def name = f.get("name", "")
      if (_decompile_unused_generated_helper_candidate(f) &&
         !_decompile_render_text_has_call_except(funcs, name, i)){
         i += 1
         continue
      }
      out = out.append(f)
      i += 1
   }
   out
}

fn _decompile_join_function_text(list funcs) str {
   mut b = str.Builder(4096)
   mut i = 0
   while i < funcs.len {
      b = str.builder_append(b, funcs[i].get("text", "") + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn decompile_all(any source, any opts=dict()) dict {
   "Decompile recovered ELF functions into Nytrix pseudocode.
   Returns {ok, language:'ny', functions, text, analysis} ; this is the
   whole-binary entry point, intentionally bounded by `max_functions` and
   `max_bytes` so scripts can iterate safely on large binaries."
   mut bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   if opts.contains("renames") { bin = with_renames(bin, opts.get("renames", dict())) }
   if !bin.get("ok", false) { return {"ok": false, "language": "ny", "functions": [], "text": "", "analysis": bin} }
   def max_funcs = int(opts.get("max_functions", 24))
   def maxb = int(opts.get("max_bytes", 512))
   def fs = recover_functions(bin, int(opts.get("scan_bytes", 65536)))
   bin = bin.set("functions", fs)
   def ranked_fs = _decompile_rank_functions(bin, fs, opts.set("max_functions", max_funcs).set("max_bytes", maxb))
   mut out = []
   mut seen = dict()
   mut i = 0
   while i < ranked_fs.len && out.len < max_funcs {
      def f = ranked_fs[i]
      def addr = int(f.get("value", 0))
      if addr > 0 && !seen.get(to_str(addr), false) && !_decompile_runtime_name(f.get("name", "")) {
         seen = seen.set(to_str(addr), true)
         mut popts = {"max_bytes": maxb}
         if opts.get("clean", false) { popts = popts.set("clean", true) }
         if opts.contains("style") { popts = popts.set("style", opts.get("style", "")) }
         if opts.get("dataflow", false) { popts = popts.set("dataflow", true) }
         if opts.get("auto_rename_locals", false) { popts = popts.set("auto_rename_locals", true) }
         def ext = function_extent(bin, f, maxb)
         if opts.get("strict_structure", false) && !ext.get("clipped", false) { popts = popts.set("strict_structure", true) }
         def rows = disassemble_function(bin, f, maxb)
         mut lifted = []
         mut li = 0
         while li < rows.len {
            lifted = lifted.append(_lift_row(bin, rows[li]))
            li += 1
         }
         lifted = _attach_compare_context(bin, lifted)
         def sig = _signature_main_aliases(_function_signature_for(bin, f, lifted, addr, maxb),
            _safe_name(f.get("name", ""), "sub"))
         popts = popts.set("rows", rows).set("lifted", lifted)
         if sig.get("params", []).len > 0 { popts = popts.set("signature", sig) }
         mut graph = dict()
         mut factset = dict()
         mut loops = dict()
         mut model = dict()
         if opts.get("full_model", false) {
            model = function_model(bin, f, maxb)
            graph = model.get("cfg", dict())
            factset = model.get("facts", dict())
            loops = model.get("loops", dict())
         } else {
            graph = _cfg_from_rows(bin, rows)
            factset = _facts_from(bin, f, lifted, graph)
            loops = _cfg_loops_for_graph(graph, _cfg_dominators_for_graph(graph))
            def machines = _state_machines_from_rows(bin, lifted)
            model = {"language": "ny", "target": f,
               "name": _rename_addr(bin, addr, _rename_name(bin, _safe_name(f.get("name", ""), "sub_" + str.to_hex(addr, 0)))),
               "addr": addr, "rows": lifted, "cfg": graph, "loops": loops, "frame": _frame_model(lifted),
               "signature": sig, "facts": factset, "state_machines": machines,
               "type_recovery": _type_recovery_from_rows(bin, f, lifted, factset, sig, maxb)}
         }
         popts = popts.set("model", model).set("loops", loops).set("facts", factset)
         if ext.get("clipped", false) { popts = popts.set("truncated_render", true) }
         def text = ny_pseudocode(bin, f, popts)
         out = out.append({"name": _rename_addr(bin, addr, _rename_name(bin, _safe_name(f.get("name", ""), "sub_" + str.to_hex(addr, 0)))),
               "addr": addr, "size": int(ext.get("size", f.get("size", 0))), "end": int(ext.get("end", addr)),
               "inferred_extent": ext.get("inferred", false), "source": f.get("source", ""),
               "rank_score": int(f.get("rank_score", 0)),
               "language": "ny", "text": text, "structured": model})
      }
      i += 1
   }
   def final_out = opts.get("clean", false) ? _decompile_prune_unused_generated_helpers(out) : out
   def text_all = _decompile_join_function_text(final_out)
   {"ok": true, "language": "ny", "functions": final_out, "text": text_all, "analysis": bin,
      "truncated": fs.len > out.len, "recovered": fs.len}
}

fn flatten_calls(any source, any root=0, int depth=2, int max_functions=24, int max_bytes=384) dict {
   "Flatten direct calls from `root` like an angr-style exploration view.
   Returns ordered function nodes and edges without pretending indirect calls are
   resolved."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   mut queue = []
   if root == 0 { queue = queue.append(function_at(bin, entry(bin))) }
   elif is_dict(root) { queue = queue.append(root) }
   elif is_str(root) {
      def sec = section(bin, root)
      if sec.len > 0 {
         mut nodes = [{"name": root, "addr": sec.get("addr", 0), "depth": 0}]
         mut edges = []
         def calls = call_targets(bin, sec, min(max_bytes, int(sec.get("size", 0))))
         mut ci = 0
         while ci < calls.len {
            edges = edges.append({"from": root, "to": calls[ci].get("name", ""), "site": calls[ci].get("from", 0), "operand": calls[ci].get("operand", "")})
            ci += 1
         }
         return {"root": root, "nodes": nodes, "edges": edges}
      }
      def fs = bin.get("functions", [])
      mut fi = 0
      while fi < fs.len {
         if fs[fi].get("name", "") == root { queue = queue.append(fs[fi]) break }
         fi += 1
      }
   } else { queue = queue.append(function_at(bin, int(root))) }
   mut seen = dict()
   mut nodes = []
   mut edges = []
   mut qd = [0]
   mut qi = 0
   while qi < queue.len && nodes.len < max_functions {
      def f = queue[qi]
      def d = qd[qi]
      qi += 1
      if !is_dict(f) || f.len == 0 { continue }
      def start = int(f.get("value", 0))
      def key = to_str(start)
      if seen.get(key, false) { continue }
      seen = seen.set(key, true)
      def name = _safe_name(f.get("name", ""), "sub_" + str.to_hex(start, 0))
      nodes = nodes.append({"name": name, "addr": start, "depth": d})
      if d >= depth { continue }
      def calls = call_targets(bin, f, max_bytes)
      mut ci = 0
      while ci < calls.len {
         def c = calls[ci]
         edges = edges.append({"from": name, "to": c.get("name", ""), "site": c.get("from", 0), "operand": c.get("operand", "")})
         def ca = int(c.get("target", 0))
         if ca != 0 && !seen.get(to_str(ca), false) {
            queue = queue.append(function_at(bin, ca))
            qd = qd.append(d + 1)
         }
         ci += 1
      }
   }
   {"root": root, "nodes": nodes, "edges": edges}
}

fn _cg_name(dict bin, dict f) str {
   def addr = int(f.get("value", f.get("addr", 0)))
   _rename_addr(bin, addr, _rename_name(bin, _safe_name(f.get("name", ""), "sub_" + str.to_hex(addr, 0))))
}

fn callgraph(any source, int max_functions=64) dict {
   "Build a lightweight callgraph with normalized nodes, edges, roots, leaves, SCCs, and cycles."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def fs0 = bin.contains("functions") ? bin.get("functions", []) : recover_functions(bin)
   mut selected = []
   mut node_by_addr = dict()
   mut names = []
   mut nodes = []
   mut i = 0
   while i < fs0.len && selected.len < max_functions {
      def f = fs0[i]
      def addr = int(f.get("value", f.get("addr", 0)))
      if addr > 0 && !node_by_addr.contains(to_str(addr)) {
         def name = _cg_name(bin, f)
         selected = selected.append(f)
         node_by_addr = node_by_addr.set(to_str(addr), name)
         names = names.append(name)
         nodes = nodes.append({"name": name, "addr": addr, "size": int(f.get("size", 0)), "source": f.get("source", f.get("type", ""))})
      }
      i += 1
   }
   mut edges = []
   i = 0
   while i < selected.len {
      def f = selected[i]
      def from_addr = int(f.get("value", f.get("addr", 0)))
      def from_name = node_by_addr.get(to_str(from_addr), _cg_name(bin, f))
      def calls = call_targets(bin, f, 256)
      mut ci = 0
      while ci < calls.len {
         def c = calls[ci]
         def target = int(c.get("target", 0))
         def internal = node_by_addr.contains(to_str(target))
         def to_name = internal ? node_by_addr.get(to_str(target), "") : c.get("name", _name_for_addr(bin, target))
         edges = _cg_add_edge(edges, {"from": from_name, "from_addr": from_addr, "to": to_name, "to_addr": target,
               "site": int(c.get("from", 0)), "operand": c.get("operand", ""), "kind": c.get("kind", "call"), "internal": internal})
         ci += 1
      }
      i += 1
   }
   mut roots = []
   mut leaves = []
   i = 0
   while i < names.len {
      def n = names[i]
      if _cg_predecessors(edges, n, true).len == 0 { roots = roots.append(n) }
      if _cg_successors(edges, n, true).len == 0 { leaves = leaves.append(n) }
      i += 1
   }
   def sccs = _cg_components(names, edges)
   mut cycles = []
   i = 0
   while i < sccs.len {
      if sccs[i].get("recursive", false) { cycles = cycles.append(sccs[i].get("nodes", [])) }
      i += 1
   }
   {"nodes": nodes, "node_names": names, "edges": edges, "roots": roots, "leaves": leaves,
      "sccs": sccs, "cycles": cycles, "node_count": nodes.len, "edge_count": edges.len}
}

fn _call_query_name(dict bin, any query) str {
   if is_dict(query) {
      if query.contains("name") { return _cg_name(bin, query) }
      if query.contains("value") || query.contains("addr") { return _name_for_addr(bin, int(query.get("value", query.get("addr", 0)))) }
   }
   if is_int(query) { return _name_for_addr(bin, int(query)) }
   def s = to_str(query)
   def fs = bin.contains("functions") ? bin.get("functions", []) : recover_functions(bin)
   mut i = 0
   while i < fs.len {
      def f = fs[i]
      if f.get("name", "") == s || _cg_name(bin, f) == s { return _cg_name(bin, f) }
      i += 1
   }
   s
}

fn callers(any source, any query, int max_functions=128) list {
   "Return normalized callgraph edges that call `query`."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def name = _call_query_name(bin, query)
   def g = callgraph(bin, max_functions)
   def edges = g.get("edges", [])
   mut out = []
   mut i = 0
   while i < edges.len {
      if edges[i].get("to", "") == name || int(edges[i].get("to_addr", 0)) == int(is_dict(query) ? query.get("value", query.get("addr", 0)) : (is_int(query) ? query : 0)) {
         out = out.append(edges[i])
      }
      i += 1
   }
   out
}

fn callees(any source, any query, int max_functions=128) list {
   "Return normalized callgraph edges called by `query`."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def name = _call_query_name(bin, query)
   def g = callgraph(bin, max_functions)
   def edges = g.get("edges", [])
   mut out = []
   mut i = 0
   while i < edges.len {
      if edges[i].get("from", "") == name || int(edges[i].get("from_addr", 0)) == int(is_dict(query) ? query.get("value", query.get("addr", 0)) : (is_int(query) ? query : 0)) {
         out = out.append(edges[i])
      }
      i += 1
   }
   out
}

fn _triage_text(dict t) str {
   mut lines = []
   lines = lines.append("triage " + t.get("target", "") + " " + t.get("arch", "") +
      " functions=" + to_str(t.get("function_count", 0)) +
      " imports=" + to_str(t.get("import_count", 0)) +
      " findings=" + to_str(t.get("finding_count", 0)))
   def cats = t.get("import_categories", dict())
   def cks = cats.keys()
   mut i = 0
   while i < cks.len {
      lines = lines.append("imports." + cks[i] + "=" + to_str(cats.get(cks[i], 0)))
      i += 1
   }
   if t.get("crackme", dict()).get("success", []).len > 0 {
      lines = lines.append("crackme success targets=" + to_str(t.get("crackme", dict()).get("success", []).len))
   }
   def funcs = t.get("functions", [])
   i = 0
   while i < funcs.len {
      lines = lines.append("function " + funcs[i].get("name", "") + " rows=" + to_str(funcs[i].get("row_count", 0)) +
         " findings=" + to_str(funcs[i].get("finding_count", 0)) +
         " score=" + to_str(funcs[i].get("score", 0)))
      i += 1
   }
   str.join(lines, "\n")
}

fn _triage_insert_hotspot(list xs, dict rec, int limit) list {
   if limit <= 0 { return xs }
   mut out = []
   mut inserted = false
   mut i = 0
   while i < xs.len {
      if !inserted && int(rec.get("score", 0)) > int(xs[i].get("score", 0)) {
         out = out.append(rec)
         inserted = true
      }
      if out.len < limit { out = out.append(xs[i]) }
      i += 1
   }
   if !inserted && out.len < limit { out = out.append(rec) }
   out
}

fn _triage_hotspots(list summaries, int limit) list {
   mut out = []
   mut i = 0
   while i < summaries.len {
      def s = summaries[i]
      if int(s.get("score", 0)) > 0 {
         out = _triage_insert_hotspot(out, {"name": s.get("name", ""), "addr": int(s.get("addr", 0)),
               "score": int(s.get("score", 0)), "findings": int(s.get("finding_count", 0)),
               "inputs": int(s.get("input_surface_count", 0)), "branches": int(s.get("branch_count", 0)),
               "calls": int(s.get("call_count", 0)), "memory_shapes": int(s.get("memory_shape_count", 0))}, limit)
      }
      i += 1
   }
   out
}

fn triage(any source, any opts=dict()) dict {
   "Return a bounded whole-binary analyst triage record.
   This is the fast orientation layer: imports by category, callgraph shape,
   crackme targets, and semantic summaries for the first recovered functions."
   def bin0 = is_dict(source) && source.contains("header") ? source : load(to_str(source), opts)
   if !bin0.get("ok", false) { return {"ok": false, "kind": "triage", "reason": bin0.get("reason", "load_failed")} }
   def max_funcs = int(opts.get("max_functions", 8))
   def maxb = int(opts.get("max_bytes", 512))
   def scan = int(opts.get("scan_bytes", 65536))
   def fs = bin0.contains("functions") && bin0.get("functions", []).len > 0 ? bin0.get("functions", []) : recover_functions(bin0, scan)
   def bin = bin0.set("functions", fs)
   def ranked_fs = _decompile_rank_functions(bin, fs, opts.set("max_functions", max_funcs).set("max_bytes", maxb))
   def imps = _summary_import_records(bin)
   def cats = _summary_count_categories(imps)
   def cg = callgraph(bin, max(max_funcs, 1) * 4)
   def crack = crackme_targets(bin, {"range": opts.get("range", ".text"),
         "max_bytes": int(opts.get("target_bytes", opts.get("search_bytes", 65536)))})
   mut summaries = []
   mut findings = []
   mut i = 0
   while i < ranked_fs.len && summaries.len < max_funcs {
      def f = ranked_fs[i]
      def addr = int(f.get("value", f.get("addr", 0)))
      if addr > 0 {
         def s = semantic_summary(bin, f, {"max_bytes": maxb})
         summaries = summaries.append(s)
         def fs0 = s.get("findings", [])
         mut j = 0
         while j < fs0.len {
            findings = findings.append(fs0[j].set("function", s.get("name", "")).set("function_addr", addr))
            j += 1
         }
      }
      i += 1
   }
   if crack.get("success", []).len > 0 {
      findings = _summary_add_finding(findings, "high", "crackme_targets",
         "binary contains success/failure string targets", crack)
   }
   i = 0
   while i < imps.len {
      def cat = imps[i].get("category", "")
      if cat == "anti_analysis" || cat == "crypto" || cat == "compression" || cat == "input" {
         findings = _summary_add_finding(findings, cat == "anti_analysis" ? "medium" : "info",
            "import_" + cat, "notable import " + imps[i].get("name", ""), imps[i])
      }
      i += 1
   }
   def hotspots = _triage_hotspots(summaries, int(opts.get("hotspot_limit", 8)))
   mut out = {"ok": true, "kind": "triage", "language": "ny",
      "target": bin.get("path", bin.get("name", "<memory>")), "arch": arch(bin),
      "header": bin.get("header", dict()),
      "imports": imps, "import_count": imps.len, "import_categories": cats,
      "callgraph": cg, "crackme": crack,
      "hotspots": hotspots,
      "functions": summaries, "function_count": summaries.len,
      "recovered_function_count": fs.len,
      "findings": findings, "finding_count": findings.len}
   out.set("text", _triage_text(out))
}

fn plan(str p="", any opts=dict()) dict {
   "Return the decompiler plan for a target and current machine."
   {"target": p, "tools": tool_status(), "passes": [
         "load ELF header/sections/segments",
         "recover symbols/imports/strings",
         "disassemble executable ranges with Capstone",
         "summarize functions with semantic_summary and triage findings",
         "render compact Nytrix analyst pseudocode",
         "feed addresses and byte ranges into lib.os.symbolic for solving/emulation",
      ], "inspiration_note": "clone angr, ghidra, or vex into /tmp only when inspecting upstream implementations",
      "options": opts}
}

fn workspace(str p, any opts=dict()) dict {
   "Create a reverse-engineering workspace record."
   mut a = load(p, opts)
   if opts.contains("renames") { a = with_renames(a, opts.get("renames", dict())) }
   if opts.contains("notes") { a = with_notes(a, opts.get("notes", dict())) }
   def scan_range = opts.get("search_range", ".text")
   def scan_bytes = int(opts.get("search_bytes", 1024))
   mut ws = {"target": p, "analysis": a, "callgraph": callgraph(a), "globals": globals(a, scan_range, scan_bytes),
      "crackme": crackme_targets(a, {"range": scan_range, "max_bytes": scan_bytes, "with_slices": false}),
      "notes": notes(a), "plan": plan(p, opts)}
   if opts.contains("search") {
      ws = ws.set("search", search(a, opts.get("search", ""), {"limit": int(opts.get("search_limit", 32)),
               "range": scan_range, "max_bytes": scan_bytes}))
   }
   ws
}

fn report(any source, int string_limit=12) str {
   "Return a compact human-readable binary report."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source), {"string_limit": string_limit})
   if !bin.get("ok", false) { return "not an ELF: " + bin.get("reason", "unknown") + "\n" }
   def h = bin.get("header", dict())
   mut b = str.Builder(512)
   b = str.builder_append(b, bin.get("name", "<memory>") + "  " + h.get("machine", "?") + " " + to_str(h.get("bits", 0)) + "-bit " + h.get("type", "?") + "\n")
   b = str.builder_append(b, "entry: " + _hex(h.get("entry", 0)) + "\n")
   b = str.builder_append(b, "sections: " + to_str(bin.get("sections", []).len) + "  functions: " + to_str(bin.get("functions", []).len) + "  imports: " + to_str(bin.get("imports", []).len) + "  globals: " + to_str(globals(bin, ".text", 2048).len) + "  notes: " + to_str(notes(bin).len) + "\n")
   def im = bin.get("imports", [])
   mut i = 0
   while i < im.len && i < 10 {
      b = str.builder_append(b, "import " + im[i].get("display_name", im[i].get("name", "")) + "\n")
      i += 1
   }
   def ss = bin.get("strings", [])
   i = 0
   while i < ss.len && i < string_limit {
      b = str.builder_append(b, "str " + _hex(ss[i].get("offset", 0)) + " " + repr(ss[i].get("value", "")) + "\n")
      i += 1
   }
   def ns = notes(bin)
   i = 0
   while i < ns.len && i < 8 {
      b = str.builder_append(b, "note " + ns[i].get("key", "") + " " + repr(ns[i].get("text", "")) + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}
