fn _clean_normalize_modsum_terminal_success_fail(str text) str {
   if (str.find(text, "ascii_sum(slice(input,") < 0 ||
      str.find(text, "succeed(input)") < 0 ||
      str.find(text, "fail(input)") < 0){ return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def open = _clean_structured_if_open_parts(lines[i])
      if open.len > 0 && str.find(open.get("expr", ""), "ascii_sum(slice(input,") >= 0 {
         def close = _clean_matching_block_close(lines, i)
         if (close == i + 2 && close + 1 < lines.len &&
            _clean_line_indent(lines[i]) == _clean_line_indent(lines[close + 1]) &&
            str.strip(lines[i + 1]) == "succeed(input)" &&
            str.strip(lines[close + 1]) == "fail(input)"){
            def pad = _clean_line_indent(lines[i])
            b = str.builder_append(b, pad + "if " + _clean_negated_condition_expr(open.get("expr", "")) + "{\n")
            b = str.builder_append(b, pad + "  fail(input)\n")
            b = str.builder_append(b, pad + "}\n")
            b = str.builder_append(b, pad + "succeed(input)\n")
            changed = true
            i = close + 2
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_readable_negated_condition_expr(str expr0) str {
   def expr = _clean_strip_outer_parens(expr0)
   if str.startswith(expr, "!") { return _clean_strip_outer_parens(slice(expr, 1, expr.len, 1)) }
   def call = _clean_rendered_call_expr_parts(expr)
   if (call.len > 0 &&
      (call.get("name", "") == "startswith" || call.get("name", "") == "matches" ||
         call.get("name", "") == "between")){
      return "!" + expr
   }
   _clean_negated_condition_expr(expr)
}

