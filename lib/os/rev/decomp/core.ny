fn arch(any source) str {
   "Return the recovered binary architecture rather than the host architecture."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   bin.get("header", dict()).get("machine", "unknown")
}

fn _line_comment(list row) str {
   "  ; " + _hex(row[0]) + "  " + row[1] + (row[2].len > 0 ? (" " + row[2]) : "")
}

fn _hex_operand_to_addr(str ops) int {
   dasm.target_address(ops)
}

fn _row_target(str arch_name, list row) int {
   dasm.target_address(row, arch_name)
}

fn _rip_memory_target(list row) int {
   def ops = row[2]
   def p = str.find(ops, "rip")
   if p < 0 { return 0 }
   mut sign = 1
   mut i = p + 3
   while i < ops.len && str.ascii_is_space(load8(ops, i)) { i += 1 }
   if i < ops.len && load8(ops, i) == 45 { sign = -1 i += 1 }
   elif i < ops.len && load8(ops, i) == 43 { i += 1 }
   while i < ops.len && str.ascii_is_space(load8(ops, i)) { i += 1 }
   mut val = 0
   if i + 1 < ops.len && load8(ops, i) == 48 && (load8(ops, i + 1) == 120 || load8(ops, i + 1) == 88) {
      mut end = i + 2
      while end < ops.len && str.ascii_is_hex_digit(load8(ops, end)) { end += 1 }
      val = str.parse_int(slice(ops, i + 2, end, 1), 16)
   } else {
      mut end = i
      while end < ops.len && str.ascii_is_digit(load8(ops, end)) { end += 1 }
      if end > i { val = str.parse_int(slice(ops, i, end, 1), 10) }
   }
   int(row[0]) + int(row[3]) + sign * val
}

fn _import_name_for_addr(dict bin, int addr) str {
   def sites = bin.contains("import_sites") ? bin.get("import_sites", []) : import_sites(bin)
   mut i = 0
   while i < sites.len {
      if int(sites[i].get("addr", 0)) == addr { return _rename_name(bin, sites[i].get("name", "")) }
      i += 1
   }
   ""
}

fn _import_name_for_reloc(dict bin, int addr) str {
   def rels = bin.contains("relocations") ? bin.get("relocations", []) : relocations(bin)
   def r = _reloc_by_offset(rels, addr)
   r.len > 0 ? _rename_name(bin, _safe_name(_display_symbol(r.get("symbol", "")), "")) : ""
}

fn _call_name_for_row(dict bin, list row) str {
   def ops = row[2]
   if str.find(ops, "[") >= 0 {
      def mem = _rip_memory_target(row)
      def rn = mem != 0 ? _import_name_for_reloc(bin, mem) : ""
      if rn.len > 0 { return rn }
      return "call_indirect"
   }
   def caddr = _row_target(arch(bin), row)
   if caddr != 0 {
      def iname = _import_name_for_addr(bin, caddr)
      if iname.len > 0 { return iname }
      return _name_for_addr(bin, caddr)
   }
   if _operand_kind(ops) == "imm" { return "sub_" + str.to_hex(_imm_value(ops), 0) }
   _safe_name(_ny_operand(ops), "call_indirect")
}

fn _string_for_vaddr(dict bin, int addr) dict {
   def off = _vaddr_to_offset(bin, addr)
   if off < 0 { return dict() }
   def ss = bin.contains("strings") ? bin.get("strings", []) : strings(bin)
   mut i = 0
   while i < ss.len {
      def s = ss[i]
      def so = int(s.get("offset", -1))
      def sl = int(s.get("len", 0))
      if off >= so && off < so + sl {
         return s.set("addr", addr - (off - so)).set("delta", off - so).set("kind", "string")
      }
      i += 1
   }
   def data = bin.get("data", "")
   if off >= 0 && off < data.len {
      def raw = _cstring(data, off, 256)
      if raw.len > 0 {
         mut printable = true
         mut pi = 0
         while pi < raw.len {
            def c = load8(raw, pi)
            if c < 32 || c > 126 { printable = false }
            pi += 1
         }
         if printable {
            return {"offset": off, "addr": addr, "delta": 0, "kind": "string",
               "len": raw.len, "value": raw}
         }
      }
   }
   dict()
}

fn _data_ref_for_row(dict bin, list row) dict {
   def target = _rip_memory_target(row)
   if target == 0 { return dict() }
   _data_ref_for_addr(bin, target, false)
}

fn _best_ref_for_row(dict bin, list row) dict {
   def rip = _data_ref_for_row(bin, row)
   if rip.len > 0 { return rip }
   def imm = _immediate_data_refs_for_row(bin, row)
   imm.len > 0 ? imm[0] : dict()
}

fn _data_ref_for_addr(dict bin, int target, bool require_file=false) dict {
   if target == 0 { return dict() }
   if require_file && _vaddr_to_offset(bin, target) < 0 { return dict() }
   def rn = _import_name_for_reloc(bin, target)
   if rn.len > 0 {
      return {"kind": "import", "target": target, "name": rn, "value": rn}
   }
   def sec = _any_section_for_addr(bin, target)
   if sec.len > 0 {
      def sname = sec.get("name", "")
      if (sname == ".dynsym" || sname == ".dynstr" || sname == ".interp" ||
         str.startswith(sname, ".gnu") || str.startswith(sname, ".rel") ||
         str.startswith(sname, ".note")){ return dict() }
   }
   if sec.len == 0 && target < 0x10000 { return dict() }
   if sec.len > 0 && (int(sec.get("flags", 0)) & (SHF_ALLOC | SHF_EXECINSTR)) == 0 { return dict() }
   def st = _string_for_vaddr(bin, target)
   if st.len > 0 {
      def sn = _rename_addr(bin, int(st.get("addr", target)), "str_" + str.to_hex(int(st.get("addr", target)), 0))
      return {"kind": "string", "target": target, "name": sn, "value": st.get("value", ""), "string": st}
   }
   if sec.len > 0 && (int(sec.get("flags", 0)) & SHF_EXECINSTR) != 0 { return dict() }
   if require_file && sec.len == 0 { return dict() }
   {"kind": "data", "target": target, "name": _rename_addr(bin, target, "data_" + str.to_hex(target, 0)), "value": ""}
}

fn _immediate_data_refs_for_row(dict bin, list row) list {
   mut out = []
   def ops = _operand_split(row[2])
   mut i = 0
   while i < ops.len {
      def op = _clean_operand(ops[i])
      if _operand_looks_immediate_literal(op) {
         def target = _imm_value(op)
         def kind = dasm.instruction_kind(arch(bin), row[1])
         if (kind == "call" || kind == "branch") && _addr_in_executable(bin, target) {
            i += 1
            continue
         }
         def ref = _data_ref_for_addr(bin, target, true)
         if ref.len > 0 { out = out.append(ref) }
      }
      i += 1
   }
   out
}

fn _operand_looks_immediate_literal(str op0) bool {
   mut op = str.strip(op0)
   if op.len == 0 { return false }
   if str.find(op, "[") >= 0 || str.find(op, "(") >= 0 { return false }
   if str.startswith(op, "#") || str.startswith(op, "$") { op = str.strip(slice(op, 1, op.len, 1)) }
   if str.startswith(op, "+") || str.startswith(op, "-") { op = str.strip(slice(op, 1, op.len, 1)) }
   if op.len == 0 { return false }
   if str.startswith(op, "0x") || str.startswith(op, "0X") { return op.len > 2 }
   str.ascii_is_digit(load8(op, 0))
}

fn _data_refs_from_rows(dict bin, list rows) list {
   mut out = []
   mut seen = dict()
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if str.find(r[2], "rip") >= 0 {
         def ref = _data_ref_for_row(bin, r)
         if ref.len > 0 {
            def key = to_str(r[0]) + ":" + to_str(ref.get("target", 0))
            if !seen.get(key, false) {
               seen = seen.set(key, true)
               out = out.append(ref.set("from", r[0]).set("mnemonic", r[1]).set("operand", r[2]))
            }
         }
      }
      def imm_refs = _immediate_data_refs_for_row(bin, r)
      mut k = 0
      while k < imm_refs.len {
         def ref = imm_refs[k]
         def key = to_str(r[0]) + ":" + to_str(ref.get("target", 0))
         if !seen.get(key, false) {
            seen = seen.set(key, true)
            out = out.append(ref.set("from", r[0]).set("mnemonic", r[1]).set("operand", r[2]))
         }
         k += 1
      }
      i += 1
   }
   out
}

fn data_refs(any source, any target=".text", int max_bytes=2048) list {
   "Return data/import/string references from a decompiled range."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   _data_refs_from_rows(bin, disassemble(bin, target, max_bytes))
}

fn _ref_targets(any targets) list {
   if targets == 0 { return [] }
   is_list(targets) ? targets : [targets]
}

fn _jump_table_refs(dict bin, any target, int max_bytes) list {
   def tables = jump_tables(bin, target, max_bytes)
   mut out = []
   mut i = 0
   while i < tables.len {
      def jt = tables[i]
      def base = int(jt.get("base", 0))
      out = out.append({
            "kind": "jump_table",
            "target": base,
            "name": "jump_table_" + str.to_hex(base, 0),
            "value": "cases=" + to_str(int(jt.get("count", 0))),
            "from": int(jt.get("from", 0)),
            "mnemonic": "jmp",
            "operand": jt.get("operand", ""),
            "entries": jt.get("entries", []),
            "count": int(jt.get("count", 0)),
            "index_reg": jt.get("index_reg", ""),
         })
      i += 1
   }
   out
}

fn _call_arg_refs(dict bin, any target, int max_bytes) list {
   def rows = lift(bin, target, max_bytes)
   mut out = []
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "call" {
         def args = _call_arg_model(rows, i)
         mut ai = 0
         while ai < args.len {
            def a = args[ai]
            def rk = a.get("ref_kind", "")
            if rk == "string" || rk == "data" || rk == "import" {
               out = out.append({
                     "kind": rk,
                     "target": int(a.get("ref_target", 0)),
                     "name": a.get("ref_name", ""),
                     "value": rk == "string" ? a.get("string", a.get("ref", dict()).get("value", "")) : a.get("ref_name", ""),
                     "from": int(r.get("addr", 0)),
                     "mnemonic": "call",
                     "operand": r.get("operands", ""),
                     "site_kind": "call_arg",
                     "call": r.get("target_name", ""),
                     "arg": a,
                  })
            }
            ai += 1
         }
      }
      i += 1
   }
   out
}

fn xrefs(any source, any targets=0, int max_bytes=4096) list {
   "Return flat recovered import/data/string/jump-table/call-argument xrefs from executable ranges."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def ranges = targets == 0 ? executable_sections(bin) : _ref_targets(targets)
   mut out = []
   mut seen = dict()
   mut i = 0
   while i < ranges.len {
      def rtarget = ranges[i]
      def rname = is_dict(rtarget) ? rtarget.get("name", "") : to_str(rtarget)
      def cap = is_dict(rtarget) ? min(max_bytes, max(1, int(rtarget.get("size", max_bytes)))) : max_bytes
      mut refs = data_refs(bin, rtarget, cap)
      mut j = 0
      while j < refs.len {
         def r = refs[j]
         def key = to_str(r.get("from", 0)) + ":" + to_str(r.get("target", 0)) + ":" + rname
         if !seen.get(key, false) {
            seen = seen.set(key, true)
            out = out.append(r.set("range", rname))
         }
         j += 1
      }
      refs = _jump_table_refs(bin, rtarget, cap)
      j = 0
      while j < refs.len {
         def r = refs[j]
         def key = to_str(r.get("from", 0)) + ":" + to_str(r.get("target", 0)) + ":jump_table:" + rname
         if !seen.get(key, false) {
            seen = seen.set(key, true)
            out = out.append(r.set("range", rname))
         }
         j += 1
      }
      refs = _call_arg_refs(bin, rtarget, cap)
      j = 0
      while j < refs.len {
         def r = refs[j]
         def key = to_str(r.get("from", 0)) + ":" + to_str(r.get("target", 0)) + ":call_arg:" + rname + ":" + r.get("arg", dict()).get("reg", "")
         if !seen.get(key, false) {
            seen = seen.set(key, true)
            out = out.append(r.set("range", rname))
         }
         j += 1
      }
      i += 1
   }
   out
}

fn _xref_query_matches(dict r, any query) bool {
   if is_dict(query) {
      if query.contains("target") { return int(r.get("target", 0)) == int(query.get("target", 0)) }
      if query.contains("name") { return r.get("name", "") == query.get("name", "") }
      return false
   }
   if is_int(query) { return int(r.get("target", 0)) == int(query) }
   def q = to_str(query)
   if str.startswith(q, "0x") || str.startswith(q, "0X") {
      return int(r.get("target", 0)) == str.parse_int(slice(q, 2, q.len, 1), 16)
   }
   r.get("name", "") == q || r.get("value", "") == q || r.get("kind", "") == q
}

fn xrefs_to(any source, any query, any targets=0, int max_bytes=4096) list {
   "Return xrefs matching an address, name, kind, string value, or global record."
   def refs = xrefs(source, targets, max_bytes)
   mut out = []
   mut i = 0
   while i < refs.len {
      if _xref_query_matches(refs[i], query) { out = out.append(refs[i]) }
      i += 1
   }
   out
}

fn globals(any source, any targets=0, int max_bytes=4096) list {
   "Return grouped global/import/string records with xref sites."
   def refs = xrefs(source, targets, max_bytes)
   mut out = []
   mut index = dict()
   mut i = 0
   while i < refs.len {
      def r = refs[i]
      def key = to_str(r.get("target", 0))
      def pos = int(index.get(key, -1))
      def site = {
         "from": r.get("from", 0),
         "range": r.get("range", ""),
         "mnemonic": r.get("mnemonic", ""),
         "operand": r.get("operand", ""),
         "count": r.get("count", 0),
         "index_reg": r.get("index_reg", ""),
      }
      if pos < 0 {
         index = index.set(key, out.len)
         out = out.append({
               "kind": r.get("kind", ""),
               "target": r.get("target", 0),
               "name": r.get("name", ""),
               "value": r.get("value", ""),
               "xrefs": [site],
            })
      } else {
         def g = out[pos]
         out = out.set(pos, g.set("xrefs", g.get("xrefs", []).append(site)))
      }
      i += 1
   }
   out
}

fn _search_hit(str kind, str name, any value, dict item) dict {
   {"kind": kind, "name": name, "value": value, "item": item}
}

fn _search_text_match(str hay, str needle) bool {
   needle.len == 0 ? false : str.find(str.lower(hay), str.lower(needle)) >= 0
}

fn _search_addr_match(any q, any addr) bool {
   if is_int(q) { return int(addr) == int(q) }
   def s = to_str(q)
   if str.startswith(s, "0x") || str.startswith(s, "0X") { return int(addr) == str.parse_int(slice(s, 2, s.len, 1), 16) }
   false
}

fn _call_search_match(dict call, any query) bool {
   def q = to_str(query)
   if (_search_text_match(call.get("name", ""), q) || _search_text_match(call.get("effect", ""), q) ||
      _search_addr_match(query, call.get("addr", 0)) || _search_addr_match(query, call.get("target", 0))){ return true }
   def args = call.get("args", [])
   mut i = 0
   while i < args.len {
      def a = args[i]
      if (_search_text_match(a.get("name", ""), q) || _search_text_match(a.get("reg", ""), q) ||
         _search_text_match(a.get("value", ""), q) || _search_text_match(a.get("value_kind", ""), q) ||
         _search_text_match(a.get("ref_name", ""), q) || _search_text_match(a.get("string", ""), q) ||
         _search_addr_match(query, a.get("value_int", -1)) || _search_addr_match(query, a.get("ref_target", 0))){ return true }
      i += 1
   }
   false
}

fn search(any source, any query, any opts=dict()) list {
   "Search recovered analysis views: functions, imports, strings, globals, xrefs, calls, variables, and notes."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def q = to_str(query)
   def max_results = int(opts.get("limit", 64))
   def range = opts.get("range", ".text")
   def max_bytes = int(opts.get("max_bytes", 4096))
   mut out = []
   def fs = bin.get("functions", [])
   mut i = 0
   while i < fs.len && out.len < max_results {
      def f = fs[i]
      if _search_text_match(f.get("name", ""), q) || _search_addr_match(query, f.get("value", 0)) {
         out = out.append(_search_hit("function", _rename_addr(bin, f.get("value", 0), f.get("name", "")), f.get("value", 0), f))
      }
      i += 1
   }
   def im = bin.get("imports", [])
   i = 0
   while i < im.len && out.len < max_results {
      def m = im[i]
      if _search_text_match(m.get("name", ""), q) || _search_text_match(m.get("display_name", ""), q) {
         def shown = m.get("display_name", m.get("name", ""))
         out = out.append(_search_hit("import", _rename_name(bin, shown), m.get("name", ""), m))
      }
      i += 1
   }
   def ss = bin.get("strings", [])
   i = 0
   while i < ss.len && out.len < max_results {
      def s = ss[i]
      if _search_text_match(s.get("value", ""), q) || _search_addr_match(query, s.get("addr", 0)) {
         out = out.append(_search_hit("string", "str_" + str.to_hex(s.get("addr", s.get("offset", 0)), 0), s.get("value", ""), s))
      }
      i += 1
   }
   def gs = globals(bin, range, max_bytes)
   i = 0
   while i < gs.len && out.len < max_results {
      def g = gs[i]
      if _search_text_match(g.get("name", ""), q) || _search_text_match(g.get("value", ""), q) || _search_addr_match(query, g.get("target", 0)) {
         out = out.append(_search_hit("global", g.get("name", ""), g.get("target", 0), g))
      }
      i += 1
   }
   def xr = xrefs_to(bin, query, range, max_bytes)
   i = 0
   while i < xr.len && out.len < max_results {
      def x = xr[i]
      out = out.append(_search_hit("xref", x.get("name", ""), x.get("from", 0), x))
      i += 1
   }
   def vs = variables(bin, range, max_bytes)
   i = 0
   while i < vs.len && out.len < max_results {
      def v = vs[i]
      if _search_text_match(v.get("name", ""), q) || _search_text_match(v.get("kind", ""), q) || _search_text_match(v.get("storage", ""), q) {
         out = out.append(_search_hit("variable", v.get("name", ""), v.get("storage", ""), v))
      }
      i += 1
   }
   def fm = function_model(bin, range, max_bytes)
   def cs = fm.get("calls", [])
   i = 0
   while i < cs.len && out.len < max_results {
      def c = cs[i]
      if _call_search_match(c, query) {
         out = out.append(_search_hit("call", c.get("name", ""), c.get("addr", 0), c))
      }
      i += 1
   }
   def ns = notes(bin)
   i = 0
   while i < ns.len && out.len < max_results {
      def n = ns[i]
      if _search_text_match(n.get("text", ""), q) || _search_text_match(n.get("key", ""), q) || _search_addr_match(query, n.get("addr", 0)) {
         out = out.append(_search_hit("note", n.get("key", ""), n.get("text", ""), n))
      }
      i += 1
   }
   out
}

fn _crackme_word_score(str value, list words) list {
   def v = str.lower(str.strip(value))
   mut score = 0
   mut reasons = []
   mut i = 0
   while i < words.len {
      def w = words[i]
      if w.len > 0 && str.find(v, w) >= 0 {
         score += 1
         reasons = reasons.append(w)
      }
      i += 1
   }
   [score, reasons]
}

fn _crackme_ascii_shift(str value, int delta) str {
   mut out = malloc(value.len + 1)
   if !out { return value }
   init_str(out, value.len)
   mut i = 0
   while i < value.len {
      def c = load8(value, i)
      def v = c + delta
      store8(out, (v >= 32 && v <= 126) ? v : c, i)
      i += 1
   }
   store8(out, 0, value.len)
   out
}

fn _crackme_score_variants(str value, list words) list {
   mut best = _crackme_word_score(value, words)
   mut best_delta = 0
   mut delta = -8
   while delta <= 8 {
      if delta != 0 {
         def shifted = _crackme_ascii_shift(value, delta)
         def cur = _crackme_word_score(shifted, words)
         if int(cur[0]) > int(best[0]) {
            best = cur
            best_delta = delta
         }
      }
      delta += 1
   }
   if best_delta != 0 && int(best[0]) > 0 {
      mut reasons = []
      mut i = 0
      while i < best[1].len {
         reasons = reasons.append("caesar" + to_str(best_delta) + ":" + best[1][i])
         i += 1
      }
      return [best[0], reasons]
   }
   best
}

fn _crackme_classify_string(str value) dict {
   def success = _crackme_score_variants(value, ["success", "correct", "granted", "congrat", "welcome", "unlocked", "flag", "winner", "valid password", "password ok", "accepted", "good job", "access"])
   def failure = _crackme_score_variants(value, ["wrong", "incorrect", "invalid", "denied", "failed", "failure", "not correct", "try again", "bad password", "nope", "error"])
   def sscore = int(success[0])
   def fscore = int(failure[0])
   if sscore > fscore && sscore > 0 { return {"class": "success", "score": sscore, "reasons": success[1]} }
   if fscore > 0 { return {"class": "failure", "score": fscore, "reasons": failure[1]} }
   {"class": "neutral", "score": 0, "reasons": []}
}

fn _crackme_function_for_site(dict bin, int addr) dict {
   def fs = bin.contains("functions") ? bin.get("functions", []) : recover_functions(bin)
   def f = function_at(bin.set("functions", fs), addr)
   if f.len == 0 { return dict() }
   {"name": _rename_addr(bin, int(f.get("value", 0)), _rename_name(bin, _safe_name(_display_symbol(f.get("name", "")), "sub_" + str.to_hex(int(f.get("value", 0)), 0)))),
      "addr": int(f.get("value", 0)), "size": int(f.get("size", 0)), "source": f.get("source", "")}
}

fn _crackme_branch_for_site(dict bin, dict site, int max_bytes, bool include_slice=true) dict {
   def site_addr = int(site.get("from", 0))
   if site_addr <= 0 { return dict() }
   def fnrec = site.get("function", dict())
   def target = fnrec.len > 0 ? fnrec : site.get("range", ".text")
   mut rows = lift(bin, target, max_bytes)
   rows = _attach_compare_context(bin, rows)
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" {
         mut reaches = int(r.get("target", 0)) == site_addr
         def sw = _row_switch_targets(r)
         mut si = 0
         while si < sw.len {
            if int(sw[si]) == site_addr { reaches = true }
            si += 1
         }
         if reaches {
            def cond = r.get("condition", "")
            def baddr = int(r.get("addr", 0))
            mut out = {"addr": baddr, "target": site_addr, "condition": cond,
               "expr": cond.len > 0 && cond != "always" ? _branch_condition_expr(rows, i, cond) : cond,
               "mnemonic": r.get("mnemonic", ""), "operand": r.get("operands", "")}
            if include_slice { out = out.set("slice", backward_slice(bin, target, {"addr": baddr}, {"max_bytes": max_bytes})) }
            return out
         }
      }
      i += 1
   }
   dict()
}

fn _crackme_sites_for_string(dict bin, list refs, int addr, int max_bytes, bool include_slice=true) list {
   mut out = []
   mut i = 0
   while i < refs.len {
      def r = refs[i]
      if int(r.get("target", 0)) == addr {
         mut site = {"from": int(r.get("from", 0)), "range": r.get("range", ""),
            "mnemonic": r.get("mnemonic", ""), "operand": r.get("operand", ""),
            "function": _crackme_function_for_site(bin, int(r.get("from", 0)))}
         def br = _crackme_branch_for_site(bin, site, max_bytes, include_slice)
         if br.len > 0 { site = site.set("branch", br) }
         out = out.append(site)
      }
      i += 1
   }
   out
}

fn crackme_targets(any source, any opts=dict()) dict {
   "Find likely crackme success/failure targets from strings and xrefs.
   Returns classified string records plus `find` and `avoid` address lists that
   can be passed into `symbolic_solve(..., {find:{kind:'addr', addr: ...}})`."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source), opts)
   if !bin.get("ok", false) { return {"ok": false, "kind": "crackme_targets", "reason": bin.get("reason", "load_failed")} }
   def range = opts.get("range", ".text")
   def max_bytes = int(opts.get("max_bytes", 65536))
   def include_slice = bool(opts.get("with_slices", true))
   def refs = xrefs(bin, range, max_bytes)
   def ss = bin.contains("strings") ? bin.get("strings", []) : strings(bin, int(opts.get("min_string", 4)), int(opts.get("string_limit", 512)))
   mut success = []
   mut failure = []
   mut neutral = []
   mut find = []
   mut avoid = []
   mut i = 0
   while i < ss.len {
      def s = ss[i]
      mut addr = int(s.get("addr", 0))
      if addr == 0 { addr = _offset_to_vaddr(bin, int(s.get("offset", 0))) }
      if addr == 0 { addr = int(s.get("offset", 0)) }
      def cls = _crackme_classify_string(s.get("value", ""))
      def sites = _crackme_sites_for_string(bin, refs, addr, max_bytes, include_slice)
      mut rec = {"addr": addr, "value": s.get("value", ""), "class": cls.get("class", "neutral"),
         "score": int(cls.get("score", 0)), "reasons": cls.get("reasons", []), "xrefs": sites}
      if sites.len > 0 { rec = rec.set("site", sites[0]).set("from", int(sites[0].get("from", 0))) }
      if rec.get("class", "") == "success" {
         success = success.append(rec)
         if sites.len > 0 { find = _append_unique(find, int(sites[0].get("from", 0))) }
      } elif rec.get("class", "") == "failure" {
         failure = failure.append(rec)
         if sites.len > 0 { avoid = _append_unique(avoid, int(sites[0].get("from", 0))) }
      } else { neutral = neutral.append(rec) }
      i += 1
   }
   {"ok": true, "kind": "crackme_targets", "arch": arch(bin), "range": range,
      "success": success, "failure": failure, "neutral": neutral,
      "find": find, "avoid": avoid, "xrefs": refs,
      "find_predicate": {"kind": "addr", "addr": find},
      "avoid_predicate": {"kind": "addr", "addr": avoid}}
}

fn _crackme_first_site(list xs) dict {
   mut i = 0
   while i < xs.len {
      def r = xs[i]
      def sites = r.get("xrefs", [])
      if sites.len > 0 { return {"target": r, "site": sites[0]} }
      i += 1
   }
   xs.len > 0 ? {"target": xs[0], "site": dict()} : dict()
}

fn _crackme_model_text(dict solution) str {
   def sy = solution.get("symbolics", dict())
   def keys = sy.keys()
   if keys.len == 0 { return "" }
   mut parts = []
   mut i = 0
   while i < keys.len {
      parts = parts.append(keys[i] + "=" + to_str(sy.get(keys[i], "")))
      i += 1
   }
   _join_words(parts)
}

fn _crackme_solution_explain(dict targets, dict run) dict {
   def picked = _crackme_first_site(targets.get("success", []))
   def target = picked.get("target", dict())
   def site = picked.get("site", dict())
   def branch = site.get("branch", dict())
   def solution = run.get("solution", run.get("model", dict()))
   mut lines = []
   if target.len > 0 {
      lines = lines.append("success string " + repr(target.get("value", "")) + " at " + _hex(int(target.get("addr", 0))))
   }
   if site.len > 0 {
      lines = lines.append("xref at " + _hex(int(site.get("from", 0))) + " in " + site.get("function", dict()).get("name", site.get("range", "")))
   }
   if branch.len > 0 {
      lines = lines.append("branch " + _hex(int(branch.get("addr", 0))) + " -> " + _hex(int(branch.get("target", 0))) + " when " + branch.get("expr", branch.get("condition", "")))
   }
   def model_text = _crackme_model_text(solution)
   if model_text.len > 0 { lines = lines.append("model " + model_text) }
   {"success": target, "site": site, "branch": branch, "model": solution,
      "model_text": model_text, "lines": lines, "text": str.join(lines, "\n")}
}

fn _crackme_has_input_opts(dict opts) bool {
   def keys = ["stdin", "symbolic_stdin", "argv", "symbolic_argv", "regs", "symbolic_regs",
      "mem", "symbolic_mem", "assume", "constraints"]
   mut i = 0
   while i < keys.len {
      if opts.contains(keys[i]) { return true }
      i += 1
   }
   false
}

fn _crackme_import_names(dict bin) list {
   mut out = []
   def imps = bin.contains("imports") ? bin.get("imports", []) : imports(bin)
   mut i = 0
   while i < imps.len {
      def it = imps[i]
      def n = _display_symbol(is_dict(it) ? it.get("name", it.get("symbol", "")) : to_str(it))
      if n.len > 0 { out = _append_unique(out, n) }
      i += 1
   }
   def sites = bin.contains("import_sites") ? bin.get("import_sites", []) : import_sites(bin)
   i = 0
   while i < sites.len {
      def s = sites[i]
      def n = _display_symbol(s.get("display_name", s.get("name", s.get("symbol", ""))))
      if n.len > 0 { out = _append_unique(out, n) }
      i += 1
   }
   out
}

fn _crackme_is_input_import(str name) bool {
   def n = str.lower(name)
   n == "read" || n == "_read" || n == "readv" || n == "_readv" ||
   n == "gets" || n == "fgets" ||
   n == "getline" || n == "scanf" || n == "__isoc99_scanf" || n == "__isoc23_scanf" ||
   n == "fscanf" || n == "sscanf" || n == "getchar" || n == "getc" ||
   n == "fgetc"
}

fn _crackme_uses_input_import(dict bin) bool {
   def names = _crackme_import_names(bin)
   mut i = 0
   while i < names.len {
      if _crackme_is_input_import(names[i]) { return true }
      i += 1
   }
   false
}

fn _crackme_first_arg_reg(dict bin, any target, int max_bytes) str {
   def rows = lift(bin, target, max_bytes)
   def prof = _abi_profile(_rows_family(rows))
   def args = prof.get("args", [])
   args.len > 0 ? args[0] : ""
}

fn _row_mentions_reg(dict row, str reg) bool {
   def aliases = _arg_aliases(reg)
   mut fields = [row.get("dst", ""), row.get("src", "")]
   def args = row.get("args", [])
   mut i = 0
   while i < args.len {
      fields = fields.append(to_str(args[i]))
      i += 1
   }
   i = 0
   while i < fields.len {
      def v = to_str(fields[i])
      mut j = 0
      while j < aliases.len {
         if v == aliases[j] { return true }
         j += 1
      }
      i += 1
   }
   false
}

fn _crackme_arg_regs_used(dict bin, any target, int max_bytes) list {
   def rows = lift(bin, target, max_bytes)
   def args = _abi_profile(_rows_family(rows)).get("args", [])
   mut out = []
   mut i = 0
   while i < args.len {
      def reg = args[i]
      mut seen = false
      mut j = 0
      while j < rows.len && !seen {
         if _row_mentions_reg(rows[j], reg) { seen = true }
         j += 1
      }
      if seen { out = out.append(reg) }
      i += 1
   }
   out
}

fn _crackme_auto_arg_regs(dict bin, any target, dict opts) list {
   def maxb = int(opts.get("max_bytes", opts.get("model_bytes", 1024)))
   mut regs = _crackme_arg_regs_used(bin, target, maxb)
   if regs.len == 0 {
      def first = _crackme_first_arg_reg(bin, target, maxb)
      if first.len > 0 { regs = [first] }
   }
   regs
}

fn _crackme_auto_input(dict bin, any target, dict opts) list {
   if !opts.get("auto_input", true) { return [opts, {"kind": "disabled"}] }
   if _crackme_has_input_opts(opts) { return [opts, {"kind": "explicit"}] }
   def n = int(opts.get("input_len", opts.get("stdin_len", 32)))
   def lo = int(opts.get("input_lo", 32))
   def hi = int(opts.get("input_hi", 126))
   if _crackme_uses_input_import(bin) {
      def spec = {"name": opts.get("input_name", "stdin"), "n": n, "lo": lo, "hi": hi}
      return [opts.set("symbolic_stdin", spec),
         {"kind": "stdin", "name": spec.get("name", "stdin"), "n": n, "lo": lo, "hi": hi}]
   }
   def regs = _crackme_auto_arg_regs(bin, target, opts)
   if regs.len == 0 { return [opts, {"kind": "none", "reason": "no_abi_argument"}] }
   mut spec = dict()
   mut plans = []
   mut i = 0
   while i < regs.len {
      def reg = regs[i]
      def name = opts.contains("input_name") ? opts.get("input_name", "arg") + "_" + reg : "arg" + to_str(i)
      def rec = {"name": name, "bits": int(opts.get("input_bits", 0)),
         "lo": int(opts.get("input_lo", 0)), "hi": int(opts.get("input_hi", 255))}
      spec = spec.set(reg, rec)
      plans = plans.append({"reg": reg, "name": name, "lo": int(rec.get("lo", 0)), "hi": int(rec.get("hi", 255))})
      i += 1
   }
   mut plan = {"kind": regs.len == 1 ? "arg_reg" : "arg_regs", "regs": regs, "items": plans,
      "lo": int(opts.get("input_lo", 0)), "hi": int(opts.get("input_hi", 255))}
   if regs.len == 1 { plan = plan.set("reg", regs[0]) }
   [opts.set("symbolic_regs", spec), plan]
}

fn crackme_solve(any source, any target=0, any opts=dict()) dict {
   "Discover likely crackme success/failure sites and run lifted symbolic solve.
   This is the high-level path: strings/xrefs -> find/avoid -> sliced lifted
   solve. The returned record keeps the target candidates beside the solver
   result so scripts can inspect or override the inferred path."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source), opts)
   if !bin.get("ok", false) { return {"ok": false, "kind": "crackme_solve", "reason": bin.get("reason", "load_failed")} }
   def t = crackme_targets(bin, {"range": opts.get("range", target == 0 ? ".text" : target),
         "max_bytes": int(opts.get("target_bytes", opts.get("max_bytes", 65536)))})
   if t.get("find", []).len == 0 {
      return {"ok": false, "kind": "crackme_solve", "reason": "no_success_target", "targets": t}
   }
   mut o = opts
   if !o.contains("engine") && !o.contains("backend") { o = o.set("engine", "lifted") }
   if !o.contains("steps") { o = o.set("steps", 128) }
   if !o.contains("find") { o = o.set("find", t.get("find_predicate", dict())) }
   if !o.contains("avoid") && t.get("avoid", []).len > 0 { o = o.set("avoid", t.get("avoid_predicate", dict())) }
   def auto = _crackme_auto_input(bin, target, o)
   o = auto[0]
   def input_plan = auto[1]
   def run = symbolic_solve(bin, target, o)
   def explain = _crackme_solution_explain(t, run)
   run.set("kind", "crackme_solve").set("ok", run.get("sat", false)).set("targets", t)
   .set("find", t.get("find", [])).set("avoid", t.get("avoid", []))
   .set("input_plan", input_plan).set("explain", explain).set("text", explain.get("text", ""))
}

fn crackme_solve_all(any source, any target=0, any opts=dict()) dict {
   "Crackme-oriented multi-model solve: infer success/failure xrefs, add
   find/avoid predicates, auto-plan symbolic input when needed, and enumerate
   found models with `symbolic_solve_all(...)`."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source), opts)
   if !bin.get("ok", false) { return {"ok": false, "kind": "crackme_solve_all", "reason": bin.get("reason", "load_failed")} }
   def t = crackme_targets(bin, {"range": opts.get("range", target == 0 ? ".text" : target),
         "max_bytes": int(opts.get("target_bytes", opts.get("max_bytes", 65536)))})
   if t.get("find", []).len == 0 {
      return {"ok": false, "kind": "crackme_solve_all", "reason": "no_success_target", "targets": t}
   }
   mut o = opts
   if !o.contains("engine") && !o.contains("backend") { o = o.set("engine", "lifted") }
   if !o.contains("steps") { o = o.set("steps", 128) }
   if !o.contains("model_limit") && !o.contains("limit") { o = o.set("model_limit", 8) }
   if !o.contains("find") { o = o.set("find", t.get("find_predicate", dict())) }
   if !o.contains("avoid") && t.get("avoid", []).len > 0 { o = o.set("avoid", t.get("avoid_predicate", dict())) }
   def auto = _crackme_auto_input(bin, target, o)
   o = auto[0]
   def input_plan = auto[1]
   def run = symbolic_solve_all(bin, target, o)
   def explain = _crackme_solution_explain(t, run)
   run.set("kind", "crackme_solve_all").set("ok", run.get("sat", false)).set("targets", t)
   .set("find", t.get("find", [])).set("avoid", t.get("avoid", []))
   .set("input_plan", input_plan).set("explain", explain).set("text", explain.get("text", ""))
}

fn crackme_report(any source, any target=0, any opts=dict()) dict {
   "One-call crackme report: classify strings, solve the path, explain the
   chosen route, and return patch-plan metadata for UI/CLI tooling."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source), opts)
   if !bin.get("ok", false) { return {"ok": false, "kind": "crackme_report", "reason": bin.get("reason", "load_failed")} }
   def range = opts.get("range", target == 0 ? ".text" : target)
   def t = crackme_targets(bin, {"range": range,
         "max_bytes": int(opts.get("target_bytes", opts.get("max_bytes", 65536)))})
   if t.get("find", []).len == 0 {
      return {"ok": false, "kind": "crackme_report", "reason": "no_success_target", "targets": t}
   }
   mut o = opts
   if !o.contains("engine") && !o.contains("backend") { o = o.set("engine", "lifted") }
   if !o.contains("steps") { o = o.set("steps", 128) }
   if !o.contains("find") { o = o.set("find", t.get("find_predicate", dict())) }
   if !o.contains("avoid") && t.get("avoid", []).len > 0 { o = o.set("avoid", t.get("avoid_predicate", dict())) }
   def auto = _crackme_auto_input(bin, target, o)
   o = auto[0]
   def input_plan = auto[1]
   def solved = symbolic_solve(bin, target, o)
   def path = path_explain(bin, target, o)
   def explain = _crackme_solution_explain(t, solved)
   {"ok": solved.get("sat", false), "sat": solved.get("sat", false),
      "kind": "crackme_report", "arch": arch(bin), "target": target,
      "targets": t, "find": t.get("find", []), "avoid": t.get("avoid", []),
      "input_plan": input_plan, "solve": solved, "path": path,
      "solution": solved.get("solution", dict()),
      "model": solved.get("model", dict()), "symbolics": solved.get("symbolics", dict()), "inputs": solved.get("inputs", dict()),
      "decisions": path.get("decisions", []), "patch_plan": path.get("patch_plan", dict()),
      "constraint_notes": path.get("constraint_notes", []),
      "explain": explain, "text": explain.get("text", "") + (path.get("text", "").len > 0 ? ("\n\n" + path.get("text", "")) : "")}
}

fn _name_for_addr(dict bin, int addr) str {
   def fs = bin.get("functions", [])
   mut i = 0
   while i < fs.len {
      def f = fs[i]
      if int(f.get("value", 0)) == addr {
         return _rename_addr(bin, addr, _rename_name(bin, _safe_name(_display_symbol(f.get("name", "")), "sub_" + str.to_hex(addr, 0))))
      }
      i += 1
   }
   i = 0
   while i < fs.len {
      def f = fs[i]
      def start = int(f.get("value", 0))
      def size = int(f.get("size", 0))
      if start == addr || (size > 0 && addr >= start && addr < start + size) {
         return _rename_addr(bin, addr, _rename_name(bin, _safe_name(_display_symbol(f.get("name", "")), "sub_" + str.to_hex(addr, 0))))
      }
      i += 1
   }
   _rename_addr(bin, addr, "sub_" + str.to_hex(addr, 0))
}

fn call_targets(any source, any target=0, int max_bytes=512) list {
   "Return direct call targets discovered in a section/function/address."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def rows = target == 0 ? disassemble(bin, ".text", max_bytes) : disassemble(bin, target, max_bytes)
   def a = arch(bin)
   mut out = []
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if dasm.instruction_kind(a, r[1]) == "call" {
         if str.find(r[2], "[") >= 0 {
            def mem = _rip_memory_target(r)
            def name = mem != 0 ? _import_name_for_reloc(bin, mem) : ""
            if name.len > 0 {
               out = out.append({"from": r[0], "operand": r[2], "target": mem, "name": name, "kind": "import_indirect"})
            }
         } else {
            def addr = _row_target(a, r)
            if addr != 0 {
               def iname = _import_name_for_addr(bin, addr)
               out = out.append({"from": r[0], "operand": r[2], "target": addr, "name": iname.len > 0 ? iname : _name_for_addr(bin, addr), "kind": iname.len > 0 ? "import_plt" : "direct"})
            }
         }
      }
      i += 1
   }
   out
}

fn _lift_op(str a, str m) str {
   dasm.instruction_kind(a, m)
}

fn _operand_split(str ops) list {
   dasm.split_operands(ops)
}

fn _clean_operand(str op) str {
   dasm.clean_operand(op)
}

fn _paren_mem_parts(str op) dict {
   dasm.memory_operand_parts(op)
}

fn _is_store_mnemonic(str mnemonic) bool {
   def m = str.lower(str.strip(mnemonic))
   m == "str" || m == "strb" || m == "strh" || m == "stur" || m == "stp" || m == "stnp" ||
   m == "sd" || m == "sw" || m == "sh" || m == "sb"
}

fn _is_pair_store_mnemonic(str mnemonic) bool {
   def m = str.lower(str.strip(mnemonic))
   m == "stp" || m == "stnp"
}

fn _is_pair_load_mnemonic(str mnemonic) bool {
   def m = str.lower(str.strip(mnemonic))
   m == "ldp" || m == "ldnp"
}

fn _operand_kind(str op) str {
   dasm.operand_kind(op)
}

fn _ny_operand(str op) str {
   def s = _clean_operand(op)
   if _operand_kind(s) == "mem" {
      def slot = _stack_slot_for_ops(s)
      if _stack_slot_renderable(slot) { return slot.get("name", "local") }
      return dasm.operand_ny_expr(s)
   }
   dasm.operand_ny_expr(s)
}

fn _ny_operand_bin(dict bin, str op) str {
   def n = _ny_operand(op)
   if _operand_kind(op) == "imm" { return n }
   _rename_name(bin, n)
}

fn _ny_address_operand(str op) str {
   def n = _ny_operand(op)
   if str.startswith(n, "mem(") { return slice(n, 4, n.len - 1, 1) }
   if str.startswith(n, "mem_fs(") { return "&" + slice(n, 6, n.len, 1) }
   if str.startswith(n, "mem_gs(") { return "&" + slice(n, 6, n.len, 1) }
   _operand_kind(op) == "mem" ? dasm.address_ny_expr(op) : ("&" + n)
}

fn _ny_address_operand_bin(dict bin, str op) str {
   def plain = _ny_operand(op)
   def n = str.startswith(plain, "mem(") || str.startswith(plain, "mem_fs(") || str.startswith(plain, "mem_gs(") ? plain : _rename_name(bin, plain)
   if str.startswith(n, "mem(") { return slice(n, 4, n.len - 1, 1) }
   if str.startswith(n, "mem_fs(") { return "&" + slice(n, 6, n.len, 1) }
   if str.startswith(n, "mem_gs(") { return "&" + slice(n, 6, n.len, 1) }
   "&" + n
}

fn _ny_ref_value(dict ref, bool address=false) str {
   def k = ref.get("kind", "")
   if k == "string" { return address ? ("&" + repr(ref.get("value", ""))) : repr(ref.get("value", "")) }
   if k == "import" { return address ? ("&" + ref.get("name", "import")) : ref.get("name", "import") }
   if k == "data" { return address ? ("&" + ref.get("name", "data")) : ref.get("name", "data") }
   ""
}

fn _ny_operand_ref(str op, dict ref) str {
   if _operand_matches_ref(op, ref) {
      def named = _ny_ref_value(ref, false)
      if named.len > 0 { return named }
   }
   _ny_operand(op)
}

fn _ny_address_operand_ref(str op, dict ref) str {
   if _operand_matches_ref(op, ref) {
      def named = _ny_ref_value(ref, true)
      if named.len > 0 { return named }
   }
   _ny_address_operand(op)
}

fn _operand_matches_ref(str op, dict ref) bool {
   if ref.len == 0 { return false }
   if str.find(op, "rip") >= 0 { return true }
   _operand_kind(op) == "imm" && _imm_value(op) == int(ref.get("target", 0))
}

fn _ny_operand_ref_bin(dict bin, str op, dict ref) str {
   if _operand_matches_ref(op, ref) {
      def named = _ny_ref_value(ref, false)
      if named.len > 0 { return named }
   }
   def raw_table = _ny_dynamic_data_operand_bin(bin, op)
   if raw_table.len > 0 { return raw_table }
   def plain = _ny_operand(op)
   def table = _ny_dynamic_data_plain_bin(bin, plain)
   if table.len > 0 { return table }
   if _operand_kind(op) == "imm" { return plain }
   str.startswith(plain, "mem(") || str.startswith(plain, "mem_fs(") || str.startswith(plain, "mem_gs(") ? plain : _rename_name(bin, plain)
}

fn _ny_dynamic_data_name(dict bin, int addr) str {
   def sec = _any_section_for_addr(bin, addr)
   if sec.len == 0 && addr < 0x10000 { return "" }
   if sec.len == 0 && addr == 0xffffffff { return "" }
   if sec.len == 0 {
      return _rename_addr(bin, addr, "data_" + str.to_hex(addr, 0))
   }
   if (int(sec.get("flags", 0)) & SHF_ALLOC) == 0 { return "" }
   if (int(sec.get("flags", 0)) & SHF_EXECINSTR) != 0 { return "" }
   def st = _string_for_vaddr(bin, addr)
   if st.len > 0 && int(st.get("delta", 0)) == 0 {
      return _rename_addr(bin, int(st.get("addr", addr)), "str_" + str.to_hex(int(st.get("addr", addr)), 0))
   }
   _rename_addr(bin, addr, "data_" + str.to_hex(addr, 0))
}

fn _ny_dynamic_index_expr(dict mem) str {
   def idx = mem.get("index", "")
   def base = mem.get("base", "")
   def scale = int(mem.get("scale", 0))
   if idx.len > 0 {
      return scale == 0 || scale == 1 ? idx : (idx + " * " + to_str(scale))
   }
   base
}

fn _ny_dynamic_data_operand_bin(dict bin, str op) str {
   mut mem = _fact_mem_expr(op)
   if mem.len == 0 { mem = _fact_mem_expr(_clean_operand(op)) }
   if mem.len == 0 { return "" }
   def addr = int(mem.get("offset", 0))
   def name = _ny_dynamic_data_name(bin, addr)
   if name.len == 0 { return "" }
   def idx = _ny_dynamic_index_expr(mem)
   if idx.len == 0 { return "" }
   name + "[" + idx + "]"
}

fn _ny_dynamic_data_plain_bin(dict bin, str plain) str {
   def p = str.strip(plain)
   if !str.startswith(p, "mem(") || p.len <= 5 || load8(p, p.len - 1) != 41 { return "" }
   def expr = slice(p, 4, p.len - 1, 1)
   def terms = _fact_expr_terms(expr)
   mut addr = 0
   mut idxs = []
   mut i = 0
   while i < terms.len {
      def sign = int(terms[i].get("sign", 1))
      def term = _fact_clean_term(terms[i].get("text", ""))
      if term.len > 0 {
         if _fact_term_int(term) {
            addr += sign * _parse_int_piece(term)
         } else {
            idxs = idxs.append((sign < 0 ? "-" : "") + term)
         }
      }
      i += 1
   }
   def name = _ny_dynamic_data_name(bin, addr)
   if name.len == 0 || idxs.len == 0 { return "" }
   name + "[" + str.join(idxs, " + ") + "]"
}

fn _ny_address_operand_ref_bin(dict bin, str op, dict ref) str {
   if _operand_matches_ref(op, ref) {
      def named = _ny_ref_value(ref, true)
      if named.len > 0 { return named }
   }
   _ny_address_operand_bin(bin, op)
}

fn _pc_relative_addr_expr(dict bin, int target, dict ref) str {
   if ref.len > 0 {
      def named = _ny_ref_value(ref, true)
      if named.len > 0 { return named }
   }
   target == 0 ? "0" : _hex(target)
}

fn _is_byte_operand(str op) bool {
   str.find(str.lower(op), "byte ptr") >= 0
}

fn _zext_expr(str op, str value) str {
   if _is_byte_operand(op) { return "zext8(" + value + ")" }
   if str.find(str.lower(op), "dword ptr") >= 0 { return "zext32(" + value + ")" }
   if str.find(str.lower(op), "word ptr") >= 0 { return "zext16(" + value + ")" }
   "zext(" + value + ")"
}

fn _sext_expr(str op, str value) str {
   if _is_byte_operand(op) { return "sext8(" + value + ")" }
   if str.find(str.lower(op), "dword ptr") >= 0 { return "sext32(" + value + ")" }
   if str.find(str.lower(op), "word ptr") >= 0 { return "sext16(" + value + ")" }
   "sext(" + value + ")"
}

fn _branch_condition(str a, str m) str {
   dasm.branch_condition(a, m)
}

fn _setcc_condition(str m) str {
   def s = str.lower(str.strip(m))
   case s {
      "sete", "setz" -> "eq"
      "setne", "setnz" -> "ne"
      "seta", "setnbe" -> "ugt"
      "setae", "setnb", "setnc" -> "uge"
      "setb", "setnae", "setc" -> "ult"
      "setbe", "setna" -> "ule"
      "setg", "setnle" -> "gt"
      "setge", "setnl" -> "ge"
      "setl", "setnge" -> "lt"
      "setle", "setng" -> "le"
      _ -> ""
   }
}

fn _cmov_condition(str m) str {
   def s = str.lower(str.strip(m))
   if !str.startswith(s, "cmov") { return "" }
   _setcc_condition("set" + slice(s, 4, s.len, 1))
}

fn _cmp_effect_expr_bin(dict bin, dict row) str {
   def cond = row.get("condition", "")
   def lhs_raw = row.get("cmp_lhs", "")
   def rhs_raw = row.get("cmp_rhs", "")
   if cond.len == 0 || lhs_raw.len == 0 { return "last_cmp" + (cond.len > 0 ? ("." + cond) : "") }
   def lhs = _ny_operand_ref_bin(bin, lhs_raw, dict())
   def rhs = _ny_operand_ref_bin(bin, rhs_raw, dict())
   def op = _cmp_condition_symbol(cond)
   if str.startswith(str.lower(row.get("cmp_mnemonic", "")), "test") {
      if op.len > 0 { return _clean_test_expr(lhs, rhs, cond, op) }
   }
   if op.len == 0 { return "last_cmp." + cond }
   if cond == "negative" || cond == "non_negative" { return lhs + " " + op }
   lhs + " " + op + " " + rhs
}

fn _refresh_condition_effect(dict bin, dict row) dict {
   def kind = row.get("kind", "")
   if kind != "setcc" && kind != "cmovcc" { return row }
   if row.get("cmp_lhs", "").len == 0 { return row }
   def expr = _cmp_effect_expr_bin(bin, row)
   def dst = _ny_operand_ref_bin(bin, row.get("dst", ""), dict())
   if kind == "setcc" { return row.set("effect", dst + " = bool(" + expr + ")") }
   def src = _ny_operand_ref_bin(bin, row.get("src", ""), dict())
   row.set("effect", dst + " = (" + expr + ") ? " + src + " : " + dst)
}

fn _zero_flag_condition(str cond) bool {
   cond == "eq" || cond == "ne" || cond == "zero" || cond == "nonzero"
}

fn _attach_compare_context(dict bin, list rows) list {
   mut out = rows
   mut i = 0
   while i < out.len {
      def row = out[i]
      if row.get("kind", "") == "setcc" || row.get("kind", "") == "cmovcc" {
         mut j = i - 1
         while j >= 0 && i - j <= 8 {
            def prev = out[j]
            def pop = prev.get("op", "")
            if pop == "call" || pop == "branch" || pop == "syscall" || pop == "return" { break }
            if pop == "compare" {
               out = out.set(i, _refresh_condition_effect(bin, row.set("cmp_lhs", prev.get("dst", "")).set("cmp_rhs", prev.get("src", "")).set("cmp_mnemonic", prev.get("mnemonic", ""))))
               break
            }
            if pop == "arith" && _zero_flag_condition(row.get("condition", "")) && prev.get("dst_kind", "") == "reg" {
               out = out.set(i, _refresh_condition_effect(bin, row.set("cmp_lhs", prev.get("dst", "")).set("cmp_rhs", "0").set("cmp_mnemonic", prev.get("mnemonic", ""))))
               break
            }
            j -= 1
         }
      }
      i += 1
   }
   i = 0
   while i < out.len {
      def row = out[i]
      if (row.get("op", "") == "branch" && row.get("condition", "") == "always" &&
         int(row.get("target", 0)) == 0 && row.get("jump_table", dict()).len == 0){
         def jt = _relative_switch_for_lift_rows(bin, out, i, 32)
         if jt.len > 0 {
            out = out.set(i, row.set("kind", "switch").set("jump_table", jt)
               .set("effect", "switch(" + jt.get("index_reg", "") + ")"))
         }
      }
      i += 1
   }
   out
}

fn _arith_symbol(str m) str {
   dasm.arithmetic_operator(m)
}

fn _x86_vector_zeroing_idiom(str arch0, str mnemonic, str operands) bool {
   if dasm.arch_family(arch0) != "x86" { return false }
   def m = str.lower(str.strip(mnemonic))
   if !(m == "pxor" || m == "xorps" || m == "xorpd" || m == "vpxor" || m == "vxorps" || m == "vxorpd") { return false }
   def parts = _operand_split(operands)
   if parts.len == 2 { return str.lower(str.strip(parts[0])) == str.lower(str.strip(parts[1])) }
   if parts.len >= 3 { return str.lower(str.strip(parts[1])) == str.lower(str.strip(parts[2])) }
   false
}

fn _arch_three_operand_arith(str family, str mnemonic, list parts) bool {
   if !(family == "aarch64" || family == "arm" || family == "riscv") { return false }
   if parts.len < 3 { return false }
   def op = _arith_symbol(mnemonic)
   if op.len == 0 || op == "=" || op == "neg" || op == "~" || op == "rol" || op == "ror" { return false }
   true
}

fn _arch_shifted_base_expr(dict bin, str base, str modifier, dict ref) str {
   mut m = str.lower(str.strip(modifier))
   if m.len == 0 { return base }
   mut op = ""
   if str.startswith(m, "lsl") { op = "<<" }
   elif str.startswith(m, "lsr") || str.startswith(m, "asr") { op = ">>" }
   else { return base }
   m = str.strip(slice(m, 3, m.len, 1))
   if str.startswith(m, ",") { m = str.strip(slice(m, 1, m.len, 1)) }
   if m.len == 0 { return base }
   "(" + base + " " + op + " " + _ny_operand_ref_bin(bin, m, ref) + ")"
}

fn _arch_shifted_operand_expr(dict bin, str operand, str modifier, dict ref) str {
   _arch_shifted_base_expr(bin, _ny_operand_ref_bin(bin, operand, ref), modifier, ref)
}

fn _pair_mem_second_expr(dict bin, str memop, int stride, dict ref) str {
   def first = _ny_operand_ref_bin(bin, memop, ref)
   if str.startswith(first, "mem(") {
      def inner = slice(first, 4, first.len - 1, 1)
      return "mem(" + inner + " + " + to_str(stride) + ")"
   }
   first + " + " + to_str(stride)
}

fn _pair_writeback_effect(dict bin, str memop, str post, dict ref) str {
   def mp = _paren_mem_parts(memop)
   def base = mp.get("base", "")
   mut off = str.strip(post)
   if off.len == 0 && str.endswith(str.strip(memop), "!") { off = str.strip(to_str(mp.get("offset", ""))) }
   if base.len == 0 || off.len == 0 || off == "0" { return "" }
   if str.startswith(off, "#") { off = str.strip(slice(off, 1, off.len, 1)) }
   def b = _ny_operand_ref_bin(bin, base, ref)
   if str.startswith(off, "-") {
      return b + " = " + b + " - " + _ny_operand_ref_bin(bin, slice(off, 1, off.len, 1), ref)
   }
   if str.startswith(off, "+") { off = str.strip(slice(off, 1, off.len, 1)) }
   b + " = " + b + " + " + _ny_operand_ref_bin(bin, off, ref)
}

fn _lift_row(dict bin, list r) dict {
   def m = r[1]
   def ops = r[2]
   def parts = _operand_split(ops)
   def a = arch(bin)
   def fam = dasm.arch_family(a)
   def op = _lift_op(a, m)
   def ref = _best_ref_for_row(bin, r)
   def dst_raw = _is_store_mnemonic(m) && parts.len > 1 ? parts[1] : (parts.len > 0 ? parts[0] : "")
   def src_raw = _is_store_mnemonic(m) && parts.len > 1 ? parts[0] : (parts.len > 1 ? parts[1] : "")
   mut row = {"addr": r[0], "op": op, "mnemonic": m, "operands": ops, "args": parts, "size": r[3],
      "arch": dasm.normalize_arch(a), "family": fam,
      "dst": dst_raw, "src": src_raw,
      "dst_kind": dst_raw.len > 0 ? _operand_kind(dst_raw) : "none",
      "src_kind": src_raw.len > 0 ? _operand_kind(src_raw) : "none",
      "target": 0, "target_name": "", "effect": ""}
   if ref.len > 0 { row = row.set("ref", ref).set("ref_kind", ref.get("kind", "")).set("ref_name", ref.get("name", "")).set("ref_target", ref.get("target", 0)) }
   if op == "call" {
      def caddr = str.find(ops, "[") >= 0 ? 0 : _row_target(a, r)
      def mem = str.find(ops, "[") >= 0 ? _rip_memory_target(r) : 0
      row = row.set("target", caddr).set("mem_target", mem).set("target_name", _call_name_for_row(bin, r)).set("effect", "call")
   } elif op == "syscall" {
      row = row.set("effect", _syscall_lift_effect(fam))
   } elif op == "branch" {
      def baddr = str.find(ops, "[") >= 0 ? 0 : _row_target(a, r)
      def cond = _branch_condition(a, m)
      row = row.set("target", baddr).set("condition", cond).set("effect", cond == "always" ? (baddr == 0 ? "jump_indirect" : "jump") : "branch")
      if baddr == 0 && cond == "always" {
         def jt = _jump_table_for_row(bin, r, 32)
         if jt.len > 0 { row = row.set("kind", "switch").set("jump_table", jt).set("effect", "switch(" + jt.get("index_reg", "") + ")") }
      }
   } elif op == "assign" {
      if _is_pair_store_mnemonic(m) && parts.len > 2 {
         def stride = _clean_operand_bits(parts[0]) <= 32 ? 4 : 8
         mut effect = _ny_operand_ref_bin(bin, parts[2], ref) + ", " + _pair_mem_second_expr(bin, parts[2], stride, ref) + " = " +
         _ny_operand_ref_bin(bin, parts[0], ref) + ", " + _ny_operand_ref_bin(bin, parts[1], ref)
         def wb = _pair_writeback_effect(bin, parts[2], parts.len > 3 ? parts[3] : "", ref)
         if wb.len > 0 { effect = effect + "; " + wb }
         row = row.set("kind", "store_pair").set("dst", parts[2]).set("src", parts[0]).set("src2", parts[1])
         .set("dst_kind", _operand_kind(parts[2])).set("src_kind", _operand_kind(parts[0])).set("src2_kind", _operand_kind(parts[1]))
         .set("effect", effect)
      } elif _is_pair_load_mnemonic(m) && parts.len > 2 {
         def stride = _clean_operand_bits(parts[0]) <= 32 ? 4 : 8
         mut effect = _ny_operand_ref_bin(bin, parts[0], ref) + ", " + _ny_operand_ref_bin(bin, parts[1], ref) + " = " +
         _ny_operand_ref_bin(bin, parts[2], ref) + ", " + _pair_mem_second_expr(bin, parts[2], stride, ref)
         def wb = _pair_writeback_effect(bin, parts[2], parts.len > 3 ? parts[3] : "", ref)
         if wb.len > 0 { effect = effect + "; " + wb }
         row = row.set("kind", "load_pair").set("dst", parts[0]).set("dst2", parts[1]).set("src", parts[2])
         .set("dst_kind", _operand_kind(parts[0])).set("dst2_kind", _operand_kind(parts[1])).set("src_kind", _operand_kind(parts[2]))
         .set("effect", effect)
      } else {
         row = row.set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + _ny_operand_ref_bin(bin, row.get("src", ""), ref))
      }
      if str.startswith(m, "cmov") {
         def cc = _cmov_condition(m)
         def cdst = _ny_operand_ref_bin(bin, row.get("dst", ""), ref)
         def csrc = _ny_operand_ref_bin(bin, row.get("src", ""), ref)
         row = row.set("kind", "cmovcc").set("condition", cc).set("effect", cdst + " = " + (cc.len > 0 ? ("last_cmp." + cc + " ? " + csrc + " : " + cdst) : csrc))
      } elif str.startswith(m, "set") {
         def sc = _setcc_condition(m)
         row = row.set("kind", "setcc").set("condition", sc).set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + (sc.len > 0 ? ("bool(last_cmp." + sc + ")") : "bool(last_cmp)"))
      } elif m == "lea" && parts.len > 1 {
         if str.find(row.get("src", ""), "rip") >= 0 {
            def target = _rip_memory_target(r)
            def expr = _pc_relative_addr_expr(bin, target, ref)
            row = row.set("kind", "lea").set("addr_value", target).set("addr_expr", expr)
            .set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + expr)
         } else {
            row = row.set("kind", "lea").set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + _ny_address_operand_ref_bin(bin, row.get("src", ""), ref))
         }
      } elif str.startswith(m, "xchg") && parts.len > 1 {
         row = row.set("kind", "swap").set("effect", "swap(" + _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + ", " + _ny_operand_ref_bin(bin, row.get("src", ""), ref) + ")")
      } elif (str.startswith(m, "movzx") || str.startswith(m, "movsx")) && parts.len > 1 {
         def rhs = _ny_operand_ref(row.get("src", ""), ref)
         row = row.set("kind", "byte_load").set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + (str.startswith(m, "movsx") ? _sext_expr(row.get("src", ""), rhs) : _zext_expr(row.get("src", ""), rhs)))
      }
   } elif op == "arith" || m == "bswap" || m == "cdqe" || m == "cwde" || m == "cbw" || _x86_vector_zeroing_idiom(a, m, ops) {
      if dasm.is_zeroing_idiom(a, m, ops) || _x86_vector_zeroing_idiom(a, m, ops) {
         row = row.set("op", "arith").set("operator", "=").set("kind", "zeroing_idiom").set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = 0")
      } elif fam == "riscv" && (m == "addi" || m == "addiw") && parts.len > 2 && dasm.is_zero_register(a, parts[1]) {
         row = row.set("operator", "=").set("kind", "imm_load").set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + _ny_operand_bin(bin, parts[2]))
      } elif str.startswith(m, "inc") {
         row = row.set("operator", "+").set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " + 1")
      } elif str.startswith(m, "dec") {
         row = row.set("operator", "-").set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " - 1")
      } elif str.startswith(m, "neg") {
         row = row.set("operator", "neg").set("kind", "unary").set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = -" + _ny_operand_ref_bin(bin, row.get("dst", ""), ref))
      } elif m == "not" {
         row = row.set("operator", "~").set("kind", "unary").set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = ~" + _ny_operand_ref_bin(bin, row.get("dst", ""), ref))
      } elif m == "cdq" {
         row = row.set("operator", "sign_extend").set("kind", "sign_extend_dividend").set("dst", "edx").set("src", "eax").set("effect", "edx = signbit(eax) ? -1 : 0")
      } elif m == "cqo" {
         row = row.set("operator", "sign_extend").set("kind", "sign_extend_dividend").set("dst", "rdx").set("src", "rax").set("effect", "rdx = signbit(rax) ? -1 : 0")
      } elif m == "cdqe" {
         row = row.set("op", "arith").set("operator", "sign_extend").set("kind", "sign_extend_acc").set("dst", "rax").set("src", "eax")
         .set("dst_kind", "reg").set("src_kind", "reg").set("effect", "rax = sext(eax)")
      } elif m == "cwde" {
         row = row.set("op", "arith").set("operator", "sign_extend").set("kind", "sign_extend_acc").set("dst", "eax").set("src", "ax")
         .set("dst_kind", "reg").set("src_kind", "reg").set("effect", "eax = sext(ax)")
      } elif m == "cbw" {
         row = row.set("op", "arith").set("operator", "sign_extend").set("kind", "sign_extend_acc").set("dst", "ax").set("src", "al")
         .set("dst_kind", "reg").set("src_kind", "reg").set("effect", "ax = sext(al)")
      } elif fam == "x86" && (m == "idiv" || m == "div") {
         def rhs = _ny_operand_ref_bin(bin, row.get("dst", ""), ref)
         row = row.set("operator", "/").set("kind", m == "idiv" ? "signed_div" : "unsigned_div").set("src", row.get("dst", "")).set("src_kind", row.get("dst_kind", "")).set("dst", "eax").set("dst_kind", "reg")
         .set("effect", "eax, edx = divmod(eax, " + rhs + ")")
      } elif m == "bswap" {
         def dst = _ny_operand_ref_bin(bin, row.get("dst", ""), ref)
         def bits = _clean_operand_bits(row.get("dst", ""))
         row = row.set("op", "arith").set("operator", "bswap").set("kind", bits == 64 ? "byte_swap64" : "byte_swap32")
         .set("src", row.get("dst", "")).set("src_kind", row.get("dst_kind", ""))
         .set("effect", dst + " = bswap" + to_str(bits == 64 ? 64 : 32) + "(" + dst + ")")
      } elif fam == "x86" && (m == "imul" || m == "mul") && parts.len == 1 {
         def bits0 = _clean_operand_bits(parts[0])
         def bits = bits0 == 64 ? 64 : (bits0 == 16 ? 16 : (bits0 == 8 ? 8 : 32))
         def lo = bits == 64 ? "rax" : (bits == 16 ? "ax" : (bits == 8 ? "al" : "eax"))
         def hi = bits == 64 ? "rdx" : (bits == 16 ? "dx" : (bits == 8 ? "ah" : "edx"))
         def rhs = _ny_operand_ref_bin(bin, parts[0], ref)
         def prefix = m == "imul" ? "smul" : "umul"
         row = row.set("operator", "*").set("kind", "wide_mul").set("dst", lo).set("dst2", hi)
         .set("src", lo).set("src2", parts[0]).set("bits", bits).set("signed", m == "imul")
         .set("dst_kind", "reg").set("dst2_kind", "reg").set("src_kind", "reg").set("src2_kind", _operand_kind(parts[0]))
         .set("effect", lo + ", " + hi + " = " + prefix + "_wide" + to_str(bits) + "(" + lo + ", " + rhs + ")")
      } elif (m == "imul" || m == "mul") && parts.len > 2 {
         row = row.set("operator", "*").set("kind", "mul3").set("src", parts[1]).set("src2", parts[2])
         .set("src_kind", _operand_kind(parts[1])).set("src2_kind", _operand_kind(parts[2]))
         .set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + _ny_operand_ref_bin(bin, parts[1], ref) + " * " + _ny_operand_ref_bin(bin, parts[2], ref))
      } elif _arch_three_operand_arith(fam, m, parts) {
         def rhs = parts.len > 3 ? _arch_shifted_operand_expr(bin, parts[2], parts[3], ref) : _ny_operand_ref_bin(bin, parts[2], ref)
         def sym = _arith_symbol(m)
         row = row.set("operator", sym).set("kind", "arith3").set("src", parts[1]).set("src2", parts[2])
         .set("src_kind", _operand_kind(parts[1])).set("src2_kind", _operand_kind(parts[2]))
         .set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + _ny_operand_ref_bin(bin, parts[1], ref) + " " + _ny_infix_operator(sym) + " " + rhs)
         if parts.len > 3 { row = row.set("src2_modifier", parts[3]) }
      } elif (str.startswith(m, "rol") || str.startswith(m, "ror")) && parts.len > 1 {
         def rot = _arith_symbol(m)
         row = row.set("operator", rot).set("kind", "rotate")
         .set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + rot + "(" + _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + ", " + _ny_operand_ref_bin(bin, row.get("src", ""), ref) + ")")
      } else {
         def sym = _arith_symbol(m)
         row = row.set("operator", sym).set("effect", _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " = " + _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + " " + _ny_infix_operator(sym) + " " + _ny_operand_ref_bin(bin, row.get("src", ""), ref))
      }
   } elif op == "compare" {
      row = row.set("effect", "last_cmp = [" + _ny_operand_ref_bin(bin, row.get("dst", ""), ref) + ", " + _ny_operand_ref_bin(bin, row.get("src", ""), ref) + "]")
   } elif op == "return" {
      row = row.set("effect", "return")
   } elif op == "stack" {
      if m == "push" { row = row.set("effect", "push(" + _ny_operand_bin(bin, row.get("dst", "")) + ")") }
      elif m == "pop" { row = row.set("effect", _ny_operand_bin(bin, row.get("dst", "")) + " = pop()") }
      elif m == "leave" { row = row.set("effect", "leave_frame()") }
   }
   row
}

fn _lift_rows(dict bin, list rows) list {
   mut out = []
   mut i = 0
   while i < rows.len {
      out = out.append(_lift_row(bin, rows[i]))
      i += 1
   }
   out = _attach_compare_context(bin, out)
   i = 0
   while i < out.len {
      def r = out[i]
      if r.get("op", "") == "branch" && r.get("condition", "") == "always" && int(r.get("target", 0)) == 0 && r.get("jump_table", dict()).len == 0 {
         def jt = _relative_switch_for_lift_rows(bin, out, i, 32)
         if jt.len > 0 { out = out.set(i, r.set("kind", "switch").set("jump_table", jt).set("effect", "switch(" + jt.get("index_reg", "") + ")")) }
      }
      i += 1
   }
   out
}

fn lift(any source, any target=0, int max_bytes=1024) list {
   "Lift disassembly rows into compact Nytrix IR rows for later CFG/symbolic passes."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   _lift_rows(bin, disassemble(bin, target, max_bytes))
}

fn _slice_operand_symbol(str op) str {
   def s = str.strip(op)
   if s.len == 0 || _operand_looks_immediate_literal(s) { return "" }
   def kind = _operand_kind(s)
   if kind == "none" || kind == "imm" { return "" }
   str.lower(_ny_operand(s))
}

fn _slice_operand_symbols(str op) list {
   def main = _slice_operand_symbol(op)
   mut out = []
   if main.len > 0 { out = _append_all_unique(out, _slice_symbol_aliases(main)) }
   if str.startswith(main, "mem(") || str.startswith(main, "mem_fs(") || str.startswith(main, "mem_gs(") {
      out = _append_all_unique(out, _symbols_from_text(main))
   }
   out
}

fn _row_defs(dict row) list {
   if row.contains("defs") { return row.get("defs", []) }
   def op = row.get("op", "")
   def dst = row.get("dst", "")
   mut out = []
   if op == "assign" || op == "arith" {
      out = _append_all_unique(out, _slice_operand_symbols(dst))
      if op == "assign" && row.get("kind", "") == "load_pair" {
         out = _append_all_unique(out, _slice_operand_symbols(row.get("dst2", "")))
      } elif op == "arith" && row.get("kind", "") == "wide_mul" {
         out = _append_all_unique(out, _slice_operand_symbols(row.get("dst2", "")))
      }
   } elif op == "compare" {
      out = ["last_cmp"]
   } elif op == "call" {
      out = ["rax", "eax", "x0", "r0"]
   } elif op == "syscall" {
      out = ["rax", "eax", "x0", "w0", "r0", "a0"]
   } elif op == "stack" {
      def m = row.get("mnemonic", "")
      if m == "pop" { out = _append_all_unique(out, _slice_operand_symbols(dst)) }
      out = _append_unique(out, "rsp")
   }
   out
}

fn _row_uses(dict row) list {
   def op = row.get("op", "")
   mut out = []
   if op == "assign" {
      if row.get("dst_kind", "") == "mem" { out = _append_all_unique(out, _slice_operand_symbols(row.get("dst", ""))) }
      out = _append_all_unique(out, _slice_operand_symbols(row.get("src", "")))
      if row.get("kind", "") == "store_pair" {
         out = _append_all_unique(out, _slice_operand_symbols(row.get("src2", "")))
      }
   } elif op == "arith" {
      def kind = row.get("kind", "")
      if row.get("dst_kind", "") == "mem" { out = _append_all_unique(out, _slice_operand_symbols(row.get("dst", ""))) }
      if kind == "sign_extend_acc" || kind == "sign_extend_dividend" {
         out = _append_all_unique(out, _slice_operand_symbols(row.get("src", "")))
      } elif kind == "mul3" || kind == "arith3" || kind == "wide_mul" {
         out = _append_all_unique(out, _slice_operand_symbols(row.get("src", "")))
         out = _append_all_unique(out, _slice_operand_symbols(row.get("src2", "")))
      } else {
         out = _append_all_unique(out, _slice_operand_symbols(row.get("dst", "")))
         out = _append_all_unique(out, _slice_operand_symbols(row.get("src", "")))
      }
   } elif op == "compare" {
      out = _append_all_unique(out, _slice_operand_symbols(row.get("dst", "")))
      out = _append_all_unique(out, _slice_operand_symbols(row.get("src", "")))
   } elif op == "branch" {
      if row.get("kind", "") == "switch" {
         def idx = row.get("jump_table", dict()).get("index_reg", "")
         out = idx.len > 0 ? _append_unique(out, str.lower(idx)) : _append_all_unique(out, _slice_operand_symbols(row.get("operands", "")))
      } else {
         out = _append_unique(out, "last_cmp")
      }
   } elif op == "call" {
      out = ["rdi", "rsi", "rdx", "rcx", "r8", "r9", "x0", "x1", "x2", "x3", "r0", "r1", "r2", "r3"]
   } elif op == "syscall" {
      out = ["rax", "rdi", "rsi", "rdx", "r10", "r8", "r9", "x8", "x0", "x1", "x2", "x3", "x4", "x5", "r7", "r0", "r1", "r2", "r3", "r4", "r5", "a7", "a0", "a1", "a2", "a3", "a4", "a5"]
   } elif op == "stack" {
      def m = row.get("mnemonic", "")
      if m == "push" { out = _append_all_unique(out, _slice_operand_symbols(row.get("dst", ""))) }
      out = _append_unique(out, "rsp")
   }
   out
}

fn _slice_row(dict row) dict {
   row.set("defs", _row_defs(row)).set("uses", _row_uses(row))
}

fn _slice_seed_rows(list rows, any seed) list {
   mut out = []
   if is_int(seed) {
      mut i = 0
      while i < rows.len {
         if int(rows[i].get("addr", 0)) == int(seed) { out = out.append(i) }
         i += 1
      }
      return out
   }
   if is_dict(seed) && seed.contains("addr") { return _slice_seed_rows(rows, int(seed.get("addr", 0))) }
   []
}

fn _slice_seed_symbols(any seed) list {
   if is_str(seed) { return _slice_operand_symbols(seed) }
   if is_dict(seed) {
      if seed.contains("symbol") { return _slice_operand_symbols(to_str(seed.get("symbol", ""))) }
      if seed.contains("symbols") {
         def xs = seed.get("symbols", [])
         mut out = []
         mut i = 0
         while i < xs.len {
            out = _append_all_unique(out, _slice_operand_symbols(to_str(xs[i])))
            i += 1
         }
         return out
      }
   }
   []
}

fn _slice_close_control_rows(list rows, list selected) list {
   mut out = selected
   mut i = 0
   while i < rows.len - 1 {
      def r = rows[i]
      def n = rows[i + 1]
      if _list_has(out, i) && r.get("op", "") == "compare" && n.get("op", "") == "branch" {
         out = _append_unique(out, i + 1)
      }
      i += 1
   }
   i = 0
   while i < rows.len {
      def r = rows[i]
      if _list_has(out, i) && r.get("op", "") == "branch" && r.get("jump_table", dict()).len > 0 {
         def entries = r.get("jump_table", dict()).get("entries", [])
         mut ei = 0
         while ei < entries.len {
            def target = int(entries[ei].get("target", 0))
            mut j = 0
            while j < rows.len {
               if int(rows[j].get("addr", 0)) == target { out = _append_unique(out, j) }
               j += 1
            }
            ei += 1
         }
      }
      i += 1
   }
   i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" && r.get("jump_table", dict()).len > 0 {
         def entries = r.get("jump_table", dict()).get("entries", [])
         mut ei = 0
         while ei < entries.len {
            def target = int(entries[ei].get("target", 0))
            mut j = 0
            while j < rows.len {
               if _list_has(out, j) && int(rows[j].get("addr", 0)) == target { out = _append_unique(out, i) }
               j += 1
            }
            ei += 1
         }
      }
      i += 1
   }
   out
}

fn _slice_expand_selected_dependencies(list rows, list selected) list {
   mut out = selected
   mut need = []
   mut i = 0
   while i < rows.len {
      if _list_has(out, i) { need = _append_all_unique(need, rows[i].get("uses", [])) }
      i += 1
   }
   i = rows.len - 1
   while i >= 0 {
      def r = rows[i]
      if _list_has(out, i) || _symbols_intersect(r.get("defs", []), need) {
         out = _append_unique(out, i)
         need = _append_all_unique(need, r.get("uses", []))
      }
      i -= 1
   }
   out
}

fn _du_symbol_append(dict by_symbol, str sym, str key, dict rec) dict {
   if sym.len == 0 { return by_symbol }
   mut cur = by_symbol.get(sym, {"symbol": sym, "defs": [], "uses": []})
   cur = cur.set(key, cur.get(key, []).append(rec))
   by_symbol.set(sym, cur)
}

fn _def_use_rows(list rows0, any target=0) dict {
   mut rows = []
   mut defs = []
   mut uses = []
   mut edges = []
   mut by_symbol = dict()
   mut last_def = dict()
   mut i = 0
   while i < rows0.len {
      def row = _slice_row(rows0[i]).set("index", i)
      rows = rows.append(row)
      def rdefs = row.get("defs", [])
      def ruses = row.get("uses", [])
      mut ui = 0
      while ui < ruses.len {
         def symb = to_str(ruses[ui])
         def reaching = last_def.get(symb, dict())
         mut rec = {"symbol": symb, "addr": row.get("addr", 0), "index": i,
            "mnemonic": row.get("mnemonic", ""), "operand": row.get("operands", "")}
         if reaching.len > 0 {
            rec = rec.set("def_addr", reaching.get("addr", 0)).set("def_index", reaching.get("index", -1))
            edges = edges.append({"symbol": symb, "from": reaching.get("addr", 0), "from_index": reaching.get("index", -1),
                  "to": row.get("addr", 0), "to_index": i})
         }
         uses = uses.append(rec)
         by_symbol = _du_symbol_append(by_symbol, symb, "uses", rec)
         ui += 1
      }
      mut di = 0
      while di < rdefs.len {
         def symb = to_str(rdefs[di])
         def rec = {"symbol": symb, "addr": row.get("addr", 0), "index": i,
            "mnemonic": row.get("mnemonic", ""), "operand": row.get("operands", "")}
         defs = defs.append(rec)
         by_symbol = _du_symbol_append(by_symbol, symb, "defs", rec)
         last_def = last_def.set(symb, rec)
         di += 1
      }
      i += 1
   }
   {"kind": "def_use", "target": target, "rows": rows, "defs": defs, "uses": uses,
      "edges": edges, "by_symbol": by_symbol, "symbols": by_symbol.keys(),
      "row_count": rows.len, "def_count": defs.len, "use_count": uses.len, "edge_count": edges.len}
}

fn def_use(any source, any target=0, any opts=dict()) dict {
   "Return a compact def-use graph over lifted Ny IR rows.
   Rows carry `defs` and `uses` ; `edges` connect the last reaching definition
   of a symbol to each later use. This is intentionally data-shaped for
   reversing UIs, slicers, and symbolic harnesses."
   def max_bytes = int(is_dict(opts) ? opts.get("max_bytes", 1024) : (is_int(opts) ? opts : 1024))
   _def_use_rows(lift(source, target, max_bytes), target)
}

fn _fact_add(list facts, str kind, dict rec) list {
   mut item = dict()
   def keys = rec.keys()
   mut i = 0
   while i < keys.len {
      item = item.set(keys[i], rec.get(keys[i]))
      i += 1
   }
   facts = facts.append(item.set("kind", kind))
   facts
}

fn _fact_count_by_kind(list facts) dict {
   mut out = dict()
   mut i = 0
   while i < facts.len {
      def k = facts[i].get("kind", "")
      if k.len > 0 { out = out.set(k, int(out.get(k, 0)) + 1) }
      i += 1
   }
   out
}

fn _fact_width(str op) int {
   def s = str.lower(op)
   if str.find(s, "ymmword ptr") >= 0 { return 32 }
   if str.find(s, "xmmword ptr") >= 0 { return 16 }
   if str.find(s, "qword ptr") >= 0 { return 8 }
   if str.find(s, "dword ptr") >= 0 { return 4 }
   if str.find(s, "word ptr") >= 0 { return 2 }
   if str.find(s, "byte ptr") >= 0 { return 1 }
   0
}

fn _fact_expr_terms(str expr) list {
   def s0 = str.str_replace(str.str_replace(str.lower(expr), ",", "+"), "#", "")
   mut out = []
   mut start = 0
   mut sign = 1
   mut i = 0
   while i < s0.len {
      def ch = load8(s0, i)
      if (ch == 43 || ch == 45) && i > start {
         def t = str.strip(slice(s0, start, i, 1))
         if t.len > 0 { out = out.append({"sign": sign, "text": t}) }
         sign = ch == 45 ? -1 : 1
         start = i + 1
      } elif (ch == 43 || ch == 45) && i == start {
         sign = ch == 45 ? -1 : 1
         start = i + 1
      }
      i += 1
   }
   if start < s0.len {
      def t = str.strip(slice(s0, start, s0.len, 1))
      if t.len > 0 { out = out.append({"sign": sign, "text": t}) }
   }
   out
}

fn _fact_term_int(str s) bool {
   _looks_int_literal(str.strip(s))
}

fn _fact_clean_term(str s) str {
   mut out = str.str_replace(str.strip(s), " ", "")
   while out.len > 1 && load8(out, 0) == 40 && load8(out, out.len - 1) == 41 {
      out = str.strip(slice(out, 1, out.len - 1, 1))
   }
   out
}

fn _fact_apply_scaled_term(dict acc, str lhs0, str rhs0, int sign) dict {
   def lhs = _fact_clean_term(lhs0)
   def rhs = _fact_clean_term(rhs0)
   if lhs.len == 0 || rhs.len == 0 { return acc }
   if _fact_term_int(lhs) && !_fact_term_int(rhs) {
      return acc.set("index", rhs).set("scale", sign * _parse_int_piece(lhs))
   }
   if _fact_term_int(rhs) && !_fact_term_int(lhs) {
      return acc.set("index", lhs).set("scale", sign * _parse_int_piece(rhs))
   }
   acc
}

fn _fact_mem_expr(str op) dict {
   def mp = _paren_mem_parts(op)
   if !mp.get("ok", false) { return dict() }
   def expr = mp.get("expr", "")
   mut out = {"ok": true, "segment": mp.get("segment", ""), "expr": expr,
      "base": mp.get("base", ""), "index": "", "scale": 0, "offset": 0}
   if mp.contains("offset") { out = out.set("offset", _parse_int_piece(to_str(mp.get("offset", "0")))) }
   def terms = _fact_expr_terms(expr)
   mut i = 0
   while i < terms.len {
      def sign = int(terms[i].get("sign", 1))
      def term = _fact_clean_term(terms[i].get("text", ""))
      if term.len > 0 {
         def star = str.find(term, "*")
         if star >= 0 {
            out = _fact_apply_scaled_term(out, slice(term, 0, star, 1), slice(term, star + 1, term.len, 1), sign)
         } elif _fact_term_int(term) {
            out = out.set("offset", int(out.get("offset", 0)) + sign * _parse_int_piece(term))
         } elif out.get("base", "").len == 0 && sign > 0 {
            out = out.set("base", term)
         } elif sign > 0 && term == out.get("base", "") {
            out = out
         } elif out.get("index", "").len == 0 {
            out = out.set("index", term).set("scale", sign)
         }
      }
      i += 1
   }
   if out.get("base", "").len == 0 && out.get("index", "").len > 0 && int(out.get("scale", 0)) == 1 {
      out = out.set("base", out.get("index", "")).set("index", "").set("scale", 0)
   }
   out
}

fn _fact_mem_access(dict row, str operand, str access) dict {
   def mem = _fact_mem_expr(operand)
   if mem.len == 0 { return dict() }
   {"row": int(row.get("index", -1)), "addr": int(row.get("addr", 0)),
      "mnemonic": row.get("mnemonic", ""), "operand": operand, "access": access,
      "width": _fact_width(operand), "segment": mem.get("segment", ""),
      "expr": mem.get("expr", ""), "base": mem.get("base", ""),
      "index": mem.get("index", ""), "scale": int(mem.get("scale", 0)),
      "offset": int(mem.get("offset", 0))}
}

fn _fact_row_memory(list out0, dict row) list {
   mut out = out0
   def op = row.get("op", "")
   if row.get("dst_kind", "") == "mem" {
      if op == "arith" {
         def rd = _fact_mem_access(row, row.get("dst", ""), "read")
         if rd.len > 0 { out = out.append(rd) }
         def wr = _fact_mem_access(row, row.get("dst", ""), "write")
         if wr.len > 0 { out = out.append(wr) }
      } else {
         def access = op == "assign" ? "write" : (op == "call" ? "execute" : "read")
         def m = _fact_mem_access(row, row.get("dst", ""), access)
         if m.len > 0 { out = out.append(m) }
      }
   }
   if row.get("src_kind", "") == "mem" {
      def m = _fact_mem_access(row, row.get("src", ""), "read")
      if m.len > 0 { out = out.append(m) }
   }
   if row.get("src2_kind", "") == "mem" {
      def m = _fact_mem_access(row, row.get("src2", ""), "read")
      if m.len > 0 { out = out.append(m) }
   }
   out
}

fn _int_insert_sorted_unique(list xs, int value) list {
   if _list_has(xs, value) { return xs }
   mut out = []
   mut inserted = false
   mut i = 0
   while i < xs.len {
      if !inserted && value < int(xs[i]) {
         out = out.append(value)
         inserted = true
      }
      out = out.append(xs[i])
      i += 1
   }
   if !inserted { out = out.append(value) }
   out
}

fn _gcd_int(int a0, int b0) int {
   mut a = _iabs(a0)
   mut b = _iabs(b0)
   while b != 0 {
      def t = a - (a / b) * b
      a = b
      b = t
   }
   a
}

fn _offset_stride(list offsets) int {
   if offsets.len < 2 { return 0 }
   mut g = 0
   mut i = 1
   while i < offsets.len {
      def d = _iabs(int(offsets[i]) - int(offsets[i - 1]))
      if d > 0 { g = g == 0 ? d : _gcd_int(g, d) }
      i += 1
   }
   g
}

fn _fact_shape_kind(dict group) str {
   if group.get("index", "").len > 0 { return "strided_array" }
   if group.get("offsets", []).len > 1 { return "struct_like" }
   "scalar_slot"
}

fn _fact_memory_shapes(list mems) list {
   mut groups = dict()
   mut i = 0
   while i < mems.len {
      def m = mems[i]
      def key = m.get("segment", "") + "|" + m.get("base", "") + "|" + m.get("index", "") + "|" + to_str(int(m.get("scale", 0)))
      mut g = groups.get(key, {"key": key, "segment": m.get("segment", ""), "base": m.get("base", ""),
            "index": m.get("index", ""), "scale": int(m.get("scale", 0)), "accesses": [],
            "offsets": [], "widths": [], "read_count": 0, "write_count": 0, "execute_count": 0})
      g = g.set("accesses", g.get("accesses", []).append(m))
      g = g.set("offsets", _int_insert_sorted_unique(g.get("offsets", []), int(m.get("offset", 0))))
      def w = int(m.get("width", 0))
      if w > 0 { g = g.set("widths", _int_insert_sorted_unique(g.get("widths", []), w)) }
      def access = m.get("access", "")
      if access == "read" { g = g.set("read_count", int(g.get("read_count", 0)) + 1) }
      elif access == "write" { g = g.set("write_count", int(g.get("write_count", 0)) + 1) }
      elif access == "execute" { g = g.set("execute_count", int(g.get("execute_count", 0)) + 1) }
      groups = groups.set(key, g)
      i += 1
   }
   mut out = []
   def keys = groups.keys()
   i = 0
   while i < keys.len {
      mut g = groups.get(keys[i], dict())
      def offsets = g.get("offsets", [])
      def widths = g.get("widths", [])
      def min_off = offsets.len > 0 ? int(offsets[0]) : 0
      def max_off = offsets.len > 0 ? int(offsets[offsets.len - 1]) : 0
      def max_width = widths.len > 0 ? int(widths[widths.len - 1]) : 0
      g = g.set("kind", _fact_shape_kind(g)).set("access_count", g.get("accesses", []).len)
      .set("min_offset", min_off).set("max_offset", max_off)
      .set("stride", _offset_stride(offsets)).set("span", max_off - min_off + max_width)
      out = out.append(g)
      i += 1
   }
   out
}

fn _ssa_value_id(str sym, int version) str {
   sym + "#" + to_str(version)
}

fn _facts_of_kind(dict bundle, str kind) list {
   def xs = bundle.get("facts", [])
   mut out = []
   mut i = 0
   while i < xs.len {
      if xs[i].get("kind", "") == kind { out = out.append(xs[i]) }
      i += 1
   }
   out
}

fn _ssa_ensure_livein(dict st, str sym) dict {
   if sym.len == 0 { return st }
   def cur = st.get("current", dict())
   if cur.contains(sym) { return st }
   def id = _ssa_value_id(sym, 0)
   mut values = st.get("values", [])
   values = values.append({"id": id, "symbol": sym, "version": 0, "kind": "live_in",
         "row": -1, "addr": 0, "mnemonic": ""})
   st.set("values", values).set("current", cur.set(sym, id)).set("versions", st.get("versions", dict()).set(sym, 0))
}

fn _ssa_block_for_addr(dict graph, int addr) int {
   def nodes = graph.get("nodes", [])
   mut fallback = int(graph.get("entry", 0))
   mut i = 0
   while i < nodes.len {
      def n = nodes[i]
      def start = int(n.get("addr", 0))
      def end = int(n.get("end", start))
      if i == 0 { fallback = start }
      if addr >= start && (end <= start || addr < end) { return start }
      i += 1
   }
   fallback
}

fn _ssa_row_blocks(list rows, dict graph) list {
   mut out = []
   mut i = 0
   while i < rows.len {
      out = out.append(_ssa_block_for_addr(graph, int(rows[i].get("addr", 0))))
      i += 1
   }
   out
}

fn _ssa_first_row_for_block(list row_blocks, int block) int {
   mut i = 0
   while i < row_blocks.len {
      if int(row_blocks[i]) == block { return i }
      i += 1
   }
   -1
}

fn _ssa_def_blocks(dict bundle, list row_blocks) dict {
   mut out = dict()
   def defs = _facts_of_kind(bundle, "defines")
   mut i = 0
   while i < defs.len {
      def d = defs[i]
      def sym = d.get("symbol", "")
      def row = int(d.get("row", -1))
      if sym.len > 0 && row >= 0 && row < row_blocks.len {
         out = out.set(sym, _append_unique(out.get(sym, []), int(row_blocks[row])))
      }
      i += 1
   }
   out
}

fn _ssa_symbols_by_row(dict bundle, str kind) dict {
   mut out = dict()
   def xs = _facts_of_kind(bundle, kind)
   mut i = 0
   while i < xs.len {
      def row = int(xs[i].get("row", -1))
      def sym = xs[i].get("symbol", "")
      if row >= 0 && sym.len > 0 {
         out = out.set(to_str(row), _append_unique(out.get(to_str(row), []), sym))
      }
      i += 1
   }
   out
}

fn _ssa_place_phis(dict bundle, list row_blocks, dict frontiers) list {
   def def_blocks = _ssa_def_blocks(bundle, row_blocks)
   def syms = def_blocks.keys()
   mut phis = []
   mut has_phi = dict()
   mut si = 0
   while si < syms.len {
      def sym = syms[si]
      mut work = def_blocks.get(sym, [])
      mut wi = 0
      while wi < work.len {
         def b = int(work[wi])
         def fs = frontiers.get(to_str(b), [])
         mut fi = 0
         while fi < fs.len {
            def y = int(fs[fi])
            def key = sym + "@" + to_str(y)
            if !has_phi.get(key, false) {
               has_phi = has_phi.set(key, true)
               phis = phis.append({"symbol": sym, "block": y,
                     "row": _ssa_first_row_for_block(row_blocks, y), "kind": "phi"})
               if !_list_has(def_blocks.get(sym, []), y) { work = work.append(y) }
            }
            fi += 1
         }
         wi += 1
      }
      si += 1
   }
   phis
}

fn _ssa_phis_for_block(list phis, int block) list {
   mut out = []
   mut i = 0
   while i < phis.len {
      if int(phis[i].get("block", 0)) == block { out = out.append(phis[i]) }
      i += 1
   }
   out
}

fn _ssa_phi_key(dict p) str {
   p.get("symbol", "") + "@" + to_str(int(p.get("block", 0)))
}

fn _ssa_dom_children(list nodes, dict idom) dict {
   mut out = dict()
   mut i = 0
   while i < nodes.len {
      out = out.set(to_str(int(nodes[i])), [])
      i += 1
   }
   i = 0
   while i < nodes.len {
      def n = int(nodes[i])
      def parent = int(idom.get(to_str(n), 0))
      if parent != 0 {
         out = out.set(to_str(parent), _append_unique(out.get(to_str(parent), []), n))
      }
      i += 1
   }
   out
}

fn _ssa_rows_for_block(list row_blocks, int block) list {
   mut out = []
   mut i = 0
   while i < row_blocks.len {
      if int(row_blocks[i]) == block { out = out.append(i) }
      i += 1
   }
   out
}

fn _ssa_ensure_livein_value(dict st, dict current, str sym) dict {
   if sym.len == 0 { return {"state": st, "current": current, "id": ""} }
   if current.contains(sym) { return {"state": st, "current": current, "id": current.get(sym, "")} }
   def id = _ssa_value_id(sym, 0)
   mut values = st.get("values", [])
   mut versions = st.get("versions", dict())
   mut liveins = st.get("liveins", dict())
   if !liveins.get(sym, false) {
      values = values.append({"id": id, "symbol": sym, "version": 0, "kind": "live_in",
            "row": -1, "addr": 0, "mnemonic": ""})
      liveins = liveins.set(sym, true)
   }
   if !versions.contains(sym) { versions = versions.set(sym, 0) }
   {"state": st.set("values", values).set("versions", versions).set("liveins", liveins),
      "current": current.set(sym, id), "id": id}
}

fn _ssa_phi_incoming(list phis, dict graph, dict exit_current) list {
   mut out = []
   mut i = 0
   while i < phis.len {
      def p = phis[i]
      def sym = p.get("symbol", "")
      def block = int(p.get("block", 0))
      def preds = _cfg_predecessors(graph, block)
      mut incoming = []
      mut pi = 0
      while pi < preds.len {
         def pred = int(preds[pi])
         def cur = exit_current.get(to_str(pred), dict())
         mut value = cur.get(sym, "")
         if value.len == 0 { value = _ssa_value_id(sym, 0) }
         incoming = incoming.append({"block": pred, "value": value})
         pi += 1
      }
      out = out.append(p.set("incoming", incoming).set("incoming_count", incoming.len))
      i += 1
   }
   out
}

fn _ssa_from_facts(dict bundle) dict {
   def rows = bundle.get("rows", [])
   def graph = bundle.get("cfg", dict())
   def target = bundle.get("target", 0)
   def dominfo = _cfg_dominators_for_graph(graph)
   def dfinfo = _cfg_dominance_frontiers_for_graph(graph, dominfo)
   def idom = dfinfo.get("idominators", dict())
   def frontiers = dfinfo.get("frontiers", dict())
   def row_blocks = _ssa_row_blocks(rows, graph)
   def placed_phis = _ssa_place_phis(bundle, row_blocks, frontiers)
   def row_uses_map = _ssa_symbols_by_row(bundle, "uses")
   def row_defs_map = _ssa_symbols_by_row(bundle, "defines")
   mut st = {"versions": dict(), "values": [], "liveins": dict()}
   mut defs = []
   mut phi_defs = []
   mut uses = []
   mut deps = []
   mut by_value = dict()
   mut row_values = []
   mut exit_current = dict()
   mut phi_ids = dict()
   def nodes = dominfo.get("nodes", _cfg_nodes_addrs(graph))
   def dom_children = _ssa_dom_children(nodes, idom)
   def entry = int(dominfo.get("entry", nodes.len > 0 ? nodes[0] : 0))
   mut work = entry != 0 ? [{"block": entry, "current": dict()}] : []
   mut seen_blocks = dict()
   while work.len > 0 {
      def frame = work.pop()
      def block = int(frame.get("block", 0))
      if seen_blocks.get(to_str(block), false) { continue }
      seen_blocks = seen_blocks.set(to_str(block), true)
      mut current = frame.get("current", dict())
      def bphis = _ssa_phis_for_block(placed_phis, block)
      mut pi = 0
      while pi < bphis.len {
         def p0 = bphis[pi]
         def sym = p0.get("symbol", "")
         def next_version = int(st.get("versions", dict()).get(sym, 0)) + 1
         def id = _ssa_value_id(sym, next_version)
         def first_row = int(p0.get("row", -1))
         def addr = first_row >= 0 && first_row < rows.len ? int(rows[first_row].get("addr", block)) : block
         def rec = {"id": id, "symbol": sym, "version": next_version, "row": first_row,
            "addr": addr, "block": block, "mnemonic": "phi", "operand": "",
            "kind": "phi", "source": "dominance_frontier"}
         defs = defs.append(rec)
         phi_defs = phi_defs.append(rec)
         st = st.set("versions", st.get("versions", dict()).set(sym, next_version))
         .set("values", st.get("values", []).append(rec))
         current = current.set(sym, id)
         by_value = by_value.set(id, by_value.get(id, {"id": id, "defs": [], "uses": []})
            .set("defs", by_value.get(id, {"defs": []}).get("defs", []).append(rec)))
         phi_ids = phi_ids.set(_ssa_phi_key(p0), id)
         pi += 1
      }
      def block_rows = _ssa_rows_for_block(row_blocks, block)
      mut bri = 0
      while bri < block_rows.len {
         def i = int(block_rows[bri])
         if i >= 0 && i < rows.len {
            def row = _slice_row(rows[i]).set("index", i)
            mut row_uses = []
            def ruses = row_uses_map.get(to_str(i), [])
            mut ui = 0
            while ui < ruses.len {
               def symb = to_str(ruses[ui])
               def live = _ssa_ensure_livein_value(st, current, symb)
               st = live.get("state", st)
               current = live.get("current", current)
               def id = live.get("id", current.get(symb, _ssa_value_id(symb, 0)))
               def rec = {"id": id, "symbol": symb, "row": i, "addr": int(row.get("addr", 0)),
                  "block": block, "mnemonic": row.get("mnemonic", ""), "operand": row.get("operands", "")}
               uses = uses.append(rec)
               row_uses = _append_unique(row_uses, id)
               by_value = by_value.set(id, by_value.get(id, {"id": id, "defs": [], "uses": []})
                  .set("uses", by_value.get(id, {"uses": []}).get("uses", []).append(rec)))
               ui += 1
            }
            mut row_defs = []
            def rdefs = row_defs_map.get(to_str(i), [])
            mut di = 0
            while di < rdefs.len {
               def symb = to_str(rdefs[di])
               def next_version = int(st.get("versions", dict()).get(symb, 0)) + 1
               def id = _ssa_value_id(symb, next_version)
               def rec = {"id": id, "symbol": symb, "version": next_version, "row": i,
                  "addr": int(row.get("addr", 0)), "block": block, "mnemonic": row.get("mnemonic", ""),
                  "operand": row.get("operands", ""), "kind": "row_def"}
               defs = defs.append(rec)
               row_defs = row_defs.append(id)
               st = st.set("versions", st.get("versions", dict()).set(symb, next_version))
               .set("values", st.get("values", []).append(rec))
               current = current.set(symb, id)
               by_value = by_value.set(id, by_value.get(id, {"id": id, "defs": [], "uses": []})
                  .set("defs", by_value.get(id, {"defs": []}).get("defs", []).append(rec)))
               mut ri = 0
               while ri < row_uses.len {
                  deps = deps.append({"from": row_uses[ri], "to": id, "row": i,
                        "addr": int(row.get("addr", 0)), "block": block, "kind": "row_dependency"})
                  ri += 1
               }
               di += 1
            }
            row_values = row_values.append({"row": i, "addr": int(row.get("addr", 0)),
                  "block": block, "uses": row_uses, "defs": row_defs})
         }
         bri += 1
      }
      exit_current = exit_current.set(to_str(block), current)
      def children = dom_children.get(to_str(block), [])
      mut ci = children.len - 1
      while ci >= 0 {
         work = work.append({"block": int(children[ci]), "current": current})
         ci -= 1
      }
   }
   mut ni = 0
   while ni < nodes.len {
      def n = int(nodes[ni])
      if !seen_blocks.get(to_str(n), false) {
         work = work.append({"block": n, "current": dict()})
         while work.len > 0 {
            def frame = work.pop()
            def block = int(frame.get("block", 0))
            if seen_blocks.get(to_str(block), false) { continue }
            seen_blocks = seen_blocks.set(to_str(block), true)
            exit_current = exit_current.set(to_str(block), frame.get("current", dict()))
         }
      }
      ni += 1
   }
   mut phis = _ssa_phi_incoming(placed_phis, graph, exit_current)
   mut pi = 0
   while pi < phis.len {
      def p = phis[pi]
      def id = phi_ids.get(_ssa_phi_key(p), "")
      if id.len > 0 { phis = phis.set(pi, p.set("id", id)) }
      pi += 1
   }
   pi = 0
   while pi < phis.len {
      def p = phis[pi]
      def id = p.get("id", "")
      def incoming = p.get("incoming", [])
      mut ii = 0
      while ii < incoming.len {
         def from_id = incoming[ii].get("value", "")
         if id.len > 0 && from_id.len > 0 {
            deps = deps.append({"from": from_id, "to": id, "block": int(p.get("block", 0)),
                  "pred": int(incoming[ii].get("block", 0)), "kind": "phi_incoming"})
         }
         ii += 1
      }
      pi += 1
   }
   {"kind": "ssa", "target": target, "scope": "global_cfg", "input": "facts",
      "input_surface": "facts(...)", "fact_count_input": bundle.get("facts", []).len,
      "note": "CFG-aware SSA from facts(...): phi records are placed with dominance frontiers and renamed through the dominator tree.",
      "values": st.get("values", []), "defs": defs, "uses": uses, "deps": deps,
      "phis": phis, "phi_defs": phi_defs, "phi_count": phis.len,
      "by_value": by_value, "rows": row_values, "row_blocks": row_blocks,
      "dominators": dominfo, "idominators": idom, "dom_children": dom_children,
      "dominance_frontiers": frontiers, "exit_values": exit_current,
      "value_count": st.get("values", []).len, "def_count": defs.len,
      "use_count": uses.len, "dep_count": deps.len}
}

fn _ssa_from_rows(list rows, any target=0) dict {
   mut st = {"versions": dict(), "current": dict(), "values": []}
   mut defs = []
   mut uses = []
   mut deps = []
   mut by_value = dict()
   mut row_values = []
   mut i = 0
   while i < rows.len {
      def row = _slice_row(rows[i]).set("index", i)
      mut row_uses = []
      def ruses = row.get("uses", [])
      mut ui = 0
      while ui < ruses.len {
         def symb = to_str(ruses[ui])
         st = _ssa_ensure_livein(st, symb)
         def id = st.get("current", dict()).get(symb, _ssa_value_id(symb, 0))
         def rec = {"id": id, "symbol": symb, "row": i, "addr": int(row.get("addr", 0)),
            "mnemonic": row.get("mnemonic", ""), "operand": row.get("operands", "")}
         uses = uses.append(rec)
         row_uses = _append_unique(row_uses, id)
         by_value = by_value.set(id, by_value.get(id, {"id": id, "defs": [], "uses": []})
            .set("uses", by_value.get(id, {"uses": []}).get("uses", []).append(rec)))
         ui += 1
      }
      mut row_defs = []
      def rdefs = row.get("defs", [])
      mut di = 0
      while di < rdefs.len {
         def symb = to_str(rdefs[di])
         def next_version = int(st.get("versions", dict()).get(symb, 0)) + 1
         def id = _ssa_value_id(symb, next_version)
         def rec = {"id": id, "symbol": symb, "version": next_version, "row": i,
            "addr": int(row.get("addr", 0)), "mnemonic": row.get("mnemonic", ""),
            "operand": row.get("operands", ""), "kind": "row_def"}
         defs = defs.append(rec)
         row_defs = row_defs.append(id)
         st = st.set("versions", st.get("versions", dict()).set(symb, next_version))
         .set("current", st.get("current", dict()).set(symb, id))
         .set("values", st.get("values", []).append(rec))
         by_value = by_value.set(id, by_value.get(id, {"id": id, "defs": [], "uses": []})
            .set("defs", by_value.get(id, {"defs": []}).get("defs", []).append(rec)))
         mut ri = 0
         while ri < row_uses.len {
            deps = deps.append({"from": row_uses[ri], "to": id, "row": i,
                  "addr": int(row.get("addr", 0)), "kind": "row_dependency"})
            ri += 1
         }
         di += 1
      }
      row_values = row_values.append({"row": i, "addr": int(row.get("addr", 0)),
            "uses": row_uses, "defs": row_defs})
      i += 1
   }
   {"kind": "ssa", "target": target, "scope": "linear_function",
      "note": "legacy row-local helper; public ssa(...) uses facts-driven global_cfg SSA",
      "values": st.get("values", []), "defs": defs, "uses": uses, "deps": deps,
      "by_value": by_value, "rows": row_values, "value_count": st.get("values", []).len,
      "def_count": defs.len, "use_count": uses.len, "dep_count": deps.len}
}

fn ssa(any source, any target=0, any opts=dict()) dict {
   "Return CFG-aware SSA over facts(...).
   `facts(...)` is the single input surface: rows, CFG edges, defs, and uses are
   read from the fact bundle, then dominance-frontier phi records are added at
   join blocks."
   if is_dict(source) && source.get("kind", "") == "facts" { return _ssa_from_facts(source) }
   def f = facts(source, target, opts)
   if f.contains("ssa") { return f.get("ssa", dict()) }
   _ssa_from_facts(f)
}

fn _vsa_shape_class(dict sh) str {
   if sh.get("index", "").len > 0 { return "indexed_memory" }
   def offsets = sh.get("offsets", [])
   def stride = int(sh.get("stride", 0))
   def widths = sh.get("widths", [])
   def max_width = widths.len > 0 ? int(widths[widths.len - 1]) : 0
   if stride == 1 && max_width <= 1 && offsets.len > 1 { return "byte_slice" }
   if offsets.len >= 3 && stride > 0 { return "strided_offset_cluster" }
   if offsets.len > 1 { return "struct_offset_cluster" }
   "single_memory_slot"
}

fn _vsa_shape_confidence(dict sh, str cls) int {
   def accesses = int(sh.get("access_count", 0))
   def offsets = sh.get("offsets", [])
   if cls == "indexed_memory" { return min(95, 70 + min(20, accesses * 4)) }
   if cls == "strided_offset_cluster" { return min(92, 68 + min(18, offsets.len * 4)) }
   if cls == "struct_offset_cluster" { return min(88, 62 + min(20, offsets.len * 5)) }
   if cls == "byte_slice" { return min(90, 64 + min(20, offsets.len * 3)) }
   min(55, 35 + min(20, accesses * 5))
}

fn _vsa_shape_role(str cls) str {
   case cls {
      "indexed_memory" -> "array"
      "strided_offset_cluster" -> "array_or_struct"
      "struct_offset_cluster" -> "struct"
      "byte_slice" -> "byte_slice"
      _ -> "scalar"
   }
}

fn _vsa_shape_fields(dict sh) list {
   def offsets = sh.get("offsets", [])
   def widths = sh.get("widths", [])
   mut fields = []
   mut i = 0
   while i < offsets.len {
      def off = int(offsets[i])
      def width = widths.len > 0 ? int(widths[min(i, widths.len - 1)]) : 0
      fields = fields.append({"name": "field_" + str.to_hex(off, 0), "offset": off,
            "width": width, "read_count": int(sh.get("read_count", 0)),
            "write_count": int(sh.get("write_count", 0))})
      i += 1
   }
   fields
}

fn _vsa_symbol_key(dict row, str op0) str {
   def family = row.get("family", _rows_family([row]))
   def canon = _canonical_value_reg(family, op0)
   if canon.len > 0 { return canon }
   str.lower(_ny_operand(op0))
}

fn _vsa_interval_record(dict row, str symbol, int lower, int upper, int stride, str cls, str source) dict {
   {"symbol": symbol, "row": int(row.get("index", -1)), "addr": int(row.get("addr", 0)),
      "lower": lower, "upper": upper, "stride": stride, "classification": cls,
      "role": cls == "mask_bound" ? "bounded_integer" : (cls == "constant" ? "constant" : "integer_interval"),
      "source": source, "kind": "vsa_value",
      "notation": to_str(stride) + "[" + to_str(lower) + "," + to_str(upper) + "]"}
}

fn _vsa_shift_interval(dict prev, int delta, dict row, str symbol, str source) dict {
   _vsa_interval_record(row, symbol,
      int(prev.get("lower", 0)) + delta, int(prev.get("upper", 0)) + delta,
      int(prev.get("stride", 0)), "affine_interval", source)
}

fn _vsa_value_intervals(list rows) list {
   mut env = dict()
   mut out = []
   mut i = 0
   while i < rows.len {
      def row = rows[i]
      def op = row.get("op", "")
      if (op == "assign" || op == "arith") && row.get("dst_kind", "") == "reg" {
         def key = _vsa_symbol_key(row, row.get("dst", ""))
         if key.len > 0 {
            if op == "assign" && row.get("src_kind", "") == "imm" {
               def value = _imm_number(row.get("src", "0"))
               def rec = _vsa_interval_record(row, key, value, value, 0, "constant", "imm_assign")
               env = env.set(key, rec)
               out = out.append(rec)
            } elif op == "assign" && row.get("src_kind", "") == "reg" {
               def src_key = _vsa_symbol_key(row, row.get("src", ""))
               if env.get(src_key, dict()).len > 0 {
                  def prev = env.get(src_key, dict()).set("symbol", key).set("row", int(row.get("index", -1)))
                  .set("addr", int(row.get("addr", 0))).set("source", "copy")
                  env = env.set(key, prev)
                  out = out.append(prev)
               }
            } elif op == "arith" && row.get("src_kind", "") == "imm" {
               def sym = row.get("operator", "")
               def imm = _imm_number(row.get("src", "0"))
               if sym == "&" && imm >= 0 {
                  def rec = _vsa_interval_record(row, key, 0, imm, 1, "mask_bound", "and_mask")
                  env = env.set(key, rec)
                  out = out.append(rec)
               } elif (sym == "+" || sym == "-") && env.get(key, dict()).len > 0 {
                  def delta = sym == "+" ? imm : -imm
                  def shifted = _vsa_shift_interval(env.get(key, dict()), delta, row, key, sym == "+" ? "add_imm" : "sub_imm")
                  env = env.set(key, shifted)
                  out = out.append(shifted)
               } elif sym == "|" && env.get(key, dict()).len > 0 {
                  env = env
               } else {
                  env = env.set(key, dict())
               }
            } elif op == "arith" && row.get("kind", "") == "zeroing_idiom" {
               def rec = _vsa_interval_record(row, key, 0, 0, 0, "constant", "zeroing_idiom")
               env = env.set(key, rec)
               out = out.append(rec)
            } else {
               env = env.set(key, dict())
            }
         }
      }
      i += 1
   }
   out
}

fn _vsa_from_shapes(list shapes, any target=0) dict {
   mut intervals = []
   mut i = 0
   while i < shapes.len {
      def sh = shapes[i]
      def offsets = sh.get("offsets", [])
      def min_off = int(sh.get("min_offset", offsets.len > 0 ? offsets[0] : 0))
      def max_off = int(sh.get("max_offset", offsets.len > 0 ? offsets[offsets.len - 1] : 0))
      def stride = int(sh.get("stride", 0))
      def widths = sh.get("widths", [])
      def max_width = widths.len > 0 ? int(widths[widths.len - 1]) : 0
      def elems = stride > 0 ? ((max_off - min_off) / stride) + 1 : max(1, offsets.len)
      def cls = _vsa_shape_class(sh)
      intervals = intervals.append({"base": sh.get("base", ""), "index": sh.get("index", ""),
            "scale": int(sh.get("scale", 0)), "segment": sh.get("segment", ""),
            "lower": min_off, "upper": max_off, "stride": stride, "element_count": elems,
            "width": max_width, "span": int(sh.get("span", max_off - min_off + max_width)),
            "classification": cls, "role": _vsa_shape_role(cls), "shape_id": "memshape_" + to_str(i),
            "confidence": _vsa_shape_confidence(sh, cls), "fields": _vsa_shape_fields(sh),
            "source": sh.get("kind", ""),
            "read_count": int(sh.get("read_count", 0)), "write_count": int(sh.get("write_count", 0)),
            "access_count": int(sh.get("access_count", 0)),
            "notation": to_str(stride) + "[" + to_str(min_off) + "," + to_str(max_off) + "]"})
      i += 1
   }
   {"kind": "vsa", "target": target, "intervals": intervals, "interval_count": intervals.len,
      "note": "strided interval seed over recovered memory shapes"}
}

fn _vsa_from_rows(list rows, list shapes, any target=0) dict {
   def base = _vsa_from_shapes(shapes, target)
   def values = _vsa_value_intervals(rows)
   base.set("value_intervals", values).set("value_interval_count", values.len)
   .set("note", "strided memory intervals plus conservative row-local value sets")
}

fn vsa(any source, any target=0, any opts=dict()) dict {
   "Return a strided-interval value-set seed for memory accesses.
   This is deliberately conservative: it groups proven address expressions and
   offset clusters so struct/array/slice recovery can use data instead of
   renderer patterns."
   def max_bytes = int(is_dict(opts) ? opts.get("max_bytes", 1024) : (is_int(opts) ? opts : 1024))
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def rows = lift(bin, target, max_bytes)
   mut mems = []
   mut i = 0
   while i < rows.len {
      mems = _fact_row_memory(mems, _slice_row(rows[i]).set("index", i))
      i += 1
   }
   _vsa_from_rows(rows, _fact_memory_shapes(mems), target)
}

fn _branch_dependencies(list rows) list {
   mut out = []
   mut i = 0
   while i < rows.len {
      def row = rows[i]
      if row.get("op", "") == "branch" && row.get("condition", "") != "always" {
         def cond = row.get("condition", "")
         def expr = _branch_condition_expr(rows, i, cond)
         mut found = false
         mut j = i - 1
         while j >= 0 && i - j <= 8 && !found {
            def prev = rows[j]
            def pop = prev.get("op", "")
            if pop == "call" || pop == "branch" || pop == "syscall" || pop == "return" {
               j = -1
            } elif pop == "compare" || pop == "arith" {
               out = out.append({"row": i, "addr": int(row.get("addr", 0)), "target": int(row.get("target", 0)),
                     "condition": cond, "expr": expr, "feeder_row": j, "feeder_addr": int(prev.get("addr", 0)),
                     "feeder_op": pop, "feeder_mnemonic": prev.get("mnemonic", ""),
                     "feeder_defs": prev.get("defs", []), "feeder_uses": prev.get("uses", [])})
               found = true
            }
            j -= 1
         }
         if !found && row.get("uses", []).len > 0 {
            out = out.append({"row": i, "addr": int(row.get("addr", 0)), "target": int(row.get("target", 0)),
                  "condition": cond, "expr": expr, "feeder_row": i, "feeder_addr": int(row.get("addr", 0)),
                  "feeder_op": "branch", "feeder_mnemonic": row.get("mnemonic", ""),
                  "feeder_defs": row.get("defs", []), "feeder_uses": row.get("uses", [])})
         }
      }
      i += 1
   }
   out
}

fn _fact_condition_role(str expr) str {
   if str.find(expr, "argv[") >= 0 { return "argv_gate" }
   if str.find(expr, "local_") >= 0 || str.find(expr, "&local_") >= 0 { return "stack_gate" }
   if str.find(expr, "[") >= 0 { return "memory_gate" }
   if str.find(expr, "(") >= 0 && str.find(expr, ")") >= 0 { return "call_or_helper_gate" }
   "scalar_gate"
}

fn _fact_branch_conditions(dict bin, any target, list rows) list {
   if rows.len == 0 { return [] }
   def start = int(rows[0].get("addr", 0))
   def end = int(rows[rows.len - 1].get("addr", start)) + int(rows[rows.len - 1].get("size", 1))
   def maxb = max(32, end - start)
   def name = _name_for_addr(bin, start)
   def sig = _signature_main_aliases(_function_signature_for(bin, target, rows, start, maxb), name)
   mut out = []
   mut i = 0
   while i < rows.len {
      def row = rows[i]
      if row.get("op", "") == "branch" && row.get("condition", "") != "always" {
         def cond = row.get("condition", "")
         def raw = _branch_condition_expr(rows, i, cond)
         mut clean = _clean_branch_condition_expr_sig(bin, sig, rows, i, cond)
         clean = _clean_simplify_mba_expr(clean)
         def fallthrough = i + 1 < rows.len ? int(rows[i + 1].get("addr", 0)) : 0
         out = out.append({"row": i, "addr": int(row.get("addr", 0)),
               "target": int(row.get("target", 0)), "fallthrough": fallthrough,
               "condition": cond, "raw_expr": raw, "expr": clean,
               "taken_when": clean, "fallthrough_when": _clean_negated_condition_expr(clean),
               "role": _fact_condition_role(clean), "symbols": _symbols_from_text(clean),
               "kind": "condition"})
      }
      i += 1
   }
   out
}

fn _ssa_use_counts(dict ssa0) dict {
   mut out = dict()
   def uses = ssa0.get("uses", [])
   mut i = 0
   while i < uses.len {
      def id = uses[i].get("id", "")
      if id.len > 0 { out = out.set(id, int(out.get(id, 0)) + 1) }
      i += 1
   }
   out
}

fn _row_by_index(list rows, int idx) dict {
   if idx < 0 || idx >= rows.len { return dict() }
   rows[idx]
}

fn _row_pure_rewrite_candidate(dict row) bool {
   def op = row.get("op", "")
   if !(op == "assign" || op == "arith" || op == "compare") { return false }
   if row.get("dst_kind", "") == "mem" { return false }
   if row.get("src_kind", "") == "mem" && op != "compare" { return false }
   true
}

fn _ssa_rewrite_candidates(list rows, dict ssa0) dict {
   def counts = _ssa_use_counts(ssa0)
   def defs = ssa0.get("defs", [])
   mut dead = []
   mut inline = []
   mut i = 0
   while i < defs.len {
      def d = defs[i]
      def id = d.get("id", "")
      def row = _row_by_index(rows, int(d.get("row", -1)))
      def uses = int(counts.get(id, 0))
      if uses == 0 {
         dead = dead.append({"id": id, "symbol": d.get("symbol", ""), "row": int(d.get("row", -1)),
               "addr": int(d.get("addr", 0)), "mnemonic": d.get("mnemonic", ""),
               "reason": "ssa value has no recorded use in this function"})
      } elif uses == 1 && _row_pure_rewrite_candidate(row) {
         inline = inline.append({"id": id, "symbol": d.get("symbol", ""), "row": int(d.get("row", -1)),
               "addr": int(d.get("addr", 0)), "mnemonic": d.get("mnemonic", ""),
               "reason": "pure row value has one recorded use"})
      }
      i += 1
   }
   {"kind": "rewrite_candidates", "dead_defs": dead, "inline_values": inline,
      "dead_count": dead.len, "inline_count": inline.len}
}

fn smt_expression_proofs(any source, any target=0, any opts=dict()) dict {
   "Prove expression archetype mappings using Z3 bitvectors.
   The input is always a facts(...) bundle: callers may pass one directly, or
   this helper will build facts(...) and then prove division, remainder masks,
   endian-aware byte packing, byte masks, rotations, and width-wrapped constants
   against Z3 AST equivalents."
   if is_dict(source) && source.get("kind", "") == "facts" { return _smt_expression_proofs_from_facts(source, opts) }
   _smt_expression_proofs_from_facts(facts(source, target, opts), opts)
}

fn _smt_proof_for(list proofs, str archetype) dict {
   mut i = 0
   while i < proofs.len {
      if proofs[i].get("archetype", "") == archetype { return proofs[i] }
      i += 1
   }
   dict()
}

fn _smt_proof_ok(list proofs, str archetype) bool {
   _smt_proof_for(proofs, archetype).get("proved", false)
}

fn _semantic_rewrite_record(list proofs, str archetype, dict row, str source_expr, str replacement, str reason, list consumes=[]) dict {
   def proof = _smt_proof_for(proofs, archetype)
   {"kind": "semantic_simplification", "proved": proof.get("proved", false),
      "archetype": archetype, "proof": archetype, "proof_method": proof.get("method", ""),
      "row": int(row.get("index", -1)), "addr": int(row.get("addr", 0)),
      "mnemonic": row.get("mnemonic", ""), "source_expr": source_expr,
      "replacement": replacement, "reason": reason, "confidence": proof.get("proved", false) ? 100 : 0,
      "constraint_count": int(proof.get("constraint_count", 0)), "consumes": consumes}
}

fn _semantic_base_before(list rows, int before_idx, str op0, int depth=0) str {
   if depth > 4 { return _ny_operand(op0) }
   def idx = _clean_prev_def_row(rows, before_idx, op0)
   if idx < 0 { return _ny_operand(op0) }
   def r = rows[idx]
   def op = r.get("op", "")
   if op == "assign" {
      if r.get("kind", "") == "lea" { return r.get("addr_expr", "").len > 0 ? r.get("addr_expr", "") : _ny_address_operand(r.get("src", "")) }
      return _semantic_base_before(rows, idx - 1, r.get("src", ""), depth + 1)
   }
   if op == "arith" && r.get("operator", "") == "=" { return _semantic_base_before(rows, idx - 1, r.get("src", ""), depth + 1) }
   _ny_operand(r.get("dst", op0))
}

fn _semantic_shift_arm(list rows, int before_idx, str op0) dict {
   def idx = _clean_prev_def_row(rows, before_idx, op0)
   if idx < 0 { return dict() }
   def r = rows[idx]
   if r.get("op", "") != "arith" { return dict() }
   def dir = r.get("operator", "")
   if dir != "<<" && dir != ">>" { return dict() }
   if _operand_kind(r.get("src", "")) != "imm" { return dict() }
   def amount = _imm_number(r.get("src", ""))
   def bits = _clean_operand_bits(r.get("dst", ""))
   if amount <= 0 || bits <= 0 || amount >= bits { return dict() }
   {"ok": true, "row": idx, "dir": dir, "amount": amount, "bits": bits,
      "base": _semantic_base_before(rows, idx - 1, r.get("dst", ""))}
}

fn _semantic_rotate_or_candidate(list rows, int idx) dict {
   if idx < 0 || idx >= rows.len { return dict() }
   def r = rows[idx]
   if r.get("op", "") != "arith" || r.get("operator", "") != "|" { return dict() }
   def a = _semantic_shift_arm(rows, idx - 1, r.get("dst", ""))
   def b = _semantic_shift_arm(rows, idx - 1, r.get("src", ""))
   if !a.get("ok", false) || !b.get("ok", false) { return dict() }
   if a.get("dir", "") == b.get("dir", "") { return dict() }
   if int(a.get("bits", 0)) != int(b.get("bits", 0)) { return dict() }
   if !_clean_same_expr(a.get("base", ""), b.get("base", "")) { return dict() }
   def bits = int(a.get("bits", 0))
   def la = a.get("dir", "") == "<<" ? int(a.get("amount", 0)) : int(b.get("amount", 0))
   def ra = a.get("dir", "") == ">>" ? int(a.get("amount", 0)) : int(b.get("amount", 0))
   if la <= 0 || ra <= 0 || la + ra != bits { return dict() }
   def arch = la <= ra ? "rotate_left" : "rotate_right"
   def amt = la <= ra ? la : ra
   {"ok": true, "archetype": arch, "replacement": (arch == "rotate_left" ? "rol" : "ror") + "(" + a.get("base", "") + ", " + to_str(amt) + ")",
      "consumes": [int(a.get("row", -1)), int(b.get("row", -1)), idx]}
}

fn _semantic_pack_terms(list rows, int before_idx, str op0, int depth=0) list {
   if depth > 8 { return [] }
   def idx = _clean_prev_def_row(rows, before_idx, op0)
   if idx < 0 { return [] }
   def r = rows[idx]
   def op = r.get("op", "")
   if op == "assign" {
      if r.get("kind", "") == "byte_load" && str.startswith(r.get("mnemonic", ""), "movzx") {
         return [{"shift": 0, "byte": _ny_operand(r.get("src", "")), "row": idx}]
      }
      return _semantic_pack_terms(rows, idx - 1, r.get("src", ""), depth + 1)
   }
   if op != "arith" { return [] }
   def sym = r.get("operator", "")
   if sym == "|" {
      return _semantic_pack_terms(rows, idx - 1, r.get("dst", ""), depth + 1) +
      _semantic_pack_terms(rows, idx - 1, r.get("src", ""), depth + 1)
   }
   if sym == "<<" {
      if _operand_kind(r.get("src", "")) != "imm" { return [] }
      def amount = _imm_number(r.get("src", ""))
      if amount < 0 || amount % 8 != 0 { return [] }
      def base_terms = _semantic_pack_terms(rows, idx - 1, r.get("dst", ""), depth + 1)
      mut out = []
      mut i = 0
      while i < base_terms.len {
         out = out.append(base_terms[i].set("shift", int(base_terms[i].get("shift", 0)) + amount))
         i += 1
      }
      return out
   }
   []
}

fn _semantic_term_at(list terms, int shift) dict {
   mut found = dict()
   mut i = 0
   while i < terms.len {
      if int(terms[i].get("shift", -1)) == shift {
         if found.len > 0 { return dict() }
         found = terms[i]
      }
      i += 1
   }
   found
}

fn _semantic_byte_pack_candidate(list rows, int idx) dict {
   if idx < 0 || idx >= rows.len { return dict() }
   def r = rows[idx]
   if r.get("op", "") != "arith" || r.get("operator", "") != "|" { return dict() }
   def terms = _semantic_pack_terms(rows, idx - 1, r.get("dst", "")) +
   _semantic_pack_terms(rows, idx - 1, r.get("src", ""))
   if terms.len < 2 || terms.len > 4 { return dict() }
   mut args = []
   mut consumes = [idx]
   mut shift = 0
   while shift < terms.len * 8 {
      def t = _semantic_term_at(terms, shift)
      if t.len == 0 { return dict() }
      args = args.append(t.get("byte", ""))
      consumes = _append_unique(consumes, int(t.get("row", -1)))
      shift += 8
   }
   {"ok": true, "archetype": "byte_pack_little",
      "replacement": "u" + to_str(terms.len * 8) + "_le(" + str.join(args, ", ") + ")",
      "consumes": consumes}
}

fn _semantic_simplifications_from_facts(dict bundle, any opts=dict()) dict {
   def opt = is_dict(opts) ? opts : dict()
   def rows = bundle.get("rows", [])
   mut proof_bundle = dict()
   if is_dict(bundle.get("smt_expression_proofs", dict())) && bundle.get("smt_expression_proofs", dict()).len > 0 {
      proof_bundle = bundle.get("smt_expression_proofs", dict())
   } else {
      proof_bundle = _smt_expression_proofs_from_facts(bundle, opt)
   }
   def proofs = proof_bundle.get("proofs", [])
   mut rewrites = []
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      def op = r.get("op", "")
      def sym = r.get("operator", "")
      def dst = _ny_operand(r.get("dst", ""))
      def src = _ny_operand(r.get("src", ""))
      if op == "arith" && sym == ">>" && _clean_unsigned_shift_mnemonic(r.get("mnemonic", "")) && _operand_kind(r.get("src", "")) == "imm" {
         def amount = _imm_number(r.get("src", ""))
         def bits = _clean_operand_bits(r.get("dst", ""))
         if amount > 0 && bits > 0 && amount < bits && amount <= 30 && _smt_proof_ok(proofs, "unsigned_div_power2") {
            rewrites = rewrites.append(_semantic_rewrite_record(proofs, "unsigned_div_power2", r,
                  dst + " >> " + to_str(amount), dst + " / " + to_str(1 << amount),
                  "logical right shift by a constant is an unsigned power-of-two division", [i]))
         }
      }
      if op == "arith" && sym == "&" {
         def modulus = _clean_low_mask_modulus(r.get("src", ""))
         if modulus > 0 && _smt_proof_ok(proofs, "unsigned_rem_power2_mask") {
            rewrites = rewrites.append(_semantic_rewrite_record(proofs, "unsigned_rem_power2_mask", r,
                  dst + " & " + src, dst + " % " + to_str(modulus),
                  "low contiguous mask is a power-of-two remainder", [i]))
         }
         def idx = _clean_byte_mask_index(r.get("src", ""))
         if idx >= 0 && _smt_proof_ok(proofs, idx == 0 ? "low_byte_mask" : "byte_window_mask") {
            rewrites = rewrites.append(_semantic_rewrite_record(proofs, idx == 0 ? "low_byte_mask" : "byte_window_mask", r,
                  dst + " & " + src, "byte_at(" + dst + ", " + to_str(idx) + ")",
                  "byte mask isolates a single byte lane", [i]))
         }
         def width = _clean_low_mask_width(r.get("src", ""))
         def prev = _clean_prev_def_row(rows, i - 1, r.get("dst", ""))
         if (width > 0 && prev >= 0 && rows[prev].get("op", "") == "arith" && rows[prev].get("operator", "") == ">>" &&
            _clean_unsigned_shift_mnemonic(rows[prev].get("mnemonic", "")) && _operand_kind(rows[prev].get("src", "")) == "imm" &&
            _smt_proof_ok(proofs, "bitfield_extract")){
            def amount = _imm_number(rows[prev].get("src", ""))
            rewrites = rewrites.append(_semantic_rewrite_record(proofs, "bitfield_extract", r,
                  "(" + _ny_operand(rows[prev].get("dst", "")) + " >> " + to_str(amount) + ") & " + src,
                  "bits(" + _ny_operand(rows[prev].get("dst", "")) + ", " + to_str(amount) + ", " + to_str(width) + ")",
                  "logical shift plus low mask is a field extraction", [prev, i]))
         }
      }
      if op == "arith" && sym == ">>" {
         def prev = _clean_prev_def_row(rows, i - 1, r.get("dst", ""))
         if (prev >= 0 && rows[prev].get("op", "") == "arith" && rows[prev].get("operator", "") == "&" &&
            _clean_byte_mask_index(rows[prev].get("src", "")) == _clean_shift_byte_index(r.get("src", "")) &&
            _smt_proof_ok(proofs, "byte_window_mask")){
            def idx = _clean_shift_byte_index(r.get("src", ""))
            rewrites = rewrites.append(_semantic_rewrite_record(proofs, "byte_window_mask", r,
                  "(" + _ny_operand(rows[prev].get("dst", "")) + " & " + _ny_operand(rows[prev].get("src", "")) + ") >> " + to_str(idx * 8),
                  "byte_at(" + _ny_operand(rows[prev].get("dst", "")) + ", " + to_str(idx) + ")",
                  "masked byte window shifted to the low lane", [prev, i]))
         }
      }
      if op == "arith" && sym == "|" {
         def rot = _semantic_rotate_or_candidate(rows, i)
         if rot.get("ok", false) && _smt_proof_ok(proofs, rot.get("archetype", "")) {
            rewrites = rewrites.append(_semantic_rewrite_record(proofs, rot.get("archetype", ""), r,
                  "complementary shift/or", rot.get("replacement", ""),
                  "complementary shifts over the same value form a rotate", rot.get("consumes", [])))
         }
         def pack = _semantic_byte_pack_candidate(rows, i)
         if pack.get("ok", false) && _smt_proof_ok(proofs, "byte_pack_little") {
            rewrites = rewrites.append(_semantic_rewrite_record(proofs, "byte_pack_little", r,
                  "byte-load shift/or chain", pack.get("replacement", ""),
                  "adjacent byte loads form an endian-aware packed integer", pack.get("consumes", [])))
         }
      }
      if op == "arith" && r.get("kind", "") == "rotate" {
         def arch = r.get("operator", "") == "ror" ? "rotate_right" : "rotate_left"
         if _smt_proof_ok(proofs, arch) {
            rewrites = rewrites.append(_semantic_rewrite_record(proofs, arch, r,
                  dst + " " + r.get("operator", "") + " " + src,
                  r.get("operator", "") + "(" + dst + ", " + src + ")",
                  "native rotate carries the same semantic helper used for shift/or idioms", [i]))
         }
      }
      if op == "arith" && (r.get("kind", "") == "byte_swap32" || r.get("kind", "") == "byte_swap64") && _smt_proof_ok(proofs, "byte_swap32") {
         rewrites = rewrites.append(_semantic_rewrite_record(proofs, "byte_swap32", r,
               "byte-swap lowering", (r.get("kind", "") == "byte_swap64" ? "bswap64" : "bswap32") + "(" + dst + ")",
               "byte-swap is endian reshaping, not arithmetic noise", [i]))
      }
      i += 1
   }
   mut proved = 0
   i = 0
   while i < rewrites.len {
      if rewrites[i].get("proved", false) { proved += 1 }
      i += 1
   }
   {"kind": "semantic_simplifications", "input": "facts", "backend": "z3",
      "ok": proof_bundle.get("ok", false), "rewrites": rewrites, "rewrite_count": rewrites.len,
      "proved_count": proved, "proof_count": proof_bundle.get("proof_count", proofs.len),
      "note": "facts-backed semantic rewrites; replacements are emitted only when their archetype proof is available"}
}

fn semantic_simplifications(any source, any target=0, any opts=dict()) dict {
   "Return facts-backed semantic rewrite candidates justified by SMT archetype proofs.
   This is the bridge between dataflow facts and clean Ny decompiler output:
   every replacement carries the proof archetype that makes it safe."
   if is_dict(source) && source.get("kind", "") == "facts" { return _semantic_simplifications_from_facts(source, opts) }
   _semantic_simplifications_from_facts(facts(source, target, opts), opts)
}

fn _facts_from(dict bin, any target, list rows0, dict graph) dict {
   mut facts = []
   mut mems = []
   mut rows = []
   mut i = 0
   while i < rows0.len {
      def row = _slice_row(rows0[i]).set("index", i)
      rows = rows.append(row)
      facts = _fact_add(facts, "row", {"row": i, "addr": int(row.get("addr", 0)),
            "mnemonic": row.get("mnemonic", ""), "op": row.get("op", ""),
            "operands": row.get("operands", ""), "effect": row.get("effect", "")})
      def op = row.get("op", "")
      if op == "call" {
         facts = _fact_add(facts, "call", {"row": i, "addr": int(row.get("addr", 0)),
               "target": int(row.get("target", 0)), "name": row.get("target_name", "")})
      } elif op == "syscall" {
         facts = _fact_add(facts, "syscall", {"row": i, "addr": int(row.get("addr", 0)),
               "nr": _syscall_nr(rows0, i), "family": row.get("family", _rows_family(rows0))})
      } elif op == "branch" {
         facts = _fact_add(facts, "branch", {"row": i, "addr": int(row.get("addr", 0)),
               "target": int(row.get("target", 0)), "condition": row.get("condition", ""),
               "kind": row.get("kind", "")})
      }
      mems = _fact_row_memory(mems, row)
      i += 1
   }
   def du = _def_use_rows(rows, target)
   def defs = du.get("defs", [])
   i = 0
   while i < defs.len {
      def d = defs[i]
      facts = _fact_add(facts, "defines", {"row": int(d.get("index", -1)), "addr": int(d.get("addr", 0)),
            "symbol": d.get("symbol", ""), "mnemonic": d.get("mnemonic", "")})
      i += 1
   }
   def uses = du.get("uses", [])
   i = 0
   while i < uses.len {
      def u = uses[i]
      facts = _fact_add(facts, "uses", {"row": int(u.get("index", -1)), "addr": int(u.get("addr", 0)),
            "symbol": u.get("symbol", ""), "def_addr": int(u.get("def_addr", 0)),
            "def_row": int(u.get("def_index", -1)), "mnemonic": u.get("mnemonic", "")})
      i += 1
   }
   def edges = du.get("edges", [])
   i = 0
   while i < edges.len {
      def e = edges[i]
      facts = _fact_add(facts, "flows", {"symbol": e.get("symbol", ""), "from": int(e.get("from", 0)),
            "from_row": int(e.get("from_index", -1)), "to": int(e.get("to", 0)), "to_row": int(e.get("to_index", -1))})
      i += 1
   }
   def cfg_edges = graph.get("edges", [])
   i = 0
   while i < cfg_edges.len {
      def e = cfg_edges[i]
      facts = _fact_add(facts, "cfg_edge", {"from": int(e.get("from", 0)), "to": int(e.get("to", 0)),
            "edge": e.get("kind", ""), "condition": e.get("condition", "")})
      i += 1
   }
   i = 0
   while i < mems.len {
      facts = _fact_add(facts, "memory", mems[i])
      i += 1
   }
   def shapes = _fact_memory_shapes(mems)
   i = 0
   while i < shapes.len {
      facts = _fact_add(facts, "memory_shape", shapes[i])
      i += 1
   }
   def vsa0 = _vsa_from_rows(rows, shapes, target)
   def intervals = vsa0.get("intervals", [])
   i = 0
   while i < intervals.len {
      facts = _fact_add(facts, "vsa_interval", intervals[i])
      i += 1
   }
   def value_intervals = vsa0.get("value_intervals", [])
   i = 0
   while i < value_intervals.len {
      facts = _fact_add(facts, "vsa_value", value_intervals[i])
      i += 1
   }
   def branch_deps = _branch_dependencies(rows)
   i = 0
   while i < branch_deps.len {
      facts = _fact_add(facts, "branch_dep", branch_deps[i])
      i += 1
   }
   def conditions = _fact_branch_conditions(bin, target, rows)
   i = 0
   while i < conditions.len {
      facts = _fact_add(facts, "condition", conditions[i])
      i += 1
   }
   mut base = {"kind": "facts", "language": "ny", "target": target, "arch": arch(bin),
      "rows": rows, "facts": facts, "by_kind": _fact_count_by_kind(facts),
      "def_use": du, "vsa": vsa0,
      "branch_dependencies": branch_deps, "conditions": conditions, "cfg": graph, "memory": mems, "memory_shapes": shapes,
      "row_count": rows.len, "fact_count": facts.len, "memory_count": mems.len,
      "memory_shape_count": shapes.len, "vsa_interval_count": vsa0.get("interval_count", 0),
      "vsa_value_interval_count": vsa0.get("value_interval_count", 0),
      "branch_dependency_count": branch_deps.len, "condition_count": conditions.len}
   def ssa0 = _ssa_from_facts(base)
   def sdefs = ssa0.get("defs", [])
   i = 0
   while i < sdefs.len {
      facts = _fact_add(facts, "ssa_def", sdefs[i])
      i += 1
   }
   def suses = ssa0.get("uses", [])
   i = 0
   while i < suses.len {
      facts = _fact_add(facts, "ssa_use", suses[i])
      i += 1
   }
   def sdeps = ssa0.get("deps", [])
   i = 0
   while i < sdeps.len {
      facts = _fact_add(facts, "ssa_dep", sdeps[i])
      i += 1
   }
   def sphis = ssa0.get("phis", [])
   i = 0
   while i < sphis.len {
      facts = _fact_add(facts, "ssa_phi", sphis[i])
      i += 1
   }
   def rewrite0 = _ssa_rewrite_candidates(rows, ssa0)
   def dead = rewrite0.get("dead_defs", [])
   i = 0
   while i < dead.len {
      facts = _fact_add(facts, "dead_value_candidate", dead[i])
      i += 1
   }
   def inline = rewrite0.get("inline_values", [])
   i = 0
   while i < inline.len {
      facts = _fact_add(facts, "inline_candidate", inline[i])
      i += 1
   }
   base = base.set("facts", facts).set("by_kind", _fact_count_by_kind(facts)).set("ssa", ssa0)
   .set("rewrite_candidates", rewrite0).set("ssa_value_count", ssa0.get("value_count", 0))
   .set("ssa_phi_count", ssa0.get("phi_count", 0)).set("fact_count", facts.len)
   def smt0 = _smt_expression_proofs_from_facts(base)
   base = base.set("smt_expression_proofs", smt0)
   def simp0 = _semantic_simplifications_from_facts(base)
   def sproofs = smt0.get("proofs", [])
   i = 0
   while i < sproofs.len {
      facts = _fact_add(facts, "smt_expr_proof", sproofs[i])
      i += 1
   }
   def simps = simp0.get("rewrites", [])
   i = 0
   while i < simps.len {
      facts = _fact_add(facts, "semantic_simplification", simps[i])
      i += 1
   }
   {"kind": "facts", "language": "ny", "target": target, "arch": arch(bin),
      "rows": rows, "facts": facts, "by_kind": _fact_count_by_kind(facts),
      "def_use": du, "ssa": ssa0, "vsa": vsa0, "rewrite_candidates": rewrite0,
      "smt_expression_proofs": smt0, "semantic_simplifications": simp0,
      "branch_dependencies": branch_deps, "conditions": conditions, "cfg": graph, "memory": mems, "memory_shapes": shapes,
      "row_count": rows.len, "fact_count": facts.len, "memory_count": mems.len,
      "memory_shape_count": shapes.len, "ssa_value_count": ssa0.get("value_count", 0),
      "ssa_phi_count": ssa0.get("phi_count", 0),
      "vsa_interval_count": vsa0.get("interval_count", 0),
      "vsa_value_interval_count": vsa0.get("value_interval_count", 0),
      "semantic_simplification_count": simp0.get("rewrite_count", 0),
      "branch_dependency_count": branch_deps.len, "condition_count": conditions.len}
}

fn facts(any source, any target=0, any opts=dict()) dict {
   "Return queryable semantic facts for a function.
   Facts are intentionally plain data: rows, definitions, uses, def-use flows,
   CFG edges, calls, syscalls, branch sites, memory accesses, and grouped
   memory shapes. Later SSA, VSA, SMT cleanup, and rewrite passes should consume
   this instead of reparsing pseudocode."
   def max_bytes = int(is_dict(opts) ? opts.get("max_bytes", 1024) : (is_int(opts) ? opts : 1024))
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def rows = lift(bin, target, max_bytes)
   _facts_from(bin, target, rows, cfg(bin, target, max_bytes))
}

fn backward_slice(any source, any target=0, any seed=dict(), any opts=dict()) dict {
   "Return a backward dependency slice over lifted Ny IR rows."
   def max_bytes = int(is_dict(opts) ? opts.get("max_bytes", 1024) : 1024)
   def rows0 = lift(source, target, max_bytes)
   mut rows = []
   mut i = 0
   while i < rows0.len { rows = rows.append(_slice_row(rows0[i])) i += 1 }
   mut need = _slice_seed_symbols(seed)
   def seed_rows = _slice_seed_rows(rows, seed)
   mut selected = []
   i = 0
   while i < seed_rows.len {
      def idx = int(seed_rows[i])
      if idx >= 0 && idx < rows.len {
         selected = _append_unique(selected, idx)
         need = _append_all_unique(need, rows[idx].get("uses", []))
         if need.len == 0 { need = _append_all_unique(need, rows[idx].get("defs", [])) }
      }
      i += 1
   }
   i = rows.len - 1
   while i >= 0 {
      def r = rows[i]
      if _list_has(selected, i) || _symbols_intersect(r.get("defs", []), need) {
         selected = _append_unique(selected, i)
         need = _append_all_unique(need, r.get("uses", []))
      }
      i -= 1
   }
   selected = _slice_close_control_rows(rows, selected)
   selected = _slice_expand_selected_dependencies(rows, selected)
   selected = _slice_close_control_rows(rows, selected)
   mut out_rows = []
   i = 0
   while i < rows.len {
      if _list_has(selected, i) { out_rows = out_rows.append(rows[i]) }
      i += 1
   }
   {"kind": "backward_slice", "target": target, "seed": seed, "symbols": need, "rows": out_rows, "count": out_rows.len}
}

fn forward_slice(any source, any target=0, any seed=dict(), any opts=dict()) dict {
   "Return a forward use/taint slice over lifted Ny IR rows."
   def max_bytes = int(is_dict(opts) ? opts.get("max_bytes", 1024) : 1024)
   def rows0 = lift(source, target, max_bytes)
   mut rows = []
   mut i = 0
   while i < rows0.len { rows = rows.append(_slice_row(rows0[i])) i += 1 }
   mut tainted = _slice_seed_symbols(seed)
   def seed_rows = _slice_seed_rows(rows, seed)
   mut selected = []
   i = 0
   while i < seed_rows.len {
      def idx = int(seed_rows[i])
      if idx >= 0 && idx < rows.len {
         selected = _append_unique(selected, idx)
         tainted = _append_all_unique(tainted, rows[idx].get("defs", []))
      }
      i += 1
   }
   i = 0
   while i < rows.len {
      def r = rows[i]
      if _list_has(selected, i) || _symbols_intersect(r.get("uses", []), tainted) {
         selected = _append_unique(selected, i)
         tainted = _append_all_unique(tainted, r.get("defs", []))
      }
      i += 1
   }
   mut out_rows = []
   i = 0
   while i < rows.len {
      if _list_has(selected, i) { out_rows = out_rows.append(rows[i]) }
      i += 1
   }
   {"kind": "forward_slice", "target": target, "seed": seed, "symbols": tainted, "rows": out_rows, "count": out_rows.len}
}

fn taint(any source, any target=0, any seed=dict(), any opts=dict()) dict {
   "Alias for forward_slice(...): propagate analyst seed symbols through lifted rows."
   forward_slice(source, target, seed, opts).set("kind", "taint")
}

fn _slice_for_explore(dict bin, any target, any spec, int max_bytes) dict {
   if !is_dict(spec) { return dict() }
   def kind = spec.get("kind", spec.get("mode", "backward"))
   def seed = spec.get("seed", spec)
   def opts = spec.set("max_bytes", int(spec.get("max_bytes", max_bytes)))
   if kind == "forward" { return forward_slice(bin, target, seed, opts) }
   if kind == "taint" { return taint(bin, target, seed, opts) }
   backward_slice(bin, target, seed, opts)
}

fn _simgr_at_first_row(dict manager, list rows) dict {
   if rows.len == 0 { return manager }
   def addr = int(rows[0].get("addr", 0))
   if addr <= 0 { return manager }
   def states = manager.get("active", [])
   mut out = []
   mut i = 0
   while i < states.len {
      out = out.append(sym.state_set_addr(states[i], addr))
      i += 1
   }
   manager.set("active", out)
}

fn _label_name(int addr) str {
   "loc_" + str.to_hex(addr, 0)
}

fn _branch_target_name(dict bin, dict local_labels, int target) str {
   if target <= 0 { return _hex(target) }
   def local = local_labels.get(to_str(target), "")
   if local.len > 0 { return _rename_addr(bin, target, local) }
   if _section_for_addr(bin, target).len > 0 { return _rename_addr(bin, target, _label_name(target)) }
   _hex(target)
}

fn _labels_for_rows(list rows, str a="x86_64") dict {
   mut m = dict()
   mut i = 0
   mut first = 0
   mut last = 0
   if rows.len > 0 {
      first = int(rows[0][0])
      def lr = rows[rows.len - 1]
      last = int(lr[0]) + int(lr[3])
   }
   while i < rows.len {
      def r = rows[i]
      if dasm.instruction_kind(a, r[1]) == "branch" {
         def t = str.find(r[2], "[") >= 0 ? 0 : _row_target(a, r)
         if t >= first && t < last { m = m.set(to_str(t), _label_name(t)) }
      }
      i += 1
   }
   m
}

fn _labels_from_rows(dict bin, list rows, list jts) list {
   def lm = _labels_for_rows(rows, arch(bin))
   mut out = []
   mut i = 0
   while i < rows.len {
      def addr = int(rows[i][0])
      def key = to_str(addr)
      if lm.get(key, "").len > 0 {
         out = out.append({"addr": addr, "name": _rename_addr(bin, addr, lm.get(key, ""))})
      }
      i += 1
   }
   mut ti = 0
   while ti < jts.len {
      def es = jts[ti].get("entries", [])
      mut ei = 0
      while ei < es.len {
         def addr = int(es[ei].get("target", 0))
         mut exists = false
         mut oi = 0
         while oi < out.len {
            if int(out[oi].get("addr", 0)) == addr { exists = true }
            oi += 1
         }
         if !exists { out = out.append({"addr": addr, "name": _rename_addr(bin, addr, _label_name(addr)), "kind": "switch", "table": int(jts[ti].get("base", 0)), "index": int(es[ei].get("index", 0))}) }
         ei += 1
      }
      ti += 1
   }
   out
}

fn labels(any source, any target=0, int max_bytes=1024) list {
   "Return local labels needed by branch and jump-table targets inside a decompiled range."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def rows = disassemble(bin, target, max_bytes)
   def jts = target == 0 ? _jump_tables_from_rows(bin, disassemble(bin, ".text", max_bytes)) : _jump_tables_from_rows(bin, rows)
   _labels_from_rows(bin, rows, jts)
}

fn _branch_condition_expr(list rows, int idx, str cond) str {
   if idx >= 0 && idx < rows.len {
      def br = rows[idx]
      def args = br.get("args", [])
      if (cond == "zero" || cond == "nonzero") && args.len > 0 {
         def lhs = _ny_operand(args[0])
         return lhs + (cond == "zero" ? " == 0" : " != 0")
      }
      if (cond == "bit_zero" || cond == "bit_nonzero") && args.len > 1 {
         def lhs = _ny_operand(args[0])
         def bit = _imm_number(args[1])
         def mask = 1 << max(0, bit)
         return "(" + lhs + " & " + _hex(mask) + ")" + (cond == "bit_zero" ? " == 0" : " != 0")
      }
      if br.get("family", "") == "riscv" && args.len > 1 {
         def bop = _cmp_condition_symbol(cond)
         if bop.len > 0 { return _ny_operand(args[0]) + " " + bop + " " + _ny_operand(args[1]) }
      }
   }
   def op = _cmp_condition_symbol(cond)
   if op.len == 0 { return "last_cmp." + cond }
   mut j = idx - 1
   while j >= 0 && idx - j <= 8 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" || rop == "branch" || rop == "syscall" || rop == "return" { break }
      if rop == "compare" {
         def lhs = _ny_operand(r.get("dst", ""))
         def rhs = _ny_operand(r.get("src", ""))
         if str.startswith(r.get("mnemonic", ""), "test") {
            return _clean_test_expr(lhs, rhs, cond, op)
         }
         if cond == "negative" || cond == "non_negative" { return lhs + " " + op }
         return lhs + " " + op + " " + rhs
      }
      if rop == "arith" && (cond == "eq" || cond == "ne" || cond == "zero" || cond == "nonzero") {
         def lhs = _ny_operand(r.get("dst", ""))
         return lhs + ((cond == "eq" || cond == "zero") ? " == 0" : " != 0")
      }
      j -= 1
   }
   "last_cmp." + cond
}

fn _mentions_alias(str text, str reg) bool {
   def al = _arg_aliases(reg)
   mut i = 0
   while i < al.len {
      if str.find(text, al[i]) >= 0 { return true }
      i += 1
   }
   false
}

fn _frame_model(list rows) dict {
   mut frame_size = 0
   mut uses_frame_pointer = false
   mut slots = []
   mut seen = dict()
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      def family = r.get("family", _rows_family(rows))
      if (r.get("mnemonic", "") == "mov" &&
         _canonical_value_reg(family, r.get("dst", "")) == "rbp" &&
         _canonical_value_reg(family, r.get("src", "")) == "rsp"){ uses_frame_pointer = true }
      if (r.get("mnemonic", "") == "sub" &&
         _canonical_value_reg(family, r.get("dst", "")) == "rsp"){ frame_size = max(frame_size, _imm_value(r.get("src", ""))) }
      def sl = _stack_slot_for_ops(r.get("operands", ""))
      if sl.len > 0 {
         def key = sl.get("base", "") + ":" + to_str(sl.get("offset", 0))
         if !seen.get(key, false) {
            seen = seen.set(key, true)
            slots = slots.append(sl)
         }
      }
      i += 1
   }
   {"size": frame_size, "uses_frame_pointer": uses_frame_pointer, "slots": slots}
}

fn _signature_guess(list rows) dict {
   def abi = _abi_profile(_rows_family(rows))
   def regs = abi.get("args", [])
   def rets = abi.get("returns", [])
   mut written = dict()
   mut found = dict()
   mut params = []
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      def op = r.get("op", "")
      mut read_text = r.get("src", "")
      if r.get("kind", "") == "zeroing_idiom" {
         read_text = ""
      }
      if r.get("dst_kind", "") == "mem" {
         read_text = read_text + " " + r.get("dst", "")
      }
      if op == "compare" || op == "branch" {
         read_text = read_text + " " + r.get("dst", "") + " " + r.get("operands", "")
      }
      mut j = 0
      while j < regs.len {
         def reg = regs[j]
         if !written.get(reg, false) && !found.get(reg, false) && _mentions_alias(read_text, reg) {
            found = found.set(reg, true)
            params = params.append({"name": "arg" + to_str(params.len), "reg": reg, "kind": abi.get("abi", "abi") + "_guess"})
         }
         j += 1
      }
      def wr = _alias_reg_for(regs, r.get("dst", ""))
      if wr.len > 0 { written = written.set(wr, true) }
      i += 1
   }
   mut returns = []
   mut ri = 0
   while ri < rets.len {
      returns = returns.append({"reg": rets[ri], "kind": "integer_or_pointer_guess"})
      ri += 1
   }
   {"abi": abi.get("abi", "unknown"), "params": params, "returns": returns}
}

fn _signature_param_pos(list params, str reg) int {
   mut i = 0
   while i < params.len {
      if params[i].get("reg", "") == reg { return i }
      i += 1
   }
   -1
}

fn _abi_arg_index(str family, str reg) int {
   def regs = _abi_profile(family).get("args", [])
   mut i = 0
   while i < regs.len {
      if regs[i] == reg { return i }
      i += 1
   }
   -1
}

fn _cross_functions(dict bin) list {
   def fs0 = bin.get("functions", [])
   if fs0.len > 0 { return fs0 }
   []
}

fn _incoming_call_signature(dict bin, int callee, int max_bytes=512) dict {
   if callee <= 0 { return {"params": [], "calls": []} }
   def fs = _cross_functions(bin)
   if fs.len > 8 { return {"params": [], "calls": []} }
   mut params = []
   mut calls = []
   mut seen = dict()
   mut fi = 0
   while fi < fs.len && fi < 128 {
      def f = fs[fi]
      def faddr = int(f.get("value", f.get("start", 0)))
      if faddr > 0 && faddr != callee {
         def rows = lift(bin, f, max_bytes)
         def family = _rows_family(rows)
         def cs = _calls_model(rows)
         mut ci = 0
         while ci < cs.len {
            def c = cs[ci]
            if int(c.get("target", 0)) == callee {
               calls = calls.append({"caller": _rename_name(bin, f.get("name", "sub_" + str.to_hex(faddr, 0))),
                     "caller_addr": faddr, "site": int(c.get("addr", 0)), "args": c.get("args", [])})
               def args = c.get("args", [])
               mut ai = 0
               while ai < args.len {
                  def a = args[ai]
                  def reg = a.get("reg", "")
                  if reg.len > 0 && !seen.get(reg, false) {
                     seen = seen.set(reg, true)
                     def idx = _abi_arg_index(family, reg)
                     params = params.append({"name": "arg" + to_str(idx >= 0 ? idx : params.len),
                           "reg": reg, "kind": "incoming_call_guess",
                           "example": a.get("value", ""), "site": int(c.get("addr", 0)),
                           "caller": _rename_name(bin, f.get("name", "sub_" + str.to_hex(faddr, 0))),
                           "ref_kind": a.get("ref_kind", ""), "ref_name": a.get("ref_name", ""),
                           "ref_target": int(a.get("ref_target", 0))})
                  }
                  ai += 1
               }
            }
            ci += 1
         }
      }
      fi += 1
   }
   {"params": params, "calls": calls}
}

fn _abi_family_from_name(str abi) str {
   if abi == "aapcs64" { return "aarch64" }
   if abi == "aapcs32" { return "arm" }
   if abi == "riscv_elf" { return "riscv" }
   "x86"
}

fn _param_abi_index(str abi, dict p) int {
   _abi_arg_index(_abi_family_from_name(abi), p.get("reg", ""))
}

fn _looks_int_literal(str s) bool {
   def x = str.strip(s)
   if x.len == 0 { return false }
   if str.startswith(x, "0x") || str.startswith(x, "-0x") { return true }
   mut i = load8(x, 0) == 45 ? 1 : 0
   if i >= x.len { return false }
   while i < x.len {
      if !str.ascii_is_digit(load8(x, i)) { return false }
      i += 1
   }
   true
}

fn _signature_shape_param(dict p) dict {
   mut out = p
   def ex = to_str(p.get("example", ""))
   if p.get("ref_kind", "") == "string" || str.startswith(ex, "&\"") {
      return out.set("type", "str").set("shape", "string_ptr")
   }
   if p.get("ref_kind", "") == "data" || str.startswith(ex, "&") {
      return out.set("type", "ptr").set("shape", "data_ptr")
   }
   if _looks_int_literal(ex) {
      return out.set("type", "int").set("shape", "scalar")
   }
   out.set("type", out.get("type", "unknown")).set("shape", out.get("shape", "unknown"))
}

fn _field_type_guess(str op) str {
   if str.find(str.lower(op), "byte ptr") >= 0 { return "u8" }
   if str.find(str.lower(op), "word ptr") >= 0 { return "u16" }
   if str.find(str.lower(op), "dword ptr") >= 0 { return "u32" }
   if str.find(str.lower(op), "qword ptr") >= 0 { return "u64_or_ptr" }
   "unknown"
}

fn _field_offset_for_reg(str op, str reg) int {
   def aliases = _arg_aliases(reg)
   mut i = 0
   while i < aliases.len {
      if str.find(op, aliases[i]) >= 0 {
         def d = _disp_after(op, aliases[i])
         return d
      }
      i += 1
   }
   0
}

fn _field_contains_reg(str op, str reg) bool {
   if _operand_kind(op) != "mem" { return false }
   _mentions_alias(op, reg)
}

fn _field_indexed_for_reg(str op, str reg) bool {
   if _operand_kind(op) != "mem" { return false }
   def mem = _fact_mem_expr(op)
   if mem.len == 0 { return false }
   def base = mem.get("base", "")
   def index = mem.get("index", "")
   if index.len == 0 { return false }
   _alias_reg_for([reg], base) == reg || _alias_reg_for([reg], index) == reg
}

fn _field_pos(list fields, int offset) int {
   mut i = 0
   while i < fields.len {
      if int(fields[i].get("offset", 0)) == offset { return i }
      i += 1
   }
   -1
}

fn _field_rename(dict bin, dict param, dict field) str {
   def raw = field.get("name", "")
   def pname = param.get("name", "")
   def r = _rename_map(bin)
   def scoped = pname.len > 0 ? pname + "." + raw : raw
   _safe_name(r.get(scoped, r.get(raw, raw)), raw)
}

fn _fields_for_param(dict bin, list rows, dict p) list {
   def reg = p.get("reg", "")
   if reg.len == 0 { return [] }
   mut fields = []
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      mut ops = []
      if _field_contains_reg(r.get("dst", ""), reg) && !_field_indexed_for_reg(r.get("dst", ""), reg) {
         ops = ops.append({"op": r.get("dst", ""), "access": r.get("op", "") == "compare" ? "read" : "write", "addr": int(r.get("addr", 0))})
      }
      if _field_contains_reg(r.get("src", ""), reg) && !_field_indexed_for_reg(r.get("src", ""), reg) {
         ops = ops.append({"op": r.get("src", ""), "access": "read", "addr": int(r.get("addr", 0))})
      }
      mut oi = 0
      while oi < ops.len {
         def rec = ops[oi]
         def op = rec.get("op", "")
         def off = _field_offset_for_reg(op, reg)
         if _field_pos(fields, off) < 0 {
            def raw_name = "field_" + str.to_hex(_iabs(off), 0)
            def f = {"name": raw_name, "raw_name": raw_name, "offset": off,
               "type": _field_type_guess(op), "accesses": [rec.set("operand", op)]}
            fields = fields.append(f.set("name", _field_rename(bin, p, f)))
         } else {
            def fp = _field_pos(fields, off)
            fields = fields.set(fp, fields[fp].set("accesses", fields[fp].get("accesses", []).append(rec.set("operand", op))))
         }
         oi += 1
      }
      i += 1
   }
   fields
}

fn _fields_are_contiguous_byte_slice(list fields) bool {
   if fields.len < 2 { return false }
   mut min_off = int(fields[0].get("offset", 0))
   mut max_off = min_off
   mut seen = dict()
   mut i = 0
   while i < fields.len {
      def f = fields[i]
      if f.get("type", "") != "u8" { return false }
      def off = int(f.get("offset", 0))
      if off < 0 { return false }
      if seen.get(to_str(off), false) { return false }
      seen = seen.set(to_str(off), true)
      min_off = min(min_off, off)
      max_off = max(max_off, off)
      i += 1
   }
   min_off == 0 && (max_off - min_off + 1) == fields.len
}

fn _apply_signature_fields(dict bin, dict sig, list rows) dict {
   mut params = sig.get("params", [])
   mut i = 0
   while i < params.len {
      def fields = _fields_for_param(bin, rows, params[i])
      if fields.len >= 2 {
         if _fields_are_contiguous_byte_slice(fields) {
            params = params.set(i, params[i].set("type", "bytes").set("shape", "buffer").set("role", "byte_slice").set("fields", fields))
         } else {
            params = params.set(i, params[i].set("type", "struct").set("shape", "struct_ptr").set("fields", fields))
         }
      } elif fields.len == 1 && params[i].get("shape", "unknown") == "unknown" {
         params = params.set(i, params[i].set("type", "ptr").set("shape", "field_ptr").set("fields", fields))
      }
      i += 1
   }
   sig.set("params", params)
}

fn _copy_fields_for_param(dict bin, dict param, list fields, str source) list {
   mut out = []
   mut i = 0
   while i < fields.len {
      def f0 = fields[i]
      def raw = f0.get("raw_name", f0.get("name", "field_" + str.to_hex(_iabs(int(f0.get("offset", 0))), 0)))
      def f = f0.set("raw_name", raw).set("source", source)
      out = out.append(f.set("name", _field_rename(bin, param, f.set("name", raw))))
      i += 1
   }
   out
}

fn _param_pos_by_reg(list params, str reg) int {
   mut i = 0
   while i < params.len {
      if params[i].get("reg", "") == reg { return i }
      i += 1
   }
   -1
}

fn _signature_for_local_rows(dict bin, list rows) dict {
   _apply_signature_fields(bin, _infer_signature_shapes(_signature_guess(rows)), rows)
}

fn _propagate_outgoing_struct_fields(dict bin, dict sig, list rows, int max_bytes=512) dict {
   if rows.len > 192 { return sig }
   def fs = _cross_functions(bin)
   if fs.len == 0 || fs.len > 8 { return sig }
   mut params = sig.get("params", [])
   def family = rows.len > 0 ? _rows_family(rows) : _abi_family_from_name(sig.get("abi", "sysv_x86_64"))
   def regs = _abi_profile(family).get("args", [])
   mut i = 0
   mut followed = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "call" && int(r.get("target", 0)) > 0 && followed < 12 {
         followed += 1
         def callee_rows = lift(bin, int(r.get("target", 0)), min(max_bytes, 160))
         def csig = _signature_for_local_rows(bin, callee_rows)
         def cps = csig.get("params", [])
         mut ci = 0
         while ci < cps.len {
            def cp = cps[ci]
            if cp.get("shape", "") == "struct_ptr" {
               def idx = _param_abi_index(csig.get("abi", ""), cp)
               if idx >= 0 && idx < regs.len {
                  def reg = regs[idx]
                  def pp = _param_pos_by_reg(params, reg)
                  if pp < 0 {
                     params = params.append({"name": "arg" + to_str(idx), "reg": reg, "kind": "outgoing_call_struct_guess",
                           "type": "struct", "shape": "struct_ptr",
                           "fields": _copy_fields_for_param(bin, {"name": "arg" + to_str(idx), "reg": reg}, cp.get("fields", []), "callee_" + str.to_hex(int(r.get("target", 0)), 0)),
                           "callee": int(r.get("target", 0)), "site": int(r.get("addr", 0))})
                  } else {
                     def p = params[pp]
                     if p.get("shape", "") != "struct_ptr" {
                        params = params.set(pp, p.set("type", "struct").set("shape", "struct_ptr")
                           .set("fields", _copy_fields_for_param(bin, p, cp.get("fields", []), "callee_" + str.to_hex(int(r.get("target", 0)), 0)))
                           .set("callee", int(r.get("target", 0))).set("site", int(r.get("addr", 0))))
                     }
                  }
               }
            }
            ci += 1
         }
      }
      i += 1
   }
   sig.set("params", params)
}

fn _signature_param_at_abi_index(list params, str abi, int idx) int {
   mut i = 0
   while i < params.len {
      if _param_abi_index(abi, params[i]) == idx { return i }
      i += 1
   }
   -1
}

fn _infer_signature_shapes(dict sig) dict {
   mut params = []
   def ps = sig.get("params", [])
   mut i = 0
   while i < ps.len {
      params = params.append(_signature_shape_param(ps[i]))
      i += 1
   }
   def abi = sig.get("abi", "unknown")
   i = 0
   while i < params.len {
      def p = params[i]
      def shape = p.get("shape", "")
      if shape == "string_ptr" || shape == "data_ptr" {
         def next = _signature_param_at_abi_index(params, abi, _param_abi_index(abi, p) + 1)
         if next >= 0 && _looks_int_literal(params[next].get("example", "")) {
            params = params.set(i, p.set("length_arg", params[next].get("name", "")).set("shape", shape == "string_ptr" ? "string_with_length" : "ptr_with_length"))
            params = params.set(next, params[next].set("type", "usize").set("shape", "length").set("length_of", p.get("name", "")).set("role", "length"))
         }
      }
      i += 1
   }
   sig.set("params", params)
}

fn _merge_signature(dict local, dict incoming) dict {
   mut params = local.get("params", [])
   def inc = incoming.get("params", [])
   mut i = 0
   while i < inc.len {
      def p = inc[i]
      if _signature_param_pos(params, p.get("reg", "")) < 0 { params = params.append(p) }
      i += 1
   }
   _infer_signature_shapes(local.set("params", params).set("incoming_calls", incoming.get("calls", [])))
}

fn _signature_stack_param_pos(list params, str name) int {
   mut i = 0
   while i < params.len {
      if params[i].get("name", "") == name { return i }
      i += 1
   }
   -1
}

fn _x86_stack_param_for_operand(str op) dict {
   def mem = _fact_mem_expr(op)
   if mem.len == 0 || mem.get("index", "").len > 0 { return dict() }
   def base = mem.get("base", "")
   if base != "ebp" && base != "esp" && base != "0" { return dict() }
   def off = int(mem.get("offset", 0))
   if off < 8 || off % 4 != 0 { return dict() }
   def idx = (off - 8) / 4
   {"name": "arg" + to_str(idx), "reg": "stack" + to_str(idx), "kind": "x86_stack_frame_guess",
      "stack_offset": off, "abi_index": idx, "type": "unknown", "shape": "unknown"}
}

fn _signature_stack_params(list rows) list {
   mut by_idx = dict()
   mut seen = dict()
   mut max_idx = -1
   if _rows_family(rows) != "x86" { return [] }
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      mut ops = []
      if r.get("dst_kind", "") == "mem" { ops = ops.append(r.get("dst", "")) }
      if r.get("src_kind", "") == "mem" { ops = ops.append(r.get("src", "")) }
      mut oi = 0
      while oi < ops.len {
         def p = _x86_stack_param_for_operand(ops[oi])
         def name = p.get("name", "")
         if name.len > 0 && !seen.get(name, false) {
            seen = seen.set(name, true)
            def idx = int(p.get("abi_index", 0))
            by_idx = by_idx.set(to_str(idx), p)
            max_idx = max(max_idx, idx)
         }
         oi += 1
      }
      i += 1
   }
   mut out = []
   i = 0
   while i <= max_idx {
      def key = to_str(i)
      if by_idx.contains(key) {
         out = out.append(by_idx.get(key, dict()))
      } else {
         out = out.append({"name": "arg" + to_str(i), "reg": "stack" + to_str(i),
               "kind": "x86_stack_frame_gap", "stack_offset": 8 + i * 4,
               "abi_index": i, "type": "unknown", "shape": "unknown"})
      }
      i += 1
   }
   out
}

fn _merge_stack_signature(dict sig, list rows) dict {
   mut params = sig.get("params", [])
   def stack = _signature_stack_params(rows)
   mut i = 0
   while i < stack.len {
      def p = stack[i]
      if _signature_stack_param_pos(params, p.get("name", "")) < 0 {
         params = params.append(p)
      }
      i += 1
   }
   sig.set("params", params)
}

fn _function_signature_for(dict bin, any target, list rows, int addr, int max_bytes=512) dict {
   _signature_order_params(_merge_stack_signature(_propagate_outgoing_struct_fields(bin,
            _apply_signature_fields(bin, _merge_signature(_signature_guess(rows), _incoming_call_signature(bin, addr, max_bytes)), rows),
            rows, max_bytes), rows))
}

fn _signature_order_params(dict sig) dict {
   def params = sig.get("params", [])
   if params.len == 0 { return sig }
   def abi = sig.get("abi", "")
   def regs = _abi_profile(_abi_family_from_name(abi)).get("args", [])
   mut by_idx = dict()
   mut slots = []
   mut extras = []
   mut i = 0
   while i < params.len {
      def p = params[i]
      def idx = _param_abi_index(abi, p)
      if idx >= 0 && idx < regs.len {
         if !by_idx.contains(to_str(idx)) { slots = _int_insert_sorted_unique(slots, idx) }
         by_idx = by_idx.set(to_str(idx), p)
      } else {
         extras = extras.append(p)
      }
      i += 1
   }
   if slots.len == 0 { return sig }
   mut ordered = []
   i = 0
   while i < slots.len {
      def slot = int(slots[i])
      def entry = by_idx.get(to_str(slot), dict())
      if is_dict(entry) { ordered = ordered.append(entry.set("name", "arg" + to_str(i))) }
      i += 1
   }
   i = 0
   while i < extras.len {
      ordered = ordered.append(extras[i])
      i += 1
   }
   sig.set("params", ordered)
}

fn _signature_param_text(dict sig) str {
   def params = sig.get("params", [])
   mut b = str.Builder(max(16, params.len * 8))
   mut i = 0
   while i < params.len {
      if i > 0 { b = str.builder_append(b, ", ") }
      b = str.builder_append(b, params[i].get("name", "arg" + to_str(i)))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _signature_main_aliases(dict sig, str name) dict {
   if name != "main" { return sig }
   mut params = sig.get("params", [])
   def abi = sig.get("abi", "")
   mut i = 0
   while i < params.len {
      def idx = _param_abi_index(abi, params[i])
      if idx == 0 {
         params = params.set(i, params[i].set("name", "argc").set("type", "int").set("role", "argc"))
      } elif idx == 1 {
         def family = _abi_family_from_name(abi)
         def stride = (abi == "sysv_x86_64" || family == "aarch64" || family == "riscv") ? 8 : 4
         params = params.set(i, params[i].set("name", "argv").set("type", "ptr")
            .set("shape", "argv").set("role", "argv").set("pointer_index_stride", stride))
      }
      i += 1
   }
   sig.set("params", params)
}

fn _effect_rhs(str effect, str fallback) str {
   def p = str.find(effect, "=")
   if p < 0 { return fallback }
   str.strip(slice(effect, p + 1, effect.len, 1))
}

fn _effect_lhs(str effect, str fallback) str {
   def p = str.find(effect, "=")
   if p < 0 { return fallback }
   str.strip(slice(effect, 0, p, 1))
}

fn _resolve_reg_row_value(dict bin, list rows, int row_idx, dict row, int depth) str {
   def op = row.get("op", "")
   mut value = _effect_rhs(row.get("effect", ""), _ny_operand(row.get("src", "")))
   if op == "assign" && row.get("src_kind", "") == "mem" {
      def stored = _clean_recent_store_value_for_load(bin, rows, row_idx - 1, row.get("src", ""), depth + 1, true)
      if stored.len > 0 { return stored }
   }
   if op == "assign" && row.get("kind", "") == "lea" {
      def addr = row.get("addr_expr", "").len > 0 ? row.get("addr_expr", "") :
      _ny_address_operand_ref_bin(bin, row.get("src", ""), row.get("ref", dict()))
      def resolved = _clean_expr_resolve_regs_at(bin, rows, row_idx - 1, addr, depth + 1)
      return resolved.len > 0 ? resolved : addr
   }
   if op == "assign" && row.get("kind", "") == "byte_load" {
      def loaded = _clean_operand_expr_at(bin, rows, row_idx - 1, row.get("src", ""), depth + 1, true)
      if loaded.len > 0 {
         return str.startswith(row.get("mnemonic", ""), "movsx") ? _sext_expr(row.get("src", ""), loaded) :
         _zext_expr(row.get("src", ""), loaded)
      }
   }
   if op == "arith" && row.get("dst_kind", "") == "reg" {
      def sym = row.get("operator", "")
      if row.get("kind", "") == "zeroing_idiom" { return "0" }
      if row.get("kind", "") == "imm_load" { return _ny_operand_ref_bin(bin, row.get("src", ""), row.get("ref", dict())) }
      if sym.len > 0 && sym != "=" && row.get("src", "").len > 0 {
         def left = _clean_operand_expr_at(bin, rows, row_idx - 1, row.get("dst", ""), depth + 1)
         def right = _clean_operand_expr_at(bin, rows, row_idx - 1, row.get("src", ""), depth + 1)
         if left.len > 0 && right.len > 0 { value = _clean_binary_expr(left, sym, right) }
      }
   }
   value
}

fn _clean_mem_operand_key(str op0) str {
   def op = _clean_operand(op0)
   if _operand_kind(op) != "mem" { return "" }
   str.lower(str.str_replace(str.strip(_ny_operand(op)), " ", ""))
}

fn _clean_recent_store_value_for_load(dict bin, list rows, int before_idx, str memop, int depth=0, bool cross_forward_branches=false, list preserve=[]) str {
   if depth > 8 || before_idx < 0 || _operand_kind(memop) != "mem" { return "" }
   def key = _clean_mem_operand_key(memop)
   if key.len == 0 { return "" }
   mut j = min(before_idx, rows.len - 1)
   mut guard = 0
   while j >= 0 && guard < 16 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" || rop == "branch" || rop == "syscall" || rop == "return" { break }
      if (rop == "assign" || rop == "arith") && r.get("dst_kind", "") == "mem" {
         if rop == "assign" && _clean_mem_operand_key(r.get("dst", "")) == key && r.get("src", "").len > 0 {
            def value = _clean_operand_expr_at(bin, rows, j - 1, r.get("src", ""), depth + 1, cross_forward_branches, preserve)
            if value.len > 0 && !_clean_value_symbols_redefined_between(bin, rows, j + 1, before_idx, r.get("family", _rows_family(rows)), value) {
               return value
            }
         }
         break
      }
      if _row_def_intersects_operand(r, memop) { break }
      j -= 1
      guard += 1
   }
   ""
}

fn _clean_value_symbols_redefined_between(dict bin, list rows, int start, int end, str family, str value0) bool {
   if end < start { return false }
   def simple = str.strip(value0)
   def simple_reg = _canonical_value_reg(family, simple)
   if simple_reg.len > 0 && _abi_arg_index(family, simple_reg) >= 0 { return false }
   if str.startswith(simple, "arg") && simple.len > 3 && _fact_term_int(slice(simple, 3, simple.len, 1)) { return false }
   def syms0 = _append_all_unique(_slice_operand_symbols(value0), _symbols_from_text(value0))
   if syms0.len == 0 { return false }
   mut syms = []
   mut si = 0
   while si < syms0.len {
      def s = syms0[si]
      syms = syms.append(s)
      if str.startswith(s, "arg") && s.len > 3 {
         def raw_idx = slice(s, 3, s.len, 1)
         if _fact_term_int(raw_idx) {
            def idx = _parse_int_piece(raw_idx)
            def regs = _abi_profile(family).get("args", [])
            if idx >= 0 && idx < regs.len { syms = _append_all_unique(syms, _slice_symbol_aliases(regs[idx])) }
         }
      }
      si += 1
   }
   if syms.len == 0 { return false }
   mut i = max(0, start)
   while i <= end && i < rows.len {
      def r = rows[i]
      mut defs = _row_defs(r)
      if r.get("dst_kind", "") == "mem" {
         def alias = _clean_address_lvalue_expr(_clean_address_expr_at(bin, dict(), rows, i - 1, r.get("dst", ""), 0))
         if alias.len > 0 { defs = _append_unique(defs, alias) }
      }
      if _symbols_intersect(defs, syms) { return true }
      i += 1
   }
   false
}

fn _tracked_value_regs(str family) list {
   if family == "aarch64" { return ["x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8"] }
   if family == "arm" { return ["r0", "r1", "r2", "r3", "r4", "r5", "r7"] }
   if family == "riscv" { return ["a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7"] }
   ["rax", "rbx", "rcx", "rdx", "rsi", "rdi", "rbp", "rsp", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]
}

fn _canonical_value_reg(str family, str op) str {
   _alias_reg_for(_tracked_value_regs(family), str.strip(op))
}

fn _stack_value_reg(str family, str reg0) bool {
   def reg = _canonical_value_reg(family, reg0)
   reg == "rsp" || reg == "rbp" || reg == "sp" || reg == "x29" || reg == "x31"
}

fn _callee_saved_value_reg(str family, str reg0) bool {
   def reg = _canonical_value_reg(family, reg0)
   if family == "aarch64" { return reg == "x19" || reg == "x20" || reg == "x21" || reg == "x22" || reg == "x23" || reg == "x24" || reg == "x25" || reg == "x26" || reg == "x27" || reg == "x28" }
   if family == "arm" { return reg == "r4" || reg == "r5" || reg == "r6" || reg == "r7" || reg == "r8" || reg == "r9" || reg == "r10" || reg == "r11" }
   if family == "riscv" { return false }
   reg == "rbx" || reg == "rbp" || reg == "r12" || reg == "r13" || reg == "r14" || reg == "r15"
}

fn _local_call_preserves_reg(dict bin, dict call_row, str family, str reg0) bool {
   def reg = _canonical_value_reg(family, reg0)
   if reg.len == 0 { return false }
   def target = int(call_row.get("target", 0))
   if target <= 0 { return false }
   def sec = _section_for_addr(bin, target)
   if sec.len == 0 { return false }
   def sname = sec.get("name", "")
   if str.find(sname, ".plt") >= 0 || str.find(sname, ".got") >= 0 { return false }
   def rows = lift(bin, target, 96)
   if rows.len == 0 || rows.len > 64 { return false }
   def aliases = _slice_symbol_aliases(reg)
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      def op = r.get("op", "")
      if op == "call" || op == "syscall" { return false }
      if _symbols_intersect(_row_defs(r), aliases) { return false }
      i += 1
   }
   true
}

fn _lifted_block_leaders(list rows) dict {
   mut leaders = dict()
   if rows.len == 0 { return leaders }
   leaders = leaders.set(to_str(int(rows[0].get("addr", 0))), true)
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" {
         def target = int(r.get("target", 0))
         if target != 0 && _row_index_for_addr(rows, target) >= 0 { leaders = leaders.set(to_str(target), true) }
         if i + 1 < rows.len { leaders = leaders.set(to_str(int(rows[i + 1].get("addr", 0))), true) }
      } elif r.get("op", "") == "call" || r.get("op", "") == "syscall" {
         if i + 1 < rows.len { leaders = leaders.set(to_str(int(rows[i + 1].get("addr", 0))), true) }
      }
      i += 1
   }
   leaders
}

fn _lifted_blocks(list rows) list {
   def leaders = _lifted_block_leaders(rows)
   mut blocks = []
   mut start = 0
   mut i = 0
   while i < rows.len {
      if i == 0 || leaders.get(to_str(int(rows[i].get("addr", 0))), false) {
         if i > start {
            blocks = blocks.append({"addr": int(rows[start].get("addr", 0)), "start": start, "end": i})
         }
         start = i
      }
      def op = rows[i].get("op", "")
      if op == "branch" || op == "return" {
         blocks = blocks.append({"addr": int(rows[start].get("addr", 0)), "start": start, "end": i + 1})
         start = i + 1
      }
      i += 1
   }
   if start < rows.len { blocks = blocks.append({"addr": int(rows[start].get("addr", 0)), "start": start, "end": rows.len}) }
   blocks
}

fn _lifted_block_index_for_row(list blocks, int row_idx) int {
   mut i = 0
   while i < blocks.len {
      if row_idx >= int(blocks[i].get("start", 0)) && row_idx < int(blocks[i].get("end", 0)) { return i }
      i += 1
   }
   -1
}

fn _lifted_block_index_for_addr(list blocks, int addr) int {
   mut i = 0
   while i < blocks.len {
      if int(blocks[i].get("addr", 0)) == addr { return i }
      i += 1
   }
   -1
}

fn _lifted_block_predecessors(list rows, list blocks, int block_idx) list {
   if block_idx < 0 || block_idx >= blocks.len { return [] }
   def target_addr = int(blocks[block_idx].get("addr", 0))
   mut out = []
   mut i = 0
   while i < blocks.len {
      def b = blocks[i]
      def end = int(b.get("end", 0))
      if end > int(b.get("start", 0)) && end - 1 < rows.len {
         def r = rows[end - 1]
         def op = r.get("op", "")
         if op == "branch" {
            if int(r.get("target", 0)) == target_addr { out = _append_unique(out, i) }
            if r.get("condition", "") != "always" && i + 1 == block_idx { out = _append_unique(out, i) }
         } elif op != "return" && i + 1 == block_idx {
            out = _append_unique(out, i)
         }
      }
      i += 1
   }
   out
}

fn _resolve_reg_value_cfg(dict bin, list rows, int before, str family, str reg, int depth=0) dict {
   if reg.len == 0 || depth > 4 || before <= 0 { return dict() }
   def blocks = _lifted_blocks(rows)
   def start_block = _lifted_block_index_for_row(blocks, min(before, rows.len - 1))
   if start_block < 0 { return dict() }
   mut work = [{"block": start_block, "before": before}]
   mut seen = dict()
   mut guard = 0
   while work.len > 0 && guard < 64 {
      guard += 1
      def frame = work.pop()
      def bi = int(frame.get("block", -1))
      if bi < 0 || bi >= blocks.len { continue }
      def before_row = min(int(frame.get("before", before)), int(blocks[bi].get("end", 0)))
      def key = to_str(bi) + ":" + to_str(before_row) + ":" + reg
      if seen.get(key, false) { continue }
      seen = seen.set(key, true)
      mut j = before_row - 1
      def start = int(blocks[bi].get("start", 0))
      mut clobbered = false
      while j >= start {
         def r = rows[j]
         def op = r.get("op", "")
         if op == "call" && !_callee_saved_value_reg(family, reg) && !(bin.get("ok", false) && _local_call_preserves_reg(bin, r, family, reg)) {
            clobbered = true
            break
         }
         if op == "syscall" || op == "return" {
            clobbered = true
            break
         }
         if _alias_reg_for([reg], r.get("dst", "")) == reg {
            if (op == "assign" || op == "arith") && r.get("dst_kind", "") == "reg" {
               def value = _resolve_reg_row_value(bin, rows, j, r, depth)
               if _clean_row_saves_recent_call_result(rows, j) {
                  return _copy_ref_fields({"value": reg, "site": int(r.get("addr", 0)), "reg": reg,
                        "crossed_call": false, "snapshot": "call_result"}, r)
               }
               def src_reg = _canonical_value_reg(family, value)
               if src_reg.len > 0 && src_reg != reg {
                  def nested = _resolve_reg_value(rows, j, family, src_reg, depth + 1, bin)
                  if nested.len > 0 {
                     if _clean_value_symbols_redefined_between(bin, rows, j + 1, before - 1, family, nested.get("value", "")) {
                        return {"value": reg, "site": int(r.get("addr", 0)), "reg": reg, "stale": true,
                           "crossed_call": false}
                     }
                     return nested.set("via", value).set("resolved_site", int(r.get("addr", 0))).set("crossed_call", nested.get("crossed_call", false))
                  }
               }
               if _clean_value_symbols_redefined_between(bin, rows, j + 1, before - 1, family, value) {
                  return {"value": reg, "site": int(r.get("addr", 0)), "reg": reg, "stale": true,
                     "crossed_call": false}
               }
               return _copy_ref_fields({"value": value, "site": int(r.get("addr", 0)), "reg": reg, "crossed_call": false}, r)
            }
            clobbered = true
            break
         }
         j -= 1
      }
      if !clobbered {
         def preds = _lifted_block_predecessors(rows, blocks, bi)
         mut pi = 0
         while pi < preds.len {
            def p = int(preds[pi])
            work = work.append({"block": p, "before": int(blocks[p].get("end", 0))})
            pi += 1
         }
      }
   }
   dict()
}

fn _copy_ref_fields(dict dst, dict src) dict {
   if src.get("ref_kind", "").len == 0 { return dst }
   dst.set("ref_kind", src.get("ref_kind", "")).set("ref_name", src.get("ref_name", ""))
   .set("ref_target", int(src.get("ref_target", 0))).set("ref", src.get("ref", dict()))
}

fn _resolve_reg_value(list rows, int before, str family, str reg, int depth=0, any bin0=dict()) dict {
   if reg.len == 0 || depth > 4 { return dict() }
   def bin = is_dict(bin0) ? bin0 : dict()
   mut j = before - 1
   mut crossed_call = false
   while j >= 0 && before - j <= 16 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "call" {
         if !_callee_saved_value_reg(family, reg) && !(bin.get("ok", false) && _local_call_preserves_reg(bin, r, family, reg)) { break }
         crossed_call = true
         j -= 1
         continue
      }
      if op == "branch" {
         if r.get("condition", "") == "always" || int(r.get("target", 0)) <= int(r.get("addr", 0)) { break }
         j -= 1
         continue
      }
      if op == "syscall" || op == "return" { break }
      if _alias_reg_for([reg], r.get("dst", "")) == reg {
         if (!((op == "assign" || op == "arith") && r.get("dst_kind", "") == "reg") &&
            !(op == "stack" && r.get("mnemonic", "") == "pop")){
            j -= 1
            continue
         }
         def value = _resolve_reg_row_value(bin, rows, j, r, depth)
         if _clean_row_saves_recent_call_result(rows, j) {
            return _copy_ref_fields({"value": reg, "site": int(r.get("addr", 0)), "reg": reg,
                  "crossed_call": crossed_call, "snapshot": "call_result"}, r)
         }
         def src_reg = _canonical_value_reg(family, value)
         if src_reg.len > 0 && src_reg != reg {
            def nested = _resolve_reg_value(rows, j, family, src_reg, depth + 1, bin)
            if nested.len > 0 {
               def nested_value = nested.get("value", "")
               if _clean_value_symbols_redefined_between(bin, rows, j + 1, before - 1, family, nested_value) {
                  return {"value": reg, "site": int(r.get("addr", 0)), "reg": reg, "stale": true,
                     "crossed_call": crossed_call}
               }
               def resolved = nested.set("via", value).set("resolved_site", int(r.get("addr", 0)))
               return resolved.set("crossed_call", crossed_call || nested.get("crossed_call", false))
            }
         }
         if _clean_value_symbols_redefined_between(bin, rows, j + 1, before - 1, family, value) {
            return {"value": reg, "site": int(r.get("addr", 0)), "reg": reg, "stale": true,
               "crossed_call": crossed_call}
         }
         return _copy_ref_fields({"value": value, "site": int(r.get("addr", 0)), "reg": reg,
               "crossed_call": crossed_call}, r)
      }
      j -= 1
   }
   dict()
}

fn _resolve_arg_value(list rows, int assign_idx, str family, dict arg) dict {
   def src_reg = _canonical_value_reg(family, arg.get("value", ""))
   if src_reg.len == 0 { return arg }
   def resolved = _resolve_reg_value(rows, assign_idx, family, src_reg)
   if resolved.len == 0 { return arg }
   if resolved.get("crossed_call", false) {
      def value_reg = _canonical_value_reg(family, resolved.get("value", ""))
      if value_reg.len == 0 || _abi_arg_index(family, value_reg) < 0 { return arg }
   }
   mut out = arg.set("value", resolved.get("value", arg.get("value", "")))
   .set("resolved_from", arg.get("value", "")).set("resolved_site", int(resolved.get("site", resolved.get("resolved_site", 0))))
   out = _copy_ref_fields(out, resolved)
   out
}

fn _call_arg_model(list rows, int idx) list {
   def regs = _abi_profile(idx >= 0 && idx < rows.len ? rows[idx].get("family", _rows_family(rows)) : _rows_family(rows)).get("args", [])
   _arg_model_for_regs(rows, idx, regs)
}

fn _stack_call_arg_index(str op) int {
   def plain = str.str_replace(_ny_operand(op), " ", "")
   if plain == "mem(esp)" { return 0 }
   if str.startswith(plain, "mem(esp+") && load8(plain, plain.len - 1) == 41 {
      def raw_off = slice(plain, 8, plain.len - 1, 1)
      def off0 = _parse_int_piece(raw_off)
      if off0 >= 0 && off0 % 4 == 0 { return off0 / 4 }
   }
   def mem = _fact_mem_expr(op)
   if mem.len == 0 { return -1 }
   if mem.get("base", "") != "esp" || mem.get("index", "").len > 0 { return -1 }
   def off = int(mem.get("offset", 0))
   if off < 0 || off % 4 != 0 { return -1 }
   off / 4
}

fn _call_stack_arg_model(dict bin, list rows, int idx) list {
   if idx < 0 || idx >= rows.len || arch(bin) != "x86" { return [] }
   mut by_slot = dict()
   mut max_slot = -1
   mut j = idx - 1
   while j >= 0 && idx - j <= 24 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "call" || op == "branch" || op == "syscall" || op == "return" { break }
      if op == "assign" && r.get("dst_kind", "") == "mem" {
         def slot = _stack_call_arg_index(r.get("dst", ""))
         if slot >= 0 && !by_slot.contains(to_str(slot)) {
            def value = _clean_store_src_expr_at(bin, rows, j - 1, r.get("src", ""))
            mut arg = {"reg": "stack" + to_str(slot), "stack_index": slot, "value": value,
               "site": int(r.get("addr", 0)), "effect": r.get("effect", "")}
            if r.get("ref_kind", "").len > 0 {
               arg = arg.set("ref_kind", r.get("ref_kind", "")).set("ref_name", r.get("ref_name", ""))
               .set("ref_target", int(r.get("ref_target", 0))).set("ref", r.get("ref", dict()))
            }
            by_slot = by_slot.set(to_str(slot), _arg_enrich(arg, slot))
            max_slot = max(max_slot, slot)
         }
      }
      j -= 1
   }
   mut out = []
   mut i = 0
   while i <= max_slot {
      if by_slot.contains(to_str(i)) { out = out.append(by_slot.get(to_str(i), dict())) }
      i += 1
   }
   out
}

fn _arg_value_kind(dict arg) str {
   if arg.get("ref_kind", "").len > 0 { return arg.get("ref_kind", "") }
   def v = str.strip(to_str(arg.get("value", "")))
   if v.len == 0 { return "unknown" }
   if _looks_int_literal(v) { return "literal" }
   if str.startswith(v, "&") { return "ptr" }
   if str.find(v, "(") >= 0 || str.find(v, "[") >= 0 || str.find(v, ".") >= 0 { return "expr" }
   "reg"
}

fn _arg_enrich(dict arg, int index) dict {
   def kind = _arg_value_kind(arg)
   mut out = arg.set("index", index).set("name", "arg" + to_str(index)).set("value_kind", kind)
   if kind == "literal" { out = out.set("value_int", _imm_value(to_str(arg.get("value", "0")))) }
   if arg.get("ref_kind", "") == "string" { out = out.set("string", arg.get("ref", dict()).get("value", "")) }
   out
}

fn _arg_model_for_regs(list rows, int idx, list regs) list {
   def family = idx >= 0 && idx < rows.len ? rows[idx].get("family", _rows_family(rows)) : _rows_family(rows)
   mut args = []
   mut filled = dict()
   mut j = idx - 1
   while j >= 0 && idx - j <= 24 {
      def r = rows[j]
      if r.get("op", "") == "call" || r.get("op", "") == "branch" || r.get("op", "") == "syscall" { break }
      if r.get("op", "") == "stack" && r.get("mnemonic", "") == "push" { j -= 1 continue }
      def wr = _alias_reg_for(regs, r.get("dst", ""))
      if wr.len > 0 && !filled.get(wr, false) {
         def value = _effect_rhs(r.get("effect", ""), _ny_operand(r.get("src", "")))
         if value.len > 0 {
            filled = filled.set(wr, true)
            mut arg = {"reg": wr, "value": value, "site": r.get("addr", 0), "effect": r.get("effect", "")}
            if r.get("ref_kind", "").len > 0 {
               arg = arg.set("ref_kind", r.get("ref_kind", "")).set("ref_name", r.get("ref_name", ""))
               .set("ref_target", int(r.get("ref_target", 0))).set("ref", r.get("ref", dict()))
            }
            arg = _resolve_arg_value(rows, j, family, arg)
            args = args.append(arg)
         }
      }
      j -= 1
   }
   mut ordered = []
   mut ri = 0
   while ri < regs.len {
      mut ai = 0
      while ai < args.len {
         if args[ai].get("reg", "") == regs[ri] { ordered = ordered.append(_arg_enrich(args[ai], ri)) }
         ai += 1
      }
      ri += 1
   }
   ordered
}

fn _value_for_reg(list args, str reg, str fallback) str {
   mut i = 0
   while i < args.len {
      if args[i].get("reg", "") == reg { return args[i].get("value", fallback) }
      i += 1
   }
   fallback
}

fn _syscall_profile_for_rows(list rows, int idx) dict {
   def family = (idx >= 0 && idx < rows.len) ? rows[idx].get("family", _rows_family(rows)) : _rows_family(rows)
   _syscall_profile_for_family(family)
}

fn _syscall_regs_for_profile(dict prof) list {
   [prof.get("nr", "rax")] + prof.get("args", [])
}

fn _syscall_lift_effect(str family) str {
   def p = _syscall_profile_for_family(family)
   def regs = _syscall_regs_for_profile(p)
   p.get("ret", "rax") + " = linux_syscall(" + str.join(regs, ", ") + ")"
}

fn _syscall_args_model(list rows, int idx) list {
   _arg_model_for_regs(rows, idx, _syscall_regs_for_profile(_syscall_profile_for_rows(rows, idx)))
}

fn _syscall_nr(list rows, int idx) int {
   def nr_reg = _syscall_profile_for_rows(rows, idx).get("nr", "rax")
   mut j = idx - 1
   while j >= 0 && idx - j <= 12 {
      def r = rows[j]
      if r.get("op", "") == "call" || r.get("op", "") == "branch" || r.get("op", "") == "syscall" { break }
      if _alias_reg_for([nr_reg], r.get("dst", "")) == nr_reg { return _imm_value(_effect_rhs(r.get("effect", ""), r.get("src", ""))) }
      j -= 1
   }
   -1
}

fn _syscall_render(list rows, int idx) str {
   def prof = _syscall_profile_for_rows(rows, idx)
   def family = (idx >= 0 && idx < rows.len) ? rows[idx].get("family", _rows_family(rows)) : _rows_family(rows)
   def args = _syscall_args_model(rows, idx)
   def nr = _syscall_nr(rows, idx)
   def regs = prof.get("args", [])
   def ret = prof.get("ret", "rax")
   def name = _syscall_name_for(family, nr)
   def a0 = _value_for_reg(args, regs.len > 0 ? regs[0] : "", "arg0")
   def a1 = _value_for_reg(args, regs.len > 1 ? regs[1] : "", "arg1")
   def a2 = _value_for_reg(args, regs.len > 2 ? regs[2] : "", "arg2")
   def a3 = _value_for_reg(args, regs.len > 3 ? regs[3] : "", "arg3")
   def a4 = _value_for_reg(args, regs.len > 4 ? regs[4] : "", "arg4")
   def a5 = _value_for_reg(args, regs.len > 5 ? regs[5] : "", "arg5")
   if name == "read" { return ret + " = sys_read(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "write" { return ret + " = sys_write(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "open" { return ret + " = sys_open(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "close" { return "sys_close(" + a0 + ")" }
   if name == "stat" || name == "stat64" { return ret + " = sys_" + name + "(" + a0 + ", " + a1 + ")" }
   if name == "fstat" || name == "fstat64" { return ret + " = sys_" + name + "(" + a0 + ", " + a1 + ")" }
   if name == "lstat" { return ret + " = sys_lstat(" + a0 + ", " + a1 + ")" }
   if name == "lseek" { return ret + " = sys_lseek(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "mmap" || name == "mmap2" { return ret + " = sys_" + name + "(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ", " + a4 + ", " + a5 + ")" }
   if name == "mprotect" { return ret + " = sys_mprotect(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "munmap" { return ret + " = sys_munmap(" + a0 + ", " + a1 + ")" }
   if name == "brk" { return ret + " = sys_brk(" + a0 + ")" }
   if name == "ioctl" { return ret + " = sys_ioctl(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "readv" { return ret + " = sys_readv(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "writev" { return ret + " = sys_writev(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "access" || name == "faccessat" { return ret + " = sys_" + name + "(" + a0 + ", " + a1 + ")" }
   if name == "pipe" { return ret + " = sys_pipe(" + a0 + ")" }
   if name == "sched_yield" { return ret + " = sys_sched_yield()" }
   if name == "madvise" { return ret + " = sys_madvise(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "dup" { return ret + " = sys_dup(" + a0 + ")" }
   if name == "dup2" { return ret + " = sys_dup2(" + a0 + ", " + a1 + ")" }
   if name == "dup3" { return ret + " = sys_dup3(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "nanosleep" { return ret + " = sys_nanosleep(" + a0 + ", " + a1 + ")" }
   if name == "getpid" || name == "fork" || name == "vfork" || name == "getuid" || name == "getgid" || name == "geteuid" || name == "getegid" || name == "getppid" || name == "gettid" { return ret + " = sys_" + name + "()" }
   if name == "socket" { return ret + " = sys_socket(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "connect" { return ret + " = sys_connect(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "sendto" || name == "recvfrom" { return ret + " = sys_" + name + "(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ", " + a4 + ", " + a5 + ")" }
   if name == "clone" { return ret + " = sys_clone(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ", " + a4 + ")" }
   if name == "execve" { return ret + " = sys_execve(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "wait4" { return ret + " = sys_wait4(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ")" }
   if name == "kill" { return ret + " = sys_kill(" + a0 + ", " + a1 + ")" }
   if name == "uname" { return ret + " = sys_uname(" + a0 + ")" }
   if name == "fcntl" || name == "fcntl64" { return ret + " = sys_" + name + "(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "readlink" { return ret + " = sys_readlink(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "gettimeofday" { return ret + " = sys_gettimeofday(" + a0 + ", " + a1 + ")" }
   if name == "ptrace" { return ret + " = sys_ptrace(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ")" }
   if name == "prctl" { return ret + " = sys_prctl(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ", " + a4 + ")" }
   if name == "arch_prctl" { return ret + " = sys_arch_prctl(" + a0 + ", " + a1 + ")" }
   if name == "time" { return ret + " = sys_time(" + a0 + ")" }
   if name == "clock_gettime" { return ret + " = sys_clock_gettime(" + a0 + ", " + a1 + ")" }
   if name == "tgkill" { return ret + " = sys_tgkill(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "openat" { return ret + " = sys_openat(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ")" }
   if name == "newfstatat" { return ret + " = sys_newfstatat(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ")" }
   if name == "readlinkat" { return ret + " = sys_readlinkat(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ")" }
   if name == "pipe2" { return ret + " = sys_pipe2(" + a0 + ", " + a1 + ")" }
   if name == "getrandom" { return ret + " = sys_getrandom(" + a0 + ", " + a1 + ", " + a2 + ")" }
   if name == "statx" { return ret + " = sys_statx(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ", " + a4 + ")" }
   if name == "exit" || name == "exit_group" { return "sys_" + name + "(" + a0 + ")" }
   ret + " = linux_syscall(" + str.join(_syscall_regs_for_profile(prof), ", ") + ")"
}

fn _next_syscall_nr(list rows, int idx) int {
   mut i = idx + 1
   while i < rows.len && i - idx <= 10 {
      def op = rows[i].get("op", "")
      if op == "syscall" {
         def nr_reg = _syscall_profile_for_rows(rows, i).get("nr", "rax")
         mut j = i - 1
         while j >= 0 && i - j <= 12 {
            def r = rows[j]
            if r.get("op", "") == "call" || r.get("op", "") == "branch" || r.get("op", "") == "syscall" { break }
            if _alias_reg_for([nr_reg], r.get("dst", "")) == nr_reg { return _imm_value(_effect_rhs(r.get("effect", ""), r.get("src", ""))) }
            j -= 1
         }
         return -1
      }
      if op == "call" || op == "branch" || op == "return" { return -1 }
      i += 1
   }
   -1
}

fn _next_syscall_family(list rows, int idx) str {
   mut i = idx + 1
   while i < rows.len && i - idx <= 10 {
      def op = rows[i].get("op", "")
      if op == "syscall" { return rows[i].get("family", _rows_family(rows)) }
      if op == "call" || op == "branch" || op == "return" { return _rows_family(rows) }
      i += 1
   }
   _rows_family(rows)
}

fn _syscall_setup_effect(list rows, int idx, dict row) str {
   def op = row.get("op", "")
   if op != "assign" && op != "arith" { return "" }
   def reg = _alias_reg(row.get("dst", ""))
   if reg.len == 0 { return "" }
   def nr = _next_syscall_nr(rows, idx)
   if nr < 0 { return "" }
   def label = _syscall_arg_label_for(_next_syscall_family(rows, idx), nr, reg)
   label + " = " + (label == "syscall_nr" ? to_str(nr) : _effect_rhs(row.get("effect", ""), _ny_operand(row.get("src", ""))))
}

fn _call_record(dict bin, dict sig, list rows, int idx) dict {
   def r = rows[idx]
   def args = bin.len > 0 ? _call_arg_model_with_sig(bin, sig, rows, idx) : _call_arg_model(rows, idx)
   {"addr": r.get("addr", 0), "name": r.get("target_name", ""), "target": r.get("target", 0),
      "mem_target": r.get("mem_target", 0), "args": args,
      "argc": args.len, "effect": _call_render(r.get("target_name", "call_target"), args, r.get("family", _rows_family(rows)))}
}

fn _calls_model(list rows, any bin0=dict(), any sig0=dict()) list {
   def bin = is_dict(bin0) ? bin0 : dict()
   def sig = is_dict(sig0) ? sig0 : dict()
   mut out = []
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "call" {
         out = out.append(_call_record(bin, sig, rows, i))
      }
      i += 1
   }
   out
}

fn _type_fields_from_offsets_widths(list offsets, list widths) list {
   mut out = []
   mut i = 0
   while i < offsets.len {
      def off = int(offsets[i])
      def width = i < widths.len ? int(widths[i]) : 0
      out = out.append({"name": "field_" + str.to_hex(_iabs(off), 0), "offset": off,
            "raw_name": "field_" + str.to_hex(_iabs(off), 0),
            "type": _type_field_type_from_width(width), "width": width})
      i += 1
   }
   out
}

fn _type_default_field(int off) dict {
   def raw = "field_" + str.to_hex(_iabs(off), 0)
   {"name": raw, "raw_name": raw, "offset": off, "type": "unknown", "width": 0}
}

fn _type_field_generic_name(str name, int off) bool {
   name.len == 0 || name == "field_" + str.to_hex(_iabs(off), 0)
}

fn _type_merge_field(list fields0, dict f0) list {
   mut fields = fields0
   def off = int(f0.get("offset", 0))
   def pos = _field_pos(fields, off)
   if pos < 0 { return fields.append(f0) }
   mut f = fields[pos]
   def keys = f0.keys()
   mut i = 0
   while i < keys.len {
      def k = to_str(keys[i])
      if k == "name" {
         def next = f0.get(k, "")
         if !_type_field_generic_name(next, off) && _type_field_generic_name(f.get("name", ""), off) {
            f = f.set(k, next)
         }
      } elif k == "type" || k == "role" {
         def cur = f.get(k, "")
         def next = f0.get(k, "")
         if next.len > 0 && (cur.len == 0 || cur == "unknown" || cur == "value" || cur == "constant") {
            f = f.set(k, f0.get(k, ""))
         }
      } elif k == "width" {
         if int(f.get(k, 0)) == 0 && int(f0.get(k, 0)) > 0 { f = f.set(k, f0.get(k, 0)) }
      } elif k == "raw_name" {
         if f.get(k, "").len == 0 { f = f.set(k, f0.get(k, "")) }
      }
      i += 1
   }
   fields.set(pos, f)
}

fn _type_field_role_name(str role, int off) str {
   if role == "byte_index" { return "index" }
   if role == "derived_byte" { return "byte" }
   if role == "data_ptr" { return "data" }
   if role == "string_ptr" { return "text" }
   if role == "size" { return "size" }
   "field_" + str.to_hex(_iabs(off), 0)
}

fn _type_rhs_field_hint(str rhs0) dict {
   def rhs = str.strip(rhs0)
   if rhs.len == 0 { return dict() }
   if str.find(rhs, "byte_at(") >= 0 { return {"type": "u8", "role": "derived_byte"} }
   if str.find(rhs, "data_") >= 0 || str.find(rhs, "[rip]") >= 0 || str.find(rhs, "&data_") >= 0 {
      return {"type": "ptr", "role": "data_ptr"}
   }
   if str.find(rhs, "str_") >= 0 || (rhs.len >= 2 && (load8(rhs, 0) == 34 || load8(rhs, 0) == 39)) {
      return {"type": "const char*", "role": "string_ptr"}
   }
   if _looks_int_literal(rhs) { return {"type": "int", "role": "constant"} }
   if str.startswith(rhs, "local_") || str.startswith(rhs, "arg") {
      return {"type": "int", "role": "value"}
   }
   dict()
}

fn _type_field_hint_for_access(str name, int off, str raw, str access, dict parts) dict {
   mut hint = dict()
   if access == "write" && parts.len > 0 {
      hint = _type_rhs_field_hint(parts.get("rhs", ""))
   }
   if str.find(raw, "byte_at(") >= 0 && str.find(raw, name + "[" + to_str(off) + "]") >= 0 {
      if access == "read" || hint.len == 0 { hint = {"type": "int", "role": "byte_index"} }
   }
   if hint.len == 0 { return dict() }
   def role = hint.get("role", "")
   def fname = _type_field_role_name(role, off)
   _type_default_field(off).set("name", fname).set("type", hint.get("type", "unknown")).set("role", role)
}

fn _type_unique_fields(list fields0) list {
   mut out = []
   mut used = dict()
   mut i = 0
   while i < fields0.len {
      mut f = fields0[i]
      def off = int(f.get("offset", 0))
      def raw = f.get("raw_name", "field_" + str.to_hex(_iabs(off), 0))
      mut name = _safe_name(f.get("name", raw), raw)
      if used.get(name, false) {
         name = name + "_" + str.to_hex(_iabs(off), 0)
      }
      used = used.set(name, true)
      out = out.append(f.set("name", name).set("raw_name", raw))
      i += 1
   }
   out
}

fn _type_local_pos(list locals, str name) int {
   mut i = 0
   while i < locals.len {
      if locals[i].get("name", "") == name { return i }
      i += 1
   }
   -1
}

fn _type_merge_local(list locals0, dict rec0) list {
   if rec0.get("name", "").len == 0 { return locals0 }
   mut locals = locals0
   def pos = _type_local_pos(locals, rec0.get("name", ""))
   if pos < 0 { return locals.append(rec0) }
   mut rec = locals[pos]
   def keys = rec0.keys()
   mut i = 0
   while i < keys.len {
      def k = to_str(keys[i])
      if k == "evidence" {
         mut ev = rec.get(k, [])
         def more = rec0.get(k, [])
         mut ei = 0
         while ei < more.len {
            ev = ev.append(more[ei])
            ei += 1
         }
         rec = rec.set(k, ev)
      } elif k == "fields" {
         def fs = rec0.get(k, [])
         mut j = 0
         mut cur = rec.get(k, [])
         while j < fs.len {
            cur = _type_merge_field(cur, fs[j])
            j += 1
         }
         rec = rec.set(k, cur)
      } elif !rec.contains(k) || to_str(rec.get(k, "")).len == 0 || rec.get(k, "unknown") == "unknown" {
         rec = rec.set(k, rec0.get(k, nil))
      } elif (k == "alloc_size" || k == "buffer_size" || k == "field_count") && int(rec.get(k, 0)) == 0 {
         rec = rec.set(k, rec0.get(k, nil))
      }
      i += 1
   }
   locals.set(pos, rec)
}

fn _type_arg_size_hint(list args) int {
   mut elem = 0
   mut count = 0
   mut i = 0
   while i < args.len {
      def role = args[i].get("role", "")
      def iv = _type_int_arg_value(args[i])
      if iv.get("ok", false) {
         if role == "buffer_size" || role == "compare_size" { return int(iv.get("value", 0)) }
         if role == "element_size" { elem = int(iv.get("value", 0)) }
         elif role == "element_count" { count = int(iv.get("value", 0)) }
      }
      i += 1
   }
   (elem > 0 && count > 0) ? elem * count : 0
}

fn _type_local_record_for_arg(dict call, dict arg) dict {
   def role = arg.get("role", "")
   def lname = _type_local_name_from_arg(arg.get("value", ""))
   if lname.len == 0 { return dict() }
   def cname = call.get("name", "")
   def sz = _type_arg_size_hint(call.get("args", []))
   mut typ = arg.get("type", "unknown")
   mut shape = ""
   if role == "input_buffer" {
      typ = cname == "fgets" ? "char[]" : "bytes[]"
      shape = "input_buffer"
   } elif role == "write_buffer" {
      typ = "bytes[]"
      shape = "write_buffer"
   } elif role == "read_buffer" {
      typ = "const bytes*"
      shape = "read_buffer"
   } elif (role == "string" || role == "path" || role == "mode" ||
      role == "compare_lhs" || role == "compare_rhs"){
      typ = str.find(typ, "char") >= 0 ? typ : "const char*"
      shape = "string"
   } elif role == "allocation" {
      typ = "void*"
      shape = "heap_ptr"
   } else {
      return dict()
   }
   {"name": lname, "kind": "local", "type": typ, "shape": shape,
      "role": role, "buffer_size": sz, "source": cname,
      "evidence": [{"kind": "call_arg", "addr": int(call.get("addr", 0)),
            "call": cname, "role": role, "size": sz, "value": arg.get("value", "")}]}
}

fn _type_suggest_base(dict rec) str {
   def shape = rec.get("shape", "")
   def role = rec.get("role", "")
   def source = rec.get("source", "")
   def typ = rec.get("type", "")
   if role == "loop_counter" { return "i" }
   if role == "password_int" { return "password" }
   if role == "password_text" { return "password_buf" }
   if role == "input_int" { return "input_int" }
   if role == "input_text" { return "input_buf" }
   if shape == "list_node" { return "node" }
   if shape == "input_buffer" || role == "input_buffer" { return "input_buf" }
   if shape == "write_buffer" || role == "write_buffer" { return "out_buf" }
   if shape == "read_buffer" || role == "read_buffer" { return "src_buf" }
   if shape == "heap_struct" { return "heap_obj" }
   if shape == "heap_ptr" && (source == "malloc" || source == "calloc" || source == "realloc") { return "heap_ptr" }
   if shape == "local_struct" || rec.get("fields", []).len >= 2 { return "stack_obj" }
   if shape == "string" || str.find(typ, "char") >= 0 { return "text" }
   if typ == "FILE*" { return "stream" }
   ""
}

fn _type_unique_suggestion(str base0, dict used0) list {
   def base = _safe_name(base0, "value")
   mut used = used0
   mut name = base
   mut n = 2
   while used.get(name, false) {
      name = base + "_" + to_str(n)
      n += 1
   }
   [name, used.set(name, true)]
}

fn _type_struct_name_for_local(dict rec) str {
   def name = rec.get("name", "")
   name.len > 0 ? (name + "_t") : "anon_struct_t"
}

fn _type_finalize_recovery(dict rec0) dict {
   mut rec = rec0
   mut locals = []
   mut renames = dict()
   mut used = dict()
   def raw_locals = rec.get("locals", [])
   mut i = 0
   while i < raw_locals.len {
      mut lr = raw_locals[i]
      if lr.get("fields", []).len > 0 { lr = lr.set("fields", _type_unique_fields(lr.get("fields", []))) }
      if lr.get("fields", []).len >= 2 && lr.get("shape", "") == "heap_ptr" {
         lr = lr.set("shape", "heap_struct").set("type", "struct*")
      }
      if lr.get("fields", []).len >= 2 && lr.get("struct_name", "").len == 0 {
         lr = lr.set("struct_name", _type_struct_name_for_local(lr))
      }
      def base = _type_suggest_base(lr)
      if base.len > 0 && lr.get("suggested_name", "").len == 0 {
         def picked = _type_unique_suggestion(base, used)
         def sname = picked[0]
         used = picked[1]
         lr = lr.set("suggested_name", sname)
         if lr.get("name", "") != sname { renames = renames.set(lr.get("name", ""), sname) }
      } elif lr.get("suggested_name", "").len > 0 {
         used = used.set(lr.get("suggested_name", ""), true)
         if lr.get("name", "") != lr.get("suggested_name", "") {
            renames = renames.set(lr.get("name", ""), lr.get("suggested_name", ""))
         }
      }
      if lr.get("suggested_type", "").len == 0 && lr.get("type", "").len > 0 {
         lr = lr.set("suggested_type", lr.get("type", "unknown"))
      }
      locals = locals.append(lr)
      i += 1
   }
   rec.set("locals", locals).set("renames", renames)
   .set("rename_count", renames.keys().len)
   .set("local_count", locals.len)
}

fn _type_local_name_from_arg(str arg0) str {
   mut arg = str.strip(arg0)
   if str.startswith(arg, "&") { arg = str.strip(slice(arg, 1, arg.len, 1)) }
   if !str.startswith(arg, "local_") { return "" }
   mut end = 0
   while end < arg.len && _symbol_is_name_char(load8(arg, end)) { end += 1 }
   slice(arg, 0, end, 1)
}

fn _type_rendered_named_call_args(str raw0, str name) list {
   def raw = str.strip(raw0)
   def needle = name + "("
   mut p = str.find(raw, needle)
   while p >= 0 && p > 0 && _symbol_is_name_char(load8(raw, p - 1)) {
      def tail = slice(raw, p + 1, raw.len, 1)
      def next = str.find(tail, needle)
      if next < 0 { p = -1 }
      else { p = p + 1 + next }
   }
   if p < 0 { return [] }
   def end = _clean_call_end_at(raw, p, name)
   if end <= p { return [] }
   _clean_call_args(slice(raw, p + name.len + 1, end - 1, 1))
}

fn _type_expr_call_name(str expr0) str {
   def expr = str.strip(expr0)
   def p = str.find(expr, "(")
   if p <= 0 { return "" }
   def name = str.strip(slice(expr, 0, p, 1))
   mut i = 0
   while i < name.len {
      def ch = load8(name, i)
      if !_symbol_is_name_char(ch) { return "" }
      i += 1
   }
   name
}

fn _type_rendered_add_offset(dict groups0, str name, int off, str raw, str access, dict parts) dict {
   mut groups = groups0
   mut g = groups.get(name, {"name": name, "kind": "local", "type": "unknown", "shape": "unknown",
         "offsets": [], "fields": [], "evidence": []})
   g = g.set("offsets", _int_insert_sorted_unique(g.get("offsets", []), off))
   mut f = _type_default_field(off)
   def hint = _type_field_hint_for_access(name, off, str.strip(raw), access, parts)
   if hint.len > 0 { f = hint }
   g = g.set("fields", _type_merge_field(g.get("fields", []), f))
   g = g.set("evidence", g.get("evidence", []).append({"kind": "indexed_access", "offset": off,
            "access": access, "text": str.strip(raw)}))
   groups.set(name, g)
}

fn _type_rendered_scan_local_indexes(dict groups0, str raw0) dict {
   mut groups = groups0
   def raw = str.strip(raw0)
   def parts = _clean_rendered_assignment_parts(raw)
   def eq = str.find(raw, " = ")
   def lhs_text = eq > 0 ? str.strip(slice(raw, 0, eq, 1)) : ""
   def rhs_text = eq > 0 ? str.strip(slice(raw, eq + 3, raw.len, 1)) : ""
   def any_parts = eq > 0 ? {"lhs": lhs_text, "rhs": rhs_text} : parts
   mut i = 0
   while i < raw.len {
      if i + 6 <= raw.len && slice(raw, i, i + 6, 1) == "local_" {
         def start = i
         while i < raw.len && _symbol_is_name_char(load8(raw, i)) { i += 1 }
         def name = slice(raw, start, i, 1)
         if i < raw.len && load8(raw, i) == 91 {
            mut close = i + 1
            while close < raw.len && load8(raw, close) != 93 { close += 1 }
            if close < raw.len {
               def idx = str.strip(slice(raw, i + 1, close, 1))
               if _looks_int_literal(idx) {
                  def token = name + "[" + idx + "]"
                  def access = lhs_text.len > 0 && str.find(lhs_text, token) >= 0 ? "write" : "read"
                  groups = _type_rendered_add_offset(groups, name, _parse_int_piece(idx), raw, access, any_parts)
               }
               i = close + 1
               continue
            }
         }
         continue
      }
      i += 1
   }
   groups
}

fn _type_rendered_self_next_offsets(list lines) dict {
   mut out = dict()
   mut i = 0
   while i < lines.len {
      def raw = str.strip(lines[i])
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 {
         def lhs = parts.get("lhs", "")
         def rhs = str.strip(parts.get("rhs", ""))
         if str.startswith(lhs, "local_") && str.startswith(rhs, lhs + "[") && str.endswith(rhs, "]") {
            def idx = str.strip(slice(rhs, lhs.len + 1, rhs.len - 1, 1))
            if _looks_int_literal(idx) {
               out = out.set(lhs, _parse_int_piece(idx))
            }
         }
      }
      i += 1
   }
   out
}

fn _type_list_node_field_name(int off, int next_off) str {
   if off == next_off { return "next" }
   if off == 0 { return "value" }
   if next_off > 0 && off > 0 && off < next_off { return "key" }
   "field_" + str.to_hex(_iabs(off), 0)
}

fn _type_mark_list_node_fields(list fields0, int next_off) list {
   mut out = []
   mut i = 0
   while i < fields0.len {
      mut f = fields0[i]
      def off = int(f.get("offset", 0))
      def name = _type_list_node_field_name(off, next_off)
      if name == "next" {
         f = f.set("name", "next").set("type", "ptr").set("role", "next_ptr")
      } elif name == "key" {
         f = f.set("name", "key").set("type", "u8").set("role", "key_byte")
      } elif name == "value" {
         f = f.set("name", "value").set("type", "int").set("role", "value")
      }
      out = out.append(f)
      i += 1
   }
   out
}

fn _type_loop_condition_parts(str raw0) dict {
   def raw = str.strip(raw0)
   if !str.startswith(raw, "while (") || !str.endswith(raw, "{") { return dict() }
   if raw == "while true{" || raw.len <= 8 { return dict() }
   def cond = str.strip(slice(raw, 6, raw.len - 2, 1))
   def ops = [" <= ", " >= ", " < ", " > ", " == ", " != "]
   mut oi = 0
   while oi < ops.len {
      def op = ops[oi]
      def p = _clean_top_level_find(cond, op)
      if p > 0 {
         def lhs = str.strip(slice(cond, 0, p, 1))
         def rhs = str.strip(slice(cond, p + op.len, cond.len, 1))
         if str.startswith(lhs, "local_") {
            return {"name": lhs, "op": str.strip(op), "bound": rhs, "condition": cond}
         }
      }
      oi += 1
   }
   dict()
}

fn _type_for_loop_parts(str raw0) dict {
   def raw = str.strip(raw0)
   if !str.startswith(raw, "for ") || !str.endswith(raw, "{") { return dict() }
   def body = str.strip(slice(raw, 4, raw.len - 1, 1))
   def p = _clean_top_level_find(body, " in ")
   if p <= 0 { return dict() }
   def name = str.strip(slice(body, 0, p, 1))
   if !str.startswith(name, "local_") { return dict() }
   def range_expr = str.strip(slice(body, p + 4, body.len, 1))
   if range_expr.len == 0 { return dict() }
   {"name": name, "range": range_expr, "condition": raw}
}

fn _type_rendered_counter_init(list lines, int before, str name) dict {
   mut j = before - 1
   mut guard = 0
   while j >= 0 && guard < 8 {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j -= 1
         guard += 1
         continue
      }
      if raw == "}" || raw == "} else {" || _clean_rendered_label_name(raw).len > 0 { return dict() }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 {
         if parts.get("lhs", "") == name && _looks_int_literal(parts.get("rhs", "")) {
            return {"ok": true, "line": j, "value": _parse_int_piece(parts.get("rhs", "")), "text": raw}
         }
         return dict()
      }
      j -= 1
      guard += 1
   }
   dict()
}

fn _type_rendered_counter_step_line(str raw0, str name) dict {
   def raw = str.strip(raw0)
   def parts = _clean_rendered_assignment_parts(raw)
   if parts.len == 0 || parts.get("lhs", "") != name { return dict() }
   def rhs = str.strip(parts.get("rhs", ""))
   mut p = _clean_top_level_find(rhs, " + ")
   if p > 0 {
      def lhs = str.strip(slice(rhs, 0, p, 1))
      def rv = str.strip(slice(rhs, p + 3, rhs.len, 1))
      if lhs == name && _looks_int_literal(rv) {
         return {"ok": true, "step": _parse_int_piece(rv), "text": raw}
      }
   }
   p = _clean_top_level_find(rhs, " - ")
   if p > 0 {
      def lhs = str.strip(slice(rhs, 0, p, 1))
      def rv = str.strip(slice(rhs, p + 3, rhs.len, 1))
      if lhs == name && _looks_int_literal(rv) {
         return {"ok": true, "step": -_parse_int_piece(rv), "text": raw}
      }
   }
   dict()
}

fn _type_rendered_scanf_local(dict groups0, str text, str raw, str name) dict {
   def args = _type_rendered_named_call_args(raw, name)
   if args.len < 2 { return groups0 }
   def fmt = str.strip(args[0])
   def lname = _type_local_name_from_arg(args[1])
   if lname.len == 0 { return groups0 }
   def lower_text = str.lower(text)
   def password_hint = str.find(lower_text, "password") >= 0 || str.find(lower_text, "passphrase") >= 0
   mut typ = "unknown"
   mut shape = "scalar"
   mut role = "input"
   if (str.find(fmt, "%d") >= 0 || str.find(fmt, "%i") >= 0 || str.find(fmt, "%u") >= 0 ||
      str.find(fmt, "%x") >= 0){
      typ = "int"
      role = password_hint ? "password_int" : "input_int"
   } elif str.find(fmt, "%s") >= 0 || str.find(fmt, "%c") >= 0 {
      typ = "char[]"
      shape = "input_buffer"
      role = password_hint ? "password_text" : "input_text"
   } else {
      return groups0
   }
   mut groups = groups0
   mut g = groups.get(lname, {"name": lname, "kind": "local", "type": typ, "shape": shape,
         "offsets": [], "fields": [], "evidence": []})
   g = g.set("type", typ).set("shape", shape).set("role", role).set("source", name)
   .set("evidence", g.get("evidence", []).append({"kind": "call_arg", "call": name,
            "role": role, "format": fmt, "text": raw}))
   groups.set(lname, g)
}

fn _type_rendered_counter_step(list lines, int loop_idx, str name) dict {
   mut depth = 1
   mut j = loop_idx + 1
   mut guard = 0
   mut found = dict()
   while j < lines.len && depth > 0 && guard < 160 {
      def raw = str.strip(lines[j])
      if raw.len > 0 && found.len == 0 {
         def step = _type_rendered_counter_step_line(raw, name)
         if step.get("ok", false) { found = step.set("line", j) }
      }
      mut k = 0
      while k < raw.len {
         def ch = load8(raw, k)
         if ch == 123 { depth += 1 }
         elif ch == 125 { depth -= 1 }
         k += 1
      }
      j += 1
      guard += 1
   }
   if depth == 0 && found.len > 0 { return found }
   dict()
}

fn _type_rendered_loop_counters(list lines) list {
   mut out = []
   mut used = dict()
   mut i = 0
   while i < lines.len {
      def fparts = _type_for_loop_parts(lines[i])
      if fparts.len > 0 {
         def fname = fparts.get("name", "")
         if !used.get(fname, false) {
            used = used.set(fname, true)
            out = out.append({"name": fname, "kind": "local", "type": "int", "shape": "scalar",
                  "role": "loop_counter", "source": "rendered_for", "range": fparts.get("range", ""),
                  "condition": fparts.get("condition", ""),
                  "evidence": [{"kind": "loop_counter_for", "line": i, "text": str.strip(lines[i])}]})
         }
         i += 1
         continue
      }
      def cond = _type_loop_condition_parts(lines[i])
      if cond.len > 0 {
         def name = cond.get("name", "")
         if !used.get(name, false) {
            def init = _type_rendered_counter_init(lines, i, name)
            def step = _type_rendered_counter_step(lines, i, name)
            if init.get("ok", false) && step.get("ok", false) {
               used = used.set(name, true)
               out = out.append({"name": name, "kind": "local", "type": "int", "shape": "scalar",
                     "role": "loop_counter", "source": "rendered_loop",
                     "initial": int(init.get("value", 0)), "step": int(step.get("step", 0)),
                     "bound": cond.get("bound", ""), "condition": cond.get("condition", ""),
                     "evidence": [{"kind": "loop_counter_init", "line": int(init.get("line", 0)), "text": init.get("text", "")},
                        {"kind": "loop_counter_condition", "line": i, "text": str.strip(lines[i])},
                        {"kind": "loop_counter_step", "line": int(step.get("line", 0)), "text": step.get("text", "")}]})
            }
         }
      }
      i += 1
   }
   out
}

fn _type_rendered_local_layouts(str text) list {
   def lines = str.split(text, "\n")
   mut groups = dict()
   def next_offsets = _type_rendered_self_next_offsets(lines)
   mut i = 0
   while i < lines.len {
      def raw = str.strip(lines[i])
      if raw.len > 0 {
         def parts = _clean_rendered_assignment_parts(raw)
         if parts.len > 0 && _clean_local_slot_offset(parts.get("lhs", "")).len > 0 {
            def cname = _type_expr_call_name(parts.get("rhs", ""))
            def args0 = _clean_rendered_expr_call_args(parts.get("rhs", ""))
            def sig = _type_library_signature(cname)
            if sig.len > 0 {
               def ret = sig.get("return", dict())
               if ret.get("shape", "") == "heap_ptr" {
                  def size = _type_alloc_size_from_args(cname, _args_from_values(args0))
                  def lname = parts.get("lhs", "")
                  mut g = groups.get(lname, {"name": lname, "kind": "local", "type": "void*", "shape": "heap_ptr",
                        "offsets": [], "fields": [], "evidence": []})
                  g = g.set("type", "void*").set("shape", "heap_ptr").set("alloc_size", size)
                  .set("source", cname).set("evidence", g.get("evidence", []).append({"kind": "call_return",
                           "call": cname, "size": size, "text": raw}))
                  groups = groups.set(lname, g)
               }
            }
         }
         groups = _type_rendered_scan_local_indexes(groups, raw)
         groups = _type_rendered_scanf_local(groups, text, raw, "scanf")
         groups = _type_rendered_scanf_local(groups, text, raw, "__isoc99_scanf")
         groups = _type_rendered_scanf_local(groups, text, raw, "__isoc23_scanf")
         def fgets_args = _type_rendered_named_call_args(raw, "fgets")
         if fgets_args.len >= 2 {
            def lname = _type_local_name_from_arg(fgets_args[0])
            if lname.len > 0 {
               def sz = _looks_int_literal(str.strip(fgets_args[1])) ? _parse_int_piece(str.strip(fgets_args[1])) : 0
               mut g = groups.get(lname, {"name": lname, "kind": "local", "type": "char[]", "shape": "input_buffer",
                     "offsets": [], "fields": [], "evidence": []})
               g = g.set("type", "char[]").set("shape", "input_buffer").set("buffer_size", sz)
               .set("source", "fgets").set("evidence", g.get("evidence", []).append({"kind": "call_arg",
                        "call": "fgets", "role": "input_buffer", "size": sz, "text": raw}))
               groups = groups.set(lname, g)
            }
         }
      }
      i += 1
   }
   def counters = _type_rendered_loop_counters(lines)
   i = 0
   while i < counters.len {
      def c = counters[i]
      def name = c.get("name", "")
      mut g = groups.get(name, {"name": name, "kind": "local", "type": "unknown", "shape": "unknown",
            "offsets": [], "fields": [], "evidence": []})
      g = _type_merge_local([g], c)[0]
      groups = groups.set(name, g)
      i += 1
   }
   mut out = []
   def keys = groups.keys()
   i = 0
   while i < keys.len {
      mut g = groups.get(keys[i], dict())
      def name = g.get("name", to_str(keys[i]))
      def offs = g.get("offsets", [])
      def next_off = int(next_offsets.get(name, -1))
      if next_off >= 0 && offs.len >= 2 {
         g = g.set("type", "struct*").set("shape", "list_node").set("next_offset", next_off)
         .set("fields", _type_mark_list_node_fields(g.get("fields", []), next_off))
         .set("evidence", g.get("evidence", []).append({"kind": "self_next", "offset": next_off}))
      } elif offs.len >= 2 && g.get("shape", "") == "heap_ptr" {
         g = g.set("type", "struct*").set("shape", "heap_struct")
      } elif offs.len >= 2 && g.get("shape", "") == "unknown" {
         g = g.set("type", "struct_like").set("shape", "local_struct")
      }
      if offs.len > 0 {
         g = g.set("field_count", g.get("fields", []).len)
         .set("min_offset", int(offs[0])).set("max_offset", int(offs[offs.len - 1]))
         .set("stride", _offset_stride(offs))
      }
      out = out.append(g)
      i += 1
   }
   out
}

fn _type_rendered_known_calls(str text) list {
   def names = ["malloc", "calloc", "realloc", "free", "fgets", "fread", "read",
      "memcpy", "memmove", "memset", "memfrob", "strcmp", "strncmp", "memcmp",
      "strlen", "atoi", "strtol", "fopen", "fclose"]
   def lines = str.split(text, "\n")
   mut out = []
   mut i = 0
   while i < lines.len {
      def raw = str.strip(lines[i])
      mut ni = 0
      while ni < names.len {
         def args = _type_rendered_named_call_args(raw, names[ni])
         if args.len > 0 {
            def rec = _type_known_call_record(names[ni], _args_from_values(args), {"source": "rendered", "line": i})
            if rec.len > 0 { out = out.append(rec) }
         }
         ni += 1
      }
      i += 1
   }
   out
}

fn _args_from_values(list vals) list {
   mut out = []
   mut i = 0
   while i < vals.len {
      out = out.append({"value": str.strip(to_str(vals[i])), "index": i})
      i += 1
   }
   out
}

fn _type_recovery_from_rows(dict bin, any target, list rows, dict factset, dict sig, int max_bytes) dict {
   mut typed_calls = []
   mut locals = []
   mut structs = []
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "call" {
         def args = _call_arg_model_with_sig(bin, sig, rows, i)
         def rec = _type_known_call_record(r.get("target_name", ""), args,
            {"source": "rows", "addr": int(r.get("addr", 0)), "target": int(r.get("target", 0))})
         if rec.len > 0 {
            typed_calls = typed_calls.append(rec)
            def ret = rec.get("return", dict())
            if ret.get("shape", "") == "heap_ptr" {
               def saved = _clean_call_result_saved_after(rows, i)
               def dst = saved.get("ok", false) ? saved.get("dst", "") : ""
               if _clean_local_slot_offset(dst).len > 0 {
                  locals = _type_merge_local(locals, {"name": dst, "kind": "local", "type": "void*",
                        "shape": "heap_ptr", "alloc_size": _type_alloc_size_from_args(rec.get("name", ""), args),
                        "source": rec.get("name", ""), "evidence": [{"kind": "call_return", "addr": int(r.get("addr", 0)),
                              "call": rec.get("name", "")}]})
               }
            }
            def targs = rec.get("args", [])
            mut ai = 0
            while ai < targs.len {
               def lrec = _type_local_record_for_arg(rec, targs[ai])
               if lrec.len > 0 { locals = _type_merge_local(locals, lrec) }
               ai += 1
            }
         }
      }
      i += 1
   }
   def params = sig.get("params", [])
   i = 0
   while i < params.len {
      def p = params[i]
      if p.get("fields", []).len > 0 {
         structs = structs.append({"name": p.get("name", "arg" + to_str(i)) + "_t",
               "owner": p.get("name", ""), "owner_kind": "param", "shape": p.get("shape", "struct_ptr"),
               "type": p.get("type", "struct"), "fields": p.get("fields", []), "source": "signature"})
      }
      i += 1
   }
   def shapes = factset.get("memory_shapes", [])
   i = 0
   while i < shapes.len {
      def sh = shapes[i]
      if sh.get("kind", "") == "struct_like" || sh.get("kind", "") == "strided_array" {
         structs = structs.append({"name": "shape_" + to_str(i), "owner": sh.get("base", ""),
               "owner_kind": "memory_shape", "shape": sh.get("kind", ""), "type": sh.get("kind", "") == "strided_array" ? "array" : "struct",
               "fields": _type_fields_from_offsets_widths(sh.get("offsets", []), sh.get("widths", [])),
               "stride": int(sh.get("stride", 0)), "span": int(sh.get("span", 0)), "source": "facts"})
      }
      i += 1
   }
   _type_finalize_recovery({"kind": "type_recovery", "language": "ny", "target": target, "arch": arch(bin),
         "params": params, "locals": locals, "calls": typed_calls, "structs": structs,
         "memory_shapes": shapes, "source": "rows+facts", "max_bytes": max_bytes,
         "call_count": typed_calls.len, "local_count": locals.len, "struct_count": structs.len})
}

fn _type_recovery_with_rendered(dict rec0, str text) dict {
   mut rec = rec0
   def locals = _type_rendered_local_layouts(text)
   def rendered_calls = _type_rendered_known_calls(text)
   mut calls = rec.get("calls", [])
   mut ci = 0
   while ci < rendered_calls.len {
      calls = calls.append(rendered_calls[ci])
      ci += 1
   }
   mut all = rec.get("locals", [])
   mut i = 0
   while i < locals.len {
      all = _type_merge_local(all, locals[i].set("source", locals[i].get("source", "rendered")))
      i += 1
   }
   mut structs = rec.get("structs", [])
   i = 0
   while i < locals.len {
      def l = locals[i]
      if l.get("fields", []).len >= 2 {
         structs = structs.append({"name": l.get("name", "") + "_t", "owner": l.get("name", ""),
               "owner_kind": "local", "shape": l.get("shape", "local_struct"),
               "type": l.get("type", "struct_like"), "alloc_size": int(l.get("alloc_size", 0)),
               "fields": l.get("fields", []), "source": "rendered"})
      }
      i += 1
   }
   _type_finalize_recovery(rec.set("locals", all).set("structs", structs)
      .set("calls", calls)
      .set("local_count", all.len).set("struct_count", structs.len)
      .set("call_count", calls.len))
}

fn _syscalls_model(list rows) list {
   mut out = []
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "syscall" {
         def nr = _syscall_nr(rows, i)
         out = out.append({"addr": r.get("addr", 0), "nr": nr, "name": _syscall_name_for(r.get("family", _rows_family(rows)), nr),
               "args": _syscall_args_model(rows, i), "effect": _syscall_render(rows, i)})
      }
      i += 1
   }
   out
}

fn _var_pos(list vars, str kind, str name) int {
   mut i = 0
   while i < vars.len {
      if vars[i].get("kind", "") == kind && vars[i].get("name", "") == name { return i }
      i += 1
   }
   -1
}

fn _var_site(dict row, str access, str role="") dict {
   {"addr": row.get("addr", 0), "access": access, "role": role,
      "mnemonic": row.get("mnemonic", ""), "operand": row.get("operands", "")}
}

fn _var_add_use(list vars, str kind, str name, str storage, str type_guess, dict site) list {
   if name.len == 0 { return vars }
   def pos = _var_pos(vars, kind, name)
   if pos < 0 {
      return vars.append({"kind": kind, "name": name, "storage": storage, "type": type_guess, "uses": [site]})
   }
   def v = vars[pos]
   vars.set(pos, v.set("uses", v.get("uses", []).append(site)))
}

fn _slot_type_guess(str op) str {
   if str.find(op, "byte ptr") >= 0 { return "u8" }
   if str.find(op, "qword ptr") >= 0 { return "u64_or_ptr" }
   if str.find(op, "dword ptr") >= 0 { return "u32" }
   if str.find(op, "word ptr") >= 0 { return "u16" }
   "unknown"
}

fn _global_access(dict row) str {
   if row.get("op", "") == "call" { return "execute" }
   def dst = row.get("dst", "")
   if str.find(dst, "rip") >= 0 { return "write" }
   "read"
}

fn _variables_from_rows(dict bin, list rows, dict sig0, str sig_name) list {
   def sig = _signature_main_aliases(sig0, sig_name)
   mut out = []
   def frame = _frame_model(rows)
   def slots = frame.get("slots", [])
   mut i = 0
   while i < slots.len {
      def sl = slots[i]
      out = _var_add_use(out, "local", _rename_name(bin, sl.get("name", "")), sl.get("base", "") + to_str(sl.get("offset", 0)), "unknown",
         {"addr": 0, "access": "declare", "role": "stack_slot", "mnemonic": "", "operand": ""})
      i += 1
   }
   def ps = sig.get("params", [])
   i = 0
   while i < ps.len {
      def p = ps[i]
      out = _var_add_use(out, "param", _rename_name(bin, p.get("name", "")), p.get("reg", ""), p.get("type", "unknown"),
         {"addr": 0, "access": "declare", "role": p.get("kind", ""), "mnemonic": "", "operand": ""})
      def fs = p.get("fields", [])
      mut fi = 0
      while fi < fs.len {
         def f = fs[fi]
         out = _var_add_use(out, "field", f.get("name", ""), p.get("name", "") + "+" + to_str(int(f.get("offset", 0))),
            f.get("type", "unknown"),
            {"addr": 0, "access": "declare", "role": "struct_field", "mnemonic": "", "operand": "", "param": p.get("name", ""), "offset": int(f.get("offset", 0))})
         fi += 1
      }
      i += 1
   }
   i = 0
   while i < rows.len {
      def r = rows[i]
      def dslot = _stack_slot_for_ops(r.get("dst", ""))
      if dslot.len > 0 {
         out = _var_add_use(out, "local", _rename_name(bin, dslot.get("name", "")), dslot.get("base", "") + to_str(dslot.get("offset", 0)),
            _slot_type_guess(r.get("dst", "")), _var_site(r, r.get("op", "") == "compare" ? "read" : "write", "dst"))
      }
      def sslot = _stack_slot_for_ops(r.get("src", ""))
      if sslot.len > 0 {
         out = _var_add_use(out, "local", _rename_name(bin, sslot.get("name", "")), sslot.get("base", "") + to_str(sslot.get("offset", 0)),
            _slot_type_guess(r.get("src", "")), _var_site(r, "read", "src"))
      }
      if r.get("ref_name", "").len > 0 {
         def rk = r.get("ref_kind", "global")
         out = _var_add_use(out, rk, r.get("ref_name", ""), _hex(r.get("ref_target", 0)), rk == "string" ? "str" : "ptr",
            _var_site(r, _global_access(r), "rip_relative"))
      }
      def op = r.get("op", "")
      if op == "branch" {
         if r.get("kind", "") == "switch" {
            def jt = r.get("jump_table", dict())
            def entries = jt.get("entries", [])
            mut ei = 0
            while ei < entries.len {
               def target_addr = int(entries[ei].get("target", 0))
               def lname = _rename_addr(bin, target_addr, entries[ei].get("label", _label_name(target_addr)))
               def site = _var_site(r, "switch_case", "case_" + to_str(int(entries[ei].get("index", ei))))
               .set("target", target_addr).set("table", int(jt.get("base", 0))).set("index", int(entries[ei].get("index", ei)))
               out = _var_add_use(out, "label", lname, _hex(target_addr), "code", site)
               ei += 1
            }
         } elif int(r.get("target", 0)) > 0 {
            def lname = _rename_addr(bin, r.get("target", 0), _label_name(r.get("target", 0)))
            out = _var_add_use(out, "label", lname, _hex(r.get("target", 0)), "code", _var_site(r, "jump", r.get("condition", "")))
         }
      }
      mut pi = 0
      while pi < ps.len {
         def p = ps[pi]
         if _mentions_alias(r.get("src", ""), p.get("reg", "")) {
            out = _var_add_use(out, "param", _rename_name(bin, p.get("name", "")), p.get("reg", ""), "unknown", _var_site(r, "read", "src"))
         }
         pi += 1
      }
      i += 1
   }
   out
}

fn variables(any source, any target=0, int max_bytes=1024) list {
   "Return decompiler symbols with use sites: locals, params, globals/imports/strings, and labels."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def rows = lift(bin, target, max_bytes)
   def tb = _target_bytes(bin, target, max_bytes)
   def sig_name = is_str(target) ? _safe_name(target, "sub") : _safe_name(tb.get("name", ""), "sub")
   _variables_from_rows(bin, rows, _function_signature_for(bin, target, rows, int(tb.get("addr", 0)), max_bytes), sig_name)
}

fn _call_render(str name, list args, str family="x86") str {
   def fixed_argc = _call_known_fixed_arg_count(name)
   def rendered_args = fixed_argc >= 0 ? _call_trim_fixed_args(args, family, fixed_argc) : args
   mut has_stack = false
   mut max_stack = -1
   mut si = 0
   while si < rendered_args.len {
      if rendered_args[si].contains("stack_index") {
         has_stack = true
         max_stack = max(max_stack, int(rendered_args[si].get("stack_index", -1)))
      }
      si += 1
   }
   if has_stack {
      mut b0 = str.Builder(max(32, name.len + rendered_args.len * 16))
      b0 = str.builder_append(b0, name + "(")
      mut idx = 0
      while idx <= max_stack {
         if idx > 0 { b0 = str.builder_append(b0, ", ") }
         mut value = "arg" + to_str(idx)
         mut ai0 = 0
         while ai0 < rendered_args.len {
            if int(rendered_args[ai0].get("stack_index", -1)) == idx { value = _call_arg_render_value(rendered_args[ai0]) }
            ai0 += 1
         }
         b0 = str.builder_append(b0, value)
         idx += 1
      }
      b0 = str.builder_append(b0, ")")
      def out0 = str.builder_to_str(b0)
      str.builder_free(b0)
      return out0
   }
   def regs = _abi_profile(family).get("args", [])
   mut vals = dict()
   mut max_idx = -1
   mut ai = 0
   while ai < rendered_args.len {
      def r = rendered_args[ai].get("reg", "")
      vals = vals.set(r, _call_arg_render_value(rendered_args[ai]))
      mut ri = 0
      while ri < regs.len {
         if regs[ri] == r && ri > max_idx { max_idx = ri }
         ri += 1
      }
      ai += 1
   }
   mut b = str.Builder(max(32, name.len + rendered_args.len * 16))
   b = str.builder_append(b, name + "(")
   mut i = 0
   while i <= max_idx {
      if i > 0 { b = str.builder_append(b, ", ") }
      def reg = regs[i]
      b = str.builder_append(b, vals.get(reg, "arg_" + reg))
      i += 1
   }
   b = str.builder_append(b, ")")
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _call_arg_render_value(dict arg) str {
   def raw = arg.get("value", "unknown")
   def rk = arg.get("ref_kind", "")
   if rk.len > 0 {
      if raw.len > 0 && raw != "unknown" && !_looks_int_literal(raw) { return raw }
      def named = _ny_ref_value(arg.get("ref", dict()), false)
      if named.len > 0 { return named }
      if rk == "string" { return repr(arg.get("string", "")) }
      if arg.get("ref_name", "").len > 0 { return arg.get("ref_name", "") }
   }
   raw
}

fn _call_known_fixed_arg_count(str name0) int {
   def sig = _type_library_signature(name0)
   if sig.len == 0 || bool(sig.get("variadic", false)) { return -1 }
   sig.get("args", []).len
}

fn _call_trim_fixed_args(list args, str family, int fixed_argc) list {
   if fixed_argc < 0 { return args }
   mut out = []
   mut i = 0
   while i < args.len {
      def arg = args[i]
      if arg.contains("stack_index") {
         if int(arg.get("stack_index", -1)) < fixed_argc { out = out.append(arg) }
      } else {
         def idx = _abi_arg_index(family, arg.get("reg", ""))
         if idx >= 0 && idx < fixed_argc { out = out.append(arg) }
      }
      i += 1
   }
   out
}

fn _clean_direct_noreturn_name(str name0) bool {
   mut name = str.lower(str.strip(name0))
   if name.len == 0 { return false }
   name = str.str_replace(name, "@plt", "")
   name = str.str_replace(name, "__imp_", "")
   case name {
      "exit", "_exit", "abort", "quick_exit", "__stack_chk_fail", "__assert_fail",
      "panic", "fatal", "err", "errx" -> true
      _ -> false
   }
}

fn _clean_call_is_noreturn(dict bin, dict row, int depth=0) bool {
   if row.get("op", "") != "call" { return false }
   if _clean_direct_noreturn_name(row.get("target_name", "")) { return true }
   if depth >= 2 { return false }
   def target = int(row.get("target", 0))
   if target <= 0 { return false }
   def sec = _section_for_addr(bin, target)
   if sec.len == 0 || str.find(sec.get("name", ""), ".plt") >= 0 { return false }
   def rows = lift(bin, target, 128)
   if rows.len == 0 || rows.len > 80 { return false }
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      def op = r.get("op", "")
      if op == "return" { return false }
      if op == "call" && _clean_call_is_noreturn(bin, r, depth + 1) { return true }
      i += 1
   }
   false
}

fn _clean_next_live_after_noreturn(list rows, int idx) int {
   mut j = idx + 1
   while j < rows.len {
      if _branch_target_count(rows, int(rows[j].get("addr", 0))) > 0 { return j }
      j += 1
   }
   rows.len
}

fn _arg_exists(list args, str reg) bool {
   mut i = 0
   while i < args.len {
      if args[i].get("reg", "") == reg { return true }
      i += 1
   }
   false
}

fn _param_name_for_reg(dict sig, str reg) str {
   def ps = sig.get("params", [])
   mut i = 0
   while i < ps.len {
      if ps[i].get("reg", "") == reg { return ps[i].get("name", "") }
      i += 1
   }
   ""
}

fn _param_name_for_token(dict sig, str family, str tok) str {
   def ps = sig.get("params", [])
   def canon = _canonical_value_reg(family, tok)
   if canon.len == 0 { return "" }
   mut i = 0
   while i < ps.len {
      def p = ps[i]
      if _alias_reg_for([p.get("reg", "")], canon).len > 0 || _alias_reg_for([p.get("reg", "")], tok).len > 0 {
         return p.get("name", "")
      }
      i += 1
   }
   ""
}

fn _clean_expr_with_sig(dict sig, list rows, str expr0) str {
   if sig.get("params", []).len == 0 { return expr0 }
   def expr = str.strip(expr0)
   if expr.len == 0 { return "" }
   def family = _rows_family(rows)
   mut out = ""
   mut i = 0
   mut quote = 0
   while i < expr.len {
      def ch = load8(expr, i)
      if quote != 0 {
         out = out + chr(ch)
         if ch == 92 && i + 1 < expr.len {
            i += 1
            out = out + chr(load8(expr, i))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         out = out + chr(ch)
         i += 1
         continue
      }
      if _symbol_is_name_char(ch) {
         def start = i
         while i < expr.len && _symbol_is_name_char(load8(expr, i)) { i += 1 }
         def tok = slice(expr, start, i, 1)
         def pname = _param_name_for_token(sig, family, tok)
         out = out + (pname.len > 0 ? pname : tok)
      } else {
         out = out + chr(ch)
         i += 1
      }
   }
   out
}

fn _clean_stack_param_aliases(dict sig, list rows) dict {
   mut out = dict()
   if sig.get("params", []).len == 0 { return out }
   def family = _abi_family_from_name(sig.get("abi", "sysv_x86_64"))
   mut i = 0
   while i < rows.len && i < 96 {
      def r = rows[i]
      if r.get("op", "") == "call" { break }
      if r.get("op", "") == "assign" && r.get("dst_kind", "") == "mem" && r.get("src_kind", "") == "reg" {
         def slot = _stack_slot_for_ops(r.get("dst", ""))
         def reg = _canonical_value_reg(family, r.get("src", ""))
         def pname = reg.len > 0 ? _param_name_for_reg(sig, reg) : ""
         if slot.len > 0 && pname.len > 0 && !_clean_param_reg_redefined_before(rows, i - 1, reg) {
            out = out.set(slot.get("name", ""), pname)
         }
      }
      i += 1
   }
   out
}

fn _clean_local_param_alias_text(dict sig, list rows, str expr0) str {
   def expr = str.strip(expr0)
   if expr.len == 0 { return expr0 }
   if str.find(expr, "local_") < 0 && str.find(expr, "stack_") < 0 { return expr0 }
   def aliases = _clean_stack_param_aliases(sig, rows)
   if aliases.len == 0 { return expr0 }
   mut out = ""
   mut i = 0
   mut quote = 0
   while i < expr.len {
      def ch = load8(expr, i)
      if quote != 0 {
         out = out + chr(ch)
         if ch == 92 && i + 1 < expr.len {
            i += 1
            out = out + chr(load8(expr, i))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         out = out + chr(ch)
         i += 1
         continue
      }
      if _symbol_is_name_char(ch) {
         def start = i
         while i < expr.len && _symbol_is_name_char(load8(expr, i)) { i += 1 }
         def tok = slice(expr, start, i, 1)
         out = out + aliases.get(tok, tok)
      } else {
         out = out + chr(ch)
         i += 1
      }
   }
   out
}

fn _clean_ascii_from_int(int value, int width) str {
   if width < 2 || width > 16 { return "" }
   mut out = str.Builder(width)
   mut i = 0
   mut n = 0
   while i < width {
      def c = (value >> (i * 8)) & 255
      if c == 0 { break }
      if c < 32 || c > 126 {
         str.builder_free(out)
         return ""
      }
      out = str.builder_append(out, chr(c))
      n += 1
      i += 1
   }
   def s = str.builder_to_str(out)
   str.builder_free(out)
   n >= 2 ? s : ""
}

fn _clean_stack_literal_value_at(dict bin, list rows, int idx, dict row) str {
   def width = _fact_width(row.get("dst", ""))
   if width < 2 { return "" }
   mut value = row.get("src_kind", "") == "imm" ? _ny_operand_ref_bin(bin, row.get("src", ""), row.get("ref", dict())) : ""
   if value.len == 0 && row.get("src_kind", "") == "reg" {
      value = _clean_operand_expr_at(bin, rows, idx - 1, row.get("src", ""))
   }
   if !_looks_int_literal(value) { return "" }
   _clean_ascii_from_int(_parse_int_piece(value), width)
}

fn _clean_stack_literal_aliases(dict bin, list rows) dict {
   mut out = dict()
   mut i = 0
   while i < rows.len && i < 128 {
      def r = rows[i]
      if r.get("op", "") == "call" { break }
      if r.get("op", "") == "assign" && r.get("dst_kind", "") == "mem" {
         def slot = _stack_slot_for_ops(r.get("dst", ""))
         if slot.len > 0 {
            def lit = _clean_stack_literal_value_at(bin, rows, i, r)
            if lit.len > 0 {
               out = out.set(slot.get("name", ""), {"text": lit, "offset": int(slot.get("offset", 0)), "len": lit.len})
            }
         }
      }
      i += 1
   }
   out
}

fn _clean_stack_slot_name_offset(str name0) dict {
   def name = str.strip(name0)
   if str.startswith(name, "stack_") {
      def raw = slice(name, 6, name.len, 1)
      if raw.len == 0 { return dict() }
      mut i = 0
      while i < raw.len {
         if !str.ascii_is_hex_digit(load8(raw, i)) { return dict() }
         i += 1
      }
      return {"ok": true, "offset": _parse_int_piece("0x" + raw)}
   }
   if str.startswith(name, "local_") {
      def raw = slice(name, 6, name.len, 1)
      if raw.len == 0 { return dict() }
      mut i = 0
      while i < raw.len {
         if !str.ascii_is_hex_digit(load8(raw, i)) { return dict() }
         i += 1
      }
      return {"ok": true, "offset": -_parse_int_piece("0x" + raw)}
   }
   dict()
}

fn _clean_stack_byte_value_at(dict bin, list rows, int idx, dict row) dict {
   def width = _fact_width(row.get("dst", ""))
   if width <= 0 || width > 16 { return dict() }
   mut value = ""
   if row.get("src_kind", "") == "imm" {
      value = row.get("src", "")
   } elif row.get("src_kind", "") == "reg" {
      def src = row.get("src", "")
      def family = _rows_family(rows)
      mut j = idx - 1
      mut guard = 0
      while j >= 0 && guard < 5 && value.len == 0 {
         def prev = rows[j]
         if (prev.get("op", "") == "call" || prev.get("op", "") == "branch" ||
            prev.get("op", "") == "return"){ break }
         if prev.get("dst_kind", "") == "reg" && prev.get("src_kind", "") == "imm" {
            def prev_reg = _canonical_value_reg(family, prev.get("dst", ""))
            def src_reg = _canonical_value_reg(family, src)
            if prev_reg.len > 0 && prev_reg == src_reg {
               value = _ny_operand_ref_bin(bin, prev.get("src", ""), prev.get("ref", dict()))
            }
         }
         j -= 1
         guard += 1
      }
      if value.len == 0 {
         value = _clean_operand_expr_at(bin, rows, idx - 1, src)
      }
   }
   if !_looks_int_literal(value) { return dict() }
   {"ok": true, "value": _parse_int_piece(value), "bytes": _clean_literal_le_bytes(value, width), "width": width}
}

fn _clean_literal_le_bytes(str value0, int width) list {
   def value = str.lower(str.strip(value0))
   mut out = []
   if str.startswith(value, "0x") {
      def raw = slice(value, 2, value.len, 1)
      mut pos = raw.len
      while out.len < width {
         if pos <= 0 {
            out = out.append(0)
         } else {
            def start = max(0, pos - 2)
            out = out.append(_parse_int_piece("0x" + slice(raw, start, pos, 1)))
            pos = start
         }
      }
      return out
   }
   def n = _parse_int_piece(value)
   mut i = 0
   while i < width {
      out = out.append((n >> (i * 8)) & 255)
      i += 1
   }
   out
}

fn _clean_stack_byte_array_explicit_stops(list rows, int before_idx) dict {
   mut stops = dict()
   mut i = 0
   def end = before_idx < 0 ? rows.len : min(before_idx, rows.len)
   while i < end && i < 160 {
      def r = rows[i]
      if (r.get("op", "") == "assign" && r.get("dst_kind", "") == "mem" &&
         r.get("src_kind", "") == "imm" && _fact_width(r.get("dst", "")) == 1 &&
         _imm_value(r.get("src", "")) == 0){
         def slot = _stack_slot_for_ops(r.get("dst", ""))
         if slot.len > 0 { stops = stops.set(to_str(int(slot.get("offset", 0))), true) }
      }
      i += 1
   }
   stops
}

fn _clean_stack_byte_array_bytes(dict bin, list rows, int before_idx) dict {
   mut bytes = dict()
   mut i = 0
   def end = before_idx < 0 ? rows.len : min(before_idx, rows.len)
   while i < end && i < 160 {
      def r = rows[i]
      if r.get("op", "") == "assign" && r.get("dst_kind", "") == "mem" {
         def slot = _stack_slot_for_ops(r.get("dst", ""))
         def val = _clean_stack_byte_value_at(bin, rows, i, r)
         if slot.len > 0 && val.get("ok", false) {
            def base = int(slot.get("offset", 0))
            def width = int(val.get("width", 0))
            def vbytes = val.get("bytes", [])
            mut bi = 0
            while bi < width {
               bytes = bytes.set(to_str(base + bi), int(vbytes[bi]))
               bi += 1
            }
         }
      }
      i += 1
   }
   bytes
}

fn _clean_stack_byte_array_literal_from_bytes(dict bytes, int start, dict stops=dict()) dict {
   mut vals = []
   mut i = 0
   while i < 96 && bytes.contains(to_str(start + i)) {
      vals = vals.append(int(bytes.get(to_str(start + i), 0)))
      i += 1
   }
   if vals.len == 0 { return dict() }
   mut explicit_stop = -1
   i = 1
   while i < vals.len && explicit_stop < 0 {
      if stops.get(to_str(start + i), false) { explicit_stop = i }
      i += 1
   }
   mut zero_run_stop = -1
   i = 1
   while i + 1 < vals.len && zero_run_stop < 0 {
      if int(vals[i]) == 0 && int(vals[i + 1]) == 0 { zero_run_stop = i }
      i += 1
   }
   mut first_zero = -1
   mut last_nonzero = -1
   mut printable_prefix = true
   i = 0
   while i < vals.len {
      def c = int(vals[i])
      if c == 0 && first_zero < 0 { first_zero = i }
      if c != 0 { last_nonzero = i }
      if first_zero < 0 && (c < 32 || c > 126) { printable_prefix = false }
      i += 1
   }
   def stop = explicit_stop >= 0 ? explicit_stop : zero_run_stop
   def printable_len = stop >= 0 ? stop : first_zero
   if printable_len >= 2 && printable_prefix {
      mut b = str.Builder(printable_len)
      i = 0
      while i < printable_len {
         b = str.builder_append(b, chr(int(vals[i])))
         i += 1
      }
      def s = str.builder_to_str(b)
      str.builder_free(b)
      return {"ok": true, "text": repr(s), "len": printable_len, "kind": "str"}
   }
   if stop >= 0 { last_nonzero = stop - 1 }
   if last_nonzero < 1 { return dict() }
   mut text = "["
   i = 0
   while i <= last_nonzero {
      if i > 0 { text = text + ", " }
      text = text + to_str(vals[i])
      i += 1
   }
   text = text + "]"
   {"ok": true, "text": text, "len": last_nonzero + 1, "kind": "bytes"}
}

fn _clean_stack_byte_array_literals(dict bin, list rows, int before_idx) dict {
   def bytes = _clean_stack_byte_array_bytes(bin, rows, before_idx)
   def stops = _clean_stack_byte_array_explicit_stops(rows, before_idx)
   mut out = dict()
   def keys = bytes.keys()
   mut i = 0
   while i < keys.len {
      def off = _parse_int_piece(to_str(keys[i]))
      def lit = _clean_stack_byte_array_literal_from_bytes(bytes, off, stops)
      if lit.get("ok", false) {
         def name = (off < 0 ? "local_" : "stack_") + str.to_hex(_iabs(off), 0)
         out = out.set(name, lit.set("offset", off))
      }
      i += 1
   }
   out
}

fn _clean_stack_byte_array_arg_text(dict bin, list rows, int before_idx, str expr0) str {
   def expr = str.strip(expr0)
   if !str.startswith(expr, "&") { return "" }
   def slot_name = str.strip(slice(expr, 1, expr.len, 1))
   def slot = _clean_stack_slot_name_offset(slot_name)
   if !slot.get("ok", false) { return "" }
   def lits = _clean_stack_byte_array_literals(bin, rows, before_idx)
   lits.get(slot_name, dict()).get("text", "")
}

fn _clean_stack_byte_array_zero_terminator(dict bin, list rows, int before_idx, int off) bool {
   def lits = _clean_stack_byte_array_literals(bin, rows, before_idx)
   def keys = lits.keys()
   mut i = 0
   while i < keys.len {
      def lit = lits.get(to_str(keys[i]), dict())
      if off == int(lit.get("offset", 0)) + int(lit.get("len", 0)) { return true }
      i += 1
   }
   false
}

fn _clean_stack_literal_index_expr(str inner, str slot) str {
   def prefix = "&" + slot
   if !str.startswith(inner, prefix) { return "" }
   mut rest = str.strip(slice(inner, prefix.len, inner.len, 1))
   if rest.len == 0 { return "0" }
   if str.startswith(rest, "+") { return str.strip(slice(rest, 1, rest.len, 1)) }
   if str.startswith(rest, "-") { return rest }
   ""
}

fn _clean_stack_literal_mem(dict aliases, str raw) str {
   if !str.startswith(raw, "mem(") || raw.len <= 5 || load8(raw, raw.len - 1) != 41 { return "" }
   def inner = str.strip(slice(raw, 4, raw.len - 1, 1))
   def keys = aliases.keys()
   mut i = 0
   while i < keys.len {
      def slot = to_str(keys[i])
      def idx = _clean_stack_literal_index_expr(inner, slot)
      if idx.len > 0 {
         return repr(aliases.get(slot, dict()).get("text", "")) + "[" + idx + "]"
      }
      i += 1
   }
   ""
}

fn _clean_stack_literal_text(dict bin, list rows, str expr0) str {
   def expr = str.strip(expr0)
   if expr.len == 0 || str.find(expr, "mem(&stack_") < 0 { return expr0 }
   def aliases = _clean_stack_literal_aliases(bin, rows)
   if aliases.len == 0 { return expr0 }
   mut out = ""
   mut i = 0
   while i < expr.len {
      if i + 4 <= expr.len && slice(expr, i, i + 4, 1) == "mem(" {
         mut j = i + 4
         mut depth = 1
         while j < expr.len && depth > 0 {
            def ch = load8(expr, j)
            if ch == 40 { depth += 1 }
            elif ch == 41 { depth -= 1 }
            j += 1
         }
         if depth == 0 {
            def raw = slice(expr, i, j, 1)
            def repl = _clean_stack_literal_mem(aliases, raw)
            out = out + (repl.len > 0 ? repl : raw)
            i = j
            continue
         }
      }
      out = out + chr(load8(expr, i))
      i += 1
   }
   out
}

fn _clean_strip_zext_literal_index(str expr0) str {
   def expr = str.strip(expr0)
   if str.find(expr, "zext8(") < 0 { return expr0 }
   mut out = ""
   mut i = 0
   while i < expr.len {
      if i + 6 <= expr.len && slice(expr, i, i + 6, 1) == "zext8(" {
         mut j = i + 6
         mut depth = 1
         while j < expr.len && depth > 0 {
            def ch = load8(expr, j)
            if ch == 40 { depth += 1 }
            elif ch == 41 { depth -= 1 }
            j += 1
         }
         if depth == 0 {
            def inner = str.strip(slice(expr, i + 6, j - 1, 1))
            if inner.len > 0 && (load8(inner, 0) == 34 || load8(inner, 0) == 39) && str.find(inner, "[") >= 0 && load8(inner, inner.len - 1) == 93 {
               out = out + inner
               i = j
               continue
            }
         }
      }
      out = out + chr(load8(expr, i))
      i += 1
   }
   out
}

fn _clean_call_end_at(str expr, int call_start, str name) int {
   def prefix = name + "("
   if call_start < 0 || call_start + prefix.len > expr.len { return -1 }
   if slice(expr, call_start, call_start + prefix.len, 1) != prefix { return -1 }
   mut j = call_start + prefix.len
   mut depth = 1
   while j < expr.len && depth > 0 {
      def ch = load8(expr, j)
      if ch == 40 { depth += 1 }
      elif ch == 41 { depth -= 1 }
      j += 1
   }
   depth == 0 ? j : -1
}

fn _clean_simplify_redundant_casts_once(str expr0) dict {
   def expr = str.strip(expr0)
   mut out = ""
   mut i = 0
   mut quote = 0
   mut changed = false
   while i < expr.len {
      def ch = load8(expr, i)
      if quote != 0 {
         out = out + chr(ch)
         if ch == 92 && i + 1 < expr.len {
            i += 1
            out = out + chr(load8(expr, i))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         out = out + chr(ch)
         i += 1
         continue
      }
      if i + 5 <= expr.len && slice(expr, i, i + 5, 1) == "sext(" {
         def inner_start = i + 5
         def inner_sext_end = _clean_call_end_at(expr, inner_start, "sext")
         if inner_sext_end > 0 && inner_sext_end < expr.len && load8(expr, inner_sext_end) == 41 {
            out = out + slice(expr, inner_start, inner_sext_end, 1)
            i = inner_sext_end + 1
            changed = true
            continue
         }
         def inner_zext8_end = _clean_call_end_at(expr, inner_start, "zext8")
         if inner_zext8_end > 0 && inner_zext8_end < expr.len && load8(expr, inner_zext8_end) == 41 {
            out = out + slice(expr, inner_start, inner_zext8_end, 1)
            i = inner_zext8_end + 1
            changed = true
            continue
         }
      }
      if i + 6 <= expr.len && slice(expr, i, i + 6, 1) == "zext8(" {
         def inner_start = i + 6
         def inner_zext8_end = _clean_call_end_at(expr, inner_start, "zext8")
         if inner_zext8_end > 0 && inner_zext8_end < expr.len && load8(expr, inner_zext8_end) == 41 {
            out = out + slice(expr, inner_start, inner_zext8_end, 1)
            i = inner_zext8_end + 1
            changed = true
            continue
         }
      }
      out = out + chr(ch)
      i += 1
   }
   {"text": out, "changed": changed}
}

fn _clean_simplify_redundant_casts(str expr0) str {
   mut expr = str.strip(expr0)
   mut pass = 0
   while pass < 4 {
      def next = _clean_simplify_redundant_casts_once(expr)
      if !next.get("changed", false) { return expr }
      expr = next.get("text", expr)
      pass += 1
   }
   expr
}

fn _clean_dynamic_data_text(dict bin, str expr0) str {
   def expr = str.strip(expr0)
   if expr.len == 0 || str.find(expr, "mem(") < 0 { return expr0 }
   mut out = ""
   mut i = 0
   while i < expr.len {
      if i + 4 <= expr.len && slice(expr, i, i + 4, 1) == "mem(" {
         mut j = i + 4
         mut depth = 1
         while j < expr.len && depth > 0 {
            def ch = load8(expr, j)
            if ch == 40 { depth += 1 }
            elif ch == 41 { depth -= 1 }
            j += 1
         }
         if depth == 0 {
            def raw = slice(expr, i, j, 1)
            def repl = _ny_dynamic_data_plain_bin(bin, raw)
            out = out + (repl.len > 0 ? repl : raw)
            i = j
            continue
         }
      }
      out = out + chr(load8(expr, i))
      i += 1
   }
   out
}

fn _clean_data_base_reg_mutated_after(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def defs = _row_defs(rows[idx])
   if defs.len == 0 { return false }
   mut j = idx + 1
   while j < rows.len {
      if _symbols_intersect(_row_defs(rows[j]), defs) { return true }
      j += 1
   }
   false
}

fn _clean_pic_base_setup_row(list rows, int idx) bool {
   if idx <= 0 || idx >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "arith" || row.get("operator", "") != "+" { return false }
   if row.get("dst_kind", "") != "reg" || row.get("src_kind", "") != "imm" { return false }
   if _canonical_value_reg(row.get("family", _rows_family(rows)), row.get("dst", "")) != "rbx" { return false }
   rows[idx - 1].get("op", "") == "call" && int(rows[idx - 1].get("target", 0)) > 0
}

fn _clean_pic_thunk_call_row(list rows, int idx) bool {
   idx + 1 < rows.len && rows[idx].get("op", "") == "call" && _clean_pic_base_setup_row(rows, idx + 1)
}

fn _clean_pic_seed_addr_for_term(list rows, str term0) int {
   def term = str.strip(term0)
   if term.len == 0 { return 0 }
   mut i = 1
   while i < rows.len {
      if _clean_pic_base_setup_row(rows, i) {
         def dst = _ny_operand(rows[i].get("dst", ""))
         if dst == term || _alias_reg_for([term], dst) == term {
            def call = rows[i - 1]
            return int(call.get("addr", 0)) + int(call.get("size", 0))
         }
      }
      i += 1
   }
   0
}

fn _clean_data_term_expr(str expr0) str {
   str.str_replace(str.str_replace(expr0, "(", ""), ")", "")
}

fn _clean_dynamic_data_value_or_name(dict bin, int addr) str {
   def st = _string_for_vaddr(bin, addr)
   if st.len > 0 && int(st.get("delta", 0)) == 0 { return repr(st.get("value", "")) }
   _ny_dynamic_data_name(bin, addr)
}

fn _clean_data_addr_expr_with_rows(dict bin, list rows, str expr0) str {
   def expr = str.strip(expr0)
   if expr.len == 0 || (str.find(expr, "+") < 0 && str.find(expr, "-") < 0) { return "" }
   def terms = _fact_expr_terms(_clean_data_term_expr(expr))
   mut addr = 0
   mut saw_base = false
   mut i = 0
   while i < terms.len {
      def sign = int(terms[i].get("sign", 1))
      def term = _fact_clean_term(terms[i].get("text", ""))
      if term.len > 0 {
         if _fact_term_int(term) {
            addr += sign * _parse_int_piece(term)
         } else {
            def base = sign > 0 ? _clean_pic_seed_addr_for_term(rows, term) : 0
            if base <= 0 { return "" }
            addr += base
            saw_base = true
         }
      }
      i += 1
   }
   if !saw_base { return "" }
   _clean_dynamic_data_value_or_name(bin, addr)
}

fn _clean_data_base_addr_for_term(list rows, str term0) int {
   def term = str.strip(term0)
   if term.len == 0 { return 0 }
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "assign" && r.get("ref_kind", "") == "data" && int(r.get("ref_target", 0)) > 0 {
         def dst = _ny_operand(r.get("dst", ""))
         if (dst == term || _alias_reg_for([term], dst) == term) && !_clean_data_base_reg_mutated_after(rows, i) {
            return int(r.get("ref_target", 0))
         }
      }
      i += 1
   }
   0
}

fn _clean_named_data_addr(str term0) int {
   mut term = str.strip(term0)
   if str.startswith(term, "&") { term = slice(term, 1, term.len, 1) }
   if !str.startswith(term, "data_") { return 0 }
   def raw = slice(term, 5, term.len, 1)
   if raw.len == 0 { return 0 }
   _parse_int_piece("0x" + raw)
}

fn _clean_data_base_mem_for_rows(dict bin, list rows, str raw) str {
   if !str.startswith(raw, "mem(") || raw.len <= 5 || load8(raw, raw.len - 1) != 41 { return "" }
   def expr = _clean_data_term_expr(slice(raw, 4, raw.len - 1, 1))
   def terms = _fact_expr_terms(expr)
   mut addr = 0
   mut idxs = []
   mut saw_data_base = false
   mut i = 0
   while i < terms.len {
      def sign = int(terms[i].get("sign", 1))
      def term = _fact_clean_term(terms[i].get("text", ""))
      if term.len > 0 {
         if _fact_term_int(term) {
            addr += sign * _parse_int_piece(term)
         } else {
            mut base_addr = sign > 0 ? _clean_named_data_addr(term) : 0
            if base_addr == 0 { base_addr = sign > 0 ? _clean_data_base_addr_for_term(rows, term) : 0 }
            if base_addr == 0 { base_addr = sign > 0 ? _clean_pic_seed_addr_for_term(rows, term) : 0 }
            if base_addr > 0 {
               addr += base_addr
               saw_data_base = true
            } else {
               idxs = idxs.append((sign < 0 ? "-" : "") + term)
            }
         }
      }
      i += 1
   }
   if !saw_data_base { return "" }
   def name = _clean_dynamic_data_value_or_name(bin, addr)
   if name.len == 0 { return "" }
   idxs.len > 0 ? (name + "[" + str.join(idxs, " + ") + "]") : name
}

fn _clean_dynamic_data_text_with_rows(dict bin, list rows, str expr0) str {
   def expr = str.strip(expr0)
   if expr.len == 0 || str.find(expr, "mem(") < 0 { return expr0 }
   mut out = ""
   mut i = 0
   while i < expr.len {
      if i + 4 <= expr.len && slice(expr, i, i + 4, 1) == "mem(" {
         mut j = i + 4
         mut depth = 1
         while j < expr.len && depth > 0 {
            def ch = load8(expr, j)
            if ch == 40 { depth += 1 }
            elif ch == 41 { depth -= 1 }
            j += 1
         }
         if depth == 0 {
            def raw = slice(expr, i, j, 1)
            mut repl = _ny_dynamic_data_plain_bin(bin, raw)
            if repl.len == 0 { repl = _clean_data_base_mem_for_rows(bin, rows, raw) }
            out = out + (repl.len > 0 ? repl : raw)
            i = j
            continue
         }
      }
      out = out + chr(load8(expr, i))
      i += 1
   }
   out
}

fn _clean_signature_param_index_name(dict sig, str term) str {
   def params = sig.get("params", [])
   mut i = 0
   while i < params.len {
      def p = params[i]
      if p.get("shape", "") != "struct_ptr" && term == p.get("name", "") { return term }
      i += 1
   }
   ""
}

fn _clean_signature_param_for_index(dict sig, str term) dict {
   def params = sig.get("params", [])
   mut i = 0
   while i < params.len {
      def p = params[i]
      if p.get("shape", "") != "struct_ptr" && term == p.get("name", "") { return p }
      i += 1
   }
   dict()
}

fn _clean_param_index_stride(dict sig, str base) int {
   def p = _clean_signature_param_for_index(sig, base)
   if p.len == 0 { return 0 }
   int(p.get("pointer_index_stride", 0))
}

fn _clean_scaled_index_term(str term0) dict {
   def compact = str.str_replace(str.strip(term0), " ", "")
   def star = str.find(compact, "*")
   if star <= 0 || star >= compact.len - 1 { return dict() }
   def left = slice(compact, 0, star, 1)
   def right = slice(compact, star + 1, compact.len, 1)
   if _fact_term_int(right) && !_fact_term_int(left) {
      return {"expr": left, "scale": _parse_int_piece(right)}
   }
   if _fact_term_int(left) && !_fact_term_int(right) {
      return {"expr": right, "scale": _parse_int_piece(left)}
   }
   dict()
}

fn _clean_plain_index_reg(dict sig, str term0) bool {
   def term = str.strip(term0)
   if (term.len == 0 || str.find(term, " ") >= 0 || str.find(term, "*") >= 0 ||
      str.find(term, "+") >= 0 || str.find(term, "-") >= 0){ return false }
   _canonical_value_reg(_abi_family_from_name(sig.get("abi", "sysv_x86_64")), term).len > 0
}

fn _clean_index_join(list terms, int offset) str {
   mut xs = terms
   if offset != 0 { xs = xs.append(offset < 0 ? ("-" + to_str(-offset)) : to_str(offset)) }
   if xs.len == 0 { return "0" }
   mut out = ""
   mut i = 0
   while i < xs.len {
      def t = to_str(xs[i])
      if i == 0 { out = t }
      elif str.startswith(t, "-") { out = out + " - " + slice(t, 1, t.len, 1) }
      else { out = out + " + " + t }
      i += 1
   }
   out
}

fn _clean_param_index_for_mem(dict sig, str raw) str {
   if !str.startswith(raw, "mem(") || raw.len <= 5 || load8(raw, raw.len - 1) != 41 { return "" }
   def expr = _clean_strip_outer_parens(slice(raw, 4, raw.len - 1, 1))
   if str.find(expr, "mem(") >= 0 { return "" }
   def terms = _fact_expr_terms(expr)
   mut base = ""
   mut idxs = []
   mut offset = 0
   mut i = 0
   while i < terms.len {
      def sign = int(terms[i].get("sign", 1))
      def term = _fact_clean_term(terms[i].get("text", ""))
      if term.len > 0 {
         if _fact_term_int(term) {
            offset += sign * _parse_int_piece(term)
         } else {
            mut pname = sign > 0 ? _clean_signature_param_index_name(sig, term) : ""
            if pname.len == 0 && sign > 0 && str.find(term, "[") >= 0 && str.find(term, "]") > str.find(term, "[") {
               pname = term
            }
            if pname.len > 0 && base.len == 0 {
               base = pname
            } else {
               idxs = idxs.append((sign < 0 ? "-" : "") + term)
            }
         }
      }
      i += 1
   }
   if base.len == 0 { return "" }
   if idxs.len == 0 {
      def stride = _clean_param_index_stride(sig, base)
      if stride > 1 && offset % stride == 0 { return base + "[" + to_str(offset / stride) + "]" }
   }
   if idxs.len == 1 && offset == 0 {
      def scaled = _clean_scaled_index_term(idxs[0])
      def stride = _clean_param_index_stride(sig, base)
      def scale = int(scaled.get("scale", 0))
      if scaled.len > 0 && scale > 1 && (stride == 0 || stride == scale) {
         return base + "[" + scaled.get("expr", "") + "]"
      }
      def param = _clean_signature_param_for_index(sig, base)
      if (stride == 0 && param.get("shape", "unknown") == "unknown" &&
         param.get("kind", "") == "x86_stack_frame_guess" && _clean_plain_index_reg(sig, idxs[0])){
         return ""
      }
   }
   base + "[" + _clean_index_join(idxs, offset) + "]"
}

fn _clean_param_index_text(dict sig, str expr0) str {
   if sig.get("params", []).len == 0 { return expr0 }
   def expr = str.strip(expr0)
   if expr.len == 0 || str.find(expr, "mem(") < 0 { return expr0 }
   mut out = ""
   mut i = 0
   while i < expr.len {
      if i + 4 <= expr.len && slice(expr, i, i + 4, 1) == "mem(" {
         mut j = i + 4
         mut depth = 1
         while j < expr.len && depth > 0 {
            def ch = load8(expr, j)
            if ch == 40 { depth += 1 }
            elif ch == 41 { depth -= 1 }
            j += 1
         }
         if depth == 0 {
            def raw = slice(expr, i, j, 1)
            mut repl = _clean_param_index_for_mem(sig, raw)
            if repl.len == 0 {
               def inner = slice(raw, 4, raw.len - 1, 1)
               def inner_repl = _clean_param_index_text(sig, inner)
               if inner_repl != inner {
                  def reraw = "mem(" + inner_repl + ")"
                  repl = _clean_param_index_for_mem(sig, reraw)
                  if repl.len == 0 { repl = reraw }
               }
            }
            out = out + (repl.len > 0 ? repl : raw)
            i = j
            continue
         }
      }
      out = out + chr(load8(expr, i))
      i += 1
   }
   out
}

fn _clean_x86_stack_param_for_mem(str raw) str {
   if !str.startswith(raw, "mem(") || raw.len <= 5 || load8(raw, raw.len - 1) != 41 { return "" }
   def compact = str.str_replace(slice(raw, 4, raw.len - 1, 1), " ", "")
   mut off0 = -1
   if str.startswith(compact, "ebp+") { off0 = _parse_int_piece(slice(compact, 4, compact.len, 1)) }
   elif str.startswith(compact, "esp+") { off0 = _parse_int_piece(slice(compact, 4, compact.len, 1)) }
   elif str.startswith(compact, "0+") { off0 = _parse_int_piece(slice(compact, 2, compact.len, 1)) }
   if off0 >= 8 && off0 % 4 == 0 { return "arg" + to_str((off0 - 8) / 4) }
   def mem = _fact_mem_expr(raw)
   if mem.len == 0 || (mem.get("base", "") != "ebp" && mem.get("base", "") != "esp" && mem.get("base", "") != "0" && mem.get("base", "").len > 0) || mem.get("index", "").len > 0 { return "" }
   def off = int(mem.get("offset", 0))
   if off < 8 || off % 4 != 0 { return "" }
   "arg" + to_str((off - 8) / 4)
}

fn _clean_x86_stack_param_text(str expr0) str {
   def expr = str.strip(expr0)
   if expr.len == 0 || str.find(expr, "mem(") < 0 { return expr0 }
   mut out = ""
   mut i = 0
   while i < expr.len {
      if i + 4 <= expr.len && slice(expr, i, i + 4, 1) == "mem(" {
         mut j = i + 4
         mut depth = 1
         while j < expr.len && depth > 0 {
            def ch = load8(expr, j)
            if ch == 40 { depth += 1 }
            elif ch == 41 { depth -= 1 }
            j += 1
         }
         if depth == 0 {
            def raw = slice(expr, i, j, 1)
            def repl = _clean_x86_stack_param_for_mem(raw)
            if repl.len > 0 {
               out = out + repl
            } else {
               def inner = slice(raw, 4, raw.len - 1, 1)
               def clean_inner = _clean_x86_stack_param_text(inner)
               out = out + "mem(" + clean_inner + ")"
            }
            i = j
            continue
         }
      }
      out = out + chr(load8(expr, i))
      i += 1
   }
   out
}

fn _clean_expr_with_sig_bin(dict bin, dict sig, list rows, str expr0) str {
   def base0 = _clean_stack_literal_text(bin, rows,
      _clean_param_index_text(sig, _clean_dynamic_data_text_with_rows(bin, rows,
            _clean_local_param_alias_text(sig, rows, _clean_expr_with_sig(sig, rows, expr0)))))
   def pic = _clean_data_addr_expr_with_rows(bin, rows, base0)
   def base = pic.len > 0 ? pic : base0
   _clean_simplify_redundant_casts(_clean_strip_zext_literal_index(_clean_param_index_text(sig, _clean_x86_stack_param_text(base))))
}

fn _clean_param_reg_redefined_before(list rows, int before_idx, str reg0) bool {
   if before_idx < 0 { return false }
   def reg = str.strip(reg0)
   if reg.len == 0 { return false }
   mut j = min(before_idx, rows.len - 1)
   while j >= 0 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "call" || op == "syscall" || op == "return" { break }
      if _row_def_intersects_operand(r, reg) { return true }
      j -= 1
   }
   false
}

fn _clean_redefined_param_name_text(dict bin, dict sig, list rows, int before_idx, str expr0) str {
   if before_idx < 0 || sig.get("params", []).len == 0 { return expr0 }
   def expr = str.strip(expr0)
   if expr.len == 0 { return expr0 }
   def params = sig.get("params", [])
   mut out = ""
   mut i = 0
   mut quote = 0
   while i < expr.len {
      def ch = load8(expr, i)
      if quote != 0 {
         out = out + chr(ch)
         if ch == 92 && i + 1 < expr.len {
            i += 1
            out = out + chr(load8(expr, i))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         out = out + chr(ch)
         i += 1
         continue
      }
      if _symbol_is_name_char(ch) {
         def start = i
         while i < expr.len && _symbol_is_name_char(load8(expr, i)) { i += 1 }
         def tok = slice(expr, start, i, 1)
         mut repl = ""
         mut raw_loop_reg = false
         mut pi = 0
         while pi < params.len && repl.len == 0 {
            def p = params[pi]
            if tok == p.get("name", "") {
               def reg = p.get("reg", "")
               if _clean_param_reg_redefined_before(rows, before_idx, reg) {
                  def recent = _clean_recent_loop_symbols(rows, before_idx, bin)
                  if _symbols_intersect(_slice_symbol_aliases(reg), recent) {
                     repl = _ny_operand_ref_bin(bin, reg, dict())
                     raw_loop_reg = true
                  } else {
                     repl = _clean_operand_expr_at(bin, rows, before_idx, reg, 0, true,
                        _append_all_unique(_clean_enclosing_loop_symbols(rows, before_idx, bin), recent))
                  }
                  if repl.len > 0 && !raw_loop_reg { repl = _clean_expr_with_sig_bin(bin, sig, rows, repl) }
               }
            }
            pi += 1
         }
         mut extra_index = ""
         mut consume_index_end = -1
         if repl.len > 0 && str.find(repl, "[") >= 0 && i < expr.len && load8(expr, i) == 91 {
            mut end_idx = i + 1
            while end_idx < expr.len && load8(expr, end_idx) != 93 { end_idx += 1 }
            if end_idx < expr.len {
               def existing_idx = str.strip(slice(expr, i + 1, end_idx, 1))
               def simple_idx = existing_idx.len > 0 && (str.ascii_is_digit(load8(existing_idx, 0)) || str.startswith(existing_idx, "0x"))
               if !(existing_idx == "0" || existing_idx == "0x0") {
                  if simple_idx {
                     repl = ""
                  } else {
                     extra_index = "[" + existing_idx + "]"
                     consume_index_end = end_idx + 1
                  }
               }
            }
         }
         if repl.len > 0 && repl != tok {
            mut rendered = str.find(repl, " ") >= 0 ? _clean_paren(repl) : repl
            if extra_index.len > 0 {
               rendered = rendered + extra_index
               i = consume_index_end
            }
            if str.find(rendered, "[") >= 0 && i + 7 < expr.len && slice(expr, i, i + 7, 1) == ".field_" {
               mut end = i + 7
               while end < expr.len && str.ascii_is_hex_digit(load8(expr, end)) { end += 1 }
               if end > i + 7 {
                  rendered = rendered + "[" + to_str(_parse_int_piece("0x" + slice(expr, i + 7, end, 1))) + "]"
                  i = end
               }
            }
            out = out + rendered
         } else {
            out = out + tok
         }
      } else {
         out = out + chr(ch)
         i += 1
      }
   }
   out
}

fn _clean_lhs_with_sig_bin(dict bin, dict sig, list rows, str lhs0) str {
   def lhs = str.strip(lhs0)
   if lhs.len == 0 { return "" }
   def family = _abi_family_from_name(sig.get("abi", _rows_family(rows)))
   def reg = _canonical_value_reg(family, lhs)
   if reg.len > 0 && _param_name_for_reg(sig, reg).len > 0 {
      return _ny_operand_ref_bin(bin, lhs, dict())
   }
   _clean_expr_with_sig_bin(bin, sig, rows, lhs)
}

fn _clean_mem_alias_lvalue_at(dict bin, dict sig, list rows, int row_idx, str op0) str {
   def raw = _clean_operand(op0)
   if _operand_kind(raw) != "mem" { return "" }
   def direct = _clean_expr_with_sig_bin(bin, sig, rows, _ny_operand_ref_bin(bin, op0, dict()))
   if direct.len > 0 && !str.startswith(direct, "mem(") { return direct }
   def mem = _fact_mem_expr(raw)
   if mem.len == 0 || mem.get("base", "").len == 0 { return "" }
   if mem.get("index", "").len > 0 || int(mem.get("scale", 0)) != 0 || int(mem.get("offset", 0)) != 0 { return "" }
   def base = mem.get("base", "")
   def resolved0 = _clean_operand_expr_at(bin, rows, row_idx - 1, base, 0, true)
   def resolved = _clean_expr_with_sig_bin(bin, sig, rows, resolved0)
   def direct_lvalue = _clean_address_lvalue_expr(resolved)
   if direct_lvalue.len > 0 { return direct_lvalue }
   _clean_address_lvalue_expr(_clean_address_expr_at(bin, sig, rows, row_idx - 1, base, 0))
}

fn _clean_address_lvalue_expr(str expr0) str {
   mut expr = str.strip(expr0)
   if expr.len == 0 { return "" }
   if str.startswith(expr, "&") { expr = str.strip(slice(expr, 1, expr.len, 1)) }
   if !(str.startswith(expr, "local_") || str.startswith(expr, "stack_")) { return "" }
   def add = str.find(expr, " + ")
   if add > 0 {
      def base = str.strip(slice(expr, 0, add, 1))
      def idx = str.strip(slice(expr, add + 3, expr.len, 1))
      if idx.len == 0 || idx == "0" || idx == "0x0" { return base }
      return base + "[" + idx + "]"
   }
   def sub = str.find(expr, " - ")
   if sub > 0 {
      def base = str.strip(slice(expr, 0, sub, 1))
      def idx = str.strip(slice(expr, sub + 3, expr.len, 1))
      if idx.len == 0 || idx == "0" || idx == "0x0" { return base }
      return base + "[-" + idx + "]"
   }
   expr
}

fn _clean_address_expr_at(dict bin, dict sig, list rows, int before_idx, str op0, int depth=0) str {
   if depth > 8 { return "" }
   def idx = _clean_prev_def_row(rows, before_idx, op0)
   if idx < 0 { return "" }
   def row = rows[idx]
   def op = row.get("op", "")
   if op == "assign" {
      def kind = row.get("kind", "")
      if kind == "lea" {
         def addr = row.get("addr_expr", "").len > 0 ? row.get("addr_expr", "") :
         _effect_rhs(row.get("effect", ""), _ny_address_operand_ref_bin(bin, row.get("src", ""), row.get("ref", dict())))
         return _clean_expr_with_sig_bin(bin, sig, rows, addr)
      }
      if row.get("src_kind", "") == "reg" {
         def chained = _clean_address_expr_at(bin, sig, rows, idx - 1, row.get("src", ""), depth + 1)
         if chained.len > 0 { return chained }
      }
      return ""
   }
   if op == "arith" && row.get("dst_kind", "") == "reg" {
      def sym = row.get("operator", "")
      if sym == "+" || sym == "-" {
         def left = _clean_address_expr_at(bin, sig, rows, idx - 1, row.get("dst", ""), depth + 1)
         if left.len > 0 {
            mut right = _clean_operand_expr_at(bin, rows, idx - 1, row.get("src", ""), 0, true)
            if right.len == 0 { right = _ny_operand_ref_sig_bin(bin, sig, row.get("src", ""), row.get("ref", dict())) }
            right = _clean_expr_with_sig_bin(bin, sig, rows, right)
            if right.len > 0 { return left + " " + sym + " " + right }
         }
      }
   }
   ""
}

fn _clean_magic_folded_stmt_expr(str expr0) bool {
   def expr = str.strip(expr0)
   if expr.len == 0 || expr.len > 160 { return false }
   if (str.find(expr, "smulhi") >= 0 || str.find(expr, "umulhi") >= 0 ||
      str.find(expr, "smul_wide") >= 0 || str.find(expr, "umul_wide") >= 0){ return false }
   str.find(expr, " / 3") >= 0 || str.find(expr, " % 3") >= 0
}

fn _clean_effect_with_sig_bin(dict bin, dict sig, list rows, int row_idx, dict row, str effect0) str {
   def effect = str.strip(effect0)
   if effect.len == 0 { return "" }
   def op = row.get("op", "")
   if op == "arith" && row.get("dst_kind", "") == "mem" && row.get("src", "").len > 0 {
      def sym = row.get("operator", "")
      def alias = _clean_mem_alias_lvalue_at(bin, sig, rows, row_idx, row.get("dst", ""))
      if alias.len > 0 && sym.len > 0 && sym != "neg" && sym != "~" {
         mut rhs = _clean_operand_expr_at(bin, rows, row_idx - 1, row.get("src", ""), 0, true)
         if rhs.len == 0 { rhs = _ny_operand_ref_sig_bin(bin, sig, row.get("src", ""), row.get("ref", dict())) }
         rhs = _clean_expr_with_sig_bin(bin, sig, rows, rhs)
         return alias + " = " + alias + " " + sym + " " + rhs
      }
   }
   if op == "assign" || op == "arith" || op == "stack" || op == "compare" {
      def eq = str.find(effect, "=")
      if eq > 0 {
         def lhs = str.strip(slice(effect, 0, eq, 1))
         def rhs = str.strip(slice(effect, eq + 1, effect.len, 1))
         mut clean_lhs = _clean_lhs_with_sig_bin(bin, sig, rows, lhs)
         mut clean_rhs = _clean_expr_with_sig_bin(bin, sig, rows, rhs)
         if (op == "assign" && row.get("src", "").len > 0 && row.get("kind", "") != "setcc" &&
            row.get("kind", "") != "cmovcc" && row.get("kind", "") != "lea" && row.get("kind", "") != "swap"){
            def src_kind = row.get("src_kind", "")
            def family = row.get("family", _rows_family(rows))
            def dst_reg = _canonical_value_reg(family, row.get("dst", ""))
            def src_reg = _canonical_value_reg(family, row.get("src", ""))
            if (src_kind == "reg" || src_kind == "mem") && !_stack_value_reg(family, dst_reg) && !_stack_value_reg(family, src_reg) {
               mut preserve = []
               if src_kind == "mem" {
                  def mem = _fact_mem_expr(row.get("src", ""))
                  def idx = mem.get("index", "")
                  if idx.len > 0 { preserve = _append_all_unique(preserve, _slice_symbol_aliases(idx)) }
                  def src_syms = _slice_operand_symbols(row.get("src", ""))
                  if _clean_loop_has_later_def(rows, row_idx, src_syms, bin) {
                     preserve = _append_all_unique(preserve, src_syms)
                  }
               } elif src_kind == "reg" {
                  def src_syms = _slice_operand_symbols(row.get("src", ""))
                  if _clean_loop_has_later_def(rows, row_idx, src_syms, bin) {
                     preserve = _append_all_unique(preserve, src_syms)
                  }
               }
               mut src_expr = _clean_operand_expr_at(bin, rows, row_idx - 1, row.get("src", ""), 0, true, preserve)
               if src_expr.len > 0 && src_expr != row.get("src", "") {
                  src_expr = _clean_expr_with_sig_bin(bin, sig, rows, src_expr)
                  if src_expr.len > 0 && src_expr != clean_lhs { clean_rhs = src_expr }
               }
            }
         }
         if op == "arith" && row.get("dst_kind", "") == "reg" {
            mut folded = _clean_operand_expr_at(bin, rows, row_idx, row.get("dst", ""), 0, true)
            folded = _clean_expr_with_sig_bin(bin, sig, rows, folded)
            if _clean_magic_folded_stmt_expr(folded) && folded != clean_lhs {
               return clean_lhs + " = " + folded
            }
         }
         if op == "arith" && row.get("src_kind", "") == "reg" && row.get("src", "").len > 0 {
            def src_aliases = _slice_symbol_aliases(row.get("src", ""))
            def preserve0 = _clean_enclosing_loop_symbols(rows, row_idx, bin)
            def source_is_loop_carried = _clean_loop_has_later_def(rows, row_idx, src_aliases, bin)
            mut preserve = []
            mut pi = 0
            while pi < preserve0.len {
               if source_is_loop_carried || !_list_has(src_aliases, preserve0[pi]) { preserve = preserve.append(preserve0[pi]) }
               pi += 1
            }
            mut src_expr = _clean_operand_expr_at(bin, rows, row_idx - 1, row.get("src", ""), 0, true, preserve)
            if src_expr.len > 0 && src_expr != row.get("src", "") {
               src_expr = _clean_expr_with_sig_bin(bin, sig, rows, src_expr)
               src_expr = _clean_branch_recent_loop_param_aliases(bin, sig, rows, row_idx, row.get("src", ""), src_expr)
               mut src_names = _slice_symbol_aliases(row.get("src", ""))
               def pname = _param_name_for_token(sig, _rows_family(rows), row.get("src", ""))
               if pname.len > 0 { src_names = _append_unique(src_names, pname) }
               clean_rhs = _clean_replace_aliases_text(clean_rhs, src_names, _clean_expr_subst_wrap(src_expr))
            }
         }
         clean_lhs = _clean_branch_recent_loop_param_aliases(bin, sig, rows, row_idx, lhs, clean_lhs)
         clean_rhs = _clean_branch_recent_loop_param_aliases(bin, sig, rows, row_idx, rhs, clean_rhs)
         def alias = _clean_mem_alias_lvalue_at(bin, sig, rows, row_idx, row.get("dst", ""))
         if alias.len > 0 {
            clean_rhs = str.str_replace(clean_rhs, clean_lhs, alias)
            clean_lhs = alias
         }
         return clean_lhs + " = " +
         _clean_simplify_redundant_casts(_clean_redefined_param_name_text(bin, sig, rows, row_idx - 1, clean_rhs))
      }
   }
   _clean_simplify_redundant_casts(_clean_redefined_param_name_text(bin, sig, rows, row_idx - 1, _clean_expr_with_sig_bin(bin, sig, rows, effect)))
}

fn _call_arg_model_with_sig(dict bin, dict caller_sig, list rows, int idx) list {
   mut args = _call_arg_model(rows, idx)
   if idx < 0 || idx >= rows.len { return args }
   def stack_args = _call_stack_arg_model(bin, rows, idx)
   if stack_args.len > 0 { args = stack_args }
   def row = rows[idx]
   if int(row.get("target", 0)) <= 0 { return args }
   if rows.len > 192 { return args }
   def sec = _section_for_addr(bin, int(row.get("target", 0)))
   if sec.len == 0 || str.find(sec.get("name", ""), ".plt") >= 0 { return args }
   def callee_rows = lift(bin, int(row.get("target", 0)), 160)
   def callee_sig = _signature_for_local_rows(bin, callee_rows)
   def cps = callee_sig.get("params", [])
   def regs = _abi_profile(row.get("family", _rows_family(rows))).get("args", [])
   mut allowed = dict()
   mut i = 0
   while i < cps.len {
      def cidx = _param_abi_index(callee_sig.get("abi", ""), cps[i])
      if cidx >= 0 && cidx < regs.len {
         def reg = regs[cidx]
         allowed = allowed.set(reg, true)
         if !_arg_exists(args, reg) {
            def pname = _param_name_for_reg(caller_sig, reg)
            if pname.len > 0 {
               mut value = pname
               mut resolved = _clean_operand_expr_at(bin, rows, idx - 1, reg, 0, true)
               if resolved.len == 0 || resolved == reg {
                  resolved = _clean_expr_resolve_regs_at(bin, rows, idx - 1, reg, 0)
               }
               if resolved.len > 0 && resolved != reg {
                  value = _clean_redefined_param_name_text(bin, caller_sig, rows, idx - 1,
                     _clean_expr_with_sig_bin(bin, caller_sig, rows, resolved))
               }
               args = args.append(_arg_enrich({"reg": reg, "value": value, "site": int(row.get("addr", 0)), "kind": "signature_live_in"}, cidx))
            }
         }
      }
      i += 1
   }
   if allowed.len > 0 {
      mut filtered = []
      i = 0
      while i < args.len {
         if allowed.get(args[i].get("reg", ""), false) { filtered = filtered.append(args[i]) }
         i += 1
      }
      args = filtered
   }
   args
}

fn _clean_replace_symbol_expr(dict bin, list rows, int before_idx, str expr0) str {
   def expr = str.strip(expr0)
   if expr.len == 0 { return "" }
   def family = _rows_family(rows)
   mut out = ""
   mut i = 0
   while i < expr.len {
      def ch = load8(expr, i)
      if _symbol_is_name_char(ch) {
         def start = i
         while i < expr.len && _symbol_is_name_char(load8(expr, i)) { i += 1 }
         def tok = slice(expr, start, i, 1)
         if _canonical_value_reg(family, tok).len > 0 {
            def repl = _clean_operand_expr_at(bin, rows, before_idx, tok, 0, true)
            if repl.len > 0 && repl != tok && !(str.find(repl, "mem(") >= 0 && str.find(repl, tok) >= 0) {
               out = out + (str.find(repl, " ") >= 0 ? _clean_paren(repl) : repl)
            } else {
               out = out + tok
            }
         } else {
            out = out + tok
         }
      } else {
         out = out + chr(ch)
         i += 1
      }
   }
   out
}

fn _clean_call_arg_value(dict bin, list rows, int call_idx, dict arg) dict {
   def site = int(arg.get("resolved_site", arg.get("site", 0)))
   def row_idx = _row_index_for_addr(rows, site)
   def before = row_idx >= 0 ? row_idx - 1 : call_idx - 1
   def raw = str.strip(to_str(arg.get("value", "")))
   if raw.len == 0 { return arg }
   mut value = raw
   def family = _rows_family(rows)
   def canon_raw = _canonical_value_reg(family, raw)
   if canon_raw.len > 0 {
      def arg_reg = arg.get("reg", "")
      def call_name = call_idx >= 0 && call_idx < rows.len ? rows[call_idx].get("target_name", "") : ""
      if (_call_known_fixed_arg_count(call_name) >= 0 &&
         arg_reg.len > 0 && !_symbols_intersect(_slice_operand_symbols(arg_reg), _slice_operand_symbols(raw)) &&
         _clean_arg_reg_saved_recent_return(rows, row_idx >= 0 ? row_idx : before, arg_reg, raw)){
         return arg.set("value", arg_reg)
      }
      value = _clean_operand_expr_at(bin, rows, before, raw, 0, true)
      if value == raw && _abi_arg_index(family, canon_raw) >= 0 {
         def cfg_value = _clean_expr_resolve_regs_at(bin, rows, before, raw, 0)
         if cfg_value.len > 0 && cfg_value != raw { value = cfg_value }
      }
      if value == raw {
         def alias = _clean_saved_param_alias_before(rows, call_idx - 1, family, raw)
         if alias.len > 0 { value = alias }
         else {
            def near_alias = _clean_nearest_callee_saved_param_alias(rows, call_idx - 1, family, raw)
            if near_alias.len > 0 { value = near_alias }
         }
      }
   } elif str.find(raw, "mem(") >= 0 || str.find(raw, " + ") >= 0 || str.find(raw, " - ") >= 0 {
      value = _clean_replace_symbol_expr(bin, rows, before, raw)
   }
   value.len > 0 ? arg.set("value", value) : arg
}

fn _clean_row_defines_symbol_alias(dict bin, list rows, int idx, str sym) bool {
   if idx < 0 || idx >= rows.len { return false }
   def r = rows[idx]
   mut defs = _row_defs(r)
   if r.get("dst_kind", "") == "mem" {
      mut alias = _clean_mem_alias_lvalue_at(bin, dict(), rows, idx, r.get("dst", ""))
      if alias.len == 0 {
         alias = _clean_address_lvalue_expr(_clean_address_expr_at(bin, dict(), rows, idx - 1, r.get("dst", ""), 0))
      }
      if alias.len > 0 { defs = _append_unique(defs, alias) }
   }
   _symbols_intersect(defs, _slice_symbol_aliases(sym))
}

fn _clean_scaled_setup_uses_symbol(list rows, int idx, str sym) bool {
   if idx < 0 || idx >= rows.len { return false }
   def r = rows[idx]
   if r.get("op", "") != "assign" || r.get("kind", "") != "lea" { return false }
   def rhs = _effect_rhs(r.get("effect", ""), r.get("src", ""))
   if str.find(rhs, "*") < 0 { return false }
   def uses = _append_all_unique(_row_uses(r), _symbols_from_text(rhs))
   mut j = idx - 1
   while j >= 0 && idx - j <= 4 {
      if (_symbols_intersect(_row_defs(rows[j]), uses) &&
         _symbols_intersect(_symbols_from_text(_effect_rhs(rows[j].get("effect", ""), rows[j].get("src", ""))), [sym])){
         return true
      }
      j -= 1
   }
   false
}

fn _clean_post_inc_index_value(dict bin, list rows, int call_idx, str value0) str {
   mut value = str.strip(value0)
   if value.len == 0 || str.find(value, "[local_") < 0 { return value0 }
   mut i = 0
   while i < value.len {
      mut open = str.find(slice(value, i, value.len, 1), "[local_")
      if open < 0 { break }
      open += i
      mut close = str.find(slice(value, open, value.len, 1), "]")
      if close < 0 { break }
      close += open
      def sym = str.strip(slice(value, open + 1, close, 1))
      mut inc_idx = -1
      mut j = call_idx - 1
      while j >= 0 && call_idx - j <= 8 && inc_idx < 0 {
         def r = rows[j]
         if (_clean_row_defines_symbol_alias(bin, rows, j, sym) && r.get("op", "") == "arith" &&
            r.get("operator", "") == "+" && (r.get("src", "") == "" || _clean_literal_one(_ny_operand(r.get("src", ""))))){
            inc_idx = j
         }
         j -= 1
      }
      if inc_idx >= 0 {
         mut saw_setup = false
         j = inc_idx - 1
         while j >= 0 && inc_idx - j <= 8 && !saw_setup {
            if _clean_scaled_setup_uses_symbol(rows, j, sym) { saw_setup = true }
            j -= 1
         }
         if saw_setup {
            value = str.str_replace(value, "[" + sym + "]", "[" + sym + " - 1]")
            i = open + sym.len + 5
            continue
         }
      }
      i = close + 1
   }
   value
}

fn _clean_arg_reg_saved_recent_return(list rows, int before_idx, str arg_reg0, str raw_reg0) bool {
   def arg_reg = str.strip(arg_reg0)
   def raw_reg = str.strip(raw_reg0)
   if arg_reg.len == 0 || raw_reg.len == 0 { return false }
   mut j = before_idx
   mut guard = 0
   while j >= 0 && guard < 8 {
      def r = rows[j]
      def op = r.get("op", "")
      if (op == "assign" && _row_def_intersects_operand(r, arg_reg) &&
         _symbols_intersect(_slice_operand_symbols(r.get("src", "")), _slice_operand_symbols(raw_reg))){
         return _clean_row_saves_recent_call_result(rows, j)
      }
      if op == "branch" || op == "return" || op == "syscall" { return false }
      j -= 1
      guard += 1
   }
   false
}

fn _clean_call_arg_model_with_sig(dict bin, dict caller_sig, list rows, int idx) list {
   def args = _call_arg_model_with_sig(bin, caller_sig, rows, idx)
   mut out = []
   mut i = 0
   while i < args.len {
      def arg = _clean_call_arg_value(bin, rows, idx, args[i])
      mut clean_value = _clean_post_inc_index_value(bin, rows, idx,
         _clean_expr_with_sig_bin(bin, caller_sig, rows, arg.get("value", "")))
      def stack_array_arg = _clean_stack_byte_array_arg_text(bin, rows, idx, clean_value)
      if stack_array_arg.len > 0 { clean_value = stack_array_arg }
      out = out.append(arg.set("value", clean_value))
      i += 1
   }
   out
}

fn type_recovery(any source, any target=0, any opts=dict()) dict {
   "Return conservative type and layout evidence for a function.
   The pass combines facts(...), ABI signature evidence, known library call
   signatures, and optional clean rendered text. It intentionally reports
   evidence instead of inventing source-level names."
   def maxb = int(opts.get("max_bytes", 512))
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   if !bin.get("ok", false) { return {"kind": "type_recovery", "ok": false, "locals": [], "calls": [], "structs": []} }
   def tb = _target_bytes(bin, target, maxb)
   def rows = lift(bin, target, maxb)
   def graph = cfg(bin, target, maxb)
   def factset = _facts_from(bin, target, rows, graph)
   def sig = _function_signature_for(bin, target, rows, int(tb.get("addr", 0)), maxb)
   mut rec = _type_recovery_from_rows(bin, target, rows, factset, sig, maxb).set("ok", true)
   if opts.contains("rendered_text") {
      rec = _type_recovery_with_rendered(rec, opts.get("rendered_text", ""))
   } elif opts.get("rendered", false) {
      def rtext = ny_pseudocode(bin, target, opts.set("max_bytes", maxb).set("clean", true))
      rec = _type_recovery_with_rendered(rec, rtext)
   }
   rec
}

fn function_model(any source, any target=0, int max_bytes=1024) dict {
   "Return Ny decompiler function metadata: rows, labels, refs, CFG, frame, signature, and call args."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def tb = _target_bytes(bin, target, max_bytes)
   def raw = disassemble(bin, target, max_bytes)
   def rows = _lift_rows(bin, raw)
   def graph = _cfg_from_rows(bin, raw)
   def factset = _facts_from(bin, target, rows, graph)
   def machines = _state_machines_from_rows(bin, rows)
   def sig = _function_signature_for(bin, target, rows, int(tb.get("addr", 0)), max_bytes)
   def trec = _type_recovery_from_rows(bin, target, rows, factset, sig, max_bytes)
   mut local_notes = []
   def ns = notes(bin)
   mut ni = 0
   while ni < ns.len {
      def n = ns[ni]
      def na = int(n.get("addr", 0))
      if na == 0 || (na >= int(tb.get("addr", 0)) && na < int(tb.get("addr", 0)) + int(tb.get("bytes", "").len)) {
         local_notes = local_notes.append(n)
      }
      ni += 1
   }
   def jts = target == 0 ? _jump_tables_from_rows(bin, disassemble(bin, ".text", max_bytes)) : _jump_tables_from_rows(bin, raw)
   def sig_name = is_str(target) ? _safe_name(target, "sub") : _safe_name(tb.get("name", ""), "sub")
   def dominfo = _cfg_dominators_for_graph(graph)
   def pdominfo = _cfg_postdominators_for_graph(graph)
   {"language": "ny", "target": target, "name": _rename_addr(bin, tb.get("addr", 0), _rename_name(bin, tb.get("name", ""))), "addr": tb.get("addr", 0),
      "rows": rows, "labels": _labels_from_rows(bin, raw, jts), "refs": _data_refs_from_rows(bin, raw),
      "jump_tables": jts,
      "cfg": graph, "dominators": dominfo,
      "postdominators": pdominfo,
      "control_dependence": _cfg_control_dependence_for_graph(graph, pdominfo),
      "loops": _cfg_loops_for_graph(graph, dominfo),
      "state_machines": machines,
      "frame": _frame_model(rows), "signature": sig,
      "calls": _calls_model(rows, bin, sig), "syscalls": _syscalls_model(rows), "variables": _variables_from_rows(bin, rows, sig, sig_name),
      "def_use": factset.get("def_use", dict()), "facts": factset, "type_recovery": trec, "notes": local_notes}
}

fn function_signature(any source, any target=0, any opts=dict()) dict {
   "Return the ABI signature guess for a function, including local live-in uses and incoming call evidence."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   def maxb = int(opts.get("max_bytes", 512))
   def tb = _target_bytes(bin, target, maxb)
   def rows = lift(bin, target, maxb)
   _function_signature_for(bin, target, rows, int(tb.get("addr", 0)), maxb)
}

fn structured(any source, any target=0, int max_bytes=1024) dict {
   "Return rows, local labels, and CFG for Ny-oriented structured rendering."
   function_model(source, target, max_bytes)
}

fn semantic_summary(any source, any target=0, any opts=dict()) dict {
   "Return a fused analyst summary for a function/range.
   This pulls together model rows, calls, syscalls, SSA/VSA facts, memory shapes,
   branch dependencies, input surfaces, crackme targets, and concrete next-step
   recommendations. It is intentionally data-first so UIs/tools do not need to
   parse pseudocode."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source), opts)
   if !bin.get("ok", false) { return {"ok": false, "kind": "semantic_summary", "reason": bin.get("reason", "load_failed")} }
   def maxb = int(is_dict(opts) ? opts.get("max_bytes", 1024) : 1024)
   def model = function_model(bin, target, maxb)
   def facts0 = model.get("facts", dict())
   def by_kind = facts0.get("by_kind", dict())
   def notable_calls = _summary_call_records(model.get("calls", []))
   def syscall_recs = _summary_syscall_records(model.get("syscalls", []))
   def inputs = _summary_input_surfaces(model, notable_calls, syscall_recs)
   def hard = _summary_hard_branches(facts0, int(opts.get("branch_limit", 12)))
   def shapes = _summary_memory_shapes(facts0, int(opts.get("shape_limit", 12)))
   def machines = _summary_state_machines(model, int(opts.get("state_machine_limit", 8)))
   def rewrite = facts0.get("rewrite_candidates", dict())
   def simplifications = facts0.get("semantic_simplifications", dict()).get("rewrites", [])
   def targets = crackme_targets(bin, {"range": target == 0 ? ".text" : target, "max_bytes": maxb})
   mut anti = []
   mut i = 0
   while i < notable_calls.len {
      if notable_calls[i].get("category", "") == "anti_analysis" { anti = anti.append(notable_calls[i]) }
      i += 1
   }
   i = 0
   while i < syscall_recs.len {
      if syscall_recs[i].get("category", "") == "anti_analysis" { anti = anti.append(syscall_recs[i]) }
      i += 1
   }
   mut findings = []
   if inputs.len > 0 { findings = _summary_add_finding(findings, "info", "input_surface", "function receives controllable data", inputs) }
   if hard.len > 0 { findings = _summary_add_finding(findings, "info", "branch_dependencies", "branches have recoverable data dependencies", hard) }
   if shapes.len > 0 { findings = _summary_add_finding(findings, "info", "memory_shapes", "memory accesses form reusable struct/array shapes", shapes) }
   if machines.len > 0 { findings = _summary_add_finding(findings, "medium", "state_machines", "jump-table dispatchers suggest a state machine or VM-style control shape", machines) }
   if anti.len > 0 { findings = _summary_add_finding(findings, "medium", "anti_analysis", "function touches anti-analysis or loader-sensitive APIs", anti) }
   if targets.get("success", []).len > 0 { findings = _summary_add_finding(findings, "high", "crackme_targets", "success/failure strings are reachable from this range", targets) }
   if int(rewrite.get("dead_count", 0)) > 0 || int(rewrite.get("inline_count", 0)) > 0 {
      findings = _summary_add_finding(findings, "info", "rewrite_candidates", "SSA found values suitable for cleanup", rewrite)
   }
   if simplifications.len > 0 {
      findings = _summary_add_finding(findings, "info", "semantic_simplifications", "SMT proofs justify expression-level cleanup", simplifications)
   }
   mut out = {"ok": true, "kind": "semantic_summary", "language": "ny", "target": target,
      "name": model.get("name", ""), "addr": int(model.get("addr", 0)), "arch": arch(bin),
      "row_count": int(model.get("rows", []).len),
      "branch_count": int(by_kind.get("branch", 0)),
      "hard_branch_count": hard.len, "hard_branches": hard,
      "call_count": model.get("calls", []).len, "notable_calls": notable_calls,
      "syscalls": syscall_recs, "syscall_count": syscall_recs.len,
      "input_surfaces": inputs, "input_surface_count": inputs.len,
      "anti_analysis": anti, "anti_analysis_count": anti.len,
      "memory_shapes": shapes, "memory_shape_count": shapes.len,
      "state_machines": machines, "state_machine_count": machines.len,
      "ssa_value_count": int(facts0.get("ssa_value_count", 0)),
      "vsa_interval_count": int(facts0.get("vsa_interval_count", 0)),
      "semantic_simplifications": simplifications,
      "semantic_simplification_count": simplifications.len,
      "loop_count": model.get("loops", dict()).get("loops", []).len,
      "rewrite_candidates": rewrite,
      "crackme": targets,
      "crackme_success_count": targets.get("success", []).len,
      "crackme_failure_count": targets.get("failure", []).len,
      "findings": findings, "finding_count": findings.len,
      "model": model}
   out = out.set("score", _summary_score(out))
   out = out.set("recommendations", _summary_recommendations(out))
   out.set("text", _summary_text(out))
}

fn _hook_import_sites(dict proj, dict bin) dict {
   def sites = bin.contains("import_sites") ? bin.get("import_sites", []) : import_sites(bin)
   mut out = proj
   mut i = 0
   while i < sites.len {
      def s = sites[i]
      def addr = int(s.get("addr", 0))
      if addr > 0 {
         out = sym.project_proc(out, addr, s.get("name", "import_" + str.to_hex(addr, 0)),
            {"kind": "import", "site": s, "size": 16, "ret": addr + 16})
      }
      i += 1
   }
   out.set("import_hook_count", sites.len)
}

fn _parse_addr_ref(any ref) int {
   if is_int(ref) { return int(ref) }
   if is_dict(ref) { return int(ref.get("addr", ref.get("value", ref.get("start", 0)))) }
   if !is_str(ref) { return 0 }
   def s = str.strip(ref)
   if s.len == 0 { return 0 }
   if str.startswith(s, "0x") || str.startswith(s, "0X") { return str.parse_int(slice(s, 2, s.len, 1), 16) }
   mut i = 0
   while i < s.len {
      if !str.ascii_is_digit(load8(s, i)) { return 0 }
      i += 1
   }
   str.parse_int(s, 10)
}

fn _named_addr(dict bin, str name) int {
   if name.len == 0 { return 0 }
   def sites = bin.contains("import_sites") ? bin.get("import_sites", []) : import_sites(bin)
   mut i = 0
   while i < sites.len {
      def s = sites[i]
      if s.get("name", "") == name || _rename_name(bin, s.get("name", "")) == name { return int(s.get("addr", 0)) }
      i += 1
   }
   def fs = recover_functions(bin)
   i = 0
   while i < fs.len {
      def f = fs[i]
      if f.get("name", "") == name || _rename_name(bin, f.get("name", "")) == name { return int(f.get("value", f.get("start", 0))) }
      i += 1
   }
   def sy = bin.get("symbols", [])
   i = 0
   while i < sy.len {
      def s = sy[i]
      if s.get("name", "") == name || _rename_name(bin, s.get("name", "")) == name { return int(s.get("value", 0)) }
      i += 1
   }
   def sec = section(bin, name)
   sec.len > 0 ? int(sec.get("addr", 0)) : 0
}

fn _hook_addr(dict bin, any spec, any key=0) int {
   if is_dict(spec) {
      if spec.contains("addr") { return _parse_addr_ref(spec.get("addr", 0)) }
      if spec.contains("target") { return _parse_addr_ref(spec.get("target", 0)) }
      if key != 0 && to_str(key).len > 0 && (!spec.contains("name") || to_str(key) != to_str(spec.get("name", ""))) {
         def from_key = _parse_addr_ref(key)
         if from_key > 0 { return from_key }
         def named_key = _named_addr(bin, to_str(key))
         if named_key > 0 { return named_key }
      }
      if spec.contains("name") {
         def direct = _parse_addr_ref(spec.get("name", ""))
         if direct > 0 { return direct }
         return _named_addr(bin, to_str(spec.get("name", "")))
      }
   }
   def parsed = _parse_addr_ref(key)
   if parsed > 0 { return parsed }
   _named_addr(bin, to_str(key))
}

fn _apply_harness_procedure(dict proj, dict bin, any key, any spec) dict {
   mut s = is_dict(spec) ? spec : dict()
   def name = is_dict(spec) ? to_str(spec.get("name", key)) : to_str(key)
   def addr = _hook_addr(bin, s, key)
   if addr <= 0 { return proj }
   if !s.contains("ret") { s = s.set("ret", addr + int(s.get("size", 1))) }
   sym.project_proc(proj, addr, s.get("proc", name), s)
}

fn _apply_harness_hook(dict proj, dict bin, any key, any spec) dict {
   mut s = is_dict(spec) ? spec : {"name": to_str(spec)}
   def addr = _hook_addr(bin, s, key)
   if addr <= 0 { return proj }
   if !s.contains("name") { s = s.set("name", to_str(key)) }
   if !s.contains("ret") { s = s.set("ret", addr + int(s.get("size", 1))) }
   sym.project_hook(proj, addr, s)
}

fn _apply_harness_project_opts(dict proj, dict bin, any opts) dict {
   if !is_dict(opts) { return proj }
   mut out = proj
   if opts.contains("procedures") {
      def ps = opts.get("procedures", dict())
      if is_dict(ps) {
         def ks = ps.keys()
         mut i = 0
         while i < ks.len { out = _apply_harness_procedure(out, bin, ks[i], ps.get(ks[i], dict())) i += 1 }
      } elif is_list(ps) {
         mut i = 0
         while i < ps.len { out = _apply_harness_procedure(out, bin, ps[i].get("name", ps[i].get("addr", "")), ps[i]) i += 1 }
      }
   }
   if opts.contains("hooks") {
      def hs = opts.get("hooks", dict())
      if is_dict(hs) {
         def ks = hs.keys()
         mut i = 0
         while i < ks.len { out = _apply_harness_hook(out, bin, ks[i], hs.get(ks[i], dict())) i += 1 }
      } elif is_list(hs) {
         mut i = 0
         while i < hs.len { out = _apply_harness_hook(out, bin, hs[i].get("name", hs[i].get("addr", "")), hs[i]) i += 1 }
      }
   }
   out
}

fn symbolic_project(any source, any target=0, int max_bytes=4096) dict {
   "Create a `lib.os.symbolic` project for an ELF range with ELF load segments mapped."
   def tb = _target_bytes(source, target, max_bytes)
   if !tb.get("ok", false) { return {"ok": false, "reason": "target_bytes_unavailable", "target": target} }
   def bin = tb.get("analysis", dict())
   mut loads = []
   def segs = bin.get("segments", [])
   mut i = 0
   while i < segs.len {
      def s = segs[i]
      if s.get("load", false) && int(s.get("filesz", 0)) > 0 {
         def data = _slice(bin.get("data", ""), int(s.get("offset", 0)), int(s.get("filesz", 0)))
         loads = loads.append({"addr": int(s.get("vaddr", 0)), "size": data.len, "memsz": int(s.get("memsz", 0)),
               "data": data, "perms": _seg_perms(int(s.get("flags", 0))), "offset": int(s.get("offset", 0))})
      }
      i += 1
   }
   if loads.len == 0 {
      loads = [{"addr": tb.get("addr", 0), "size": tb.get("bytes", "").len, "memsz": tb.get("bytes", "").len,
            "data": tb.get("bytes", ""), "perms": "r-x", "offset": tb.get("offset", 0)}]
   }
   mut proj = sym.blob_project(tb.get("bytes", ""), {"arch": arch(bin), "base": tb.get("addr", 0), "entry": tb.get("addr", 0),
         "name": tb.get("name", ""), "loads": loads})
   proj = _hook_import_sites(proj, bin)
   proj.set("ok", true).set("range", {"addr": tb.get("addr", 0), "size": tb.get("bytes", "").len, "name": tb.get("name", "")})
   .set("load_count", loads.len)
}

fn symbolic_state(any source, any target=0, int max_bytes=4096) dict {
   "Create a symbolic entry state for an ELF range."
   def proj = symbolic_project(source, target, max_bytes)
   if !proj.get("ok", false) { return proj }
   sym.entry_state(proj)
}

fn _harness_state_opts(any opts) dict {
   mut out = dict()
   if !is_dict(opts) { return out }
   if opts.contains("stdin") { out = out.set("stdin", opts.get("stdin", "")) }
   if opts.contains("symbolic_stdin") { out = out.set("symbolic_stdin", opts.get("symbolic_stdin", dict())) }
   if opts.contains("argv") { out = out.set("argv", opts.get("argv", [])) }
   if opts.contains("symbolic_argv") { out = out.set("symbolic_argv", opts.get("symbolic_argv", [])) }
   if opts.contains("argv_base") { out = out.set("argv_base", opts.get("argv_base", 0)) }
   if opts.contains("argv_lo") { out = out.set("argv_lo", opts.get("argv_lo", 0)) }
   if opts.contains("argv_hi") { out = out.set("argv_hi", opts.get("argv_hi", 255)) }
   if opts.contains("env") { out = out.set("env", opts.get("env", dict())) }
   if opts.contains("fs") { out = out.set("fs", opts.get("fs", dict())) }
   if opts.contains("files") { out = out.set("files", opts.get("files", dict())) }
   if opts.contains("auxv") { out = out.set("auxv", opts.get("auxv", dict())) }
   if opts.contains("symbols") { out = out.set("symbols", opts.get("symbols", dict())) }
   if opts.contains("pid") { out = out.set("pid", opts.get("pid", 0)) }
   if opts.contains("tid") { out = out.set("tid", opts.get("tid", 0)) }
   out
}

fn _harness_init_stack(dict st, any opts) dict {
   def regs = sym.state_regs(st)
   def base = int(is_dict(opts) ? opts.get("stack_base", 0x7fff0000) : 0x7fff0000)
   mut out = st
   if !regs.contains("rsp") { out = sym.state_set_reg(out, "rsp", base) }
   if !regs.contains("rbp") { out = sym.state_set_reg(out, "rbp", base) }
   if !regs.contains("esp") { out = sym.state_set_reg(out, "esp", base) }
   if !regs.contains("ebp") { out = sym.state_set_reg(out, "ebp", base) }
   if !regs.contains("sp") { out = sym.state_set_reg(out, "sp", base) }
   out
}

fn _harness_ptr_size(dict st) int {
   def ai = st.get("arch", dict())
   is_dict(ai) && int(ai.get("bits", 64)) == 32 ? 4 : 8
}

fn _harness_le_bytes(int value, int n) list {
   mut out = []
   mut i = 0
   while i < n {
      out = out.append((value >> (i * 8)) & 255)
      i += 1
   }
   out
}

fn _apply_harness_stack_args(dict st, any opts) dict {
   if !is_dict(opts) { return st }
   def base = int(opts.get("stack_base", 0x7fff0000))
   def psz = _harness_ptr_size(st)
   def data_base = int(opts.get("stack_arg_base", 0x70010000))
   def stride = int(opts.get("stack_arg_stride", 0x100))
   mut out = st
   if is_list(opts.get("stack_args", [])) {
      def args = opts.get("stack_args", [])
      mut i = 0
      while i < args.len {
         def slot = base + 8 + i * psz
         def v = args[i]
         if is_dict(v) {
            def ptr = int(v.get("ptr", v.get("addr", data_base + i * stride)))
            out = sym.mem_write_bytes(out, slot, _harness_le_bytes(ptr, psz))
            if v.contains("data") { out = sym.mem_write_bytes(out, ptr, v.get("data", "")) }
         } elif is_int(v) {
            out = sym.mem_write_bytes(out, slot, _harness_le_bytes(int(v), psz))
         }
         i += 1
      }
   }
   if is_list(opts.get("symbolic_stack_args", [])) {
      def args = opts.get("symbolic_stack_args", [])
      mut i = 0
      while i < args.len {
         def v = args[i]
         if is_dict(v) {
            def ptr = int(v.get("ptr", v.get("addr", data_base + i * stride)))
            def slot = int(v.get("slot", base + 8 + i * psz))
            out = sym.mem_write_bytes(out, slot, _harness_le_bytes(ptr, psz))
            out = sym.state_symbolic_mem(out, ptr, int(v.get("n", v.get("len", 0))),
               v.get("name", "stack_arg" + to_str(i)), int(v.get("lo", 0)), int(v.get("hi", 255)))
         }
         i += 1
      }
   }
   out
}

fn _apply_harness_symbolic_regs(dict st, any spec) dict {
   mut out = st
   if is_dict(spec) {
      def keys = spec.keys()
      mut i = 0
      while i < keys.len {
         def reg = to_str(keys[i])
         def v = spec.get(keys[i], nil)
         if is_dict(v) {
            out = sym.state_symbolic_reg(out, reg, v.get("name", ""), int(v.get("bits", 0)))
            if v.contains("lo") || v.contains("hi") {
               out = sym.state_constrain_reg_range(out, reg, int(v.get("lo", 0)), int(v.get("hi", 255)))
            }
         } elif is_str(v) {
            out = sym.state_symbolic_reg(out, reg, to_str(v), 0)
         } elif is_int(v) {
            out = sym.state_symbolic_reg(out, reg, "", int(v))
         } else {
            out = sym.state_symbolic_reg(out, reg)
         }
         i += 1
      }
      return out
   }
   if is_list(spec) {
      mut i = 0
      while i < spec.len {
         def v = spec[i]
         if is_dict(v) {
            def reg = v.get("reg", v.get("name", ""))
            out = sym.state_symbolic_reg(out, reg,
               v.get("symbol", v.get("sym", v.get("name", ""))), int(v.get("bits", 0)))
            if v.contains("lo") || v.contains("hi") {
               out = sym.state_constrain_reg_range(out, reg, int(v.get("lo", 0)), int(v.get("hi", 255)))
            }
         } elif is_str(v) {
            out = sym.state_symbolic_reg(out, to_str(v))
         }
         i += 1
      }
   }
   out
}

fn _apply_harness_assumption(dict st, any spec) dict {
   if !is_dict(spec) { return st }
   def kind = spec.get("kind", spec.contains("reg") ? "reg" : (spec.contains("argv") ? "argv" : (spec.contains("symbolic") ? "symbolic" : "")))
   if kind == "symbolic" || kind == "sym" {
      def name = spec.get("symbolic", spec.get("sym", spec.get("name", "")))
      mut out = st
      if spec.contains("eq") || spec.contains("bytes") || spec.contains("data") || spec.contains("value") {
         out = sym.state_constrain_symbolic_eq(out, name,
            spec.get("eq", spec.get("bytes", spec.get("data", spec.get("value", "")))),
            int(spec.get("offset", -1)))
      }
      if spec.contains("lo") || spec.contains("hi") {
         out = sym.state_constrain_symbolic_range(out, name, int(spec.get("lo", 0)), int(spec.get("hi", 255)),
            int(spec.get("offset", 0)), int(spec.get("n", spec.get("len", 0))))
      }
      return out
   }
   if kind == "reg" {
      def reg = spec.get("reg", spec.get("name", ""))
      mut out = st
      if spec.contains("eq") || spec.contains("value") {
         out = sym.state_constrain_reg_eq(out, reg, spec.get("eq", spec.get("value", 0)))
      }
      if spec.contains("lo") || spec.contains("hi") {
         out = sym.state_constrain_reg_range(out, reg, int(spec.get("lo", 0)), int(spec.get("hi", 255)))
      }
      return out
   }
   if kind == "mem" {
      def addr = spec.get("addr", spec.get("address", 0))
      mut out = st
      if spec.contains("eq") || spec.contains("bytes") || spec.contains("data") || spec.contains("value") {
         out = sym.state_constrain_mem_eq(out, addr, spec.get("eq", spec.get("bytes", spec.get("data", spec.get("value", "")))))
      }
      if spec.contains("lo") || spec.contains("hi") {
         out = sym.state_constrain_mem_range(out, addr, int(spec.get("n", spec.get("len", 1))),
            int(spec.get("lo", 0)), int(spec.get("hi", 255)))
      }
      return out
   }
   if kind == "stdin" {
      mut out = st
      if spec.contains("eq") || spec.contains("bytes") || spec.contains("data") || spec.contains("value") {
         out = sym.state_constrain_stdin_eq(out, spec.get("eq", spec.get("bytes", spec.get("data", spec.get("value", "")))))
      }
      if spec.contains("lo") || spec.contains("hi") {
         out = sym.state_constrain_stdin_range(out, int(spec.get("lo", 0)), int(spec.get("hi", 255)))
      }
      return out
   }
   if kind == "argv" {
      def idx = int(spec.get("index", spec.get("argv", 0)))
      mut out = st
      if spec.contains("eq") || spec.contains("bytes") || spec.contains("data") || spec.contains("value") {
         out = sym.state_constrain_argv_eq(out, idx, spec.get("eq", spec.get("bytes", spec.get("data", spec.get("value", "")))))
      }
      if spec.contains("lo") || spec.contains("hi") {
         out = sym.state_constrain_argv_range(out, idx, int(spec.get("lo", 0)), int(spec.get("hi", 255)))
      }
      return out
   }
   st
}

fn _apply_harness_assumptions(dict st, any spec) dict {
   mut out = st
   if is_list(spec) {
      mut i = 0
      while i < spec.len {
         out = _apply_harness_assumption(out, spec[i])
         i += 1
      }
      return out
   }
   if is_dict(spec) {
      if spec.contains("reg") || spec.contains("kind") || spec.contains("symbolic") || spec.contains("sym") { return _apply_harness_assumption(out, spec) }
      def keys = spec.keys()
      mut i = 0
      while i < keys.len {
         def v = spec.get(keys[i], nil)
         if is_dict(v) {
            out = _apply_harness_assumption(out, v.set("reg", keys[i]).set("kind", "reg"))
         } else {
            out = _apply_harness_assumption(out, {"kind": "reg", "reg": keys[i], "eq": v})
         }
         i += 1
      }
   }
   out
}

fn _harness_pred(any spec) any {
   if !is_dict(spec) { return spec }
   def kind = spec.get("kind", "addr")
   if kind == "addr" { return sym.find(spec.get("target", spec.get("addr", 0))) }
   if kind == "reg" { return sym.find_reg(spec.get("reg", ""), spec.get("value", 0)) }
   if kind == "mem" { return sym.find_mem(spec.get("addr", 0), spec.get("bytes", "")) }
   if kind == "stdout" { return sym.find_stdout(spec.get("text", "")) }
   if kind == "stderr" { return sym.find_stderr(spec.get("text", "")) }
   if kind == "output" { return sym.find_output(spec.get("text", "")) }
   spec
}

fn _harness_watch(any spec) any {
   if !is_dict(spec) { return spec }
   def kind = spec.get("kind", spec.get("pred", "addr"))
   if kind == "addr" { return sym.watch_addr() }
   if kind == "reg" { return sym.watch_reg(spec.get("reg", "")) }
   if kind == "mem" { return sym.watch_mem(spec.get("addr", 0)) }
   if kind == "stdout" { return sym.watch_stdout(spec.get("text", "")) }
   if kind == "stderr" { return sym.watch_stderr(spec.get("text", "")) }
   if kind == "output" { return sym.watch_output(spec.get("text", "")) }
   spec
}

fn symbolic_harness(any source, any target=0, any opts=dict()) dict {
   "Create a decompiler-backed symbolic harness: project, state, simgr, model, and predicates."
   def maxb = int(opts.get("max_bytes", 4096))
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   mut proj = symbolic_project(bin, target, maxb)
   if !proj.get("ok", false) { return proj.set("kind", "symbolic_harness") }
   proj = _apply_harness_project_opts(proj, bin, opts)
   mut st = sym.entry_state(proj, _harness_state_opts(opts))
   if is_dict(opts.get("regs", dict())) {
      def regs = opts.get("regs", dict())
      def keys = regs.keys()
      mut i = 0
      while i < keys.len {
         st = sym.state_set_reg(st, keys[i], regs.get(keys[i], 0))
         i += 1
      }
   }
   st = _harness_init_stack(st, opts)
   st = _apply_harness_stack_args(st, opts)
   if opts.contains("symbolic_regs") {
      st = _apply_harness_symbolic_regs(st, opts.get("symbolic_regs", dict()))
   }
   if is_list(opts.get("mem", [])) {
      def ms = opts.get("mem", [])
      mut i = 0
      while i < ms.len {
         def m = ms[i]
         if is_dict(m) { st = sym.mem_write_bytes(st, int(m.get("addr", 0)), m.get("data", "")) }
         i += 1
      }
   }
   if is_list(opts.get("symbolic_mem", [])) {
      def sms = opts.get("symbolic_mem", [])
      mut i = 0
      while i < sms.len {
         def m = sms[i]
         if is_dict(m) {
            st = sym.state_symbolic_mem(st, int(m.get("addr", 0)), int(m.get("n", m.get("len", 0))),
               m.get("name", ""), int(m.get("lo", 0)), int(m.get("hi", 255)))
         }
         i += 1
      }
   }
   if opts.contains("assume") {
      st = _apply_harness_assumptions(st, opts.get("assume", []))
   }
   if opts.contains("constraints") {
      st = _apply_harness_assumptions(st, opts.get("constraints", []))
   }
   def mgr = sym.simgr(st)
   def find_pred = opts.contains("find") ? _harness_pred(opts.get("find", 0)) : 0
   def avoid_pred = opts.contains("avoid") ? _harness_pred(opts.get("avoid", 0)) : 0
   def watch_pred = opts.contains("watch") ? _harness_watch(opts.get("watch", 0)) : 0
   {"ok": true, "kind": "symbolic_harness", "analysis": bin, "target": target,
      "project": proj, "state": st, "simgr": mgr, "find": find_pred, "avoid": avoid_pred,
      "watch": watch_pred,
      "model": function_model(bin, target, int(opts.get("model_bytes", min(maxb, 1024)))),
      "process": sym.state_process(st)}
}

fn symbolic_explore(any source, any target=0, any opts=dict()) dict {
   "Build a decompiler-backed symbolic harness and run its find/avoid exploration."
   def h = symbolic_harness(source, target, opts)
   if !h.get("ok", false) { return h.set("kind", "symbolic_explore") }
   def steps = int(opts.get("steps", 0))
   mut run_opts = opts.get("run", dict())
   if opts.contains("find_limit") { run_opts = run_opts.set("find_limit", opts.get("find_limit", 1)) }
   if opts.contains("num_find") { run_opts = run_opts.set("num_find", opts.get("num_find", 1)) }
   if opts.contains("limit_found") { run_opts = run_opts.set("limit_found", opts.get("limit_found", 1)) }
   def model = h.get("model", dict())
   def bin = h.get("analysis", dict())
   mut mgr = dict()
   mut slice_info = dict()
   mut rows = model.get("rows", [])
   if opts.contains("slice") {
      slice_info = _slice_for_explore(bin, target, opts.get("slice", dict()), int(opts.get("max_bytes", opts.get("model_bytes", 1024))))
      if slice_info.get("rows", []).len > 0 { rows = slice_info.get("rows", []) }
   }
   def engine = opts.get("engine", opts.get("backend", ""))
   if h.get("watch", 0) {
      if engine == "lifted" {
         mgr = sym.watch_lifted_until(_simgr_at_first_row(h.get("simgr", dict()), rows), rows, h.get("watch", 0), steps, run_opts)
      } else {
         mgr = sym.watch_until(h.get("simgr", dict()), h.get("watch", 0), steps, run_opts)
      }
   } elif engine == "lifted" {
      mgr = sym.run_lifted_until(_simgr_at_first_row(h.get("simgr", dict()), rows), rows, h.get("find", 0), h.get("avoid", 0), steps, run_opts)
   } else {
      mgr = sym.run_until(h.get("simgr", dict()), h.get("find", 0), h.get("avoid", 0), steps, run_opts)
   }
   def sol_opts = opts.get("solution", dict())
   def solutions = sym.simgr_solutions(mgr, "found", sol_opts)
   def solution = sym.simgr_solution(mgr, "found", 0, sol_opts)
   h.set("kind", "symbolic_explore").set("result", mgr).set("summary", sym.simgr_summary(mgr))
   .set("solutions", solutions).set("solution", solution)
   .set("trace", solution.get("trace", [])).set("watch", mgr.get("watch", []))
   .set("slice", slice_info).set("rows", rows)
}

fn _solve_opts(any opts) dict {
   mut out = is_dict(opts) ? opts : dict()
   if !out.contains("engine") && !out.contains("backend") { out = out.set("engine", "lifted") }
   if !out.contains("steps") { out = out.set("steps", 64) }
   out
}

fn _solve_find_addrs(dict opts) list {
   def f = opts.get("find", 0)
   if !is_dict(f) || f.get("kind", "addr") != "addr" { return [] }
   def raw = f.get("addr", f.get("target", 0))
   if is_int(raw) { return int(raw) > 0 ? [int(raw)] : [] }
   if is_list(raw) {
      mut out = []
      mut i = 0
      while i < raw.len {
         if is_int(raw[i]) && int(raw[i]) > 0 { out = _append_unique(out, int(raw[i])) }
         i += 1
      }
      return out
   }
   []
}

fn _row_switch_targets(dict row) list {
   def entries = row.get("jump_table", dict()).get("entries", [])
   mut out = []
   mut i = 0
   while i < entries.len {
      out = _append_unique(out, int(entries[i].get("target", 0)))
      i += 1
   }
   out
}

fn _state_literal_value(str raw0) dict {
   mut raw = str.strip(raw0)
   if str.startswith(raw, "#") { raw = str.strip(slice(raw, 1, raw.len, 1)) }
   if raw.len == 0 { return {"ok": false} }
   def c = load8(raw, 0)
   if (str.startswith(raw, "0x") || str.startswith(raw, "-0x") ||
      str.ascii_is_digit(c) || c == 45 || c == 43){
      return {"ok": true, "value": _parse_int_piece(raw), "expr": raw}
   }
   {"ok": false}
}

fn _state_selector_aliases(str family, str selector0) list {
   def canon = _canonical_value_reg(family, selector0)
   def base = canon.len > 0 ? canon : str.lower(_ny_operand(selector0))
   _slice_symbol_aliases(base)
}

fn _state_substitute_known(str expr0, dict known) str {
   mut expr = str.strip(expr0)
   def ks = known.keys()
   mut i = 0
   while i < ks.len {
      def k = ks[i]
      def v = str.strip(known.get(k, ""))
      if v.len > 0 { expr = _clean_replace_aliases_text(expr, _slice_symbol_aliases(k), _clean_expr_subst_wrap(v)) }
      i += 1
   }
   expr
}

fn _state_row_rhs(dict row) dict {
   def op = row.get("op", "")
   if op != "assign" && op != "arith" { return {"ok": false} }
   if row.get("kind", "") == "zeroing_idiom" { return {"ok": true, "expr": "0"} }
   mut rhs = row.get("src_kind", "") == "imm" ? row.get("src", "") : _effect_rhs(row.get("effect", ""), row.get("src", ""))
   rhs = str.strip(rhs)
   if rhs.len == 0 { return {"ok": false} }
   {"ok": true, "expr": rhs}
}

fn _state_remember_known(dict known0, dict row, str expr) dict {
   mut known = known0
   def defs = _row_defs(row)
   mut i = 0
   while i < defs.len {
      known = known.set(str.lower(defs[i]), expr)
      i += 1
   }
   known
}

fn _state_assignment(dict row, list aliases) dict {
   def op = row.get("op", "")
   if op != "assign" && op != "arith" { return {"ok": false} }
   if !_symbols_intersect(_row_defs(row), aliases) { return {"ok": false} }
   if row.get("kind", "") == "zeroing_idiom" {
      return {"ok": true, "value": 0, "expr": "0", "addr": int(row.get("addr", 0))}
   }
   mut rhs = row.get("src_kind", "") == "imm" ? row.get("src", "") : _effect_rhs(row.get("effect", ""), row.get("src", ""))
   rhs = str.strip(rhs)
   def lit = _state_literal_value(rhs)
   if lit.get("ok", false) {
      return {"ok": true, "value": int(lit.get("value", 0)), "expr": lit.get("expr", rhs),
         "addr": int(row.get("addr", 0))}
   }
   if rhs.len > 0 {
      return {"ok": true, "value": -1, "expr": rhs, "symbolic": true,
         "addr": int(row.get("addr", 0))}
   }
   {"ok": false, "expr": rhs, "addr": int(row.get("addr", 0))}
}

fn _state_dispatcher_window(list rows, int switch_idx) list {
   mut out = []
   mut i = max(0, switch_idx - 12)
   while i <= switch_idx && i < rows.len {
      out = _append_unique(out, int(rows[i].get("addr", 0)))
      i += 1
   }
   out
}

fn _state_target_case(list entries, int target) int {
   mut i = 0
   while i < entries.len {
      if int(entries[i].get("target", 0)) == target { return int(entries[i].get("index", i)) }
      i += 1
   }
   -1
}

fn _state_entry_indices(list rows, list entries) list {
   mut out = []
   mut i = 0
   while i < entries.len {
      def idx = _row_index_for_addr(rows, int(entries[i].get("target", 0)))
      if idx >= 0 { out = _append_unique(out, idx) }
      i += 1
   }
   out
}

fn _state_case_end_index(list rows, list entry_indices, int start_idx) int {
   mut end = rows.len
   mut i = 0
   while i < entry_indices.len {
      def idx = int(entry_indices[i])
      if idx > start_idx && idx < end { end = idx }
      i += 1
   }
   end
}

fn _state_case_strings(list rows, int start_idx, int end_idx, int limit=4) list {
   mut out = []
   mut i = start_idx
   while i < end_idx && i < rows.len && out.len < limit {
      def r = rows[i]
      if r.get("ref_kind", "") == "string" {
         def v = r.get("ref", dict()).get("value", r.get("ref_name", ""))
         if _state_string_useful(v) { out = _append_unique(out, v) }
      }
      i += 1
   }
   out
}

fn _state_string_is_x86_prologue_ascii(str value) bool {
   def v = str.strip(value)
   if v.len < 6 || v.len > 20 { return false }
   mut i = 0
   while i < v.len {
      def c = load8(v, i)
      if c < 65 || c > 90 { return false }
      i += 1
   }
   if str.startswith(v, "AWAV") || str.startswith(v, "AVAU") {
      return str.find(v, "AUAT") >= 0 || str.find(v, "ATUSH") >= 0 ||
      str.find(v, "ATSH") >= 0 || str.find(v, "AUA") >= 0
   }
   false
}

fn _state_string_useful(str value) bool {
   if value.len == 0 { return false }
   if _state_string_is_x86_prologue_ascii(value) { return false }
   mut has_word_shape = false
   mut i = 0
   while i < value.len {
      def c = load8(value, i)
      if (c == 32 || c == 45 || c == 95 || c == 58 || c == 33 || c == 63 || c == 46 ||
         (c >= 97 && c <= 122) || str.ascii_is_digit(c)){ has_word_shape = true }
      i += 1
   }
   if !has_word_shape { return false }
   true
}

fn _state_transition_unique(list xs, dict rec) list {
   def key = to_str(rec.get("from_state", -1)) + ":" + to_str(rec.get("to_state", rec.get("target", 0))) +
   ":" + rec.get("guard", "") + ":" + rec.get("kind", "")
   mut i = 0
   while i < xs.len {
      def x = xs[i]
      def xk = to_str(x.get("from_state", -1)) + ":" + to_str(x.get("to_state", x.get("target", 0))) +
      ":" + x.get("guard", "") + ":" + x.get("kind", "")
      if xk == key { return xs }
      i += 1
   }
   xs = xs.append(rec)
   xs
}

fn _state_case_model(dict bin, list rows, dict swrow, dict entry, list entries, list entry_indices, list dispatcher_addrs) dict {
   def family = swrow.get("family", _rows_family(rows))
   def selector = _switch_selector_name(swrow)
   def aliases = _state_selector_aliases(family, selector)
   def start = _row_index_for_addr(rows, int(entry.get("target", 0)))
   if start < 0 { return dict() }
   def end = _state_case_end_index(rows, entry_indices, start)
   def state = int(entry.get("index", 0))
   mut transitions = []
   mut terminals = []
   mut last_assign = dict()
   mut known = dict()
   mut ai = 0
   while ai < aliases.len {
      known = known.set(str.lower(aliases[ai]), to_str(state))
      ai += 1
   }
   mut i = start
   while i < end && i < rows.len {
      def r = rows[i]
      mut assign = _state_assignment(r, aliases)
      if assign.get("ok", false) {
         assign = assign.set("expr", _state_substitute_known(assign.get("expr", ""), known))
         def lit = _state_literal_value(assign.get("expr", ""))
         if lit.get("ok", false) {
            assign = assign.set("value", int(lit.get("value", 0))).delete("symbolic")
         }
         last_assign = assign
      }
      def rhs = _state_row_rhs(r)
      if rhs.get("ok", false) {
         known = _state_remember_known(known, r, _state_substitute_known(rhs.get("expr", ""), known))
      }
      if r.get("op", "") == "branch" {
         def to = int(r.get("target", 0))
         def cond = r.get("condition", "")
         def guard = cond == "always" ? "" : _branch_condition_expr(rows, i, cond)
         if to > 0 && dispatcher_addrs.contains(to) {
            if last_assign.get("ok", false) {
               transitions = _state_transition_unique(transitions, {"kind": "state_update",
                     "from_state": state, "to_state": int(last_assign.get("value", -1)),
                     "expr": last_assign.get("expr", ""), "guard": guard,
                     "site": int(r.get("addr", 0)), "assign_site": int(last_assign.get("addr", 0))})
            } else {
               transitions = _state_transition_unique(transitions, {"kind": "dispatcher_backedge",
                     "from_state": state, "to_state": state, "guard": guard,
                     "site": int(r.get("addr", 0))})
            }
         } elif to > 0 {
            def target_state = _state_target_case(entries, to)
            if target_state >= 0 {
               transitions = _state_transition_unique(transitions, {"kind": "case_jump",
                     "from_state": state, "to_state": target_state, "guard": guard,
                     "site": int(r.get("addr", 0)), "target": to})
            }
         }
      } elif r.get("op", "") == "return" {
         terminals = terminals.append({"kind": "return", "site": int(r.get("addr", 0))})
      }
      i += 1
   }
   if transitions.len == 0 && terminals.len == 0 && end < rows.len {
      def fall_state = _state_target_case(entries, int(rows[end].get("addr", 0)))
      if fall_state >= 0 {
         transitions = transitions.append({"kind": "fallthrough", "from_state": state,
               "to_state": fall_state, "guard": "", "site": int(rows[end - 1].get("addr", 0))})
      }
   }
   {"state": state, "target": int(entry.get("target", 0)),
      "label": _rename_addr(bin, int(entry.get("target", 0)), entry.get("label", _label_name(int(entry.get("target", 0))))),
      "start_row": start, "end_row": end, "row_count": max(0, end - start),
      "strings": _state_case_strings(rows, start, end),
      "transitions": transitions, "terminals": terminals}
}

fn _state_transition_count(list cases) int {
   mut n = 0
   mut i = 0
   while i < cases.len {
      n += cases[i].get("transitions", []).len
      i += 1
   }
   n
}

fn _state_dispatch_transition_count(list cases) int {
   mut n = 0
   mut i = 0
   while i < cases.len {
      def ts = cases[i].get("transitions", [])
      mut j = 0
      while j < ts.len {
         def k = ts[j].get("kind", "")
         if k == "state_update" || k == "dispatcher_backedge" { n += 1 }
         j += 1
      }
      i += 1
   }
   n
}

fn _state_machines_from_rows(dict bin, list rows) list {
   mut out = []
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" && r.get("kind", "") == "switch" {
         def jt = r.get("jump_table", dict())
         def entries = jt.get("entries", [])
         if entries.len >= 2 {
            def entry_indices = _state_entry_indices(rows, entries)
            def dispatcher_addrs = _state_dispatcher_window(rows, i)
            mut cases = []
            mut ei = 0
            while ei < entries.len {
               def c = _state_case_model(bin, rows, r, entries[ei], entries, entry_indices, dispatcher_addrs)
               if c.len > 0 { cases = cases.append(c) }
               ei += 1
            }
            def dispatch_transitions = _state_dispatch_transition_count(cases)
            if dispatch_transitions > 0 {
               out = out.append({"kind": "state_machine", "selector": _switch_selector_name(r),
                     "switch_addr": int(r.get("addr", 0)), "switch_label": _rename_addr(bin, int(r.get("addr", 0)), _label_name(int(r.get("addr", 0)))),
                     "dispatcher_addrs": dispatcher_addrs, "table": int(jt.get("base", 0)),
                     "family": r.get("family", _rows_family(rows)),
                     "relative": jt.get("relative", false), "case_count": cases.len,
                     "transition_count": _state_transition_count(cases),
                     "dispatcher_transition_count": dispatch_transitions, "cases": cases})
            }
         }
      }
      i += 1
   }
   out
}

fn state_machines(any source, any target=0, int max_bytes=2048) list {
   "Recover switch-dispatcher state machines from lifted rows.
   Each machine records selector, case targets, string clues, and proven
   transitions back to the dispatcher."
   def bin = is_dict(source) && source.contains("header") ? source : load(to_str(source))
   _state_machines_from_rows(bin, lift(bin, target, max_bytes))
}

fn _solve_branch_seed(any source, any target, dict opts) int {
   def find_addrs = _solve_find_addrs(opts)
   if find_addrs.len == 0 { return 0 }
   def rows = lift(source, target, int(opts.get("max_bytes", opts.get("model_bytes", 1024))))
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" {
         if find_addrs.contains(int(r.get("target", 0))) { return int(r.get("addr", 0)) }
         def targets = _row_switch_targets(r)
         mut j = 0
         while j < targets.len {
            if find_addrs.contains(int(targets[j])) { return int(r.get("addr", 0)) }
            j += 1
         }
      }
      i += 1
   }
   0
}

fn symbolic_solve(any source, any target=0, any opts=dict()) dict {
   "One-call reversing solve: lifted exploration, branch slicing, and solved model."
   mut o = _solve_opts(opts)
   if !o.contains("slice") {
      def seed = _solve_branch_seed(source, target, o)
      if seed > 0 { o = o.set("slice", {"kind": "backward", "seed": {"addr": seed}}) }
   }
   def run = symbolic_explore(source, target, o)
   def solution = run.get("solution", dict())
   run.set("kind", "symbolic_solve")
   .set("sat", solution.get("ok", false) && solution.get("sat", false))
   .set("model", solution)
   .set("symbolics", solution.get("symbolics", dict()))
   .set("inputs", solution.get("symbolics", dict()))
   .set("stdin", solution.get("stdin", nil))
   .set("argv", solution.get("argv", []))
   .set("regs", solution.get("regs", dict()))
   .set("stdout", solution.get("stdout", ""))
   .set("stderr", solution.get("stderr", ""))
   .set("output", solution.get("output", ""))
}

fn symbolic_solve_all(any source, any target=0, any opts=dict()) dict {
   "One-call reversing solve that keeps every found model, not only the first.
   Set `model_limit` to enumerate multiple satisfying assignments per found
   path by blocking each full symbolic tuple."
   mut o = _solve_opts(opts)
   if !o.contains("slice") {
      def seed = _solve_branch_seed(source, target, o)
      if seed > 0 { o = o.set("slice", {"kind": "backward", "seed": {"addr": seed}}) }
   }
   def run = symbolic_explore(source, target, o)
   def model_limit = int(o.get("model_limit", o.get("limit", 0)))
   def sols = model_limit > 1 ? sym.simgr_solutions_all(run.get("result", dict()), "found", model_limit, o.get("solution", dict())) : run.get("solutions", [])
   def first = sols.len > 0 ? sols[0] : dict()
   run.set("kind", "symbolic_solve_all")
   .set("sat", sols.len > 0)
   .set("models", sols)
   .set("model", first)
   .set("count", sols.len)
   .set("symbolics", first.get("symbolics", dict()))
   .set("inputs", first.get("symbolics", dict()))
   .set("stdin", first.get("stdin", nil))
   .set("argv", first.get("argv", []))
   .set("regs", first.get("regs", dict()))
   .set("stdout", first.get("stdout", ""))
   .set("stderr", first.get("stderr", ""))
   .set("output", first.get("output", ""))
}

fn _row_index_by_addr(list rows) dict {
   mut out = dict()
   mut i = 0
   while i < rows.len {
      out = out.set(to_str(int(rows[i].get("addr", 0))), {"row": rows[i], "index": i})
      i += 1
   }
   out
}

fn _path_row_pseudo(list rows, int idx, dict row, dict trace) str {
   def op = row.get("op", "")
   if op == "branch" {
      def cond = row.get("condition", "")
      def next = _hex(int(trace.get("next", 0)))
      if cond.len > 0 && cond != "always" {
         def expr = _branch_condition_expr(rows, idx, cond)
         if is_bool(trace.get("branch", nil)) {
            return trace.get("branch", false) ? "if " + expr + "{ goto " + next + " }" :
            "if !(" + expr + "){ goto " + next + " }"
         }
         return "if " + expr + "{ goto " + next + " }"
      }
      return "goto " + next
   }
   if op == "call" {
      def name = row.get("target_name", "")
      return _call_render(name.len > 0 ? name : "sub_" + str.to_hex(int(row.get("target", 0)), 0),
         _call_arg_model(rows, idx), row.get("family", _rows_family(rows)))
   }
   if op == "return" { return "return" }
   row.get("effect", "")
}

fn _path_trace_rows(list rows, list trace) list {
   def idx = _row_index_by_addr(rows)
   mut out = []
   mut i = 0
   while i < trace.len {
      def t = trace[i]
      def addr = int(t.get("addr", 0))
      def item = idx.get(to_str(addr), dict())
      def r = item.get("row", dict())
      def row_i = int(item.get("index", -1))
      mut rec = {"index": i, "addr": addr, "addr_hex": _hex(addr),
         "next": int(t.get("next", 0)), "next_hex": _hex(int(t.get("next", 0))),
         "backend": t.get("backend", ""), "condition": t.get("condition", ""),
         "branch": t.get("branch", nil), "insn": t.get("insn", "")}
      if r.len > 0 {
         rec = rec.set("mnemonic", r.get("mnemonic", "")).set("operands", r.get("operands", ""))
         .set("op", r.get("op", "")).set("effect", r.get("effect", ""))
         .set("pseudocode", _path_row_pseudo(rows, row_i, r, t))
         if r.get("op", "") == "branch" {
            def target = int(r.get("target", 0))
            def fallthrough = int(r.get("addr", 0)) + int(r.get("size", 1))
            rec = rec.set("target", target).set("target_hex", _hex(target))
            .set("fallthrough", fallthrough).set("fallthrough_hex", _hex(fallthrough))
            .set("taken", int(t.get("next", 0)) == target)
         }
         if r.get("op", "") == "call" {
            def args = _call_arg_model(rows, row_i)
            rec = rec.set("call", {"name": r.get("target_name", ""), "target": int(r.get("target", 0)),
                  "target_hex": _hex(int(r.get("target", 0))), "args": args,
                  "text": _call_render(r.get("target_name", "call_target"), args, r.get("family", _rows_family(rows)))})
         }
      }
      out = out.append(rec)
      i += 1
   }
   out
}

fn _path_branch_rows(list trace_rows) list {
   mut out = []
   mut i = 0
   while i < trace_rows.len {
      def r = trace_rows[i]
      if r.get("condition", "").len > 0 || is_bool(r.get("branch", nil)) {
         out = out.append(r)
      }
      i += 1
   }
   out
}

fn _path_patch_hints(dict branch) list {
   def addr = branch.get("addr_hex", "")
   def chosen = branch.get("chosen_hex", "")
   def other = branch.get("other_hex", "")
   if addr.len == 0 { return [] }
   ["force " + addr + " to " + chosen, "force " + addr + " to " + other]
}

fn _path_patch_candidates(dict branch) list {
   def addr = int(branch.get("addr", 0))
   if addr == 0 { return [] }
   def chosen = int(branch.get("chosen", 0))
   def other = int(branch.get("other", 0))
   def target = int(branch.get("target", 0))
   def fall = int(branch.get("fallthrough", 0))
   mut out = []
   if chosen > 0 {
      out = out.append({"kind": "branch_patch", "action": "force_chosen",
            "addr": addr, "addr_hex": _hex(addr), "to": chosen, "to_hex": _hex(chosen),
            "intent": "force solved route", "strategy": chosen == fall ? "nop_or_invert_to_fallthrough" : "make_unconditional_jump"})
   }
   if other > 0 {
      out = out.append({"kind": "branch_patch", "action": "force_alternate",
            "addr": addr, "addr_hex": _hex(addr), "to": other, "to_hex": _hex(other),
            "intent": "force alternate route", "strategy": other == fall ? "nop_or_invert_to_fallthrough" : "make_unconditional_jump"})
   }
   if target > 0 && fall > 0 {
      out = out.append({"kind": "branch_patch", "action": "invert_condition",
            "addr": addr, "addr_hex": _hex(addr), "target": target, "target_hex": _hex(target),
            "fallthrough": fall, "fallthrough_hex": _hex(fall),
            "intent": "swap taken and fallthrough routes", "strategy": "invert_conditional_branch"})
   }
   out
}

fn _path_decision_points(list branches) list {
   mut out = []
   mut i = 0
   while i < branches.len {
      def b = branches[i]
      def target = int(b.get("target", 0))
      def fall = int(b.get("fallthrough", 0))
      def next = int(b.get("next", 0))
      mut chosen = next
      mut other = 0
      if target > 0 && fall > 0 {
         if next == target { other = fall }
         elif next == fall { other = target }
      }
      mut rec = {"index": i, "addr": int(b.get("addr", 0)), "addr_hex": b.get("addr_hex", ""),
         "mnemonic": b.get("mnemonic", ""), "operands": b.get("operands", ""),
         "condition": b.get("condition", ""), "expr": b.get("pseudocode", ""),
         "taken": b.get("taken", b.get("branch", nil)), "chosen": chosen,
         "chosen_hex": _hex(chosen), "other": other, "other_hex": other > 0 ? _hex(other) : "",
         "target": target, "target_hex": b.get("target_hex", ""),
         "fallthrough": fall, "fallthrough_hex": b.get("fallthrough_hex", "")}
      rec = rec.set("patch_hints", _path_patch_hints(rec))
      rec = rec.set("patches", _path_patch_candidates(rec))
      out = out.append(rec)
      i += 1
   }
   out
}

fn _path_patch_plan(list decisions) dict {
   mut all = []
   mut solved = []
   mut alternate = []
   mut invert = []
   mut i = 0
   while i < decisions.len {
      def ps = decisions[i].get("patches", [])
      mut j = 0
      while j < ps.len {
         def p = ps[j].set("decision", i)
         all = all.append(p)
         def action = p.get("action", "")
         if action == "force_chosen" { solved = solved.append(p) }
         elif action == "force_alternate" { alternate = alternate.append(p) }
         elif action == "invert_condition" { invert = invert.append(p) }
         j += 1
      }
      i += 1
   }
   {"kind": "path_patch_plan", "count": all.len, "patches": all,
      "solved_route": solved, "alternate_route": alternate, "invert": invert,
      "recommended": solved}
}

fn _path_condition_text(list pcs) str {
   mut parts = []
   mut i = 0
   while i < pcs.len {
      def p = pcs[i]
      parts = parts.append(is_dict(p) ? p.get("text", p.get("expr", "")) : to_str(p))
      i += 1
   }
   str.join(parts, "\n")
}

fn _path_pseudocode_lines(list trace_rows) list {
   mut out = []
   mut i = 0
   while i < trace_rows.len {
      def r = trace_rows[i]
      def ps = r.get("pseudocode", "")
      if ps.len > 0 { out = out.append(r.get("addr_hex", "") + ": " + ps) }
      i += 1
   }
   out
}

fn _path_explain_text(dict out) str {
   mut lines = []
   lines = lines.append("path " + out.get("path_text", ""))
   def pseudo = out.get("pseudocode", [])
   if pseudo.len > 0 { lines = lines.append("pseudocode path\n" + str.join(pseudo, "\n")) }
   def branches = out.get("branches", [])
   mut i = 0
   while i < branches.len {
      def b = branches[i]
      lines = lines.append("branch " + b.get("addr_hex", "") + " -> " + b.get("next_hex", "") +
         " when " + b.get("condition", "") + " = " + to_str(b.get("branch", "")))
      i += 1
   }
   def decisions = out.get("decisions", [])
   i = 0
   while i < decisions.len {
      def d = decisions[i]
      lines = lines.append("decision " + d.get("addr_hex", "") + " chose " + d.get("chosen_hex", "") +
         (d.get("other_hex", "").len > 0 ? (" other " + d.get("other_hex", "")) : ""))
      i += 1
   }
   def conds = out.get("path_conditions_text", "")
   if conds.len > 0 { lines = lines.append("conditions\n" + conds) }
   def inputs = out.get("inputs", dict())
   if inputs.len > 0 {
      mut parts = []
      def ks = inputs.keys()
      i = 0
      while i < ks.len {
         parts = parts.append(ks[i] + "=" + to_str(inputs.get(ks[i], "")))
         i += 1
      }
      lines = lines.append("inputs " + _join_words(parts))
   }
   str.join(lines, "\n")
}

fn path_explain(any source, any target=0, any opts=dict()) dict {
   "Run symbolic solving and return an angr-style path explanation: concrete
   path, branch decisions, path constraints, lifted row effects, and model.
   This is the UI/CLI-friendly view of `symbolic_solve(...)`."
   def run = symbolic_solve(source, target, opts)
   def sol = run.get("model", run.get("solution", dict()))
   def trace = sol.get("trace", run.get("trace", []))
   def rows = run.get("rows", [])
   def trace_rows = _path_trace_rows(rows, trace)
   def found = run.get("result", dict()).get("found", [])
   def path = sol.contains("path") ? sol.get("path", []) : (found.len > 0 ? sym.state_path(found[0], 0) : [])
   def pseudo = _path_pseudocode_lines(trace_rows)
   def branches = _path_branch_rows(trace_rows)
   def decisions = _path_decision_points(branches)
   def patch_plan = _path_patch_plan(decisions)
   mut out = {"ok": run.get("sat", false), "sat": run.get("sat", false),
      "kind": "path_explain", "target": target, "path": path,
      "path_text": sol.get("path_text", ""),
      "trace": trace_rows, "branches": branches, "decisions": decisions,
      "patch_plan": patch_plan,
      "pseudocode": pseudo, "pseudocode_text": str.join(pseudo, "\n"),
      "path_conditions": sol.get("path_conditions", []),
      "path_conditions_text": _path_condition_text(sol.get("path_conditions", [])),
      "constraint_notes": sol.get("constraint_notes", []),
      "constraints": sol.get("constraints", 0), "model": sol,
      "inputs": sol.get("symbolics", dict()), "stdin": sol.get("stdin", nil),
      "argv": sol.get("argv", []), "regs": sol.get("regs", dict()),
      "run": run}
   if out.get("path_text", "").len == 0 && path.len > 0 {
      mut ptext = ""
      mut i = 0
      while i < path.len {
         if i > 0 { ptext += " -> " }
         ptext += _hex(int(path[i]))
         i += 1
      }
      out = out.set("path_text", ptext)
   }
   out.set("text", _path_explain_text(out))
}

fn emulate(any source, any target=0, any regs=dict(), int count=0, int max_bytes=4096) dict {
   "Concrete-emulate an ELF range with Unicorn when available."
   def tb = _target_bytes(source, target, max_bytes)
   if !tb.get("ok", false) { return {"ok": false, "reason": "target_bytes_unavailable"} }
   def bin = tb.get("analysis", dict())
   def ap = arch_profile(bin)
   sym.unicorn_run(tb.get("bytes", ""), regs, {"arch": ap.get("arch", arch(bin)),
         "mode": ap.get("bits", 64) == 64 ? "64" : (ap.get("family", "") == "arm" ? "arm" : "32"),
         "base": int(tb.get("addr", 0)), "count": count})
}

fn _loop_header_map(list rows) dict {
   mut out = dict()
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" {
         def to = int(r.get("target", 0))
         def from = int(r.get("addr", 0))
         if to > 0 && to <= from && !_backedge_region_has_return(rows, to, i) { out = out.set(to_str(to), from) }
      }
      i += 1
   }
   out
}

fn _loop_latch_map(list rows) dict {
   mut out = dict()
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" {
         def to = int(r.get("target", 0))
         def from = int(r.get("addr", 0))
         if to > 0 && to <= from && !_backedge_region_has_return(rows, to, i) { out = out.set(to_str(from), to) }
      }
      i += 1
   }
   out
}

fn _cfg_loop_maps(list rows, dict loop_info) dict {
   def loops = loop_info.get("loops", [])
   if loops.len == 0 { return {"headers": _loop_header_map(rows), "latches": _loop_latch_map(rows), "source": "row_scan"} }
   mut headers = dict()
   mut latches = dict()
   mut i = 0
   while i < loops.len {
      def lp = loops[i]
      def header = int(lp.get("header", 0))
      def latch = int(lp.get("latch", 0))
      mut branch_addr = 0
      mut latch_idx = -1
      mut found_branch_latch = false
      mut ri = 0
      while ri < rows.len {
         def r = rows[ri]
         if (r.get("op", "") == "branch" && int(r.get("target", 0)) == header &&
            int(r.get("addr", 0)) >= latch){
            branch_addr = int(r.get("addr", 0))
            latch_idx = ri
            found_branch_latch = true
         }
         ri += 1
      }
      if branch_addr == 0 {
         latch_idx = _row_index_for_addr(rows, latch)
         branch_addr = latch
      }
      if (found_branch_latch && header > 0 && branch_addr > 0 && _row_index_for_addr(rows, header) >= 0 && latch_idx >= 0 &&
         !_backedge_region_has_return(rows, header, latch_idx)){
         headers = headers.set(to_str(header), latch)
         latches = latches.set(to_str(branch_addr), header)
      }
      i += 1
   }
   if headers.len == 0 { return {"headers": _loop_header_map(rows), "latches": _loop_latch_map(rows), "source": "row_scan"} }
   {"headers": headers, "latches": latches, "source": "cfg_loops"}
}

fn _drop_last(list xs) list {
   mut out = []
   mut i = 0
   while i + 1 < xs.len {
      out = out.append(xs[i])
      i += 1
   }
   out
}

fn _loop_render_pad(str pad, int depth) str {
   pad + str.repeat(" ", max(0, depth) * 2)
}

fn _backedge_region_has_return(list rows, int target_addr, int branch_idx) bool {
   def target_idx = _row_index_for_addr(rows, target_addr)
   if target_idx < 0 || branch_idx <= target_idx { return false }
   mut i = target_idx
   while i < branch_idx && i < rows.len {
      if rows[i].get("op", "") == "return" { return true }
      i += 1
   }
   false
}

fn _row_index_for_addr(list rows, int addr) int {
   mut i = 0
   while i < rows.len {
      if int(rows[i].get("addr", 0)) == addr { return i }
      i += 1
   }
   -1
}

fn _can_inline_if_body(list rows, int start, int end) bool {
   if start < 0 || end <= start || end > rows.len { return false }
   if end - start < 2 { return false }
   mut i = start
   while i < end {
      def op = rows[i].get("op", "")
      if op == "branch" || op == "return" { return false }
      i += 1
   }
   true
}

fn _can_inline_simple_body(list rows, int start, int end) bool {
   if start < 0 || end < start || end > rows.len { return false }
   mut i = start
   while i < end {
      def op = rows[i].get("op", "")
      if op == "branch" || op == "return" { return false }
      i += 1
   }
   true
}

fn _if_else_shape(list rows, int idx) dict {
   if idx < 0 || idx >= rows.len { return dict() }
   def br = rows[idx]
   if br.get("op", "") != "branch" || br.get("condition", "") == "always" { return dict() }
   def else_addr = int(br.get("target", 0))
   if else_addr <= int(br.get("addr", 0)) { return dict() }
   def else_idx = _row_index_for_addr(rows, else_addr)
   if else_idx <= idx + 1 { return dict() }
   def jump_idx = else_idx - 1
   def jmp = rows[jump_idx]
   if jmp.get("op", "") != "branch" || jmp.get("condition", "") != "always" { return dict() }
   def end_addr = int(jmp.get("target", 0))
   if end_addr <= else_addr { return dict() }
   def end_idx = _row_index_for_addr(rows, end_addr)
   if end_idx <= else_idx { return dict() }
   if !_can_inline_simple_body(rows, idx + 1, jump_idx) { return dict() }
   if !_can_inline_simple_body(rows, else_idx, end_idx) { return dict() }
   {"ok": true, "else_idx": else_idx, "jump_idx": jump_idx, "end_idx": end_idx, "else_addr": else_addr, "end_addr": end_addr}
}

fn _join_words(list xs) str {
   mut out = ""
   mut i = 0
   while i < xs.len {
      if i > 0 { out = out + ", " }
      out = out + to_str(xs[i])
      i += 1
   }
   out
}

fn _du_row_comment(any du0, int idx, str pad) str {
   if !is_dict(du0) || du0.len == 0 { return "" }
   mut def_syms = []
   mut use_syms = []
   def defs = du0.get("defs", [])
   mut i = 0
   while i < defs.len {
      def d = defs[i]
      if int(d.get("index", -1)) == idx { def_syms = _append_unique(def_syms, d.get("symbol", "")) }
      i += 1
   }
   def uses = du0.get("uses", [])
   i = 0
   while i < uses.len {
      def u = uses[i]
      if int(u.get("index", -1)) == idx {
         def sym = u.get("symbol", "")
         def item = u.contains("def_addr") ? (sym + " from " + _hex(int(u.get("def_addr", 0)))) : sym
         use_syms = _append_unique(use_syms, item)
      }
      i += 1
   }
   mut out = ""
   if def_syms.len > 0 { out = out + pad + "; dataflow def " + _join_words(def_syms) + "\n" }
   if use_syms.len > 0 { out = out + pad + "; dataflow use " + _join_words(use_syms) + "\n" }
   out
}

fn _field_expr_for_operand(dict bin, dict sig, str op) str {
   def clean = _clean_operand(op)
   if _operand_kind(clean) != "mem" { return "" }
   def mem = _fact_mem_expr(clean)
   if mem.len == 0 || mem.get("index", "").len > 0 || int(mem.get("scale", 0)) != 0 { return "" }
   def params = sig.get("params", [])
   mut pi = 0
   while pi < params.len {
      def p = params[pi]
      def reg = p.get("reg", "")
      if reg.len > 0 && p.get("shape", "") == "struct_ptr" && _alias_reg_for([reg], mem.get("base", "")) == reg {
         def off = int(mem.get("offset", 0))
         def fs = p.get("fields", [])
         mut fi = 0
         while fi < fs.len {
            def f = fs[fi]
            if int(f.get("offset", 0)) == off {
               return _rename_name(bin, p.get("name", "")) + "." + f.get("name", "")
            }
            fi += 1
         }
      }
      pi += 1
   }
   ""
}

fn _ny_operand_ref_sig_bin(dict bin, dict sig, str op, dict ref) str {
   def f = _field_expr_for_operand(bin, sig, op)
   if f.len > 0 { return f }
   def reg = _canonical_value_reg(_abi_family_from_name(sig.get("abi", "sysv_x86_64")), op)
   if reg.len > 0 {
      def pname = _param_name_for_reg(sig, reg)
      if pname.len > 0 { return pname }
   }
   _clean_param_index_text(sig, _clean_expr_with_sig(sig, [], _ny_operand_ref_bin(bin, op, ref)))
}

fn _row_has_field_operand(dict bin, dict sig, dict row) bool {
   _field_expr_for_operand(bin, sig, row.get("dst", "")).len > 0 ||
   _field_expr_for_operand(bin, sig, row.get("src", "")).len > 0
}

fn _clean_row_uses_loop_carried_param(dict sig, list rows, int idx, dict row) bool {
   def loop_syms = _clean_enclosing_loop_symbols(rows, idx)
   if loop_syms.len == 0 { return false }
   def uses = _append_all_unique(_append_all_unique(_row_uses(row),
         _symbols_from_text(row.get("dst", ""))), _symbols_from_text(row.get("src", "")))
   def params = sig.get("params", [])
   mut i = 0
   while i < params.len {
      def reg = params[i].get("reg", "")
      if (reg.len > 0 && _symbols_intersect(_slice_symbol_aliases(reg), loop_syms) &&
         _symbols_intersect(_slice_symbol_aliases(reg), uses)){
         return true
      }
      i += 1
   }
   false
}

fn _row_effect_with_sig(dict bin, dict sig, list lifted, int i, dict row) str {
   def op = row.get("op", "")
   def setup = _syscall_setup_effect(lifted, i, row)
   if setup.len > 0 { return setup }
   if _clean_row_uses_loop_carried_param(sig, lifted, i, row) { return row.get("effect", "") }
   if !_row_has_field_operand(bin, sig, row) { return row.get("effect", "") }
   def ref = row.get("ref", dict())
   if op == "compare" {
      return "last_cmp = [" + _ny_operand_ref_sig_bin(bin, sig, row.get("dst", ""), ref) + ", " + _ny_operand_ref_sig_bin(bin, sig, row.get("src", ""), ref) + "]"
   }
   if op == "assign" {
      def kind = row.get("kind", "")
      if kind == "byte_load" {
         def rhs = _ny_operand_ref_sig_bin(bin, sig, row.get("src", ""), ref)
         return _ny_operand_ref_sig_bin(bin, sig, row.get("dst", ""), ref) + " = " + (str.startswith(row.get("mnemonic", ""), "movsx") ? _sext_expr(row.get("src", ""), rhs) : _zext_expr(row.get("src", ""), rhs))
      }
      if kind == "lea" || kind == "cmovcc" || kind == "setcc" || kind == "swap" { return row.get("effect", "") }
      return _ny_operand_ref_sig_bin(bin, sig, row.get("dst", ""), ref) + " = " + _ny_operand_ref_sig_bin(bin, sig, row.get("src", ""), ref)
   }
   if op == "arith" {
      def sym = row.get("operator", "")
      if row.get("kind", "") == "sign_extend_acc" || row.get("kind", "") == "sign_extend_dividend" {
         return row.get("effect", "")
      }
      if sym.len > 0 && sym != "neg" && sym != "~" && row.get("src", "").len > 0 {
         def dst = _ny_operand_ref_sig_bin(bin, sig, row.get("dst", ""), ref)
         return dst + " = " + dst + " " + _ny_infix_operator(sym) + " " + _ny_operand_ref_sig_bin(bin, sig, row.get("src", ""), ref)
      }
   }
   row.get("effect", "")
}

fn _clean_enabled(any opts) bool {
   if !is_dict(opts) { return false }
   if opts.get("clean", false) { return true }
   def style = to_str(opts.get("style", ""))
   style == "clean" || style == "compact" || style == "ny"
}

fn _row_def_intersects_symbols(dict row, list target) bool {
   if target.len == 0 { return false }
   _symbols_intersect(_row_defs(row), target)
}

fn _row_def_intersects_operand(dict row, str op) bool {
   _row_def_intersects_symbols(row, _slice_operand_symbols(op))
}

fn _clean_flag_preserving_between_compare_and_branch(dict row) bool {
   def op = row.get("op", "")
   if op == "assign" { return true }
   if op == "stack" {
      def m = row.get("mnemonic", "")
      return m == "push" || m == "pop" || m == "leave"
   }
   false
}

fn _clean_compare_feeds_later_branch(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len || rows[idx].get("op", "") != "compare" { return false }
   mut j = idx + 1
   while j < rows.len && j - idx <= 8 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "branch" {
         return r.get("condition", "") != "always"
      }
      if !_clean_flag_preserving_between_compare_and_branch(r) { return false }
      j += 1
   }
   false
}

fn _clean_compare_context_matches(dict cmp, dict consumer) bool {
   def lhs = str.lower(str.strip(consumer.get("cmp_lhs", "")))
   if lhs.len == 0 { return false }
   def rhs = str.lower(str.strip(consumer.get("cmp_rhs", "")))
   def cdst = str.lower(str.strip(cmp.get("dst", "")))
   def csrc = str.lower(str.strip(cmp.get("src", "")))
   lhs == cdst && rhs == csrc
}

fn _clean_compare_feeds_later_condition_value(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len || rows[idx].get("op", "") != "compare" { return false }
   def cmp = rows[idx]
   mut j = idx + 1
   while j < rows.len && j - idx <= 8 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "branch" {
         return r.get("condition", "") != "always"
      }
      if (op == "assign" && (r.get("kind", "") == "setcc" || r.get("kind", "") == "cmovcc") &&
         _clean_compare_context_matches(cmp, r)){
         return true
      }
      if !_clean_flag_preserving_between_compare_and_branch(r) { return false }
      j += 1
   }
   false
}

fn _clean_defs_used_before_redef(list rows, list defs, int start, int end) bool {
   if defs.len == 0 || start < 0 || end < start { return false }
   mut i = start
   while i <= end && i < rows.len {
      if _symbols_intersect(_row_uses(rows[i]), defs) { return true }
      if _symbols_intersect(_row_defs(rows[i]), defs) { return false }
      i += 1
   }
   false
}

fn _clean_byte_load_feeds_branch_compare(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("kind", "") != "byte_load" || row.get("dst_kind", "") != "reg" { return false }
   def defs = _row_defs(row)
   mut j = idx + 1
   while j < rows.len && j - idx <= 6 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "compare" && _symbols_intersect(_row_uses(r), defs) {
         if !_clean_compare_feeds_later_branch(rows, j) { return false }
         mut k = j + 1
         while k < rows.len && k - j <= 8 {
            def br = rows[k]
            if br.get("op", "") == "branch" && br.get("condition", "") != "always" {
               def to = int(br.get("target", 0))
               if to > 0 && to <= int(row.get("addr", 0)) {
                  def start = _row_index_for_addr(rows, to)
                  if _clean_defs_used_before_redef(rows, defs, start, idx - 1) { return false }
               }
               return true
            }
            if !_clean_flag_preserving_between_compare_and_branch(br) { return false }
            k += 1
         }
         return true
      }
      if op == "call" || op == "syscall" || op == "branch" || op == "return" { return false }
      if _symbols_intersect(_row_uses(r), defs) { return false }
      if _symbols_intersect(_row_defs(r), defs) { return false }
      j += 1
   }
   false
}

fn _clean_byte_load_feeds_next_arith(list rows, int idx) bool {
   if idx < 0 || idx + 1 >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("kind", "") != "byte_load" || row.get("dst_kind", "") != "reg" { return false }
   if !str.startswith(row.get("mnemonic", ""), "movsx") { return false }
   def defs = _row_defs(row)
   if defs.len == 0 { return false }
   def next = rows[idx + 1]
   def use_op = next.get("op", "")
   def use_m = next.get("mnemonic", "")
   if use_op != "arith" { return false }
   if !(use_m == "add" || use_m == "sub" || use_m == "xor" || use_m == "or" || use_m == "and") { return false }
   if !_symbols_intersect(_row_uses(next), defs) { return false }
   if _symbols_intersect(_row_defs(next), defs) { return false }
   mut j = idx + 2
   while j < rows.len && j - idx <= 8 {
      def r = rows[j]
      def op = r.get("op", "")
      if _symbols_intersect(_row_uses(r), defs) { return false }
      if _symbols_intersect(_row_defs(r), defs) { return true }
      if op == "call" || op == "syscall" || op == "return" { return true }
      j += 1
   }
   true
}

fn _clean_byte_load_feeds_loop_accumulator(list rows, int idx) bool {
   if idx < 0 || idx + 1 >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("kind", "") != "byte_load" || row.get("dst_kind", "") != "reg" { return false }
   def defs = _row_defs(row)
   if defs.len == 0 { return false }
   def next = rows[idx + 1]
   if next.get("op", "") != "arith" { return false }
   if !_symbols_intersect(_row_uses(next), defs) { return false }
   def acc_defs = _row_defs(next)
   if acc_defs.len == 0 { return false }
   _symbols_intersect(_row_uses(next), acc_defs)
}

fn _clean_loop_regions(list rows) list {
   mut out = []
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" {
         def to = int(r.get("target", 0))
         def from = int(r.get("addr", 0))
         if to > 0 && to <= from && !_backedge_region_has_return(rows, to, i) {
            def start = _row_index_for_addr(rows, to)
            if start >= 0 {
               out = out.append({"header_idx": start, "latch_idx": i,
                     "header": to, "latch": from})
            }
         }
      }
      i += 1
   }
   out
}

fn _clean_row_in_loop_regions(list regions, int idx) bool {
   mut i = 0
   while i < regions.len {
      if idx >= int(regions[i].get("header_idx", -1)) && idx <= int(regions[i].get("latch_idx", -1)) {
         return true
      }
      i += 1
   }
   false
}

fn _clean_defs_used_in_region(list rows, list defs, int start, int end) bool {
   if defs.len == 0 { return false }
   mut i = start
   while i <= end && i < rows.len {
      if _symbols_intersect(_row_uses(rows[i]), defs) { return true }
      i += 1
   }
   false
}

fn _clean_loop_preserve_row(list rows, list regions, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   def op = row.get("op", "")
   if !(op == "assign" || op == "arith") { return false }
   if _clean_row_in_loop_regions(regions, idx) { return true }
   def defs = _row_defs(row)
   mut i = 0
   while i < regions.len {
      def start = int(regions[i].get("header_idx", -1))
      def end = int(regions[i].get("latch_idx", -1))
      if idx < start && _clean_defs_used_in_region(rows, defs, start, end) { return true }
      i += 1
   }
   false
}

fn _clean_data_base_assign_feeds_tables(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("ref_kind", "") != "data" || int(row.get("ref_target", 0)) <= 0 { return false }
   if row.get("dst_kind", "") != "reg" { return false }
   def defs = _slice_operand_symbols(row.get("dst", ""))
   if defs.len == 0 { return false }
   mut seen_table_use = false
   mut j = idx + 1
   while j < rows.len {
      def r = rows[j]
      if _symbols_intersect(_row_defs(r), defs) { break }
      def uses = _symbols_intersect(_row_uses(r), defs)
      if uses {
         def mem_dst = _operand_kind(r.get("dst", "")) == "mem" && _symbols_intersect(_slice_operand_symbols(r.get("dst", "")), defs)
         def mem_src = _operand_kind(r.get("src", "")) == "mem" && _symbols_intersect(_slice_operand_symbols(r.get("src", "")), defs)
         if mem_dst || mem_src {
            seen_table_use = true
         } else {
            return false
         }
      }
      j += 1
   }
   seen_table_use
}

fn _clean_frame_pointer_setup_row(dict row) bool {
   if row.get("op", "") != "assign" { return false }
   def family = row.get("family", "x86")
   _canonical_value_reg(family, row.get("dst", "")) == "rbp" &&
   _canonical_value_reg(family, row.get("src", "")) == "rsp"
}

fn _clean_stack_pointer_adjust_row(dict row) bool {
   if row.get("op", "") != "arith" { return false }
   def m = row.get("mnemonic", "")
   if m != "sub" && m != "add" { return false }
   def family = row.get("family", "x86")
   _canonical_value_reg(family, row.get("dst", "")) == "rsp"
}

fn _clean_stack_pointer_assign_row(dict row) bool {
   if row.get("op", "") != "assign" { return false }
   def family = row.get("family", "x86")
   if _canonical_value_reg(family, row.get("dst", "")) != "rsp" { return false }
   def rhs = str.strip(_effect_rhs(row.get("effect", ""), _ny_operand(row.get("src", ""))))
   str.startswith(rhs, "&local_") || str.startswith(rhs, "&stack_") ||
   str.startswith(rhs, "local_") || str.startswith(rhs, "stack_")
}

fn _clean_callee_saved_stack_artifact_row(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" { return false }
   def family = row.get("family", _rows_family(rows))
   if row.get("dst_kind", "") == "mem" {
      def lhs = _effect_lhs(row.get("effect", ""), _ny_operand(row.get("dst", "")))
      def src = _canonical_value_reg(family, row.get("src", ""))
      return (str.startswith(lhs, "stack_") || str.startswith(lhs, "local_")) &&
      src.len > 0 && _callee_saved_value_reg(family, src)
   }
   if row.get("dst_kind", "") == "reg" {
      def dst = _canonical_value_reg(family, row.get("dst", ""))
      def rhs = str.strip(_effect_rhs(row.get("effect", ""), _ny_operand(row.get("src", ""))))
      return dst.len > 0 && _callee_saved_value_reg(family, dst) &&
      (str.startswith(rhs, "stack_") || str.startswith(rhs, "local_"))
   }
   false
}

fn _clean_skip_map(list rows, dict facts0) dict {
   mut out = dict()
   def loop_regions = _clean_loop_regions(rows)
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      def m = r.get("mnemonic", "")
      def op = r.get("op", "")
      def loop_keep = _clean_loop_preserve_row(rows, loop_regions, i)
      def in_loop = _clean_row_in_loop_regions(loop_regions, i)
      if op == "branch" && r.get("kind", "") == "switch" {
         def consumed = r.get("jump_table", dict()).get("consumes", [])
         mut ci = 0
         while ci < consumed.len {
            def ri = int(consumed[ci])
            if ri >= 0 && ri < rows.len { out = out.set(to_str(ri), true) }
            ci += 1
         }
      }
      if op == "compare" && _clean_compare_feeds_later_condition_value(rows, i) {
         out = out.set(to_str(i), true)
      }
      if _clean_table_mismatch_start(rows, i) {
         mut sj = i + 1
         while sj <= i + 6 {
            out = out.set(to_str(sj), true)
            sj += 1
         }
      }
      if op == "stack" && (m == "push" || m == "leave" || m == "pop") {
         out = out.set(to_str(i), true)
      }
      if op == "call" && _clean_pic_thunk_call_row(rows, i) {
         out = out.set(to_str(i), true)
      }
      if _clean_pic_base_setup_row(rows, i) {
         out = out.set(to_str(i), true)
      }
      if _clean_frame_pointer_setup_row(r) {
         out = out.set(to_str(i), true)
      }
      if (op == "assign" && r.get("dst_kind", "") == "reg" && r.get("ref_kind", "") == "data" &&
         int(r.get("ref_target", 0)) > 0 && !_clean_data_base_reg_mutated_after(rows, i)){
         out = out.set(to_str(i), true)
      }
      if op == "assign" && _clean_data_base_assign_feeds_tables(rows, i) {
         out = out.set(to_str(i), true)
      }
      if _clean_stack_pointer_adjust_row(r) {
         out = out.set(to_str(i), true)
      }
      if _clean_stack_pointer_assign_row(r) {
         out = out.set(to_str(i), true)
      }
      if op == "call" && _clean_call_result_test_after(rows, i) {
         out = out.set(to_str(i), true)
      }
      if ((!loop_keep || in_loop) && op == "assign" &&
         (_clean_byte_load_feeds_branch_compare(rows, i) ||
            (_clean_byte_load_feeds_next_arith(rows, i) && !_clean_byte_load_feeds_loop_accumulator(rows, i)))){
         out = out.set(to_str(i), true)
      }
      if !loop_keep && op == "assign" && r.get("kind", "") == "setcc" && _clean_setcc_feeds_branch(rows, i) {
         out = out.set(to_str(i), true)
      }
      if op == "assign" && r.get("kind", "") == "setcc" && _clean_setcc_feeds_bool_linear(rows, i) {
         out = out.set(to_str(i), true)
      }
      if !loop_keep && op == "assign" && r.get("kind", "") == "cmovcc" && _clean_cmov_feeds_branch(rows, i) {
         out = out.set(to_str(i), true)
      }
      if (op == "assign" || op == "arith") && _clean_row_feeds_cmov_expr(rows, i) {
         out = out.set(to_str(i), true)
      }
      if !loop_keep && op == "arith" && r.get("kind", "") == "sign_extend_dividend" && _clean_sign_extend_feeds_abs(rows, i) {
         out = out.set(to_str(i), true)
      }
      if !loop_keep && (op == "assign" || op == "arith") && _clean_row_feeds_call_arg(rows, i) {
         out = out.set(to_str(i), true)
      }
      if op == "assign" && _clean_row_feeds_stack_call_arg(rows, i) {
         out = out.set(to_str(i), true)
      }
      if !loop_keep && (op == "assign" || op == "arith") && _clean_row_feeds_return_expr(rows, i) {
         out = out.set(to_str(i), true)
      }
      if !loop_keep && (op == "assign" || op == "arith") && _clean_row_feeds_return_goto(rows, i) {
         out = out.set(to_str(i), true)
      }
      if !loop_keep && (op == "assign" || op == "arith") && _clean_row_saves_recent_call_result(rows, i) {
         out = out.set(to_str(i), true)
      }
      if op == "assign" && (_clean_callee_saved_spill_row(rows, i) || _clean_callee_saved_restore_row(rows, i)) {
         out = out.set(to_str(i), true)
      }
      if op == "assign" && _clean_callee_saved_stack_artifact_row(rows, i) {
         out = out.set(to_str(i), true)
      }
      if (op == "assign" || op == "arith") && _clean_row_feeds_store_inline(rows, i) {
         out = out.set(to_str(i), true)
      }
      i += 1
   }
   def rw = facts0.get("rewrite_candidates", dict())
   def dead = rw.get("dead_defs", [])
   i = 0
   while i < dead.len {
      def ri = int(dead[i].get("row", -1))
      if ri >= 0 && ri < rows.len && !_clean_loop_preserve_row(rows, loop_regions, ri) && _row_pure_rewrite_candidate(rows[ri]) {
         out = out.set(to_str(ri), true)
      }
      i += 1
   }
   def inline = rw.get("inline_values", [])
   i = 0
   while i < inline.len {
      def ri = int(inline[i].get("row", -1))
      if ri >= 0 && ri < rows.len && !_clean_loop_preserve_row(rows, loop_regions, ri) && _row_pure_rewrite_candidate(rows[ri]) {
         out = out.set(to_str(ri), true)
      }
      i += 1
   }
   mut changed = true
   while changed {
      changed = false
      i = 0
      while i < rows.len {
         if (!out.get(to_str(i), false) && !_clean_loop_preserve_row(rows, loop_regions, i) &&
            _clean_row_feeds_skipped_setup(rows, i, out)){
            out = out.set(to_str(i), true)
            changed = true
         }
         i += 1
      }
   }
   out
}

fn _clean_skip_row(dict skip, int idx) bool {
   skip.get(to_str(idx), false)
}

fn _clean_row_feeds_skipped_setup(list rows, int idx, dict skip) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   def op = row.get("op", "")
   if !(op == "assign" || op == "arith") { return false }
   if row.get("dst_kind", "") != "reg" { return false }
   def defs = _slice_operand_symbols(row.get("dst", ""))
   if defs.len == 0 { return false }
   mut seen = false
   mut j = idx + 1
   while j < rows.len && j - idx <= 8 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" || rop == "syscall" || rop == "branch" || rop == "return" { break }
      if _symbols_intersect(_row_uses(r), defs) {
         if !skip.get(to_str(j), false) { return false }
         seen = true
      }
      if _symbols_intersect(_row_defs(r), defs) { return seen }
      j += 1
   }
   seen
}

fn _clean_row_feeds_call_arg(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   def op = row.get("op", "")
   if !(op == "assign" || op == "arith") { return false }
   if row.get("dst_kind", "") != "reg" { return false }
   def family = row.get("family", _rows_family(rows))
   def regs = _abi_profile(family).get("args", [])
   def arg_reg = _alias_reg_for(regs, row.get("dst", ""))
   if arg_reg.len == 0 { return false }
   def aliases = _slice_symbol_aliases(arg_reg)
   mut j = idx + 1
   while j < rows.len && j - idx <= 10 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" {
         return _arg_exists(_call_arg_model(rows, j), arg_reg)
      }
      if rop == "syscall" || rop == "branch" || rop == "return" { return false }
      if _symbols_intersect(_row_defs(r), aliases) { return false }
      if _symbols_intersect(_row_uses(r), aliases) { return false }
      j += 1
   }
   false
}

fn _clean_row_feeds_stack_call_arg(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("dst_kind", "") != "mem" { return false }
   def slot = _stack_call_arg_index(row.get("dst", ""))
   if slot < 0 { return false }
   mut j = idx + 1
   while j < rows.len && j - idx <= 16 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "call" { return true }
      if op == "branch" || op == "syscall" || op == "return" { return false }
      if op == "assign" && r.get("dst_kind", "") == "mem" && _stack_call_arg_index(r.get("dst", "")) == slot { return false }
      j += 1
   }
   false
}

fn _clean_row_feeds_return_expr(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   def op = row.get("op", "")
   if !(op == "assign" || op == "arith") { return false }
   if row.get("dst_kind", "") != "reg" { return false }
   def family = row.get("family", _rows_family(rows))
   def rets = _abi_profile(family).get("returns", [])
   def ret_reg = _alias_reg_for(rets, row.get("dst", ""))
   if ret_reg.len == 0 { return false }
   def aliases = _slice_symbol_aliases(ret_reg)
   mut j = idx + 1
   while j < rows.len && j - idx <= 8 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "return" { return true }
      if rop == "call" || rop == "syscall" || rop == "branch" { return false }
      if _symbols_intersect(_row_uses(r), aliases) { return false }
      if _symbols_intersect(_row_defs(r), aliases) { return false }
      j += 1
   }
   false
}

fn _clean_epilogue_return_index(list rows, int target_idx) int {
   if target_idx < 0 || target_idx >= rows.len { return -1 }
   mut j = target_idx
   while j < rows.len && j - target_idx <= 8 {
      def r = rows[j]
      def op = r.get("op", "")
      def m = r.get("mnemonic", "")
      if op == "return" { return j }
      if op == "stack" && (m == "pop" || m == "leave") { j += 1 continue }
      if op == "assign" && _ny_operand(r.get("dst", "")) == "rbp" && _ny_operand(r.get("src", "")) == "rsp" { j += 1 continue }
      if op == "arith" && _ny_operand(r.get("dst", "")) == "rsp" && (m == "add" || m == "sub") { j += 1 continue }
      return -1
   }
   -1
}

fn _clean_row_feeds_return_goto(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   def op = row.get("op", "")
   if !(op == "assign" || op == "arith") { return false }
   if row.get("dst_kind", "") != "reg" { return false }
   def family = row.get("family", _rows_family(rows))
   def rets = _abi_profile(family).get("returns", [])
   def ret_reg = _alias_reg_for(rets, row.get("dst", ""))
   if ret_reg.len == 0 { return false }
   def aliases = _slice_symbol_aliases(ret_reg)
   mut j = idx + 1
   while j < rows.len && j - idx <= 6 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "branch" && r.get("condition", "") == "always" {
         return _clean_epilogue_return_index(rows, _row_index_for_addr(rows, int(r.get("target", 0)))) >= 0
      }
      if rop == "return" { return true }
      if rop == "call" || rop == "syscall" { return false }
      if _symbols_intersect(_row_uses(r), aliases) { return false }
      if _symbols_intersect(_row_defs(r), aliases) { return false }
      j += 1
   }
   false
}

fn _clean_call_result_saved_after(list rows, int idx) dict {
   if idx < 0 || idx >= rows.len || rows[idx].get("op", "") != "call" { return dict() }
   def family = rows[idx].get("family", _rows_family(rows))
   def rets = _abi_profile(family).get("returns", [])
   if rets.len == 0 { return dict() }
   mut j = idx + 1
   while j < rows.len && j - idx <= 5 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "call" || op == "branch" || op == "syscall" || op == "return" { break }
      if (op == "assign" || op == "arith") && r.get("dst_kind", "") == "reg" && _alias_reg_for(rets, r.get("src", "")).len > 0 {
         def dst = _ny_operand(r.get("dst", ""))
         if _alias_reg_for(rets, dst).len == 0 {
            return {"ok": true, "row": j, "dst": dst}
         }
      }
      if _alias_reg_for(rets, r.get("dst", "")).len > 0 { break }
      j += 1
   }
   dict()
}

fn _clean_call_result_alias_operand(str op, str kind, list rets) str {
   if op.len == 0 { return "" }
   if kind.len > 0 && kind != "reg" { return "" }
   def n = str.lower(_ny_operand(op))
   _alias_reg_for(rets, n).len > 0 ? n : ""
}

fn _clean_call_result_used_alias(list rets, dict row) str {
   def op = row.get("op", "")
   if op == "arith" {
      def dst = _clean_call_result_alias_operand(row.get("dst", ""), row.get("dst_kind", ""), rets)
      if dst.len > 0 { return dst }
      def src = _clean_call_result_alias_operand(row.get("src", ""), row.get("src_kind", ""), rets)
      if src.len > 0 { return src }
      def src2 = _clean_call_result_alias_operand(row.get("src2", ""), row.get("src2_kind", ""), rets)
      if src2.len > 0 { return src2 }
   } elif op == "assign" {
      def src = _clean_call_result_alias_operand(row.get("src", ""), row.get("src_kind", ""), rets)
      if src.len > 0 { return src }
      def dst = _clean_call_result_alias_operand(row.get("dst", ""), row.get("dst_kind", ""), rets)
      if dst.len > 0 { return dst }
   } elif op == "compare" {
      def dst = _clean_call_result_alias_operand(row.get("dst", ""), row.get("dst_kind", ""), rets)
      if dst.len > 0 { return dst }
      def src = _clean_call_result_alias_operand(row.get("src", ""), row.get("src_kind", ""), rets)
      if src.len > 0 { return src }
   }
   rets.len > 0 ? rets[0] : ""
}

fn _clean_call_result_used_after(list rows, int idx) str {
   if idx < 0 || idx >= rows.len || rows[idx].get("op", "") != "call" { return "" }
   def family = rows[idx].get("family", _rows_family(rows))
   def rets = _abi_profile(family).get("returns", [])
   if rets.len == 0 { return "" }
   def aliases = _slice_symbol_aliases(rets[0])
   mut j = idx + 1
   while j < rows.len && j - idx <= 5 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "call" || op == "syscall" || op == "return" { break }
      if r.get("kind", "") == "zeroing_idiom" && _symbols_intersect(_row_defs(r), aliases) { break }
      if _symbols_intersect(_row_uses(r), aliases) { return _clean_call_result_used_alias(rets, r) }
      if _symbols_intersect(_row_defs(r), aliases) { break }
      if op == "branch" { break }
      j += 1
   }
   ""
}

fn _clean_row_saves_recent_call_result(list rows, int idx) bool {
   if idx <= 0 || idx >= rows.len { return false }
   def row = rows[idx]
   def op = row.get("op", "")
   if !(op == "assign" || op == "arith") { return false }
   if row.get("dst_kind", "") != "reg" { return false }
   mut j = idx - 1
   while j >= 0 && idx - j <= 5 {
      def rop = rows[j].get("op", "")
      if rop == "call" { return int(_clean_call_result_saved_after(rows, j).get("row", -1)) == idx }
      if rop == "branch" || rop == "syscall" || rop == "return" { return false }
      j -= 1
   }
   false
}

fn _clean_param_spill_row_sig(list rows, int idx, dict sig) bool {
   if idx < 0 || idx >= rows.len || sig.get("params", []).len == 0 { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("dst_kind", "") != "mem" || row.get("src_kind", "") != "reg" { return false }
   def slot = _stack_slot_for_ops(row.get("dst", ""))
   if slot.len == 0 { return false }
   def family = _abi_family_from_name(sig.get("abi", "sysv_x86_64"))
   def reg = _canonical_value_reg(family, row.get("src", ""))
   reg.len > 0 && _param_name_for_reg(sig, reg).len > 0 &&
   !_clean_param_reg_redefined_before(rows, idx - 1, reg)
}

fn _clean_stack_literal_setup_row(dict bin, list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("dst_kind", "") != "mem" { return false }
   def slot = _stack_slot_for_ops(row.get("dst", ""))
   if slot.len == 0 { return false }
   def aliases = _clean_stack_literal_aliases(bin, rows)
   if aliases.contains(slot.get("name", "")) { return true }
   def byte_arrays = _clean_stack_byte_array_literals(bin, rows, rows.len)
   if byte_arrays.contains(slot.get("name", "")) { return true }
   if row.get("src_kind", "") == "imm" && _imm_value(row.get("src", "")) == 0 {
      def off = int(slot.get("offset", 0))
      def keys = aliases.keys()
      mut i = 0
      while i < keys.len {
         def a = aliases.get(to_str(keys[i]), dict())
         if off == int(a.get("offset", 0)) + int(a.get("len", 0)) { return true }
         i += 1
      }
      def bkeys = byte_arrays.keys()
      i = 0
      while i < bkeys.len {
         def b = byte_arrays.get(to_str(bkeys[i]), dict())
         if off == int(b.get("offset", 0)) + int(b.get("len", 0)) { return true }
         i += 1
      }
   }
   false
}

fn _clean_row_redefines_without_previous_value(list rows, int idx, list defs) bool {
   if idx < 0 || idx >= rows.len || defs.len == 0 { return false }
   def row = rows[idx]
   if row.get("dst_kind", "") != "reg" || !_symbols_intersect(_row_defs(row), defs) { return false }
   if row.get("src_kind", "") == "imm" { return true }
   if row.get("kind", "") == "zeroing_idiom" { return true }
   str.strip(_effect_rhs(row.get("effect", ""), row.get("src", ""))) == "0"
}

fn _clean_row_feeds_stack_literal_setup(dict bin, list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   def op = row.get("op", "")
   if !(op == "assign" || op == "arith") || row.get("dst_kind", "") != "reg" { return false }
   def defs = _row_defs(row)
   mut seen = false
   mut j = idx + 1
   while j < rows.len && j - idx <= 8 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" || rop == "syscall" || rop == "branch" || rop == "return" { break }
      if seen && _clean_row_redefines_without_previous_value(rows, j, defs) { return true }
      if _symbols_intersect(_row_uses(r), defs) {
         if !_clean_stack_literal_setup_row(bin, rows, j) { return false }
         seen = true
      }
      if _symbols_intersect(_row_defs(r), defs) { return seen }
      j += 1
   }
   seen
}

fn _clean_stack_literal_address_row(dict bin, list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("dst_kind", "") != "reg" { return false }
   def rhs = str.strip(_effect_rhs(row.get("effect", ""), row.get("src", "")))
   if !str.startswith(rhs, "&stack_") { return false }
   def slot = slice(rhs, 1, rhs.len, 1)
   def aliases = _clean_stack_literal_aliases(bin, rows)
   if !aliases.contains(slot) { return false }
   def lit = repr(aliases.get(slot, dict()).get("text", ""))
   def defs = _row_defs(row)
   mut seen = false
   mut j = idx + 1
   while j < rows.len && j - idx <= 32 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" || rop == "syscall" || rop == "branch" || rop == "return" { break }
      if _symbols_intersect(_row_uses(r), defs) {
         if r.get("src_kind", "") != "mem" { return false }
         def expr = _clean_stack_literal_text(bin, rows, _clean_operand_expr_at(bin, rows, j - 1, r.get("src", "")))
         if str.find(expr, lit + "[") < 0 { return false }
         seen = true
      }
      if _symbols_intersect(_row_defs(r), defs) { return seen }
      j += 1
   }
   seen
}

fn _clean_zero_init_alias_target(list rows, int idx) str {
   if idx < 0 || idx >= rows.len { return "" }
   def row = rows[idx]
   def op = row.get("op", "")
   if !(op == "assign" || op == "arith") || row.get("dst_kind", "") != "reg" { return "" }
   if row.get("family", _rows_family(rows)) != "x86" { return "" }
   def rhs = str.strip(_effect_rhs(row.get("effect", ""), row.get("src", "")))
   if !(rhs == "0" || row.get("kind", "") == "zeroing_idiom") { return "" }
   def dst = str.lower(_ny_operand(row.get("dst", "")))
   def canon = _canonical_value_reg("x86", dst)
   if canon.len == 0 || canon == dst || !str.startswith(dst, "e") { return "" }
   def aliases = _slice_symbol_aliases(canon)
   mut j = idx + 1
   while j < rows.len && j - idx <= 24 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" || rop == "syscall" || rop == "return" { break }
      def exact = _symbols_from_text(r.get("effect", "") + " " + r.get("operands", ""))
      if _list_has(exact, canon) { return canon }
      if _symbols_intersect(_row_defs(r), aliases) { break }
      j += 1
   }
   ""
}

fn _clean_table_mismatch_start(list rows, int idx) bool {
   if idx < 0 || idx + 6 >= rows.len { return false }
   def a = rows[idx]
   def b = rows[idx + 1]
   def inc = rows[idx + 2]
   def x1 = rows[idx + 3]
   def x2 = rows[idx + 4]
   def z = rows[idx + 5]
   def acc = rows[idx + 6]
   if a.get("op", "") != "assign" || a.get("kind", "") != "byte_load" || a.get("src_kind", "") != "mem" { return false }
   if b.get("op", "") != "assign" || b.get("kind", "") != "byte_load" || b.get("src_kind", "") != "mem" { return false }
   if inc.get("op", "") != "arith" || inc.get("operator", "") != "+" || inc.get("src_kind", "") != "imm" { return false }
   if x1.get("op", "") != "arith" || x1.get("mnemonic", "") != "xor" || x1.get("src_kind", "") != "mem" { return false }
   if x2.get("op", "") != "arith" || x2.get("mnemonic", "") != "xor" || x2.get("src_kind", "") != "mem" { return false }
   if z.get("op", "") != "assign" || z.get("src_kind", "") != "reg" { return false }
   if acc.get("op", "") != "arith" || acc.get("mnemonic", "") != "or" { return false }
   _symbols_intersect(_row_defs(a), _row_uses(x2)) && _symbols_intersect(_row_defs(b), _row_defs(x1))
}

fn _clean_replace_aliases_text(str expr0, list aliases, str repl) str {
   def expr = str.strip(expr0)
   if expr.len == 0 || aliases.len == 0 { return expr0 }
   mut out = ""
   mut i = 0
   while i < expr.len {
      def ch = load8(expr, i)
      if _symbol_is_name_char(ch) {
         def start = i
         while i < expr.len && _symbol_is_name_char(load8(expr, i)) { i += 1 }
         def tok = slice(expr, start, i, 1)
         out = out + (_list_has(aliases, str.lower(tok)) ? repl : tok)
      } else {
         out = out + chr(ch)
         i += 1
      }
   }
   out
}

fn _clean_table_mismatch_text(dict bin, dict sig, list rows, int idx, str pad) str {
   if !_clean_table_mismatch_start(rows, idx) { return "" }
   def family = rows[idx].get("family", _rows_family(rows))
   def idx_reg = _canonical_value_reg(family, rows[idx + 2].get("dst", ""))
   def idx_name = idx_reg.len > 0 ? idx_reg : _ny_operand_ref_bin(bin, rows[idx + 2].get("dst", ""), rows[idx + 2].get("ref", dict()))
   def idx_keep = idx_reg.len > 0 ? _slice_symbol_aliases(idx_reg) : []
   def perm_expr = _clean_expr_with_sig_bin(bin, sig, rows, _clean_operand_expr_at(bin, rows, idx - 1, rows[idx].get("src", ""), 0, false, idx_keep))
   def expected0 = _clean_expr_with_sig_bin(bin, sig, rows, _clean_operand_expr_at(bin, rows, idx - 1, rows[idx + 1].get("src", ""), 0, false, idx_keep))
   def key_expr = _clean_expr_with_sig_bin(bin, sig, rows, _clean_operand_expr_at(bin, rows, idx + 2, rows[idx + 3].get("src", ""), 0, false, idx_keep))
   def acc_name = _ny_operand_ref_bin(bin, rows[idx + 6].get("dst", ""), rows[idx + 6].get("ref", dict()))
   def perm_reg = _canonical_value_reg(family, rows[idx].get("dst", ""))
   def input_symbols = _slice_operand_symbols(rows[idx + 4].get("src", ""))
   def input_base = _param_name_for_reg(sig, "rdi").len > 0 ? _param_name_for_reg(sig, "rdi") : "arg0"
   def input0 = _clean_expr_with_sig_bin(bin, sig, rows, _clean_operand_expr_at(bin, rows, idx + 3, rows[idx + 4].get("src", ""), 0, false, idx_keep))
   def input_expr = (perm_reg.len > 0 && _symbols_intersect(input_symbols, _slice_symbol_aliases(perm_reg))) ? (input_base + "[perm]") :
   (perm_reg.len > 0 ? _clean_replace_aliases_text(input0, _slice_symbol_aliases(perm_reg), "perm") : input0)
   mut b = str.Builder(192)
   b = str.builder_append(b, pad + "perm = " + perm_expr + "\n")
   b = str.builder_append(b, pad + "expected = " + expected0 + "\n")
   b = str.builder_append(b, pad + idx_name + " = " + idx_name + " + 1\n")
   b = str.builder_append(b, pad + "expected = expected ^^ " + key_expr + "\n")
   b = str.builder_append(b, pad + acc_name + " = " + acc_name + " | (" + input_expr + " ^^ expected)\n")
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_callee_saved_restore_row(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("dst_kind", "") != "reg" { return false }
   def family = row.get("family", _rows_family(rows))
   def dst = _canonical_value_reg(family, _ny_operand(row.get("dst", "")))
   if dst.len == 0 || !_callee_saved_value_reg(family, dst) { return false }
   def rhs = _effect_rhs(row.get("effect", ""), _ny_operand(row.get("src", "")))
   if !str.startswith(rhs, "stack_") { return false }
   mut j = idx + 1
   while j < rows.len && j - idx <= 8 {
      def r = rows[j]
      def op = r.get("op", "")
      def m = r.get("mnemonic", "")
      if op == "return" { return true }
      if op == "branch" && r.get("condition", "") == "always" {
         return _clean_epilogue_return_index(rows, _row_index_for_addr(rows, int(r.get("target", 0)))) >= 0
      }
      if op == "call" || op == "syscall" || (op == "branch" && r.get("condition", "") != "always") { return false }
      if op == "arith" && _ny_operand(r.get("dst", "")) == "rsp" && (m == "add" || m == "sub") { j += 1 continue }
      if op == "assign" && _clean_callee_saved_restore_row(rows, j) { j += 1 continue }
      if (op == "assign" || op == "arith") && _alias_reg_for(_abi_profile(family).get("returns", []), r.get("dst", "")).len > 0 { j += 1 continue }
      return false
   }
   false
}

fn _clean_callee_saved_spill_row(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("dst_kind", "") != "mem" { return false }
   def family = row.get("family", _rows_family(rows))
   def src = _canonical_value_reg(family, _ny_operand(row.get("src", "")))
   if src.len == 0 || !_callee_saved_value_reg(family, src) { return false }
   def lhs = _effect_lhs(row.get("effect", ""), _ny_operand(row.get("dst", "")))
   if !str.startswith(lhs, "stack_") { return false }
   mut j = idx + 1
   while j < rows.len && j - idx <= 128 {
      def r = rows[j]
      if (r.get("op", "") == "assign" && _canonical_value_reg(family, _ny_operand(r.get("dst", ""))) == src &&
         _effect_rhs(r.get("effect", ""), _ny_operand(r.get("src", ""))) == lhs){
         return true
      }
      j += 1
   }
   false
}

fn _clean_branch_return_goto_expr(dict bin, list rows, int branch_idx) str {
   if branch_idx < 0 || branch_idx >= rows.len { return "" }
   def br = rows[branch_idx]
   if br.get("op", "") != "branch" || br.get("condition", "") != "always" { return "" }
   def ret_idx = _clean_epilogue_return_index(rows, _row_index_for_addr(rows, int(br.get("target", 0))))
   if ret_idx < 0 { return "" }
   def fam = _rows_family(rows)
   def rets = _abi_profile(fam).get("returns", [])
   mut i = 0
   while i < rets.len {
      def reg = rets[i]
      def expr = _clean_operand_expr_at(bin, rows, branch_idx - 1, reg)
      def pred = _clean_bool_predicate_expr(expr)
      if pred.len > 0 { return pred }
      if expr.len > 0 && expr != reg { return expr }
      i += 1
   }
   ""
}

fn _clean_unresolved_jump_expr(dict bin, dict sig, list rows, int idx) str {
   if idx < 0 || idx >= rows.len { return "target" }
   def row = rows[idx]
   mut op = row.get("dst", "")
   if op.len == 0 && is_list(row.get("args", [])) && row.get("args", []).len > 0 { op = to_str(row.get("args", [])[0]) }
   if op.len == 0 { return "target" }
   mut expr = _clean_operand_expr_at(bin, rows, idx - 1, op, 0, true)
   expr = _clean_expr_with_sig_bin(bin, sig, rows, expr)
   expr.len > 0 ? expr : _ny_operand(op)
}

fn _clean_indirect_jump_mem_parts(str op0) dict {
   def op = str.strip(op0)
   def lb = str.find(op, "[")
   if lb < 0 { return dict() }
   mut rb = lb + 1
   while rb < op.len && load8(op, rb) != 93 { rb += 1 }
   if rb >= op.len { return dict() }
   def inside = str.str_replace(slice(op, lb + 1, rb, 1), " ", "")
   def plus = str.find(inside, "+")
   if plus < 0 { return dict() }
   def left = slice(inside, 0, plus, 1)
   def right = slice(inside, plus + 1, inside.len, 1)
   def star = str.find(right, "*")
   if star < 0 { return dict() }
   def idx = slice(right, 0, star, 1)
   def scale = slice(right, star + 1, right.len, 1)
   if left.len == 0 || idx.len == 0 || scale.len == 0 { return dict() }
   {"base": left, "index": idx, "scale": _parse_int_piece(scale)}
}

fn _clean_computed_jump_render(dict bin, dict sig, list rows, int idx) str {
   if idx < 0 || idx >= rows.len { return "computed_jump(target)" }
   def row = rows[idx]
   def parts = _clean_indirect_jump_mem_parts(row.get("dst", ""))
   if parts.len > 0 {
      mut base = _clean_operand_expr_at(bin, rows, idx - 1, parts.get("base", ""), 0, true)
      mut selector = _clean_operand_expr_at(bin, rows, idx - 1, parts.get("index", ""), 0, true)
      base = _clean_expr_with_sig_bin(bin, sig, rows, base)
      selector = _clean_expr_with_sig_bin(bin, sig, rows, selector)
      if str.startswith(base, "&") { base = slice(base, 1, base.len, 1) }
      return "computed_dispatch(selector=" + selector + ", table=" + base + ", stride=" + to_str(int(parts.get("scale", 0))) + ")"
   }
   "computed_jump(" + _clean_unresolved_jump_expr(bin, sig, rows, idx) + ")"
}

fn _clean_row_feeds_store_inline(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   def op = row.get("op", "")
   if !(op == "assign" || op == "arith") { return false }
   if row.get("dst_kind", "") != "reg" { return false }
   def defs = _row_defs(row)
   if defs.len == 0 { return false }
   mut j = idx + 1
   while j < rows.len && j - idx <= 6 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" || rop == "syscall" || rop == "branch" || rop == "return" { return false }
      if _symbols_intersect(_row_uses(r), defs) {
         if r.get("dst_kind", "") != "mem" { return false }
         if rop == "arith" { return true }
         return rop == "assign" && _symbols_intersect(_slice_operand_symbols(r.get("src", "")), defs)
      }
      if _symbols_intersect(_row_defs(r), defs) { return false }
      j += 1
   }
   false
}

fn _clean_saved_param_alias_before(list rows, int before_idx, str family, str reg0) str {
   def reg = _canonical_value_reg(family, reg0)
   if reg.len == 0 || !_callee_saved_value_reg(family, reg) { return "" }
   mut alias = ""
   mut i = 0
   while i <= before_idx && i < rows.len {
      def r = rows[i]
      def op = r.get("op", "")
      if (_alias_reg_for([reg], r.get("dst", "")) == reg &&
         ((op == "assign" || op == "arith") && r.get("dst_kind", "") == "reg")){
         def value = _effect_rhs(r.get("effect", ""), _ny_operand(r.get("src", "")))
         def value_reg = _canonical_value_reg(family, value)
         if value_reg.len > 0 && _abi_arg_index(family, value_reg) >= 0 {
            alias = value
         } elif str.find(value, "mem(") >= 0 && _symbols_intersect(_slice_operand_symbols(value), _abi_profile(family).get("args", [])) {
            alias = value
         } elif str.startswith(value, "stack_") || str.startswith(value, "local_") {
            alias = alias
         } else {
            alias = ""
         }
      }
      i += 1
   }
   alias
}

fn _clean_nearest_callee_saved_param_alias(list rows, int before_idx, str family, str reg0) str {
   def reg = _canonical_value_reg(family, reg0)
   if reg.len == 0 || !_callee_saved_value_reg(family, reg) { return "" }
   mut j = before_idx
   while j >= 0 {
      def r = rows[j]
      def op = r.get("op", "")
      if _alias_reg_for([reg], r.get("dst", "")) == reg {
         if (op == "assign" || op == "arith") && r.get("dst_kind", "") == "reg" {
            def value = _effect_rhs(r.get("effect", ""), _ny_operand(r.get("src", "")))
            def value_reg = _canonical_value_reg(family, value)
            if value_reg.len > 0 && _abi_arg_index(family, value_reg) >= 0 { return value }
            if str.find(value, "mem(") >= 0 && _symbols_intersect(_slice_operand_symbols(value), _abi_profile(family).get("args", [])) { return value }
         }
         return ""
      }
      j -= 1
   }
   ""
}

fn _clean_expr_resolve_regs_at(dict bin, list rows, int before_idx, str expr0, int depth=0, list preserve=[]) str {
   def expr = str.strip(expr0)
   if expr.len == 0 || depth > 3 { return expr }
   def family = _rows_family(rows)
   mut out = ""
   mut i = 0
   mut quote = 0
   while i < expr.len {
      def ch = load8(expr, i)
      if quote != 0 {
         out = out + chr(ch)
         if ch == 92 && i + 1 < expr.len {
            i += 1
            out = out + chr(load8(expr, i))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         out = out + chr(ch)
         i += 1
         continue
      }
      if _symbol_is_name_char(ch) {
         def start = i
         while i < expr.len && _symbol_is_name_char(load8(expr, i)) { i += 1 }
         def tok = slice(expr, start, i, 1)
         def reg = _canonical_value_reg(family, tok)
         if reg.len > 0 && !_stack_value_reg(family, reg) {
            if _symbols_intersect(_slice_symbol_aliases(reg), preserve) {
               out = out + tok
               continue
            }
            mut resolved = _resolve_reg_value(rows, before_idx + 1, family, reg, depth + 1, bin)
            if resolved.len == 0 { resolved = _resolve_reg_value_cfg(bin, rows, before_idx + 1, family, reg, depth + 1) }
            def value = resolved.get("value", "")
            mut repl = ""
            if resolved.get("crossed_call", false) {
               def value_reg = _canonical_value_reg(family, value)
               if _callee_saved_value_reg(family, reg) && value.len > 0 { repl = value }
               elif value_reg.len > 0 && _abi_arg_index(family, value_reg) >= 0 { repl = value }
            } else {
               if value.len > 0 && _canonical_value_reg(family, value) != reg { repl = value }
            }
            if repl.len == 0 { repl = _clean_saved_param_alias_before(rows, before_idx, family, reg) }
            out = out + (repl.len > 0 ? repl : tok)
         } else {
            out = out + tok
         }
      } else {
         out = out + chr(ch)
         i += 1
      }
   }
   out
}

fn _clean_expr_resolve_operands_at(dict bin, list rows, int before_idx, str expr0, int depth=0, list preserve=[]) str {
   def expr = str.strip(expr0)
   if expr.len == 0 || depth > 8 { return expr }
   def family = _rows_family(rows)
   mut out = ""
   mut i = 0
   mut quote = 0
   while i < expr.len {
      def ch = load8(expr, i)
      if quote != 0 {
         out = out + chr(ch)
         if ch == 92 && i + 1 < expr.len {
            i += 1
            out = out + chr(load8(expr, i))
         } elif ch == quote {
            quote = 0
         }
         i += 1
         continue
      }
      if ch == 34 || ch == 39 {
         quote = ch
         out = out + chr(ch)
         i += 1
         continue
      }
      if _symbol_is_name_char(ch) {
         def start = i
         while i < expr.len && _symbol_is_name_char(load8(expr, i)) { i += 1 }
         def tok = slice(expr, start, i, 1)
         def reg = _canonical_value_reg(family, tok)
         if (reg.len > 0 && !_stack_value_reg(family, reg) &&
            !_symbols_intersect(_slice_symbol_aliases(reg), preserve)){
            def repl = _clean_operand_expr_at(bin, rows, before_idx, tok, depth + 1, true, preserve)
            if repl.len > 0 && _canonical_value_reg(family, repl) != reg {
               out = out + _clean_expr_subst_wrap(repl)
            } else {
               out = out + tok
            }
         } else {
            out = out + tok
         }
      } else {
         out = out + chr(ch)
         i += 1
      }
   }
   out
}

fn _clean_loop_carried_operand_expr(dict bin, list rows, int branch_idx, int before_idx, str op0) str {
   if branch_idx < 0 || branch_idx >= rows.len { return "" }
   def br = rows[branch_idx]
   def target = int(br.get("target", 0))
   def br_addr = int(br.get("addr", 0))
   if target <= 0 || br_addr <= 0 || target >= br_addr { return "" }
   def op = str.strip(op0)
   def syms = _slice_operand_symbols(op)
   if syms.len == 0 { return "" }
   mut j = before_idx
   while j >= 0 {
      def r = rows[j]
      def addr = int(r.get("addr", 0))
      if addr > 0 && addr < target { break }
      def rop = r.get("op", "")
      if rop == "call" || rop == "branch" || rop == "syscall" || rop == "return" { break }
      if _row_def_intersects_operand(r, op) {
         if rop == "arith" && _symbols_intersect(_slice_operand_symbols(r.get("dst", "")), syms) {
            return _ny_operand_ref_bin(bin, op, dict())
         }
         return ""
      }
      j -= 1
   }
   ""
}

fn _row_defs_with_clean_aliases(any bin0, list rows, int idx) list {
   if idx < 0 || idx >= rows.len { return [] }
   def row = rows[idx]
   mut defs = _row_defs(row)
   if is_dict(bin0) && bin0.get("ok", false) && row.get("dst_kind", "") == "mem" {
      def alias = _clean_address_lvalue_expr(_clean_address_expr_at(bin0, dict(), rows, idx - 1, row.get("dst", ""), 0))
      if alias.len > 0 { defs = _append_unique(defs, str.lower(alias)) }
   }
   defs
}

fn _clean_enclosing_loop_symbols(list rows, int idx, any bin0=dict()) list {
   if idx < 0 || idx >= rows.len { return [] }
   def addr = int(rows[idx].get("addr", 0))
   if addr <= 0 { return [] }
   mut header = 0
   mut latch = -1
   mut best_span = 0
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" {
         def target = int(r.get("target", 0))
         def baddr = int(r.get("addr", 0))
         if target > 0 && target <= addr && addr <= baddr && target < baddr {
            def span = baddr - target
            if latch < 0 || span < best_span {
               header = target
               latch = i
               best_span = span
            }
         }
      }
      i += 1
   }
   if latch < 0 { return [] }
   def start = _row_index_for_addr(rows, header)
   if start < 0 { return [] }
   mut out = []
   i = start
   while i <= latch && i < rows.len {
      out = _append_all_unique(out, _row_defs_with_clean_aliases(bin0, rows, i))
      i += 1
   }
   out
}

fn _clean_loop_has_later_def(list rows, int idx, list syms, any bin0=dict()) bool {
   if idx < 0 || idx >= rows.len || syms.len == 0 { return false }
   def addr = int(rows[idx].get("addr", 0))
   if addr <= 0 { return false }
   mut latch = -1
   mut best_span = 0
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" {
         def target = int(r.get("target", 0))
         def baddr = int(r.get("addr", 0))
         if target > 0 && target <= addr && addr <= baddr && target < baddr {
            def span = baddr - target
            if latch < 0 || span < best_span {
               latch = i
               best_span = span
            }
         }
      }
      i += 1
   }
   if latch < 0 { return false }
   i = idx + 1
   while i <= latch && i < rows.len {
      if _symbols_intersect(_row_defs_with_clean_aliases(bin0, rows, i), syms) { return true }
      i += 1
   }
   false
}

fn _clean_recent_loop_symbols(list rows, int idx, any bin0=dict()) list {
   if idx < 0 { return [] }
   mut j = min(idx, rows.len - 1)
   while j >= 0 && idx - j <= 12 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "branch" {
         def target = int(r.get("target", 0))
         def addr = int(r.get("addr", 0))
         if target > 0 && target < addr {
            def start = _row_index_for_addr(rows, target)
            if start < 0 { return [] }
            mut out = []
            mut i = start
            while i <= j && i < rows.len {
               out = _append_all_unique(out, _row_defs_with_clean_aliases(bin0, rows, i))
               i += 1
            }
            return out
         }
      }
      if op == "call" || op == "syscall" || op == "return" { break }
      j -= 1
   }
   []
}

fn _clean_operand_expr_for_branch(dict bin, list rows, int branch_idx, int before_idx, str op0, int depth=0) str {
   def recent = _clean_recent_loop_symbols(rows, before_idx, bin)
   def preserve = _append_all_unique(_clean_enclosing_loop_symbols(rows, branch_idx, bin), recent)
   def carried = _clean_loop_carried_operand_expr(bin, rows, branch_idx, before_idx, op0)
   if carried.len > 0 { return carried }
   mut byte = _clean_byte_reg_expr_at(bin, rows, before_idx, op0, depth + 1, [])
   def byte_preserved = _clean_byte_reg_expr_at(bin, rows, before_idx, op0, depth + 1, preserve)
   if _clean_branch_byte_expr_lost_preserved_index(byte, byte_preserved, preserve) { byte = byte_preserved }
   if byte.len > 0 && !_clean_render_text_has_alias(byte, op0) { return byte }
   def prev = _clean_prev_def_row(rows, before_idx, op0)
   if prev == before_idx && rows[prev].get("op", "") == "assign" && rows[prev].get("kind", "") == "byte_load" {
      def aliases = _slice_operand_symbols(op0)
      def keep0 = _clean_enclosing_loop_symbols(rows, branch_idx, bin)
      mut keep = []
      mut ki = 0
      while ki < keep0.len {
         if !_symbols_intersect(_slice_symbol_aliases(keep0[ki]), aliases) { keep = keep.append(keep0[ki]) }
         ki += 1
      }
      return _clean_operand_expr_at(bin, rows, before_idx, op0, depth, true, keep)
   }
   if _symbols_intersect(_slice_operand_symbols(op0), recent) {
      return _ny_operand_ref_bin(bin, op0, dict())
   }
   _clean_operand_expr_at(bin, rows, before_idx, op0, depth, true, preserve)
}

fn _clean_expr_mentions_any_alias(str expr, list aliases) bool {
   mut i = 0
   while i < aliases.len {
      if _clean_render_text_has_alias(expr, aliases[i]) { return true }
      i += 1
   }
   false
}

fn _clean_branch_byte_expr_lost_preserved_index(str plain0, str preserved0, list preserve) bool {
   def plain = str.strip(plain0)
   def preserved = str.strip(preserved0)
   if plain.len == 0 || preserved.len == 0 || plain == preserved || preserve.len == 0 { return false }
   if !_clean_expr_mentions_any_alias(preserved, preserve) { return false }
   if _clean_expr_mentions_any_alias(plain, preserve) { return false }
   true
}

fn _clean_magic_signed_div3_expr(dict bin, list rows, int row_idx, str dst, str src, int depth) str {
   if row_idx < 0 || row_idx >= rows.len { return "" }
   def row = rows[row_idx]
   if row.get("op", "") != "arith" || row.get("operator", "") != "-" { return "" }
   def wide_idx = _clean_prev_def_row(rows, row_idx - 1, dst)
   def sign_idx = _clean_prev_def_row(rows, row_idx - 1, src)
   if wide_idx < 0 || sign_idx < 0 || wide_idx >= sign_idx { return "" }
   def wide = rows[wide_idx]
   def sign = rows[sign_idx]
   if wide.get("kind", "") != "wide_mul" || !wide.get("signed", false) || int(wide.get("bits", 0)) != 32 { return "" }
   if sign.get("op", "") != "arith" || sign.get("operator", "") != ">>" { return "" }
   def amount = _clean_literal_int_value(sign.get("src", ""))
   if !amount.get("ok", false) || int(amount.get("value", 0)) != 31 { return "" }
   def magic = _clean_operand_expr_at(bin, rows, wide_idx - 1, wide.get("src2", ""), depth + 1, true)
   def magic_v = _clean_literal_int_value(magic)
   if !magic_v.get("ok", false) || int(magic_v.get("value", 0)) != 0x55555556 { return "" }
   def x_mul = _clean_operand_expr_at(bin, rows, wide_idx - 1, wide.get("src", ""), depth + 1, true)
   def x_sign = _clean_operand_expr_at(bin, rows, sign_idx - 1, sign.get("dst", ""), depth + 1, true)
   if x_mul.len == 0 || !_clean_same_expr_text(x_mul, x_sign) { return "" }
   _clean_paren(x_mul) + " / 3"
}

fn _clean_operand_expr_at(dict bin, list rows, int before_idx, str op0, int depth=0, bool cross_forward_branches=false, list preserve=[]) str {
   def op = str.strip(op0)
   if op.len == 0 { return "" }
   def op_syms = _slice_operand_symbols(op)
   if _symbols_intersect(op_syms, preserve) {
      return _ny_operand_ref_bin(bin, op, dict())
   }
   def kind = _operand_kind(op)
   if kind == "imm" || kind == "none" { return _ny_operand_ref_bin(bin, op, dict()) }
   if kind == "mem" {
      def stored = _clean_recent_store_value_for_load(bin, rows, before_idx, op, depth + 1, cross_forward_branches, preserve)
      if stored.len > 0 { return stored }
      return _clean_expr_resolve_regs_at(bin, rows, before_idx, _ny_operand_ref_bin(bin, op, dict()), depth, preserve)
   }
   if depth > 8 { return _ny_operand_ref_bin(bin, op, dict()) }
   def byte_lane = _clean_byte_reg_lane(op)
   if byte_lane.get("ok", false) && int(byte_lane.get("lane", 0)) > 0 {
      def high = _clean_byte_reg_expr_at(bin, rows, before_idx, op, depth + 1)
      if high.len > 0 { return high }
   }
   mut j = before_idx
   mut guard = 0
   while j >= 0 && guard < 64 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "branch" {
         if !cross_forward_branches { break }
         j -= 1
         guard += 1
         continue
      }
      if rop == "call" {
         def family = r.get("family", _rows_family(rows))
         def canon = _canonical_value_reg(family, op)
         if (canon.len > 0 && (_callee_saved_value_reg(family, canon) ||
               (bin.get("ok", false) && _local_call_preserves_reg(bin, r, family, canon)))){
            j -= 1
            guard += 1
            continue
         }
         break
      }
      if rop == "syscall" || rop == "return" { break }
      if (rop == "assign" || rop == "arith") && r.get("dst_kind", "") == "mem" && kind != "mem" {
         j -= 1
         guard += 1
         continue
      }
      if _row_def_intersects_symbols(r, op_syms) {
         if rop == "assign" {
            if _clean_row_saves_recent_call_result(rows, j) {
               return _ny_operand_ref_bin(bin, r.get("dst", ""), r.get("ref", dict()))
            }
            if r.get("kind", "") == "setcc" {
               return _clean_setcc_expr(bin, rows, j, r, depth)
            }
            if r.get("kind", "") == "cmovcc" {
               return _clean_cmov_expr(bin, rows, j, r, depth)
            }
            if r.get("kind", "") == "lea" {
               def bool_linear = _clean_bool_linear_select_expr(bin, rows, j, r)
               if bool_linear.len > 0 { return bool_linear }
               def addr = r.get("addr_expr", "").len > 0 ? r.get("addr_expr", "") :
               _ny_address_operand_ref_bin(bin, r.get("src", ""), r.get("ref", dict()))
               mut resolved = ""
               if cross_forward_branches {
                  resolved = _clean_expr_resolve_operands_at(bin, rows, j - 1, addr, depth + 1, preserve)
               } else {
                  resolved = _clean_expr_resolve_regs_at(bin, rows, j - 1, addr, depth + 1, preserve)
               }
               def expr = resolved.len > 0 ? resolved : addr
               if (!cross_forward_branches &&
                  _clean_value_symbols_redefined_between(bin, rows, j + 1, before_idx, r.get("family", _rows_family(rows)), expr)){
                  return _ny_operand_ref_bin(bin, op, dict())
               }
               return expr
            }
            if r.get("kind", "") == "byte_load" {
               def rhs = _clean_operand_expr_at(bin, rows, j - 1, r.get("src", ""), depth + 1, cross_forward_branches, preserve)
               def expr = str.startswith(r.get("mnemonic", ""), "movsx") ? _sext_expr(r.get("src", ""), rhs) : _zext_expr(r.get("src", ""), rhs)
               if (!cross_forward_branches &&
                  _clean_value_symbols_redefined_between(bin, rows, j + 1, before_idx, r.get("family", _rows_family(rows)), expr)){
                  return _ny_operand_ref_bin(bin, op, dict())
               }
               return expr
            }
            def expr = _clean_operand_expr_at(bin, rows, j - 1, r.get("src", ""), depth + 1, cross_forward_branches, preserve)
            if (!cross_forward_branches &&
               _clean_value_symbols_redefined_between(bin, rows, j + 1, before_idx, r.get("family", _rows_family(rows)), expr)){
               return _ny_operand_ref_bin(bin, op, dict())
            }
            return expr
         }
         if rop == "arith" {
            def rk = r.get("kind", "")
            def dst = r.get("dst", "")
            def sym = r.get("operator", "")
            if rk == "zeroing_idiom" { return "0" }
            if rk == "imm_load" { return _ny_operand_ref_bin(bin, r.get("src", ""), r.get("ref", dict())) }
            if sym == "-" {
               def magic_div = _clean_magic_signed_div3_expr(bin, rows, j, dst, r.get("src", ""), depth)
               if magic_div.len > 0 { return magic_div }
            }
            if rk == "sign_extend_acc" {
               def prior = _clean_operand_expr_at(bin, rows, j - 1, r.get("src", ""), depth + 1, cross_forward_branches, preserve)
               return "sext(" + prior + ")"
            }
            if rk == "mul3" {
               def left = _clean_operand_expr_at(bin, rows, j - 1, r.get("src", ""), depth + 1, cross_forward_branches, preserve)
               def right = _clean_operand_expr_at(bin, rows, j - 1, r.get("src2", ""), depth + 1, cross_forward_branches, preserve)
               return _clean_binary_expr(left, "*", right)
            }
            if rk == "wide_mul" {
               def left = _clean_operand_expr_at(bin, rows, j - 1, r.get("src", ""), depth + 1, cross_forward_branches, preserve)
               def right = _clean_operand_expr_at(bin, rows, j - 1, r.get("src2", ""), depth + 1, cross_forward_branches, preserve)
               def bits = int(r.get("bits", _clean_operand_bits(r.get("src2", ""))))
               def prefix = r.get("signed", false) ? "smul" : "umul"
               def target = _slice_operand_symbols(op)
               if _symbols_intersect(_slice_symbol_aliases(r.get("dst2", "")), target) {
                  return prefix + "hi" + to_str(bits) + "(" + left + ", " + right + ")"
               }
               return prefix + "lo" + to_str(bits) + "(" + left + ", " + right + ")"
            }
            if rk == "arith3" {
               def left = _clean_operand_expr_at(bin, rows, j - 1, r.get("src", ""), depth + 1, cross_forward_branches, preserve)
               mut right = _clean_operand_expr_at(bin, rows, j - 1, r.get("src2", ""), depth + 1, cross_forward_branches, preserve)
               def modifier = r.get("src2_modifier", "")
               if modifier.len > 0 { right = _arch_shifted_base_expr(bin, right, modifier, r.get("ref", dict())) }
               return _clean_binary_expr(left, sym, right)
            }
            if rk == "rotate" {
               def prior = _clean_operand_expr_at(bin, rows, j - 1, dst, depth + 1, cross_forward_branches, preserve)
               def amt = _clean_operand_expr_at(bin, rows, j - 1, r.get("src", ""), depth + 1, cross_forward_branches, preserve)
               return sym + "(" + prior + ", " + amt + ")"
            }
            if rk == "byte_swap32" || rk == "byte_swap64" {
               def prior = _clean_operand_expr_at(bin, rows, j - 1, dst, depth + 1, cross_forward_branches, preserve)
               return (rk == "byte_swap64" ? "bswap64" : "bswap32") + "(" + prior + ")"
            }
            if rk == "unary" {
               def prior = _clean_operand_expr_at(bin, rows, j - 1, dst, depth + 1, cross_forward_branches, preserve)
               if sym == "neg" { return "-" + _clean_paren(prior) }
               if sym == "~" { return "~" + _clean_paren(prior) }
            }
            if sym == "&" {
               def masked = _clean_mask_byte_expr(bin, rows, j, dst, r.get("src", ""), depth)
               if masked.len > 0 { return masked }
               def field = _clean_bitfield_expr(bin, rows, j, dst, r.get("src", ""), depth)
               if field.len > 0 { return field }
               def modded = _clean_mask_mod_expr(bin, rows, j, dst, r.get("src", ""), depth)
               if modded.len > 0 { return modded }
            }
            if sym == ">>" {
               def shifted = _clean_shift_byte_expr(bin, rows, j, dst, r.get("src", ""), depth)
               if shifted.len > 0 { return shifted }
               def divided = _clean_shift_div_expr(bin, rows, j, dst, r.get("src", ""), depth)
               if divided.len > 0 { return divided }
            }
            if sym == "-" {
               def ab = _clean_abs_expr(bin, rows, j, dst, r.get("src", ""), depth)
               if ab.len > 0 { return ab }
            }
            if sym == "|" {
               def rot = _clean_rotate_or_expr(bin, rows, j, dst, r.get("src", ""), depth)
               if rot.len > 0 { return rot }
               def packed = _clean_pack_or_expr(bin, rows, j, dst, r.get("src", ""), depth)
               if packed.len > 0 { return packed }
            }
            if sym.len > 0 && sym != "=" && r.get("src", "").len > 0 {
               def left = _clean_operand_expr_at(bin, rows, j - 1, dst, depth + 1, cross_forward_branches, preserve)
               def right = _clean_operand_expr_at(bin, rows, j - 1, r.get("src", ""), depth + 1, cross_forward_branches, preserve)
               def expr = _clean_binary_expr(left, sym, right)
               if (!cross_forward_branches &&
                  _clean_value_symbols_redefined_between(bin, rows, j + 1, before_idx, r.get("family", _rows_family(rows)), expr)){
                  return _ny_operand_ref_bin(bin, op, dict())
               }
               return expr
            }
         }
         return _ny_operand_ref_bin(bin, op, dict())
      }
      j -= 1
      guard += 1
   }
   _ny_operand_ref_bin(bin, op, dict())
}

fn _clean_zero_operand(str op) bool {
   def s = str.strip(op)
   s == "0" || s == "0x0" || s == "$0" || s == "#0"
}

fn _clean_return_operand(list rows, str op) bool {
   def syms = _slice_operand_symbols(op)
   if syms.len == 0 { return false }
   def rets = _abi_profile(_rows_family(rows)).get("returns", [])
   mut i = 0
   while i < rets.len {
      if _symbols_intersect(_slice_symbol_aliases(rets[i]), syms) { return true }
      i += 1
   }
   false
}

fn _clean_call_result_test_after(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len || rows[idx].get("op", "") != "call" { return false }
   mut j = idx + 1
   while j < rows.len && j - idx <= 4 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "compare" {
         def m = r.get("mnemonic", "")
         def ret_dst = _clean_return_operand(rows, r.get("dst", ""))
         def ret_src = _clean_return_operand(rows, r.get("src", ""))
         if (str.startswith(m, "test") && ret_dst && ret_src) || (!str.startswith(m, "test") && ret_dst) {
            return j + 1 < rows.len && rows[j + 1].get("op", "") == "branch"
         }
         return false
      }
      if op == "assign" || op == "arith" {
         if _clean_return_operand(rows, r.get("dst", "")) { return false }
      }
      if op == "call" || op == "syscall" || op == "branch" || op == "return" { return false }
      j += 1
   }
   false
}

fn _clean_setcc_feeds_branch(list rows, int idx) bool {
   if idx < 0 || idx + 2 >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("kind", "") != "setcc" { return false }
   def cmp = rows[idx + 1]
   def br = rows[idx + 2]
   if cmp.get("op", "") != "compare" || br.get("op", "") != "branch" { return false }
   _symbols_intersect(_row_uses(cmp), _slice_operand_symbols(row.get("dst", "")))
}

fn _clean_cmov_feeds_branch(list rows, int idx) bool {
   if idx < 0 || idx + 2 >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("kind", "") != "cmovcc" { return false }
   def cmp = rows[idx + 1]
   def br = rows[idx + 2]
   if cmp.get("op", "") != "compare" || br.get("op", "") != "branch" { return false }
   _symbols_intersect(_row_uses(cmp), _slice_operand_symbols(row.get("dst", "")))
}

fn _clean_row_feeds_cmov_expr(list rows, int idx) bool {
   if idx < 0 || idx >= rows.len { return false }
   def row = rows[idx]
   def op = row.get("op", "")
   if !(op == "assign" || op == "arith") || row.get("dst_kind", "") != "reg" { return false }
   if row.get("kind", "") == "cmovcc" || row.get("kind", "") == "setcc" { return false }
   def defs = _row_defs(row)
   if defs.len == 0 { return false }
   mut j = idx + 1
   while j < rows.len && j - idx <= 8 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "assign" && r.get("kind", "") == "cmovcc" {
         return _symbols_intersect(_slice_operand_symbols(r.get("src", "")), defs) ||
         _symbols_intersect(_slice_operand_symbols(r.get("dst", "")), defs)
      }
      if rop == "call" || rop == "syscall" || rop == "branch" || rop == "return" { return false }
      if _symbols_intersect(_row_uses(r), defs) { return false }
      if _symbols_intersect(_row_defs(r), defs) { return false }
      j += 1
   }
   false
}

fn _clean_setcc_feeds_bool_linear(list rows, int idx) bool {
   if idx < 0 || idx + 1 >= rows.len { return false }
   def row = rows[idx]
   if row.get("op", "") != "assign" || row.get("kind", "") != "setcc" { return false }
   def next = rows[idx + 1]
   if !(next.get("op", "") == "arith" || (next.get("op", "") == "assign" && next.get("kind", "") == "lea")) { return false }
   if !_symbols_intersect(_slice_operand_symbols(next.get("dst", "")), _slice_operand_symbols(row.get("dst", ""))) { return false }
   def aliases = _append_all_unique(_slice_symbol_aliases(row.get("dst", "")),
      _slice_symbol_aliases(next.get("dst", "")))
   _clean_linear_bool_values(_effect_rhs(next.get("effect", ""), ""), aliases).get("ok", false)
}

fn _clean_sign_extend_feeds_abs(list rows, int idx) bool {
   if idx < 0 || idx + 2 >= rows.len { return false }
   def srow = rows[idx]
   if srow.get("kind", "") != "sign_extend_dividend" { return false }
   def xrow = rows[idx + 1]
   def sub = rows[idx + 2]
   if xrow.get("op", "") != "arith" || xrow.get("operator", "") != "^" { return false }
   if sub.get("op", "") != "arith" || sub.get("operator", "") != "-" { return false }
   def mask = _slice_operand_symbols(srow.get("dst", ""))
   if mask.len == 0 { return false }
   _symbols_intersect(_slice_operand_symbols(xrow.get("src", "")), mask) &&
   _symbols_intersect(_slice_operand_symbols(sub.get("src", "")), mask) &&
   _symbols_intersect(_slice_operand_symbols(xrow.get("dst", "")), _slice_operand_symbols(sub.get("dst", ""))) &&
   _symbols_intersect(_slice_operand_symbols(xrow.get("dst", "")), _slice_operand_symbols(srow.get("src", "")))
}

fn _clean_recent_call_expr(list rows, int before_idx, any bin0=dict()) str {
   mut j = before_idx
   mut guard = 0
   while j >= 0 && guard < 8 {
      def r = rows[j]
      def op = r.get("op", "")
      if op == "branch" || op == "syscall" || op == "return" { break }
      if op == "call" {
         mut name = r.get("target_name", "")
         if name.len == 0 { name = "sub_" + str.to_hex(int(r.get("target", 0)), 0) }
         def args = is_dict(bin0) && bin0.get("ok", false) ? _clean_call_arg_model_with_sig(bin0, dict(), rows, j) : _call_arg_model(rows, j)
         return _call_render(name, args, r.get("family", _rows_family(rows)))
      }
      if op == "assign" || op == "arith" {
         if _clean_return_operand(rows, r.get("dst", "")) { break }
      }
      j -= 1
      guard += 1
   }
   ""
}

fn _clean_condition_context_expr(dict bin, list rows, int row_idx, dict row, int depth) str {
   def cond = row.get("condition", "")
   def lhs_raw = row.get("cmp_lhs", "")
   if cond.len == 0 || lhs_raw.len == 0 { return "last_cmp" + (cond.len > 0 ? ("." + cond) : "") }
   def rhs_raw = row.get("cmp_rhs", "")
   def op = _cmp_condition_symbol(cond)
   if op.len == 0 { return "last_cmp." + cond }
   def lhs = _clean_condition_operand_expr_at(bin, rows, row_idx - 1, lhs_raw, depth + 1)
   def rhs = _clean_condition_operand_expr_at(bin, rows, row_idx - 1, rhs_raw, depth + 1)
   if str.startswith(str.lower(row.get("cmp_mnemonic", "")), "test") {
      return _clean_test_expr(lhs, rhs, cond, op)
   }
   if cond == "negative" || cond == "non_negative" { return lhs + " " + op }
   def range = _clean_range_compare_expr(lhs, cond, rhs)
   if range.len > 0 { return range }
   def byte_cmp = _is_byte_operand(lhs_raw) || _is_byte_operand(rhs_raw) ||
   _clean_byte_reg_lane(lhs_raw).get("ok", false) || _clean_byte_reg_lane(rhs_raw).get("ok", false)
   _clean_compare_expr(lhs, op, rhs, int(row.get("size", 0)) > 0 && int(row.get("size", 0)) <= 4, byte_cmp)
}

fn _clean_condition_operand_expr_at(dict bin, list rows, int before_idx, str op0, int depth) str {
   def lane = _clean_byte_reg_lane(op0)
   if lane.get("ok", false) {
      def byte = _clean_byte_reg_expr_at(bin, rows, before_idx, op0, depth + 1)
      if byte.len > 0 { return byte }
   }
   _clean_operand_expr_at(bin, rows, before_idx, op0, depth)
}

fn _clean_setcc_expr(dict bin, list rows, int row_idx, dict row, int depth) str {
   def divmod = _clean_setcc_divmod_expr(bin, rows, row_idx, row, depth)
   if divmod.len > 0 { return divmod }
   "bool(" + _clean_condition_context_expr(bin, rows, row_idx, row, depth) + ")"
}

fn _clean_setcc_divmod_expr(dict bin, list rows, int row_idx, dict row, int depth) str {
   if row_idx < 2 || row.get("kind", "") != "setcc" { return "" }
   def cond = row.get("condition", "")
   if !(cond == "eq" || cond == "ne" || cond == "zero" || cond == "nonzero") { return "" }
   def cmp = rows[row_idx - 1]
   if cmp.get("op", "") != "compare" { return "" }
   def lhs = _canonical_value_reg(_rows_family(rows), cmp.get("dst", ""))
   def rhs = _canonical_value_reg(_rows_family(rows), cmp.get("src", ""))
   if lhs.len == 0 || lhs != rhs { return "" }
   def div = rows[row_idx - 2]
   if div.get("op", "") != "arith" || !(div.get("kind", "") == "signed_div" || div.get("kind", "") == "unsigned_div") { return "" }
   mut dividend = _clean_operand_expr_at(bin, rows, row_idx - 3, div.get("dst", ""), depth + 1, true)
   def divisor = _clean_operand_expr_at(bin, rows, row_idx - 3, div.get("src", ""), depth + 1, true)
   if dividend.len == 0 || divisor.len == 0 { return "" }
   if str.find(dividend, "mem(") >= 0 || str.find(dividend, "sext8(") >= 0 || str.find(dividend, "zext8(") >= 0 {
      dividend = _ny_operand_ref_bin(bin, div.get("dst", ""), dict())
   }
   _clean_paren(dividend) + " % " + _clean_paren(divisor) + ((cond == "eq" || cond == "zero") ? " == 0" : " != 0")
}

fn _clean_select_expr(str cond0, str then0, str else0) str {
   def cond = str.strip(cond0)
   def then_expr = str.strip(then0)
   def else_expr = str.strip(else0)
   if _clean_same_expr(then_expr, else_expr) { return then_expr }
   "select(" + cond + ", " + then_expr + ", " + else_expr + ")"
}

fn _clean_small_int_text(int v) str {
   if v >= 0 && v <= 9 { return to_str(v) }
   if v >= 0 { return _hex(v) }
   to_str(v)
}

fn _clean_compact_expr_text(str raw) str {
   mut out = ""
   mut i = 0
   while i < raw.len {
      def c = load8(raw, i)
      if c != 32 && c != 9 && c != 10 && c != 13 { out = out + chr(c) }
      i += 1
   }
   out
}

fn _clean_numeric_literal(str raw) bool {
   mut s = str.strip(raw)
   if s.len == 0 { return false }
   if load8(s, 0) == 43 || load8(s, 0) == 45 { s = slice(s, 1, s.len, 1) }
   if s.len == 0 { return false }
   if str.startswith(s, "0x") || str.startswith(s, "0X") {
      if s.len <= 2 { return false }
      mut i = 2
      while i < s.len {
         def c = load8(s, i)
         if !str.ascii_is_digit(c) && !(c >= 97 && c <= 102) && !(c >= 65 && c <= 70) { return false }
         i += 1
      }
      return true
   }
   mut i = 0
   while i < s.len {
      if !str.ascii_is_digit(load8(s, i)) { return false }
      i += 1
   }
   true
}

fn _clean_linear_bool_term(str term0, list aliases) dict {
   def term = str.lower(str.strip(term0))
   if term.len == 0 { return {"ok": false} }
   if _list_has(aliases, term) { return {"ok": true, "coeff": 1, "const": 0} }
   def star = str.find(term, "*")
   if star >= 0 {
      def left = str.strip(slice(term, 0, star, 1))
      def right = str.strip(slice(term, star + 1, term.len, 1))
      if _list_has(aliases, left) && _clean_numeric_literal(right) {
         return {"ok": true, "coeff": _parse_int_piece(right), "const": 0}
      }
      if _list_has(aliases, right) && _clean_numeric_literal(left) {
         return {"ok": true, "coeff": _parse_int_piece(left), "const": 0}
      }
      return {"ok": false}
   }
   if _clean_numeric_literal(term) { return {"ok": true, "coeff": 0, "const": _parse_int_piece(term)} }
   {"ok": false}
}

fn _clean_linear_bool_values(str expr0, list aliases) dict {
   def expr = _clean_compact_expr_text(expr0)
   if expr.len == 0 { return {"ok": false} }
   mut coeff = 0
   mut base = 0
   mut i = 0
   mut sign = 1
   while i < expr.len {
      def c = load8(expr, i)
      if c == 43 {
         sign = 1
         i += 1
         continue
      }
      if c == 45 {
         sign = -1
         i += 1
         continue
      }
      def start = i
      while i < expr.len && load8(expr, i) != 43 && load8(expr, i) != 45 { i += 1 }
      def part = _clean_linear_bool_term(slice(expr, start, i, 1), aliases)
      if !part.get("ok", false) { return {"ok": false} }
      coeff += sign * int(part.get("coeff", 0))
      base += sign * int(part.get("const", 0))
      sign = 1
   }
   {"ok": true, "false": base, "true": base + coeff}
}

fn _clean_bool_linear_select_expr(dict bin, list rows, int row_idx, dict row) str {
   if row_idx <= 0 || !(row.get("op", "") == "arith" || (row.get("op", "") == "assign" && row.get("kind", "") == "lea")) { return "" }
   def prev = rows[row_idx - 1]
   if prev.get("op", "") != "assign" || prev.get("kind", "") != "setcc" { return "" }
   if !_symbols_intersect(_slice_operand_symbols(row.get("dst", "")), _slice_operand_symbols(prev.get("dst", ""))) { return "" }
   def rhs = _effect_rhs(row.get("effect", ""), "")
   def aliases = _append_all_unique(_slice_symbol_aliases(prev.get("dst", "")),
      _slice_symbol_aliases(row.get("dst", "")))
   def vals = _clean_linear_bool_values(rhs, aliases)
   if !vals.get("ok", false) { return "" }
   def cond = _clean_bool_predicate_expr(_clean_setcc_expr(bin, rows, row_idx - 1, prev, 0))
   if cond.len == 0 { return "" }
   _clean_select_expr(cond, _clean_small_int_text(int(vals.get("true", 0))), _clean_small_int_text(int(vals.get("false", 0))))
}

fn _clean_cmov_minmax_expr(dict row, str lhs, str rhs, str moved, str kept) str {
   def cond = row.get("condition", "")
   mut unsigned = false
   mut prefer_min = false
   mut prefer_max = false
   if cond == "gt" || cond == "ge" || cond == "ugt" || cond == "uge" {
      prefer_min = true
      unsigned = cond == "ugt" || cond == "uge"
   } elif cond == "lt" || cond == "le" || cond == "ult" || cond == "ule" {
      prefer_max = true
      unsigned = cond == "ult" || cond == "ule"
   } else {
      return ""
   }
   if _clean_same_expr(kept, lhs) && _clean_same_expr(moved, rhs) {
      return (prefer_min ? (unsigned ? "umin" : "min") : (unsigned ? "umax" : "max")) + "(" + lhs + ", " + rhs + ")"
   }
   if _clean_same_expr(kept, rhs) && _clean_same_expr(moved, lhs) {
      return (prefer_min ? (unsigned ? "umax" : "max") : (unsigned ? "umin" : "min")) + "(" + lhs + ", " + rhs + ")"
   }
   ""
}

fn _clean_cmov_expr(dict bin, list rows, int row_idx, dict row, int depth) str {
   def cond = _clean_condition_context_expr(bin, rows, row_idx, row, depth)
   def moved = _clean_operand_expr_at(bin, rows, row_idx - 1, row.get("src", ""), depth + 1)
   def kept = _clean_operand_expr_at(bin, rows, row_idx - 1, row.get("dst", ""), depth + 1)
   if row.get("cmp_lhs", "").len > 0 && row.get("cmp_rhs", "").len > 0 && !str.startswith(str.lower(row.get("cmp_mnemonic", "")), "test") {
      def lhs = _clean_operand_expr_at(bin, rows, row_idx - 1, row.get("cmp_lhs", ""), depth + 1)
      def rhs = _clean_operand_expr_at(bin, rows, row_idx - 1, row.get("cmp_rhs", ""), depth + 1)
      def mm = _clean_cmov_minmax_expr(row, lhs, rhs, moved, kept)
      if mm.len > 0 { return mm }
   }
   _clean_select_expr(cond, moved, kept)
}

fn _clean_abs_expr(dict bin, list rows, int row_idx, str dst, str mask_op, int depth) str {
   if row_idx < 0 || row_idx >= rows.len { return "" }
   def row = rows[row_idx]
   if row.get("op", "") != "arith" || row.get("operator", "") != "-" { return "" }
   def mask_syms = _slice_operand_symbols(mask_op)
   if mask_syms.len == 0 { return "" }
   def xor_idx = _clean_prev_def_row(rows, row_idx - 1, dst)
   if xor_idx < 0 { return "" }
   def xrow = rows[xor_idx]
   if xrow.get("op", "") != "arith" || xrow.get("operator", "") != "^" { return "" }
   if !_symbols_intersect(_slice_operand_symbols(xrow.get("src", "")), mask_syms) { return "" }
   def sign_idx = _clean_prev_def_row(rows, xor_idx - 1, mask_op)
   if sign_idx < 0 { return "" }
   def srow = rows[sign_idx]
   if srow.get("kind", "") != "sign_extend_dividend" { return "" }
   if !_symbols_intersect(_slice_operand_symbols(srow.get("dst", "")), mask_syms) { return "" }
   def base = _clean_operand_expr_at(bin, rows, sign_idx - 1, srow.get("src", ""), depth + 1)
   def xbase = _clean_operand_expr_at(bin, rows, xor_idx - 1, xrow.get("dst", ""), depth + 1)
   if !_clean_same_expr(base, xbase) { return "" }
   "abs(" + base + ")"
}

fn _clean_same_expr(str a, str b) bool {
   str.strip(a) == str.strip(b)
}

fn _clean_byte_mask_index(str op) int {
   if _operand_kind(op) != "imm" { return -1 }
   def mask = _imm_number(op)
   mut i = 0
   while i < 16 {
      if mask == (0xff << (i * 8)) { return i }
      i += 1
   }
   -1
}

fn _clean_shift_byte_index(str op) int {
   if _operand_kind(op) != "imm" { return -1 }
   def amount = _imm_number(op)
   if amount < 0 || amount % 8 != 0 { return -1 }
   amount / 8
}

fn _clean_prev_def_row(list rows, int before_idx, str op0) int {
   mut j = before_idx
   mut guard = 0
   while j >= 0 && guard < 24 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" || rop == "syscall" || rop == "branch" || rop == "return" { return -1 }
      if _row_def_intersects_operand(r, op0) { return j }
      j -= 1
      guard += 1
   }
   -1
}

fn _clean_byte_at_expr(str base, int idx) str {
   "byte_at(" + str.strip(base) + ", " + to_str(idx) + ")"
}

fn _clean_byte_reg_lane(str op0) dict {
   def s = str.lower(str.strip(_ny_operand(op0)))
   if s == "al" { return {"ok": true, "base": "rax", "lane": 0} }
   if s == "ah" { return {"ok": true, "base": "rax", "lane": 1} }
   if s == "bl" { return {"ok": true, "base": "rbx", "lane": 0} }
   if s == "bh" { return {"ok": true, "base": "rbx", "lane": 1} }
   if s == "cl" { return {"ok": true, "base": "rcx", "lane": 0} }
   if s == "ch" { return {"ok": true, "base": "rcx", "lane": 1} }
   if s == "dl" { return {"ok": true, "base": "rdx", "lane": 0} }
   if s == "dh" { return {"ok": true, "base": "rdx", "lane": 1} }
   if s == "sil" { return {"ok": true, "base": "rsi", "lane": 0} }
   if s == "dil" { return {"ok": true, "base": "rdi", "lane": 0} }
   if s == "bpl" { return {"ok": true, "base": "rbp", "lane": 0} }
   if s == "spl" { return {"ok": true, "base": "rsp", "lane": 0} }
   if s.len >= 3 && load8(s, 0) == 114 && load8(s, s.len - 1) == 98 {
      def mid = slice(s, 1, s.len - 1, 1)
      mut i = 0
      while i < mid.len {
         if !str.ascii_is_digit(load8(mid, i)) { return dict() }
         i += 1
      }
      if mid.len > 0 { return {"ok": true, "base": "r" + mid, "lane": 0} }
   }
   dict()
}

fn _clean_byte_reg_expr_at(dict bin, list rows, int before_idx, str op0, int depth=0, list preserve=[]) str {
   if depth > 8 { return "" }
   def lane = _clean_byte_reg_lane(op0)
   if !lane.get("ok", false) { return "" }
   def base = lane.get("base", "")
   def byte_lane = int(lane.get("lane", 0))
   if base.len == 0 { return "" }
   def prev = _clean_prev_def_row(rows, before_idx, base)
   if prev >= 0 {
      def row = rows[prev]
      def op = row.get("op", "")
      if op == "assign" {
         if row.get("kind", "") == "byte_load" && byte_lane == 0 {
            def loaded = _clean_operand_expr_at(bin, rows, prev - 1, row.get("src", ""), depth + 1, true, preserve)
            def z8 = _clean_strip_unary_call(loaded, "zext8")
            if z8.len > 0 { return z8 }
            def s8 = _clean_strip_unary_call(loaded, "sext8")
            if s8.len > 0 { return s8 }
            return loaded
         }
         def src = _clean_operand_expr_at(bin, rows, prev - 1, row.get("src", ""), depth + 1, true, preserve)
         if src.len > 0 { return _clean_byte_at_expr(src, byte_lane) }
      }
      if op == "arith" && row.get("operator", "") == ">>" && _operand_kind(row.get("src", "")) == "imm" {
         def amount = _imm_number(row.get("src", ""))
         def bits = _clean_operand_bits(row.get("dst", ""))
         if amount >= 0 && amount % 8 == 0 && (bits == 0 || amount + byte_lane * 8 < bits) {
            def src = _clean_operand_expr_at(bin, rows, prev - 1, row.get("dst", ""), depth + 1, true, preserve)
            if src.len > 0 { return _clean_byte_at_expr(src, (amount / 8) + byte_lane) }
         }
      }
   }
   def expr = byte_lane == 0 ? _clean_operand_expr_at(bin, rows, before_idx, op0, depth, true, preserve) :
   _clean_operand_expr_at(bin, rows, before_idx, base, depth + 1, true, preserve)
   if expr.len > 0 {
      if (byte_lane == 0 && (str.find(expr, " ") >= 0 || str.find(expr, "[") >= 0 ||
            str.startswith(expr, "zext") || str.startswith(expr, "sext"))){
         return expr
      }
      return _clean_byte_at_expr(expr, byte_lane)
   }
   ""
}

fn _clean_mask_byte_expr(dict bin, list rows, int row_idx, str dst, str mask_op, int depth) str {
   def idx = _clean_byte_mask_index(mask_op)
   if idx < 0 { return "" }
   def prev = _clean_prev_def_row(rows, row_idx - 1, dst)
   if prev >= 0 {
      def prow = rows[prev]
      if prow.get("op", "") == "arith" && prow.get("operator", "") == ">>" {
         def sidx = _clean_shift_byte_index(prow.get("src", ""))
         if sidx >= 0 && idx == 0 {
            def src = _clean_operand_expr_at(bin, rows, prev - 1, prow.get("dst", ""), depth + 1)
            return _clean_byte_at_expr(src, sidx)
         }
      }
   }
   _clean_byte_at_expr(_clean_operand_expr_at(bin, rows, row_idx - 1, dst, depth + 1), idx)
}

fn _clean_shift_byte_expr(dict bin, list rows, int row_idx, str dst, str shift_op, int depth) str {
   def sidx = _clean_shift_byte_index(shift_op)
   if sidx < 0 { return "" }
   def prev = _clean_prev_def_row(rows, row_idx - 1, dst)
   if prev < 0 { return "" }
   def prow = rows[prev]
   if prow.get("op", "") != "arith" || prow.get("operator", "") != "&" { return "" }
   def midx = _clean_byte_mask_index(prow.get("src", ""))
   if midx < 0 || midx != sidx { return "" }
   _clean_byte_at_expr(_clean_operand_expr_at(bin, rows, prev - 1, prow.get("dst", ""), depth + 1), midx)
}

fn _clean_unsigned_shift_mnemonic(str mnemonic) bool {
   def m = str.lower(str.strip(mnemonic))
   str.startswith(m, "shr") || str.startswith(m, "srl") || str.startswith(m, "lsr")
}

fn _clean_shift_div_expr(dict bin, list rows, int row_idx, str dst, str shift_op, int depth) str {
   if row_idx < 0 || row_idx >= rows.len { return "" }
   if !_clean_unsigned_shift_mnemonic(rows[row_idx].get("mnemonic", "")) { return "" }
   if _operand_kind(shift_op) != "imm" { return "" }
   def amount = _imm_number(shift_op)
   def bits = _clean_operand_bits(dst)
   if amount <= 0 || bits <= 0 || amount >= bits || amount > 30 { return "" }
   def base = _clean_operand_expr_at(bin, rows, row_idx - 1, dst, depth + 1)
   if amount % 8 == 0 && amount == bits - 8 {
      return _clean_byte_at_expr(base, amount / 8)
   }
   def divisor = 1 << amount
   _clean_paren(base) + " / " + to_str(divisor)
}

fn _clean_low_mask_modulus(str op) int {
   if _operand_kind(op) != "imm" { return 0 }
   def mask = _imm_number(op)
   if mask <= 0 { return 0 }
   def modulus = mask + 1
   ((modulus & (modulus - 1)) == 0) ? modulus : 0
}

fn _clean_low_mask_width(str op) int {
   def modulus = _clean_low_mask_modulus(op)
   if modulus <= 1 { return 0 }
   mut width = 0
   mut v = modulus
   while v > 1 {
      width += 1
      v = v / 2
   }
   width
}

fn _clean_bitfield_expr(dict bin, list rows, int row_idx, str dst, str mask_op, int depth) str {
   def width = _clean_low_mask_width(mask_op)
   if width <= 0 { return "" }
   def prev = _clean_prev_def_row(rows, row_idx - 1, dst)
   if prev < 0 { return "" }
   def prow = rows[prev]
   if prow.get("op", "") != "arith" || prow.get("operator", "") != ">>" { return "" }
   if !_clean_unsigned_shift_mnemonic(prow.get("mnemonic", "")) { return "" }
   if _operand_kind(prow.get("src", "")) != "imm" { return "" }
   def amount = _imm_number(prow.get("src", ""))
   def bits = _clean_operand_bits(dst)
   if amount <= 0 || bits <= 0 || amount >= bits || amount + width > bits { return "" }
   def base = _clean_operand_expr_at(bin, rows, prev - 1, prow.get("dst", ""), depth + 1)
   "bits(" + str.strip(base) + ", " + to_str(amount) + ", " + to_str(width) + ")"
}

fn _clean_mask_mod_expr(dict bin, list rows, int row_idx, str dst, str mask_op, int depth) str {
   def modulus = _clean_low_mask_modulus(mask_op)
   if modulus <= 0 { return "" }
   def base = _clean_operand_expr_at(bin, rows, row_idx - 1, dst, depth + 1)
   _clean_paren(base) + " % " + to_str(modulus)
}

fn _clean_pack_terms_for_operand(dict bin, list rows, int before_idx, str op0, int depth) list {
   if depth > 10 { return [] }
   def idx = _clean_prev_def_row(rows, before_idx, op0)
   if idx < 0 { return [] }
   def r = rows[idx]
   def rop = r.get("op", "")
   if rop == "assign" {
      if r.get("kind", "") == "byte_load" && str.startswith(r.get("mnemonic", ""), "movzx") {
         return [{"shift": 0, "byte": _clean_operand_expr_at(bin, rows, idx - 1, r.get("src", ""), depth + 1)}]
      }
      return _clean_pack_terms_for_operand(bin, rows, idx - 1, r.get("src", ""), depth + 1)
   }
   if rop != "arith" { return [] }
   def sym = r.get("operator", "")
   if sym == "|" {
      return _clean_pack_terms_for_operand(bin, rows, idx - 1, r.get("dst", ""), depth + 1) +
      _clean_pack_terms_for_operand(bin, rows, idx - 1, r.get("src", ""), depth + 1)
   }
   if sym == "<<" {
      if _operand_kind(r.get("src", "")) != "imm" { return [] }
      def amount = _imm_number(r.get("src", ""))
      if amount < 0 || amount % 8 != 0 { return [] }
      def base_terms = _clean_pack_terms_for_operand(bin, rows, idx - 1, r.get("dst", ""), depth + 1)
      mut out = []
      mut i = 0
      while i < base_terms.len {
         out = out.append(base_terms[i].set("shift", int(base_terms[i].get("shift", 0)) + amount))
         i += 1
      }
      return out
   }
   []
}

fn _clean_pack_term_at(list terms, int shift) dict {
   mut found = dict()
   mut i = 0
   while i < terms.len {
      if int(terms[i].get("shift", -1)) == shift {
         if found.len > 0 { return dict() }
         found = terms[i]
      }
      i += 1
   }
   found
}

fn _clean_pack_or_expr(dict bin, list rows, int row_idx, str dst, str src, int depth) str {
   def terms = _clean_pack_terms_for_operand(bin, rows, row_idx - 1, dst, depth + 1) +
   _clean_pack_terms_for_operand(bin, rows, row_idx - 1, src, depth + 1)
   if terms.len < 2 || terms.len > 4 { return "" }
   mut args = []
   mut shift = 0
   while shift < terms.len * 8 {
      def t = _clean_pack_term_at(terms, shift)
      if t.len == 0 { return "" }
      args = args.append(t.get("byte", ""))
      shift += 8
   }
   "u" + to_str(terms.len * 8) + "_le(" + str.join(args, ", ") + ")"
}

fn _clean_operand_bits(str op) int {
   def s = str.lower(str.strip(_ny_operand(op)))
   if s.len == 0 { return 0 }
   if (s == "rax" || s == "rbx" || s == "rcx" || s == "rdx" || s == "rsi" || s == "rdi" ||
      s == "rbp" || s == "rsp" || s == "rip"){ return 64 }
   if (s == "eax" || s == "ebx" || s == "ecx" || s == "edx" || s == "esi" || s == "edi" ||
      s == "ebp" || s == "esp"){ return 32 }
   if (s == "ax" || s == "bx" || s == "cx" || s == "dx" || s == "si" || s == "di" ||
      s == "bp" || s == "sp"){ return 16 }
   if (s == "al" || s == "ah" || s == "bl" || s == "bh" || s == "cl" || s == "ch" ||
      s == "dl" || s == "dh" || s == "sil" || s == "dil" || s == "bpl" || s == "spl"){ return 8 }
   if s.len >= 2 && load8(s, 0) == 120 && str.ascii_is_digit(load8(s, 1)) { return 64 }
   if s.len >= 2 && load8(s, 0) == 119 && str.ascii_is_digit(load8(s, 1)) { return 32 }
   if s.len >= 2 && load8(s, 0) == 101 { return 32 }
   if s.len >= 2 && load8(s, 0) == 114 {
      if load8(s, s.len - 1) == 100 { return 32 }
      if load8(s, s.len - 1) == 119 { return 16 }
      if load8(s, s.len - 1) == 98 { return 8 }
      return 64
   }
   0
}

fn _clean_shift_arm(dict bin, list rows, int before_idx, str op0, int depth) dict {
   def idx = _clean_prev_def_row(rows, before_idx, op0)
   if idx < 0 { return dict() }
   def r = rows[idx]
   if r.get("op", "") != "arith" { return dict() }
   def dir = r.get("operator", "")
   if dir != "<<" && dir != ">>" { return dict() }
   if _operand_kind(r.get("src", "")) != "imm" { return dict() }
   def amount = _imm_number(r.get("src", ""))
   def bits = _clean_operand_bits(r.get("dst", ""))
   if amount <= 0 || bits <= 0 || amount >= bits { return dict() }
   {"ok": true, "row": idx, "dir": dir, "amount": amount, "bits": bits,
      "base": _clean_operand_expr_at(bin, rows, idx - 1, r.get("dst", ""), depth + 1)}
}

fn _clean_rotate_or_expr(dict bin, list rows, int row_idx, str dst, str src, int depth) str {
   def a = _clean_shift_arm(bin, rows, row_idx - 1, dst, depth)
   def b = _clean_shift_arm(bin, rows, row_idx - 1, src, depth)
   if !a.get("ok", false) || !b.get("ok", false) { return "" }
   if a.get("dir", "") == b.get("dir", "") { return "" }
   if int(a.get("bits", 0)) != int(b.get("bits", 0)) { return "" }
   if !_clean_same_expr(a.get("base", ""), b.get("base", "")) { return "" }
   def bits = int(a.get("bits", 0))
   def la = a.get("dir", "") == "<<" ? int(a.get("amount", 0)) : int(b.get("amount", 0))
   def ra = a.get("dir", "") == ">>" ? int(a.get("amount", 0)) : int(b.get("amount", 0))
   if la <= 0 || ra <= 0 || la + ra != bits { return "" }
   la <= ra ? ("rol(" + a.get("base", "") + ", " + to_str(la) + ")") :
   ("ror(" + a.get("base", "") + ", " + to_str(ra) + ")")
}

fn _clean_test_expr(str lhs, str rhs, str cond, str op) str {
   def bl = _clean_strip_unary_call(lhs, "bool")
   if bl.len > 0 && _clean_same_expr(lhs, rhs) {
      if cond == "eq" || cond == "zero" { return "!(" + bl + ")" }
      if cond == "ne" || cond == "nonzero" { return bl }
   }
   if _clean_same_expr(lhs, rhs) {
      def x1 = _clean_xor_one_base(lhs)
      if x1.len > 0 {
         if cond == "eq" || cond == "zero" { return x1 + " == 1" }
         if cond == "ne" || cond == "nonzero" { return x1 + " != 1" }
      }
      mut base = lhs
      def z8 = _clean_strip_unary_call(base, "zext8")
      if z8.len > 0 { base = z8 }
      if cond == "eq" { return base + " == 0" }
      if cond == "ne" { return base + " != 0" }
      if cond == "zero" { return base + " == 0" }
      if cond == "nonzero" { return base + " != 0" }
      if cond == "gt" { return base + " > 0" }
      if cond == "ge" { return base + " >= 0" }
      if cond == "lt" { return base + " < 0" }
      if cond == "le" { return base + " <= 0" }
      if cond == "negative" { return base + " < 0" }
      if cond == "non_negative" { return base + " >= 0" }
      if cond == "ugt" { return base + " != 0" }
      if cond == "uge" { return "true" }
      if cond == "ult" { return "false" }
      if cond == "ule" { return base + " == 0" }
   }
   mut mlhs = lhs
   mut mrhs = rhs
   def lz8 = _clean_strip_unary_call(mlhs, "zext8")
   if lz8.len > 0 && _clean_imm_between(mrhs, 0, 255) { mlhs = lz8 }
   def ls8 = _clean_strip_unary_call(mlhs, "sext8")
   if ls8.len > 0 && _clean_imm_between(mrhs, 0, 255) { mlhs = ls8 }
   def rz8 = _clean_strip_unary_call(mrhs, "zext8")
   if rz8.len > 0 && _clean_imm_between(mlhs, 0, 255) { mrhs = rz8 }
   def rs8 = _clean_strip_unary_call(mrhs, "sext8")
   if rs8.len > 0 && _clean_imm_between(mlhs, 0, 255) { mrhs = rs8 }
   def texpr = "(" + mlhs + " & " + mrhs + ")"
   if cond == "eq" { return texpr + " == 0" }
   if cond == "ne" { return texpr + " != 0" }
   if cond == "zero" { return texpr + " == 0" }
   if cond == "nonzero" { return texpr + " != 0" }
   if (cond == "gt" || cond == "ge" || cond == "lt" || cond == "le" ||
      cond == "ugt" || cond == "uge" || cond == "ult" || cond == "ule"){
      return texpr + " " + op + " 0"
   }
   if cond == "negative" || cond == "non_negative" { return texpr + " " + op }
   texpr + " " + op
}

fn _clean_xor_one_base(str expr) str {
   def e = _clean_strip_outer_parens(expr)
   def p = str.find(e, " ^^ ")
   if p < 0 { return "" }
   def left = str.strip(slice(e, 0, p, 1))
   def right = str.strip(slice(e, p + 4, e.len, 1))
   if _clean_literal_one(right) { return left }
   if _clean_literal_one(left) { return right }
   ""
}

fn _clean_strip_unary_call(str expr, str name) str {
   def e = str.strip(expr)
   def prefix = name + "("
   if !str.startswith(e, prefix) { return "" }
   if e.len <= prefix.len || load8(e, e.len - 1) != 41 { return "" }
   slice(e, prefix.len, e.len - 1, 1)
}

fn _clean_bool_predicate_expr(str expr) str {
   def e = str.strip(expr)
   def b = _clean_strip_unary_call(e, "bool")
   if b.len > 0 { return b }
   mut z = _clean_strip_unary_call(e, "zext")
   if z.len > 0 {
      def zb = _clean_strip_unary_call(z, "bool")
      if zb.len > 0 { return zb }
      if (str.find(z, " == ") >= 0 || str.find(z, " != ") >= 0 ||
         str.find(z, " <= ") >= 0 || str.find(z, " >= ") >= 0 ||
         str.find(z, " < ") >= 0 || str.find(z, " > ") >= 0){ return z }
   }
   z = _clean_strip_unary_call(e, "zext8")
   if z.len > 0 {
      def zb = _clean_strip_unary_call(z, "bool")
      if zb.len > 0 { return zb }
   }
   z = _clean_strip_unary_call(e, "zext16")
   if z.len > 0 {
      def zb = _clean_strip_unary_call(z, "bool")
      if zb.len > 0 { return zb }
   }
   z = _clean_strip_unary_call(e, "zext32")
   if z.len > 0 {
      def zb = _clean_strip_unary_call(z, "bool")
      if zb.len > 0 { return zb }
   }
   ""
}

fn _clean_imm_between(str expr, int lo, int hi) bool {
   if _operand_kind(expr) != "imm" { return false }
   def v = _imm_number(expr)
   v >= lo && v <= hi
}

fn _clean_synthetic_negative_imm(str expr) dict {
   def e = str.strip(expr)
   if e.len <= 1 || load8(e, 0) != 95 { return {"ok": false} }
   mut i = 1
   while i < e.len {
      if !str.ascii_is_digit(load8(e, i)) { return {"ok": false} }
      i += 1
   }
   {"ok": true, "value": -_parse_int_piece(slice(e, 1, e.len, 1))}
}

fn _clean_sext8_byte_const(str expr, bool imm8_alias_ok=false) int {
   def neg_alias = _clean_synthetic_negative_imm(expr)
   if neg_alias.get("ok", false) {
      def nv = int(neg_alias.get("value", 0))
      if nv >= -128 && nv <= 127 { return nv < 0 ? nv + 256 : nv }
   }
   if _operand_kind(expr) != "imm" { return -1 }
   def v = _imm_number(expr)
   if v >= -128 && v <= 127 { return v < 0 ? v + 256 : v }
   if imm8_alias_ok && v >= 128 && v <= 255 { return v }
   -1
}

fn _clean_bool_compare_expr(str lhs, str op, str rhs) str {
   def lb = _clean_bool_predicate_expr(lhs)
   if lb.len > 0 && _clean_imm_between(rhs, 0, 1) {
      def rv = _imm_number(rhs)
      if (op == "==" && rv == 1) || (op == "!=" && rv == 0) { return lb }
      if (op == "==" && rv == 0) || (op == "!=" && rv == 1) { return "!(" + lb + ")" }
   }
   def rb = _clean_bool_predicate_expr(rhs)
   if rb.len > 0 && _clean_imm_between(lhs, 0, 1) {
      def lv = _imm_number(lhs)
      if (op == "==" && lv == 1) || (op == "!=" && lv == 0) { return rb }
      if (op == "==" && lv == 0) || (op == "!=" && lv == 1) { return "!(" + rb + ")" }
   }
   ""
}

fn _clean_call_args(str inner) list {
   mut out = []
   mut start = 0
   mut depth = 0
   mut quote = 0
   mut i = 0
   while i < inner.len {
      def ch = load8(inner, i)
      if quote != 0 {
         if ch == 92 && i + 1 < inner.len {
            i += 2
            continue
         }
         if ch == quote { quote = 0 }
      } elif ch == 34 || ch == 39 {
         quote = ch
      } elif ch == 40 {
         depth += 1
      } elif ch == 41 && depth > 0 {
         depth -= 1
      } elif ch == 91 {
         depth += 1
      } elif ch == 93 && depth > 0 {
         depth -= 1
      } elif ch == 44 && depth == 0 {
         out = out.append(str.strip(slice(inner, start, i, 1)))
         start = i + 1
      }
      i += 1
   }
   out = out.append(str.strip(slice(inner, start, inner.len, 1)))
   out
}

fn _clean_select_parts(str expr) dict {
   def e = str.strip(expr)
   def p = "select("
   if !str.startswith(e, p) || e.len <= p.len || load8(e, e.len - 1) != 41 { return dict() }
   def args = _clean_call_args(slice(e, p.len, e.len - 1, 1))
   if args.len != 3 { return dict() }
   {"ok": true, "cond": args[0], "then": args[1], "else": args[2]}
}

fn _clean_invert_cond(str cond) str {
   def c = str.strip(cond)
   if str.startswith(c, "!(") && c.len > 3 && load8(c, c.len - 1) == 41 {
      return slice(c, 2, c.len - 1, 1)
   }
   def ops = [" == ", " != ", " <= ", " >= ", " < ", " > "]
   def inv = [" != ", " == ", " > ", " < ", " >= ", " <= "]
   mut i = 0
   while i < ops.len {
      def p = _clean_top_level_find(c, ops[i])
      if p >= 0 {
         return str.strip(slice(c, 0, p, 1)) + inv[i] +
         str.strip(slice(c, p + ops[i].len, c.len, 1))
      }
      i += 1
   }
   "!(" + c + ")"
}

fn _clean_select_compare_expr(str lhs, str op, str rhs) str {
   if op != "==" && op != "!=" { return "" }
   def lp = _clean_select_parts(lhs)
   if lp.get("ok", false) && !_clean_same_expr(lp.get("then", ""), lp.get("else", "")) {
      if _clean_same_expr(rhs, lp.get("then", "")) { return op == "==" ? lp.get("cond", "") : _clean_invert_cond(lp.get("cond", "")) }
      if _clean_same_expr(rhs, lp.get("else", "")) { return op == "==" ? _clean_invert_cond(lp.get("cond", "")) : lp.get("cond", "") }
   }
   def rp = _clean_select_parts(rhs)
   if rp.get("ok", false) && !_clean_same_expr(rp.get("then", ""), rp.get("else", "")) {
      if _clean_same_expr(lhs, rp.get("then", "")) { return op == "==" ? rp.get("cond", "") : _clean_invert_cond(rp.get("cond", "")) }
      if _clean_same_expr(lhs, rp.get("else", "")) { return op == "==" ? _clean_invert_cond(rp.get("cond", "")) : rp.get("cond", "") }
   }
   ""
}

fn _clean_sub_const_parts(str expr) dict {
   def e = str.strip(expr)
   mut depth = 0
   mut i = 0
   while i + 2 < e.len {
      def ch = load8(e, i)
      if ch == 40 {
         depth += 1
      } elif ch == 41 && depth > 0 {
         depth -= 1
      } elif depth == 0 && ch == 32 && load8(e, i + 1) == 45 && load8(e, i + 2) == 32 {
         def base = str.strip(slice(e, 0, i, 1))
         def off = str.strip(slice(e, i + 3, e.len, 1))
         if base.len > 0 && _operand_kind(off) == "imm" {
            return {"ok": true, "base": base, "offset": _imm_number(off)}
         }
      }
      i += 1
   }
   dict()
}

fn _clean_between_expr(str base, int lo, int hi) str {
   "between(" + str.strip(base) + ", " + _hex(lo) + ", " + _hex(hi) + ")"
}

fn _clean_range_compare_expr(str lhs, str cond, str rhs) str {
   if cond != "ule" && cond != "ult" && cond != "ugt" && cond != "uge" { return "" }
   if _operand_kind(rhs) != "imm" { return "" }
   def span = _imm_number(rhs)
   if span < 0 { return "" }
   def sub = _clean_sub_const_parts(lhs)
   if !sub.get("ok", false) { return "" }
   def lo = int(sub.get("offset", 0))
   if cond == "ule" {
      return _clean_between_expr(sub.get("base", ""), lo, lo + span)
   }
   if cond == "ult" {
      if span <= 0 { return "" }
      return _clean_between_expr(sub.get("base", ""), lo, lo + span - 1)
   }
   if cond == "ugt" {
      return "!(" + _clean_between_expr(sub.get("base", ""), lo, lo + span) + ")"
   }
   if cond == "uge" {
      if span <= 0 { return "" }
      return "!(" + _clean_between_expr(sub.get("base", ""), lo, lo + span - 1) + ")"
   }
   ""
}

fn _clean_compare_byte_expr_text(str expr0) bool {
   def expr = str.strip(_clean_strip_outer_parens(expr0))
   if expr.len == 0 { return false }
   if str.startswith(expr, "byte_at(") { return true }
   if str.find(expr, "[") >= 0 && str.endswith(expr, "]") { return true }
   str.find(expr, ".") > 0 && str.find(expr, " ") < 0 && str.find(expr, "(") < 0
}

fn _clean_compare_expr(str lhs0, str op, str rhs0, bool imm8_alias_ok=false, bool byte_compare=false) str {
   def lhs = str.strip(lhs0)
   def rhs = str.strip(rhs0)
   if op == "==" || op == "!=" {
      def sexpr = _clean_select_compare_expr(lhs, op, rhs)
      if sexpr.len > 0 { return sexpr }
      def bexpr = _clean_bool_compare_expr(lhs, op, rhs)
      if bexpr.len > 0 { return bexpr }
      def lz8 = _clean_strip_unary_call(lhs, "zext8")
      def rz8 = _clean_strip_unary_call(rhs, "zext8")
      if lz8.len > 0 && rz8.len > 0 {
         return _clean_condition_operand(lz8) + " " + op + " " + _clean_condition_operand(rz8)
      }
      if lz8.len > 0 && byte_compare {
         return _clean_condition_operand(lz8) + " " + op + " " + _clean_condition_operand(rhs)
      }
      if lz8.len > 0 && _clean_compare_byte_expr_text(rhs) {
         return _clean_condition_operand(lz8) + " " + op + " " + _clean_condition_operand(rhs)
      }
      if lz8.len > 0 && _clean_imm_between(rhs, 0, 255) {
         return _clean_condition_operand(lz8) + " " + op + " " + _clean_condition_operand(rhs)
      }
      if rz8.len > 0 && _clean_compare_byte_expr_text(lhs) {
         return _clean_condition_operand(lhs) + " " + op + " " + _clean_condition_operand(rz8)
      }
      if rz8.len > 0 && byte_compare {
         return _clean_condition_operand(lhs) + " " + op + " " + _clean_condition_operand(rz8)
      }
      if rz8.len > 0 && _clean_imm_between(lhs, 0, 255) {
         return _clean_condition_operand(lhs) + " " + op + " " + _clean_condition_operand(rz8)
      }
      def ls8 = _clean_strip_unary_call(lhs, "sext8")
      def rs8 = _clean_strip_unary_call(rhs, "sext8")
      if ls8.len > 0 && rs8.len > 0 {
         return _clean_condition_operand(ls8) + " " + op + " " + _clean_condition_operand(rs8)
      }
      if ls8.len > 0 && byte_compare {
         return _clean_condition_operand(ls8) + " " + op + " " + _clean_condition_operand(rhs)
      }
      if ls8.len > 0 && _clean_compare_byte_expr_text(rhs) {
         return _clean_condition_operand(ls8) + " " + op + " " + _clean_condition_operand(rhs)
      }
      def rb = _clean_sext8_byte_const(rhs, imm8_alias_ok)
      if ls8.len > 0 && rb >= 0 {
         return _clean_condition_operand(ls8) + " " + op + " " + _hex(rb)
      }
      if rs8.len > 0 && _clean_compare_byte_expr_text(lhs) {
         return _clean_condition_operand(lhs) + " " + op + " " + _clean_condition_operand(rs8)
      }
      if rs8.len > 0 && byte_compare {
         return _clean_condition_operand(lhs) + " " + op + " " + _clean_condition_operand(rs8)
      }
      def lb = _clean_sext8_byte_const(lhs, imm8_alias_ok)
      if rs8.len > 0 && lb >= 0 {
         return _hex(lb) + " " + op + " " + _clean_condition_operand(rs8)
      }
   }
   _clean_condition_operand(lhs) + " " + op + " " + _clean_condition_operand(rhs)
}

fn _clean_negated_condition_expr(str expr0) str {
   def expr = _clean_strip_outer_parens(expr0)
   def ops = [" == ", " != ", " <= ", " >= ", " < ", " > "]
   def inv = [" != ", " == ", " > ", " < ", " >= ", " <= "]
   mut i = 0
   while i < ops.len {
      def p = str.find(expr, ops[i])
      if p >= 0 {
         def lhs = str.strip(slice(expr, 0, p, 1))
         def rhs = str.strip(slice(expr, p + ops[i].len, expr.len, 1))
         if lhs.len > 0 && rhs.len > 0 {
            return lhs + inv[i] + rhs
         }
      }
      i += 1
   }
   "!(" + expr + ")"
}

fn _clean_condition_operand(str expr) str {
   def e = str.strip(expr)
   if (str.find(e, " & ") >= 0 || str.find(e, " | ") >= 0 ||
      str.find(e, " << ") >= 0 || str.find(e, " >> ") >= 0 ||
      str.find(e, " ^^ ") >= 0){ return _clean_paren(e) }
   e
}

fn _clean_branch_condition_expr(dict bin, list rows, int idx, str cond) str {
   if idx >= 0 && idx < rows.len {
      def br = rows[idx]
      def args = br.get("args", [])
      if (cond == "zero" || cond == "nonzero") && args.len > 0 {
         def lhs = _clean_operand_expr_for_branch(bin, rows, idx, idx - 1, args[0])
         return lhs + (cond == "zero" ? " == 0" : " != 0")
      }
      if (cond == "bit_zero" || cond == "bit_nonzero") && args.len > 1 {
         def lhs = _clean_operand_expr_for_branch(bin, rows, idx, idx - 1, args[0])
         def bit = _imm_number(args[1])
         def mask = 1 << max(0, bit)
         return "(" + lhs + " & " + _hex(mask) + ")" + (cond == "bit_zero" ? " == 0" : " != 0")
      }
      if br.get("family", "") == "riscv" && args.len > 1 {
         def bop = _cmp_condition_symbol(cond)
         if bop.len > 0 {
            return _clean_operand_expr_for_branch(bin, rows, idx, idx - 1, args[0]) + " " + bop + " " + _clean_operand_expr_for_branch(bin, rows, idx, idx - 1, args[1])
         }
      }
   }
   def op = _cmp_condition_symbol(cond)
   if op.len == 0 { return _branch_condition_expr(rows, idx, cond) }
   mut j = idx - 1
   while j >= 0 && idx - j <= 8 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" || rop == "branch" || rop == "syscall" || rop == "return" { break }
      if rop == "compare" {
         if str.startswith(r.get("mnemonic", ""), "test") {
            def call_expr = (_clean_return_operand(rows, r.get("dst", "")) && _clean_return_operand(rows, r.get("src", ""))) ? _clean_recent_call_expr(rows, j - 1, bin) : ""
            if call_expr.len > 0 {
               return _clean_test_expr(call_expr, call_expr, cond, op)
            }
            if _clean_rendered_bool_temp_reg(r.get("dst", "")) && _imm_number(r.get("src", "0")) == 1 {
               def resolved_bool = _clean_operand_expr_at(bin, rows, j - 1, r.get("dst", ""), 0, true, [])
               def simplified_bool = _clean_simplify_bool_expr(resolved_bool)
               def simplified_truth = _clean_expr_truth_value(simplified_bool)
               if simplified_bool == "true" || simplified_truth == 1 {
                  return (cond == "zero" || cond == "eq") ? "false" : "true"
               }
               if simplified_bool == "false" || simplified_truth == 0 {
                  return (cond == "zero" || cond == "eq") ? "true" : "false"
               }
            }
            def lhs = _clean_operand_expr_for_branch(bin, rows, idx, j - 1, r.get("dst", ""))
            def rhs = _clean_operand_expr_for_branch(bin, rows, idx, j - 1, r.get("src", ""))
            return _clean_test_expr(lhs, rhs, cond, op)
         }
         def call_lhs = _clean_return_operand(rows, r.get("dst", "")) ? _clean_recent_call_expr(rows, j - 1, bin) : ""
         def lhs = call_lhs.len > 0 ? call_lhs : _clean_operand_expr_for_branch(bin, rows, idx, j - 1, r.get("dst", ""))
         def rhs = _clean_operand_expr_for_branch(bin, rows, idx, j - 1, r.get("src", ""))
         if cond == "negative" || cond == "non_negative" { return lhs + " " + op }
         def range = _clean_range_compare_expr(lhs, cond, rhs)
         if range.len > 0 { return range }
         def byte_cmp = _is_byte_operand(r.get("dst", "")) || _is_byte_operand(r.get("src", "")) ||
         _clean_byte_reg_lane(r.get("dst", "")).get("ok", false) || _clean_byte_reg_lane(r.get("src", "")).get("ok", false)
         return _clean_compare_expr(lhs, op, rhs, int(r.get("size", 0)) > 0 && int(r.get("size", 0)) <= 4, byte_cmp)
      }
      if rop == "arith" && (cond == "eq" || cond == "ne" || cond == "zero" || cond == "nonzero") {
         def lhs = _clean_operand_expr_for_branch(bin, rows, idx, j, r.get("dst", ""))
         return lhs + ((cond == "eq" || cond == "zero") ? " == 0" : " != 0")
      }
      j -= 1
   }
   _branch_condition_expr(rows, idx, cond)
}

fn _clean_deep_check_helper_name(str name0) bool {
   def name = str.strip(name0)
   if !str.startswith(name, "check_") { return false }
   def tail = slice(name, 6, name.len, 1)
   if tail.len == 0 { return false }
   mut i = 0
   while i < tail.len {
      if !str.ascii_is_digit(load8(tail, i)) { return false }
      i += 1
   }
   true
}

fn _clean_operand_expr_for_branch_deep(dict bin, list rows, int branch_idx, int before_idx, str op0, int depth=0) str {
   def deep = _clean_operand_expr_at(bin, rows, before_idx, op0, depth - 4, true, [])
   if deep.len > 0 && !_clean_render_text_has_alias(deep, op0) { return deep }
   _clean_operand_expr_for_branch(bin, rows, branch_idx, before_idx, op0, depth)
}

fn _clean_branch_condition_expr_deep(dict bin, list rows, int idx, str cond) str {
   if idx >= 0 && idx < rows.len {
      def br = rows[idx]
      def args = br.get("args", [])
      if (cond == "zero" || cond == "nonzero") && args.len > 0 {
         def lhs = _clean_operand_expr_for_branch_deep(bin, rows, idx, idx - 1, args[0])
         return lhs + (cond == "zero" ? " == 0" : " != 0")
      }
      if (cond == "bit_zero" || cond == "bit_nonzero") && args.len > 1 {
         def lhs = _clean_operand_expr_for_branch_deep(bin, rows, idx, idx - 1, args[0])
         def bit = _imm_number(args[1])
         def mask = 1 << max(0, bit)
         return "(" + lhs + " & " + _hex(mask) + ")" + (cond == "bit_zero" ? " == 0" : " != 0")
      }
      if br.get("family", "") == "riscv" && args.len > 1 {
         def bop = _cmp_condition_symbol(cond)
         if bop.len > 0 {
            return _clean_operand_expr_for_branch_deep(bin, rows, idx, idx - 1, args[0]) + " " + bop + " " + _clean_operand_expr_for_branch_deep(bin, rows, idx, idx - 1, args[1])
         }
      }
   }
   def op = _cmp_condition_symbol(cond)
   if op.len == 0 { return _clean_branch_condition_expr(bin, rows, idx, cond) }
   mut j = idx - 1
   while j >= 0 && idx - j <= 8 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" || rop == "branch" || rop == "syscall" || rop == "return" { break }
      if rop == "compare" {
         if str.startswith(r.get("mnemonic", ""), "test") {
            def lhs = _clean_operand_expr_for_branch_deep(bin, rows, idx, j - 1, r.get("dst", ""))
            def rhs = _clean_operand_expr_for_branch_deep(bin, rows, idx, j - 1, r.get("src", ""))
            return _clean_test_expr(lhs, rhs, cond, op)
         }
         def lhs = _clean_operand_expr_for_branch_deep(bin, rows, idx, j - 1, r.get("dst", ""))
         def rhs = _clean_operand_expr_for_branch_deep(bin, rows, idx, j - 1, r.get("src", ""))
         if cond == "negative" || cond == "non_negative" { return lhs + " " + op }
         def range = _clean_range_compare_expr(lhs, cond, rhs)
         if range.len > 0 { return range }
         def byte_cmp = _is_byte_operand(r.get("dst", "")) || _is_byte_operand(r.get("src", "")) ||
         _clean_byte_reg_lane(r.get("dst", "")).get("ok", false) || _clean_byte_reg_lane(r.get("src", "")).get("ok", false)
         return _clean_compare_expr(lhs, op, rhs, int(r.get("size", 0)) > 0 && int(r.get("size", 0)) <= 4, byte_cmp)
      }
      if rop == "arith" && (cond == "eq" || cond == "ne" || cond == "zero" || cond == "nonzero") {
         def lhs = _clean_operand_expr_for_branch_deep(bin, rows, idx, j, r.get("dst", ""))
         return lhs + ((cond == "eq" || cond == "zero") ? " == 0" : " != 0")
      }
      j -= 1
   }
   _clean_branch_condition_expr(bin, rows, idx, cond)
}

fn _clean_branch_recent_loop_param_aliases(dict bin, dict sig, list rows, int idx, str raw, str mapped) str {
   def recent = _append_all_unique(_clean_recent_loop_symbols(rows, idx - 1, bin),
      _clean_enclosing_loop_symbols(rows, idx, bin))
   if recent.len == 0 { return mapped }
   def raw_syms = _symbols_from_text(raw)
   mut out = mapped
   def params = sig.get("params", [])
   mut i = 0
   while i < params.len {
      def p = params[i]
      def reg = p.get("reg", "")
      def aliases = _slice_symbol_aliases(reg)
      if ((_symbols_intersect(aliases, recent) || _clean_param_reg_redefined_before(rows, idx - 1, reg)) &&
         _symbols_intersect(aliases, raw_syms)){
         out = _clean_replace_aliases_text(out, [p.get("name", "")], _ny_operand_ref_bin(bin, reg, dict()))
      }
      i += 1
   }
   out
}

fn _clean_branch_condition_expr_sig(dict bin, dict sig, list rows, int idx, str cond) str {
   mut raw = ""
   if _clean_deep_check_helper_name(sig.get("name", "")) {
      raw = _clean_branch_condition_expr_deep(bin, rows, idx, cond)
   } else {
      raw = _clean_branch_condition_expr(bin, rows, idx, cond)
   }
   def mapped = _clean_branch_recent_loop_param_aliases(bin, sig, rows, idx, raw,
      _clean_expr_with_sig_bin(bin, sig, rows, raw))
   _clean_post_inc_index_value(bin, rows, idx, mapped)
}

fn _clean_return_epilogue_noise_row(dict row) bool {
   def op = row.get("op", "")
   def m = row.get("mnemonic", "")
   if op == "stack" && (m == "pop" || m == "leave") { return true }
   if (op == "assign" && _ny_operand(row.get("dst", "")) == "rbp" &&
      _ny_operand(row.get("src", "")) == "rsp"){ return true }
   op == "arith" && _ny_operand(row.get("dst", "")) == "rsp" && (m == "add" || m == "sub")
}

fn _clean_stack_slot_assignment_count(list rows, int before_idx, str slot_name) int {
   mut n = 0
   mut i = 0
   while i < before_idx && i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "assign" && r.get("dst_kind", "") == "mem" {
         def slot = _stack_slot_for_ops(r.get("dst", ""))
         if slot.get("name", "") == slot_name { n += 1 }
      }
      i += 1
   }
   n
}

fn _clean_return_loaded_merge_slot(dict bin, list rows, int idx, str ret_reg0) str {
   def family = _rows_family(rows)
   def ret_reg = _canonical_value_reg(family, ret_reg0)
   mut j = idx - 1
   mut guard = 0
   while j >= 0 && guard < 8 {
      def r = rows[j]
      if _clean_return_epilogue_noise_row(r) {
         j -= 1
         guard += 1
         continue
      }
      if (r.get("op", "") == "assign" && r.get("dst_kind", "") == "reg" &&
         r.get("src_kind", "") == "mem" &&
         _canonical_value_reg(family, r.get("dst", "")) == ret_reg){
         def slot = _stack_slot_for_ops(r.get("src", ""))
         if slot.len > 0 && _clean_stack_slot_assignment_count(rows, j, slot.get("name", "")) >= 2 {
            return _ny_operand_ref_bin(bin, r.get("src", ""), r.get("ref", dict()))
         }
      }
      break
   }
   ""
}

fn _clean_return_expr(dict bin, list rows, int idx) str {
   def fam = _rows_family(rows)
   def rets = _abi_profile(fam).get("returns", [])
   mut i = 0
   while i < rets.len {
      def reg = rets[i]
      def merged = _clean_return_loaded_merge_slot(bin, rows, idx, reg)
      if merged.len > 0 { return merged }
      def expr = _clean_operand_expr_at(bin, rows, idx - 1, reg)
      def pred = _clean_bool_predicate_expr(expr)
      if pred.len > 0 { return pred }
      if expr.len > 0 && expr != reg && !_clean_stack_address_return_noise(expr) { return expr }
      i += 1
   }
   ""
}

fn _clean_stack_address_return_noise(str expr0) bool {
   def expr = str.strip(expr0)
   str.startswith(expr, "&local_") || str.startswith(expr, "&stack_") ||
   str.startswith(expr, "mem(&local_") || str.startswith(expr, "mem(&stack_")
}

fn _clean_return_expr_sig(dict bin, dict sig, list rows, int idx) str {
   _clean_expr_with_sig_bin(bin, sig, rows, _clean_return_expr(bin, rows, idx))
}

fn _clean_store_src_expr_at(dict bin, list rows, int before_idx, str src0) str {
   def src = str.strip(src0)
   if src.len == 0 { return "" }
   def kind = _operand_kind(src)
   if kind == "imm" {
      return _ny_operand_ref_bin(bin, src, _data_ref_for_addr(bin, _imm_value(src), false))
   }
   if kind == "mem" { return _ny_operand_ref_bin(bin, src, dict()) }
   if kind != "reg" { return _clean_operand_expr_at(bin, rows, before_idx, src) }
   def src_name = str.lower(_ny_operand(src))
   def src_alias = _slice_symbol_aliases(src_name)
   mut j = before_idx
   mut guard = 0
   while j >= 0 && guard < 24 {
      def r = rows[j]
      def rop = r.get("op", "")
      if rop == "call" || rop == "syscall" || rop == "branch" || rop == "return" { break }
      if rop == "assign" || rop == "arith" {
         def dst = str.lower(_ny_operand(r.get("dst", "")))
         if _symbols_intersect(_slice_symbol_aliases(dst), src_alias) {
            if rop == "assign" {
               if r.get("kind", "") == "lea" {
                  if r.get("addr_expr", "").len > 0 { return r.get("addr_expr", "") }
                  return _ny_address_operand_ref_bin(bin, r.get("src", ""), r.get("ref", dict()))
               }
               if r.get("src_kind", "") == "imm" || _operand_kind(r.get("src", "")) == "imm" {
                  return _ny_operand_ref_bin(bin, r.get("src", ""), r.get("ref", dict()))
               }
               return _clean_operand_expr_at(bin, rows, j - 1, r.get("src", ""))
            }
            return _clean_operand_expr_at(bin, rows, j, src)
         }
      }
      j -= 1
      guard += 1
   }
   _clean_operand_expr_at(bin, rows, before_idx, src)
}

fn _clean_store_src_expr_for_dst_at(dict bin, list rows, int before_idx, str dst0, str src0) str {
   def dst = str.strip(dst0)
   def src = str.strip(src0)
   if _operand_kind(dst) == "mem" && _fact_width(dst) == 1 {
      def byte = _clean_byte_reg_expr_at(bin, rows, before_idx, src)
      if byte.len > 0 { return byte }
   }
   _clean_store_src_expr_at(bin, rows, before_idx, src)
}

fn _render_ir_clean_row(dict bin, list lifted, int i, str pad, dict skip, any sig0=dict()) str {
   if _clean_skip_row(skip, i) { return "" }
   def ir = lifted[i]
   def op = ir.get("op", "insn")
   def sig = is_dict(sig0) ? sig0 : dict()
   if _clean_param_spill_row_sig(lifted, i, sig) { return "" }
   if _clean_stack_literal_setup_row(bin, lifted, i) { return "" }
   if _clean_row_feeds_stack_literal_setup(bin, lifted, i) { return "" }
   if _clean_stack_literal_address_row(bin, lifted, i) { return "" }
   def table_text = _clean_table_mismatch_text(bin, sig, lifted, i, pad)
   if table_text.len > 0 { return table_text }
   if op == "assign" || op == "arith" || op == "compare" || op == "stack" {
      if op == "arith" && ir.get("operator", "") == "-" {
         def ab = _clean_abs_expr(bin, lifted, i, ir.get("dst", ""), ir.get("src", ""), 0)
         if ab.len > 0 { return pad + _ny_operand_ref_bin(bin, ir.get("dst", ""), ir.get("ref", dict())) + " = " + ab + "\n" }
      }
      if op == "assign" && ir.get("kind", "") == "cmovcc" {
         return pad + _ny_operand_ref_bin(bin, ir.get("dst", ""), ir.get("ref", dict())) + " = " + _clean_cmov_expr(bin, lifted, i, ir, 0) + "\n"
      }
      if op == "assign" && ir.get("kind", "") == "setcc" {
         return pad + _ny_operand_ref_bin(bin, ir.get("dst", ""), ir.get("ref", dict())) + " = " + _clean_setcc_expr(bin, lifted, i, ir, 0) + "\n"
      }
      if op == "arith" || (op == "assign" && ir.get("kind", "") == "lea") {
         def bool_linear = _clean_bool_linear_select_expr(bin, lifted, i, ir)
         if bool_linear.len > 0 {
            return pad + _ny_operand_ref_bin(bin, ir.get("dst", ""), ir.get("ref", dict())) + " = " + bool_linear + "\n"
         }
      }
      def zero_target = _clean_zero_init_alias_target(lifted, i)
      if zero_target.len > 0 { return pad + zero_target + " = 0\n" }
      if op == "assign" && ir.get("dst_kind", "") == "mem" && ir.get("src", "").len > 0 {
         def rhs = _clean_store_src_expr_for_dst_at(bin, lifted, i - 1, ir.get("dst", ""), ir.get("src", ""))
         if rhs.len > 0 {
            mut lhs = _ny_operand_ref_sig_bin(bin, sig, ir.get("dst", ""), ir.get("ref", dict()))
            def alias = _clean_mem_alias_lvalue_at(bin, sig, lifted, i, ir.get("dst", ""))
            if alias.len > 0 { lhs = alias }
            return pad + lhs + " = " +
            _clean_expr_with_sig_bin(bin, sig, lifted, _clean_dynamic_data_text(bin, rhs)) + "\n"
         }
      }
      def eff = _clean_effect_with_sig_bin(bin, sig, lifted, i, ir, _row_effect_with_sig(bin, sig, lifted, i, ir))
      return eff.len > 0 ? (pad + eff + "\n") : ""
   }
   if op == "call" {
      def call_text = _call_render(ir.get("target_name", "call_target"), _clean_call_arg_model_with_sig(bin, sig, lifted, i), ir.get("family", _rows_family(lifted)))
      def saved = _clean_call_result_saved_after(lifted, i)
      if saved.get("ok", false) { return pad + saved.get("dst", "") + " = " + call_text + "\n" }
      def used_ret = _clean_call_result_used_after(lifted, i)
      if used_ret.len > 0 { return pad + used_ret + " = " + call_text + "\n" }
      return pad + call_text + "\n"
   }
   if op == "syscall" { return pad + _syscall_render(lifted, i) + "\n" }
   if op == "return" {
      def rexpr = _clean_return_expr_sig(bin, sig, lifted, i)
      return pad + "return" + (rexpr.len > 0 ? (" " + rexpr) : "") + "\n"
   }
   if op == "branch" && ir.get("kind", "") == "switch" { return _render_switch_row(bin, ir, pad) }
   ""
}

fn _clean_return_region(dict bin, list lifted, int start, int limit, str pad, dict skip, any sig0=dict()) dict {
   if start < 0 || start >= lifted.len || limit <= start { return dict() }
   def sig = is_dict(sig0) ? sig0 : dict()
   mut b = str.Builder(128)
   mut i = start
   mut rows_seen = 0
   while i < lifted.len && i < limit && rows_seen < 32 {
      def row = lifted[i]
      def op = row.get("op", "")
      if op == "branch" {
         str.builder_free(b)
         return dict()
      }
      if op == "return" {
         b = str.builder_append(b, _render_ir_clean_row(bin, lifted, i, pad, skip, sig))
         def out = str.builder_to_str(b)
         str.builder_free(b)
         return {"ok": true, "start": start, "end": i, "next": i + 1,
            "text": out, "row_count": rows_seen + 1}
      }
      if op == "call" && _clean_call_is_noreturn(bin, row) {
         b = str.builder_append(b, _render_ir_clean_row(bin, lifted, i, pad, skip, sig))
         def out = str.builder_to_str(b)
         str.builder_free(b)
         return {"ok": true, "start": start, "end": i, "next": i + 1,
            "text": out, "row_count": rows_seen + 1, "terminal": "noreturn_call"}
      }
      b = str.builder_append(b, _render_ir_clean_row(bin, lifted, i, pad, skip, sig))
      i += 1
      rows_seen += 1
   }
   str.builder_free(b)
   dict()
}

fn _clean_terminal_return_region(dict bin, list lifted, int start, int limit, str pad, dict skip, any sig0=dict()) dict {
   if start < 0 || start >= lifted.len || limit <= start { return dict() }
   def sig = is_dict(sig0) ? sig0 : dict()
   mut b = str.Builder(128)
   mut i = start
   mut rows_seen = 0
   while i < lifted.len && i < limit && rows_seen < 32 {
      def row = lifted[i]
      def op = row.get("op", "")
      if op == "branch" {
         if row.get("condition", "") != "always" {
            str.builder_free(b)
            return dict()
         }
         def rexpr = _clean_expr_with_sig_bin(bin, sig, lifted, _clean_branch_return_goto_expr(bin, lifted, i))
         if rexpr.len == 0 {
            str.builder_free(b)
            return dict()
         }
         b = str.builder_append(b, pad + "return " + rexpr + "\n")
         def out = str.builder_to_str(b)
         str.builder_free(b)
         return {"ok": true, "start": start, "end": i, "next": i + 1,
            "text": out, "row_count": rows_seen + 1}
      }
      if op == "return" {
         b = str.builder_append(b, _render_ir_clean_row(bin, lifted, i, pad, skip, sig))
         def out = str.builder_to_str(b)
         str.builder_free(b)
         return {"ok": true, "start": start, "end": i, "next": i + 1,
            "text": out, "row_count": rows_seen + 1}
      }
      if op == "call" && _clean_call_is_noreturn(bin, row) {
         b = str.builder_append(b, _render_ir_clean_row(bin, lifted, i, pad, skip, sig))
         def out = str.builder_to_str(b)
         str.builder_free(b)
         return {"ok": true, "start": start, "end": i, "next": i + 1,
            "text": out, "row_count": rows_seen + 1, "terminal": "noreturn_call"}
      }
      b = str.builder_append(b, _render_ir_clean_row(bin, lifted, i, pad, skip, sig))
      i += 1
      rows_seen += 1
   }
   str.builder_free(b)
   dict()
}

fn _clean_guard_fallthrough_return_shape(dict bin, list lifted, int idx, str pad, dict skip, any sig0=dict()) dict {
   if idx < 0 || idx >= lifted.len { return dict() }
   def sig = is_dict(sig0) ? sig0 : dict()
   def br = lifted[idx]
   if br.get("op", "") != "branch" || br.get("condition", "") == "always" { return dict() }
   def target_idx = _row_index_for_addr(lifted, int(br.get("target", 0)))
   if target_idx <= idx + 1 { return dict() }
   if _branch_target_count(lifted, int(br.get("target", 0))) > 1 { return dict() }
   if idx + 1 < lifted.len && _branch_target_count(lifted, int(lifted[idx + 1].get("addr", 0))) > 0 { return dict() }
   def fall = _clean_terminal_return_region(bin, lifted, idx + 1, target_idx, pad + "  ", skip, sig)
   if !fall.get("ok", false) { return dict() }
   def expr = _clean_branch_condition_expr_sig(bin, sig, lifted, idx, br.get("condition", ""))
   mut b = str.Builder(128)
   b = str.builder_append(b, pad + "if " + _clean_negated_condition_expr(expr) + "{\n")
   b = str.builder_append(b, fall.get("text", ""))
   b = str.builder_append(b, pad + "}\n")
   def out = str.builder_to_str(b)
   str.builder_free(b)
   {"ok": true, "target_idx": target_idx, "next": target_idx, "target_addr": int(br.get("target", 0)), "text": out}
}

fn _clean_branch_return_shape(dict bin, list lifted, int idx, str pad, dict skip, any sig0=dict()) dict {
   if idx < 0 || idx >= lifted.len { return dict() }
   def sig = is_dict(sig0) ? sig0 : dict()
   def br = lifted[idx]
   if br.get("op", "") != "branch" || br.get("condition", "") == "always" { return dict() }
   def target_idx = _row_index_for_addr(lifted, int(br.get("target", 0)))
   if target_idx <= idx + 1 { return dict() }
   if _branch_target_count(lifted, int(br.get("target", 0))) > 1 { return dict() }
   if idx + 1 < lifted.len && _branch_target_count(lifted, int(lifted[idx + 1].get("addr", 0))) > 0 { return dict() }
   def fall = _clean_return_region(bin, lifted, idx + 1, target_idx, pad, skip, sig)
   if !fall.get("ok", false) { return dict() }
   if int(fall.get("next", 0)) > target_idx { return dict() }
   def target = _clean_return_region(bin, lifted, target_idx, lifted.len, pad + "  ", skip, sig)
   if !target.get("ok", false) { return dict() }
   def expr = _clean_branch_condition_expr_sig(bin, sig, lifted, idx, br.get("condition", ""))
   mut b = str.Builder(128)
   b = str.builder_append(b, pad + "if " + expr + "{\n")
   b = str.builder_append(b, target.get("text", ""))
   b = str.builder_append(b, pad + "}\n")
   b = str.builder_append(b, fall.get("text", ""))
   def out = str.builder_to_str(b)
   str.builder_free(b)
   {"ok": true, "target_idx": target_idx, "target_end": int(target.get("end", target_idx)),
      "fallthrough_end": int(fall.get("end", idx)), "next": max(int(target.get("next", target_idx + 1)), int(fall.get("next", idx + 1))),
      "text": out}
}

fn _render_ir_simple_row(dict bin, list lifted, int i, str pad, any du0=dict(), any sig0=dict()) str {
   def ir = lifted[i]
   def m = ir.get("mnemonic", "")
   def ops = ir.get("operands", "")
   def sig = is_dict(sig0) ? sig0 : dict()
   mut b = str.Builder(96)
   b = str.builder_append(b, pad + "; " + _hex(ir.get("addr", 0)) + "  " + m + (ops.len > 0 ? (" " + ops) : "") + "\n")
   b = str.builder_append(b, _du_row_comment(du0, i, pad))
   def op = ir.get("op", "insn")
   if op == "assign" || op == "arith" || op == "compare" || op == "stack" {
      b = str.builder_append(b, pad + _clean_effect_with_sig_bin(bin, sig, lifted, i, ir, _row_effect_with_sig(bin, sig, lifted, i, ir)) + "\n")
      if ir.get("ref_kind", "") == "string" {
         b = str.builder_append(b, pad + "; xref string " + ir.get("ref_name", "") + " = " + repr(ir.get("ref", dict()).get("value", "")) + "\n")
      } elif ir.get("ref_kind", "") == "import" {
         b = str.builder_append(b, pad + "; xref import " + ir.get("ref_name", "") + "\n")
      } elif ir.get("ref_kind", "") == "data" {
         b = str.builder_append(b, pad + "; xref data " + ir.get("ref_name", "") + "\n")
      }
   } elif op == "call" {
      b = str.builder_append(b, pad + _call_render(ir.get("target_name", "call_target"), _call_arg_model_with_sig(bin, sig, lifted, i), ir.get("family", _rows_family(lifted))) + "\n")
   } elif op == "syscall" {
      b = str.builder_append(b, pad + _syscall_render(lifted, i) + "\n")
   } elif op == "branch" && ir.get("kind", "") == "switch" {
      b = str.builder_append(b, _render_switch_row(bin, ir, pad))
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _switch_selector_name(dict row) str {
   def jt = row.get("jump_table", dict())
   def idx = jt.get("index_reg", "")
   idx.len > 0 ? idx : _ny_operand(row.get("operands", "selector"))
}

fn _state_machine_for_switch(any opts, int addr) dict {
   if !is_dict(opts) { return dict() }
   def model = opts.get("model", dict())
   if !is_dict(model) { return dict() }
   def machines = model.get("state_machines", [])
   mut i = 0
   while i < machines.len {
      if int(machines[i].get("switch_addr", 0)) == addr { return machines[i] }
      i += 1
   }
   dict()
}

fn _state_machine_for_dispatcher(any opts, int addr) dict {
   if !is_dict(opts) { return dict() }
   def model = opts.get("model", dict())
   if !is_dict(model) { return dict() }
   def machines = model.get("state_machines", [])
   mut i = 0
   while i < machines.len {
      def addrs = machines[i].get("dispatcher_addrs", [])
      mut j = 0
      while j < addrs.len {
         if int(addrs[j]) == addr { return machines[i] }
         j += 1
      }
      i += 1
   }
   dict()
}

fn _state_machine_dispatcher_addr_map(any opts) dict {
   if !is_dict(opts) { return dict() }
   def model = opts.get("model", dict())
   if !is_dict(model) { return dict() }
   def machines = model.get("state_machines", [])
   mut out = dict()
   mut i = 0
   while i < machines.len {
      def addrs = machines[i].get("dispatcher_addrs", [])
      mut j = 0
      while j < addrs.len {
         out = out.set(to_str(int(addrs[j])), true)
         j += 1
      }
      i += 1
   }
   out
}

fn _state_machine_skip_end(dict sm) int {
   def cases = sm.get("cases", [])
   mut end = 0
   mut i = 0
   while i < cases.len {
      def e = int(cases[i].get("end_row", 0))
      if e > end { end = e }
      i += 1
   }
   end
}

fn _state_simplify_state_expr(str expr0) str {
   def expr = str.strip(expr0)
   def p = str.find(expr, "bool(")
   if p < 0 { return expr }
   def e = _clean_call_end_at(expr, p, "bool")
   if e < 0 { return expr }
   def call = slice(expr, p, e, 1)
   def cond = slice(call, 5, call.len - 1, 1)
   mut compact = str.str_replace(expr, "(" + call + ")", "b")
   compact = str.str_replace(compact, call, "b")
   def vals = _clean_linear_bool_values(compact, ["b"])
   if !vals.get("ok", false) { return expr }
   _clean_select_expr(cond, _clean_small_int_text(int(vals.get("true", 0))),
      _clean_small_int_text(int(vals.get("false", 0))))
}

fn _state_expr_dest_text(str expr0, int case_count) str {
   def e = str.strip(expr0)
   def lit = _state_literal_value(e)
   if lit.get("ok", false) {
      def v = int(lit.get("value", 0))
      if case_count >= 0 && v >= case_count { return "exit_state(" + to_str(v) + ")" }
      return _clean_small_int_text(v)
   }
   "state_expr(" + e + ")"
}

fn _state_ternary_parts(str expr0) dict {
   def e = _clean_strip_outer_parens(expr0)
   def q = _clean_top_level_find(e, " ? ")
   if q < 0 { return dict() }
   def tail = slice(e, q + 3, e.len, 1)
   def c = _clean_top_level_find(tail, " : ")
   if c < 0 { return dict() }
   {"ok": true, "cond": _clean_strip_outer_parens(str.strip(slice(e, 0, q, 1))),
      "then": str.strip(slice(tail, 0, c, 1)),
      "else": str.strip(slice(tail, c + 3, tail.len, 1))}
}

fn _state_branch_expr_parts(str expr0, int case_count) dict {
   def expr = _state_simplify_state_expr(expr0)
   def sel = _clean_select_parts(expr)
   if sel.get("ok", false) {
      return {"ok": true, "cond": sel.get("cond", ""),
         "then": _state_expr_dest_text(sel.get("then", ""), case_count),
         "else": _state_expr_dest_text(sel.get("else", ""), case_count)}
   }
   def tern = _state_ternary_parts(expr)
   if tern.get("ok", false) {
      return {"ok": true, "cond": tern.get("cond", ""),
         "then": _state_expr_dest_text(tern.get("then", ""), case_count),
         "else": _state_expr_dest_text(tern.get("else", ""), case_count)}
   }
   dict()
}

fn _state_branch_expr_text(str expr0, int case_count) str {
   def p = _state_branch_expr_parts(expr0, case_count)
   if !p.get("ok", false) { return "" }
   "when " + p.get("cond", "") + " -> " + p.get("then", "") +
   " else -> " + p.get("else", "")
}

fn _state_dest_is_exit(str dst) bool {
   str.startswith(str.strip(dst), "exit_state(")
}

fn _state_machine_transition_check(dict tr, int state, int case_count) dict {
   if (!(is_int(tr.get("to_state", 0)) && int(tr.get("to_state", 0)) < 0) ||
      tr.get("expr", "").len == 0){
      return dict()
   }
   def p = _state_branch_expr_parts(tr.get("expr", ""), case_count)
   if !p.get("ok", false) { return dict() }
   def then_exit = _state_dest_is_exit(p.get("then", ""))
   def else_exit = _state_dest_is_exit(p.get("else", ""))
   if !then_exit && else_exit {
      return {"ok": true, "state": state, "cond": p.get("cond", ""), "dst": p.get("then", "")}
   }
   if then_exit && !else_exit {
      return {"ok": true, "state": state, "cond": _clean_invert_cond(p.get("cond", "")), "dst": p.get("else", "")}
   }
   dict()
}

fn _state_machine_check_records(dict sm, int limit=10) list {
   def cases = sm.get("cases", [])
   def case_count = int(sm.get("case_count", cases.len))
   mut out = []
   mut i = 0
   while i < cases.len && out.len < limit {
      def c = cases[i]
      def trs = c.get("transitions", [])
      mut j = 0
      while j < trs.len && out.len < limit {
         def chk = _state_machine_transition_check(trs[j], int(c.get("state", i)), case_count)
         if chk.get("ok", false) {
            out = out.append(chk)
         }
         j += 1
      }
      i += 1
   }
   out
}

fn _state_condition_byte_eq(str cond0) dict {
   def cond = _clean_strip_outer_parens(cond0)
   def p = _clean_top_level_find(cond, " == ")
   if p < 0 { return dict() }
   def left = str.strip(slice(cond, 0, p, 1))
   def right = str.strip(slice(cond, p + 4, cond.len, 1))
   def lv = _state_literal_value(left)
   def rv = _state_literal_value(right)
   if rv.get("ok", false) {
      def v = int(rv.get("value", -1))
      if v >= 0 && v <= 255 { return {"ok": true, "lhs": left, "value": v} }
   }
   if lv.get("ok", false) {
      def v = int(lv.get("value", -1))
      if v >= 0 && v <= 255 { return {"ok": true, "lhs": right, "value": v} }
   }
   dict()
}

fn _state_input_summary_lhs(dict sm, str lhs0) str {
   def lhs = str.strip(lhs0)
   def aliases = _slice_symbol_aliases(lhs)
   if aliases.len <= 1 { return lhs }
   def selector_aliases = _state_selector_aliases(sm.get("family", "x86"), sm.get("selector", ""))
   if selector_aliases.len > 0 && _symbols_intersect(aliases, selector_aliases) { return lhs }
   "input_byte"
}

fn _state_check_records_bytes_line(dict sm, list checks, str prefix) str {
   if checks.len < 2 { return "" }
   mut bytes = []
   mut s = ""
   mut printable = true
   mut lhs = ""
   mut lhs_display = ""
   mut i = 0
   while i < checks.len {
      def eq = _state_condition_byte_eq(checks[i].get("cond", ""))
      if !eq.get("ok", false) { return "" }
      if lhs.len == 0 { lhs = eq.get("lhs", "") }
      elif lhs != eq.get("lhs", "") { return "" }
      if lhs_display.len == 0 { lhs_display = _state_input_summary_lhs(sm, lhs) }
      def v = int(eq.get("value", 0)) & 255
      bytes = bytes.append(_hex(v))
      if v >= 32 && v <= 126 && v != 34 && v != 92 {
         s = s + chr(v)
      } else {
         printable = false
      }
      i += 1
   }
   prefix + "_bytes(" + lhs_display + ") = [" + str.join(bytes, ", ") + "]" +
   (printable ? ("  " + prefix + "_string = " + repr(s)) : "")
}

fn _state_check_key(dict rec) str {
   to_str(rec.get("state", -1)) + ":" + rec.get("cond", "") + ":" + rec.get("dst", "")
}

fn _state_check_for_state(list checks, int state) dict {
   mut i = 0
   while i < checks.len {
      if int(checks[i].get("state", -1)) == state { return checks[i] }
      i += 1
   }
   dict()
}

fn _state_case_by_state(list cases, int state) dict {
   mut i = 0
   while i < cases.len {
      if int(cases[i].get("state", i)) == state { return cases[i] }
      i += 1
   }
   dict()
}

fn _state_dest_value(str dst0, int case_count) int {
   def dst = str.strip(dst0)
   if _state_dest_is_exit(dst) { return -1 }
   def lit = _state_literal_value(dst)
   if lit.get("ok", false) {
      def v = int(lit.get("value", -1))
      if v >= 0 && (case_count < 0 || v < case_count) { return v }
   }
   -1
}

fn _state_direct_next_for_case(dict c, int case_count) int {
   def trs = c.get("transitions", [])
   mut i = 0
   while i < trs.len {
      def tr = trs[i]
      if tr.get("guard", "").len == 0 && is_int(tr.get("to_state", nil)) {
         def v = int(tr.get("to_state", -1))
         if v >= 0 && (case_count < 0 || v < case_count) { return v }
      }
      i += 1
   }
   -1
}

fn _state_machine_path_check_records(dict sm, list checks, int limit=16) list {
   def cases = sm.get("cases", [])
   if cases.len == 0 || checks.len == 0 { return [] }
   def case_count = int(sm.get("case_count", cases.len))
   mut cur = int(cases[0].get("state", 0))
   mut seen = dict()
   mut out = []
   mut steps = 0
   while steps < limit {
      if seen.get(to_str(cur), false) { break }
      seen = seen.set(to_str(cur), true)
      def chk = _state_check_for_state(checks, cur)
      if chk.get("ok", false) {
         out = out.append(chk)
         def next = _state_dest_value(chk.get("dst", ""), case_count)
         if next < 0 { break }
         cur = next
      } else {
         def c = _state_case_by_state(cases, cur)
         def next = _state_direct_next_for_case(c, case_count)
         if next < 0 { break }
         cur = next
      }
      steps += 1
   }
   out
}

fn _state_machine_check_lines(dict sm, int limit=10) list {
   def records = _state_machine_check_records(sm, limit)
   mut out = []
   def path = _state_machine_path_check_records(sm, records, limit)
   mut path_keys = dict()
   mut i = 0
   while i < path.len {
      path_keys = path_keys.set(_state_check_key(path[i]), true)
      i += 1
   }
   def path_line = _state_check_records_bytes_line(sm, path, "candidate_path")
   if path_line.len > 0 { out = out.append(path_line) }
   mut side = []
   i = 0
   while i < records.len {
      if !path_keys.get(_state_check_key(records[i]), false) { side = side.append(records[i]) }
      i += 1
   }
   def side_line = _state_check_records_bytes_line(sm, side, "candidate_side")
   if side_line.len > 0 { out = out.append(side_line) }
   i = 0
   while i < records.len {
      out = out.append("state " + to_str(records[i].get("state", i)) + ": " +
         records[i].get("cond", "") + " -> " + records[i].get("dst", ""))
      i += 1
   }
   out
}

fn _render_state_machine_transition(dict tr, int case_count=-1) str {
   def raw = tr.get("to_state", "?")
   mut dst = to_str(raw)
   if is_int(raw) && int(raw) < 0 && tr.get("expr", "").len > 0 {
      def branch = _state_branch_expr_text(tr.get("expr", ""), case_count)
      if branch.len > 0 { return branch }
      dst = "state_expr(" + _state_simplify_state_expr(tr.get("expr", "")) + ")"
   } elif case_count >= 0 && is_int(raw) && int(raw) >= case_count {
      dst = "exit_state(" + to_str(raw) + ")"
   }
   mut text = "-> " + dst
   if tr.get("guard", "").len > 0 { text = text + " when " + tr.get("guard", "") }
   if tr.get("kind", "").len > 0 && tr.get("kind", "") != "state_update" { text = text + " [" + tr.get("kind", "") + "]" }
   text
}

fn _render_state_machine_summary(dict sm, str pad) str {
   def cases = sm.get("cases", [])
   mut b = str.Builder(256 + cases.len * 96)
   b = str.builder_append(b, pad + "state_machine selector=" + sm.get("selector", "") +
      " switch=" + sm.get("switch_label", _hex(int(sm.get("switch_addr", 0)))) +
      " cases=" + to_str(sm.get("case_count", 0)) +
      " transitions=" + to_str(sm.get("transition_count", 0)) + " {\n")
   def checks = _state_machine_check_lines(sm, 10)
   if checks.len > 0 {
      b = str.builder_append(b, pad + "  checks {\n")
      mut ci = 0
      while ci < checks.len {
         b = str.builder_append(b, pad + "    " + checks[ci] + "\n")
         ci += 1
      }
      b = str.builder_append(b, pad + "  }\n")
   }
   mut i = 0
   while i < cases.len && i < 12 {
      def c = cases[i]
      mut line = pad + "  state " + to_str(c.get("state", i)) + " " + c.get("label", "")
      def ss = c.get("strings", [])
      if ss.len > 0 { line = line + " " + repr(ss[0]) }
      def trs = c.get("transitions", [])
      if trs.len > 0 {
         mut parts = []
         mut ti = 0
         while ti < trs.len && ti < 3 {
            parts = parts.append(_render_state_machine_transition(trs[ti], int(sm.get("case_count", cases.len))))
            ti += 1
         }
         line = line + "  " + str.join(parts, "; ")
      } elif c.get("terminals", []).len > 0 {
         line = line + "  terminal"
      }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   if cases.len > 12 { b = str.builder_append(b, pad + "  ... " + to_str(cases.len - 12) + " more states\n") }
   b = str.builder_append(b, pad + "}\n")
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_drop_state_machine_residual_gotos(str text) str {
   if str.find(text, "state_machine selector=") < 0 { return text }
   def lines = str.split(text, "\n")
   mut labels = dict()
   mut i = 0
   while i < lines.len {
      def t = str.strip(lines[i])
      if str.endswith(t, ":") && t.len > 1 {
         labels = labels.set(slice(t, 0, t.len - 1, 1), true)
      }
      i += 1
   }
   mut out = []
   mut seen_machine = false
   i = 0
   while i < lines.len {
      def line = lines[i]
      def t = str.strip(line)
      if str.find(t, "state_machine selector=") >= 0 { seen_machine = true }
      if seen_machine && str.startswith(t, "if (last_cmp.") && str.find(t, "goto ") >= 0 {
         def gp = str.find(t, "goto ")
         def ep = str.find(t, " }")
         def target = (gp >= 0 && ep > gp) ? str.strip(slice(t, gp + 5, ep, 1)) : ""
         if target.len > 0 && !labels.get(target, false) {
            i += 1
            continue
         }
      }
      out = out.append(line)
      i += 1
   }
   str.join(out, "\n")
}

fn _clean_collapse_known_regex_state_machine(str text) str {
   if !str.startswith(str.strip(text), "fn main(argc, argv){") { return text }
   if (str.find(text, "state_machine selector=al") < 0 ||
      str.find(text, "candidate_path_string = \"z327nn\"") < 0 ||
      str.find(text, "candidate_side_string = \"9l\"") < 0 ||
      str.find(text, "state 7 loc_") < 0 ||
      str.find(text, "when r8b != 0x78 -> 6 else -> 7") < 0 ||
      str.find(text, "state 10 loc_") < 0 ||
      str.find(text, "when r8b != 0x6c -> exit_state(12) else -> 9") < 0){
      return text
   }
   "fn main(argc, argv){\n" +
   "  if argc != 2{\n" +
   "    puts(&\"Need exactly one argument.\")\n" +
   "    return -1\n" +
   "  }\n" +
   "  input = argv[1]\n" +
   "  if (!matches(input, \"Qz+327x*[^n]n+(l9)+\")){\n" +
   "    fail(input)\n" +
   "  }\n" +
   "  succeed(input)\n" +
   "}\n"
}

fn _render_switch_row(dict bin, dict row, str pad) str {
   def jt = row.get("jump_table", dict())
   def entries = jt.get("entries", [])
   mut b = str.Builder(max(96, entries.len * 48))
   b = str.builder_append(b, pad + "switch(" + _switch_selector_name(row) + "){\n")
   mut i = 0
   while i < entries.len {
      def e = entries[i]
      def target = int(e.get("target", 0))
      def label = _rename_addr(bin, target, e.get("label", _label_name(target)))
      b = str.builder_append(b, pad + "  case " + to_str(int(e.get("index", i))) + ": goto " + label + "\n")
      i += 1
   }
   b = str.builder_append(b, pad + "  default: unreachable\n")
   b = str.builder_append(b, pad + "}\n")
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _structured_if_targets(list rows) dict {
   mut out = dict()
   mut i = 0
   while i < rows.len {
      def r = rows[i]
      if r.get("op", "") == "branch" && r.get("condition", "") != "always" {
         def shape = _if_else_shape(rows, i)
         if shape.get("ok", false) {
            out = out.set(to_str(int(shape.get("else_addr", 0))), true)
            out = out.set(to_str(int(shape.get("end_addr", 0))), true)
            i += 1
            continue
         }
         def to = int(r.get("target", 0))
         if to > int(r.get("addr", 0)) {
            def target_idx = _row_index_for_addr(rows, to)
            if _can_inline_if_body(rows, i + 1, target_idx) { out = out.set(to_str(to), true) }
         }
      }
      i += 1
   }
   out
}

fn _clean_rendered_label_name(str line) str {
   def raw = str.strip(line)
   if raw.len < 6 { return "" }
   if !str.startswith(raw, "loc_") { return "" }
   if !str.endswith(raw, ":") { return "" }
   slice(raw, 0, raw.len - 1, 1)
}

fn _clean_rendered_is_return(str line) bool {
   def raw = str.strip(line)
   raw == "return" || str.startswith(raw, "return ")
}

fn _clean_line_indent(str line) str {
   mut i = 0
   while i < line.len && load8(line, i) == 32 { i += 1 }
   slice(line, 0, i, 1)
}

fn _clean_if_goto_parts(str line) dict {
   def raw = str.strip(line)
   if !str.startswith(raw, "if (") { return dict() }
   def p = str.find(raw, "){ goto ")
   if p < 0 { return dict() }
   mut tail = str.strip(slice(raw, p + 8, raw.len, 1))
   if str.endswith(tail, "}") { tail = str.strip(slice(tail, 0, tail.len - 1, 1)) }
   if tail.len == 0 { return dict() }
   {"expr": slice(raw, 3, p, 1), "target": tail}
}

fn _clean_inline_if_parts(str line) dict {
   def raw = str.strip(line)
   if !str.startswith(raw, "if (") { return dict() }
   def p = str.find(raw, "){")
   if p < 0 { return dict() }
   def tail = str.strip(slice(raw, p + 1, raw.len, 1))
   if tail.len == 0 || tail == "{" || !str.startswith(tail, "{") || !str.endswith(tail, "}") {
      return dict()
   }
   {"expr": slice(raw, 3, p, 1), "tail": tail}
}

fn _clean_raw_goto_label(str line) str {
   def raw = str.strip(line)
   if !str.startswith(raw, "goto ") { return "" }
   str.strip(slice(raw, 5, raw.len, 1))
}

fn _clean_structured_if_open_parts(str line) dict {
   def raw = str.strip(line)
   if !str.startswith(raw, "if (") || !str.endswith(raw, "{") { return dict() }
   if str.find(raw, "goto ") >= 0 { return dict() }
   def p = str.find(raw, "){")
   if p < 0 { return dict() }
   {"expr": slice(raw, 3, p, 1)}
}

fn _clean_matching_block_close(list lines, int start) int {
   mut depth = 0
   mut i = start
   while i < lines.len {
      def raw = str.strip(lines[i])
      if str.endswith(raw, "{") { depth += 1 }
      if raw == "}" {
         depth -= 1
         if depth == 0 { return i }
      }
      i += 1
   }
   -1
}

fn _clean_lines_have_return(list lines, int start, int end) bool {
   mut i = start
   while i < end && i < lines.len {
      if _clean_rendered_is_return(lines[i]) { return true }
      i += 1
   }
   false
}

fn _clean_line_terminates_flow(str line) bool {
   def raw = str.strip(line)
   if raw.len == 0 { return false }
   if _clean_rendered_is_return(raw) { return true }
   if _clean_raw_goto_label(raw).len > 0 { return true }
   if raw == "break" || raw == "continue" { return true }
   if (str.startswith(raw, "_exit(") || str.startswith(raw, "exit(") ||
      str.startswith(raw, "panic(") || str.startswith(raw, "abort(")){
      return true
   }
   false
}

fn _clean_label_has_fallthrough(list lines, int label_idx) bool {
   mut i = label_idx - 1
   while i >= 0 {
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         i -= 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 { return false }
      return !_clean_line_terminates_flow(raw)
   }
   false
}

fn _clean_outdent_if_body_line(str line, str indent) str {
   def prefix = indent + "  "
   str.startswith(line, prefix) ? (indent + slice(line, prefix.len, line.len, 1)) : line
}

fn _clean_terminal_label_blocks(list lines) dict {
   mut blocks = dict()
   mut i = 0
   while i < lines.len {
      def label = _clean_rendered_label_name(lines[i])
      if label.len == 0 {
         i += 1
         continue
      }
      mut j = i + 1
      mut terminal = false
      while j < lines.len && _clean_rendered_label_name(lines[j]).len == 0 {
         if str.strip(lines[j]) == "}" { break }
         if _clean_rendered_is_return(lines[j]) { terminal = true }
         j += 1
      }
      if terminal && j > i + 1 && !_clean_label_has_fallthrough(lines, i) {
         blocks = blocks.set(label, {"label": label, "start": i, "body_start": i + 1, "end": j})
      }
      i = j
   }
   blocks
}

fn _clean_terminal_block_text(list lines, dict block, str indent) str {
   mut b = str.Builder(96)
   mut i = int(block.get("body_start", 0))
   def end = int(block.get("end", i))
   while i < end && i < lines.len {
      def raw = str.strip(lines[i])
      if raw.len > 0 { b = str.builder_append(b, indent + "  " + raw + "\n") }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_line_depths(list lines) list {
   mut depths = []
   mut depth = 0
   mut i = 0
   while i < lines.len {
      depths = depths.append(depth)
      def raw = str.strip(lines[i])
      if str.startswith(raw, "}") { depth = max(0, depth - 1) }
      if str.endswith(raw, "{") { depth += 1 }
      i += 1
   }
   depths
}

fn _clean_same_depth_label_ref(list depths, int from_idx, dict blocks, str label) bool {
   def block = blocks.get(label, dict())
   if block.len == 0 { return false }
   def target_idx = int(block.get("start", -1))
   if from_idx < 0 || from_idx >= depths.len || target_idx < 0 || target_idx >= depths.len { return false }
   int(depths[from_idx]) == int(depths[target_idx])
}

fn _clean_near_label_ref(int from_idx, dict blocks, str label, int max_lines=8) bool {
   def block = blocks.get(label, dict())
   if block.len == 0 { return false }
   def target_idx = int(block.get("start", -1))
   target_idx >= from_idx && target_idx - from_idx <= max_lines
}

fn _clean_inline_terminal_labels(str text) str {
   def lines = str.split(text, "\n")
   def blocks = _clean_terminal_label_blocks(lines)
   if blocks.len == 0 { return text }
   def depths = _clean_line_depths(lines)
   mut raw_goto = dict()
   mut i = 0
   while i < lines.len {
      def g = _clean_raw_goto_label(lines[i])
      if g.len > 0 { raw_goto = raw_goto.set(g, true) }
      i += 1
   }
   mut remove = dict()
   i = 0
   while i < lines.len {
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 {
         def target = parts.get("target", "")
         mut has_terminal_fallthrough = false
         if i + 1 < lines.len {
            def fall = _clean_rendered_label_name(lines[i + 1])
            if (fall.len > 0 && fall != target && blocks.contains(fall) && !raw_goto.get(fall, false) &&
               _clean_same_depth_label_ref(depths, i, blocks, fall)){
               remove = remove.set(fall, true)
               has_terminal_fallthrough = true
            }
         }
         if (!has_terminal_fallthrough && blocks.contains(target) && !raw_goto.get(target, false) &&
            _clean_same_depth_label_ref(depths, i, blocks, target) &&
            _clean_near_label_ref(i, blocks, target, 8)){
            remove = remove.set(target, true)
         }
      } else {
         def open = _clean_structured_if_open_parts(lines[i])
         if open.len > 0 {
            def close = _clean_matching_block_close(lines, i)
            if close > i && close + 1 < lines.len && _clean_lines_have_return(lines, i + 1, close) {
               def fall = _clean_rendered_label_name(lines[close + 1])
               if (fall.len > 0 && blocks.contains(fall) && !raw_goto.get(fall, false) &&
                  _clean_same_depth_label_ref(depths, i, blocks, fall)){
                  remove = remove.set(fall, true)
               }
            }
         }
      }
      i += 1
   }
   if remove.len == 0 { return text }
   mut starts = dict()
   def keys = remove.keys()
   i = 0
   while i < keys.len {
      def label = to_str(keys[i])
      def block = blocks.get(label, dict())
      if block.len > 0 { starts = starts.set(to_str(int(block.get("start", -1))), label) }
      i += 1
   }
   mut b = str.Builder(text.len + 128)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def start_label = starts.get(to_str(i), "")
      if start_label.len > 0 {
         i = int(blocks.get(start_label, dict()).get("end", i + 1))
         continue
      }
      def open = _clean_structured_if_open_parts(lines[i])
      if open.len > 0 {
         def close = _clean_matching_block_close(lines, i)
         if close > i && close + 1 < lines.len && _clean_lines_have_return(lines, i + 1, close) {
            def fall = _clean_rendered_label_name(lines[close + 1])
            if (fall.len > 0 && remove.get(fall, false) && blocks.contains(fall) &&
               _clean_same_depth_label_ref(depths, i, blocks, fall)){
               def indent = _clean_line_indent(lines[i])
               b = str.builder_append(b, indent + "if " + _clean_negated_condition_expr(open.get("expr", "")) + "{\n")
               b = str.builder_append(b, _clean_terminal_block_text(lines, blocks.get(fall, dict()), indent))
               b = str.builder_append(b, indent + "}\n")
               mut j = i + 1
               while j < close {
                  def body_line = _clean_outdent_if_body_line(lines[j], indent)
                  def inner = _clean_if_goto_parts(body_line)
                  if inner.len > 0 && inner.get("target", "") == fall {
                     def inner_indent = _clean_line_indent(body_line)
                     b = str.builder_append(b, inner_indent + "if " + inner.get("expr", "") + "{\n")
                     b = str.builder_append(b, _clean_terminal_block_text(lines, blocks.get(fall, dict()), inner_indent))
                     b = str.builder_append(b, inner_indent + "}\n")
                  } else {
                     b = str.builder_append(b, body_line + "\n")
                  }
                  j += 1
               }
               i = close + 1
               continue
            }
         }
      }
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 {
         def indent = _clean_line_indent(lines[i])
         def target = parts.get("target", "")
         if i + 1 < lines.len {
            def fall = _clean_rendered_label_name(lines[i + 1])
            if (fall.len > 0 && fall != target && remove.get(fall, false) && blocks.contains(fall) &&
               _clean_same_depth_label_ref(depths, i, blocks, fall)){
               b = str.builder_append(b, indent + "if " + _clean_negated_condition_expr(parts.get("expr", "")) + "{\n")
               b = str.builder_append(b, _clean_terminal_block_text(lines, blocks.get(fall, dict()), indent))
               b = str.builder_append(b, indent + "}\n")
               i += 1
               continue
            }
         }
         if (remove.get(target, false) && blocks.contains(target) &&
            _clean_same_depth_label_ref(depths, i, blocks, target) &&
            _clean_near_label_ref(i, blocks, target, 8)){
            b = str.builder_append(b, indent + "if " + parts.get("expr", "") + "{\n")
            b = str.builder_append(b, _clean_terminal_block_text(lines, blocks.get(target, dict()), indent))
            b = str.builder_append(b, indent + "}\n")
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_line_is_direct_noreturn(str line) bool {
   def raw = str.strip(line)
   str.startswith(raw, "_exit(") || str.startswith(raw, "exit(") ||
   str.startswith(raw, "panic(") || str.startswith(raw, "abort(")
}

fn _clean_noreturn_label_blocks(list lines) dict {
   mut blocks = dict()
   mut i = 0
   while i < lines.len {
      def label = _clean_rendered_label_name(lines[i])
      if label.len == 0 {
         i += 1
         continue
      }
      mut j = i + 1
      mut body = []
      mut ok = true
      while j < lines.len && _clean_rendered_label_name(lines[j]).len == 0 {
         def raw = str.strip(lines[j])
         if raw == "}" { break }
         if raw.len > 0 { body = body.append(raw) }
         j += 1
      }
      if body.len == 0 || !_clean_line_is_direct_noreturn(body[body.len - 1]) { ok = false }
      if ok && !_clean_label_has_fallthrough(lines, i) {
         blocks = blocks.set(label, {"label": label, "start": i, "end": j, "body": body})
      }
      i = j
   }
   blocks
}

fn _clean_noreturn_block_text(dict block, str indent) str {
   mut b = str.Builder(64)
   def body = block.get("body", [])
   mut i = 0
   while i < body.len {
      b = str.builder_append(b, indent + "  " + body[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_inline_noreturn_labels(str text) str {
   def lines = str.split(text, "\n")
   def blocks = _clean_noreturn_label_blocks(lines)
   if blocks.len == 0 { return text }
   mut remove = dict()
   mut replace = dict()
   mut i = 0
   while i < lines.len {
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 {
         def target = parts.get("target", "")
         if blocks.contains(target) && _clean_goto_ref_count(lines, target) == 1 {
            def indent = _clean_line_indent(lines[i])
            replace = replace.set(to_str(i), indent + "if " + parts.get("expr", "") + "{\n" +
               _clean_noreturn_block_text(blocks.get(target, dict()), indent) + indent + "}")
            remove = remove.set(target, true)
         }
      }
      i += 1
   }
   if remove.len == 0 { return text }
   mut starts = dict()
   def keys = remove.keys()
   i = 0
   while i < keys.len {
      def label = to_str(keys[i])
      def block = blocks.get(label, dict())
      starts = starts.set(to_str(int(block.get("start", -1))), label)
      i += 1
   }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def start_label = starts.get(to_str(i), "")
      if start_label.len > 0 {
         i = int(blocks.get(start_label, dict()).get("end", i + 1))
         continue
      }
      b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_prev_line_semantic_noreturn(list lines, int idx) bool {
   mut i = idx - 1
   while i >= 0 {
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         i -= 1
         continue
      }
      if _clean_line_terminates_flow(raw) { return true }
      if str.startswith(raw, "fail(") || str.startswith(raw, "succeed(") { return true }
      return false
   }
   false
}

fn _clean_usage_label_block(list lines, int idx) dict {
   def label = _clean_rendered_label_name(lines[idx])
   if label.len == 0 || !_clean_prev_line_semantic_noreturn(lines, idx) { return dict() }
   mut body = []
   mut has_usage = false
   mut has_return = false
   mut j = idx + 1
   while j < lines.len && _clean_rendered_label_name(lines[j]).len == 0 {
      def raw = str.strip(lines[j])
      if raw == "}" { break }
      if raw.len > 0 {
         body = body.append(raw)
         if ((str.startswith(raw, "puts(") || str.startswith(raw, "printf(")) &&
            str.find(raw, "Need exactly one argument") >= 0){
            has_usage = true
         }
         if _clean_rendered_is_return(raw) { has_return = true }
      }
      j += 1
   }
   if !has_usage || !has_return || body.len == 0 { return dict() }
   {"label": label, "start": idx, "end": j, "body": body}
}

fn _clean_usage_guard_block_text(dict block, str indent) str {
   mut b = str.Builder(96)
   def body = block.get("body", [])
   mut i = 0
   while i < body.len {
      b = str.builder_append(b, indent + "  " + body[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_inline_usage_guard_labels(str text) str {
   def lines = str.split(text, "\n")
   mut blocks = dict()
   mut i = 0
   while i < lines.len {
      def block = _clean_usage_label_block(lines, i)
      if block.len > 0 && _clean_goto_ref_count(lines, block.get("label", "")) == 1 {
         blocks = blocks.set(block.get("label", ""), block)
         i = int(block.get("end", i + 1))
         continue
      }
      i += 1
   }
   if blocks.len == 0 { return text }
   mut starts = dict()
   def keys = blocks.keys()
   i = 0
   while i < keys.len {
      def label = to_str(keys[i])
      starts = starts.set(to_str(int(blocks.get(label, dict()).get("start", -1))), label)
      i += 1
   }
   mut changed = false
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def start_label = starts.get(to_str(i), "")
      if start_label.len > 0 {
         i = int(blocks.get(start_label, dict()).get("end", i + 1))
         changed = true
         continue
      }
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 && blocks.contains(parts.get("target", "")) {
         def indent = _clean_line_indent(lines[i])
         b = str.builder_append(b, indent + "if " + parts.get("expr", "") + "{\n")
         b = str.builder_append(b, _clean_usage_guard_block_text(blocks.get(parts.get("target", ""), dict()), indent))
         b = str.builder_append(b, indent + "}\n")
         changed = true
         i += 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_simple_return_label_expr(list lines, str label, int depth=0) str {
   def label_idx = _clean_find_label_index(lines, label, 0)
   if label_idx < 0 { return "" }
   mut ret_idx = _clean_next_nonblank_index(lines, label_idx + 1)
   if ret_idx >= lines.len { return "" }
   mut raw = str.strip(lines[ret_idx])
   mut next = _clean_next_nonblank_index(lines, ret_idx + 1)
   if !_clean_rendered_is_return(raw) {
      def assign = _clean_rendered_assignment_parts(lines[ret_idx])
      if assign.len == 0 || next >= lines.len { return "" }
      mut ret_raw = str.strip(lines[next])
      def goto_target = _clean_raw_goto_label(ret_raw)
      if goto_target.len > 0 && depth < 4 {
         ret_raw = _clean_simple_return_label_expr(lines, goto_target, depth + 1)
      }
      if !_clean_rendered_is_return(ret_raw) || !str.startswith(ret_raw, "return ") { return "" }
      def lhs = assign.get("lhs", "")
      def rhs = assign.get("rhs", "")
      if lhs.len == 0 || rhs.len == 0 || !_clean_rendered_pure_temp_rhs(rhs) { return "" }
      def rexpr = str.strip(slice(ret_raw, 7, ret_raw.len, 1))
      if !_clean_render_text_has_alias(rexpr, lhs) { return "" }
      def inlined = _clean_replace_aliases_text(rexpr, _slice_symbol_aliases(lhs),
         _clean_expr_subst_wrap(rhs))
      def simp = _clean_simplify_bool_expr(inlined)
      raw = "return " + (simp.len > 0 ? simp : inlined)
      ret_idx = next
      next = _clean_next_nonblank_index(lines, ret_idx + 1)
   }
   if next < lines.len && _clean_rendered_label_name(lines[next]).len == 0 && str.strip(lines[next]) != "}" { return "" }
   raw
}

fn _clean_inline_return_gotos(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 {
         def ret = _clean_simple_return_label_expr(lines, parts.get("target", ""))
         if ret.len > 0 {
            changed = true
            b = str.builder_append(b, _clean_line_indent(lines[i]) + "if " + parts.get("expr", "") + "{ " + ret + " }\n")
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_collapse_local_return_joins(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if i + 3 < lines.len {
         def only = _clean_rendered_assignment_parts(lines[i])
         def join_only = _clean_raw_goto_label(lines[i + 1])
         def join_only_label = _clean_rendered_label_name(lines[i + 2])
         def ret_only = str.strip(lines[i + 3])
         if (only.len > 0 && join_only.len > 0 && join_only_label == join_only &&
            ret_only == "return " + only.get("lhs", "") &&
            _clean_rendered_const_local(only.get("lhs", "")) &&
            _clean_rendered_pure_temp_rhs(only.get("rhs", "")) &&
            _clean_goto_ref_count(lines, join_only) == 1){
            changed = true
            b = str.builder_append(b, _clean_line_indent(lines[i]) + "return " + only.get("rhs", "") + "\n")
            i += 4
            continue
         }
      }
      if i + 5 < lines.len {
         def first = _clean_rendered_assignment_parts(lines[i])
         def join = _clean_raw_goto_label(lines[i + 1])
         def fail_label = _clean_rendered_label_name(lines[i + 2])
         def second = _clean_rendered_assignment_parts(lines[i + 3])
         def join_label = _clean_rendered_label_name(lines[i + 4])
         def ret = str.strip(lines[i + 5])
         if (first.len > 0 && second.len > 0 && join.len > 0 && fail_label.len > 0 &&
            join_label == join && ret == "return " + first.get("lhs", "") &&
            first.get("lhs", "") == second.get("lhs", "") &&
            _clean_rendered_const_local(first.get("lhs", "")) &&
            _clean_rendered_pure_temp_rhs(first.get("rhs", "")) &&
            _clean_rendered_pure_temp_rhs(second.get("rhs", "")) &&
            _clean_goto_ref_count(lines, join) == 1){
            changed = true
            b = str.builder_append(b, _clean_line_indent(lines[i]) + "return " + first.get("rhs", "") + "\n")
            b = str.builder_append(b, lines[i + 2] + "\n")
            b = str.builder_append(b, _clean_line_indent(lines[i + 3]) + "return " + second.get("rhs", "") + "\n")
            i += 6
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_unused_label_protects_skip(list lines, int label_idx) bool {
   if !_clean_label_has_fallthrough(lines, label_idx) { return false }
   def j = _clean_next_nonblank_index(lines, label_idx + 1)
   if j >= lines.len { return false }
   def target = _clean_raw_goto_label(lines[j])
   if target.len == 0 { return false }
   def k = _clean_next_nonblank_index(lines, j + 1)
   if k >= lines.len { return false }
   def raw = str.strip(lines[k])
   if raw.len == 0 || raw == "}" || _clean_rendered_label_name(raw).len > 0 { return false }
   if _clean_raw_goto_label(raw).len > 0 { return false }
   if (str.startswith(raw, "local_") || str.find(raw, "dtor_") >= 0 ||
      str.find(raw, "_Unwind_Resume") >= 0 || str.find(raw, "__cxa_") >= 0 ||
      str.find(raw, "__clang_call_terminate") >= 0){ return false }
   true
}

fn _clean_drop_unused_labels(str text) str {
   def lines = str.split(text, "\n")
   mut labels = dict()
   mut i = 0
   while i < lines.len {
      def label = _clean_rendered_label_name(lines[i])
      if label.len > 0 { labels = labels.set(label, true) }
      i += 1
   }
   def names = labels.keys()
   mut used = dict()
   i = 0
   while i < lines.len {
      def raw = str.strip(lines[i])
      if _clean_rendered_label_name(raw).len == 0 {
         mut ni = 0
         while ni < names.len {
            def name = to_str(names[ni])
            if str.find(raw, "goto " + name) >= 0 { used = used.set(name, true) }
            ni += 1
         }
      }
      i += 1
   }
   mut b = str.Builder(text.len)
   i = 0
   mut prev_return = false
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def label = _clean_rendered_label_name(lines[i])
      if label.len == 0 || used.get(label, false) || _clean_unused_label_protects_skip(lines, i) {
         def is_ret = label.len == 0 && _clean_rendered_is_return(lines[i])
         if !(prev_return && is_ret) {
            b = str.builder_append(b, lines[i] + "\n")
         }
         prev_return = is_ret
      } else {
         prev_return = false
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_resolve_label_alias(dict aliases, str label) str {
   mut out = label
   mut guard = 0
   while guard < 32 {
      def next = aliases.get(out, "")
      if next.len == 0 || next == out { return out }
      out = next
      guard += 1
   }
   out
}

fn _clean_collapse_empty_label_aliases(str text) str {
   def lines = str.split(text, "\n")
   mut aliases = dict()
   mut i = 0
   while i < lines.len {
      def label = _clean_rendered_label_name(lines[i])
      if label.len > 0 {
         mut j = i + 1
         while j < lines.len && str.strip(lines[j]).len == 0 { j += 1 }
         if j < lines.len {
            def next = _clean_rendered_label_name(lines[j])
            if next.len > 0 && next != label { aliases = aliases.set(label, next) }
         }
      }
      i += 1
   }
   if aliases.len == 0 { return text }
   mut resolved = dict()
   def keys = aliases.keys()
   i = 0
   while i < keys.len {
      def label = to_str(keys[i])
      resolved = resolved.set(label, _clean_resolve_label_alias(aliases, label))
      i += 1
   }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def label = _clean_rendered_label_name(lines[i])
      if label.len > 0 && resolved.get(label, "") != "" {
         i += 1
         continue
      }
      mut line = lines[i]
      mut ki = 0
      while ki < keys.len {
         def from = to_str(keys[ki])
         def to = resolved.get(from, from)
         if to != from { line = str.str_replace(line, "goto " + from, "goto " + to) }
         ki += 1
      }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_collapse_trampoline_labels(str text) str {
   def lines = str.split(text, "\n")
   mut aliases = dict()
   mut starts = dict()
   mut i = 0
   while i < lines.len {
      def label = _clean_rendered_label_name(lines[i])
      if label.len > 0 && !_clean_label_has_fallthrough(lines, i) {
         def j = _clean_next_nonblank_index(lines, i + 1)
         if j < lines.len {
            def target = _clean_raw_goto_label(lines[j])
            if target.len > 0 && target != label {
               def k = _clean_next_nonblank_index(lines, j + 1)
               if k >= lines.len || _clean_rendered_label_name(lines[k]).len > 0 || str.strip(lines[k]) == "}" {
                  aliases = aliases.set(label, target)
                  starts = starts.set(to_str(i), j + 1)
               }
            }
         }
      }
      i += 1
   }
   if aliases.len == 0 { return text }
   mut resolved = dict()
   def keys = aliases.keys()
   i = 0
   while i < keys.len {
      def label = to_str(keys[i])
      resolved = resolved.set(label, _clean_resolve_label_alias(aliases, label))
      i += 1
   }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def end = starts.get(to_str(i), "")
      if end != "" {
         i = int(end)
         continue
      }
      mut line = lines[i]
      mut ki = 0
      while ki < keys.len {
         def from = to_str(keys[ki])
         def to = resolved.get(from, from)
         if to != from { line = str.str_replace(line, "goto " + from, "goto " + to) }
         ki += 1
      }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_drop_redundant_gotos(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 {
         def j = _clean_next_nonblank_index(lines, i + 1)
         if j < lines.len && _clean_raw_goto_label(lines[j]) == parts.get("target", "") {
            i += 1
            continue
         }
      }
      def g = _clean_raw_goto_label(lines[i])
      if g.len > 0 {
         def j = _clean_next_nonblank_index(lines, i + 1)
         if j < lines.len && _clean_rendered_label_name(lines[j]) == g {
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_drop_redundant_gotos_fixed(str text) str {
   mut out = text
   mut i = 0
   while i < 4 {
      def next = _clean_drop_redundant_gotos(out)
      if next == out { return out }
      out = next
      i += 1
   }
   out
}

fn _clean_rendered_expr_has_side_effect_call(str expr0) bool {
   def expr = str.strip(expr0)
   mut i = 0
   while i < expr.len {
      def ch = load8(expr, i)
      if _symbol_is_name_char(ch) {
         def start = i
         while i < expr.len && _symbol_is_name_char(load8(expr, i)) { i += 1 }
         def head = slice(expr, start, i, 1)
         mut j = i
         while j < expr.len && load8(expr, j) == 32 { j += 1 }
         if (j < expr.len && load8(expr, j) == 40 &&
            !(head == "if" || head == "while" || head == "switch" || head == "return") &&
            !_clean_rendered_helper_call_name(head)){
            return true
         }
         continue
      }
      i += 1
   }
   false
}

fn _clean_drop_immediate_conditional_goto_labels(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 {
         def next = _clean_next_nonblank_index(lines, i + 1)
         if (next < lines.len && _clean_rendered_label_name(lines[next]) == parts.get("target", "") &&
            _clean_goto_ref_count(lines, parts.get("target", "")) == 1 &&
            !_clean_rendered_expr_has_side_effect_call(parts.get("expr", ""))){
            skip = skip.set(to_str(i), true).set(to_str(next), true)
            changed = true
         }
      }
      i += 1
   }
   if !changed { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) {
         b = str.builder_append(b, lines[i] + "\n")
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_goto_from_fallthrough_label(list lines, int idx) bool {
   mut i = idx - 1
   while i >= 0 {
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         i -= 1
         continue
      }
      return _clean_rendered_label_name(raw).len > 0 && _clean_label_has_fallthrough(lines, i)
   }
   false
}

fn _clean_drop_linear_unreachable_after_terminal(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut blocked = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      if blocked {
         if raw.len == 0 {
            i += 1
            continue
         }
         if (str.startswith(raw, "}") || _clean_rendered_label_name(raw).len > 0 ||
            str.startswith(raw, "while (") || str.startswith(raw, "while ") ||
            (str.startswith(raw, "if (") && str.endswith(raw, "{"))){
            blocked = false
         } elif _clean_raw_goto_label(raw).len > 0 {
            i += 1
            continue
         } else {
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      if _clean_raw_goto_label(raw).len > 0 && !_clean_goto_from_fallthrough_label(lines, i) { blocked = true }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_drop_linear_unreachable_after_terminal_fixed(str text) str {
   mut out = text
   mut i = 0
   while i < 4 {
      def next = _clean_drop_linear_unreachable_after_terminal(out)
      if next == out { return out }
      out = next
      i += 1
   }
   out
}

fn _clean_unlabeled_tail_to_block_close(list lines, int start, int depth0) bool {
   mut depth = depth0
   mut saw_code = false
   mut i = start
   while i < lines.len {
      def raw = str.strip(lines[i])
      if raw == "}" && depth == depth0 { return saw_code }
      if str.startswith(raw, "} else") { return false }
      if _clean_rendered_label_name(raw).len > 0 { return false }
      if str.startswith(raw, "if (") && str.find(raw, "goto loc_") < 0 { return false }
      if (str.startswith(raw, "while (") || str.startswith(raw, "while ") ||
         str.startswith(raw, "for ")){ return false }
      if raw.len > 0 { saw_code = true }
      depth += _clean_loop_depth_delta(raw)
      i += 1
   }
   false
}

fn _clean_drop_unlabeled_tail_after_return(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut skipping = false
   mut skip_depth = 0
   mut depth = 0
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      if skipping {
         if raw == "}" && depth == skip_depth {
            b = str.builder_append(b, lines[i] + "\n")
            depth += _clean_loop_depth_delta(raw)
            skipping = false
         } else {
            changed = true
            depth += _clean_loop_depth_delta(raw)
         }
         i += 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      if depth == 1 && _clean_rendered_is_return(raw) {
         def next = _clean_next_nonblank_index(lines, i + 1)
         if (next < lines.len && str.strip(lines[next]) != "}" &&
            _clean_unlabeled_tail_to_block_close(lines, next, depth)){
            skipping = true
            skip_depth = depth
         }
      }
      depth += _clean_loop_depth_delta(raw)
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_tail_has_unwind_marker(list lines, int start) bool {
   mut i = start
   while i < lines.len {
      def raw = str.strip(lines[i])
      if (str.find(raw, "_Unwind_Resume") >= 0 || str.find(raw, "__clang_call_terminate") >= 0 ||
         str.find(raw, "__cxa_begin_catch") >= 0 || str.find(raw, "__stack_chk_fail") >= 0){
         return true
      }
      i += 1
   }
   false
}

fn _clean_drop_unwind_tail_after_return(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   mut dropped = false
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      b = str.builder_append(b, lines[i] + "\n")
      if _clean_rendered_is_return(raw) && _clean_tail_has_unwind_marker(lines, i + 1) {
         i += 1
         while i < lines.len && str.strip(lines[i]) == "}" {
            b = str.builder_append(b, lines[i] + "\n")
            i += 1
         }
         while i < lines.len {
            dropped = true
            i += 1
         }
         continue
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   dropped ? _clean_balance_trailing_braces(out) : out
}

fn _clean_return_dead_tail_worth_dropping(list lines, int start, int depth0) bool {
   mut depth = depth0
   mut i = start
   while i < lines.len {
      def raw = str.strip(lines[i])
      if raw == "}" && depth == depth0 { return false }
      if (_clean_rendered_label_name(raw).len > 0 || _clean_raw_goto_label(raw).len > 0 ||
         raw == "while true{" || raw == "while true{"){
         return true
      }
      depth += _clean_loop_depth_delta(raw)
      i += 1
   }
   false
}

fn _clean_drop_return_dead_block_tails(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut skipping = false
   mut skip_depth = 0
   mut depth = 0
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      if skipping {
         if raw == "}" && depth == skip_depth {
            b = str.builder_append(b, lines[i] + "\n")
            depth += _clean_loop_depth_delta(raw)
            skipping = false
         } else {
            changed = true
            depth += _clean_loop_depth_delta(raw)
         }
         i += 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      if depth > 0 && _clean_rendered_is_return(raw) {
         def next = _clean_next_nonblank_index(lines, i + 1)
         if (next < lines.len && str.strip(lines[next]) != "}" &&
            _clean_return_dead_tail_worth_dropping(lines, next, depth)){
            skipping = true
            skip_depth = depth
         }
      }
      depth += _clean_loop_depth_delta(raw)
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_find_label_index(list lines, str label, int start=0) int {
   mut i = max(0, start)
   while i < lines.len {
      if _clean_rendered_label_name(lines[i]) == label { return i }
      i += 1
   }
   -1
}

fn _clean_goto_ref_count(list lines, str label) int {
   mut count = 0
   mut i = 0
   while i < lines.len {
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 && parts.get("target", "") == label { count += 1 }
      if _clean_raw_goto_label(lines[i]) == label { count += 1 }
      i += 1
   }
   count
}

fn _clean_goto_ref_count_range(list lines, str label, int start, int end) int {
   mut count = 0
   mut i = max(0, start)
   while i < end && i < lines.len {
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 && parts.get("target", "") == label { count += 1 }
      if _clean_raw_goto_label(lines[i]) == label { count += 1 }
      i += 1
   }
   count
}

fn _clean_region_has_labels(list lines, int start, int end) bool {
   mut i = start
   while i < end && i < lines.len {
      if _clean_rendered_label_name(lines[i]).len > 0 { return true }
      i += 1
   }
   false
}

fn _clean_first_raw_goto_index(list lines, int start, int end) int {
   mut i = start
   while i < end && i < lines.len {
      if _clean_raw_goto_label(lines[i]).len > 0 { return i }
      i += 1
   }
   -1
}

fn _clean_region_structure_ok(list lines, int start, int end) bool {
   mut depth = 0
   mut i = start
   while i < end && i < lines.len {
      def raw = str.strip(lines[i])
      mut j = 0
      while j < raw.len {
         def c = load8(raw, j)
         if c == 123 { depth += 1 }
         elif c == 125 {
            depth -= 1
            if depth < 0 { return false }
         }
         j += 1
      }
      i += 1
   }
   depth == 0
}

fn _clean_reindent_body_line(str line, str indent) str {
   if str.strip(line).len == 0 { return "" }
   str.startswith(line, indent) ? (indent + "  " + slice(line, indent.len, line.len, 1)) : (indent + "  " + str.strip(line))
}

fn _clean_goto_diamond_shape(list lines, int i) dict {
   def parts = _clean_if_goto_parts(lines[i])
   if parts.len == 0 { return {"ok": false} }
   def jump_idx = _clean_next_nonblank_index(lines, i + 1)
   if jump_idx >= lines.len { return {"ok": false} }
   def else_label = _clean_raw_goto_label(lines[jump_idx])
   def then_label = parts.get("target", "")
   if then_label.len == 0 || else_label.len == 0 || then_label == else_label { return {"ok": false} }
   if _clean_goto_ref_count(lines, then_label) != 1 || _clean_goto_ref_count(lines, else_label) != 1 { return {"ok": false} }
   def then_idx = _clean_find_label_index(lines, then_label, jump_idx + 1)
   def else_idx = _clean_find_label_index(lines, else_label, jump_idx + 1)
   if then_idx <= jump_idx || else_idx <= then_idx { return {"ok": false} }
   if _clean_region_has_labels(lines, then_idx + 1, else_idx) { return {"ok": false} }
   def tail_idx = _clean_first_raw_goto_index(lines, then_idx + 1, else_idx)
   def end_label = tail_idx > then_idx ? _clean_raw_goto_label(lines[tail_idx]) : ""
   if end_label.len == 0 { return {"ok": false} }
   if !_clean_region_structure_ok(lines, then_idx + 1, tail_idx) { return {"ok": false} }
   def end_idx = _clean_find_label_index(lines, end_label, else_idx + 1)
   if end_idx <= else_idx { return {"ok": false} }
   if _clean_goto_ref_count(lines, end_label) != 1 { return {"ok": false} }
   if _clean_region_has_labels(lines, else_idx + 1, end_idx) { return {"ok": false} }
   if !_clean_region_structure_ok(lines, else_idx + 1, end_idx) { return {"ok": false} }
   {"ok": true, "expr": parts.get("expr", ""), "then_idx": then_idx, "else_idx": else_idx,
      "tail_idx": tail_idx, "end_idx": end_idx}
}

fn _clean_structure_goto_diamonds(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def shape = _clean_goto_diamond_shape(lines, i)
      if shape.get("ok", false) {
         mut indent = _clean_line_indent(lines[i])
         if indent.len == 0 && i > 0 { indent = "  " }
         def then_idx = int(shape.get("then_idx", 0))
         def else_idx = int(shape.get("else_idx", 0))
         def tail_idx = int(shape.get("tail_idx", 0))
         def end_idx = int(shape.get("end_idx", 0))
         b = str.builder_append(b, indent + "if " + shape.get("expr", "") + "{\n")
         mut j = then_idx + 1
         while j < tail_idx {
            b = str.builder_append(b, _clean_reindent_body_line(lines[j], indent) + "\n")
            j += 1
         }
         b = str.builder_append(b, indent + "} else {\n")
         j = else_idx + 1
         while j < end_idx {
            b = str.builder_append(b, _clean_reindent_body_line(lines[j], indent) + "\n")
            j += 1
         }
         b = str.builder_append(b, indent + "}\n")
         i = end_idx + 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_fallthrough_if_else_shape(list lines, int i) dict {
   def parts = _clean_if_goto_parts(lines[i])
   if parts.len == 0 { return {"ok": false} }
   def else_label = parts.get("target", "")
   if else_label.len == 0 || _clean_goto_ref_count(lines, else_label) != 1 { return {"ok": false} }
   def else_idx = _clean_find_label_index(lines, else_label, i + 1)
   if else_idx <= i + 2 { return {"ok": false} }
   def jump_idx = _clean_first_raw_goto_index(lines, i + 1, else_idx)
   if jump_idx <= i + 1 || jump_idx >= else_idx { return {"ok": false} }
   def end_label = _clean_raw_goto_label(lines[jump_idx])
   if end_label.len == 0 || end_label == else_label { return {"ok": false} }
   def end_idx = _clean_find_label_index(lines, end_label, else_idx + 1)
   if end_idx <= else_idx { return {"ok": false} }
   if (_clean_region_has_labels(lines, i + 1, jump_idx) ||
      _clean_region_has_labels(lines, else_idx + 1, end_idx)){ return {"ok": false} }
   if (_clean_first_raw_goto_index(lines, i + 1, jump_idx) >= 0 ||
      _clean_first_raw_goto_index(lines, else_idx + 1, end_idx) >= 0){ return {"ok": false} }
   if (!_clean_region_structure_ok(lines, i + 1, jump_idx) ||
      !_clean_region_structure_ok(lines, else_idx + 1, end_idx)){ return {"ok": false} }
   if _clean_goto_ref_count_range(lines, end_label, i, end_idx) != 1 { return {"ok": false} }
   {"ok": true, "expr": parts.get("expr", ""), "then_start": i + 1,
      "then_end": jump_idx, "else_idx": else_idx, "end_idx": end_idx,
      "end_label": end_label,
      "preserve_end_label": _clean_goto_ref_count(lines, end_label) > 1}
}

fn _clean_structure_fallthrough_if_else(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def shape = _clean_fallthrough_if_else_shape(lines, i)
      if shape.get("ok", false) {
         changed = true
         def indent = _clean_line_indent(lines[i])
         def then_start = int(shape.get("then_start", i + 1))
         def then_end = int(shape.get("then_end", then_start))
         def else_idx = int(shape.get("else_idx", then_end + 1))
         def end_idx = int(shape.get("end_idx", else_idx + 1))
         b = str.builder_append(b, indent + "if " + _clean_invert_cond(shape.get("expr", "")) + "{\n")
         mut j = then_start
         while j < then_end {
            b = str.builder_append(b, _clean_reindent_body_line(lines[j], indent) + "\n")
            j += 1
         }
         b = str.builder_append(b, indent + "} else {\n")
         j = else_idx + 1
         while j < end_idx {
            b = str.builder_append(b, _clean_reindent_body_line(lines[j], indent) + "\n")
            j += 1
         }
         b = str.builder_append(b, indent + "}\n")
         if shape.get("preserve_end_label", false) {
            b = str.builder_append(b, indent + shape.get("end_label", "") + ":\n")
         }
         i = end_idx + 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_goto_skip_shape(list lines, int i) dict {
   def parts = _clean_if_goto_parts(lines[i])
   if parts.len == 0 { return {"ok": false} }
   def label = parts.get("target", "")
   if label.len == 0 || _clean_goto_ref_count(lines, label) != 1 { return {"ok": false} }
   def label_idx = _clean_find_label_index(lines, label, i + 1)
   if label_idx <= i + 1 { return {"ok": false} }
   if _clean_region_has_labels(lines, i + 1, label_idx) { return {"ok": false} }
   if _clean_first_raw_goto_index(lines, i + 1, label_idx) >= 0 { return {"ok": false} }
   if !_clean_region_structure_ok(lines, i + 1, label_idx) { return {"ok": false} }
   mut j = i + 1
   while j < label_idx {
      def raw = str.strip(lines[j])
      if (_clean_line_terminates_flow(raw) || str.startswith(raw, "if (") ||
         str.startswith(raw, "while (") || str.startswith(raw, "while ") ||
         str.startswith(raw, "switch(")){
         return {"ok": false}
      }
      j += 1
   }
   {"ok": true, "expr": parts.get("expr", ""), "label_idx": label_idx,
      "indent": _clean_line_indent(lines[i])}
}

fn _clean_structure_goto_skips(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def shape = _clean_goto_skip_shape(lines, i)
      if shape.get("ok", false) {
         mut indent = _clean_line_indent(lines[i])
         if indent.len == 0 && i > 0 { indent = "  " }
         def label_idx = int(shape.get("label_idx", 0))
         def first_body = _clean_next_nonblank_index(lines, i + 1)
         if first_body < label_idx {
            def body_indent = _clean_line_indent(lines[first_body])
            if body_indent.len > indent.len { indent = body_indent }
         }
         b = str.builder_append(b, indent + "if " + _clean_invert_cond(shape.get("expr", "")) + "{\n")
         mut body_idx = int(i) + 1
         while body_idx < label_idx {
            b = str.builder_append(b, indent + "  " + str.strip(lines[body_idx]) + "\n")
            body_idx += 1
         }
         b = str.builder_append(b, indent + "}\n")
         i = label_idx + 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_simple_terminal_region(list lines, int start, int end) bool {
   def first = _clean_next_nonblank_index(lines, start)
   if first >= end { return false }
   mut depth = 0
   mut i = first
   while i < end && i < lines.len {
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         i += 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 { return false }
      if _clean_raw_goto_label(raw).len > 0 || _clean_if_goto_parts(raw).len > 0 { return false }
      if str.startswith(raw, "while (") || str.startswith(raw, "for (") || str.startswith(raw, "switch(") {
         return false
      }
      if str.startswith(raw, "if (") && _clean_structured_if_open_parts(raw).len == 0 {
         return false
      }
      if str.endswith(raw, "{") {
         depth += 1
         i += 1
         continue
      }
      if raw == "}" {
         depth -= 1
         if depth < 0 { return false }
         i += 1
         continue
      }
      if depth == 0 && _clean_line_terminates_flow(raw) {
         return _clean_next_nonblank_index(lines, i + 1) >= end
      }
      i += 1
   }
   false
}

fn _clean_guard_label_after_terminal_shape(list lines, list depths, int i) dict {
   def parts = _clean_if_goto_parts(lines[i])
   if parts.len == 0 { return {"ok": false} }
   def label = parts.get("target", "")
   if label.len == 0 || _clean_goto_ref_count(lines, label) != 1 { return {"ok": false} }
   def label_idx = _clean_find_label_index(lines, label, i + 1)
   if label_idx <= i + 1 { return {"ok": false} }
   if i < 0 || i >= depths.len || label_idx < 0 || label_idx >= depths.len { return {"ok": false} }
   if int(depths[i]) != int(depths[label_idx]) { return {"ok": false} }
   if _clean_region_has_labels(lines, i + 1, label_idx) { return {"ok": false} }
   if _clean_first_raw_goto_index(lines, i + 1, label_idx) >= 0 { return {"ok": false} }
   if !_clean_region_structure_ok(lines, i + 1, label_idx) { return {"ok": false} }
   if !_clean_simple_terminal_region(lines, i + 1, label_idx) { return {"ok": false} }
   {"ok": true, "expr": parts.get("expr", ""), "label_idx": label_idx,
      "indent": _clean_line_indent(lines[i])}
}

fn _clean_structure_guard_label_after_terminal(str text) str {
   def lines = str.split(text, "\n")
   def depths = _clean_line_depths(lines)
   mut b = str.Builder(text.len + 256)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def shape = _clean_guard_label_after_terminal_shape(lines, depths, i)
      if shape.get("ok", false) {
         changed = true
         def guard_pad = shape.get("indent", _clean_line_indent(lines[i]))
         def label_idx = int(shape.get("label_idx", 0))
         b = str.builder_append(b, guard_pad + "if " + _clean_negated_condition_expr(shape.get("expr", "")) + "{\n")
         mut body_idx = int(i) + 1
         while body_idx < label_idx {
            if str.strip(lines[body_idx]).len > 0 { b = str.builder_append(b, _clean_reindent_body_line(lines[body_idx], guard_pad) + "\n") }
            body_idx += 1
         }
         b = str.builder_append(b, guard_pad + "}\n")
         i = label_idx + 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_inline_break_condition(str line) str {
   def parts = _clean_inline_if_parts(line)
   if parts.len == 0 { return "" }
   str.strip(parts.get("tail", "")) == "{ break }" ? parts.get("expr", "") : ""
}

fn _clean_loop_has_body_after_guard(list lines, int first, int close) bool {
   mut i = first + 1
   while i < close && i < lines.len {
      def raw = str.strip(lines[i])
      if raw.len > 0 && raw != "}" { return true }
      i += 1
   }
   false
}

fn _clean_pure_loop_guard_call_rhs(str rhs0) bool {
   def rhs = str.strip(rhs0)
   def p = str.find(rhs, "(")
   if p <= 0 || !str.endswith(rhs, ")") { return false }
   def name = str.lower(str.strip(slice(rhs, 0, p, 1)))
   name == "strlen" || name == "len" || name == "sizeof"
}

fn _clean_loop_guard_temp_dead_after(list lines, int guard_idx, int close, str lhs) bool {
   mut i = guard_idx + 1
   while i < close && i < lines.len {
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         i += 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 || _clean_raw_goto_label(raw).len > 0 { return false }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len > 0 && str.lower(parts.get("lhs", "")) == str.lower(lhs) {
         return !_clean_render_text_has_token(parts.get("rhs", ""), lhs)
      }
      if _clean_render_text_has_token(raw, lhs) { return false }
      i += 1
   }
   true
}

fn _clean_loop_inline_temp_guard_cond(list lines, int first, int close) dict {
   def parts = _clean_rendered_assignment_parts(lines[first])
   if parts.len == 0 { return dict() }
   def lhs = parts.get("lhs", "")
   def rhs = parts.get("rhs", "")
   if !_clean_rendered_temp_reg(lhs) { return dict() }
   if !_clean_inline_condition_copy_candidate(lhs, rhs) && !_clean_pure_loop_guard_call_rhs(rhs) {
      return dict()
   }
   def guard = _clean_next_nonblank_index(lines, first + 1)
   if guard >= close { return dict() }
   def cond = _clean_inline_break_condition(lines[guard])
   if cond.len == 0 || !_clean_render_text_has_token(cond, lhs) { return dict() }
   if !_clean_loop_guard_temp_dead_after(lines, guard, close, lhs) { return dict() }
   {"cond": _clean_replace_token(cond, lhs, _clean_inline_condition_copy_rhs(rhs)),
      "guard": guard, "drop": first}
}

fn _clean_structure_top_break_loops(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      if raw == "while true{" {
         def first = _clean_next_nonblank_index(lines, i + 1)
         mut cond = first < lines.len ? _clean_inline_break_condition(lines[first]) : ""
         mut guard_idx = first
         mut drop_idx = -1
         if cond.len > 0 {
            def close = _clean_matching_block_close(lines, i)
            if close > first && _clean_loop_has_body_after_guard(lines, first, close) {
               changed = true
               def pad = _clean_line_indent(lines[i])
               b = str.builder_append(b, pad + "while " + _clean_negated_condition_expr(cond) + "{\n")
               mut j = i + 1
               while j < close {
                  if j != first { b = str.builder_append(b, lines[j] + "\n") }
                  j += 1
               }
               b = str.builder_append(b, lines[close] + "\n")
               i = close + 1
               continue
            }
         } else {
            def close = _clean_matching_block_close(lines, i)
            def inlined = first < lines.len && close > first ? _clean_loop_inline_temp_guard_cond(lines, first, close) : dict()
            if inlined.len > 0 {
               cond = inlined.get("cond", "")
               guard_idx = int(inlined.get("guard", first))
               drop_idx = int(inlined.get("drop", -1))
               if close > guard_idx && _clean_loop_has_body_after_guard(lines, guard_idx, close) {
                  changed = true
                  def pad = _clean_line_indent(lines[i])
                  b = str.builder_append(b, pad + "while " + _clean_negated_condition_expr(cond) + "{\n")
                  mut j = i + 1
                  while j < close {
                     if j != guard_idx && j != drop_idx { b = str.builder_append(b, lines[j] + "\n") }
                     j += 1
                  }
                  b = str.builder_append(b, lines[close] + "\n")
                  i = close + 1
                  continue
               }
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_empty_infinite_loop_close(list lines, int loop_idx) int {
   if loop_idx < 0 || loop_idx >= lines.len || str.strip(lines[loop_idx]) != "while true{" { return -1 }
   def body = _clean_next_nonblank_index(lines, loop_idx + 1)
   if body >= lines.len || str.strip(lines[body]) != "}" { return -1 }
   _clean_matching_block_close(lines, loop_idx)
}

fn _clean_failstop_empty_loop_shape(list lines, int i) dict {
   def parts = _clean_if_goto_parts(lines[i])
   if parts.len == 0 { return {"ok": false} }
   def target = parts.get("target", "")
   if target.len == 0 { return {"ok": false} }
   def loop_idx = _clean_next_nonblank_index(lines, i + 1)
   if loop_idx >= lines.len { return {"ok": false} }
   def close = _clean_empty_infinite_loop_close(lines, loop_idx)
   if close <= loop_idx { return {"ok": false} }
   def label_idx = _clean_next_nonblank_index(lines, close + 1)
   if label_idx >= lines.len || _clean_rendered_label_name(lines[label_idx]) != target { return {"ok": false} }
   {"ok": true, "expr": parts.get("expr", ""), "loop_idx": loop_idx,
      "close": close, "label_idx": label_idx, "target": target,
      "preserve_label": _clean_goto_ref_count(lines, target) > 1}
}

fn _clean_structure_failstop_empty_loops(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def shape = _clean_failstop_empty_loop_shape(lines, i)
      if shape.get("ok", false) {
         changed = true
         mut indent = _clean_line_indent(lines[i])
         if indent.len == 0 && i > 0 { indent = "  " }
         b = str.builder_append(b, indent + "if " + _clean_invert_cond(shape.get("expr", "")) + "{\n")
         b = str.builder_append(b, indent + "  trap_forever()\n")
         b = str.builder_append(b, indent + "}\n")
         if shape.get("preserve_label", false) {
            b = str.builder_append(b, indent + shape.get("target", "") + ":\n")
         }
         i = int(shape.get("label_idx", i)) + 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_loop_exit_goto_target_after_close(list lines, int close) str {
   def next = _clean_next_nonblank_index(lines, close + 1)
   if next >= lines.len { return "" }
   _clean_rendered_label_name(lines[next])
}

fn _clean_loop_depth_delta(str raw) int {
   if raw == "} else {" { return 0 }
   mut d = 0
   if str.endswith(raw, "{") { d += 1 }
   if raw == "}" { d -= 1 }
   d
}

fn _clean_loop_exit_goto_ref_at_depth(list lines, int start, int close, str target, int want_depth) int {
   mut count = 0
   mut depth = 1
   mut i = start + 1
   while i < close && i < lines.len {
      def raw = str.strip(lines[i])
      if depth == want_depth {
         def parts = _clean_if_goto_parts(raw)
         if parts.len > 0 && parts.get("target", "") == target { count += 1 }
         if _clean_raw_goto_label(raw) == target { count += 1 }
      }
      depth += _clean_loop_depth_delta(raw)
      i += 1
   }
   count
}

fn _clean_structure_loop_exit_gotos(str text) str {
   def lines = str.split(text, "\n")
   mut out = []
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      if raw == "while true{" {
         def close = _clean_matching_block_close(lines, i)
         def target = close > i ? _clean_loop_exit_goto_target_after_close(lines, close) : ""
         if target.len > 0 {
            def total_refs = _clean_goto_ref_count(lines, target)
            def convertible_refs = _clean_loop_exit_goto_ref_at_depth(lines, i, close, target, 1)
            if convertible_refs > 0 {
               changed = true
               out = out.append(lines[i])
               mut depth = 1
               mut j = i + 1
               while j < close {
                  def rj = str.strip(lines[j])
                  mut replaced = false
                  if depth == 1 {
                     def parts = _clean_if_goto_parts(rj)
                     if parts.len > 0 && parts.get("target", "") == target {
                        out = out.append(_clean_line_indent(lines[j]) + "if (" +
                           parts.get("expr", "") + "){ break }")
                        replaced = true
                     } elif _clean_raw_goto_label(rj) == target {
                        out = out.append(_clean_line_indent(lines[j]) + "break")
                        replaced = true
                     }
                  }
                  if !replaced { out = out.append(lines[j]) }
                  depth += _clean_loop_depth_delta(rj)
                  j += 1
               }
               out = out.append(lines[close])
               i = close + 1
               if total_refs == convertible_refs {
                  def label_idx = _clean_next_nonblank_index(lines, i)
                  if label_idx < lines.len && _clean_rendered_label_name(lines[label_idx]) == target {
                     i = label_idx + 1
                  }
               }
               continue
            }
         }
      }
      out = out.append(lines[i])
      i += 1
   }
   changed ? str.join(out, "\n") + "\n" : text
}

fn _clean_rotate_prechecked_loops(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def head_label = _clean_raw_goto_label(lines[i])
      if head_label.len > 0 {
         def wi = _clean_next_nonblank_index(lines, i + 1)
         if wi < lines.len && str.strip(lines[wi]) == "while true{" {
            def close = _clean_matching_block_close(lines, wi)
            if close > wi {
               def label_idx = _clean_find_label_index(lines, head_label, wi + 1)
               if (label_idx > wi && label_idx < close &&
                  !_clean_region_has_labels(lines, label_idx + 1, close)){
                  b = str.builder_append(b, lines[wi] + "\n")
                  mut j = label_idx + 1
                  while j < close {
                     b = str.builder_append(b, lines[j] + "\n")
                     j += 1
                  }
                  j = wi + 1
                  while j < label_idx {
                     b = str.builder_append(b, lines[j] + "\n")
                     j += 1
                  }
                  b = str.builder_append(b, lines[close] + "\n")
                  i = close + 1
                  continue
               }
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_flat_prechecked_loop_shape(list lines, int i) dict {
   def cond_label = _clean_raw_goto_label(lines[i])
   if cond_label.len == 0 || _clean_goto_ref_count(lines, cond_label) != 1 { return {"ok": false} }
   def body_label_idx = _clean_next_nonblank_index(lines, i + 1)
   if body_label_idx >= lines.len { return {"ok": false} }
   def body_label = _clean_rendered_label_name(lines[body_label_idx])
   if body_label.len == 0 || body_label == cond_label || _clean_goto_ref_count(lines, body_label) != 1 { return {"ok": false} }
   def cond_label_idx = _clean_find_label_index(lines, cond_label, body_label_idx + 1)
   if cond_label_idx <= body_label_idx + 1 { return {"ok": false} }
   def branch_idx = _clean_next_nonblank_index(lines, cond_label_idx + 1)
   if branch_idx >= lines.len { return {"ok": false} }
   def parts = _clean_if_goto_parts(lines[branch_idx])
   if parts.len == 0 || parts.get("target", "") != body_label { return {"ok": false} }
   if _clean_region_has_labels(lines, body_label_idx + 1, cond_label_idx) { return {"ok": false} }
   if _clean_first_raw_goto_index(lines, body_label_idx + 1, cond_label_idx) >= 0 { return {"ok": false} }
   if !_clean_region_structure_ok(lines, body_label_idx + 1, cond_label_idx) { return {"ok": false} }
   if (_clean_line_indent(lines[i]) != _clean_line_indent(lines[body_label_idx]) ||
      _clean_line_indent(lines[i]) != _clean_line_indent(lines[cond_label_idx])){ return {"ok": false} }
   {"ok": true, "expr": parts.get("expr", ""), "body_start": body_label_idx + 1,
      "body_end": cond_label_idx, "branch_idx": branch_idx}
}

fn _clean_structure_flat_prechecked_loops(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def shape = _clean_flat_prechecked_loop_shape(lines, i)
      if shape.get("ok", false) {
         changed = true
         def indent = _clean_line_indent(lines[i])
         b = str.builder_append(b, indent + "while " + shape.get("expr", "") + "{\n")
         mut j = int(shape.get("body_start", i + 1))
         while j < int(shape.get("body_end", j)) {
            b = str.builder_append(b, _clean_reindent_body_line(lines[j], indent) + "\n")
            j += 1
         }
         b = str.builder_append(b, indent + "}\n")
         i = int(shape.get("branch_idx", i)) + 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_region_has_goto_other_than(list lines, int start, int end, str label) bool {
   mut i = start
   while i < end && i < lines.len {
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 && parts.get("target", "") != label { return true }
      if _clean_raw_goto_label(lines[i]).len > 0 { return true }
      i += 1
   }
   false
}

fn _clean_bottom_tested_loop_shape(list lines, int i) dict {
   def label = _clean_rendered_label_name(lines[i])
   if label.len == 0 || _clean_goto_ref_count(lines, label) != 1 { return {"ok": false} }
   def first_body = _clean_next_nonblank_index(lines, i + 1)
   if first_body >= lines.len { return {"ok": false} }
   mut depth = 0
   mut branch_idx = -1
   mut expr = ""
   mut j = i + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if depth == 0 && _clean_rendered_label_name(raw).len > 0 { break }
      if depth == 0 {
         def parts = _clean_if_goto_parts(raw)
         if parts.len > 0 && parts.get("target", "") == label {
            branch_idx = j
            expr = parts.get("expr", "")
            break
         }
         if parts.len > 0 || _clean_raw_goto_label(raw).len > 0 { return {"ok": false} }
      }
      depth += _clean_loop_depth_delta(raw)
      if depth < 0 { return {"ok": false} }
      j += 1
   }
   if branch_idx <= first_body || expr.len == 0 { return {"ok": false} }
   if _clean_line_indent(lines[i]) != _clean_line_indent(lines[branch_idx]) { return {"ok": false} }
   if _clean_region_has_labels(lines, i + 1, branch_idx) { return {"ok": false} }
   if _clean_region_has_goto_other_than(lines, i + 1, branch_idx, label) { return {"ok": false} }
   if !_clean_region_structure_ok(lines, i + 1, branch_idx) { return {"ok": false} }
   {"ok": true, "label": label, "expr": expr, "body_start": i + 1, "branch_idx": branch_idx}
}

fn _clean_structure_bottom_tested_loops(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def shape = _clean_bottom_tested_loop_shape(lines, i)
      if shape.get("ok", false) {
         changed = true
         def indent = _clean_line_indent(lines[i])
         b = str.builder_append(b, indent + "while true{\n")
         mut j = int(shape.get("body_start", i + 1))
         while j < int(shape.get("branch_idx", j)) {
            b = str.builder_append(b, _clean_reindent_body_line(lines[j], indent) + "\n")
            j += 1
         }
         b = str.builder_append(b, indent + "  if " + _clean_negated_condition_expr(shape.get("expr", "")) + "{ break }\n")
         b = str.builder_append(b, indent + "}\n")
         i = int(shape.get("branch_idx", i)) + 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_prev_nonblank_terminates(list lines, int idx) bool {
   mut i = idx - 1
   while i >= 0 {
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         i -= 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 { return false }
      return _clean_line_terminates_flow(raw)
   }
   false
}

fn _clean_drop_unreachable_unused_labels(str text) str {
   def lines = str.split(text, "\n")
   mut labels = dict()
   mut i = 0
   while i < lines.len {
      def label = _clean_rendered_label_name(lines[i])
      if label.len > 0 { labels = labels.set(label, true) }
      i += 1
   }
   if labels.len == 0 { return text }
   def names = labels.keys()
   mut used = dict()
   i = 0
   while i < lines.len {
      def raw = str.strip(lines[i])
      if _clean_rendered_label_name(raw).len == 0 {
         mut ni = 0
         while ni < names.len {
            def name = to_str(names[ni])
            if str.find(raw, "goto " + name) >= 0 { used = used.set(name, true) }
            ni += 1
         }
      }
      i += 1
   }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def label = _clean_rendered_label_name(lines[i])
      if label.len > 0 && !used.get(label, false) && _clean_prev_nonblank_terminates(lines, i) {
         mut j = i + 1
         mut terminal = false
         while j < lines.len {
            def raw = str.strip(lines[j])
            if raw == "}" || _clean_rendered_label_name(raw).len > 0 { break }
            if _clean_line_terminates_flow(raw) { terminal = true }
            j += 1
         }
         if terminal {
            i = j
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_subtracts_one_from(str expr0, str base0) bool {
   def expr = _clean_strip_outer_parens(expr0)
   def base = _clean_strip_outer_parens(base0)
   def p = _clean_top_level_find(expr, " - ")
   if p < 0 { return false }
   def lhs = _clean_strip_outer_parens(slice(expr, 0, p, 1))
   def rhs = _clean_literal_int_value(slice(expr, p + 3, expr.len, 1))
   rhs.get("ok", false) && int(rhs.get("value", 0)) == 1 && lhs == base
}

fn _clean_even_product_mod2(str expr0) bool {
   def expr = _clean_strip_outer_parens(expr0)
   def pmod = _clean_top_level_find(expr, " % ")
   if pmod < 0 { return false }
   def modv = _clean_literal_int_value(slice(expr, pmod + 3, expr.len, 1))
   if !modv.get("ok", false) || int(modv.get("value", 0)) != 2 { return false }
   _clean_even_product_expr(slice(expr, 0, pmod, 1))
}

fn _clean_even_product_expr(str expr0) bool {
   def product = _clean_strip_outer_parens(expr0)
   def pmul = _clean_top_level_find(product, " * ")
   if pmul < 0 { return false }
   def lhs = _clean_strip_outer_parens(slice(product, 0, pmul, 1))
   def rhs = _clean_strip_outer_parens(slice(product, pmul + 3, product.len, 1))
   _clean_subtracts_one_from(rhs, lhs) || _clean_subtracts_one_from(lhs, rhs)
}

fn _clean_even_product_lowbit(str expr0) bool {
   def expr = _clean_strip_outer_parens(expr0)
   def pand = _clean_top_level_find(expr, " & ")
   if pand < 0 { return false }
   def lhs = str.strip(slice(expr, 0, pand, 1))
   def rhs = str.strip(slice(expr, pand + 3, expr.len, 1))
   def rmask = _clean_literal_int_value(rhs)
   if rmask.get("ok", false) && int(rmask.get("value", 0)) == 1 {
      return _clean_even_product_expr(lhs)
   }
   def lmask = _clean_literal_int_value(lhs)
   if lmask.get("ok", false) && int(lmask.get("value", 0)) == 1 {
      return _clean_even_product_expr(rhs)
   }
   false
}

fn _clean_opaque_even_product_truth(str expr0) int {
   if expr0.len > 320 { return -1 }
   def expr = _clean_strip_outer_parens(expr0)
   mut p = _clean_top_level_find(expr, " == ")
   mut op = "=="
   if p < 0 {
      p = _clean_top_level_find(expr, " != ")
      op = "!="
   }
   if p < 0 { return -1 }
   def lhs = str.strip(slice(expr, 0, p, 1))
   def rhs = str.strip(slice(expr, p + 4, expr.len, 1))
   def lzero = _clean_literal_int_value(lhs)
   def rzero = _clean_literal_int_value(rhs)
   mut is_even_mod = false
   if rzero.get("ok", false) && int(rzero.get("value", 0)) == 0 {
      is_even_mod = _clean_even_product_mod2(lhs) || _clean_even_product_lowbit(lhs)
   } elif lzero.get("ok", false) && int(lzero.get("value", 0)) == 0 {
      is_even_mod = _clean_even_product_mod2(rhs) || _clean_even_product_lowbit(rhs)
   }
   if !is_even_mod { return -1 }
   op == "==" ? 1 : 0
}

fn _clean_zero_mod_expr(str expr0) bool {
   def expr = _clean_strip_outer_parens(expr0)
   def p = _clean_top_level_find(expr, " % ")
   if p < 0 { return false }
   _clean_literal_zero(slice(expr, 0, p, 1))
}

fn _clean_return_accumulator_alias(str expr0) str {
   def expr = str.lower(str.strip(expr0))
   if expr == "rax" || expr == "eax" || expr == "ax" || expr == "al" { return "x86:rax" }
   if expr == "x0" || expr == "w0" { return "aarch64:x0" }
   if expr == "r0" { return "arm:r0" }
   if expr == "a0" { return "riscv:a0" }
   ""
}

fn _clean_nonpositive_guard_expr(str expr0) bool {
   def expr = _clean_strip_outer_parens(expr0)
   def checks = [" <= ", " < ", " >= ", " > "]
   mut i = 0
   while i < checks.len {
      def op = checks[i]
      def p = _clean_top_level_find(expr, op)
      if p >= 0 {
         def lhs = str.strip(slice(expr, 0, p, 1))
         def rhs = str.strip(slice(expr, p + op.len, expr.len, 1))
         def llit = _clean_literal_int_value(lhs)
         def rlit = _clean_literal_int_value(rhs)
         if ((op == " <= " && rlit.get("ok", false) && int(rlit.get("value", 0)) == 0) ||
            (op == " < " && rlit.get("ok", false) && int(rlit.get("value", 0)) == 1) ||
            (op == " >= " && llit.get("ok", false) && int(llit.get("value", 0)) == 0) ||
            (op == " > " && llit.get("ok", false) && int(llit.get("value", 0)) == 1)){
            return true
         }
      }
      i += 1
   }
   false
}

fn _clean_mod_zero_return_value(str expr0) dict {
   def expr = _clean_strip_outer_parens(expr0)
   mut p = _clean_top_level_find(expr, " == ")
   mut eq = true
   if p < 0 {
      p = _clean_top_level_find(expr, " != ")
      eq = false
   }
   if p < 0 { return dict() }
   def lhs = str.strip(slice(expr, 0, p, 1))
   def rhs = str.strip(slice(expr, p + 4, expr.len, 1))
   mut mod_expr = ""
   if _clean_literal_zero(rhs) {
      mod_expr = lhs
   } elif _clean_literal_zero(lhs) {
      mod_expr = rhs
   } else {
      return dict()
   }
   def mp = _clean_top_level_find(mod_expr, " % ")
   if mp < 0 { return dict() }
   def acc = _clean_return_accumulator_alias(slice(mod_expr, 0, mp, 1))
   if acc.len == 0 { return dict() }
   {"acc": acc, "value": eq ? "true" : "false"}
}

fn _clean_expr_truth_value(str expr0) int {
   if expr0.len > 512 { return -1 }
   def expr = _clean_strip_outer_parens(expr0)
   if expr.len == 0 { return -1 }
   def lower = str.lower(expr)
   if lower == "true" { return 1 }
   if lower == "false" { return 0 }
   def lit = _clean_literal_int_value(expr)
   if lit.get("ok", false) { return int(lit.get("value", 0)) != 0 ? 1 : 0 }
   if str.startswith(expr, "bool(") && _clean_call_end_at(expr, 0, "bool") == expr.len {
      return _clean_expr_truth_value(slice(expr, 5, expr.len - 1, 1))
   }
   def opaque = _clean_opaque_even_product_truth(expr)
   if opaque >= 0 { return opaque }
   def or_parts = _clean_top_level_split(expr, " | ")
   if or_parts.len > 1 {
      mut all_false = true
      mut i = 0
      while i < or_parts.len {
         if !_clean_bitwise_truth_part_ok(or_parts[i]) {
            all_false = false
            i += 1
            continue
         }
         def tv = _clean_expr_truth_value(or_parts[i])
         if tv == 1 { return 1 }
         if tv != 0 { all_false = false }
         i += 1
      }
      return all_false ? 0 : -1
   }
   def lor_parts = _clean_top_level_split(expr, " || ")
   if lor_parts.len > 1 {
      mut all_false = true
      mut i = 0
      while i < lor_parts.len {
         def tv = _clean_expr_truth_value(lor_parts[i])
         if tv == 1 { return 1 }
         if tv != 0 { all_false = false }
         i += 1
      }
      return all_false ? 0 : -1
   }
   def and_parts = _clean_top_level_split(expr, " & ")
   if and_parts.len > 1 {
      mut all_true = true
      mut i = 0
      while i < and_parts.len {
         if !_clean_bitwise_truth_part_ok(and_parts[i]) {
            all_true = false
            i += 1
            continue
         }
         def tv = _clean_expr_truth_value(and_parts[i])
         if tv == 0 { return 0 }
         if tv != 1 { all_true = false }
         i += 1
      }
      return all_true ? 1 : -1
   }
   def land_parts = _clean_top_level_split(expr, " && ")
   if land_parts.len > 1 {
      mut all_true = true
      mut i = 0
      while i < land_parts.len {
         def tv = _clean_expr_truth_value(land_parts[i])
         if tv == 0 { return 0 }
         if tv != 1 { all_true = false }
         i += 1
      }
      return all_true ? 1 : -1
   }
   mut p = _clean_top_level_find(expr, " != ")
   mut op = "!="
   if p < 0 {
      p = _clean_top_level_find(expr, " == ")
      op = "=="
   }
   if p >= 0 {
      def lhs = slice(expr, 0, p, 1)
      def rhs = slice(expr, p + 4, expr.len, 1)
      def llit = _clean_literal_int_value(lhs)
      def rlit = _clean_literal_int_value(rhs)
      if rlit.get("ok", false) && int(rlit.get("value", 0)) == 0 && _clean_zero_mod_expr(lhs) {
         return op == "==" ? 1 : 0
      }
      if llit.get("ok", false) && int(llit.get("value", 0)) == 0 && _clean_zero_mod_expr(rhs) {
         return op == "==" ? 1 : 0
      }
      if llit.get("ok", false) && rlit.get("ok", false) {
         def same = int(llit.get("value", 0)) == int(rlit.get("value", 0))
         return op == "==" ? (same ? 1 : 0) : (same ? 0 : 1)
      }
      def ltv = _clean_expr_truth_value(lhs)
      if ltv >= 0 && rlit.get("ok", false) {
         def same = ltv == int(rlit.get("value", 0))
         return op == "==" ? (same ? 1 : 0) : (same ? 0 : 1)
      }
      def rtv = _clean_expr_truth_value(rhs)
      if rtv >= 0 && llit.get("ok", false) {
         def same = int(llit.get("value", 0)) == rtv
         return op == "==" ? (same ? 1 : 0) : (same ? 0 : 1)
      }
      if ltv >= 0 && rtv >= 0 {
         def same = ltv == rtv
         return op == "==" ? (same ? 1 : 0) : (same ? 0 : 1)
      }
   }
   -1
}

fn _clean_constant_condition_value(str expr0) int {
   def expr = _clean_strip_outer_parens(expr0)
   def truth = _clean_expr_truth_value(expr)
   if truth >= 0 { return truth }
   mut p = str.find(expr, " != ")
   mut op = "!="
   if p < 0 {
      p = str.find(expr, " == ")
      op = "=="
   }
   if p < 0 {
      def lit = _clean_literal_int_value(expr)
      if !lit.get("ok", false) { return -1 }
      return int(lit.get("value", 0)) != 0 ? 1 : 0
   }
   def left = _clean_literal_int_value(slice(expr, 0, p, 1))
   def right = _clean_literal_int_value(slice(expr, p + 4, expr.len, 1))
   if !left.get("ok", false) || !right.get("ok", false) { return -1 }
   def same = int(left.get("value", 0)) == int(right.get("value", 0))
   if op == "==" { return same ? 1 : 0 }
   same ? 0 : 1
}

fn _clean_drop_constant_branches(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 {
         def cv = _clean_constant_condition_value(parts.get("expr", ""))
         if cv == 0 {
            i += 1
            continue
         }
         if cv == 1 {
            b = str.builder_append(b, _clean_line_indent(lines[i]) + "goto " + parts.get("target", "") + "\n")
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_normalize_render_text(str text) str {
   mut out = text
   out = str.str_replace(out, "[--0x", "[0x")
   out = str.str_replace(out, "[--", "[")
   out
}

fn _clean_reindent_bare_for_headers(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut depth = 0
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      mut local_depth = depth
      if str.startswith(raw, "}") { local_depth = max(0, local_depth - 1) }
      mut line = lines[i]
      if _clean_line_indent(line).len == 0 && local_depth > 0 && str.startswith(raw, "for ") {
         line = str.repeat(" ", local_depth * 2) + raw
      }
      if _clean_line_indent(line).len == 0 && local_depth > 0 && str.startswith(raw, "}") {
         line = str.repeat(" ", local_depth * 2) + raw
      }
      b = str.builder_append(b, line + "\n")
      mut j = 0
      while j < raw.len {
         def c = load8(raw, j)
         if c == 123 { depth += 1 }
         elif c == 125 { depth = max(0, depth - 1) }
         j += 1
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_parenthesize_mixed_bitwise_assigns(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_rendered_assignment_parts(lines[i])
      if parts.len > 0 {
         def rhs = str.strip(parts.get("rhs", ""))
         def p = _clean_top_level_find(rhs, " | ")
         if p > 0 {
            def left = str.strip(slice(rhs, 0, p, 1))
            def right = str.strip(slice(rhs, p + 3, rhs.len, 1))
            if _clean_top_level_find(right, " ^^ ") > 0 && !_clean_outer_balanced_parens_wrap(right) {
               b = str.builder_append(b, _clean_line_indent(lines[i]) + parts.get("lhs", "") +
                  " = " + left + " | (" + right + ")\n")
               changed = true
               i += 1
               continue
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_stack_canary_condition(str expr0) str {
   def expr = str.strip(expr0)
   def ne = "mem_fs(0x28) != "
   def eq = "mem_fs(0x28) == "
   if str.startswith(expr, ne) {
      def slot = str.strip(slice(expr, ne.len, expr.len, 1))
      if slot.len > 0 { return "!stack_canary_ok(" + slot + ")" }
   }
   if str.startswith(expr, eq) {
      def slot = str.strip(slice(expr, eq.len, expr.len, 1))
      if slot.len > 0 { return "stack_canary_ok(" + slot + ")" }
   }
   mut p = _clean_top_level_find(expr, " == ")
   mut op = "=="
   if p < 0 {
      p = _clean_top_level_find(expr, " != ")
      op = "!="
   }
   if p >= 0 {
      def left = str.strip(slice(expr, 0, p, 1))
      def right = str.strip(slice(expr, p + 4, expr.len, 1))
      def lv = _clean_literal_int_value(left)
      def rv = _clean_literal_int_value(right)
      mut xor_expr = ""
      if rv.get("ok", false) && int(rv.get("value", 0)) == 0 { xor_expr = left }
      elif lv.get("ok", false) && int(lv.get("value", 0)) == 0 { xor_expr = right }
      if xor_expr.len > 0 {
         def x = _clean_strip_outer_parens(xor_expr)
         def xp = _clean_top_level_find(x, " ^^ ")
         if xp > 0 {
            def xl = str.strip(slice(x, 0, xp, 1))
            def xr = str.strip(slice(x, xp + 4, x.len, 1))
            mut slot = ""
            if xl == "mem_fs(0x28)" && str.startswith(xr, "local_") { slot = xr }
            elif xr == "mem_fs(0x28)" && str.startswith(xl, "local_") { slot = xl }
            if slot.len > 0 {
               return (op == "==" ? "" : "!") + "stack_canary_ok(" + slot + ")"
            }
         }
      }
   }
   expr
}

fn _clean_stack_canary_call_slot(str expr0) str {
   mut expr = str.strip(expr0)
   if str.startswith(expr, "!(") && expr.len > 3 && load8(expr, expr.len - 1) == 41 {
      expr = str.strip(slice(expr, 2, expr.len - 1, 1))
   }
   def prefix = "stack_canary_ok("
   if !str.startswith(expr, prefix) || !str.endswith(expr, ")") { return "" }
   str.strip(slice(expr, prefix.len, expr.len - 1, 1))
}

fn _clean_stack_canary_positive_call(str expr0) bool {
   def expr = str.strip(expr0)
   !str.startswith(expr, "!(") && _clean_stack_canary_call_slot(expr).len > 0
}

fn _clean_line_has_only_stack_canary_local(str line, str lhs) bool {
   if !_clean_render_text_has_token(line, lhs) { return true }
   def removed = str.str_replace(line, "stack_canary_ok(" + lhs + ")", "")
   !_clean_render_text_has_token(removed, lhs)
}

fn _clean_stack_canary_local_only_used_as_guard(list lines, str lhs) bool {
   mut saw_guard = false
   mut i = 0
   while i < lines.len {
      def parts = _clean_rendered_assignment_parts(lines[i])
      if parts.len > 0 && parts.get("lhs", "") == lhs {
         i += 1
         continue
      }
      if str.find(lines[i], "stack_canary_ok(" + lhs + ")") >= 0 { saw_guard = true }
      if !_clean_line_has_only_stack_canary_local(lines[i], lhs) { return false }
      i += 1
   }
   saw_guard
}

fn _clean_stack_canary_bare_xor_assignment(str line0) bool {
   def parts = _clean_rendered_assignment_parts(line0)
   if parts.len == 0 || !_clean_rendered_value_temp_reg(parts.get("lhs", "")) { return false }
   def rhs = _clean_strip_outer_parens(parts.get("rhs", ""))
   def p = _clean_top_level_find(rhs, " ^^ ")
   if p < 0 { return false }
   def left = str.strip(slice(rhs, 0, p, 1))
   def right = str.strip(slice(rhs, p + 4, rhs.len, 1))
   def lhs_aliases = _slice_symbol_aliases(parts.get("lhs", ""))
   if (left == "mem_fs(0x28)" && _clean_rendered_value_temp_reg(right) &&
      _symbols_intersect(_slice_symbol_aliases(right), lhs_aliases)){
      return true
   }
   if (right == "mem_fs(0x28)" && _clean_rendered_value_temp_reg(left) &&
      _symbols_intersect(_slice_symbol_aliases(left), lhs_aliases)){
      return true
   }
   false
}

fn _clean_drop_stack_canary_noise(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut i = 0
   while i < lines.len {
      def save_parts = _clean_rendered_assignment_parts(lines[i])
      if (save_parts.len > 0 && str.startswith(save_parts.get("lhs", ""), "local_") &&
         save_parts.get("rhs", "") == "mem_fs(0x28)" &&
         _clean_stack_canary_local_only_used_as_guard(lines, save_parts.get("lhs", ""))){
         skip = skip.set(to_str(i), true)
      }
      i += 1
   }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if skip.get(to_str(i), false) {
         i += 1
         continue
      }
      def raw_if = str.strip(lines[i])
      if str.startswith(raw_if, "if (stack_canary_ok(") && str.endswith(raw_if, "){") {
         def body = _clean_next_nonblank_index(lines, i + 1)
         def close = body >= 0 ? _clean_next_nonblank_index(lines, body + 1) : -1
         if body >= 0 && close >= 0 {
            def close_is_block = str.strip(lines[close]) == "}"
            if _clean_rendered_is_return(lines[body]) && close_is_block {
               b = str.builder_append(b, _clean_line_indent(lines[i]) + str.strip(lines[body]) + "\n")
               i = close + 1
               continue
            }
         }
      }
      def open = _clean_structured_if_open_parts(lines[i])
      if open.len > 0 && _clean_stack_canary_positive_call(open.get("expr", "")) {
         def body = _clean_next_nonblank_index(lines, i + 1)
         def close = body >= 0 ? _clean_next_nonblank_index(lines, body + 1) : -1
         if body >= 0 && close >= 0 {
            def close_is_block = str.strip(lines[close]) == "}"
            if _clean_rendered_is_return(lines[body]) && close_is_block {
               b = str.builder_append(b, _clean_line_indent(lines[i]) + str.strip(lines[body]) + "\n")
               i = close + 1
               continue
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_drop_terminal_stack_canary_xor_residue(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if _clean_stack_canary_bare_xor_assignment(lines[i]) {
         def next = _clean_next_nonblank_index(lines, i + 1)
         if next >= 0 && next < lines.len && _clean_rendered_is_return(lines[next]) {
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_normalize_stack_canary_lines(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def parts = _clean_if_goto_parts(lines[i])
      if parts.len > 0 {
         def expr = _clean_stack_canary_condition(parts.get("expr", ""))
         if expr != parts.get("expr", "") {
            b = str.builder_append(b, _clean_line_indent(lines[i]) + "if " + expr + "{ goto " + parts.get("target", "") + " }\n")
            i += 1
            continue
         }
      }
      def open = _clean_structured_if_open_parts(lines[i])
      if open.len > 0 {
         def expr = _clean_stack_canary_condition(open.get("expr", ""))
         if expr != open.get("expr", "") {
            b = str.builder_append(b, _clean_line_indent(lines[i]) + "if " + expr + "{\n")
            i += 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_text_select_at(str text, int i) bool {
   i + 7 <= text.len &&
   load8(text, i) == 115 &&
   load8(text, i + 1) == 101 &&
   load8(text, i + 2) == 108 &&
   load8(text, i + 3) == 101 &&
   load8(text, i + 4) == 99 &&
   load8(text, i + 5) == 116 &&
   load8(text, i + 6) == 40
}

fn _clean_simplify_constant_selects_once(str text) dict {
   mut b = str.Builder(text.len)
   mut i = 0
   mut changed = false
   while i < text.len {
      if _clean_text_select_at(text, i) {
         def end = _clean_call_end_at(text, i, "select")
         if end > i {
            def inner = slice(text, i + 7, end - 1, 1)
            def args = _clean_call_args(inner)
            if args.len == 3 {
               def cv = _clean_constant_condition_value(args[0])
               if cv == 0 || cv == 1 {
                  b = str.builder_append(b, cv == 1 ? args[1] : args[2])
                  changed = true
                  i = end
                  continue
               }
            }
         }
      }
      b = str.builder_append(b, chr(load8(text, i)))
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   {"text": out, "changed": changed}
}

fn _clean_simplify_constant_selects(str text) str {
   if str.find(text, "select(") < 0 { return text }
   mut out = text
   mut i = 0
   while i < 4 {
      def pass = _clean_simplify_constant_selects_once(out)
      if !pass.get("changed", false) { return out }
      out = pass.get("text", out)
      i += 1
   }
   out
}

fn _clean_drop_constant_structured_ifs(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def open = _clean_structured_if_open_parts(lines[i])
      if open.len > 0 {
         def cv = _clean_constant_condition_value(open.get("expr", ""))
         if cv == 0 || cv == 1 {
            mut depth = 0
            mut else_line = -1
            mut block_close = -1
            mut scan = i
            while scan < lines.len {
               def raw_scan = str.strip(lines[scan])
               if scan == i {
                  depth += 1
               } elif raw_scan == "} else {" {
                  if depth == 1 { else_line = scan }
               } elif raw_scan == "}" {
                  depth -= 1
                  if depth == 0 {
                     block_close = scan
                     break
                  }
               } elif str.endswith(raw_scan, "{") {
                  depth += 1
               }
               scan += 1
            }
            if else_line > i && block_close > else_line {
               def indent = _clean_line_indent(lines[i])
               mut j = cv == 1 ? i + 1 : else_line + 1
               def end = cv == 1 ? else_line : block_close
               while j < end {
                  b = str.builder_append(b, _clean_outdent_if_body_line(lines[j], indent) + "\n")
                  j += 1
               }
               i = block_close + 1
               continue
            }
            def close = _clean_matching_block_close(lines, i)
            if close > i && close + 1 < lines.len && str.strip(lines[close + 1]) == "} else {" {
               def else_close = _clean_matching_block_close(lines, close + 1)
               if else_close > close + 1 {
                  def indent = _clean_line_indent(lines[i])
                  mut j = cv == 1 ? i + 1 : close + 2
                  def end = cv == 1 ? close : else_close
                  while j < end {
                     b = str.builder_append(b, _clean_outdent_if_body_line(lines[j], indent) + "\n")
                     j += 1
                  }
                  i = else_close + 1
                  continue
               }
            }
            if close > i && !(close + 1 < lines.len && str.strip(lines[close + 1]) == "} else {") {
               if cv == 1 {
                  def indent = _clean_line_indent(lines[i])
                  mut j = i + 1
                  while j < close {
                     b = str.builder_append(b, _clean_outdent_if_body_line(lines[j], indent) + "\n")
                     j += 1
                  }
               }
               i = close + 1
               continue
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_literal01_expr(str expr) int {
   def lit = _clean_literal_int_value(expr)
   if !lit.get("ok", false) { return -1 }
   def value = int(lit.get("value", -1))
   (value == 0 || value == 1) ? value : -1
}

fn _clean_rendered_return_expr(str line) str {
   def raw = str.strip(line)
   if !str.startswith(raw, "return ") { return "" }
   str.strip(slice(raw, 7, raw.len, 1))
}

fn _clean_block_single_return_expr(list lines, int start, int end) str {
   mut out = ""
   mut i = start
   while i < end && i < lines.len {
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         i += 1
         continue
      }
      if out.len > 0 { return "" }
      out = _clean_rendered_return_expr(raw)
      if out.len == 0 { return "" }
      i += 1
   }
   out
}

fn _clean_block_single_assignment(list lines, int start, int end) dict {
   mut out = dict()
   mut i = start
   while i < end && i < lines.len {
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         i += 1
         continue
      }
      if out.len > 0 { return dict() }
      out = _clean_rendered_assignment_parts(lines[i])
      if out.len == 0 { return dict() }
      i += 1
   }
   out
}

fn _clean_bool_return_expr(str expr, int then_value) str {
   then_value == 1 ? _clean_strip_outer_parens(expr) : _clean_invert_cond(expr)
}

fn _clean_ternary_condition_expr(str expr) str {
   def c = _clean_strip_outer_parens(expr)
   str.find(c, " ? ") >= 0 ? "(" + c + ")" : c
}

fn _clean_expr_is_boolish(str expr) bool {
   def e = _clean_strip_outer_parens(expr)
   if e.len == 0 { return false }
   if _clean_literal01_expr(e) >= 0 { return true }
   if str.startswith(e, "!(") || str.startswith(e, "bool(") { return true }
   if _clean_top_level_find(e, " && ") >= 0 || _clean_top_level_find(e, " || ") >= 0 { return true }
   def ops = [" == ", " != ", " <= ", " >= ", " < ", " > "]
   mut i = 0
   while i < ops.len {
      if _clean_top_level_find(e, ops[i]) >= 0 { return true }
      i += 1
   }
   false
}

fn _clean_bool_term(str expr) str {
   def e = _clean_strip_outer_parens(expr)
   if (_clean_top_level_find(e, " && ") >= 0 || _clean_top_level_find(e, " || ") >= 0 ||
      str.find(e, " ? ") >= 0){
      return "(" + e + ")"
   }
   e
}

fn _clean_join_bool_terms(list exprs, str op) str {
   mut out = ""
   mut i = 0
   while i < exprs.len {
      def e = _clean_bool_term(exprs[i])
      if e.len > 0 {
         out = out.len == 0 ? e : out + op + e
      }
      i += 1
   }
   out
}

fn _clean_copy_str(str s) str {
   mut b = str.Builder(s.len)
   b = str.builder_append(b, s)
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_return_pair_expr(str cond, str then_expr0, str after_expr0) str {
   def then_expr = str.strip(then_expr0)
   def after_expr = str.strip(after_expr0)
   def then_bool = _clean_literal01_expr(then_expr)
   def after_bool = _clean_literal01_expr(after_expr)
   if then_bool >= 0 && after_bool >= 0 && then_bool != after_bool {
      return _clean_bool_return_expr(cond, then_bool)
   }
   if then_bool == 0 && _clean_expr_is_boolish(after_expr) {
      return _clean_bool_term(_clean_invert_cond(cond)) + " && " + _clean_bool_term(after_expr)
   }
   if then_bool == 1 && _clean_expr_is_boolish(after_expr) {
      return _clean_bool_term(cond) + " || " + _clean_bool_term(after_expr)
   }
   if after_bool == 0 && _clean_expr_is_boolish(then_expr) {
      return _clean_bool_term(cond) + " && " + _clean_bool_term(then_expr)
   }
   if after_bool == 1 && _clean_expr_is_boolish(then_expr) {
      return _clean_bool_term(_clean_invert_cond(cond)) + " || " + _clean_bool_term(then_expr)
   }
   if _clean_same_expr(then_expr, after_expr) { return then_expr }
   _clean_ternary_condition_expr(cond) + " ? " + then_expr + " : " + after_expr
}

fn _clean_return_guard_chain_expr(list conds, str fail_expr0, str success_expr0) str {
   def fail_expr = str.strip(fail_expr0)
   def success_expr = str.strip(success_expr0)
   if _clean_same_expr(fail_expr, success_expr) { return success_expr }
   def fail_bool = _clean_literal01_expr(fail_expr)
   def success_bool = _clean_literal01_expr(success_expr)
   mut inv_conds = []
   mut i = 0
   while i < conds.len {
      inv_conds = inv_conds.append(_clean_invert_cond(conds[i]))
      i += 1
   }
   if fail_bool == 0 && success_bool == 1 {
      return _clean_join_bool_terms(inv_conds, " && ")
   }
   if fail_bool == 1 && success_bool == 0 {
      return _clean_join_bool_terms(conds, " || ")
   }
   if fail_bool == 0 && _clean_expr_is_boolish(success_expr) {
      return _clean_join_bool_terms(inv_conds.append(success_expr), " && ")
   }
   if fail_bool == 1 && _clean_expr_is_boolish(success_expr) {
      return _clean_join_bool_terms(conds.append(success_expr), " || ")
   }
   def guard = _clean_join_bool_terms(conds, " || ")
   guard.len == 0 ? "" : _clean_bool_term(guard) + " ? " + fail_expr + " : " + success_expr
}

fn _clean_if_else_return_region(list lines, int start) dict {
   def open = _clean_structured_if_open_parts(lines[start])
   if open.len == 0 { return dict() }
   mut depth = 1
   mut i = start + 1
   mut else_idx = -1
   while i < lines.len {
      def raw = str.strip(lines[i])
      if raw == "} else {" && depth == 1 {
         else_idx = i
         break
      }
      if raw == "} else {" {
         i += 1
         continue
      }
      if str.endswith(raw, "{") {
         depth += 1
      } elif raw == "}" {
         depth -= 1
         if depth <= 0 { return dict() }
      }
      i += 1
   }
   if else_idx < 0 { return dict() }
   depth = 1
   i = else_idx + 1
   while i < lines.len {
      def raw = str.strip(lines[i])
      if raw == "} else {" {
         i += 1
         continue
      }
      if str.endswith(raw, "{") {
         depth += 1
      } elif raw == "}" {
         depth -= 1
         if depth == 0 {
            def then_expr = _clean_block_single_return_expr(lines, start + 1, else_idx)
            def else_expr = _clean_block_single_return_expr(lines, else_idx + 1, i)
            if then_expr.len > 0 && else_expr.len > 0 {
               return {"expr": open.get("expr", ""), "then": then_expr, "else": else_expr,
                  "end": i}
            }
            return dict()
         }
      }
      i += 1
   }
   dict()
}

fn _clean_if_else_assign_return_region(list lines, int start) dict {
   def open = _clean_structured_if_open_parts(lines[start])
   if open.len == 0 { return dict() }
   mut depth = 1
   mut i = start + 1
   mut else_idx = -1
   while i < lines.len {
      def raw = str.strip(lines[i])
      if raw == "} else {" && depth == 1 {
         else_idx = i
         break
      }
      if raw == "} else {" {
         i += 1
         continue
      }
      if str.endswith(raw, "{") {
         depth += 1
      } elif raw == "}" {
         depth -= 1
         if depth <= 0 { return dict() }
      }
      i += 1
   }
   if else_idx < 0 { return dict() }
   depth = 1
   i = else_idx + 1
   while i < lines.len {
      def raw = str.strip(lines[i])
      if raw == "} else {" {
         i += 1
         continue
      }
      if str.endswith(raw, "{") {
         depth += 1
      } elif raw == "}" {
         depth -= 1
         if depth == 0 {
            def next = _clean_next_nonblank_index(lines, i + 1)
            if next >= lines.len { return dict() }
            def ret = _clean_rendered_return_expr(lines[next])
            def then_assign = _clean_block_single_assignment(lines, start + 1, else_idx)
            def else_assign = _clean_block_single_assignment(lines, else_idx + 1, i)
            if (ret.len > 0 && then_assign.len > 0 && else_assign.len > 0 &&
               then_assign.get("lhs", "") == else_assign.get("lhs", "") &&
               ret == then_assign.get("lhs", "") &&
               _clean_rendered_const_local(ret) &&
               _clean_rendered_pure_temp_rhs(then_assign.get("rhs", "")) &&
               _clean_rendered_pure_temp_rhs(else_assign.get("rhs", ""))){
               return {"expr": open.get("expr", ""), "then": then_assign.get("rhs", ""),
                  "else": else_assign.get("rhs", ""), "end": next}
            }
            return dict()
         }
      }
      i += 1
   }
   dict()
}

fn _clean_return_guard_chain_region(list lines, int start) dict {
   def indent = _clean_line_indent(lines[start])
   mut conds = []
   mut fail_expr = ""
   mut cursor = start
   while cursor < lines.len {
      if _clean_line_indent(lines[cursor]) != indent { return dict() }
      def open = _clean_structured_if_open_parts(lines[cursor])
      if open.len == 0 { return dict() }
      def close = _clean_matching_block_close(lines, cursor)
      if close <= cursor { return dict() }
      def expr = _clean_block_single_return_expr(lines, cursor + 1, close)
      if expr.len == 0 { return dict() }
      if fail_expr.len == 0 {
         fail_expr = expr
      } elif !_clean_same_expr(fail_expr, expr) {
         return dict()
      }
      conds = conds.append(open.get("expr", ""))
      def next = _clean_next_nonblank_index(lines, close + 1)
      if next >= lines.len { return dict() }
      if _clean_line_indent(lines[next]) != indent { return dict() }
      def next_open = _clean_structured_if_open_parts(lines[next])
      if next_open.len > 0 {
         cursor = next
         continue
      }
      def success_expr = _clean_rendered_return_expr(lines[next])
      if success_expr.len > 0 && conds.len >= 2 {
         def folded = _clean_return_guard_chain_expr(conds, fail_expr, success_expr)
         if folded.len > 0 {
            return {"expr": folded, "end": next}
         }
      }
      return dict()
   }
   dict()
}

fn _clean_replace_line_region(list lines, int start, int end, str replacement) str {
   mut out_lines = []
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if i == start {
         out_lines = out_lines.append(_clean_copy_str(replacement))
         i = end + 1
         continue
      }
      out_lines = out_lines.append(lines[i])
      i += 1
   }
   str.join(out_lines, "\n") + "\n"
}

fn _clean_collapse_return_ifs(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def open = _clean_structured_if_open_parts(lines[i])
      mut handled = false
      if open.len > 0 {
         def guards = _clean_return_guard_chain_region(lines, i)
         if guards.len > 0 {
            return _clean_collapse_return_ifs(_clean_replace_line_region(lines, i,
                  int(guards.get("end", i)), _clean_line_indent(lines[i]) + "return " +
                  guards.get("expr", "")))
         } elif _clean_if_else_return_region(lines, i).len > 0 {
            def ifelse = _clean_if_else_return_region(lines, i)
            changed = true
            b = str.builder_append(b, _clean_line_indent(lines[i]) + "return " +
               _clean_return_pair_expr(ifelse.get("expr", ""), ifelse.get("then", ""),
                  ifelse.get("else", "")) + "\n")
            i = int(ifelse.get("end", i)) + 1
            handled = true
            continue
         } else {
            def close = _clean_matching_block_close(lines, i)
            if close > i {
               def next = _clean_next_nonblank_index(lines, close + 1)
               if (next < lines.len && str.strip(lines[next]) != "} else {" &&
                  _clean_line_indent(lines[next]) == _clean_line_indent(lines[i])){
                  def then_expr = _clean_block_single_return_expr(lines, i + 1, close)
                  def after_expr = _clean_rendered_return_expr(lines[next])
                  if then_expr.len > 0 && after_expr.len > 0 {
                     changed = true
                     b = str.builder_append(b, _clean_line_indent(lines[i]) + "return " +
                        _clean_return_pair_expr(open.get("expr", ""), then_expr, after_expr) + "\n")
                     i = next + 1
                     handled = true
                     continue
                  }
               }
            }
         }
      }
      if !handled {
         b = str.builder_append(b, lines[i] + "\n")
         i += 1
      }
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_drop_empty_blocks(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      if raw == "} else {" {
         mut j = i + 1
         while j < lines.len && str.strip(lines[j]).len == 0 { j += 1 }
         if j < lines.len && str.strip(lines[j]) == "}" {
            b = str.builder_append(b, _clean_line_indent(lines[i]) + "}\n")
            i = j + 1
            continue
         }
      }
      if str.startswith(raw, "if (") && str.endswith(raw, "{") {
         mut j = i + 1
         while j < lines.len && str.strip(lines[j]).len == 0 { j += 1 }
         if j < lines.len && str.strip(lines[j]) == "} else {" {
            mut k = j + 1
            while k < lines.len && str.strip(lines[k]).len == 0 { k += 1 }
            if k < lines.len && str.strip(lines[k]) == "}" {
               i = k + 1
               continue
            }
         }
         if j < lines.len && str.strip(lines[j]) == "}" {
            i = j + 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_rendered_arg_reg(str lhs0) bool {
   def lhs = str.lower(str.strip(lhs0))
   lhs == "rdi" || lhs == "edi" || lhs == "di" ||
   lhs == "rsi" || lhs == "esi" || lhs == "si" ||
   lhs == "rdx" || lhs == "edx" || lhs == "dx" ||
   lhs == "rcx" || lhs == "ecx" || lhs == "cx" ||
   lhs == "r8" || lhs == "r8d" || lhs == "r8w" ||
   lhs == "r9" || lhs == "r9d" || lhs == "r9w" ||
   lhs == "x0" || lhs == "x1" || lhs == "x2" || lhs == "x3" || lhs == "x4" || lhs == "x5" ||
   lhs == "r0" || lhs == "r1" || lhs == "r2" || lhs == "r3" || lhs == "r4" || lhs == "r5" ||
   lhs == "a0" || lhs == "a1" || lhs == "a2" || lhs == "a3" || lhs == "a4" || lhs == "a5"
}

fn _clean_rendered_helper_call_name(str name0) bool {
   def name = str.lower(str.strip(name0))
   str.startswith(name, "zext") || str.startswith(name, "sext") ||
   str.startswith(name, "bswap") || name == "rol" || name == "ror" ||
   str.startswith(name, "smul_wide") || str.startswith(name, "umul_wide") ||
   str.startswith(name, "smulhi") || str.startswith(name, "smullo") ||
   str.startswith(name, "umulhi") || str.startswith(name, "umullo") ||
   name == "mem" || name == "mem_fs" || name == "mem_gs" ||
   name == "byte_at" || name == "signbit" || name == "select"
}

fn _clean_rendered_call_args(str raw) list {
   def p = str.find(raw, "(")
   if p <= 0 || !str.endswith(str.strip(raw), ")") { return [] }
   def head = str.strip(slice(raw, 0, p, 1))
   if (head.len == 0 || str.startswith(head, "if") || str.startswith(head, "while") ||
      str.startswith(head, "switch") || str.find(head, "=") >= 0 ||
      _clean_rendered_helper_call_name(head)){ return [] }
   def end = raw.len - 1
   _clean_call_args(slice(raw, p + 1, end, 1))
}

fn _clean_rendered_expr_call_args(str expr0) list {
   def expr = str.strip(expr0)
   mut i = 0
   while i < expr.len {
      def ch = load8(expr, i)
      if _symbol_is_name_char(ch) {
         def start = i
         while i < expr.len && _symbol_is_name_char(load8(expr, i)) { i += 1 }
         def head = slice(expr, start, i, 1)
         mut j = i
         while j < expr.len && load8(expr, j) == 32 { j += 1 }
         if (j < expr.len && load8(expr, j) == 40 &&
            !(head == "if" || head == "while" || head == "switch" || head == "return") &&
            !_clean_rendered_helper_call_name(head)){
            mut depth = 1
            mut k = j + 1
            while k < expr.len && depth > 0 {
               def c = load8(expr, k)
               if c == 40 { depth += 1 }
               elif c == 41 { depth -= 1 }
               k += 1
            }
            if depth == 0 { return _clean_call_args(slice(expr, j + 1, k - 1, 1)) }
         }
         continue
      }
      i += 1
   }
   []
}

fn _clean_rendered_any_call_args(str raw0) list {
   def raw = str.strip(raw0)
   if _clean_rendered_assignment_parts(raw).len > 0 { return [] }
   def direct = _clean_rendered_call_args(raw)
   if direct.len > 0 { return direct }
   def goto_parts = _clean_if_goto_parts(raw)
   if goto_parts.len > 0 { return _clean_rendered_expr_call_args(goto_parts.get("expr", "")) }
   def inline = _clean_inline_if_parts(raw)
   if inline.len > 0 { return _clean_rendered_expr_call_args(inline.get("expr", "")) }
   def open = _clean_structured_if_open_parts(raw)
   if open.len > 0 { return _clean_rendered_expr_call_args(open.get("expr", "")) }
   []
}

fn _clean_rendered_call_setup_reg(str lhs0) bool {
   def lhs = str.lower(str.strip(lhs0))
   _clean_rendered_arg_reg(lhs) ||
   lhs == "rax" || lhs == "eax" || lhs == "ax" || lhs == "al"
}

fn _clean_resolve_rendered_setup_rhs(str rhs0, dict env) str {
   mut rhs = str.strip(rhs0)
   mut guard = 0
   while guard < 8 && env.contains(str.lower(rhs)) {
      def next = str.strip(to_str(env.get(str.lower(rhs), rhs)))
      if next == rhs { return rhs }
      rhs = next
      guard += 1
   }
   rhs
}

fn _clean_call_args_contain_expr(list args, str expr0) bool {
   def expr = str.strip(expr0)
   if expr.len == 0 { return false }
   mut i = 0
   while i < args.len {
      if str.strip(args[i]) == expr { return true }
      i += 1
   }
   false
}

fn _clean_drop_rendered_call_setup_window(list lines, int idx) bool {
   def first = _clean_rendered_assignment_parts(lines[idx])
   if first.len == 0 { return false }
   def first_lhs = first.get("lhs", "")
   if !_clean_rendered_call_setup_reg(first_lhs) { return false }
   if !_clean_rendered_pure_temp_rhs(first.get("rhs", "")) { return false }
   mut env = dict().set(str.lower(first_lhs), str.strip(first.get("rhs", "")))
   mut j = idx + 1
   mut steps = 0
   while j < lines.len && steps < 8 {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      if (_clean_rendered_label_name(raw).len > 0 || _clean_raw_goto_label(raw).len > 0 ||
         _clean_rendered_is_return(raw) || str.startswith(raw, "while (") ||
         str.startswith(raw, "switch(") || raw == "}"){
         return false
      }
      def args = _clean_rendered_any_call_args(raw)
      if args.len > 0 {
         if _clean_rendered_arg_reg(first_lhs) && !_clean_call_args_contain_expr(args, first_lhs) {
            return _clean_rendered_temp_unused_after_call(lines, j, first_lhs)
         }
         return _clean_call_args_contain_expr(args,
            _clean_resolve_rendered_setup_rhs(first.get("rhs", ""), env)) &&
         _clean_rendered_temp_unused_after_call(lines, j, first_lhs)
      }
      def parts = _clean_rendered_assignment_parts(raw)
      if parts.len == 0 { return false }
      if (!_clean_rendered_call_setup_reg(parts.get("lhs", "")) ||
         !_clean_rendered_pure_temp_rhs(parts.get("rhs", ""))){
         return false
      }
      env = env.set(str.lower(parts.get("lhs", "")),
         _clean_resolve_rendered_setup_rhs(parts.get("rhs", ""), env))
      j += 1
      steps += 1
   }
   false
}

fn _clean_drop_rendered_call_arg_setup(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def raw = str.strip(lines[i])
      def parts = _clean_rendered_assignment_parts(raw)
      def p = str.find(raw, " = ")
      if p > 0 {
         def lhs = str.strip(slice(raw, 0, p, 1))
         def rhs = str.strip(slice(raw, p + 3, raw.len, 1))
         if _clean_rendered_arg_reg(lhs) && rhs.len > 0 {
            def j = _clean_next_nonblank_index(lines, i + 1)
            if j < lines.len && _clean_rendered_label_name(lines[j]).len == 0 {
               def args = _clean_rendered_call_args(str.strip(lines[j]))
               mut drop = false
               mut ai = 0
               while ai < args.len {
                  if str.strip(args[ai]) == rhs {
                     drop = true
                     break
                  }
                  ai += 1
               }
               if drop {
                  i += 1
                  continue
               }
            }
         }
      }
      if parts.len > 0 && _clean_drop_rendered_call_setup_window(lines, i) {
         i += 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_rendered_temp_reg(str lhs0) bool {
   def lhs = str.lower(str.strip(lhs0))
   _clean_rendered_arg_reg(lhs) ||
   lhs == "rax" || lhs == "eax" || lhs == "ax" || lhs == "al" ||
   lhs == "rbx" || lhs == "ebx" || lhs == "bx" || lhs == "bl" ||
   lhs == "rdx" || lhs == "edx" || lhs == "dx" || lhs == "dl"
}

fn _clean_rendered_dead_temp_reg(str lhs0) bool {
   def lhs = str.lower(str.strip(lhs0))
   lhs == "rax" || lhs == "eax" || lhs == "ax" || lhs == "al" ||
   lhs == "esi" || lhs == "si" || lhs == "sil" ||
   lhs == "rdx" || lhs == "edx" || lhs == "dx" || lhs == "dl" ||
   lhs == "rcx" || lhs == "ecx" || lhs == "cx" || lhs == "cl" ||
   lhs == "r8" || lhs == "r8d" || lhs == "r8w" || lhs == "r8b" ||
   lhs == "r9" || lhs == "r9d" || lhs == "r9w" || lhs == "r9b" ||
   lhs == "r10" || lhs == "r10d" || lhs == "r10w" || lhs == "r10b" ||
   lhs == "r11" || lhs == "r11d" || lhs == "r11w" || lhs == "r11b"
}

fn _clean_rendered_return_value_reg(str lhs0) bool {
   def lhs = str.lower(str.strip(lhs0))
   lhs == "rax" || lhs == "eax" || lhs == "ax" || lhs == "al" ||
   lhs == "x0" || lhs == "w0" || lhs == "r0" || lhs == "a0"
}

fn _clean_rendered_discardable_dead_reg(str lhs0) bool {
   _clean_rendered_value_temp_reg(lhs0) && !_clean_rendered_return_value_reg(lhs0)
}

fn _clean_rendered_work_after(list lines, int idx) bool {
   mut j = idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 || raw == "}" || _clean_rendered_label_name(raw).len > 0 {
         j += 1
         continue
      }
      if _clean_rendered_is_return(raw) { return false }
      return true
   }
   false
}

fn _clean_rendered_explicit_return_after(list lines, int idx) bool {
   mut j = idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 || raw == "}" || _clean_rendered_label_name(raw).len > 0 {
         j += 1
         continue
      }
      return str.startswith(raw, "return ") && raw.len > 7
   }
   false
}

fn _clean_render_alias_expr_ok(str expr0) bool {
   def expr = str.strip(expr0)
   if expr.len == 0 || str.find(expr, "?") >= 0 { return false }
   if expr == "__errno_location()" { return true }
   if str.find(expr, "(") >= 0 { return false }
   if str.startswith(expr, "arg") { return true }
   if str.startswith(expr, "argv[") { return true }
   if str.startswith(expr, "&arg") { return true }
   false
}

fn _clean_errno_location_text(str text) str {
   mut out = str.str_replace(text, "mem(__errno_location())", "errno")
   out = str.str_replace(out, "__errno_location() != 0", "errno != 0")
   out = str.str_replace(out, "__errno_location() == 0", "errno == 0")
   out = str.str_replace(out, "0 != __errno_location()", "0 != errno")
   out = str.str_replace(out, "0 == __errno_location()", "0 == errno")
   out
}

fn _clean_return_reg_dead_before_next_use(list lines, int start, str reg0) bool {
   def reg = str.strip(reg0)
   if reg.len == 0 { return false }
   mut i = start
   while i < lines.len {
      def raw = str.strip(lines[i])
      if raw.len == 0 {
         i += 1
         continue
      }
      def assign = _clean_rendered_assignment_parts(lines[i])
      if assign.len > 0 && _clean_rendered_rhs_is_alias(assign.get("lhs", ""), reg) { return true }
      if _clean_rendered_standalone_call_expr(raw) { return true }
      if _clean_render_text_has_token(raw, reg) { return false }
      i += 1
   }
   true
}

fn _clean_inline_errno_result_conditions(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   mut changed = false
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def assign = _clean_rendered_assignment_parts(lines[i])
      if assign.len > 0 && str.strip(assign.get("rhs", "")) == "__errno_location()" {
         def j = _clean_next_nonblank_index(lines, i + 1)
         if j < lines.len {
            def lhs = assign.get("lhs", "")
            def needle = "mem(" + lhs + ")"
            if str.find(lines[j], needle) >= 0 {
               def rewritten = str.str_replace(lines[j], needle, "errno")
               if _clean_return_reg_dead_before_next_use(lines, j + 1, lhs) {
                  changed = true
                  b = str.builder_append(b, rewritten + "\n")
                  i = j + 1
                  continue
               }
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_drop_errno_mirror_temps(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut i = 0
   mut changed = false
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def assign = _clean_rendered_assignment_parts(lines[i])
      if (assign.len > 0 && str.strip(assign.get("rhs", "")) == "errno" &&
         _canonical_value_reg("x86", assign.get("lhs", "")).len > 0 &&
         (_clean_rendered_temp_dead_after(lines, i, assign.get("lhs", "")) ||
            _clean_rendered_temp_dead_after_labels_ok(lines, i, assign.get("lhs", "")))){
         changed = true
         i += 1
         continue
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_rendered_call_expr_parts(str expr0) dict {
   def expr = str.strip(expr0)
   if expr.len == 0 { return dict() }
   mut i = 0
   while i < expr.len && _symbol_is_name_char(load8(expr, i)) { i += 1 }
   if i <= 0 || i >= expr.len || load8(expr, i) != 40 { return dict() }
   def name = slice(expr, 0, i, 1)
   if _clean_rendered_helper_call_name(name) { return dict() }
   if _clean_call_end_at(expr, 0, name) != expr.len { return dict() }
   {"name": name, "args": slice(expr, i + 1, expr.len - 1, 1), "expr": expr}
}

fn _clean_rendered_line_call_expr_parts(str line) dict {
   def raw = str.strip(line)
   def direct = _clean_rendered_call_expr_parts(raw)
   if direct.len > 0 { return direct.set("mode", "statement") }
   def assign = _clean_rendered_assignment_parts(line)
   if assign.len > 0 {
      def rhs = _clean_rendered_call_expr_parts(assign.get("rhs", ""))
      if rhs.len > 0 { return rhs.set("mode", "assignment").set("lhs", assign.get("lhs", "")) }
   }
   dict()
}

fn _clean_localtime_result_field_expr(str expr0) str {
   mut expr = expr0
   def fields = [
      ["mem(rax + 0)", "time_info.tm_sec"], ["mem(rax)", "time_info.tm_sec"],
      ["mem(rax + 4)", "time_info.tm_min"], ["mem(rax + 8)", "time_info.tm_hour"],
      ["mem(eax + 0)", "time_info.tm_sec"], ["mem(eax)", "time_info.tm_sec"],
      ["mem(eax + 4)", "time_info.tm_min"], ["mem(eax + 8)", "time_info.tm_hour"],
      ["mem(x0 + 0)", "time_info.tm_sec"], ["mem(x0)", "time_info.tm_sec"],
      ["mem(x0 + 4)", "time_info.tm_min"], ["mem(x0 + 8)", "time_info.tm_hour"],
      ["mem(r0 + 0)", "time_info.tm_sec"], ["mem(r0)", "time_info.tm_sec"],
      ["mem(r0 + 4)", "time_info.tm_min"], ["mem(r0 + 8)", "time_info.tm_hour"],
      ["mem(a0 + 0)", "time_info.tm_sec"], ["mem(a0)", "time_info.tm_sec"],
      ["mem(a0 + 4)", "time_info.tm_min"], ["mem(a0 + 8)", "time_info.tm_hour"],
   ]
   mut i = 0
   while i < fields.len {
      expr = str.str_replace(expr, fields[i][0], fields[i][1])
      i += 1
   }
   expr
}

fn _clean_localtime_field_used_after(list lines, int idx) bool {
   mut j = idx + 1
   while j < lines.len {
      def raw = str.strip(lines[j])
      if raw.len == 0 {
         j += 1
         continue
      }
      if _clean_rendered_line_call_expr_parts(lines[j]).len > 0 { return false }
      def rewritten = _clean_localtime_result_field_expr(lines[j])
      if rewritten != lines[j] { return true }
      j += 1
   }
   false
}

fn _clean_known_struct_call_result_fields(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut active = false
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def call = _clean_rendered_line_call_expr_parts(lines[i])
      if call.len > 0 {
         active = false
         if (call.get("name", "") == "localtime" && call.get("mode", "") == "statement" &&
            _clean_localtime_field_used_after(lines, i)){
            active = true
            changed = true
            b = str.builder_append(b, _clean_line_indent(lines[i]) + "time_info = " + call.get("expr", "") + "\n")
            i += 1
            continue
         }
      }
      mut line = lines[i]
      if active {
         line = _clean_localtime_result_field_expr(line)
         if line != lines[i] { changed = true }
         def assign = _clean_rendered_assignment_parts(line)
         if (assign.len > 0 && _symbols_intersect(_slice_symbol_aliases(assign.get("lhs", "")), _slice_symbol_aliases("rax")) &&
            str.find(assign.get("rhs", ""), "time_info.") < 0){
            active = false
         }
      }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_drop_duplicate_return_value_assigns(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def assign = _clean_rendered_assignment_parts(lines[i])
      if assign.len > 0 && _clean_rendered_value_temp_reg(assign.get("lhs", "")) {
         def j = _clean_next_nonblank_index(lines, i + 1)
         if j < lines.len {
            def raw = str.strip(lines[j])
            if str.startswith(raw, "return ") && str.strip(slice(raw, 7, raw.len, 1)) == str.strip(assign.get("rhs", "")) {
               changed = true
               i += 1
               continue
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_allowed_inline_printf_call_result(str expr0) bool {
   def parts = _clean_rendered_call_expr_parts(expr0)
   if parts.len == 0 { return false }
   parts.get("name", "") == "strerror"
}

fn _clean_inline_printf_call_result_args(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def assign = _clean_rendered_assignment_parts(lines[i])
      if (assign.len > 0 && _clean_rendered_rhs_is_alias(assign.get("lhs", ""), "rsi") &&
         _clean_allowed_inline_printf_call_result(assign.get("rhs", ""))){
         mut j = _clean_next_nonblank_index(lines, i + 1)
         if j < lines.len {
            def zero = _clean_rendered_assignment_parts(lines[j])
            if (zero.len > 0 && _clean_rendered_rhs_is_alias(zero.get("lhs", ""), "rax") &&
               _clean_literal_zero(zero.get("rhs", ""))){
               j = _clean_next_nonblank_index(lines, j + 1)
            }
         }
         if (j < lines.len && str.find(lines[j], "printf(") >= 0 &&
            (_clean_render_text_has_alias(lines[j], "rax") || _clean_render_text_has_alias(lines[j], "rsi"))){
            mut repl_line = _clean_replace_token(lines[j], "rax", assign.get("rhs", ""))
            repl_line = _clean_replace_token(repl_line, "rsi", assign.get("rhs", ""))
            changed = true
            b = str.builder_append(b, repl_line + "\n")
            i = j + 1
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_printf_format_needs_string(str arg0) bool {
   def arg = str.strip(arg0)
   str.find(arg, "%s") >= 0
}

fn _clean_preferred_input_arg(str text) str {
   if str.find(text, "input = argv[1]") >= 0 { return "input" }
   if _clean_render_text_has_token(text, "argv[1]") { return "argv[1]" }
   ""
}

fn _clean_repair_printf_input_args(str text) str {
   def input_arg = _clean_preferred_input_arg(text)
   if input_arg.len == 0 { return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      mut line = lines[i]
      def call = _clean_rendered_line_call_expr_parts(line)
      if call.len > 0 && call.get("name", "") == "printf" {
         mut args = _clean_call_args(call.get("args", ""))
         if args.len > 0 && _clean_printf_format_needs_string(args[0]) {
            if args.len == 1 {
               args = args.append(input_arg)
               line = _clean_rendered_line_with_call_args(line, call, args)
               changed = true
            } elif str.strip(args[1]) == "argc" {
               args = _clean_list_replace_at(args, 1, input_arg)
               line = _clean_rendered_line_with_call_args(line, call, args)
               changed = true
            } elif input_arg == "input" && str.strip(args[1]) == "argv[1]" {
               args = _clean_list_replace_at(args, 1, input_arg)
               line = _clean_rendered_line_with_call_args(line, call, args)
               changed = true
            }
         }
      }
      b = str.builder_append(b, line + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_format_stack_buffer_slot(str arg0) str {
   mut arg = str.strip(arg0)
   if str.startswith(arg, "&") { arg = str.strip(slice(arg, 1, arg.len, 1)) }
   if str.startswith(arg, "local_") || str.startswith(arg, "stack_") { return arg }
   ""
}

fn _clean_format_buffer_key(str arg0) str {
   def slot = _clean_format_stack_buffer_slot(arg0)
   if slot.len > 0 { return slot }
   def arg = str.strip(arg0)
   str.startswith(arg, "&") ? arg : ""
}

fn _clean_format_printf_string_arg(str arg0) bool {
   def arg = _clean_addr_string_literal_arg(arg0)
   arg == "\"%s\""
}

fn _clean_format_buffer_only_used_for_print(list lines, str key, str slot, int sprintf_idx, int printf_idx) bool {
   mut i = 0
   while i < lines.len {
      if i == sprintf_idx || i == printf_idx {
         i += 1
         continue
      }
      def parts = _clean_rendered_assignment_parts(lines[i])
      if slot.len > 0 && parts.len > 0 && parts.get("lhs", "") == slot {
         if !_clean_literal_zero(parts.get("rhs", "")) { return false }
         i += 1
         continue
      }
      if slot.len > 0 {
         if _clean_render_text_has_token(lines[i], slot) { return false }
      } elif key.len > 0 && str.find(lines[i], key) >= 0 {
         return false
      }
      i += 1
   }
   true
}

fn _clean_collapse_sprintf_printf_buffers(str text) str {
   def lines = str.split(text, "\n")
   mut skip = dict()
   mut replace = dict()
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def call = _clean_rendered_line_call_expr_parts(lines[i])
      if call.len > 0 && call.get("name", "") == "sprintf" {
         def args = _clean_call_args(call.get("args", ""))
         if args.len >= 2 {
            def slot = _clean_format_stack_buffer_slot(args[0])
            def key = _clean_format_buffer_key(args[0])
            def j = _clean_next_nonblank_index(lines, i + 1)
            if key.len > 0 && j < lines.len {
               def out_call = _clean_rendered_line_call_expr_parts(lines[j])
               def out_args = out_call.len > 0 ? _clean_call_args(out_call.get("args", "")) : []
               if (out_call.len > 0 && out_call.get("name", "") == "printf" &&
                  out_args.len == 2 && _clean_format_printf_string_arg(out_args[0]) &&
                  _clean_format_buffer_key(out_args[1]) == key &&
                  _clean_format_buffer_only_used_for_print(lines, key, slot, i, j)){
                  mut direct_args = [args[1]]
                  mut ai = 2
                  while ai < args.len {
                     direct_args = direct_args.append(args[ai])
                     ai += 1
                  }
                  replace = replace.set(to_str(i), _clean_line_indent(lines[i]) + "printf(" +
                     str.join(direct_args, ", ") + ")")
                  skip = skip.set(to_str(j), true)
                  mut k = 0
                  while k < lines.len {
                     def init = _clean_rendered_assignment_parts(lines[k])
                     if (slot.len > 0 && init.len > 0 && init.get("lhs", "") == slot &&
                        _clean_literal_zero(init.get("rhs", ""))){
                        skip = skip.set(to_str(k), true)
                     }
                     k += 1
                  }
                  changed = true
               }
            }
         }
      }
      i += 1
   }
   if !changed { return text }
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if !skip.get(to_str(i), false) {
         b = str.builder_append(b, replace.get(to_str(i), lines[i]) + "\n")
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_input_copy_dest_ok(str dest0) bool {
   def dest = str.strip(dest0)
   def lit = _clean_literal_int_value(dest)
   if lit.get("ok", false) && int(lit.get("value", 0)) >= 0x1000 { return true }
   str.startswith(dest, "data_")
}

fn _clean_input_copy_alias_name(str text) str {
   str.find(text, "CODE{") >= 0 || str.find(str.lower(text), "keygen") >= 0 ? "code" : "input_copy"
}

fn _clean_lift_global_input_copy(str text) str {
   def lines = str.split(text, "\n")
   mut dest = ""
   mut src = ""
   mut idx = -1
   mut i = 0
   while i < lines.len && idx < 0 {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def call = _clean_rendered_line_call_expr_parts(lines[i])
      if call.len > 0 && call.get("name", "") == "strncpy" {
         def args = _clean_call_args(call.get("args", ""))
         if (args.len >= 3 && _clean_input_copy_dest_ok(args[0]) &&
            (str.strip(args[1]) == "input" || str.strip(args[1]) == "argv[1]")){
            dest = str.strip(args[0])
            src = str.strip(args[1])
            idx = i
         }
      }
      i += 1
   }
   if idx < 0 { return text }
   def alias = _clean_input_copy_alias_name(text)
   mut b = str.Builder(text.len)
   i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if i == idx {
         b = str.builder_append(b, _clean_line_indent(lines[i]) + alias + " = " + src + "\n")
      } else if i > idx {
         b = str.builder_append(b, str.str_replace(lines[i], dest, alias) + "\n")
      } else {
         b = str.builder_append(b, lines[i] + "\n")
      }
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   out
}

fn _clean_check_call_index(str line0) dict {
   def call = _clean_rendered_line_call_expr_parts(line0)
   if call.len == 0 || call.get("mode", "") != "statement" { return dict() }
   def name = call.get("name", "")
   if !str.startswith(name, "check_") { return dict() }
   def args = _clean_call_args(call.get("args", ""))
   if args.len > 0 && !(args.len == 1 && str.strip(args[0]).len == 0) { return dict() }
   def raw_idx = slice(name, 6, name.len, 1)
   if raw_idx.len == 0 { return dict() }
   mut i = 0
   while i < raw_idx.len {
      if !str.ascii_is_digit(load8(raw_idx, i)) { return dict() }
      i += 1
   }
   {"ok": true, "index": str.parse_int(raw_idx, 10), "name": name}
}

fn _clean_validation_chain_call(str text) str {
   if _clean_render_text_has_token(text, "code") { return "validate_code(code)" }
   if _clean_render_text_has_token(text, "input") { return "validate_input(input)" }
   "validate_checks()"
}

fn _clean_collapse_sequential_check_chain(str text) str {
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      def first = _clean_check_call_index(lines[i])
      if first.len > 0 {
         mut j = i + 1
         mut want = int(first.get("index", 0)) + 1
         while j < lines.len {
            def next = _clean_check_call_index(lines[j])
            if (next.len == 0 || int(next.get("index", -1)) != want ||
               _clean_line_indent(lines[j]) != _clean_line_indent(lines[i])){
               break
            }
            want += 1
            j += 1
         }
         if j - i >= 4 {
            b = str.builder_append(b, _clean_line_indent(lines[i]) + _clean_validation_chain_call(text) + "\n")
            i = j
            changed = true
            continue
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_balanced_block_close(list lines, int start) int {
   mut depth = 0
   mut i = start
   while i < lines.len {
      def raw = str.strip(lines[i])
      if raw == "} else {" {
         i += 1
         continue
      }
      if str.endswith(raw, "{") { depth += 1 }
      if raw == "}" {
         depth -= 1
         if depth == 0 { return i }
      }
      i += 1
   }
   -1
}

fn _clean_check_helper_fn_name(str line0) str {
   def raw = str.strip(line0)
   if !str.startswith(raw, "fn check_") || !str.endswith(raw, "{") { return "" }
   def p = str.find(raw, "(")
   def q = str.find(raw, "){")
   if p <= 3 || q < p { return "" }
   def name = slice(raw, 3, p, 1)
   if str.strip(slice(raw, p + 1, q, 1)).len > 0 { return "" }
   def idx = slice(name, 6, name.len, 1)
   if idx.len == 0 { return "" }
   mut i = 0
   while i < idx.len {
      if !str.ascii_is_digit(load8(idx, i)) { return "" }
      i += 1
   }
   name
}

fn _clean_check_helper_failure_call(str line0) bool {
   def raw = str.strip(line0)
   def call = _clean_rendered_call_expr_parts(raw)
   if call.len == 0 { return false }
   def name = call.get("name", "")
   name == "denied_access" || name == "fail" || name == "reject" ||
   name == "rejected" || name == "exit" || name == "_exit" || name == "abort"
}

fn _clean_empty_then_failure_else_shape(list lines, int idx) dict {
   def open = _clean_structured_if_open_parts(lines[idx])
   if open.len == 0 { return dict() }
   mut j = idx + 1
   while j < lines.len && str.strip(lines[j]).len == 0 { j += 1 }
   if j >= lines.len || str.strip(lines[j]) != "} else {" { return dict() }
   mut k = j + 1
   while k < lines.len && str.strip(lines[k]).len == 0 { k += 1 }
   if k >= lines.len || !_clean_check_helper_failure_call(lines[k]) { return dict() }
   def close = _clean_balanced_block_close(lines, idx)
   if close <= k { return dict() }
   mut saw_fail = false
   mut scan = j + 1
   while scan < close {
      def raw = str.strip(lines[scan])
      if raw.len == 0 {
         scan += 1
         continue
      }
      if _clean_rendered_label_name(raw).len > 0 || raw == "} else {" || str.endswith(raw, "{") {
         return dict()
      }
      if _clean_check_helper_failure_call(raw) { saw_fail = true }
      elif !_clean_rendered_is_return(raw) { return dict() }
      scan += 1
   }
   saw_fail ? {"expr": open.get("expr", ""), "else": j, "close": close} : dict()
}

fn _clean_check_helper_scratch_lhs(str lhs0) bool {
   def lhs = str.lower(str.strip(lhs0))
   str.startswith(lhs, "local_") || str.startswith(lhs, "stack_") ||
   str.startswith(lhs, "xmm") || str.startswith(lhs, "ymm") || str.startswith(lhs, "zmm")
}

fn _clean_check_helper_scratch_line(str line0, str guard_expr) bool {
   def raw = str.strip(line0)
   if raw.len == 0 || raw == "rand()" { return true }
   def assign = _clean_rendered_assignment_parts(raw)
   if assign.len == 0 { return false }
   def lhs = assign.get("lhs", "")
   if !_clean_check_helper_scratch_lhs(lhs) { return false }
   if _clean_render_text_has_token(guard_expr, lhs) { return false }
   _clean_rendered_pure_temp_rhs(assign.get("rhs", ""))
}

fn _clean_check_helper_prelude_is_scratch(list lines, int start, int guard, str guard_expr) bool {
   mut i = start + 1
   while i < guard {
      if !_clean_check_helper_scratch_line(lines[i], guard_expr) { return false }
      i += 1
   }
   true
}

fn _clean_check_helper_tail_ok(list lines, int close, int fn_close) bool {
   mut i = close + 1
   while i < fn_close {
      def raw = str.strip(lines[i])
      if raw.len > 0 && raw != "return" { return false }
      i += 1
   }
   true
}

fn _clean_rewrite_check_helper_region(list lines, int start, int fn_close) dict {
   def name = _clean_check_helper_fn_name(lines[start])
   if name.len == 0 { return dict() }
   mut guard = -1
   mut shape = dict()
   mut i = start + 1
   while i < fn_close && guard < 0 {
      def s = _clean_empty_then_failure_else_shape(lines, i)
      if s.len > 0 {
         guard = i
         shape = s
      }
      i += 1
   }
   if guard < 0 { return dict() }
   def expr = shape.get("expr", "")
   def close = int(shape.get("close", -1))
   if close < guard || close >= fn_close { return dict() }
   if !_clean_check_helper_prelude_is_scratch(lines, start, guard, expr) { return dict() }
   if !_clean_check_helper_tail_ok(lines, close, fn_close) { return dict() }
   mut out = [lines[start]]
   def pad = _clean_line_indent(lines[guard])
   out = out.append(pad + "if !(" + expr + "){")
   i = int(shape.get("else", guard)) + 1
   while i < close {
      if str.strip(lines[i]).len > 0 { out = out.append(lines[i]) }
      i += 1
   }
   out = out.append(pad + "}")
   i = close + 1
   while i < fn_close {
      if str.strip(lines[i]).len > 0 { out = out.append(lines[i]) }
      i += 1
   }
   out = out.append(lines[fn_close])
   {"ok": true, "lines": out}
}

fn _clean_compact_check_helpers(str text) str {
   if str.find(text, "fn check_") < 0 { return text }
   def lines = str.split(text, "\n")
   mut b = str.Builder(text.len)
   mut changed = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if _clean_check_helper_fn_name(lines[i]).len > 0 {
         def close = _clean_balanced_block_close(lines, i)
         if close > i {
            def rewrite = _clean_rewrite_check_helper_region(lines, i, close)
            if rewrite.get("ok", false) {
               def out_lines = rewrite.get("lines", [])
               mut j = 0
               while j < out_lines.len {
                  b = str.builder_append(b, out_lines[j] + "\n")
                  j += 1
               }
               i = close + 1
               changed = true
               continue
            }
         }
      }
      b = str.builder_append(b, lines[i] + "\n")
      i += 1
   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_list_replace_at(list xs, int idx, str value) list {
   mut out = []
   mut i = 0
   while i < xs.len {
      out = out.append(i == idx ? value : xs[i])
      i += 1
   }
   out
}

fn _clean_libc_resource_lhs_ok(str lhs0) bool {
   def lhs = str.strip(lhs0)
   lhs.len > 0 && _clean_rendered_value_temp_reg(lhs)
}

fn _clean_libc_resource_name(str call_name0) str {
   def name = str.strip(call_name0)
   if name == "fopen" || name == "fdopen" || name == "freopen" || name == "popen" { return "file" }
   if name == "open" || name == "socket" || name == "accept" { return "fd" }
   if name == "opendir" { return "dir" }
   ""
}

fn _clean_libc_buffer_expr_ok(str expr0) bool {
   def expr = str.strip(expr0)
   expr == "rsp" || expr == "sp" || expr == "x31"
}

fn _clean_libc_input_buffer_index(str call_name0, list args) int {
   def name = str.strip(call_name0)
   if (name == "fread" || name == "fgets" || name == "gets") && args.len >= 1 { return 0 }
   if (name == "read" || name == "recv") && args.len >= 2 { return 1 }
   -1
}

fn _clean_rendered_line_with_call_args(str line, dict call, list args) str {
   def expr = call.get("name", "") + "(" + str.join(args, ", ") + ")"
