   mut changed = false
   mut folded = false
   mut i = 0
   while i < lines.len {
      if i == lines.len - 1 && lines[i].len == 0 { break }
      if (i + 5 < lines.len &&
         str.strip(lines[i]) == "i = 0" &&
         str.strip(lines[i + 1]) == "sum = 0" &&
         str.strip(lines[i + 2]) == "while input[i] != 0{" &&
         str.strip(lines[i + 3]) == "sum = sum + sext8(input[i])" &&
         str.strip(lines[i + 4]) == "i = i + 1" &&
         str.strip(lines[i + 5]) == "}"){
         b = str.builder_append(b, _clean_line_indent(lines[i]) + "sum = ascii_sum(input)\n")
         changed = true
         folded = true
         i += 6
         continue
      }
      mut line = lines[i]
      if folded {
         def cond = _clean_condition_expr_parts(line)
         if cond.len > 0 {
            def expr = _clean_ascii_sum_index_guard_expr(cond.get("expr", ""))
            if expr != cond.get("expr", "") {
