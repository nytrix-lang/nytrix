   }
   def out = str.builder_to_str(b)
   str.builder_free(b)
   changed ? out : text
}

fn _clean_modsum_slice_expr(str src0, int length) str {
   if length <= 0 { return "" }
   def src = str.strip(src0)
   mut base = src
   mut start = 0
   def plus = _clean_top_level_find(src, " + ")
   if plus >= 0 {
      base = str.strip(slice(src, 0, plus, 1))
      def off = _clean_literal_int_value(slice(src, plus + 3, src.len, 1))
      if !off.get("ok", false) || int(off.get("value", 0)) < 0 { return "" }
      start = int(off.get("value", 0))
   }
   if base != "input" && base != "argv[1]" && base != "password" { return "" }
   "slice(" + base + ", " + to_str(start) + ", " + to_str(start + length) + ", 1)"
}

fn _clean_modsum_predicate_expr(str call_text0, bool want_true) str {
   def call = _clean_rendered_call_expr_parts(call_text0)
   if call.len == 0 || call.get("name", "") != "check_with_mod" { return "" }
   def args = _clean_call_args(call.get("args", ""))
   if args.len < 3 { return "" }
   def lenv = _clean_literal_int_value(args[1])
   def modv = _clean_literal_int_value(args[2])
   if !lenv.get("ok", false) || !modv.get("ok", false) { return "" }
   def length = int(lenv.get("value", 0))
   def modulus = int(modv.get("value", 0))
   if length <= 0 || modulus <= 0 { return "" }
   def part = _clean_modsum_slice_expr(args[0], length)
   if part.len == 0 { return "" }
   "ascii_sum(" + part + ") % " + to_str(modulus) + (want_true ? " == 0" : " != 0")
}

fn _clean_simplify_modsum_call_expr(str expr0) str {
